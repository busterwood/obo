// obo/lib/env.obx: read-only access to the process environment.
//
// It is a source module (`module env`); importers write
//
//     import "env.obx" as env            // from obo/lib/
//     import "../lib/env.obx" as env     // from obo/cmd/
//
// and reach exported declarations as env::name. Within a file a declaration may
// use only earlier declarations. The module uses only the getenv builtin
// (design stdlib-eza-design-v7 section 5.8) and has no other dependency.
//
// get(name) is the owned byte array: nil when the name is invalid (empty, an
// embedded NUL, or containing '=') or absent, and a non-nil empty array when
// the variable is present with an empty value. value(name) copies the bytes to
// a string, so absent and present-empty both give ""; has is the way to tell
// them apart. getOr returns the fallback only when get is nil. There is no
// setenv and no iteration: eza reads NO_COLOR, LS_COLORS and EZA_COLORS and
// nothing writes the environment.
//
// No helper is named `string`: that would shadow the primitive type and the
// string(...) conversion inside this module. `value` and `getOr` are the
// names the design fixes (B3).
module env

// The value as bytes; nil when invalid or absent. The array is a copy the
// caller owns, so it survives anything that changes the environment.
pub fn get(name: string): ?[]byte {
    return getenv(name)
}

// Whether the variable is present at all (an empty value counts as present).
// The local is required by the owned-temporary rule.
pub fn has(name: string): bool {
    let v = get(name)
    return v != nil
}

// The value as a string: absent and present-empty both give "".
pub fn value(name: string): string {
    let v = get(name)
    if v == nil { return "" }
    return string(v)
}

// The value, or the fallback when the variable is absent.
pub fn getOr(name: string, fallback: string): string {
    let v = get(name)
    if v == nil { return fallback }
    return string(v)
}
