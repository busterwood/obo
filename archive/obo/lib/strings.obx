// value equality (strings compare by bytes)
pub fn eq(a: string, b: string): bool {
    return a == b
}

// prefix/suffix tests; an empty prefix or suffix is a prefix/suffix of anything
pub fn startsWith(s: string, prefix: string): bool {
    if len(prefix) > len(s) { return false }
    for i in 0..len(prefix) {
        if s[i] != prefix[i] { return false }
    }
    return true
}

pub fn endsWith(s: string, suffix: string): bool {
    if len(suffix) > len(s) { return false }
    let off = len(s) - len(suffix)
    for i in 0..len(suffix) {
        if s[off + i] != suffix[i] { return false }
    }
    return true
}

// first byte index of sub, or -1. The empty substring is found at 0.
pub fn indexOf(s: string, sub: string): int {
    let n = len(sub)
    if n == 0 { return 0 }
    if n > len(s) { return -1 }
    var i = 0
    while i + n <= len(s) {
        if matchesAt(s, i, sub) { return i }
        i += 1
    }
    return -1
}

pub fn contains(s: string, sub: string): bool {
    return indexOf(s, sub) >= 0
}

// s[i]; the index must be in range (the runtime checks it like any index)
pub fn byteAt(s: string, i: int): byte {
    return s[i]
}

// The array is taken by value: the call moves it into the callee, string(data)
// copies its bytes, and the callee's array is freed at scope exit. The caller
// must not use the array after the call. An empty array gives "".
pub fn fromBytes(data: []byte): string {
    return string(data)
}

// ASCII A..Z to a..z; every other byte is copied unchanged
pub fn lowerAscii(s: string): string {
    var out = new []byte(0)
    for i in 0..len(s) {
        var b = s[i]
        if b >= 'A' && b <= 'Z' { b = byte(b + 32) }
        append(out, b)
    }
    return string(out)
}

// Byte-wise split on a non-empty separator. split("", ",") is [""], a trailing
// separator yields a trailing empty field, and an empty separator is EINVAL.
pub fn split(s: string, sep: string): Result[[]string] {
    if len(sep) == 0 { return err("empty separator", 22) }
    var out = new []string(0)
    var start = 0
    var i = 0
    while i + len(sep) <= len(s) {
        if matchesAt(s, i, sep) {
            append(out, substr(s, start, i))
            i += len(sep)
            start = i
        } else {
            i += 1
        }
    }
    append(out, substr(s, start, len(s)))
    return ok(out)
}

// the single-byte fast path of split; a byte separator is always valid
pub fn splitByte(s: string, sep: byte): Result[[]string] {
    var out = new []string(0)
    var start = 0
    for i in 0..len(s) {
        if s[i] == sep {
            append(out, substr(s, start, i))
            start = i + 1
        }
    }
    append(out, substr(s, start, len(s)))
    return ok(out)
}

// parts joined by sep; join([], ",") is "" and join(["a"], ",") is "a"
pub fn join(parts: &[]string, sep: string): string {
    var out = new []byte(0)
    for i in 0..len(parts) {
        if i > 0 {
            for j in 0..len(sep) { append(out, sep[j]) }
        }
        for j in 0..len(parts[i]) { append(out, parts[i][j]) }
    }
    return string(out)
}

// C-locale whitespace trimming (isSpace: space and 0x09..0x0D)
pub fn trimLeft(s: string): string {
    var i = 0
    while i < len(s) && isSpace(s[i]) { i += 1 }
    return substr(s, i, len(s))
}

pub fn trimRight(s: string): string {
    var i = len(s)
    while i > 0 && isSpace(s[i - 1]) { i -= 1 }
    return substr(s, 0, i)
}

pub fn trim(s: string): string {
    var start = 0
    var end = len(s)
    while start < end && isSpace(s[start]) { start += 1 }
    while end > start && isSpace(s[end - 1]) { end -= 1 }
    return substr(s, start, end)
}

// ------------------------------------------------------- the eza name order
//
// natord-plus-plus 2.0.0 compares a sequence of chars: Unicode whitespace is
// skipped at the top of the outer loop, ASCII digit runs compare naturally and
// everything else compares by code point (folded for compare_ignore_case).
// E2 decodes UTF-8: invalid bytes compare as U+FFFD, exactly as if the strings
// had been lossy-decoded by eza first. Pure-ASCII strings keep the byte loop
// (its order is identical); a string with any byte >= 0x80 takes the code
// point loop.

fn hasHigh(s: string): bool {
    for i in 0..len(s) {
        if s[i] >= 0x80 { return true }
    }
    return false
}

fn isDigitCp(cp: int): bool {
    return cp >= '0' && cp <= '9'
}

fn signCp(a: int, b: int): int {
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

// natord::compare_iter over decoded code points (fold selects lowerCp). The
// structure follows natcmpCore; `pa`/`pb` are the packed current steps, so a
// read is an index move plus utf8Step.
fn natcmpUtf8(a: string, b: string, fold: bool): int {
    var i = 0
    var j = 0
    var pa = utf8Step(a, 0)
    var pb = utf8Step(b, 0)
    while true {
        while pa >= 0 && isUnicodeSpace(pa >> 4) {
            i += stepLen(pa)
            pa = utf8Step(a, i)
        }
        while pb >= 0 && isUnicodeSpace(pb >> 4) {
            j += stepLen(pb)
            pb = utf8Step(b, j)
        }
        if pa < 0 && pb < 0 { return 0 }
        if pa < 0 { return -1 }
        if pb < 0 { return 1 }
        let ca = pa >> 4
        let cb = pb >> 4
        if isDigitCp(ca) && isDigitCp(cb) {
            if ca == '0' || cb == '0' {
                // left-aligned matching: 015 < 12
                if ca != cb { return signCp(ca, cb) }
                i += stepLen(pa)
                j += stepLen(pb)
                pa = utf8Step(a, i)
                pb = utf8Step(b, j)
                while pa >= 0 && pb >= 0 && isDigitCp(pa >> 4) &&
                        isDigitCp(pb >> 4) {
                    let x = pa >> 4
                    let y = pb >> 4
                    if x != y { return signCp(x, y) }
                    i += stepLen(pa)
                    j += stepLen(pb)
                    pa = utf8Step(a, i)
                    pb = utf8Step(b, j)
                }
                if pa >= 0 && isDigitCp(pa >> 4) { return 1 }
                if pb >= 0 && isDigitCp(pb >> 4) { return -1 }
                // both runs ended: continue the outer loop
            } else {
                // right-aligned matching: 15 < 123
                var last = 0
                while pa >= 0 && pb >= 0 && isDigitCp(pa >> 4) &&
                        isDigitCp(pb >> 4) {
                    let x = pa >> 4
                    let y = pb >> 4
                    if last == 0 && x != y { last = signCp(x, y) }
                    i += stepLen(pa)
                    j += stepLen(pb)
                    pa = utf8Step(a, i)
                    pb = utf8Step(b, j)
                }
                if pa >= 0 && isDigitCp(pa >> 4) { return 1 }
                if pb >= 0 && isDigitCp(pb >> 4) { return -1 }
                if last != 0 { return last }
                // both runs ended equal: continue
            }
        } else {
            var x = ca
            var y = cb
            if fold {
                x = lowerCp(x)
                y = lowerCp(y)
            }
            if x < y { return -1 }
            if x > y { return 1 }
            i += stepLen(pa)
            j += stepLen(pb)
            pa = utf8Step(a, i)
            pb = utf8Step(b, j)
        }
    }
}

// eza's name order: natord::compare (case-sensitive) and
// natord::compare_ignore_case (simple Unicode lowercase). -1, 0 or 1.
pub fn natcmp(a: string, b: string): int {
    if !hasHigh(a) && !hasHigh(b) { return natcmpCore(a, b, false) }
    return natcmpUtf8(a, b, false)
}

pub fn natcmpFold(a: string, b: string): int {
    if !hasHigh(a) && !hasHigh(b) { return natcmpCore(a, b, true) }
    return natcmpUtf8(a, b, true)
}

// eza's QuoteSpaces escaping (src/output/escape.rs). The rule:
//   1. needs = the name contains ' ' or '\'';
//   2. when quoteSpaces && needs, wrap in '"' if the name contains '\'',
//      otherwise in '\'';
//   3. \t, \n and \r become \\t, \\n, \\r; every other byte < 0x20 or 0x7f
//      becomes \u{h} with lowercase hex and no leading zeros; every other byte
//      is copied unchanged (including \\, ", ' and bytes >= 0x80);
//   4. quotes wrap the escaped bytes and embedded quotes are not escaped.
// With quoteSpaces=false no quote characters are added but controls are still
// escaped. The function is byte-wise and does not validate UTF-8.
pub fn quoteName(name: string, quoteSpaces: bool): string {
    var needs = false
    var hasSingle = false
    for i in 0..len(name) {
        let b = name[i]
        if b == ' ' || b == '\'' { needs = true }
        if b == '\'' { hasSingle = true }
    }
    var quote = false
    var q: byte = '\''
    if quoteSpaces && needs {
        quote = true
        if hasSingle { q = '"' }
    }
    var out = new []byte(0)
    if quote { append(out, q) }
    for i in 0..len(name) {
        let b = name[i]
        if b == '\t' {
            append(out, '\\')
            append(out, 't')
        } else if b == '\n' {
            append(out, '\\')
            append(out, 'n')
        } else if b == '\r' {
            append(out, '\\')
            append(out, 'r')
        } else if b < ' ' || b == 127 {
            append(out, '\\')
            append(out, 'u')
            append(out, '{')
            appendHexByte(out, b)
            append(out, '}')
        } else {
            append(out, b)
        }
    }
    if quote { append(out, q) }
    return string(out)
}

// The shared parent prefix of an input operand or symlink target: escape the
// whole parent once with the outer style, then:
//   "" for an empty parent; "/" for parent "/" (the escaped root already ends
//   in a separator, so none is added); otherwise the escaped parent plus "/".
// It does not append a name. "/tmp" gives "/tmp/", "x y/sub" gives
// "'x y/sub'/"; the caller appends the escaped name.
pub fn parentPrefix(parent: string, quoteSpaces: bool): string {
    if len(parent) == 0 { return "" }
    let escaped = quoteName(parent, quoteSpaces)
    if parent == "/" { return escaped }
    return escaped + "/"
}

// The display width of s: each decoded code point contributes widthCp's width
// and each invalid maximal subpart contributes one U+FFFD (width 1), matching
// the reference's lossy display. Printable ASCII is unchanged from E0; C0
// controls and DEL are width 0, not their byte length. This is the
// per-character rule ansi-width applies to eza's painted grid cells; callers
// that lay out columns must not use len(s).
pub fn displayWidth(s: string): int {
    var w = 0
    var i = 0
    while i < len(s) {
        let p = utf8Step(s, i)
        if (p & 1) != 0 {
            w += 1
        } else {
            w += widthCp(p >> 4)
        }
        i += stepLen(p)
    }
    return w
}

// The display width of the text quoteName(name, quoteSpaces) would produce,
// without building it. Grid cells are measured this way before they are
// painted. `name` should already be lossy (valid UTF-8); an invalid byte still
// counts as its U+FFFD replacement. A quoted name adds the two quote
// characters; an escaped control character contributes its rendered length
// (\t, \n and \r are two columns; \u{h} is five or six).
pub fn quotedWidth(name: string, quoteSpaces: bool): int {
    var needs = false
    for i in 0..len(name) {
        let b = name[i]
        if b == ' ' || b == '\'' { needs = true }
    }
    var w = 0
    if quoteSpaces && needs { w += 2 }
    var i = 0
    while i < len(name) {
        let p = utf8Step(name, i)
        let cp = p >> 4
        if (p & 1) != 0 {
            w += 1
        } else if cp == 9 || cp == 10 || cp == 13 {
            w += 2
        } else if cp < 0x20 || cp == 0x7F {
            // \u{h}: backslash, u, {, the lowercase hex digits, }
            w += 5
            if cp >= 16 { w += 1 }
        } else {
            w += widthCp(cp)
        }
        i += stepLen(p)
    }
    return w
}
