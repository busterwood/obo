// obo/lib/strings.obx: byte and string helpers shared by the command-line
// tools and the eza stdlib. It is a source module (`module strings`);
// importers write
//
//     import "../lib/strings.obx" as strings      // from obo/cmd/
//     import "strings.obx" as strings             // from obo/lib/
//
// and reach exported declarations as strings::name. Within a file a declaration
// may use only earlier declarations, so this file keeps its callees first. It is
// dependency-free and defines no main.
//
// The tool rules do not live here: cat's numbering and squeeze state, wc's width
// rule and sort's numeric parser stay in those tools. These functions are byte
// classification, byte ordering, splitting/joining, whitespace trimming, the
// eza natural name order (natord-plus-plus), eza's QuoteSpaces escaping and its
// parent-prefix primitive. The byte helpers stay byte-wise; P6b (E2) adds one
// UTF-8 layer for the reference's name handling: natcmp/natcmpFold decode code
// points, lossy() is Rust's String::from_utf8_lossy (U+FFFD per invalid maximal
// subpart), displayWidth/quotedWidth measure with unicode-width 0.1.14's
// per-character widths (the crate behind ansi-width, which eza's grid uses),
// and isValidUtf8() is the validation eza applies to COLUMNS. The width table
// is generated from that crate and documented at widthCp; its full parity is
// limited to the per-character width rule. Lowercasing for the folded
// comparator is simple single-code-point lowercase over the common Latin,
// Greek, Cyrillic and fullwidth ranges, not Rust's full to_lowercase (which can
// expand one character into several); the divergence is documented at lowerCp.
//
// The P1 compatibility functions (cmpBytes, errText, digits, appendPadded) were
// removed in P2: cmp is the byte-order name that survives, errno text lives in
// errors.obx and number formatting in fmt.obx (design section 4.3).
//
// Ownership follows section 5.0: strings are borrowed, returned strings are
// owed by the caller, and an array parameter is borrowed unless its type is
// owned, as in fromBytes.
module strings

// C-locale whitespace: space, tab, LF, VT, FF, CR
pub fn isSpace(b: byte): bool {
    return b == ' ' || (b >= '\t' && b <= '\r')
}

// the blanks sort -n skips: space and tab only
pub fn isBlank(b: byte): bool {
    return b == ' ' || b == '\t'
}

// C-locale isprint: 0x20..0x7E
pub fn isPrint(b: byte): bool {
    return b >= ' ' && b <= '~'
}

// GNU wc's C-locale word byte: printable and not space (0x21..0x7E)
pub fn isWordByte(b: byte): bool {
    return isPrint(b) && b != ' '
}

// decimal digit '0'..'9' (natord runs)
pub fn isDigit(b: byte): bool {
    return b >= '0' && b <= '9'
}

// unsigned byte-wise lexicographic order; -1, 0 or 1. This is the only
// byte-order name: P1's temporary cmpBytes wrapper was removed in P2.
pub fn cmp(a: string, b: string): int {
    var n = len(a)
    if len(b) < n { n = len(b) }
    for i in 0..n {
        if a[i] < b[i] { return -1 }
        if a[i] > b[i] { return 1 }
    }
    if len(a) < len(b) { return -1 }
    if len(a) > len(b) { return 1 }
    return 0
}

// bytes [start, start+len(sub)) of s equal sub; the caller checks the bounds
fn matchesAt(s: string, start: int, sub: string): bool {
    for i in 0..len(sub) {
        if s[start + i] != sub[i] { return false }
    }
    return true
}

// one lowercase hexadecimal digit, 0..15
fn hexDigit(v: int): byte {
    if v < 10 { return byte('0' + v) }
    return byte('a' + (v - 10))
}

// append the lowercase hex form of a byte with no leading zero: 0 -> "0",
// 0x1b -> "1b", 0x7f -> "7f" (the \u{...} payload of quoteName)
fn appendHexByte(mut out: &[]byte, b: byte) {
    let hi = int(b) / 16
    let lo = int(b) % 16
    if hi > 0 { append(out, hexDigit(hi)) }
    append(out, hexDigit(lo))
}

// natord-plus-plus 2.0.0 compare_iter in its E0 ASCII form (design Appendix A).
// fold selects ASCII A..Z folding; digits are unaffected. Whitespace is skipped
// only at the top of the outer loop, never inside a digit run.
fn natcmpCore(a: string, b: string, fold: bool): int {
    var i = 0
    var j = 0
    while true {
        while i < len(a) && isSpace(a[i]) { i += 1 }
        while j < len(b) && isSpace(b[j]) { j += 1 }
        if i == len(a) && j == len(b) { return 0 }
        if i == len(a) { return -1 }
        if j == len(b) { return 1 }
        let da = isDigit(a[i])
        let db = isDigit(b[j])
        if da && db {
            if a[i] == '0' || b[j] == '0' {
                // left-aligned matching: 015 < 12
                if a[i] != b[j] {
                    if a[i] < b[j] { return -1 }
                    return 1
                }
                i += 1
                j += 1
                while i < len(a) && j < len(b) && isDigit(a[i]) && isDigit(b[j]) {
                    if a[i] != b[j] {
                        if a[i] < b[j] { return -1 }
                        return 1
                    }
                    i += 1
                    j += 1
                }
                if i < len(a) && isDigit(a[i]) { return 1 }
                if j < len(b) && isDigit(b[j]) { return -1 }
                // both runs ended: continue the outer loop
            } else {
                // right-aligned matching: 15 < 123
                var last = 0
                while i < len(a) && j < len(b) && isDigit(a[i]) && isDigit(b[j]) {
                    if last == 0 && a[i] != b[j] {
                        if a[i] < b[j] { last = -1 } else { last = 1 }
                    }
                    i += 1
                    j += 1
                }
                if i < len(a) && isDigit(a[i]) { return 1 }
                if j < len(b) && isDigit(b[j]) { return -1 }
                if last != 0 { return last }
                // both runs ended equal: continue
            }
        } else {
            var ca = a[i]
            var cb = b[j]
            if fold {
                if ca >= 'A' && ca <= 'Z' { ca = byte(ca + 32) }
                if cb >= 'A' && cb <= 'Z' { cb = byte(cb + 32) }
            }
            if ca < cb { return -1 }
            if ca > cb { return 1 }
            i += 1
            j += 1
        }
    }
}

// ------------------------------------------------------------- UTF-8 decoding
//
// utf8Step is the one decoder every UTF-8 function uses. It returns a packed
// value or -1 at the end of the string:
//
//     bits 4..  the code point (0..0x10FFFF; U+FFFD for an invalid sequence)
//     bits 1..3 the bytes consumed (1..4)
//     bit 0     set when the sequence is invalid (a lossy replacement)
//
// Invalid sequences follow Rust's String::from_utf8_lossy exactly: one U+FFFD
// per maximal invalid subpart, so 0xFF is one replacement, E2 82 at the end is
// one replacement for both bytes, E2 82 28 is one replacement plus '(', and an
// overlong or surrogate start byte is one replacement followed by each
// continuation byte's own replacement. A valid U+FFFD is three bytes and never
// has the invalid bit, so the two cases cannot be confused.

fn isCont(b: byte): bool {
    return b >= 0x80 && b <= 0xBF
}

fn utf8Bad(n: int): int {
    return (0xFFFD << 4) | (n << 1) | 1
}

fn utf8Step(s: string, i: int): int {
    if i >= len(s) { return -1 }
    let b = s[i]
    if b < 0x80 {
        return (int(b) << 4) | 2
    }
    if b >= 0xC2 && b <= 0xDF {
        if i + 1 < len(s) && isCont(s[i + 1]) {
            let cp = ((int(b) & 0x1F) << 6) | (int(s[i + 1]) & 0x3F)
            return (cp << 4) | 4
        }
        return utf8Bad(1)
    }
    if b >= 0xE0 && b <= 0xEF {
        if i + 1 >= len(s) { return utf8Bad(1) }
        let b2 = s[i + 1]
        var ok2 = isCont(b2)
        if b == 0xE0 && b2 < 0xA0 { ok2 = false }
        if b == 0xED && b2 >= 0xA0 { ok2 = false }
        if !ok2 { return utf8Bad(1) }
        if i + 2 >= len(s) { return utf8Bad(2) }
        let b3 = s[i + 2]
        if !isCont(b3) { return utf8Bad(2) }
        let cp = ((int(b) & 0x0F) << 12) | ((int(b2) & 0x3F) << 6) |
                 (int(b3) & 0x3F)
        return (cp << 4) | 6
    }
    if b >= 0xF0 && b <= 0xF4 {
        if i + 1 >= len(s) { return utf8Bad(1) }
        let b2 = s[i + 1]
        var ok2 = isCont(b2)
        if b == 0xF0 && b2 < 0x90 { ok2 = false }
        if b == 0xF4 && b2 > 0x8F { ok2 = false }
        if !ok2 { return utf8Bad(1) }
        if i + 2 >= len(s) { return utf8Bad(2) }
        let b3 = s[i + 2]
        if !isCont(b3) { return utf8Bad(2) }
        if i + 3 >= len(s) { return utf8Bad(3) }
        let b4 = s[i + 3]
        if !isCont(b4) { return utf8Bad(3) }
        let cp = ((int(b) & 0x07) << 18) | ((int(b2) & 0x3F) << 12) |
                 ((int(b3) & 0x3F) << 6) | (int(b4) & 0x3F)
        return (cp << 4) | 8
    }
    // 0x80..0xC1 (continuation or overlong) and 0xF5..0xFF
    return utf8Bad(1)
}

// the byte count of a packed step
fn stepLen(p: int): int {
    return (p >> 1) & 7
}

// True when s is well-formed UTF-8 (Rust str validation).
pub fn isValidUtf8(s: string): bool {
    var i = 0
    while i < len(s) {
        let p = utf8Step(s, i)
        if (p & 1) != 0 { return false }
        i += stepLen(p)
    }
    return true
}

// Rust String::from_utf8_lossy: invalid sequences become U+FFFD and every
// valid sequence keeps its exact bytes. A valid string is returned unchanged
// (no copy).
pub fn lossy(s: string): string {
    if isValidUtf8(s) { return s }
    var out = new []byte(0)
    var i = 0
    while i < len(s) {
        let p = utf8Step(s, i)
        let cp = p >> 4
        let n = stepLen(p)
        if (p & 1) != 0 {
            append(out, byte(0xEF))
            append(out, byte(0xBF))
            append(out, byte(0xBD))
        } else {
            for k in 0..n { append(out, s[i + k]) }
        }
        i += n
    }
    return string(out)
}

// Rust char::is_whitespace (the White_Space property): the exact set the
// reference's natord compares skip. ASCII space and 0x09..0x0D are included.
fn isUnicodeSpace(cp: int): bool {
    if cp == 0x20 { return true }
    if cp >= 0x09 && cp <= 0x0D { return true }
    if cp == 0x85 || cp == 0xA0 || cp == 0x1680 { return true }
    if cp >= 0x2000 && cp <= 0x200A { return true }
    if cp == 0x2028 || cp == 0x2029 || cp == 0x202F { return true }
    if cp == 0x205F || cp == 0x3000 { return true }
    return false
}

// Simple single-code-point Unicode lowercase for the common blocks: ASCII,
// Latin-1 Supplement, Latin Extended-A, the basic Greek and Cyrillic blocks and
// fullwidth A-Z. Rust's char::to_lowercase() is full Unicode lowercase; it can
// expand one character into several (U+0130 is "i" plus a combining dot) and it
// covers every script. Outside these blocks 1,234 scalar values (542 ranges)
// still compare by their original code point, the documented divergence;
// U+0130 is the only multi-character expansion and is deliberately left
// unfolded.
fn lowerCp(cp: int): int {
    if cp >= 'A' && cp <= 'Z' { return cp + 32 }
    if cp >= 0xC0 && cp <= 0xD6 { return cp + 32 }
    if cp >= 0xD8 && cp <= 0xDE { return cp + 32 }
    if cp >= 0x100 && cp <= 0x137 && cp != 0x130 && cp % 2 == 0 {
        return cp + 1
    }
    if cp >= 0x139 && cp <= 0x148 && cp % 2 == 1 { return cp + 1 }
    if cp >= 0x14A && cp <= 0x177 && cp % 2 == 0 { return cp + 1 }
    if cp == 0x178 { return 0xFF }
    if cp >= 0x179 && cp <= 0x17E && cp % 2 == 1 { return cp + 1 }
    if cp == 0x386 { return 0x3AC }
    if cp >= 0x388 && cp <= 0x38A { return cp + 37 }
    if cp == 0x38C { return 0x3CC }
    if cp >= 0x38E && cp <= 0x38F { return cp + 63 }
    if cp >= 0x391 && cp <= 0x3A1 { return cp + 32 }
    if cp >= 0x3A3 && cp <= 0x3AB { return cp + 32 }
    if cp == 0x3CF { return 0x3D7 }
    if cp >= 0x400 && cp <= 0x40F { return cp + 80 }
    if cp >= 0x410 && cp <= 0x42F { return cp + 32 }
    if cp >= 0xFF21 && cp <= 0xFF3A { return cp + 32 }
    return cp
}

// The per-character display width of unicode-width 0.1.14 (the crate
// ansi-width 0.1.0 uses, and therefore the width eza's grid measures with).
// The crate returns None for a control character, and ansi_width treats None as
// 0. The ranges below were generated by enumerating U+00A0..U+10FFFF against
// the crate's single_char_width; every range has width 0 or 2 (plus U+17D8,
// width 3) and every code point outside them is width 1. Surrogates cannot
// occur in decoded UTF-8. This is the full per-character table; the crate's
// string-level ligature rules do not apply because ansi-width measures each
// char independently.
fn widthCp(cp: int): int {
    if cp < 0x20 { return 0 }
    if cp < 0x7F { return 1 }
    if cp < 0xA0 { return 0 }
    if cp == 0xAD { return 0 }
    if cp >= 0x300 && cp <= 0x36F { return 0 }
    if cp >= 0x483 && cp <= 0x489 { return 0 }
    if cp >= 0x591 && cp <= 0x5BD { return 0 }
    if cp == 0x5BF { return 0 }
    if cp >= 0x5C1 && cp <= 0x5C2 { return 0 }
    if cp >= 0x5C4 && cp <= 0x5C5 { return 0 }
    if cp == 0x5C7 { return 0 }
    if cp == 0x605 { return 0 }
    if cp >= 0x610 && cp <= 0x61A { return 0 }
    if cp == 0x61C { return 0 }
    if cp >= 0x64B && cp <= 0x65F { return 0 }
    if cp == 0x670 { return 0 }
    if cp >= 0x6D6 && cp <= 0x6DC { return 0 }
    if cp >= 0x6DF && cp <= 0x6E4 { return 0 }
    if cp >= 0x6E7 && cp <= 0x6E8 { return 0 }
    if cp >= 0x6EA && cp <= 0x6ED { return 0 }
    if cp == 0x70F { return 0 }
    if cp == 0x711 { return 0 }
    if cp >= 0x730 && cp <= 0x74A { return 0 }
    if cp >= 0x7A6 && cp <= 0x7B0 { return 0 }
    if cp >= 0x7EB && cp <= 0x7F3 { return 0 }
    if cp == 0x7FD { return 0 }
    if cp >= 0x816 && cp <= 0x819 { return 0 }
    if cp >= 0x81B && cp <= 0x823 { return 0 }
    if cp >= 0x825 && cp <= 0x827 { return 0 }
    if cp >= 0x829 && cp <= 0x82D { return 0 }
    if cp >= 0x859 && cp <= 0x85B { return 0 }
    if cp >= 0x890 && cp <= 0x891 { return 0 }
    if cp >= 0x898 && cp <= 0x89F { return 0 }
    if cp >= 0x8CA && cp <= 0x902 { return 0 }
    if cp == 0x93A { return 0 }
    if cp == 0x93C { return 0 }
    if cp >= 0x941 && cp <= 0x948 { return 0 }
    if cp == 0x94D { return 0 }
    if cp >= 0x951 && cp <= 0x957 { return 0 }
    if cp >= 0x962 && cp <= 0x963 { return 0 }
    if cp == 0x981 { return 0 }
    if cp == 0x9BC { return 0 }
    if cp == 0x9BE { return 0 }
    if cp >= 0x9C1 && cp <= 0x9C4 { return 0 }
    if cp == 0x9CD { return 0 }
    if cp == 0x9D7 { return 0 }
    if cp >= 0x9E2 && cp <= 0x9E3 { return 0 }
    if cp == 0x9FE { return 0 }
    if cp >= 0xA01 && cp <= 0xA02 { return 0 }
    if cp == 0xA3C { return 0 }
    if cp >= 0xA41 && cp <= 0xA42 { return 0 }
