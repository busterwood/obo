// wc: count lines, words and bytes, with -l, -w and -c.
//
// Built as a module root by tools/build_tools.py: it imports lib/io.obx as
// `io`, lib/fmt.obx as `fmt` and lib/errors.obx as `errors`, and every library
// name is qualified. The subset is deliberate:
// -m, -L, --files0-from, long options, --help and --version are unsupported
// (see cmd/README.md).
//
// The C-locale word rule is GNU's: whitespace (space, tab, LF, VT, FF, CR) ends
// a word, a printable byte 0x21..0x7E starts or continues one, and every other
// byte (NUL, the other controls, 0x7F..0xFF) is ignored -- it neither starts nor
// ends a word. Word state resets for each operand; a final line without a
// newline is not counted as a line.
//
// Performance: each requested column takes its own path, because scanning for
// counts nobody asked for is waste. -c only sums chunk lengths and never looks
// at a byte. -l runs a newline-only loop unrolled 32 bytes with four
// accumulators (no per-byte byte count, no word state); the unroll removes loop
// overhead and keeps the four conditional-add chains independent. When -w is
// selected the single word state machine counts words and, if -l is also
// selected, lines in one pass: -lw and -lwc cost about what -w alone costs, and
// a separate newline pass is measurably slower. The word loop keeps its state
// and counters in locals and writes them back once per chunk. Every load is a
// bounds-checked byte load; there is no word-at-a-time builtin, so this is the
// pure-obo floor (GNU's -l speed comes from memchr, which is SIMD).
//
// Output is delayed until every operand has been scanned, because the width
// depends on the total size. Phase 2 has no stat, so the tool uses the bytes it
// counted: width 0 for one output line with one selected column, otherwise
// max(7 if any operand's size is unknown (stdin or a directory read error),
// digits(bytes counted on non-stdin operands)). GNU's metadata-based width
// differs for unreadable, non-regular and regular-file-stdin operands; see the
// README for the documented divergences and the cases the harness keeps out.
//
// Open/read errors print `wc: <operand>: <text>`, set failed and continue; a
// directory's (zero) counts still print. Write errors print `wc: write error`
// (no operand, no errno text), exit 1. The delayed output is flushed before the
// failure exit so the counts and the error both appear.

import "../lib/io.obx" as io
import "../lib/fmt.obx" as fmt
import "../lib/errors.obx" as errors

type Counts = ref record {
    lines: int
    words: int
    bytes: int
    inWord: int        // 1 inside a word at the end of the last chunk, else 0
}

type WcStat = ref record {
    label: string      // the operand name, or "-" for stdin
    counts: Counts
    unknown: bool      // stdin, or a read that failed with EISDIR
    isStdin: bool      // its bytes are excluded from the width sum
}

type WcOpts = ref record {
    lines: bool
    words: bool
    bytes: bool
}

// Newline-only scan, used when lines are requested and words are not; the
// caller adds len(data) to the byte count. The 32-byte unroll with four
// accumulators was the fastest shape measured: the four conditional-add chains
// are independent and the loop condition runs once per 32 bytes. The tail handles
// the last 0..31 bytes of every chunk (a chunk can end anywhere).
fn scanLines(mut c: &Counts, data: &[]byte) {
    var a0 = 0
    var a1 = 0
    var a2 = 0
    var a3 = 0
    let n = len(data)
    var i = 0
    while i + 32 <= n {
        if data[i] == '\n' { a0 += 1 }
        if data[i + 1] == '\n' { a1 += 1 }
        if data[i + 2] == '\n' { a2 += 1 }
        if data[i + 3] == '\n' { a3 += 1 }
        if data[i + 4] == '\n' { a0 += 1 }
        if data[i + 5] == '\n' { a1 += 1 }
        if data[i + 6] == '\n' { a2 += 1 }
        if data[i + 7] == '\n' { a3 += 1 }
        if data[i + 8] == '\n' { a0 += 1 }
        if data[i + 9] == '\n' { a1 += 1 }
        if data[i + 10] == '\n' { a2 += 1 }
        if data[i + 11] == '\n' { a3 += 1 }
        if data[i + 12] == '\n' { a0 += 1 }
        if data[i + 13] == '\n' { a1 += 1 }
        if data[i + 14] == '\n' { a2 += 1 }
        if data[i + 15] == '\n' { a3 += 1 }
        if data[i + 16] == '\n' { a0 += 1 }
        if data[i + 17] == '\n' { a1 += 1 }
        if data[i + 18] == '\n' { a2 += 1 }
        if data[i + 19] == '\n' { a3 += 1 }
        if data[i + 20] == '\n' { a0 += 1 }
        if data[i + 21] == '\n' { a1 += 1 }
        if data[i + 22] == '\n' { a2 += 1 }
        if data[i + 23] == '\n' { a3 += 1 }
        if data[i + 24] == '\n' { a0 += 1 }
        if data[i + 25] == '\n' { a1 += 1 }
        if data[i + 26] == '\n' { a2 += 1 }
        if data[i + 27] == '\n' { a3 += 1 }
        if data[i + 28] == '\n' { a0 += 1 }
        if data[i + 29] == '\n' { a1 += 1 }
        if data[i + 30] == '\n' { a2 += 1 }
        if data[i + 31] == '\n' { a3 += 1 }
        i += 32
    }
    while i < n {
        if data[i] == '\n' { a0 += 1 }
        i += 1
    }
    c.lines += a0 + a1 + a2 + a3
}

// Word-only scan, used when words are requested and lines are not; the caller
// adds len(data) to the byte count. The C-locale rule is inline
// (strings::isSpace/isWordByte are correct but a call per byte is far too
// slow). The state is an int so the common word byte updates it with
// `words += 1 - inWord` instead of a nested branch; the 0/1 int is the same state
// as a bool. Whitespace is space or 0x09..0x0D; word bytes are 0x21..0x7E;
// everything else leaves the state alone, so `a\0b` stays one word.
fn scanWords(mut c: &Counts, data: &[]byte) {
    var words = c.words
    var inw = c.inWord
    let n = len(data)
    var i = 0
    while i < n {
        let b = data[i]
        if b >= '!' {
            if b <= '~' {
                words += 1 - inw
                inw = 1
            }
        } else if b == ' ' || (b >= '\t' && b <= '\r') {
            inw = 0
        }
        i += 1
    }
    c.words = words
    c.inWord = inw
}

// Words and lines in one pass. A separate newline pass would read every chunk
// twice and measured slower than this extra newline test, which only runs in the
// whitespace branch (so it is one comparison per byte outside it).
fn scanWordsLines(mut c: &Counts, data: &[]byte) {
    var words = c.words
    var lines = c.lines
    var inw = c.inWord
    let n = len(data)
    var i = 0
    while i < n {
        let b = data[i]
        if b >= '!' {
            if b <= '~' {
                words += 1 - inw
                inw = 1
            }
        } else if b == ' ' || (b >= '\t' && b <= '\r') {
            if b == '\n' { lines += 1 }
            inw = 0
        }
        i += 1
    }
    c.words = words
    c.lines = lines
    c.inWord = inw
}

fn countReader(mut r: &io::Reader, mut c: &Counts, opts: &WcOpts): Result[bool] {
    while true {
        let more = try io::fill(r)
        if !more { return ok(true) }
        let chunk = io::takeChunk(r)
        c.bytes += len(chunk)
        if opts.words {
            if opts.lines { scanWordsLines(c, &chunk) } else { scanWords(c, &chunk) }
        } else if opts.lines {
            scanLines(c, &chunk)
        }
    }
}

// Scan one operand and append its stat. Returns false when the operand failed
// (open error: no stat; read error: the partial counts are still appended).
// Stdin is never opened or closed.
fn wcOperand(path: string, label: string, opts: &WcOpts, mut stats: &[]WcStat): bool {
    var c = new Counts{lines: 0, words: 0, bytes: 0, inWord: 0}
    if path == "-" {
        var r = io::newReader(stdin(), 65536)
        let rr = countReader(r, c, opts)
        match rr {
            ok {
                append(stats, new WcStat{label: label, counts: c, unknown: true, isStdin: true})
                return true
            }
            err {
                eprintln("wc: -: ", errors::text(rr.code))
                append(stats, new WcStat{label: label, counts: c, unknown: true, isStdin: true})
                return false
            }
        }
    }
    let f = openFile(path, "r")
    match f {
        ok {
            let fd = f.value
            defer closeFile(fd)
            var r = io::newReader(fd, 65536)
            let rr = countReader(r, c, opts)
            match rr {
                ok {
                    append(stats, new WcStat{label: path, counts: c, unknown: false, isStdin: false})
                    return true
                }
                err {
                    eprintln("wc: ", path, ": ", errors::text(rr.code))
                    var unknown = false
                    if rr.code == 21 { unknown = true }
                    append(stats, new WcStat{label: path, counts: c, unknown: unknown, isStdin: false})
                    return false
                }
            }
        }
        err {
            eprintln("wc: ", path, ": ", errors::text(f.code))
            return false
        }
    }
}

fn columnCount(opts: &WcOpts): int {
    var n = 0
    if opts.lines { n += 1 }
    if opts.words { n += 1 }
    if opts.bytes { n += 1 }
    return n
}

// One output line: the selected counts in l/w/c order, right-aligned to width,
// single spaces between fields (no leading separator), then the label if any.
fn emitStat(mut w: &io::Writer, s: &WcStat, opts: &WcOpts, width: int): Result[bool] {
    var first = true
    if opts.lines {
        try fmt::writePadded(w, s.counts.lines, width)
        first = false
    }
    if opts.words {
        if !first { try io::write(w, " ") }
        try fmt::writePadded(w, s.counts.words, width)
        first = false
    }
    if opts.bytes {
        if !first { try io::write(w, " ") }
        try fmt::writePadded(w, s.counts.bytes, width)
        first = false
    }
    if len(s.label) > 0 {
        try io::write(w, " ")
        try io::write(w, s.label)
    }
    try io::write(w, "\n")
    return ok(true)
}

// Apply one short-option character; false means it is not one of ours.
fn setOpt(mut o: &WcOpts, c: byte): bool {
    if c == 'l' { o.lines = true; return true }
    if c == 'w' { o.words = true; return true }
    if c == 'c' { o.bytes = true; return true }
    return false
}

fn main() {
    let argv = args()
    var opts = new WcOpts{lines: false, words: false, bytes: false}
    var operands = new []string(0)
    var endOpts = false
    var i = 1
    while i < len(argv) {
        let a = argv[i]
        if !endOpts && a == "--" {
            endOpts = true
        } else if !endOpts && len(a) > 1 && a[0] == '-' {
            if len(a) > 2 && a[1] == '-' {
                eprintln("wc: unrecognized option '", a, "'")
                exit(1)
            }
            var j = 1
            while j < len(a) {
                let c = a[j]
                if !setOpt(opts, c) {
                    let ch = substr(a, j, j + 1)
                    eprintln("wc: invalid option -- '", ch, "'")
                    exit(1)
                }
                j += 1
            }
        } else {
            append(operands, a)
        }
        i += 1
    }
    if columnCount(opts) == 0 {
        opts.lines = true
        opts.words = true
        opts.bytes = true
    }

    var stats = new []WcStat(0)
    var failed = false
    if len(operands) == 0 {
        if !wcOperand("-", "", opts, stats) { failed = true }
    } else {
        var k = 0
        while k < len(operands) {
            let p = operands[k]
            if !wcOperand(p, p, opts, stats) { failed = true }
            k += 1
        }
    }

    // the width is chosen once, from every line that will print
    var operandCount = len(operands)
    if operandCount == 0 { operandCount = 1 }
    var printedLines = len(stats)
    if operandCount > 1 { printedLines += 1 }
    var width = 0
    if !(len(stats) == 1 && operandCount == 1 && columnCount(opts) == 1) {
        var sizeSum = 0
        var anyUnknown = false
        var si = 0
        while si < len(stats) {
            if !stats[si].isStdin { sizeSum += stats[si].counts.bytes }
            if stats[si].unknown { anyUnknown = true }
            si += 1
        }
        width = fmt::digits(sizeSum)
        if anyUnknown && width < 7 { width = 7 }
    }

    var total = new Counts{lines: 0, words: 0, bytes: 0, inWord: 0}
    var ti = 0
    while ti < len(stats) {
        total.lines += stats[ti].counts.lines
        total.words += stats[ti].counts.words
        total.bytes += stats[ti].counts.bytes
        ti += 1
    }

    var w = io::newWriter(stdout(), 65536)
    var ei = 0
    while ei < len(stats) {
        let er = emitStat(w, stats[ei], opts, width)
        match er {
            ok { }
            err {
                eprintln("wc: write error")
                exit(1)
            }
        }
        ei += 1
    }
    let ts = new WcStat{label: "total", counts: total, unknown: false, isStdin: false}
    if operandCount > 1 {
        let er = emitStat(w, ts, opts, width)
        match er {
            ok { }
            err {
                eprintln("wc: write error")
                exit(1)
            }
        }
    }
    let fl = io::flush(w)
    match fl {
        ok { }
        err {
            eprintln("wc: write error")
            exit(1)
        }
    }
    if failed { exit(1) }
}
