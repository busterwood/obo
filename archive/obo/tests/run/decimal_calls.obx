// Decimal parameters are passed by value in 24-byte slots; decimal returns use
// a hidden destination pointer; recurse and mix one-word parameters around them.

fn add(a: decimal, b: decimal): decimal { return a + b }
fn mix(a: decimal, n: int, b: decimal, m: int): decimal {
    return a + b + decimal(n + m)
}
fn after(n: int, a: decimal): decimal { return a + decimal(n) }
fn count(n: int): decimal {
    if n == 0 { return 1.0 }
    return count(n - 1) + 1.0
}
fn deferred(): decimal {
    defer { println("d1") }
    defer { println("d2") }
    return 1.50
}
fn main() {
    println(add(1.20, 2.3)) // expect: 3.50
    println(mix(1.0, 2, 3.00, 4)) // expect: 10.00
    println(after(2, 1.00)) // expect: 3.00
    println(count(5)) // expect: 6.0
    println(deferred()) // expect: d2
                        // expect: d1
                        // expect: 1.50
    var x = add(0.1, 0.2)
    println(x) // expect: 0.3
    x += 1.00
    println(x) // expect: 1.30
    x *= 2.0
    println(x) // expect: 2.600
    x %= 0.7
    println(x) // expect: 0.500
}
