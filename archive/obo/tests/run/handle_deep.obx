type Item = ref record { v: int; kids: []Item }
type Bag = ref record { items: []Item; vals: []int; n: int }

// a reference parameter names the record, not the array a change through a handle frees:
// reading it afresh afterwards is fine
fn both(p: &Bag, h: ^Bag): int {
    h.items = new []Item(0)
    return len(p.items)
}

// a change through a handle frees only what is below its target
fn cut(h: ^Bag) {
    h.items = new []Item(0)
}

// a scalar written through a handle frees nothing
fn setN(h: ^Bag) {
    h.n = 5
}

// a scalar array truncated through a handle frees nothing
fn clearVals(h: ^Bag) {
    truncate(h.vals, 0)
}

// a reference inside something survives a scalar array truncated through a handle
fn trimVals(n: &Item, h: ^Bag): int {
    let kids = &n.kids
    truncate(h.vals, 0)
    return len(kids)
}

// a read through a handle, passed a reference inside something: no change, so no invalidation
fn peek(a: &Item, h: ^Bag): int {
    return a.v + len(h.items)
}

// a recursive tree walk with references inside something passed down, in a function that writes nothing
fn sumTree(n: &Item): int {
    var t = n.v
    let kids = &n.kids
    for k in kids { t += sumTree(k) }
    return t
}

// a recursive writer that points its reference elsewhere before using it: the old reference is not used
fn repoint(n: &Item, h: ^Bag, d: int): int {
    var k = &n.kids[0]
    if d > 0 { repoint(n, h, d - 1) }
    k = &n.kids[0]
    let v = k.v
    h.items = new []Item(0)
    return v
}

// a recursive writer that passes only a whole object to itself, and uses nothing inside something
fn countDown(n: &Item, h: ^Bag, d: int) {
    if d > 0 { countDown(n, h, d - 1) }
    h.items = new []Item(0)
}

// a reference re-pointed on both branches of an if after a recursive call: each path points it afresh, so it is valid
fn both2(n: &Item, h: ^Bag, d: int): int {
    var r = &n.kids[0]
    if d > 0 { both2(n, h, d - 1) }
    if d > 0 { r = &n.kids[0] } else { r = &n.kids[1] }
    let v = r.v
    h.items = new []Item(0)
    return v
}

// a writer of the kids of an item, which refills them with one item
fn refillKids(h: ^Item) {
    h.kids = new []Item(0)
    append(h.kids, new Item{v: 9, kids: new []Item(0)})
}

// a loop body that always returns: its one pass's suspicion does not leave the loop
fn retLeak(n: &Item, h: ^Item, d: int): int {
    var k = &n.kids[0]
    var i = 5
    while i < 2 {
        retLeak(n, h, d - 1)
        if i == 7 { k = n }
        return 0
    }
    println(k.v)
    h.kids = new []Item(0)
    return 1
}

// a deferred recursive call runs where the block ends: nothing is read after it
fn deferRec(n: &Item, h: ^Item, d: int) {
    if d == 0 {
        refillKids(h)
        return
    }
    var k = &n.kids[0]
    defer { if d > 0 { deferRec(n, h, d - 1) } }
    println(k.v)
    refillKids(h)
}

// a deferred recursive call inside an if block: the use inside the block comes before the call
fn deferInIf(n: &Item, h: ^Item, d: int) {
    var k = &n.kids[0]
    if d > 0 {
        defer { deferInIf(n, h, d - 1) }
        println(k.v)
    }
}

// a reference pointed afresh after each recursive call, before its use on the next iteration
fn loopRepoint(n: &Item, h: ^Item, d: int) {
    var k = &n.kids[0]
    var i = 0
    while i < 2 {
        if d > 0 { loopRepoint(n, h, d - 1) }
        k = &n.kids[0]
        println(k.v)
        i += 1
    }
    refillKids(h)
}

// a recursive call in a loop leaves a reference suspect where the next iteration starts, and nothing reads it again
fn unusedRef(n: &Item, h: ^Item, d: int) {
    var k = &n.kids[0]
    var i = 0
    while i < 2 {
        if d > 0 { unusedRef(n, h, d - 1) }
        if i == 1 { k = n }
        i += 1
    }
    refillKids(h)
}

// a reference pointed afresh after the recursive call on each branch, read on the next iteration
fn loopBothRepoint(n: &Item, h: ^Item, d: int) {
    var k = &n.kids[0]
    var i = 0
    while i < 2 {
        println(k.v)
        i += 1
        if d > 0 { loopBothRepoint(n, h, d - 1) }
        if i == 2 { k = &n.kids[0] } else { k = &n.kids[0] }
    }
    refillKids(h)
}

fn main() {
    var bag = new Bag{items: new []Item(0), vals: new []int(0), n: 0}
    append(bag.items, new Item{v: 1, kids: new []Item(0)})
    var root = new Item{v: 1, kids: new []Item(0)}
    append(root.kids, new Item{v: 2, kids: new []Item(0)})
    println(sumTree(root))                // expect: 3
    let h = handle(bag)
    let first = &bag.items[0]
    println(first.v)                      // expect: 1
    setN(h)
    println(first.v)                      // expect: 1
    println(bag.n)                        // expect: 5
    println(peek(first, h))               // expect: 2
    append(bag.vals, 7)
    clearVals(h)
    println(first.v)                      // expect: 1
    println(trimVals(root, h))            // expect: 1
    let q = &bag                          // a whole object: a change through a handle leaves it valid
    cut(h)
    println(len(q.items))                 // expect: 0
    countDown(root, h, 2)
    println(repoint(root, h, 1))          // expect: 2
    println(both(bag, handle(bag)))       // expect: 0
    var top = new Item{v: 5, kids: new []Item(0)}
    append(top.kids, new Item{v: 3, kids: new []Item(0)})
    append(top.kids, new Item{v: 4, kids: new []Item(0)})
    println(both2(top, handle(bag), 2))   // expect: 3
    var root2 = new Item{v: 1, kids: new []Item(0)}
    append(root2.kids, new Item{v: 2, kids: new []Item(0)})
    println(retLeak(root2, handle(root2), 0))   // expect: 2
                                                  // expect: 1
    var root3 = new Item{v: 1, kids: new []Item(0)}
    append(root3.kids, new Item{v: 2, kids: new []Item(0)})
    deferRec(root3, handle(root3), 1)           // expect: 2
    var root4 = new Item{v: 1, kids: new []Item(0)}
    append(root4.kids, new Item{v: 2, kids: new []Item(0)})
    deferInIf(root4, handle(root4), 1)          // expect: 2
    var root5 = new Item{v: 1, kids: new []Item(0)}
    append(root5.kids, new Item{v: 2, kids: new []Item(0)})
    loopRepoint(root5, handle(root5), 1)        // expect: 2
                                                  // expect: 2
                                                  // expect: 9
                                                  // expect: 9
                                                  // expect: 9
                                                  // expect: 9
    var root6 = new Item{v: 1, kids: new []Item(0)}
    append(root6.kids, new Item{v: 2, kids: new []Item(0)})
    loopBothRepoint(root6, handle(root6), 1)    // expect: 2
                                                  // expect: 2
                                                  // expect: 2
                                                  // expect: 9
                                                  // expect: 9
                                                  // expect: 9
    var root7 = new Item{v: 1, kids: new []Item(0)}
    append(root7.kids, new Item{v: 2, kids: new []Item(0)})
    unusedRef(root7, handle(root7), 1)
    println(1)                                    // expect: 1
}
