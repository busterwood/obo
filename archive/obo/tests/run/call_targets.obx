// The forms that stay accepted once compound assignments, append, truncate, replace and
// indexes check their targets across calls: the value or index computed first, a pure call
// beside a field, and a whole local array held across a call that only borrows it or passes it
// as a mut argument. A call that takes it by value is refused there (tests/errors/call_targets.obx).
type Item = ref record { v: int; kids: []Item }

var gscratch = new []Item(0)
var gtotal = 0

fn mkItem(v: int): Item { return new Item{v: v, kids: new []Item(0)} }
fn rebuild(mut a: &[]Item): int { a[0] = mkItem(50); return 1 }
fn sumOf(a: &[]Item): int { return len(a) }
fn freeOther(): int { gscratch = new []Item(0); return 2 }
fn fresh(): Item { gscratch = new []Item(0); return mkItem(6) }
fn pick(mut a: &[]Item): int { append(a, mkItem(9)); return 1 }
fn bumpTotal(): int { gtotal += 1; return 3 }
fn eatItems(a: []Item): int { return 1 }        // takes an array by value: it moves it
fn lastOf(a: &[]Item): int { return len(a) - 1 }
type IBag = ref record { items: []Item }
fn borrowBag(b: &IBag): int { return 0 }            // borrows the record: nothing is moved
fn moveBag(b: IBag): int { return 0 }               // takes the record by value
fn idxG(a: &[][]int): int { return 0 }
fn rebuildArr(a: []Item): []Item { return new []Item(0) }
type Two = ref record { items: []Item; opt: ?IBag }
fn sinkOptB(b: ?IBag): int { return 0 }             // pure: consumes the optional it is given
fn sinkIt(a: []Item): int { return 0 }              // pure: consumes the array it is given
fn sinkIBag(b: IBag): int { return 0 }              // pure: consumes the record it is given
fn sinkOptItem(n: ?Item): int { return 0 }          // pure: consumes the optional item it is given
fn passOptIB(b: ?IBag): ?IBag { return b }     // pure: returns the optional it is given

fn main() {
    var a = new []Item(0)
    append(a, mkItem(1))
    let r = rebuild(a)              // the call goes first
    a[0].v += r                     // the value is computed before the target is located
    println(a[0].v)                 // expect: 51
    a[0].v += sumOf(a)              // a pure call beside a field: no freeing
    println(a[0].v)                 // expect: 52
    append(a, fresh())              // a call that frees a global, beside a whole local array
    println(len(a))                 // expect: 2
    let old = replace(a, new []Item(0))
    println(len(old))              // expect: 2
    var xs = new []Item(0)
    append(xs, mkItem(3))
    append(xs, fresh())             // the array is a whole local: no call can free it
    println(len(xs))                // expect: 2
    truncate(xs, freeOther() - 1)   // the count's call frees a global, not xs
    println(len(xs))                // expect: 1
    // the index is taken after the call made the array longer
    println(xs[pick(xs)].v)         // expect: 9
    var n = mkItem(1)
    append(n.kids, mkItem(2))
    let g = bumpTotal()
    n.kids[0].v += g                // computed first
    println(n.kids[0].v)            // expect: 5
    // a borrow and a mut argument may be called in an index of a whole array: neither moves its header
    var ys = new []Item(0)
    append(ys, mkItem(4))
    append(ys, mkItem(5))
    println(ys[lastOf(ys)].v)       // expect: 5
    println(ys[pick(ys)].v)         // expect: 5
    // another array moved by a call in the index: the array indexed is not the one moved
    println(ys[eatItems(xs)].v)     // expect: 5
    // a field's array indexed through a borrow of its record: nothing is moved
    var bg = new IBag{items: new []Item(0)}
    append(bg.items, mkItem(7))
    println(bg.items[borrowBag(bg)].v)   // expect: 7
    // the index is closed before a later operand moves the record
    println(bg.items[0].v + moveBag(bg)) // expect: 7
    // a reference to a whole array indexed by a pure borrow of it
    var rs = new []Item(0)
    append(rs, mkItem(3))
    let rr = &rs
    println(rr[lastOf(rs)].v)       // expect: 3
    // a whole local array reassigned from a call that takes it by value: the owner is the target
    rs = rebuildArr(rs)
    println(len(rs))                // expect: 0
    // a grid indexed in its inner index by a borrow of the grid
    var grid = new [][]int(0)
    var row = new []int(0)
    append(row, 5)
    append(grid, row)
    println(grid[0][idxG(grid)])    // expect: 5
    // a take of an optional field, beside an array indexed in its record: the taken object is not the array's
    var t = new Two{items: new []Item(0), opt: new IBag{items: new []Item(0)}}
    append(t.items, mkItem(1))
    println(t.items[sinkOptB(take(t.opt))].v)      // expect: 1
    // a replace of another array in an index: the array indexed is not the one replaced
    var oth = new []Item(0)
    append(oth, mkItem(3))
    var cb = new IBag{items: new []Item(0)}
    append(cb.items, mkItem(7))
    println(cb.items[sinkIt(replace(oth, new []Item(0)))].v)   // expect: 7
    // a whole record replaced, its old value consumed in the index of the new one's array
    var rb = new IBag{items: new []Item(0)}
    append(rb.items, mkItem(8))
    let oldRb = replace(rb, new IBag{items: new []Item(0)})
    append(rb.items, mkItem(8))
    println(rb.items[sinkIBag(oldRb)].v)             // expect: 8
    // a handle to an object, indexed with a temporary moved in the index: the temporary is not its target
    var hb = new IBag{items: new []Item(0)}
    append(hb.items, mkItem(4))
    let hh = handle(hb)
    println(hh.items[sinkIBag(new IBag{items: new []Item(0)})].v)   // expect: 4
    // an element taken from the array indexed: the array header is not freed, only the element
    var xo = new []?Item(0)
    append(xo, mkItem(1))
    append(xo, mkItem(2))
    xo[sinkOptItem(take(xo[1]))] = mkItem(7)
    println(len(xo))                               // expect: 2
    // a value that takes the optional field it is assigned to: take leaves the field nil and the store writes
    // the place, so it is not freed (only an ancestor of the place is)
    var tk = new Two{items: new []Item(0), opt: new IBag{items: new []Item(0)}}
    append(tk.items, mkItem(6))
    tk.opt = passOptIB(take(tk.opt))
    println(tk.items[0].v)                         // expect: 6
}
