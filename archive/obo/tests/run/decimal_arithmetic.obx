// Exact + - * % and display propagation: add/sub max scale, multiply sum,
// remainder max; unary minus preserves scale.

fn main() {
    println(1.20 + 1.2)              // expect: 2.40
    println(5.00 - 2.5)              // expect: 2.50
    println(1.20 * 1.2)              // expect: 1.440
    println(10.0 % 3.0)              // expect: 1.0
    println(-10.0 % 3.0)             // expect: -1.0
    println(10.0 % -3.0)             // expect: 1.0
    println(-1.25)                   // expect: -1.25
    println(1e20 + 1.0)              // expect: 100000000000000000001.0
    println(1.00 + 2.0)              // expect: 3.00
    println(1.00 * 2.0)              // expect: 2.000
    println(1.00 % 0.3)              // expect: 0.10
    println(99999999999999999999999999999999999998.0 + 1.0) // expect: 99999999999999999999999999999999999999.0
}
