// env: the env and io wrappers at the program level, run by run_fork.py with a
// scratch directory as argv[1]. The runner's environment is inherited, so only
// names that are invalid or absent by construction are read here; the fixed
// present/empty values live in tests/meta/env_api.obx, and the pty-true and
// duplicate-name scan rules in tests/rt_meta_test.c's crafted envp.
// expect: invalid nil true
// expect: null false
// expect: closed false
// expect: file false
// expect: wrappers false
import "env.obx" as env
import "io.obx" as io

fn main() {
    let a = args()
    let dir = a[1]

    // an empty name and a name containing '=' are invalid, so get is nil
    let e = env::get("")
    if e != nil { println("empty name matched"); exit(1) }
    let q = env::get("A=B")
    if q != nil { println("equals name matched"); exit(1) }
    if env::has("") { println("empty name has"); exit(1) }
    if env::has("A=B") { println("equals name has"); exit(1) }
    if env::value("") != "" { println("empty value"); exit(1) }
    if env::getOr("", "fallback") != "fallback" { println("empty fallback"); exit(1) }
    println("invalid nil true")

    // isatty: negative and bad descriptors, /dev/null, a closed tracked fd
    if isatty(-1) { println("negative tty"); exit(1) }
    if isatty(-999) { println("negative big tty"); exit(1) }
    if isatty(999) { println("bad fd tty"); exit(1) }
    let nul = openFile("/dev/null", "r")
    match nul {
        ok(fd) {
            if isatty(fd) { println("null tty"); exit(1) }
            let c = closeFile(fd)
            match c { ok(v) { } err(m, n) { println("null close ", m, " ", n); exit(1) } }
            if isatty(fd) { println("closed tty"); exit(1) }
            println("null false")
            println("closed false")
        }
        err(m, c) { println("null open ", m, " ", c); exit(1) }
    }

    // a regular file created in the scratch directory is not a terminal
    let path = dir + "/env-file"
    let w = openFile(path, "w")
    match w {
        ok(fd) {
            let c = closeFile(fd)
            match c { ok(v) { } err(m, n) { println("file close ", m, " ", n); exit(1) } }
        }
        err(m, c) { println("file create ", m, " ", c); exit(1) }
    }
    let r = openFile(path, "r")
    match r {
        ok(fd) {
            if isatty(fd) { println("file tty"); exit(1) }
            if io::isTty(fd) { println("file io tty"); exit(1) }
            let c = closeFile(fd)
            match c { ok(v) { } err(m, n) { println("file close r ", m, " ", n); exit(1) } }
            println("file false")
        }
        err(m, c) { println("file open ", m, " ", c); exit(1) }
    }
    if io::isTty(-1) { println("wrapper negative"); exit(1) }
    println("wrappers false")
}
