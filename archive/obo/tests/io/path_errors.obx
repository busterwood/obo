// path_errors: the path and mode errors the runtime reports before any open:
// an empty path and an embedded NUL are EINVAL (22), a path of 4096 bytes is
// ENAMETOOLONG (36), and a computed unknown mode is EINVAL (22) with the
// "unknown open mode" message. No file is created or opened.
// expect: empty 22
// expect: nul 22
// expect: long 36
// expect: mode 22 unknown open mode
fn main() {
    let empty = ""
    let e = openFile(empty, "r")
    match e {
        ok(v) { println("empty ok ", v); exit(1) }
        err(m, c) { println("empty ", c) }
    }

    var nb = new []byte(3)
    nb[0] = 'a'
    nb[1] = byte(0)
    nb[2] = 'b'
    let withNul = string(nb)
    let n = openFile(withNul, "r")
    match n {
        ok(v) { println("nul ok ", v); exit(1) }
        err(m, c) { println("nul ", c) }
    }

    var lb = new []byte(4096)
    for i in 0..4096 { lb[i] = 'a' }
    let longPath = string(lb)
    let l = openFile(longPath, "r")
    match l {
        ok(v) { println("long ok ", v); exit(1) }
        err(m, c) { println("long ", c) }
    }

    let mode = "z"
    let u = openFile("obo-io-path-errors-no-such-file", mode)
    match u {
        ok(v) { println("mode ok ", v); exit(1) }
        err(m, c) { println("mode ", c, " ", m) }
    }
}
