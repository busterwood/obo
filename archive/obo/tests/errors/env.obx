// The P5a environment builtins' compile-time checks. The harness prepends every
// line before the first "// ===" to each case, so the prelude binds the helper
// the try-in-an-argument case uses. Each case has exactly one error marker on
// its line, as in the other error files.

fn getResultName(): Result[string] { return ok("p") }

// === isatty fd type
fn main() {
    let t = isatty("0")                             // error: isatty needs an int file descriptor, not string
}

// === isatty extra argument
fn main() {
    let t = isatty(0, 1)                            // error: expected ')', found ,
}

// === isatty no argument
fn main() {
    let t = isatty()                                // error: expected an expression
}

// === getenv name type
fn main() {
    let v = getenv(1)                               // error: getenv needs a string name, not int
}

// === getenv result is optional
fn main() {
    let v: []byte = getenv("A")                     // error: initialising 'v': cannot use ?[]byte as []byte
}

// === getenv extra argument
fn main() {
    let v = getenv("A", 1)                          // error: expected ')', found ,
}

// === getenv no argument
fn main() {
    let v = getenv()                                // error: expected an expression
}

// === try in a getenv argument
fn main() {
    let v = getenv(try getResultName())             // error: a try expression cannot be part of a larger expression; assign it to a local first
}

// === a getenv result as a condition
fn main() {
    if getenv("A") { }                              // error: condition must be bool, not ?[]byte
}
