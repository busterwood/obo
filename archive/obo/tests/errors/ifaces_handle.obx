// Handles of interface values in 0.8, step 6 of v3 (design 6.2, 9.1, 11 and 12.2 E8a): there is no ^I yet, so
// handle names records and closed types only. Owned, borrowed and optional interface forms are all refused with
// the existing text, which renders the actual type. Handles of records and closed types are unchanged.
type Shape = interface {
    pure fn area(): int
}
type Square = ref record { s: int }
fn (q: &Square) area(): int { return q.s }
impl Shape for Square

// === an owned interface value
fn f() {
    let a: Shape = new Square{s: 1}
    let h = handle(a)  // error: handles name records and closed types, not Shape
}

// === a borrowed interface reference
fn f(a: Shape) {
    let r: &Shape = &a
    let h = handle(r)  // error: handles name records and closed types, not Shape
}

// === an optional interface value
fn f() {
    let o: ?Shape = new Square{s: 1}
    let h = handle(o)  // error: handles name records and closed types, not ?Shape
}

// === a narrowed &?I parameter is a &I
fn f(o: &?Shape) {
    if o != nil {
        let h = handle(o)  // error: handles name records and closed types, not Shape
    }
}
