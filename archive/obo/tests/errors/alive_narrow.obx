// === a negated guard does not narrow the rest of an and, the owner freed on one path
fn main() {
    var a = nb(1)
    let h = handle(a)
    var c = flag()
    if c { a = nb(2) }
    if !alive(h) && h.n > 0 { println(1) }  // error: handle 'h' may name a freed object
