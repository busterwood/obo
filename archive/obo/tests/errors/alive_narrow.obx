// === a copy of a dead handle made after the if
fn main() {
    var a = nb(1)
    let h = handle(a)
    var c = flag()
    if c { a = nb(2) }
if alive(h) { println(h.n) }
let g = h
println(g.n)  // error: handle 'g' may name a freed object
}

// === the dead mark is back after a conjunction guard
fn main() {
    var a = nb(1)
    let h = handle(a)
    var c = flag()
    if c { a = nb(2) }
    if alive(h) && c {
        println(1)
    }
    println(h.n)  // error: handle 'h' may name a freed object
}
// === the dead mark is back after a conjunction guard with a nested conjunction
fn main() {
    var a = nb(1)
    let h = handle(a)
    var c = flag()
    if c { a = nb(2) }
    if alive(h) && (c && c) {
        println(1)
    }
    println(h.n)  // error: handle 'h' may name a freed object
}
// === the dead mark is back in the else arm of a conjunction guard
fn main() {
    var a = nb(1)
    let h = handle(a)
    var c = flag()
    if c { a = nb(2) }
    if alive(h) && c {
        println(1)
    } else {
        println(h.n)  // error: handle 'h' may name a freed object
    }
}
// === a negated guard with an else, the then block goes on
fn main() {
    var a = nb(1)
    let h = handle(a)
    var c = flag()
    if c { a = nb(2) }
    if !alive(h) {
        println(0)
    } else {
        println(h.n)
    }
    println(h.n)  // error: handle 'h' may name a freed object
}
// === a negated guard does not narrow the rest of an and
fn main() {
    var a = nb(1)
    let h = handle(a)
    a = nb(2)
    if !alive(h) && h.n > 0 { println(1) }  // error: handle 'h' may name a freed object
