fn main() {
    var a = nb(1)
    let h = handle(a)
    var c = flag()
    if c { a = nb(2) }
let g = handle(a)
if alive(g) { println(h.n)  // error: handle 'h' may name a freed object
}
}
// === a guard on a different handle, copy
fn main() {
    var a = nb(1)
    let h = handle(a)
    var c = flag()
    if c { a = nb(2) }
let g = h
if alive(g) { println(h.n)  // error: handle 'h' may name a freed object
}
}
