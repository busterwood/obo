// === an early exit in a block does not reach out of it
fn main() {
    var a = nb(1)
    let h = handle(a)
    var c = flag()
    if c { a = nb(2) }
if c {
    if !alive(h) { return }
    println(h.n)
}
println(h.n)  // error: handle 'h' may name a freed object
}
// === a double negation
fn main() {
    var a = nb(1)
    let h = handle(a)
    var c = flag()
    if c { a = nb(2) }
if !!alive(h) { println(h.n)  // error: handle 'h' may name a freed object
}
}
// === a parenthesised guard
fn main() {
    var a = nb(1)
    let h = handle(a)
    var c = flag()
    if c { a = nb(2) }
if (alive(h)) { println(h.n)  // error: handle 'h' may name a freed object
}
}
// === while alive
fn main() {
    var a = nb(1)
    let h = handle(a)
    var c = flag()
    if c { a = nb(2) }
while alive(h) {
    println(h.n)  // error: handle 'h' may name a freed object
    break
}
}
// === a guard in a loop whose body frees later
fn main() {
    var a = nb(1)
    let h = handle(a)
    var c = flag()
    if c { a = nb(2) }
var i = 0
while i < 2 {
    if alive(h) { println(h.n) }
    a = nb(3)  // error: cannot assign over the owner of handle 'h' inside a loop that uses the handle
    i += 1
}
}
// === an early exit in a loop whose body frees later
fn main() {
    var a = nb(1)
    let h = handle(a)
    var c = flag()
    if c { a = nb(2) }
var i = 0
while i < 2 {
    if !alive(h) { break }
    println(h.n)
    a = nb(3)  // error: cannot assign over the owner of handle 'h' inside a loop that uses the handle
    i += 1
}
}
// === a break out of the guarded arm, a use after the loop
fn main() {
    var a = nb(1)
    let h = handle(a)
    var c = flag()
    if c { a = nb(2) }
var i = 0
while i < 2 {
    if alive(h) { a = nb(3); break }
    i += 1
}
println(h.n)  // error: handle 'h' may name a freed object
}
