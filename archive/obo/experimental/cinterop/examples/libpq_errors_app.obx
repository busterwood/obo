module app

import "libpq.obx"

fn bytes_of(s: string): []byte {
    var b = new []byte(0)
    for i in 0..len(s) { append(b, s[i]) }
    return b
}

// Fake ABI only. Each specific wrapper message is produced by a real code path:
// PQconnectdb returning NULL, and PQexecParams returning NULL with no libpq
// error text. A closed connection now traps with exit 7 on the next native
// borrow, so that case is a separate app.
fn main() {
    let nullc = libpq::connect(bytes_of("fake-null"))
    match nullc {
        ok(conn) {
            println("null_connect=unexpected_ok")
            conn.close()
            exit(1)
        }
        err(m, c) { println("null_connect_error=", c, " ", m) }
    }

    let made = libpq::connect(bytes_of("fake-ok"))
    match made {
        ok(conn) {
            let alloc = libpq::query(&conn, bytes_of("FAKE_ALLOC"))
            match alloc {
                ok(rows) {
                    println("alloc=unexpected_ok")
                    rows.close()
                    exit(2)
                }
                err(m, c) { println("alloc_error=", c, " ", m) }
            }
            let cr = conn.close()
            match cr {
                ok(v) { println("conn_closed=", v) }
                err(m, c) { println("close_error=", m, " ", c) }
            }
            println("conn_open=", conn.is_open())
        }
        err(m, c) {
            println("connect_error=", m, " (", c, ")")
            exit(4)
        }
    }
}
