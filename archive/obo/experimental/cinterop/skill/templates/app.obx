module app

import "demo.obx"

fn main() {
    let made = demo::open(4)
    match made {
        ok(d) {
            defer d.close()
            println("byte0=", d.byte_at(0))
            println("open=", d.is_open())
            d.close()                     // safe: a second close is ok(false)
            println("closed=", !d.is_open())
        }
        err(m, c) { println("open error ", m, " ", c); exit(1) }
    }

    // The same handle through an out record (rc + ?Demo).
    let made_out = demo::open_out(2)
    match made_out {
        ok(d) {
            defer d.close()
            println("out_byte0=", d.byte_at(0))
        }
        err(m, c) { println("out error ", m, " ", c); exit(1) }
    }

    // The error path: demo_make(7) writes a non-NULL handle and returns rc 7.
    // The wrapper must close that handle; if it does not, the OBO_CHECK=1
    // census exits 8 and this run fails.
    let failed = demo::open_out(7)
    match failed {
        ok(d) {
            d.close()
            println("out_error=none")
            exit(1)
        }
        err(m, c) { println("out_error=", c) }
    }
}
