// io: reading and writing files and the standard streams.
//
// read/write/append work on whole files and return Result[_, IoError];
// Writer is a buffered writer for stdout, stderr or a file, flushed (and a
// file closed) when it is dropped. Errors carry the errno, the operation and
// the path. read and readStdin read a whole file or standard input; Reader
// reads one a chunk or a line at a time.

pub type IoError = value record {
    pub errno: int   // the C errno, e.g. 2 for "no such file"
    pub op: str      // "open", "read", "write", "close"
    pub path: str
}

extern "c" fn strerror(e: i32): str
extern "c" fn errno(): int as "obx_errno"
extern "c" fn openFd(path: str, how: int): int as "obx_open"
extern "c" fn close(fd: i32): i32
extern "c" fn sysRead(fd: i32, buf: mut &[byte], n: int): int as "read"
extern "c" fn flushOut(): int as "obxlib_flush_out"
extern "c" fn cIsatty(fd: int): int as "obxlib_isatty"
extern "c" fn termCols(fd: int): int as "obxlib_term_cols"

// "open nope.txt: No such file or directory"
pub fn (e: IoError) toStr(): str {
    return e.op + " " + e.path + ": " + errorText(e.errno)
}

pub fn (a: IoError) eq(b: &IoError): bool {
    return a.errno == b.errno && a.op == b.op && a.path == b.path
}

// The errnos of an operation stopped by cancellation or by the deadline of
// a task.within (net; SPEC 16).
pub const ECANCELED = 125
pub const ETIMEDOUT = 110

pub fn (e: IoError) isCancelled(): bool { return e.errno == ECANCELED }
pub fn (e: IoError) isTimeout(): bool { return e.errno == ETIMEDOUT }

// A failed name lookup (net.resolve, net.dial) is LOOKUP + n, n the
// positive form of getaddrinfo's EAI_ code (EAI_NONAME -2 is LOOKUP + 2);
// errorText gives glibc's text for it, without calling gai_strerror.
pub const LOOKUP = 100000

// Whether the error is a failed name lookup.
pub fn (e: IoError) isLookup(): bool { return e.errno > LOOKUP && e.errno < LOOKUP + 100 }

// The C library's text for an errno (and for LOOKUP + n, getaddrinfo's).
pub fn errorText(errno: int): str {
    if errno > LOOKUP && errno < LOOKUP + 100 { return lookupText(errno - LOOKUP) }
    return strerror(i32(errno))
}

fn lookupText(n: int): str {
    match n {
        1 { return "Bad value for ai_flags" }
        2 { return "Name or service not known" }
        3 { return "Temporary failure in name resolution" }
        4 { return "Non-recoverable failure in name resolution" }
        5 { return "No address associated with hostname" }
        6 { return "ai_family not supported" }
        7 { return "ai_socktype not supported" }
        8 { return "Servname not supported for ai_socktype" }
        9 { return "Address family for hostname not supported" }
        10 { return "Memory allocation failure" }
        12 { return "Argument buffer overflow" }
        else { return "Unknown name lookup error " + intToStr(-n) }
    }
}

// The errno of the last failed C call.
pub fn lastErrno(): int { return errno() }

pub fn ioError(errno: int, op: str, path: str): IoError {
    return IoError{errno: errno, op: op, path: path}
}

// The whole file at path.
pub fn read(path: str): Result[str, IoError] {
    var s = ""
    let e = readFile(path, mut &s)
    if e != 0 { return Err(ioError(e, "read", path)) }
    return Ok(s)
}

// The lines of the file at path, without their "\n" (or "\r\n").
pub fn readLines(path: str): Result[[]str, IoError] {
    let text = try read(path)
    return Ok(splitLines(text))
}

// Standard input up to its end.
pub fn readStdin(): Result[str, IoError] { return read("/dev/stdin") }

// The lines of s: split at "\n", a "\r" before it dropped, no empty last
// line after a final "\n".
pub fn splitLines(s: str): []str {
    var out: []str = []
    var start = 0
    for i in 0..len(s) {
        if strByte(s, i) == '\n' {
            var end = i
            if end > start && strByte(s, end - 1) == '\r' { end -= 1 }
            append(mut &out, strSlice(s, start, end))
            start = i + 1
        }
    }
    if start < len(s) { append(mut &out, strSlice(s, start, len(s))) }
    return out
}

// Replaces the file at path with data (creating it, mode 0666 less umask).
pub fn write(path: str, data: str): Result[Unit, IoError] { return writeHow(path, data, 1) }

// Adds data at the end of the file at path (creating it).
pub fn appendTo(path: str, data: str): Result[Unit, IoError] { return writeHow(path, data, 2) }

fn writeHow(path: str, data: str, how: int): Result[Unit, IoError] {
    let fd = openFd(path, how)
    if fd < 0 { return Err(ioError(-fd, "open", path)) }
    if writeFd(fd, data) != len(data) {
        let e = errno()
        close(i32(fd))
        return Err(ioError(e, "write", path))
    }
    if close(i32(fd)) != 0 { return Err(ioError(errno(), "close", path)) }
    return Ok(Unit{})
}

// ---------------------------------------------------------------- Writer

// A buffered writer. The buffer is written out when it passes 64 KiB, on
// flush, and when the writer is dropped; a file writer also closes its file
// then. The first error of a write when the buffer is full is reported by the
// next flush or close; errors when it is dropped are lost.
pub type Writer = record {
    fd: int
    path: str
    buf: StrBuf
    ownsFd: bool
    failed: Option[IoError]   // the first error of an implicit flush
}

const LIMIT = 65536

pub fn stdout(): Writer { return Writer{fd: 1, path: "<stdout>", buf: newStrBuf(), ownsFd: false, failed: None} }
pub fn stderr(): Writer { return Writer{fd: 2, path: "<stderr>", buf: newStrBuf(), ownsFd: false, failed: None} }

// A writer to a new or emptied file.
pub fn create(path: str): Result[Writer, IoError] { return openWriter(path, 1) }

// A writer that adds to the end of a file (creating it).
pub fn openAppend(path: str): Result[Writer, IoError] { return openWriter(path, 2) }

fn openWriter(path: str, how: int): Result[Writer, IoError] {
    let fd = openFd(path, how)
    if fd < 0 { return Err(ioError(-fd, "open", path)) }
    return Ok(Writer{fd: fd, path: path, buf: newStrBuf(), ownsFd: true, failed: None})
}

pub fn (w: mut &Writer) write(s: str) {
    w.buf.add(s)
    if w.buf.size() >= LIMIT { w.spill() }
}

pub fn (w: mut &Writer) writeln(s: str) {
    w.buf.add(s)
    w.buf.addByte('\n')
    if w.buf.size() >= LIMIT { w.spill() }
}

pub fn (w: mut &Writer) writeByte(c: byte) {
    w.buf.addByte(c)
    if w.buf.size() >= LIMIT { w.spill() }
}

// Writes out the buffer (for stdout, also the runtime's buffer behind
// print). An error of an earlier implicit flush is reported here, once.
pub fn (w: mut &Writer) flush(): Result[Unit, IoError] {
    try w.flushBuf()
    if w.fd == 1 { try flushStdout() }
    match replace(mut &w.failed, None) {
        Some(e) { return Err(e) }
        None { return Ok(Unit{}) }
    }
}

// The implicit flush when the buffer is full: an error is kept for flush.
fn (w: mut &Writer) spill() {
    match w.flushBuf() {
        Err(e) { if w.failed.isNone() { w.failed = Some(e) } }
        Ok(_) {}
    }
}

fn (w: mut &Writer) flushBuf(): Result[Unit, IoError] {
    if w.buf.size() == 0 { return Ok(Unit{}) }
    let s = w.buf.toStr()
    w.buf.clear()
    if w.fd < 0 { return Err(ioError(9, "write", w.path)) }
    if writeFd(w.fd, s) != len(s) { return Err(ioError(errno(), "write", w.path)) }
    return Ok(Unit{})
}

// Writes out what print and println (and stdout writers) have buffered; the
// error of the first write to standard output that failed since the last
// call, if any.
pub fn flushStdout(): Result[Unit, IoError] {
    let e = flushOut()
    if e != 0 { return Err(ioError(e, "write", "<stdout>")) }
    return Ok(Unit{})
}

// Whether the descriptor fd (0, 1, 2, ...) is a terminal.
pub fn isTerminal(fd: int): bool { return cIsatty(fd) != 0 }

// The width in columns of the terminal at fd; None when fd is not a terminal
// or the terminal reports no size.
pub fn terminalWidth(fd: int): Option[int] {
    let n = termCols(fd)
    return if n > 0 { Some(n) } else { None }
}

// Flushes, then closes a file writer; later writes fail with EBADF.
pub fn (w: mut &Writer) close(): Result[Unit, IoError] {
    try w.flush()
    if w.ownsFd && w.fd >= 0 {
        let fd = w.fd
        w.fd = -1
        if close(i32(fd)) != 0 { return Err(ioError(errno(), "close", w.path)) }
    }
    return Ok(Unit{})
}

fn (w: mut &Writer) drop() {
    w.flush()
    if w.ownsFd && w.fd >= 0 { close(i32(w.fd)) }
}

// ---------------------------------------------------------------- Reader

// A buffered reader over standard input or a file. read fills the front of
// the caller's byte array, from the bytes readLine has buffered and else
// straight from the file; readLine reads through a 64 KiB buffer. The end of
// the input is not remembered: a read after it tries again, so a growing file
// or a terminal can give more. An interrupted read (EINTR) is retried. A file
// reader closes its file when it is dropped.
pub type Reader = record {
    fd: int
    path: str
    buf: []byte     // allocated by the first readLine
    pos: int        // the next unread byte of buf
    end: int        // the end of the bytes read into buf
    ownsFd: bool
}

const CHUNK = 65536

pub fn stdin(): Reader { return Reader{fd: 0, path: "<stdin>", buf: [], pos: 0, end: 0, ownsFd: false} }

// A reader of the file at path.
pub fn open(path: str): Result[Reader, IoError] {
    let fd = openFd(path, 0)
    if fd < 0 { return Err(ioError(-fd, "open", path)) }
    return Ok(Reader{fd: fd, path: path, buf: [], pos: 0, end: 0, ownsFd: true})
}

// Reads up to len(dst) bytes into the front of dst: how many, 0 at the end
// of the input (and when dst is empty).
pub fn (r: mut &Reader) read(dst: mut &[byte]): Result[int, IoError] {
    let n = len(dst)
    if n == 0 { return Ok(0) }
    if r.pos < r.end {
        var k = r.end - r.pos
        if k > n { k = n }
        for i in 0..k { dst[i] = r.buf[r.pos + i] }
        r.pos += k
        return Ok(k)
    }
    let k = readFd(r.fd, dst, n)
    if k < 0 { return Err(ioError(-k, "read", r.path)) }
    return Ok(k)
}

// The next line, without its "\n" (and a "\r" before it, as splitLines);
// a last line without a "\n" too. None at the end of the input.
pub fn (r: mut &Reader) readLine(): Result[Option[str], IoError] {
    var line = ""
    var any = false
    while true {
        if r.pos == r.end {
            if len(r.buf) == 0 { r.buf = array(CHUNK, 0) }
            let k = readFd(r.fd, mut &r.buf, CHUNK)
            if k < 0 { return Err(ioError(-k, "read", r.path)) }
            r.pos = 0
            r.end = k
            if k == 0 { break }
        }
        let from = r.pos
        var i = from
        while i < r.end && r.buf[i] != '\n' { i += 1 }
        let part = strFromBytes(&r.buf[from..i])
        line = if any { line + part } else { part }
        any = true
        if i < r.end {
            r.pos = i + 1
            return Ok(Some(dropCr(line)))
        }
        r.pos = i
    }
    return if any { Ok(Some(dropCr(line))) } else { Ok(None) }
}

fn dropCr(s: str): str {
    let n = len(s)
    return if n > 0 && strByte(s, n - 1) == '\r' { strSlice(s, 0, n - 1) } else { s }
}

// Reads from fd into the front of dst (at most n bytes): how many, 0 at the
// end, or minus the errno.
fn readFd(fd: int, dst: mut &[byte], n: int): int {
    if fd < 0 { return -9 }
    while true {
        let k = sysRead(i32(fd), dst, n)
        if k >= 0 { return k }
        let e = errno()
        if e != 4 { return -e }
    }
    return 0
}

// Closes a file reader; later reads fail with EBADF.
pub fn (r: mut &Reader) close(): Result[Unit, IoError] {
    r.pos = 0
    r.end = 0
    if r.ownsFd && r.fd >= 0 {
        let fd = r.fd
        r.fd = -1
        if close(i32(fd)) != 0 { return Err(ioError(errno(), "close", r.path)) }
    }
    return Ok(Unit{})
}

fn (r: mut &Reader) drop() {
    if r.ownsFd && r.fd >= 0 { close(i32(r.fd)) }
}
