// tz: time zones, from the system's TZif files (version 2 and later, 64-bit
// transitions) and the POSIX TZ rule in a TZif footer, as glibc applies them.
//
// A zone gives the offset from UTC, the DST flag and the abbreviation of an
// instant. Before the first transition the zone uses the first standard
// (non-DST) type, as glibc does; from the last transition on, the footer rule
// (for example "GMT0BST,M3.5.0/1,M10.5.0") decides when the file has one. A
// zone with no file and no footer is UTC.
//
//     let z = tz.local()                  // $TZ, else /etc/localtime, else UTC
//     let z = try tz.load("Europe/London")
//     let i = z.at(sec)                   // i.offset seconds east, i.dst, i.abbr
//
// Tests: lib/tests/run/tz_*.obx; the expected values come from Python's zoneinfo
// (lib/tests/gen_tz.py).

import "io"
import "os"
import "time"
import "strings"

const ZONEINFO = "/usr/share/zoneinfo/"

// The local time type in effect at an instant.
pub type Info = value record {
    pub offset: int     // seconds east of UTC
    pub dst: bool       // daylight saving time
    pub abbr: str       // "GMT", "BST", "+0330" and so on
}

// A local time type of a zone or of its POSIX rule (offset east of UTC).
type Kind = value record { offset: int; dst: bool; abbr: str }

// One switch of a POSIX rule: kind 0 is Mm.w.d (month, week 1..5 where 5 is the
// last, weekday 0..6 with Sunday 0), 1 is Jn (1..365, February 29 never counts)
// and 2 is n (0..365, counting February 29); time is seconds from midnight.
type Switch = value record { kind: int; month: int; week: int; wday: int; day: int; time: int }

// A POSIX TZ rule: the standard type, and the DST type with its two switches.
type Posix = value record { std: Kind; hasDst: bool; dst: Kind; start: Switch; end: Switch }

// A zone: the local time types, the transitions (Unix seconds, ascending) with
// the type each one starts, and the footer rule.
pub type Zone = record {
    pub name: str
    types: []Kind
    times: []int
    index: []int
    hasRule: bool
    rule: Posix
}

const UTC_KIND: Kind = Kind{offset: 0, dst: false, abbr: "UTC"}

fn noSwitch(): Switch { return Switch{kind: 0, month: 0, week: 0, wday: 0, day: 0, time: 0} }

fn noRule(): Posix {
    return Posix{std: UTC_KIND, hasDst: false, dst: UTC_KIND, start: noSwitch(), end: noSwitch()}
}

fn utcZone(name: str): Zone {
    return Zone{name: name, types: [UTC_KIND], times: [], index: [], hasRule: false, rule: noRule()}
}

// The UTC zone.
pub fn utc(): Zone { return utcZone("UTC") }

// The zone of this process: $TZ when set, else /etc/localtime, else UTC.
pub fn local(): Zone {
    match os.env("TZ") {
        Some(v) { return fromSpec(v) }
        None {}
    }
    match fromFile("/etc/localtime") {
        Ok(z) { return z }
        Err(_) { return utc() }
    }
}

// The zone a TZ value names: ":" is ignored, "" and "UTC" are UTC, a path
// (starting with "/") is a TZif file, a name is a file under
// /usr/share/zoneinfo, and anything else is a POSIX rule; no zone is UTC.
pub fn fromSpec(spec: str): Zone {
    var s = spec
    if len(s) > 0 && s[0] == ':' { s = s[1..] }
    if s == "" || s == "UTC" { return utc() }
    if s[0] == '/' {
        match fromFile(s) {
            Ok(z) { return z }
            Err(_) { return utc() }
        }
    }
    match load(s) {
        Ok(z) { return z }
        Err(_) {}
    }
    match parsePosix(s) {
        Some(z) { return z }
        None { return utc() }
    }
}

// The zone with this name under /usr/share/zoneinfo; Err when it is missing,
// unsafe ("..", a leading "/") or not a TZif file. "UTC" is always UTC.
pub fn load(name: str): Result[Zone, str] {
    if name == "UTC" { return Ok(utc()) }
    if len(name) == 0 || name[0] == '/' || strings.count(name, "..") > 0 {
        return Err("bad zone name " + name)
    }
    return fromFile(ZONEINFO + name)
}

// The zone in a TZif file at path.
pub fn fromFile(path: str): Result[Zone, str] {
    match io.read(path) {
        Ok(data) { return parseTzif(data, path) }
        Err(e) { return Err(path + ": " + e.toStr()) }
    }
}

// ---------------------------------------------------------------- TZif

// A 32-bit big-endian value, signed.
fn be32(s: str, p: int): int {
    let v = be32u(s, p)
    return if v >= 2147483648 { v - 4294967296 } else { v }
}

fn be32u(s: str, p: int): int {
    return int(s[p]) * 16777216 + int(s[p + 1]) * 65536 + int(s[p + 2]) * 256 + int(s[p + 3])
}

// A signed 64-bit big-endian value, from its two halves (no overflow).
fn be64(s: str, p: int): int {
    return be32(s, p) * 4294967296 + be32u(s, p + 4)
}

// The six counts of a TZif header at p: isut, isstd, leap, time, type, char.
fn counts(s: str, p: int): []int {
    var c: []int = []
    for k in 0..6 { append(mut &c, be32u(s, p + 20 + 4 * k)) }
    return c
}

fn parseTzif(data: str, path: str): Result[Zone, str] {
    if len(data) < 44 || data[0..4] != "TZif" { return Err(path + ": not a TZif file") }
    let version = data[4]
    var p = 0
    var c = counts(data, 0)
    var timeSize = 4
    if version >= '2' {
        // skip the version 1 block, then read the version 2 header and data
        let v1 = c[3] * 4 + c[3] + c[4] * 6 + c[5] + c[2] * 8 + c[1] + c[0]
        p = 44 + v1
        if len(data) < p + 44 || data[p..p + 4] != "TZif" { return Err(path + ": bad TZif version 2 header") }
        c = counts(data, p)
        timeSize = 8
    }
    let timeCount = c[3]
    let typeCount = c[4]
    let charCount = c[5]
    let base = p + 44
    let typeAt = base + timeCount * timeSize + timeCount
    let charAt = typeAt + typeCount * 6
    let dataEnd = charAt + charCount + c[2] * (timeSize + 4) + c[1] + c[0]
    if typeCount < 1 || len(data) < dataEnd { return Err(path + ": truncated TZif file") }
    var types: []Kind = []
    for k in 0..typeCount {
        let q = typeAt + 6 * k
        let ai = int(data[q + 5])
        var end = charAt + ai
        while end < charAt + charCount && data[end] != 0 { end += 1 }
        append(mut &types, Kind{offset: be32(data, q), dst: data[q + 4] != 0, abbr: data[charAt + ai..end]})
    }
    var times: []int = []
    var index: []int = []
    for k in 0..timeCount {
        let t = if timeSize == 8 { be64(data, base + 8 * k) } else { be32(data, base + 4 * k) }
        let ti = int(data[base + timeCount * timeSize + k])
        if ti >= typeCount { return Err(path + ": bad transition type") }
        append(mut &times, t)
        append(mut &index, ti)
    }
    var z = Zone{name: path, types: types, times: times, index: index, hasRule: false, rule: noRule()}
    if version >= '2' && dataEnd < len(data) && data[dataEnd] == '\n' {
        // the footer: a newline, the TZ string, a newline
        var e = dataEnd + 1
        while e < len(data) && data[e] != '\n' { e += 1 }
        let r = parseRule(data[dataEnd + 1..e])
        if r.ok {
            z.hasRule = true
            z.rule = r.rule
        }
    }
    return Ok(z)
}

// ---------------------------------------------------------------- POSIX

// The text being read and the position in it.
type Cur = value record { s: str; i: int }

// A parsed TZ string: ok is false when the text is not a rule.
type ParsedRule = value record { ok: bool; rule: Posix }

fn badRule(): ParsedRule { return ParsedRule{ok: false, rule: noRule()} }

// The zone of a POSIX TZ string (no transitions, only the rule).
fn parsePosix(spec: str): Option[Zone] {
    let r = parseRule(spec)
    if !r.ok { return None }
    var types: []Kind = [r.rule.std]
    if r.rule.hasDst { append(mut &types, r.rule.dst) }
    return Some(Zone{name: spec, types: types, times: [], index: [], hasRule: true, rule: r.rule})
}

// std offset [dst [offset] [,start[/time],end[/time]]]. Without a rule the
// DST switches are the US ones, M3.2.0 and M11.1.0.
fn parseRule(spec: str): ParsedRule {
    var c = Cur{s: spec, i: 0}
    let stdName = c.name()
    if stdName == "" { return badRule() }
    let stdOff = c.offset()
    if !stdOff.isSome() { return badRule() }
    var r = noRule()
    r.std = Kind{offset: -stdOff.unwrap(), dst: false, abbr: stdName}
    if c.i == len(spec) { return ParsedRule{ok: true, rule: r} }
    let dstName = c.name()
    if dstName == "" { return badRule() }
    var dstOffset = r.std.offset + 3600
    if c.i < len(spec) && spec[c.i] != ',' {
        match c.offset() {
            Some(o) { dstOffset = -o }
            None { return badRule() }
        }
    }
    r.hasDst = true
    r.dst = Kind{offset: dstOffset, dst: true, abbr: dstName}
    r.start = Switch{kind: 0, month: 3, week: 2, wday: 0, day: 0, time: 7200}
    r.end = Switch{kind: 0, month: 11, week: 1, wday: 0, day: 0, time: 7200}
    if c.i < len(spec) {
        if spec[c.i] != ',' { return badRule() }
        c.i += 1
        match c.switchRule() {
            Some(s) { r.start = s }
            None { return badRule() }
        }
        if c.i >= len(spec) || spec[c.i] != ',' { return badRule() }
        c.i += 1
        match c.switchRule() {
            Some(s) { r.end = s }
            None { return badRule() }
        }
    }
    if c.i != len(spec) { return badRule() }
    return ParsedRule{ok: true, rule: r}
}

fn isAlpha(b: byte): bool { return (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') }

fn isDigitByte(b: byte): bool { return b >= '0' && b <= '9' }

// An abbreviation: at least three letters, or any text between < and >.
fn (c: mut &Cur) name(): str {
    if c.i < len(c.s) && c.s[c.i] == '<' {
        var e = c.i + 1
        while e < len(c.s) && c.s[e] != '>' { e += 1 }
        if e >= len(c.s) { return "" }
        let text = c.s[c.i + 1..e]
        c.i = e + 1
        return text
    }
    let start = c.i
    while c.i < len(c.s) && isAlpha(c.s[c.i]) { c.i += 1 }
    if c.i - start < 3 { c.i = start; return "" }
    return c.s[start..c.i]
}

// [+-]hh[:mm[:ss]] as seconds, the sign as written (POSIX counts hours west).
fn (c: mut &Cur) offset(): Option[int] {
    var sign = 1
    if c.i < len(c.s) && (c.s[c.i] == '+' || c.s[c.i] == '-') {
        if c.s[c.i] == '-' { sign = -1 }
        c.i += 1
    }
    match c.clock() {
        Some(v) { return Some(sign * v) }
        None { return None }
    }
}

// hh[:mm[:ss]] as seconds (hours may reach 167 in a footer).
fn (c: mut &Cur) clock(): Option[int] {
    let h = c.num()
    if !h.isSome() { return None }
    var total = h.unwrap() * 3600
    if c.i < len(c.s) && c.s[c.i] == ':' {
        c.i += 1
        match c.num() {
            Some(m) { total += m * 60 }
            None { return None }
        }
        if c.i < len(c.s) && c.s[c.i] == ':' {
            c.i += 1
            match c.num() {
                Some(sec) { total += sec }
                None { return None }
            }
        }
    }
    return Some(total)
}

// Decimal digits, at most nine of them.
fn (c: mut &Cur) num(): Option[int] {
    let start = c.i
    var v = 0
    while c.i < len(c.s) && isDigitByte(c.s[c.i]) && c.i - start < 9 {
        v = v * 10 + int(c.s[c.i]) - 48
        c.i += 1
    }
    if c.i == start { return None }
    return Some(v)
}

// Mm.w.d, Jn or n, with an optional /time (default 02:00:00).
fn (c: mut &Cur) switchRule(): Option[Switch] {
    var s = Switch{kind: 0, month: 0, week: 0, wday: 0, day: 0, time: 7200}
    if c.i < len(c.s) && c.s[c.i] == 'M' {
        c.i += 1
        match c.num() { Some(m) { s.month = m } None { return None } }
        if c.i >= len(c.s) || c.s[c.i] != '.' { return None }
        c.i += 1
        match c.num() { Some(w) { s.week = w } None { return None } }
        if c.i >= len(c.s) || c.s[c.i] != '.' { return None }
        c.i += 1
        match c.num() { Some(d) { s.wday = d } None { return None } }
        if s.month < 1 || s.month > 12 || s.week < 1 || s.week > 5 || s.wday > 6 { return None }
    } else if c.i < len(c.s) && c.s[c.i] == 'J' {
        c.i += 1
        s.kind = 1
        match c.num() { Some(d) { s.day = d } None { return None } }
        if s.day < 1 || s.day > 365 { return None }
    } else {
        s.kind = 2
        match c.num() { Some(d) { s.day = d } None { return None } }
        if s.day > 365 { return None }
    }
    if c.i < len(c.s) && c.s[c.i] == '/' {
        c.i += 1
        match c.clock() { Some(t) { s.time = t } None { return None } }
    }
    return Some(s)
}

// ---------------------------------------------------------------- lookup

// The local time type in effect at Unix time sec.
pub fn (z: &Zone) at(sec: int): Info {
    let k = z.kindAt(sec)
    return Info{offset: k.offset, dst: k.dst, abbr: k.abbr}
}

// The civil date and time shown in the zone at Unix time sec.
pub fn (z: &Zone) localTime(sec: int): time.LocalDateTime {
    return time.localOf(time.Time{sec: sec + z.at(sec).offset, nsec: 0})
}

fn (z: &Zone) kindAt(sec: int): Kind {
    let n = len(z.times)
    if n == 0 {
        return if z.hasRule { ruleKind(&z.rule, sec) } else { z.types[0] }
    }
    if sec < z.times[0] {
        for k in z.types {
            if !k.dst { return k }
        }
        return z.types[0]
    }
    if z.hasRule && sec >= z.times[n - 1] { return ruleKind(&z.rule, sec) }
    // the last transition at or before sec
    var lo = 0
    var hi = n - 1
    while lo < hi {
        let mid = (lo + hi + 1) / 2
        if z.times[mid] <= sec { lo = mid } else { hi = mid - 1 }
    }
    return z.types[z.index[lo]]
}

// The type a POSIX rule gives at sec: DST from its start switch (given in
// standard time) to its end switch (in DST time), which wraps over the year's
// end in the southern hemisphere.
fn ruleKind(r: &Posix, sec: int): Kind {
    if !r.hasDst { return r.std }
    let y = time.dateOf(sec + r.std.offset).year
    let startAt = switchAt(r.start, y, r.std.offset)
    let endAt = switchAt(r.end, y, r.dst.offset)
    let inDst = if startAt < endAt { sec >= startAt && sec < endAt } else { !(sec >= endAt && sec < startAt) }
    return if inDst { r.dst } else { r.std }
}

// The Unix time of a switch in year y, where the wall clock reads offset east of UTC.
fn switchAt(s: Switch, y: int, offset: int): int {
    var day = 0
    if s.kind == 0 {
        let first = time.daysOfDate(time.Date{year: y, month: s.month, day: 1})
        let firstWd = time.weekday(time.Date{year: y, month: s.month, day: 1})
        var d = 1 + (s.wday - firstWd + 7) % 7 + (s.week - 1) * 7
        let dim = time.daysInMonth(y, s.month)
        while d > dim { d -= 7 }
        day = first + d - 1
    } else if s.kind == 1 {
        var n = s.day - 1
        if time.isLeapYear(y) && s.day >= 60 { n += 1 }
        day = time.daysOfDate(time.Date{year: y, month: 1, day: 1}) + n
    } else {
        day = time.daysOfDate(time.Date{year: y, month: 1, day: 1}) + s.day
    }
    return day * 86400 + s.time - offset
}
