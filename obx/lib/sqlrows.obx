}

// ---------------------------------------------------------------- for clients

// E_TYPE: a value of col read as kind, where its codec cannot.
pub fn wrongKind(col: &Column, kind: str): Error {
    return sqldialect.dbError(sqldialect.E_TYPE, col.typeName + " cannot be read as " + kind)
}

// The state of a stream between fills: rows still to come, ended, or failed
// (its error already returned).
pub const LIVE = 0
pub const ENDED = 1
pub const FAILED = 2
