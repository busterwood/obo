// tns: the wire protocol of Oracle Database (TNS packets carrying TTC
// messages), for the `oracle` module (design/oracle.md). A port of the thin
// mode of python-oracledb (src/oracledb/impl/thin and impl/base, Copyright
// (c) 2016, 2026, Oracle and/or its affiliates, Apache-2.0 OR UPL-1.0; see
// NOTICE), read together with node-oracledb's lib/thin.
//
//   - packets: the 8-byte header (a 16-bit length until the ACCEPT, a 32-bit
//     one after it), CONNECT, ACCEPT, REFUSE, RESEND, DATA (two bytes of
//     data flags, then TTC messages), MARKER (break and reset), CONTROL.
//   - TTC encodings: one-byte, big-endian and "universal" integers (a length
//     byte, then that many big-endian bytes), byte strings with a length
//     byte or in chunks (254, then 4-byte-length chunks up to an empty one).
//   - values: NUMBER (base-100 digits, exact, as Num), BINARY_FLOAT and
//     BINARY_DOUBLE (IEEE bits with the sign flipped), DATE, TIMESTAMP and
//     TIMESTAMP WITH TIME ZONE, BOOLEAN, RAW, VARCHAR2 and CHAR (AL32UTF8),
//     NVARCHAR2 and NCHAR (AL16UTF16, big-endian).
//   - the login: the Protocol and DataTypes messages, and the two
//     authentication phases with the 12c (PBKDF2-SHA512) and 11g (SHA-1)
//     verifiers (crypto.obx does the arithmetic through libcrypto).
//   - requests: EXECUTE with binds and a prefetch, FETCH, COMMIT, ROLLBACK,
//     LOGOFF, and closing cursors by a piggyback in front of the next one.
//   - replies: DESCRIBE_INFO, ROW_HEADER, BIT_VECTOR, ROW_DATA, ERROR,
//     STATUS, WARNING, PARAMETER, SERVER_SIDE_PIGGYBACK, END_OF_RESPONSE.
//
// The decoder never traps on what the server sends: every length and count
// is checked against the bytes there are. A reply is decoded a whole message
// at a time; a message cut off at the end of the bytes received so far is
// decoded again from its start once the next packet is in.
//
// Errors are sqldialect.DbError: the server's ORA- errors with their number
// as the code and the server's text ("ORA-00942: table or view does not
// exist"), E_PROTOCOL, E_IO, E_CANCELLED, E_TIMEOUT, E_LIMIT, E_INPUT,
// E_TYPE. After an error on the wire the session is broken: its later calls
// fail with E_IO at once.

import "net"
import "tls"
import "io"
import "os"
import "strings"
import "sqldialect"
import "math"
import "time"
import "crypto"

pub type Error = sqldialect.DbError

// ---------------------------------------------------------------- constants

pub const PT_CONNECT = 1
pub const PT_ACCEPT = 2
pub const PT_REFUSE = 4
pub const PT_REDIRECT = 5
pub const PT_DATA = 6
pub const PT_RESEND = 11
pub const PT_MARKER = 12
pub const PT_CONTROL = 14

const HEADER = 8
const DATA_FLAGS_EOF = 0x40
const MARKER_BREAK = 1
const MARKER_RESET = 2

const VERSION_DESIRED = 319
const VERSION_MINIMUM = 300
const VERSION_MIN_ACCEPTED = 315
const VERSION_MIN_OOB_CHECK = 318
const NSI_NA_REQUIRED = 0x10
const NSI_FLAGS = 0x84                  // security renegotiation, NA disabled
const SDU = 8192
const MAX_CONNECT_DATA = 230

