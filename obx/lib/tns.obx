    5, 1, 1, 6, 2, 10, 7, 2, 10, 9, 1, 1, 15, 1, 1, 39, 39, 1, 68, 2, 10, 91, 2, 10,
    94, 1, 1, 95, 23, 1, 96, 96, 1, 97, 96, 1, 100, 100, 1, 101, 101, 1, 102, 102, 1, 104, 11, 1,
    106, 106, 1, 108, 109, 1, 109, 109, 1, 110, 111, 1, 111, 111, 1, 112, 112, 1, 113, 113, 1, 114, 114, 1,
    115, 115, 1, 116, 102, 1, 119, 119, 1, 198, 198, 1, 146, 146, 1, 152, 2, 10, 153, 2, 10, 154, 2, 10,
    155, 1, 1, 156, 12, 10, 172, 2, 10, 178, 178, 1, 179, 179, 1, 180, 180, 1, 181, 181, 1, 182, 182, 1,
    183, 183, 1, 184, 12, 10, 185, 185, 1, 186, 186, 1, 187, 187, 1, 188, 188, 1, 189, 189, 1, 190, 190, 1,
    195, 112, 1, 196, 113, 1, 197, 114, 1, 208, 208, 1, 231, 231, 1, 232, 231, 1, 233, 233, 1, 241, 109, 1,
    252, 252, 1, 590, 590, 1, 591, 591, 1, 592, 592, 1, 613, 613, 1, 614, 614, 1, 615, 615, 1, 616, 616, 1,
    611, 611, 1, 612, 612, 1, 593, 593, 1, 594, 594, 1, 595, 595, 1, 596, 596, 1, 597, 597, 1, 598, 598, 1,
    599, 599, 1, 600, 600, 1, 601, 601, 1, 602, 602, 1, 603, 603, 1, 604, 604, 1, 605, 605, 1, 622, 622, 1,
    623, 623, 1, 624, 624, 1, 625, 625, 1, 626, 626, 1, 627, 627, 1, 628, 628, 1, 629, 629, 1, 630, 630, 1,
    631, 631, 1, 632, 632, 1, 637, 637, 1, 638, 638, 1, 636, 636, 1, 639, 639, 1, 663, 663, 1, 640, 640, 1,
    652, 652, 1, 646, 646, 1, 647, 647, 1, 127, 127, 1, 660, 660, 1, 661, 661, 1, 665, 665, 1, 668, 668, 1,
    669, 669, 1, 670, 670, 1
]

fn putProtocol(m: mut &[]byte) {
    put8(m, MT_PROTOCOL)
    put8(m, 6)
    put8(m, 0)
    putStr(m, "obx")
    put8(m, 0)
}

fn putDataTypes(m: mut &[]byte, fv: int, eor: bool) {
    put8(m, MT_DATA_TYPES)
    put16le(m, CHARSET_UTF8)
    put16le(m, CHARSET_UTF8)
    put8(m, 0x01 | 0x02)
    putBytes(m, compileCaps(fv, eor))
    putBytes(m, runtimeCaps())
    var i = 0
    while i + 2 < len(DATA_TYPES) {
        put16be(m, DATA_TYPES[i])
        put16be(m, DATA_TYPES[i + 1])
        put16be(m, DATA_TYPES[i + 2])
        put16be(m, 0)
        i += 3
    }
    put16be(m, 0)
}

fn (s: mut &Session) nextSeq(): int {
    s.seq = (s.seq + 1) & 0xff
    if s.seq == 0 { s.seq = 1 }
    return s.seq
}

// A function message's header, after the piggybacks (cursors to close).
fn (s: mut &Session) header(m: mut &[]byte, fnCode: int) {
    if s.streamCursor != 0 {
        append(mut &s.toClose, s.streamCursor)      // a stream left open: its cursor is closed now
        s.streamCursor = 0
    }
    if len(s.toClose) > 0 {
        put8(m, MT_PIGGYBACK)
        put8(m, FN_CLOSE_CURSORS)
        put8(m, s.nextSeq())
        if s.fieldVersion >= FV_23_1_EXT_1 { putUb(m, 0) }
        put8(m, 1)
        putUb(m, len(s.toClose))
        for id in s.toClose { putUb(m, id) }
        s.toClose = []
    }
    put8(m, MT_FUNCTION)
    put8(m, fnCode)
    put8(m, s.nextSeq())
    if s.fieldVersion >= FV_23_1_EXT_1 { putUb(m, 0) }
}

// Queues a server cursor to be closed with the next request.
pub fn (s: mut &Session) closeCursor(id: int) { if id != 0 { append(mut &s.toClose, id) } }

// Whether the server has the BOOLEAN type in SQL (Oracle Database 23 and up).
pub fn (s: &Session) hasBoolean(): bool { return s.fieldVersion >= FV_23_1 }

// Bytes received after a marker exchange or a packet: the next DATA payload.
type Data = value record { data: str; reset: bool }

fn (s: mut &Session) nextData(w: Where): Result[Data, Error] {
    var reset = false
    while true {
        let p = try s.t.receive(w)
        if p.ptype == PT_DATA {
            if len(p.data) < 2 { return Err(proto("a DATA packet without data flags")) }
            let flags = (int(p.data[0]) << 8) | int(p.data[1])
            if (flags & DATA_FLAGS_EOF) != 0 { return Err(ioErr("the server ended the session")) }
            if len(p.data) == 2 { continue }
            return Ok(Data{data: p.data[2..], reset: reset})
        } else if p.ptype == PT_MARKER {
            // The server broke off the call: reset, then the error follows.
            try s.t.sendPacket(PT_MARKER, 0, "\x01\x00\x02", w)
            var q = p
            while true {
                if q.ptype == PT_MARKER && len(q.data) >= 3 && int(q.data[2]) == MARKER_RESET { break }
                q = try s.t.receive(w)
            }
            reset = true
        } else if p.ptype == PT_CONTROL {
            continue
        } else {
            return Err(proto("a packet of type " + p.ptype.toStr() + " in a reply"))
        }
    }
    return Err(proto("unreachable"))
}

// Sends a request and decodes its reply into r.
pub fn (s: mut &Session) call(msg: &[]byte, r: mut &Reply, w: Where): Result[Unit, Error] {
    if s.broken { return Err(ioErr("the connection is broken by an earlier error")) }
    try s.settle(w)
    s.requests += 1
    match s.exchange(msg, r, w) {
        Ok(_) { return Ok(Unit{}) }
        Err(e) {
            s.broken = true
            return Err(e)
        }
    }
}

// Reads past the reply of a FETCH sent ahead (sendFetch) that its stream
// did not take: the server allows one request at a time, so it is read
// before the next one is sent. Its rows are dropped; the cursor is closed
// by the request that follows.
fn (s: mut &Session) settle(w: Where): Result[Unit, Error] {
    if !s.pending { return Ok(Unit{}) }
    s.pending = false
    let cols = replace(mut &s.pendingCols, [])
    var r = s.reply(K_EXECUTE, &cols, &[])
    r.raw = true
    // a row of NULLs before the first, for BIT_VECTOR repeats
    for i in 0..len(cols) {
        append(mut &r.rawStarts, 0)
        append(mut &r.rawLens, -1)
    }
    r.rawFirst = len(cols)
    match s.receive(mut &r, w) {
        Ok(_) { return Ok(Unit{}) }
        Err(e) {
            s.broken = true
            return Err(e)
        }
    }
}

// Sends a FETCH of up to n rows of a stream's cursor without reading its
// reply (receiveFetch reads it), so the server makes the next rows while
// the program uses the last ones. Until it is read, any other request
// reads it first and drops it (settle).
pub fn (s: mut &Session) sendFetch(cursorId: int, n: int, columns: &[]Column, w: Where): Result[Unit, Error] {
    if s.broken { return Err(ioErr("the connection is broken by an earlier error")) }
    try s.settle(w)
    var m: []byte = []
    let keep = s.streamCursor
    s.streamCursor = 0
    s.header(mut &m, FN_FETCH)
    s.streamCursor = keep
    putUb(mut &m, cursorId)
    putUb(mut &m, n)
    s.requests += 1
    match s.t.sendData(&m, w) {
        Ok(_) {}
        Err(e) {
            s.broken = true
            return Err(e)
        }
    }
    s.pending = true
    var cols: []Column = []
    for x in columns { append(mut &cols, x) }
    s.pendingCols = cols
    return Ok(Unit{})
}

// The reply of the FETCH sendFetch sent, its rows kept raw after prev's.
pub fn (s: mut &Session) receiveFetch(columns: &[]Column, prev: &Reply, w: Where): Result[Reply, Error] {
    if s.broken { return Err(ioErr("the connection is broken by an earlier error")) }
    if !s.pending { return Err(proto("no FETCH is outstanding")) }
    s.pending = false
    s.pendingCols = []
    var r = s.reply(K_EXECUTE, columns, &[])
    seedRaw(mut &r, prev)
    match s.receive(mut &r, w) {
        Ok(_) { return Ok(r) }
        Err(e) {
            s.broken = true
            return Err(e)
        }
    }
}

// Whether a FETCH sent ahead has a reply not yet read.
pub fn (s: &Session) hasPending(): bool { return s.pending }

fn (s: mut &Session) exchange(msg: &[]byte, r: mut &Reply, w: Where): Result[Unit, Error] {
    try s.t.sendData(msg, w)
    return s.receive(r, w)
}

// Reads one reply into r.
fn (s: mut &Session) receive(r: mut &Reply, w: Where): Result[Unit, Error] {
    var data = ""
    var total = 0
    while !r.done {
        if len(data) == 0 {
            let d = try s.nextData(w)
            data = d.data
            total += len(data)
        }
        if r.raw && int(data[0]) == MT_ROW_DATA && !(r.outMode && !r.described) {
            // a run of rows kept raw, scanned in place (decodeMessage's ROW_DATA)
            var p = 0
            var short = false
            while p < len(data) && int(data[p]) == MT_ROW_DATA {
                let q = try scanRaw(&data, p + 1, r)
                if q == RAW_SHORT {
                    short = true
                    break
                }
                p = q
            }
            data = data[p..]
            if short {
                let d = try s.nextData(w)
                total += len(d.data)
                if total > s.maxReply {
                    return Err(sqldialect.dbError(sqldialect.E_LIMIT, "tns: a reply larger than " + s.maxReply.toStr() + " bytes"))
                }
                data = if d.reset { d.data } else { data + d.data }
            }
            continue
        }
        var c = cursor(data)
        match decodeMessage(mut &c, r, s.fieldVersion) {
            Ok(_) { data = data[c.pos..] }
            Err(e) {
                if !c.short { return Err(e) }
                let d = try s.nextData(w)
                total += len(d.data)
                if total > s.maxReply {
                    return Err(sqldialect.dbError(sqldialect.E_LIMIT, "tns: a reply larger than " + s.maxReply.toStr() + " bytes"))
                }
                data = if d.reset { d.data } else { data + d.data }
            }
        }
    }
    if len(data) > 0 { return Err(proto(len(data).toStr() + " bytes after the end of a reply")) }
    s.inTransaction = (r.callStatus & 0x2) != 0
    for x in r.warnings { append(mut &s.warnings, x) }
    return Ok(Unit{})
}

// The error a reply ends with as an Error: ORA-nnnnn with the server's text.
pub fn serverError(e: &ErrorInfo): Error { return Error{code: e.num, state: "", msg: e.msg} }

fn hexUpper(s: str): str { return strings.toUpper(crypto.hex(s)) }

fn unhexOr(h: str, what: str): Result[str, Error] {
    match crypto.unhex(h) {
        Some(b) { return Ok(b) }
        None { return Err(proto(what + " is not hex")) }
    }
}

fn param(kv: &[]KeyValue, key: str): str {
    for p in kv { if p.key == key { return p.value } }
    return ""
}

fn paramInt(kv: &[]KeyValue, key: str): Result[int, Error] {
    match parseInt(param(kv, key)) {
        Some(v) { return Ok(v) }
        None { return Err(proto(key + " is not a number")) }
    }
}

fn putPair(m: mut &[]byte, k: str, v: str, flags: int) {
    putBytes2(m, k)
    putBytes2(m, v)
    putUb(m, flags)
}

// The verifier arithmetic of python-oracledb's auth.pyx (_generate_verifier)
// and the pairs of phase two that come from it.
pub type Verifier = value record {
    pub sessionKey: str         // AUTH_SESSKEY to send (hex)
    pub speedyKey: str          // AUTH_PBKDF2_SPEEDY_KEY (12c, hex) or ""
    pub password: str           // AUTH_PASSWORD (hex)
    pub comboKey: str           // the key that decrypts AUTH_SVR_RESPONSE
}

pub fn verifier(vtype: int, kv: &[]KeyValue, password: str, partB: str, salt1: str, salt2: str): Result[Verifier, Error] {
    let vfr = try unhexOr(param(kv, "AUTH_VFR_DATA"), "AUTH_VFR_DATA")
    var keylen = 0
    var hash = ""
    var pwKey = ""
    if vtype == 0x4815 {
        keylen = 32
        let iters = try paramInt(kv, "AUTH_PBKDF2_VGEN_COUNT")
        pwKey = match crypto.pbkdf2Sha512(password, vfr + "AUTH_PBKDF2_SPEEDY_KEY", iters, 64) {
            Ok(k) { k }
            Err(e) { return Err(cryptoFail(e)) }
        }
        let h = match crypto.sha512(pwKey + vfr) {
            Ok(x) { x }
            Err(e) { return Err(cryptoFail(e)) }
        }
        hash = h[0..32]
    } else if vtype == 0xb152 || vtype == 0x1b25 {
        keylen = 24
        let h = match crypto.sha1(password + vfr) {
            Ok(x) { x }
            Err(e) { return Err(cryptoFail(e)) }
        }
        hash = h + "\x00\x00\x00\x00"
    } else {
        return Err(sqldialect.dbError(sqldialect.E_PROTOCOL, "tns: password verifier type " + vtype.toStr() +
                                      " is not supported (10g verifiers are not)"))
    }
    let iv = "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    let server = try unhexOr(param(kv, "AUTH_SESSKEY"), "AUTH_SESSKEY")
    let partA = match crypto.aesCbcDecrypt(hash, iv, server, false) {
        Ok(x) { x }
        Err(e) { return Err(cryptoFail(e)) }
    }
    if len(partB) != len(partA) { return Err(proto("AUTH_SESSKEY of " + len(partA).toStr() + " bytes")) }
    let client = match crypto.aesCbcEncrypt(hash, iv, partB, true) {
        Ok(x) { x }
        Err(e) { return Err(cryptoFail(e)) }
    }
    var sessKey = ""
    var combo = ""
    if len(partA) == 48 {
        sessKey = hexUpper(client)[0..96]
        var x: []byte = []
        for i in 16..40 { append(mut &x, partA[i] ^ partB[i]) }
        let xs = strFromBytes(&x)
        let m1 = match crypto.md5(xs[0..16]) {
            Ok(v) { v }
            Err(e) { return Err(cryptoFail(e)) }
        }
        let m2 = match crypto.md5(xs[16..]) {
            Ok(v) { v }
            Err(e) { return Err(cryptoFail(e)) }
        }
        combo = (m1 + m2)[0..keylen]
    } else {
        if len(partA) < keylen { return Err(proto("AUTH_SESSKEY of " + len(partA).toStr() + " bytes")) }
        sessKey = hexUpper(client)[0..64]
        let salt = try unhexOr(param(kv, "AUTH_PBKDF2_CSK_SALT"), "AUTH_PBKDF2_CSK_SALT")
        let iters = try paramInt(kv, "AUTH_PBKDF2_SDER_COUNT")
        let temp = hexUpper(partB[0..keylen] + partA[0..keylen])
        combo = match crypto.pbkdf2Sha512(temp, salt, iters, keylen) {
            Ok(k) { k }
            Err(e) { return Err(cryptoFail(e)) }
        }
    }
    var speedy = ""
    if vtype == 0x4815 {
        let sk = match crypto.aesCbcEncrypt(combo, iv, salt1 + pwKey, true) {
            Ok(x) { x }
            Err(e) { return Err(cryptoFail(e)) }
        }
        speedy = hexUpper(sk[0..80])
    }
    let pw = match crypto.aesCbcEncrypt(combo, iv, salt2 + password, true) {
        Ok(x) { x }
        Err(e) { return Err(cryptoFail(e)) }
    }
    return Ok(Verifier{sessionKey: sessKey, speedyKey: speedy, password: hexUpper(pw), comboKey: combo})
}

fn random(n: int): Result[str, Error] {
    match crypto.randomBytes(n) {
        Ok(b) { return Ok(b) }
        Err(e) { return Err(cryptoFail(e)) }
    }
}

fn versionText(v: int, fv: int): str {
    if fv >= FV_18_1_EXT_1 {
        return ((v >> 24) & 0xff).toStr() + "." + ((v >> 16) & 0xff).toStr() + "." + ((v >> 12) & 0x0f).toStr() + "." +
               ((v >> 4) & 0xff).toStr() + "." + (v & 0x0f).toStr()
    }
    return ((v >> 24) & 0xff).toStr() + "." + ((v >> 20) & 0x0f).toStr() + "." + ((v >> 12) & 0x0f).toStr() + "." +
           ((v >> 8) & 0x0f).toStr() + "." + (v & 0x0f).toStr()
}

// A TLS handshake on sock, verified against the system's store or the
// Config's CA file, for the Server Certificate Name or else the host.
fn tlsOver(sock: net.Conn, cfg: &Config, w: Where): Result[Stream, Error] {
    var o = tls.defaults()
    o.insecureSkipVerify = cfg.trustServerCertificate
    o.caFile = cfg.caFile
    let ctx = match tls.client(o) {
        Ok(x) { x }
        Err(e) { return Err(tlsFail(e)) }
    }
    let name = if cfg.serverCertName != "" { cfg.serverCertName } else { cfg.host }
    return match ctx.connect(sock, name, w) {
        Ok(t) { Ok(Stream.Tls(t)) }
        Err(e) { Err(tlsFail(e)) }
    }
}

// Connects (TCP, TLS for tcps), negotiates the protocol and logs in.
// Every step parks only the task. A wrong password is the server's
// ORA-01017.
pub fn open(cfg: &Config, w: Where): Result[Session, Error] {
    let sock = match net.dial(addrOf(cfg.host, cfg.port), w) {
        Ok(c) { c }
        Err(e) { return Err(ioFail(e)) }
    }
    let nd = sock.setNoDelay(true)
    let st = if cfg.tls { try tlsOver(sock, cfg, w) } else { Stream.Plain(sock) }
    var s = Session{t: transport(st), fieldVersion: FV_MAX, seq: 0, broken: false, maxString: 4000, charset: 0,
                    ncharset: 0, banner: "", version: "", sessionId: 0, serial: 0, inTransaction: false, warnings: [],
                    maxReply: 1 << 30, toClose: [], streamCursor: 0, eor: false, fastAuth: false,
                    requests: 0, pending: false, pendingCols: []}
    try s.connect(cfg, w)
    try s.login(cfg, w)
    return Ok(s)
}

fn (s: mut &Session) connect(cfg: &Config, w: Where): Result[Unit, Error] {
    let desc = descriptor(cfg)
    var tries = 0
    while true {
        try s.t.sendPacket(PT_CONNECT, 0, connectBody(desc), w)
        if len(desc) > MAX_CONNECT_DATA {
            var d: []byte = []
            put16be(mut &d, 0)
            putStr(mut &d, desc)
            try s.t.sendPacket(PT_DATA, 0, strFromBytes(&d), w)
        }
        let p = try s.t.receive(w)
        if p.ptype == PT_ACCEPT {
            let a = try parseAccept(p.data)
            s.t.large = true
            s.t.sdu = max(512, min(a.sdu, 2097152))
            s.eor = a.version >= VERSION_MIN_END_OF_RESPONSE && (a.flags2 & ACCEPT_HAS_END_OF_RESPONSE) != 0
            s.fastAuth = (a.flags2 & ACCEPT_FAST_AUTH) != 0
            return Ok(Unit{})
        }
        if p.ptype == PT_REFUSE { return Err(refuseError(p.data, cfg)) }
        if p.ptype == PT_REDIRECT {
            return Err(sqldialect.dbError(sqldialect.E_PROTOCOL, "tns: the listener redirects the connection; redirects are not supported yet"))
        }
        if p.ptype != PT_RESEND || tries > 3 { return Err(proto("a packet of type " + p.ptype.toStr() + " for CONNECT")) }
        tries += 1
        // Over tcps the listener hands the connection to the database with a
        // RESEND flagged for TLS renegotiation: the TLS session ends there
        // (no close_notify) and a fresh handshake runs on the same socket
        // before CONNECT goes again (python-oracledb's renegotiate_tls).
        if (p.flags & PACKET_FLAG_TLS_RENEG) != 0 && s.t.s.isTls() {
            let tls.Detached{sock: sock, rest: rest} = s.t.s.takeTls().detach()
            if len(rest) > 0 || s.t.inbox.pos < s.t.inbox.end {
                return Err(proto("data after a RESEND for TLS renegotiation"))
            }
            s.t.s = try tlsOver(sock, cfg, w)
        }
    }
    return Err(proto("unreachable"))
}

fn (s: mut &Session) authOne(m: mut &[]byte, cfg: &Config) {
    s.header(m, FN_AUTH_PHASE_ONE)
    put8(m, 1)
    putUb(m, len(cfg.user))
    putUb(m, 0x1)                           // LOGON
    put8(m, 1)
    putUb(m, 5)
    put8(m, 1)
    put8(m, 1)
    putBytes(m, cfg.user)
    putPair(m, "AUTH_TERMINAL", "unknown", 0)
    putPair(m, "AUTH_PROGRAM_NM", cfg.program, 0)
    putPair(m, "AUTH_MACHINE", machine(), 0)
    putPair(m, "AUTH_PID", os.pid().toStr(), 0)
    putPair(m, "AUTH_SID", osUser(), 0)
}

// The server's banner, character sets and capabilities, from its PROTOCOL.
fn (s: mut &Session) useProtocol(info: &ProtocolInfo): Result[Unit, Error] {
    if len(info.compileCaps) <= 7 { return Err(proto("the server sent no compile capabilities")) }
    s.fieldVersion = min(FV_MAX, int(info.compileCaps[7]))
    if s.fieldVersion < 7 {
        return Err(sqldialect.dbError(sqldialect.E_PROTOCOL, "tns: the server's TTC field version " + s.fieldVersion.toStr() +
                                      " is older than Oracle Database 12.1's"))
    }
    s.maxString = if len(info.runtimeCaps) > 6 && (int(info.runtimeCaps[6]) & 0x04) != 0 { 32767 } else { 4000 }
    s.charset = info.charset
    s.ncharset = info.ncharset
    s.banner = info.banner
    if s.charset != CHARSET_UTF8 {
        return Err(sqldialect.dbError(sqldialect.E_PROTOCOL, "tns: the database character set is " + s.charset.toStr() +
                                      "; only AL32UTF8 (873) is supported"))
    }
    return Ok(Unit{})
}

// An empty reply for this session (ending as the server ends replies).
fn (s: &Session) reply(kind: int, columns: &[]Column, last: &[]Cell): Reply {
    var r = newReply(kind, columns, last)
    r.eor = s.eor
    return r
}

fn (s: mut &Session) login(cfg: &Config, w: Where): Result[Unit, Error] {
    var r1 = s.reply(K_AUTH, &[], &[])
    if s.fastAuth {
        // Oracle 23 and up: PROTOCOL, DATA_TYPES and phase one in one
        // message (python-oracledb's FastAuthMessage), written at field
        // version 13 (no token in the header).
        var m: []byte = []
        put8(mut &m, MT_FAST_AUTH)
        put8(mut &m, 1)                     // version
        put8(mut &m, 1)                     // the server converts characters
        put8(mut &m, 0)
        putProtocol(mut &m)
        put16be(mut &m, 0)
        put8(mut &m, 0)
        put16be(mut &m, 0)
        put8(mut &m, FV_19_1_EXT_1)
        putDataTypes(mut &m, FV_MAX, s.eor)
        s.fieldVersion = FV_19_1_EXT_1
        s.authOne(mut &m, cfg)
        s.fieldVersion = FV_MAX
        r1.fast = true
        try s.call(&m, mut &r1, w)
        try s.useProtocol(&r1.protocol)
    } else {
        // Protocol and data types first; the server ends neither reply
        // with END_OF_RESPONSE.
        var pr = newReply(K_PLAIN, &[], &[])
        var pm: []byte = []
        putProtocol(mut &pm)
        try s.call(&pm, mut &pr, w)
        if pr.hasError { return Err(serverError(&pr.error)) }
        try s.useProtocol(&pr.protocol)
        var dr = newReply(K_PLAIN, &[], &[])
        var dm: []byte = []
        putDataTypes(mut &dm, s.fieldVersion, s.eor)
        try s.call(&dm, mut &dr, w)
        if dr.hasError { return Err(serverError(&dr.error)) }
        var m1: []byte = []
        s.authOne(mut &m1, cfg)
        try s.call(&m1, mut &r1, w)
    }
    if r1.hasError && r1.error.num != 0 { return Err(serverError(&r1.error)) }
    var vtype = 0
    for p in r1.params { if p.key == "AUTH_VFR_DATA" { vtype = p.flags } }

    // Phase two: the session key and the encrypted password.
    let v = try verifier(vtype, &r1.params, cfg.password, try random(if len(param(&r1.params, "AUTH_SESSKEY")) == 96 { 48 } else { 32 }),
                         try random(16), try random(16))
    let twelve = vtype == 0x4815
    var m2: []byte = []
    s.header(mut &m2, FN_AUTH_PHASE_TWO)
    put8(mut &m2, 1)
    putUb(mut &m2, len(cfg.user))
    putUb(mut &m2, 0x1 | 0x100)
    put8(mut &m2, 1)
    putUb(mut &m2, if twelve { 7 } else { 6 })
    put8(mut &m2, 1)
    put8(mut &m2, 1)
    putBytes(mut &m2, cfg.user)
    putPair(mut &m2, "AUTH_SESSKEY", v.sessionKey, 1)
    if twelve { putPair(mut &m2, "AUTH_PBKDF2_SPEEDY_KEY", v.speedyKey, 0) }
    putPair(mut &m2, "AUTH_PASSWORD", v.password, 0)
    putPair(mut &m2, "SESSION_CLIENT_CHARSET", "873", 0)
    putPair(mut &m2, "SESSION_CLIENT_DRIVER_NAME", DRIVER_NAME, 0)
    putPair(mut &m2, "SESSION_CLIENT_VERSION", "16777216", 0)
    putPair(mut &m2, "AUTH_ALTER_SESSION", "ALTER SESSION SET TIME_ZONE='+00:00'\x00", 1)
    var r2 = s.reply(K_AUTH, &[], &[])
    try s.call(&m2, mut &r2, w)
    if r2.hasError && r2.error.num != 0 { return Err(serverError(&r2.error)) }
    let resp = try unhexOr(param(&r2.params, "AUTH_SVR_RESPONSE"), "AUTH_SVR_RESPONSE")
    let iv = "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    let plain = match crypto.aesCbcDecrypt(v.comboKey, iv, resp, false) {
        Ok(x) { x }
        Err(e) { return Err(cryptoFail(e)) }
    }
    if len(plain) < 32 || plain[16..32] != "SERVER_TO_CLIENT" {
        return Err(proto("the server's AUTH_SVR_RESPONSE does not prove it knows the password"))
    }
    s.sessionId = match parseInt(param(&r2.params, "AUTH_SESSION_ID")) {
        Some(x) { x }
        None { 0 }
    }
    s.serial = match parseInt(param(&r2.params, "AUTH_SERIAL_NUM")) {
        Some(x) { x }
        None { 0 }
    }
    match parseInt(param(&r2.params, "AUTH_VERSION_NO")) {
        Some(x) { s.version = versionText(x, s.fieldVersion) }
        None { }
    }
    return Ok(Unit{})
}

// ---------------------------------------------------------------- calls

// Runs an execute; the reply has the columns, the first rows and the end
// status (an ORA- error is r.error, not Err).
pub fn (s: mut &Session) execute(e: &Execute, columns: &[]Column, w: Where): Result[Reply, Error] {
    return s.executeAs(e, columns, false, w)
}

// execute, with rows kept raw (Reply.raw) when raw.
pub fn (s: mut &Session) executeAs(e: &Execute, columns: &[]Column, raw: bool, w: Where): Result[Reply, Error] {
    var m: []byte = []
    s.header(mut &m, FN_EXECUTE)
    executeBody(mut &m, e, s.fieldVersion, s.maxString)
    var r = s.reply(K_EXECUTE, columns, &[])
    r.raw = raw
    for i in 0..len(e.binds) {
        let b = e.binds[i]
        append(mut &r.binds, Column{name: ":" + (i + 1).toStr(), oraType: b.oraType, csfrm: b.csfrm, precision: 0, scale: -127,
                                    bufferSize: b.bufferSize, maxSize: b.bufferSize, nullable: true})
        if b.returning {
            append(mut &r.outIndex, i)
            r.returning = true
            r.outMode = true
        }
    }
    try s.call(&m, mut &r, w)
    // Large OUT values: the server asks for them to be flushed (python-oracledb's flush_out_binds)
    var rounds = 0
    while r.flush && rounds < 100 {
        r.flush = false
        r.done = false
        var f: []byte = []
        put8(mut &f, MT_FLUSH_OUT_BINDS)
        try s.call(&f, mut &r, w)
        rounds += 1
    }
    return Ok(r)
}

// A FETCH of up to n more rows of an open cursor, the rows kept raw after
// prev's (a stream's previous fetch: BIT_VECTOR may repeat its last row's
// values). The stream's own cursor is not closed by this request
// (streamCursor).
pub fn (s: mut &Session) fetchRaw(cursorId: int, n: int, columns: &[]Column, prev: &Reply, w: Where): Result[Reply, Error] {
    var m: []byte = []
    let keep = s.streamCursor
    s.streamCursor = 0
    s.header(mut &m, FN_FETCH)
    s.streamCursor = keep
    putUb(mut &m, cursorId)
    putUb(mut &m, n)
    var r = s.reply(K_EXECUTE, columns, &[])
    seedRaw(mut &r, prev)
    try s.call(&m, mut &r, w)
    return Ok(r)
}

// The next rows (up to n) of an open cursor, kept raw and added to r's: a
// buffered query keeps all its rows in one Reply, so BIT_VECTOR repeats
// find the row before across fetches. r's end status (error, hasError) is
// this round trip's. A FETCH; for a REF CURSOR or implicit result (ref)
// an EXECUTE with FETCH alone on its cursor, as python-oracledb does for a
// cursor without SQL.
pub fn (s: mut &Session) fetchInto(cursorId: int, n: int, ref: bool, r: mut &Reply, w: Where): Result[Unit, Error] {
    var m: []byte = []
    if ref {
        let e = Execute{sql: "", kind: S_QUERY, cursorId: cursorId, binds: [], prefetch: n, commit: false, fetchOnly: true}
        s.header(mut &m, FN_EXECUTE)
        executeBody(mut &m, &e, s.fieldVersion, s.maxString)
    } else {
        s.header(mut &m, FN_FETCH)
        putUb(mut &m, cursorId)
        putUb(mut &m, n)
    }
    r.raw = true
    r.done = false
    r.hasError = false
    r.error = ErrorInfo{num: 0, msg: "", pos: 0, cursorId: 0, rowCount: 0, callStatus: 0}
    r.callStatus = 0
    r.warnings = []
    r.eor = s.eor
    try s.call(&m, r, w)
    return Ok(Unit{})
}

// COMMIT, ROLLBACK or LOGOFF; the server's error, if any, as Err.
pub fn (s: mut &Session) simple(fnCode: int, w: Where): Result[Unit, Error] {
    var m: []byte = []
    s.header(mut &m, fnCode)
    var r = s.reply(K_PLAIN, &[], &[])
    try s.call(&m, mut &r, w)
    if r.hasError && r.error.num != 0 { return Err(serverError(&r.error)) }
    return Ok(Unit{})
}

pub fn (s: mut &Session) commit(w: Where): Result[Unit, Error] { return s.simple(FN_COMMIT, w) }
pub fn (s: mut &Session) rollback(w: Where): Result[Unit, Error] { return s.simple(FN_ROLLBACK, w) }

// Logs off (when the session is not broken) and closes the socket.
pub fn (s: mut &Session) close(w: Where) {
    if !s.broken {
        let r = s.simple(FN_LOGOFF, w)
        if !s.broken {
            var eof: []byte = []
            put16be(mut &eof, DATA_FLAGS_EOF)
            let r2 = s.t.sendPacket(PT_DATA, 0, strFromBytes(&eof), w)
        }
    }
    s.broken = true
    let old = replace(mut &s.t.s, Stream.Gone)
}

// ---------------------------------------------------------------- streamed values (sqlrows)

// A column for sqlrows: wire is the Oracle type, aux its csfrm.
pub fn describe(cols: &[]Column): []sqlrows.Column {
    var out: []sqlrows.Column = []
    for c in cols {
        let nullable = if c.nullable { sqlrows.NULLABLE_YES } else { sqlrows.NULLABLE_NO }
        append(mut &out, sqlrows.column(c.name, typeText(&c), kindsOf(&c), nullable, c.oraType, c.maxSize, c.precision,
                                        c.scale, c.csfrm))
    }
    return out
}

// "NUMBER(10,2)", "NUMBER", "VARCHAR2", ...
fn typeText(c: &Column): str {
    if c.oraType == T_NUMBER && c.precision > 0 {
        if c.scale == -127 { return "FLOAT(" + c.precision.toStr() + ")" }
        return "NUMBER(" + c.precision.toStr() + "," + c.scale.toStr() + ")"
    }
    return c.typeName()
}

// What a column can be read as (design/db-streaming.md, section 3). A
// NUMBER without precision (what Oracle says for COUNT(*), SUM, ROWNUM and
// most expressions) reads as int too, each value checked; NUMBER(p, 0)
// only for p up to 18.
fn kindsOf(c: &Column): int {
    let t = c.oraType
    if t == T_NUMBER {
        if c.precision == 0 || (c.scale == 0 && c.precision <= 18) {
            return sqlrows.kinds(&[sqlrows.Kind.Decimal, sqlrows.Kind.Int])
        }
        return sqlrows.kinds(&[sqlrows.Kind.Decimal])
    }
    if t == T_BINARY_INTEGER { return sqlrows.kinds(&[sqlrows.Kind.Int, sqlrows.Kind.Decimal]) }
    if t == T_BINARY_FLOAT || t == T_BINARY_DOUBLE { return sqlrows.kinds(&[sqlrows.Kind.Float]) }
    if t == T_VARCHAR || t == T_CHAR || t == T_LONG || t == T_ROWID { return sqlrows.kinds(&[sqlrows.Kind.Text]) }
    if t == T_RAW || t == T_LONG_RAW { return sqlrows.kinds(&[sqlrows.Kind.Bytes]) }
    if t == T_DATE { return sqlrows.kinds(&[sqlrows.Kind.DateTime, sqlrows.Kind.Date]) }
    if t == T_TIMESTAMP || t == T_TIMESTAMP_LTZ { return sqlrows.kinds(&[sqlrows.Kind.DateTime]) }
    if t == T_TIMESTAMP_TZ { return sqlrows.kinds(&[sqlrows.Kind.OffsetDateTime]) }
    if t == T_BOOLEAN { return sqlrows.kinds(&[sqlrows.Kind.Bool]) }
    return 0
}

// A NUMBER as units * 10^-scale (scale 0 to 38, no trailing zeros in the
// fraction), straight from its bytes; None when it needs more than 38
// digits or a scale outside 0 to 38 (the slow path then: decodeNumber).
type Fixed = value record { units: i128; scale: int }

const MAX38: i128 = 99999999999999999999999999999999999999

fn numberFixed(b: &str): Result[Option[Fixed], Error] {
    let n = len(b)
    if n == 0 || n > 21 { return Err(proto("a NUMBER of " + n.toStr() + " bytes")) }
    let b0 = int(b[0])
    let pos = (b0 & 0x80) != 0
    if n == 1 {
        if pos { return Ok(Some(Fixed{units: 0, scale: 0})) }
        return Err(typeErr("the NUMBER is -1e126 (Oracle's negative infinity)"))
    }
    let e = (if pos { b0 } else { (~b0) & 0xff }) - 193
    var last = n
    if !pos && int(b[n - 1]) == 102 { last = n - 1 }
    let pairs = last - 1
    if pairs > 19 { return Ok(None) }
    var p = e - pairs + 1                // value = u * 100^p
    if pairs + max(p, 0) <= 9 {
        // up to 18 digits: in an int
        var s = 0
        for i in 1..last {
            let v = if pos { int(b[i]) - 1 } else { 101 - int(b[i]) }
            if v < 0 || v > 99 { return Err(proto("a NUMBER mantissa byte " + int(b[i]).toStr())) }
            s = s * 100 + v
        }
        for k in 0..p { s = s * 100 }
        var sc = if p < 0 { -2 * p } else { 0 }
        while sc > 0 && s % 10 == 0 {
            s = s / 10
            sc -= 1
        }
        if sc > 38 { return Ok(None) }
        return Ok(Some(Fixed{units: i128(if pos { s } else { -s }), scale: sc}))
    }
    var u: i128 = 0
    for i in 1..last {
        let v = if pos { int(b[i]) - 1 } else { 101 - int(b[i]) }
        if v < 0 || v > 99 { return Err(proto("a NUMBER mantissa byte " + int(b[i]).toStr())) }
        u = u * 100 + i128(v)
    }
    var scale = 0
    while p > 0 {
        if u > MAX38 / 100 { return Ok(None) }
        u = u * 100
        p -= 1
    }
    if p < 0 { scale = -2 * p }
    while scale > 0 && u % 10 == 0 {
        u = u / 10
        scale -= 1
    }
    if scale > 38 { return Ok(None) }
    return Ok(Some(Fixed{units: if pos { u } else { -u }, scale: scale}))
}

// A NUMBER's bytes as an int when it is an integer that numberFixed reads
// and int holds; None otherwise (also for malformed bytes: the caller's
// slow path, decodeNumber, says what is wrong).
pub fn fixedInt(b: &str): Option[int] {
    match numberFixed(b) {
        Ok(o) {
            match o {
                Some(f) {
                    if f.scale == 0 && f.units <= i128(9223372036854775807) && f.units >= -i128(9223372036854775807) - 1 {
                        return Some(int(f.units))
                    }
                }
                None {}
            }
        }
        Err(_) {}
    }
    return None
}

// A NUMBER's bytes as a Decimal (the display scale its digits need) when
// numberFixed reads it; None otherwise, as fixedInt.
pub fn fixedDecimal(b: &str): Option[Decimal] {
    match numberFixed(b) {
        Ok(o) {
            match o {
                Some(f) { return Some(fromFraction(f.units, f.scale)) }
                None {}
            }
        }
        Err(_) {}
    }
    return None
}

fn oInt(b: &str, col: &sqlrows.Column): Result[int, Error] {
    if col.wire != T_NUMBER && col.wire != T_BINARY_INTEGER { return Err(sqlrows.wrongKind(col, "int")) }
    match try numberFixed(b) {
        Some(f) {
            if f.scale == 0 && f.units <= i128(9223372036854775807) && f.units >= -i128(9223372036854775807) - 1 {
                return Ok(int(f.units))
            }
        }
        None {}
    }
    let num = try decodeNumber(b)
    return Err(typeErr(num.toStr() + " is not an int"))
}

fn oDecimal(b: &str, col: &sqlrows.Column): Result[Decimal, Error] {
    if col.wire == T_BINARY_FLOAT || col.wire == T_BINARY_DOUBLE {
        return Err(sqldialect.dbError(sqldialect.E_INEXACT, "a binary float is not exact as a decimal"))
    }
    if col.wire != T_NUMBER && col.wire != T_BINARY_INTEGER { return Err(sqlrows.wrongKind(col, "Decimal")) }
    var d = Decimal.zero()
    match try numberFixed(b) {
        Some(f) { d = fromFraction(f.units, f.scale) }
        None {
            let num = try decodeNumber(b)
            d = match num.decimal() {
                Ok(x) { x }
                Err(e) { return Err(sqldialect.dbError(sqldialect.E_INEXACT, num.toStr() + " has more digits than a Decimal")) }
            }
        }
    }
    let s = col.scale
    if s > 0 && s != -127 && d.scale() < s {
        match d.withScale(s) {
            Ok(x) { return Ok(x) }
            Err(_) { return Ok(d) }
        }
    }
    return Ok(d)
}

fn oFloat(b: &str, col: &sqlrows.Column): Result[float, Error] {
    if col.wire == T_BINARY_DOUBLE { return decodeDouble(b) }
    if col.wire == T_BINARY_FLOAT { return decodeFloat(b) }
    return Err(sqlrows.wrongKind(col, "float"))
}

fn oText(b: &str, col: &sqlrows.Column): Result[str, Error] {
    let t = col.wire
    if t == T_ROWID { return Ok(b) }
    if t != T_VARCHAR && t != T_CHAR && t != T_LONG { return Err(sqlrows.wrongKind(col, "text")) }
    if col.aux == CS_NCHAR { return fromUtf16be(b) }
    if !strings.isValidUtf8(b) { return Err(typeErr("invalid UTF-8")) }
    return Ok(b)
}

fn oBytes(b: &str, col: &sqlrows.Column): Result[str, Error] {
    if col.wire != T_RAW && col.wire != T_LONG_RAW { return Err(sqlrows.wrongKind(col, "bytes")) }
    return Ok(b)
}

fn oBool(b: &str, col: &sqlrows.Column): Result[bool, Error] {
    if col.wire != T_BOOLEAN { return Err(sqlrows.wrongKind(col, "bool")) }
    return Ok(len(b) > 0 && int(b[len(b) - 1]) == 1)
}

fn stampOf(b: &str, col: &sqlrows.Column, kind: str): Result[Stamp, Error] {
    let t = col.wire
    if t != T_DATE && t != T_TIMESTAMP && t != T_TIMESTAMP_TZ && t != T_TIMESTAMP_LTZ { return Err(sqlrows.wrongKind(col, kind)) }
    return decodeStamp(b)
}

fn oDate(b: &str, col: &sqlrows.Column): Result[time.Date, Error] {
    let s = try stampOf(b, col, "date")
    if s.hasOffset { return Err(sqlrows.wrongKind(col, "date")) }
    if s.local.time.nanos != 0 { return Err(sqldialect.dbError(sqldialect.E_INEXACT, "the value has a time of day")) }
    return Ok(s.local.date)
}

fn oTime(b: &str, col: &sqlrows.Column): Result[time.TimeOfDay, Error] {
    let s = try stampOf(b, col, "time")
    if s.hasOffset { return Err(sqlrows.wrongKind(col, "time")) }
    return Ok(s.local.time)
}

fn oDateTime(b: &str, col: &sqlrows.Column): Result[time.LocalDateTime, Error] {
    let s = try stampOf(b, col, "date-time")
    if s.hasOffset { return Err(sqlrows.wrongKind(col, "date-time")) }
    return Ok(s.local)
}

fn oOffset(b: &str, col: &sqlrows.Column): Result[time.OffsetDateTime, Error] {
    let s = try stampOf(b, col, "date-time with offset")
    if !s.hasOffset { return Err(sqlrows.wrongKind(col, "date-time with offset")) }
    return Ok(time.OffsetDateTime{local: s.local, offset: s.offset})
}

// How sqlrows.RowView decodes Oracle values.
pub fn codec(): sqlrows.Codec {
    return sqlrows.Codec{int: oInt, decimal: oDecimal, float: oFloat, text: oText, bytes: oBytes, bool: oBool, date: oDate,
                         time: oTime, dateTime: oDateTime, offsetDateTime: oOffset}
}
