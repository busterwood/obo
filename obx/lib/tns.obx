pub const DRIVER_NAME = "obx thn : 0.1"

// ---------------------------------------------------------------- errors

fn proto(msg: str): Error { return sqldialect.dbError(sqldialect.E_PROTOCOL, "tns: " + msg) }

fn ioErr(msg: str): Error { return sqldialect.dbError(sqldialect.E_IO, "tns: " + msg) }

fn ioFail(e: io.IoError): Error {
    if e.isCancelled() { return sqldialect.dbError(sqldialect.E_CANCELLED, "tns: cancelled") }
    if e.isTimeout() { return sqldialect.dbError(sqldialect.E_TIMEOUT, "tns: deadline passed") }
    return ioErr(e.toStr())
}

fn tlsFail(e: tls.Error): Error {
    if e.kind == tls.Kind.Cancelled { return sqldialect.dbError(sqldialect.E_CANCELLED, "tns: cancelled") }
    if e.kind == tls.Kind.Timeout { return sqldialect.dbError(sqldialect.E_TIMEOUT, "tns: deadline passed") }
    if e.kind == tls.Kind.Io { return ioErr(e.cause.toStr()) }
    return ioErr(e.toStr())
}

fn cryptoFail(e: crypto.Error): Error { return proto(e.toStr()) }

fn typeErr(msg: str): Error { return sqldialect.dbError(sqldialect.E_TYPE, msg) }

// ---------------------------------------------------------------- writing

fn put8(b: mut &[]byte, v: int) { append(b, byte(v & 0xff)) }

fn put16be(b: mut &[]byte, v: int) {
    append(b, byte((v >> 8) & 0xff))
    append(b, byte(v & 0xff))
}

fn put16le(b: mut &[]byte, v: int) {
    append(b, byte(v & 0xff))
    append(b, byte((v >> 8) & 0xff))
}

fn put32be(b: mut &[]byte, v: int) {
    for k in 0..4 { append(b, byte((v >> (24 - 8 * k)) & 0xff)) }
}

fn put64be(b: mut &[]byte, v: int) {
    for k in 0..8 { append(b, byte((v >> (56 - 8 * k)) & 0xff)) }
}

fn putStr(b: mut &[]byte, s: str) { appendStr(b, s) }

// A universal unsigned integer (ub2, ub4, ub8): a length byte, then that
// many big-endian bytes (1, 2, 4 or 8); 0 is the single byte 0.
pub fn putUb(b: mut &[]byte, v: int) {
    if v == 0 {
        put8(b, 0)
    } else if v > 0 && v <= 0xff {
        put8(b, 1)
        put8(b, v)
    } else if v > 0 && v <= 0xffff {
        put8(b, 2)
        put16be(b, v)
    } else if v > 0 && v <= 0xffffffff {
        put8(b, 4)
        put32be(b, v)
    } else {
        put8(b, 8)
        put64be(b, v)
    }
}

// A universal signed 4-byte integer (sb4): the sign in bit 7 of the length.
fn putSb4(b: mut &[]byte, v: int) {
    let sign = if v < 0 { 0x80 } else { 0 }
    let a = if v < 0 { -v } else { v }
    if a == 0 {
        put8(b, 0)
    } else if a <= 0xff {
        put8(b, 1 | sign)
        put8(b, a)
    } else if a <= 0xffff {
        put8(b, 2 | sign)
        put16be(b, a)
    } else {
        put8(b, 4 | sign)
        put32be(b, a)
    }
}

// Bytes with a length: up to 252 bytes after a length byte; longer ones as
// 254, then chunks of at most 32767 bytes each after a ub4 length, then a
// ub4 0. Nothing (a 0 byte) is how a NULL or empty value goes.
pub fn putBytes(b: mut &[]byte, s: str) {
    let n = len(s)
    if n <= 252 {
        put8(b, n)
        putStr(b, s)
        return
    }
    put8(b, 254)
    var off = 0
    while off < n {
        let k = min(32767, n - off)
        putUb(b, k)
        putStr(b, s[off..off + k])
        off += k
    }
    putUb(b, 0)
}

// A ub4 length, then (when not empty) the bytes with a length.
fn putBytes2(b: mut &[]byte, s: str) {
    putUb(b, len(s))
    if len(s) > 0 { putBytes(b, s) }
}

// ---------------------------------------------------------------- reading

// A cursor over received bytes. Every read checks the bytes there are; when
// they run out, short is set (the message may continue in the next packet).
pub type Cur = value record { s: str; pub pos: int; pub short: bool }

pub fn cursor(s: str): Cur { return Cur{s: s, pos: 0, short: false} }

fn (c: &Cur) left(): int { return len(c.s) - c.pos }

fn (c: mut &Cur) need(n: int, what: str): Result[Unit, Error] {
    if n < 0 { return Err(proto(what + ": a length of " + n.toStr())) }
    if n > len(c.s) - c.pos {
        c.short = true
        return Err(proto(what + ": " + n.toStr() + " bytes needed, " + (len(c.s) - c.pos).toStr() + " left"))
    }
    return Ok(Unit{})
}

fn (c: mut &Cur) u8(what: str): Result[int, Error] {
    try c.need(1, what)
    let v = int(c.s[c.pos])
    c.pos += 1
    return Ok(v)
}

fn (c: mut &Cur) u16be(what: str): Result[int, Error] {
    try c.need(2, what)
    let v = (int(c.s[c.pos]) << 8) | int(c.s[c.pos + 1])
    c.pos += 2
    return Ok(v)
}

fn (c: mut &Cur) u16le(what: str): Result[int, Error] {
    try c.need(2, what)
    let v = int(c.s[c.pos]) | (int(c.s[c.pos + 1]) << 8)
    c.pos += 2
    return Ok(v)
}

fn (c: mut &Cur) u32be(what: str): Result[int, Error] {
    try c.need(4, what)
    var v = 0
    for k in 0..4 { v = (v << 8) | int(c.s[c.pos + k]) }
    c.pos += 4
    return Ok(v)
}

fn (c: mut &Cur) take(n: int, what: str): Result[str, Error] {
    try c.need(n, what)
    let v = c.s[c.pos..c.pos + n]
    c.pos += n
    return Ok(v)
}

fn (c: mut &Cur) skip(n: int, what: str): Result[Unit, Error] {
    try c.need(n, what)
    c.pos += n
    return Ok(Unit{})
}

// A universal integer of at most maxBytes bytes; negative when the length
// byte has bit 7 (the signed types).
fn (c: mut &Cur) uni(maxBytes: int, what: str): Result[int, Error] {
    let l = try c.u8(what)
    if l == 0 { return Ok(0) }
    let neg = (l & 0x80) != 0
    let n = l & 0x7f
    if n > maxBytes { return Err(proto(what + ": an integer of " + n.toStr() + " bytes")) }
    try c.need(n, what)
    var v = 0
    for k in 0..n { v = (v << 8) | int(c.s[c.pos + k]) }
    c.pos += n
    return Ok(if neg { -v } else { v })
}

pub fn (c: mut &Cur) ub2(what: str): Result[int, Error] { return c.uni(2, what) }
pub fn (c: mut &Cur) ub4(what: str): Result[int, Error] { return c.uni(4, what) }
pub fn (c: mut &Cur) ub8(what: str): Result[int, Error] { return c.uni(8, what) }

fn (c: mut &Cur) skipUb(what: str): Result[Unit, Error] {
    let v = try c.uni(8, what)
    return Ok(Unit{})
}

fn (c: mut &Cur) skipN(n: int, what: str): Result[Unit, Error] {
    for i in 0..n { try c.skipUb(what) }
    return Ok(Unit{})
}

// Bytes with a length (putBytes's form); None for NULL (a length of 0 or 255).
pub fn (c: mut &Cur) bytes(what: str): Result[Option[str], Error] {
    let l = try c.u8(what)
    if l == 0 || l == 255 { return Ok(None) }
    if l != 254 { return Ok(Some(try c.take(l, what))) }
    var out: []byte = []
    while true {
        let k = try c.ub4(what)
        if k == 0 { break }
        let part = try c.take(k, what)
        appendStr(mut &out, part)
    }
    return Ok(Some(strFromBytes(&out)))
}

fn (c: mut &Cur) bytesOrEmpty(what: str): Result[str, Error] {
    match try c.bytes(what) {
        Some(b) { return Ok(b) }
        None { return Ok("") }
    }
}

// A ub4 length, then (when not 0) bytes with a length.
fn (c: mut &Cur) str2(what: str): Result[str, Error] {
    let n = try c.ub4(what)
    if n == 0 { return Ok("") }
    return c.bytesOrEmpty(what)
}

// ---------------------------------------------------------------- text

fn utf8(b: str, what: str): Result[str, Error] {
    if !strings.isValidUtf8(b) { return Err(proto(what + ": invalid UTF-8")) }
    return Ok(b)
}

// UTF-8 text as UTF-16BE (NCHAR binds).
pub fn toUtf16be(s: str): Result[str, Error] {
    var out: []byte = []
    var i = 0
    while i < len(s) {
        let c = s[i]
        if c < 0x80 {
            append(mut &out, byte(0))
            append(mut &out, c)
            i += 1
            continue
        }
        let d = strings.decodeAt(s, i)
        if !d.ok { return Err(sqldialect.inputError("invalid UTF-8 at byte " + i.toStr())) }
        if d.rune >= 0x10000 {
            put16be(mut &out, 0xd800 + ((d.rune - 0x10000) >> 10))
            put16be(mut &out, 0xdc00 + ((d.rune - 0x10000) & 0x3ff))
        } else {
            put16be(mut &out, d.rune)
        }
        i += d.size
    }
    return Ok(strFromBytes(&out))
}

// UTF-16BE bytes as UTF-8; Err for an odd length or a lone surrogate.
pub fn fromUtf16be(b: str): Result[str, Error] {
    if len(b) % 2 != 0 { return Err(proto("UTF-16 text with an odd number of bytes")) }
    var out = newStrBuf()
    var i = 0
    while i < len(b) {
        var u = (int(b[i]) << 8) | int(b[i + 1])
        if u >= 0xd800 && u <= 0xdfff {
            let lo = if i + 3 < len(b) { (int(b[i + 2]) << 8) | int(b[i + 3]) } else { 0 }
            if u >= 0xdc00 || lo < 0xdc00 || lo > 0xdfff {
                return Err(proto("invalid UTF-16: a lone surrogate at unit " + (i / 2).toStr()))
            }
            u = 0x10000 + ((u - 0xd800) << 10) + (lo - 0xdc00)
            i += 2
        }
        strings.addRune(mut &out, u)
        i += 2
    }
    return Ok(out.toStr())
}

// ---------------------------------------------------------------- NUMBER

// An Oracle NUMBER, exactly: (-1 if neg) * digits * 10^exp, where digits
// has no leading and no trailing zero ("" for zero, with exp 0). Up to 40
// digits (Oracle's binary arithmetic gives 39 and 40, as 1/3 does).
pub type Num = value record {
    pub neg: bool
    pub digits: str
    pub exp: int
}

pub fn numOfDecimal(d: Decimal): Num {
    if d.isZero() { return Num{neg: false, digits: "", exp: 0} }
    return Num{neg: d.isNeg(), digits: d.coefficient().toStr(), exp: d.exponent()}
}

pub fn numOfInt(n: int): Num { return numOfDecimal(Decimal.fromInt(n)) }

// The number as Oracle and python-oracledb write it: "-12.5", "0.001", "1000".
pub fn (n: &Num) toStr(): str {
    if n.digits == "" { return "0" }
    let sign = if n.neg { "-" } else { "" }
    if n.exp >= 0 { return sign + n.digits + repeat("0", n.exp) }
    let point = len(n.digits) + n.exp
    if point <= 0 { return sign + "0." + repeat("0", -point) + n.digits }
    return sign + n.digits[0..point] + "." + n.digits[point..]
}

// The Decimal; Err(DecError.Precision) for 39 and 40 digits.
pub fn (n: &Num) decimal(): Result[Decimal, DecError] {
    if n.digits == "" { return Ok(Decimal.zero()) }
    if len(n.digits) > 38 { return Err(DecError.Precision) }
    let sign = if n.neg { "-" } else { "" }
    return Decimal.parse(sign + n.digits + "e" + n.exp.toStr())
}

// The int, if the number is an integer within int's range.
pub fn (n: &Num) int(): Option[int] {
    if n.digits == "" { return Some(0) }
    if n.exp < 0 || len(n.digits) + n.exp > 19 { return None }
    var v: i128 = 0
    for i in 0..len(n.digits) { v = v * 10 + i128(n.digits[i] - '0') }
    for i in 0..n.exp { v = v * 10 }
    if n.neg { v = -v }
    if v > i128(9223372036854775807) || v < -i128(9223372036854775807) - 1 { return None }
    return Some(int(v))
}

// The NUMBER bytes of n (1 to 22 bytes). E_INPUT outside Oracle's range
// (more than 40 digits, 1e126 and up, below 1e-130).
pub fn encodeNumber(n: &Num): Result[str, Error] {
    if n.digits == "" { return Ok("\x80") }
    var d = n.digits
    var dpi = len(d) + n.exp            // the digits before the decimal point
    if len(d) > 40 || dpi > 126 || dpi < -129 {
        return Err(sqldialect.inputError("a number outside Oracle NUMBER's range (at most 40 digits, from 1e-130 to below 1e126): " +
                                          (if n.neg { "-" } else { "" }) + n.digits + "e" + n.exp.toStr()))
    }
    if floorMod(dpi, 2) == 1 {
        d = "0" + d
        dpi += 1
    }
    if len(d) % 2 == 1 { d = d + "0" }
    let pairs = len(d) / 2
    var b: []byte = []
    var e = floorDiv(dpi, 2) + 192
    if n.neg { e = (~e) & 0xff }
    put8(mut &b, e)
    for p in 0..pairs {
        let v = int(d[2 * p] - '0') * 10 + int(d[2 * p + 1] - '0')
        put8(mut &b, if n.neg { 101 - v } else { v + 1 })
    }
    if n.neg && len(d) < 40 { put8(mut &b, 102) }
    return Ok(strFromBytes(&b))
}

// The number in NUMBER bytes. Err for a malformed one and for -1e126
// (Oracle's "negative infinity", a single byte 0).
pub fn decodeNumber(b: str): Result[Num, Error] {
    let n = len(b)
    if n == 0 || n > 21 { return Err(proto("a NUMBER of " + n.toStr() + " bytes")) }
    let b0 = int(b[0])
    let pos = (b0 & 0x80) != 0
    if n == 1 {
        if pos { return Ok(Num{neg: false, digits: "", exp: 0}) }
        return Err(typeErr("the NUMBER is -1e126 (Oracle's negative infinity)"))
    }
    let e = (if pos { b0 } else { (~b0) & 0xff }) - 193
    var last = n
    if !pos && int(b[n - 1]) == 102 { last = n - 1 }
    var ds = newStrBuf()
    for i in 1..last {
        let v = if pos { int(b[i]) - 1 } else { 101 - int(b[i]) }
        if v < 0 || v > 99 { return Err(proto("a NUMBER mantissa byte " + int(b[i]).toStr())) }
        ds.addByte(byte(48 + v / 10))
        ds.addByte(byte(48 + v % 10))
    }
    let all = ds.toStr()
    // value = 0.all * 10^(2e + 2)
    var lo = 0
    while lo < len(all) && all[lo] == '0' { lo += 1 }
    var hi = len(all)
    while hi > lo && all[hi - 1] == '0' { hi -= 1 }
    if lo == hi { return Ok(Num{neg: false, digits: "", exp: 0}) }
    return Ok(Num{neg: !pos, digits: all[lo..hi], exp: 2 * e + 2 - hi})
}

// ---------------------------------------------------------------- floats

// The IEEE 754 double bits of f, exactly (tds.bitsOfFloat).
pub fn bitsOfFloat(f: float): int {
    if f == 0.0 { return if f.toStr() == "-0" { -9223372036854775807 - 1 } else { 0 } }
    if f.isNaN() { return 0x7ff8000000000000 }
    if !f.isFinite() { return if f > 0.0 { 0x7ff0000000000000 } else { -4503599627370496 } }
    let neg = f < 0.0
    var x = if neg { -f } else { f }
    var e = 0
    let top = float(1 << 53)
    let low = float(1 << 52)
    while x >= top {
        x = x / 2.0
        e += 1
    }
    while x < low {
        x = x * 2.0
        e -= 1
    }
    let m = int(x)
    let be = e + 1075
    var bits = 0
    if be <= 0 {
        bits = m >> (1 - be)
    } else {
        bits = (be << 52) | (m - (1 << 52))
    }
    if neg { bits = bits | (-9223372036854775807 - 1) }
    return bits
}

fn pow2(x: float, e: int): float {
    var f = x
    var k = e
    while k > 0 {
        let s = if k > 60 { 60 } else { k }
        f = f * float(1 << s)
        k -= s
    }
    while k < 0 {
        let s = if -k > 60 { 60 } else { -k }
        f = f / float(1 << s)
        k += s
    }
    return f
}

pub fn floatOfBits(b: int): float {
    let e = (b >> 52) & 0x7ff
    let m = b & 0xfffffffffffff
    var f: float = 0.0
    if e == 0x7ff {
        f = if m == 0 { math.inf() } else { math.nan() }
    } else {
        f = pow2(float(if e == 0 { m } else { m | (1 << 52) }), (if e == 0 { 1 } else { e }) - 1075)
    }
    return if b < 0 { -f } else { f }
}

fn floatOfBits32(b: int): float {
    let e = (b >> 23) & 0xff
    let m = b & 0x7fffff
    var f: float = 0.0
    if e == 0xff {
        f = if m == 0 { math.inf() } else { math.nan() }
    } else {
        f = pow2(float(if e == 0 { m } else { m | (1 << 23) }), (if e == 0 { 1 } else { e }) - 150)
    }
    return if ((b >> 31) & 1) == 1 { -f } else { f }
}

// BINARY_DOUBLE bytes: the bits big-endian, the sign bit set for positive
// numbers and every bit inverted for negative ones (so bytes sort as numbers).
pub fn encodeDouble(f: float): str {
    var bits = bitsOfFloat(f)
    if bits >= 0 { bits = bits | (-9223372036854775807 - 1) } else { bits = ~bits }
    var b: []byte = []
    put64be(mut &b, bits)
    return strFromBytes(&b)
}

pub fn decodeDouble(b: str): Result[float, Error] {
    if len(b) != 8 { return Err(proto("a BINARY_DOUBLE of " + len(b).toStr() + " bytes")) }
    var bits = 0
    for k in 0..8 { bits = (bits << 8) | int(b[k]) }
    if bits < 0 { bits = bits & 0x7fffffffffffffff } else { bits = ~bits }
    return Ok(floatOfBits(bits))
}

pub fn decodeFloat(b: str): Result[float, Error] {
    if len(b) != 4 { return Err(proto("a BINARY_FLOAT of " + len(b).toStr() + " bytes")) }
    var bits = 0
    for k in 0..4 { bits = (bits << 8) | int(b[k]) }
    if (bits & 0x80000000) != 0 { bits = bits & 0x7fffffff } else { bits = (~bits) & 0xffffffff }
    return Ok(floatOfBits32(bits))
}

// ---------------------------------------------------------------- dates

// A DATE or TIMESTAMP: the civil date and time; for TIMESTAMP WITH TIME
// ZONE also the offset in minutes (hasOffset).
pub type Stamp = value record {
    pub local: time.LocalDateTime
    pub offset: int
    pub hasOffset: bool
}

// DATE (7 bytes), TIMESTAMP (11: with nanoseconds) or TIMESTAMP WITH TIME
// ZONE (13: the UTC date and time, then the offset). E_TYPE for a named
// time zone (a region id), which needs Oracle's time zone files.
pub fn decodeStamp(b: str): Result[Stamp, Error] {
    let n = len(b)
    if n != 7 && n != 11 && n != 13 { return Err(proto("a date of " + n.toStr() + " bytes")) }
    let year = (int(b[0]) - 100) * 100 + int(b[1]) - 100
    let d = time.Date{year: year, month: int(b[2]), day: int(b[3])}
    if !d.valid() { return Err(proto("the date " + d.toStr())) }
    var nanos = 0
    if n >= 11 { nanos = (int(b[7]) << 24) | (int(b[8]) << 16) | (int(b[9]) << 8) | int(b[10]) }
    let t = match time.timeOfDay(int(b[4]) - 1, int(b[5]) - 1, int(b[6]) - 1, nanos) {
        Some(t) { t }
        None { return Err(proto("a time of day out of range")) }
    }
    let local = time.LocalDateTime{date: d, time: t}
    if n < 13 || (int(b[11]) == 0 && int(b[12]) == 0) {
        return Ok(Stamp{local: local, offset: 0, hasOffset: n == 13})
    }
    if (int(b[11]) & 0x80) != 0 { return Err(typeErr("a TIMESTAMP WITH TIME ZONE in a named time zone (region id); use an offset")) }
    let off = (int(b[11]) - 20) * 60 + (int(b[12]) - 60)
    match local.atUtc().atOffset(off) {
        Some(o) { return Ok(Stamp{local: o.local, offset: off, hasOffset: true}) }
        None { return Err(proto("a time zone offset of " + off.toStr() + " minutes")) }
    }
}

fn putDate(b: mut &[]byte, l: &time.LocalDateTime) {
    let y = l.date.year
    put8(b, floorDiv(y, 100) + 100)
    put8(b, floorMod(y, 100) + 100)
    put8(b, l.date.month)
    put8(b, l.date.day)
    put8(b, l.time.hour() + 1)
    put8(b, l.time.minute() + 1)
    put8(b, l.time.second() + 1)
}

// DATE bytes (no fraction of a second).
pub fn encodeDate(l: &time.LocalDateTime): str {
    var b: []byte = []
    putDate(mut &b, l)
    return strFromBytes(&b)
}

// TIMESTAMP bytes (with nanoseconds).
pub fn encodeTimestamp(l: &time.LocalDateTime): str {
    var b: []byte = []
    putDate(mut &b, l)
    put32be(mut &b, l.time.nano())
    return strFromBytes(&b)
}

// TIMESTAMP WITH TIME ZONE bytes: the UTC date and time, then the offset.
pub fn encodeTimestampTz(o: &time.OffsetDateTime): str {
    let u = time.localOf(o.instant())
    var b: []byte = []
    putDate(mut &b, &u)
    put32be(mut &b, u.time.nano())
    let h = o.offset / 60               // hours and minutes both carry the sign
    put8(mut &b, h + 20)
    put8(mut &b, o.offset - h * 60 + 60)
    return strFromBytes(&b)
}

fn floorDiv(a: int, b: int): int {
    let q = a / b
    return if (a % b != 0) && ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn floorMod(a: int, b: int): int { return a - floorDiv(a, b) * b }
