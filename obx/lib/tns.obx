pub const DRIVER_NAME = "obx thn : 0.1"

// ---------------------------------------------------------------- errors

fn proto(msg: str): Error { return sqldialect.dbError(sqldialect.E_PROTOCOL, "tns: " + msg) }

fn ioErr(msg: str): Error { return sqldialect.dbError(sqldialect.E_IO, "tns: " + msg) }

fn ioFail(e: io.IoError): Error {
    if e.isCancelled() { return sqldialect.dbError(sqldialect.E_CANCELLED, "tns: cancelled") }
    if e.isTimeout() { return sqldialect.dbError(sqldialect.E_TIMEOUT, "tns: deadline passed") }
    return ioErr(e.toStr())
}

fn tlsFail(e: tls.Error): Error {
    if e.kind == tls.Kind.Cancelled { return sqldialect.dbError(sqldialect.E_CANCELLED, "tns: cancelled") }
    if e.kind == tls.Kind.Timeout { return sqldialect.dbError(sqldialect.E_TIMEOUT, "tns: deadline passed") }
    if e.kind == tls.Kind.Io { return ioErr(e.cause.toStr()) }
    return ioErr(e.toStr())
}

fn cryptoFail(e: crypto.Error): Error { return proto(e.toStr()) }

fn typeErr(msg: str): Error { return sqldialect.dbError(sqldialect.E_TYPE, msg) }

// ---------------------------------------------------------------- writing

fn put8(b: mut &[]byte, v: int) { append(b, byte(v & 0xff)) }

fn put16be(b: mut &[]byte, v: int) {
    append(b, byte((v >> 8) & 0xff))
    append(b, byte(v & 0xff))
}

fn put16le(b: mut &[]byte, v: int) {
    append(b, byte(v & 0xff))
    append(b, byte((v >> 8) & 0xff))
}

fn put32be(b: mut &[]byte, v: int) {
    for k in 0..4 { append(b, byte((v >> (24 - 8 * k)) & 0xff)) }
}

fn put64be(b: mut &[]byte, v: int) {
    for k in 0..8 { append(b, byte((v >> (56 - 8 * k)) & 0xff)) }
}

fn putStr(b: mut &[]byte, s: str) { appendStr(b, s) }

// A universal unsigned integer (ub2, ub4, ub8): a length byte, then that
// many big-endian bytes (1, 2, 4 or 8); 0 is the single byte 0.
pub fn putUb(b: mut &[]byte, v: int) {
    if v == 0 {
        put8(b, 0)
    } else if v > 0 && v <= 0xff {
        put8(b, 1)
        put8(b, v)
    } else if v > 0 && v <= 0xffff {
        put8(b, 2)
        put16be(b, v)
    } else if v > 0 && v <= 0xffffffff {
        put8(b, 4)
        put32be(b, v)
    } else {
        put8(b, 8)
        put64be(b, v)
    }
}

// A universal signed 4-byte integer (sb4): the sign in bit 7 of the length.
fn putSb4(b: mut &[]byte, v: int) {
    let sign = if v < 0 { 0x80 } else { 0 }
    let a = if v < 0 { -v } else { v }
    if a == 0 {
        put8(b, 0)
    } else if a <= 0xff {
        put8(b, 1 | sign)
        put8(b, a)
    } else if a <= 0xffff {
        put8(b, 2 | sign)
        put16be(b, a)
    } else {
        put8(b, 4 | sign)
        put32be(b, a)
    }
}

// Bytes with a length: up to 252 bytes after a length byte; longer ones as
// 254, then chunks of at most 32767 bytes each after a ub4 length, then a
// ub4 0. Nothing (a 0 byte) is how a NULL or empty value goes.
pub fn putBytes(b: mut &[]byte, s: str) {
    let n = len(s)
    if n <= 252 {
        put8(b, n)
        putStr(b, s)
        return
    }
    put8(b, 254)
    var off = 0
    while off < n {
        let k = min(32767, n - off)
        putUb(b, k)
        putStr(b, s[off..off + k])
        off += k
    }
    putUb(b, 0)
}

// A ub4 length, then (when not empty) the bytes with a length.
fn putBytes2(b: mut &[]byte, s: str) {
    putUb(b, len(s))
    if len(s) > 0 { putBytes(b, s) }
}

// ---------------------------------------------------------------- reading

// A cursor over received bytes. Every read checks the bytes there are; when
// they run out, short is set (the message may continue in the next packet).
pub type Cur = value record { s: str; pub pos: int; pub short: bool }

pub fn cursor(s: str): Cur { return Cur{s: s, pos: 0, short: false} }

fn (c: &Cur) left(): int { return len(c.s) - c.pos }

fn (c: mut &Cur) need(n: int, what: str): Result[Unit, Error] {
    if n < 0 { return Err(proto(what + ": a length of " + n.toStr())) }
    if n > len(c.s) - c.pos {
        c.short = true
        return Err(proto(what + ": " + n.toStr() + " bytes needed, " + (len(c.s) - c.pos).toStr() + " left"))
    }
    return Ok(Unit{})
}

fn (c: mut &Cur) u8(what: str): Result[int, Error] {
    try c.need(1, what)
    let v = int(c.s[c.pos])
    c.pos += 1
    return Ok(v)
}

fn (c: mut &Cur) u16be(what: str): Result[int, Error] {
    try c.need(2, what)
    let v = (int(c.s[c.pos]) << 8) | int(c.s[c.pos + 1])
    c.pos += 2
    return Ok(v)
}

fn (c: mut &Cur) u16le(what: str): Result[int, Error] {
    try c.need(2, what)
    let v = int(c.s[c.pos]) | (int(c.s[c.pos + 1]) << 8)
    c.pos += 2
    return Ok(v)
}

fn (c: mut &Cur) u32be(what: str): Result[int, Error] {
    try c.need(4, what)
    var v = 0
    for k in 0..4 { v = (v << 8) | int(c.s[c.pos + k]) }
    c.pos += 4
    return Ok(v)
}

fn (c: mut &Cur) take(n: int, what: str): Result[str, Error] {
    try c.need(n, what)
    let v = c.s[c.pos..c.pos + n]
    c.pos += n
    return Ok(v)
}

fn (c: mut &Cur) skip(n: int, what: str): Result[Unit, Error] {
    try c.need(n, what)
    c.pos += n
    return Ok(Unit{})
}

// A universal integer of at most maxBytes bytes; negative when the length
// byte has bit 7 (the signed types).
fn (c: mut &Cur) uni(maxBytes: int, what: str): Result[int, Error] {
    let l = try c.u8(what)
    if l == 0 { return Ok(0) }
    let neg = (l & 0x80) != 0
    let n = l & 0x7f
    if n > maxBytes { return Err(proto(what + ": an integer of " + n.toStr() + " bytes")) }
    try c.need(n, what)
    var v = 0
    for k in 0..n { v = (v << 8) | int(c.s[c.pos + k]) }
    c.pos += n
    return Ok(if neg { -v } else { v })
}

pub fn (c: mut &Cur) ub2(what: str): Result[int, Error] { return c.uni(2, what) }
pub fn (c: mut &Cur) ub4(what: str): Result[int, Error] { return c.uni(4, what) }
pub fn (c: mut &Cur) ub8(what: str): Result[int, Error] { return c.uni(8, what) }

fn (c: mut &Cur) skipUb(what: str): Result[Unit, Error] {
    let v = try c.uni(8, what)
    return Ok(Unit{})
}

fn (c: mut &Cur) skipN(n: int, what: str): Result[Unit, Error] {
    for i in 0..n { try c.skipUb(what) }
    return Ok(Unit{})
}

// Bytes with a length (putBytes's form); None for NULL (a length of 0 or 255).
pub fn (c: mut &Cur) bytes(what: str): Result[Option[str], Error] {
    let l = try c.u8(what)
    if l == 0 || l == 255 { return Ok(None) }
    if l != 254 { return Ok(Some(try c.take(l, what))) }
    var out: []byte = []
    while true {
        let k = try c.ub4(what)
        if k == 0 { break }
        let part = try c.take(k, what)
        appendStr(mut &out, part)
    }
    return Ok(Some(strFromBytes(&out)))
}

fn (c: mut &Cur) bytesOrEmpty(what: str): Result[str, Error] {
    match try c.bytes(what) {
        Some(b) { return Ok(b) }
        None { return Ok("") }
    }
}

// A ub4 length, then (when not 0) bytes with a length.
fn (c: mut &Cur) str2(what: str): Result[str, Error] {
    let n = try c.ub4(what)
    if n == 0 { return Ok("") }
    return c.bytesOrEmpty(what)
}

// ---------------------------------------------------------------- text

fn utf8(b: str, what: str): Result[str, Error] {
    if !strings.isValidUtf8(b) { return Err(proto(what + ": invalid UTF-8")) }
    return Ok(b)
}

// UTF-8 text as UTF-16BE (NCHAR binds).
pub fn toUtf16be(s: str): Result[str, Error] {
    var out: []byte = []
    var i = 0
    while i < len(s) {
        let c = s[i]
        if c < 0x80 {
            append(mut &out, byte(0))
            append(mut &out, c)
            i += 1
            continue
        }
        let d = strings.decodeAt(s, i)
        if !d.ok { return Err(sqldialect.inputError("invalid UTF-8 at byte " + i.toStr())) }
        if d.rune >= 0x10000 {
            put16be(mut &out, 0xd800 + ((d.rune - 0x10000) >> 10))
            put16be(mut &out, 0xdc00 + ((d.rune - 0x10000) & 0x3ff))
        } else {
            put16be(mut &out, d.rune)
        }
        i += d.size
    }
    return Ok(strFromBytes(&out))
}

// UTF-16BE bytes as UTF-8; Err for an odd length or a lone surrogate.
pub fn fromUtf16be(b: str): Result[str, Error] {
    if len(b) % 2 != 0 { return Err(proto("UTF-16 text with an odd number of bytes")) }
    var out = newStrBuf()
    var i = 0
    while i < len(b) {
        var u = (int(b[i]) << 8) | int(b[i + 1])
        if u >= 0xd800 && u <= 0xdfff {
            let lo = if i + 3 < len(b) { (int(b[i + 2]) << 8) | int(b[i + 3]) } else { 0 }
            if u >= 0xdc00 || lo < 0xdc00 || lo > 0xdfff {
                return Err(proto("invalid UTF-16: a lone surrogate at unit " + (i / 2).toStr()))
            }
            u = 0x10000 + ((u - 0xd800) << 10) + (lo - 0xdc00)
            i += 2
        }
        strings.addRune(mut &out, u)
        i += 2
    }
    return Ok(out.toStr())
}

// ---------------------------------------------------------------- NUMBER

// An Oracle NUMBER, exactly: (-1 if neg) * digits * 10^exp, where digits
// has no leading and no trailing zero ("" for zero, with exp 0). Up to 40
// digits (Oracle's binary arithmetic gives 39 and 40, as 1/3 does).
pub type Num = value record {
    pub neg: bool
    pub digits: str
    pub exp: int
}

pub fn numOfDecimal(d: Decimal): Num {
    if d.isZero() { return Num{neg: false, digits: "", exp: 0} }
    return Num{neg: d.isNeg(), digits: d.coefficient().toStr(), exp: d.exponent()}
}

pub fn numOfInt(n: int): Num { return numOfDecimal(Decimal.fromInt(n)) }

// The number as Oracle and python-oracledb write it: "-12.5", "0.001", "1000".
pub fn (n: &Num) toStr(): str {
    if n.digits == "" { return "0" }
    let sign = if n.neg { "-" } else { "" }
    if n.exp >= 0 { return sign + n.digits + repeat("0", n.exp) }
    let point = len(n.digits) + n.exp
    if point <= 0 { return sign + "0." + repeat("0", -point) + n.digits }
    return sign + n.digits[0..point] + "." + n.digits[point..]
}

// The Decimal; Err(DecError.Precision) for 39 and 40 digits.
pub fn (n: &Num) decimal(): Result[Decimal, DecError] {
    if n.digits == "" { return Ok(Decimal.zero()) }
    if len(n.digits) > 38 { return Err(DecError.Precision) }
    let sign = if n.neg { "-" } else { "" }
    return Decimal.parse(sign + n.digits + "e" + n.exp.toStr())
}

// The int, if the number is an integer within int's range.
pub fn (n: &Num) int(): Option[int] {
    if n.digits == "" { return Some(0) }
    if n.exp < 0 || len(n.digits) + n.exp > 19 { return None }
    var v: i128 = 0
    for i in 0..len(n.digits) { v = v * 10 + i128(n.digits[i] - '0') }
    for i in 0..n.exp { v = v * 10 }
    if n.neg { v = -v }
    if v > i128(9223372036854775807) || v < -i128(9223372036854775807) - 1 { return None }
    return Some(int(v))
}

// The NUMBER bytes of n (1 to 22 bytes). E_INPUT outside Oracle's range
// (more than 40 digits, 1e126 and up, below 1e-130).
pub fn encodeNumber(n: &Num): Result[str, Error] {
    if n.digits == "" { return Ok("\x80") }
    var d = n.digits
    var dpi = len(d) + n.exp            // the digits before the decimal point
    if len(d) > 40 || dpi > 126 || dpi < -129 {
        return Err(sqldialect.inputError("a number outside Oracle NUMBER's range (at most 40 digits, from 1e-130 to below 1e126): " +
                                          (if n.neg { "-" } else { "" }) + n.digits + "e" + n.exp.toStr()))
    }
    if floorMod(dpi, 2) == 1 {
        d = "0" + d
        dpi += 1
    }
    if len(d) % 2 == 1 { d = d + "0" }
    let pairs = len(d) / 2
    var b: []byte = []
    var e = floorDiv(dpi, 2) + 192
    if n.neg { e = (~e) & 0xff }
    put8(mut &b, e)
    for p in 0..pairs {
        let v = int(d[2 * p] - '0') * 10 + int(d[2 * p + 1] - '0')
        put8(mut &b, if n.neg { 101 - v } else { v + 1 })
    }
    if n.neg && len(d) < 40 { put8(mut &b, 102) }
    return Ok(strFromBytes(&b))
}

// The number in NUMBER bytes. Err for a malformed one and for -1e126
// (Oracle's "negative infinity", a single byte 0).
pub fn decodeNumber(b: str): Result[Num, Error] {
    let n = len(b)
    if n == 0 || n > 21 { return Err(proto("a NUMBER of " + n.toStr() + " bytes")) }
    let b0 = int(b[0])
    let pos = (b0 & 0x80) != 0
    if n == 1 {
        if pos { return Ok(Num{neg: false, digits: "", exp: 0}) }
        return Err(typeErr("the NUMBER is -1e126 (Oracle's negative infinity)"))
    }
    let e = (if pos { b0 } else { (~b0) & 0xff }) - 193
    var last = n
    if !pos && int(b[n - 1]) == 102 { last = n - 1 }
    var ds = newStrBuf()
    for i in 1..last {
        let v = if pos { int(b[i]) - 1 } else { 101 - int(b[i]) }
        if v < 0 || v > 99 { return Err(proto("a NUMBER mantissa byte " + int(b[i]).toStr())) }
        ds.addByte(byte(48 + v / 10))
        ds.addByte(byte(48 + v % 10))
    }
    let all = ds.toStr()
    // value = 0.all * 10^(2e + 2)
    var lo = 0
    while lo < len(all) && all[lo] == '0' { lo += 1 }
    var hi = len(all)
    while hi > lo && all[hi - 1] == '0' { hi -= 1 }
    if lo == hi { return Ok(Num{neg: false, digits: "", exp: 0}) }
    return Ok(Num{neg: !pos, digits: all[lo..hi], exp: 2 * e + 2 - hi})
}

// ---------------------------------------------------------------- floats

// The IEEE 754 double bits of f, exactly (tds.bitsOfFloat).
pub fn bitsOfFloat(f: float): int {
    if f == 0.0f { return if f.toStr() == "-0" { -9223372036854775807 - 1 } else { 0 } }
    if f.isNaN() { return 0x7ff8000000000000 }
    if !f.isFinite() { return if f > 0.0f { 0x7ff0000000000000 } else { -4503599627370496 } }
    let neg = f < 0.0f
    var x = if neg { -f } else { f }
    var e = 0
    let top = float(1 << 53)
    let low = float(1 << 52)
    while x >= top {
        x = x / 2.0f
        e += 1
    }
    while x < low {
        x = x * 2.0f
        e -= 1
    }
    let m = int(x)
    let be = e + 1075
    var bits = 0
    if be <= 0 {
        bits = m >> (1 - be)
    } else {
        bits = (be << 52) | (m - (1 << 52))
    }
    if neg { bits = bits | (-9223372036854775807 - 1) }
    return bits
}

fn pow2(x: float, e: int): float {
    var f = x
    var k = e
    while k > 0 {
        let s = if k > 60 { 60 } else { k }
        f = f * float(1 << s)
        k -= s
    }
    while k < 0 {
        let s = if -k > 60 { 60 } else { -k }
        f = f / float(1 << s)
        k += s
    }
    return f
}

pub fn floatOfBits(b: int): float {
    let e = (b >> 52) & 0x7ff
    let m = b & 0xfffffffffffff
    var f: float = 0.0f
    if e == 0x7ff {
        f = if m == 0 { math.inf() } else { math.nan() }
    } else {
        f = pow2(float(if e == 0 { m } else { m | (1 << 52) }), (if e == 0 { 1 } else { e }) - 1075)
    }
    return if b < 0 { -f } else { f }
}

fn floatOfBits32(b: int): float {
    let e = (b >> 23) & 0xff
    let m = b & 0x7fffff
    var f: float = 0.0f
    if e == 0xff {
        f = if m == 0 { math.inf() } else { math.nan() }
    } else {
        f = pow2(float(if e == 0 { m } else { m | (1 << 23) }), (if e == 0 { 1 } else { e }) - 150)
    }
    return if ((b >> 31) & 1) == 1 { -f } else { f }
}

// BINARY_DOUBLE bytes: the bits big-endian, the sign bit set for positive
// numbers and every bit inverted for negative ones (so bytes sort as numbers).
pub fn encodeDouble(f: float): str {
    var bits = bitsOfFloat(f)
    if bits >= 0 { bits = bits | (-9223372036854775807 - 1) } else { bits = ~bits }
    var b: []byte = []
    put64be(mut &b, bits)
    return strFromBytes(&b)
}

pub fn decodeDouble(b: str): Result[float, Error] {
    if len(b) != 8 { return Err(proto("a BINARY_DOUBLE of " + len(b).toStr() + " bytes")) }
    var bits = 0
    for k in 0..8 { bits = (bits << 8) | int(b[k]) }
    if bits < 0 { bits = bits & 0x7fffffffffffffff } else { bits = ~bits }
    return Ok(floatOfBits(bits))
}

pub fn decodeFloat(b: str): Result[float, Error] {
    if len(b) != 4 { return Err(proto("a BINARY_FLOAT of " + len(b).toStr() + " bytes")) }
    var bits = 0
    for k in 0..4 { bits = (bits << 8) | int(b[k]) }
    if (bits & 0x80000000) != 0 { bits = bits & 0x7fffffff } else { bits = (~bits) & 0xffffffff }
    return Ok(floatOfBits32(bits))
}

// ---------------------------------------------------------------- dates

// A DATE or TIMESTAMP: the civil date and time; for TIMESTAMP WITH TIME
// ZONE also the offset in minutes (hasOffset).
pub type Stamp = value record {
    pub local: time.LocalDateTime
    pub offset: int
    pub hasOffset: bool
}

// DATE (7 bytes), TIMESTAMP (11: with nanoseconds) or TIMESTAMP WITH TIME
// ZONE (13: the UTC date and time, then the offset). E_TYPE for a named
// time zone (a region id), which needs Oracle's time zone files.
pub fn decodeStamp(b: str): Result[Stamp, Error] {
    let n = len(b)
    if n != 7 && n != 11 && n != 13 { return Err(proto("a date of " + n.toStr() + " bytes")) }
    let year = (int(b[0]) - 100) * 100 + int(b[1]) - 100
    let d = time.Date{year: year, month: int(b[2]), day: int(b[3])}
    if !d.valid() { return Err(proto("the date " + d.toStr())) }
    var nanos = 0
    if n >= 11 { nanos = (int(b[7]) << 24) | (int(b[8]) << 16) | (int(b[9]) << 8) | int(b[10]) }
    let t = match time.timeOfDay(int(b[4]) - 1, int(b[5]) - 1, int(b[6]) - 1, nanos) {
        Some(t) { t }
        None { return Err(proto("a time of day out of range")) }
    }
    let local = time.LocalDateTime{date: d, time: t}
    if n < 13 || (int(b[11]) == 0 && int(b[12]) == 0) {
        return Ok(Stamp{local: local, offset: 0, hasOffset: n == 13})
    }
    if (int(b[11]) & 0x80) != 0 { return Err(typeErr("a TIMESTAMP WITH TIME ZONE in a named time zone (region id); use an offset")) }
    let off = (int(b[11]) - 20) * 60 + (int(b[12]) - 60)
    match local.atUtc().atOffset(off) {
        Some(o) { return Ok(Stamp{local: o.local, offset: off, hasOffset: true}) }
        None { return Err(proto("a time zone offset of " + off.toStr() + " minutes")) }
    }
}

fn putDate(b: mut &[]byte, l: &time.LocalDateTime) {
    let y = l.date.year
    put8(b, floorDiv(y, 100) + 100)
    put8(b, floorMod(y, 100) + 100)
    put8(b, l.date.month)
    put8(b, l.date.day)
    put8(b, l.time.hour() + 1)
    put8(b, l.time.minute() + 1)
    put8(b, l.time.second() + 1)
}

// DATE bytes (no fraction of a second).
pub fn encodeDate(l: &time.LocalDateTime): str {
    var b: []byte = []
    putDate(mut &b, l)
    return strFromBytes(&b)
}

// TIMESTAMP bytes (with nanoseconds).
pub fn encodeTimestamp(l: &time.LocalDateTime): str {
    var b: []byte = []
    putDate(mut &b, l)
    put32be(mut &b, l.time.nano())
    return strFromBytes(&b)
}

// TIMESTAMP WITH TIME ZONE bytes: the UTC date and time, then the offset.
pub fn encodeTimestampTz(o: &time.OffsetDateTime): str {
    let u = time.localOf(o.instant())
    var b: []byte = []
    putDate(mut &b, &u)
    put32be(mut &b, u.time.nano())
    let h = o.offset / 60               // hours and minutes both carry the sign
    put8(mut &b, h + 20)
    put8(mut &b, o.offset - h * 60 + 60)
    return strFromBytes(&b)
}

fn floorDiv(a: int, b: int): int {
    let q = a / b
    return if (a % b != 0) && ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn floorMod(a: int, b: int): int { return a - floorDiv(a, b) * b }

// ---------------------------------------------------------------- ROWID

const BASE64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

fn base64Chars(b: mut &StrBuf, v: int, n: int) {
    for i in 0..n { b.addByte(BASE64[(v >> (6 * (n - 1 - i))) & 0x3f]) }
}

// The 18-character text of a physical ROWID (python-oracledb's _encode_rowid).
pub fn rowidText(rba: int, partition: int, block: int, slot: int): str {
    var b = newStrBuf()
    base64Chars(mut &b, rba, 6)
    base64Chars(mut &b, partition, 3)
    base64Chars(mut &b, block, 6)
    base64Chars(mut &b, slot, 3)
    return b.toStr()
}

// ---------------------------------------------------------------- columns and cells

// A column of a query, from DESCRIBE_INFO.
pub type Column = value record {
    pub name: str
    pub oraType: int        // T_*
    pub csfrm: int          // CS_NCHAR for NCHAR, NVARCHAR2, NCLOB
    pub precision: int
    pub scale: int          // -127 with precision 0: NUMBER without precision (floating)
    pub bufferSize: int     // 0: the column is always NULL (SELECT NULL ...)
    pub maxSize: int
    pub nullable: bool
}

// The Oracle name of a column's type: "NUMBER", "VARCHAR2", "NVARCHAR2", ...
pub fn (c: &Column) typeName(): str { return typeNameOf(c.oraType, c.csfrm) }

pub fn typeNameOf(t: int, csfrm: int): str {
    let n = csfrm == CS_NCHAR
    match t {
        T_VARCHAR { return if n { "NVARCHAR2" } else { "VARCHAR2" } }
        T_NUMBER { return "NUMBER" }
        T_BINARY_INTEGER { return "BINARY_INTEGER" }
        T_LONG { return "LONG" }
        T_ROWID { return "ROWID" }
        T_DATE { return "DATE" }
        T_RAW { return "RAW" }
        T_LONG_RAW { return "LONG RAW" }
        T_CHAR { return if n { "NCHAR" } else { "CHAR" } }
        T_BINARY_FLOAT { return "BINARY_FLOAT" }
        T_BINARY_DOUBLE { return "BINARY_DOUBLE" }
        T_CURSOR { return "REF CURSOR" }
        T_OBJECT { return "OBJECT" }
        T_CLOB { return if n { "NCLOB" } else { "CLOB" } }
        T_BLOB { return "BLOB" }
        T_BFILE { return "BFILE" }
        T_JSON { return "JSON" }
        T_VECTOR { return "VECTOR" }
        T_TIMESTAMP { return "TIMESTAMP" }
        T_TIMESTAMP_TZ { return "TIMESTAMP WITH TIME ZONE" }
        T_TIMESTAMP_LTZ { return "TIMESTAMP WITH LOCAL TIME ZONE" }
        T_INTERVAL_YM { return "INTERVAL YEAR TO MONTH" }
        T_INTERVAL_DS { return "INTERVAL DAY TO SECOND" }
        T_UROWID { return "UROWID" }
        T_BOOLEAN { return "BOOLEAN" }
        else { return "type " + t.toStr() }
    }
}

// A value of a row.
pub type Cell = value closed {
    Null
    Number(Num)       // NUMBER, FLOAT, INTEGER: exact
    Float(float)      // BINARY_FLOAT, BINARY_DOUBLE
    Text(str)         // VARCHAR2, CHAR, LONG, NVARCHAR2, NCHAR; ROWID as its text
    Bytes(str)        // RAW, LONG RAW
    Stamp(Stamp)      // DATE, TIMESTAMP, TIMESTAMP WITH [LOCAL] TIME ZONE
    Bool(bool)        // BOOLEAN
    Failed(str)       // a value that could not be decoded, and why
}

// ---------------------------------------------------------------- replies

// The server's ERROR message: the call's end status. num 0: success;
// 1403: no (more) rows; otherwise an ORA- error with its text.
pub type ErrorInfo = value record {
    pub num: int
    pub msg: str
    pub pos: int            // the offset in the SQL text, when the server gives one
    pub cursorId: int
    pub rowCount: int       // rows fetched so far (queries) or changed (DML)
    pub callStatus: int
}

pub type KeyValue = value record { pub key: str; pub value: str; pub flags: int }

pub type ProtocolInfo = value record {
    pub banner: str
    pub charset: int
    pub ncharset: int
    pub compileCaps: str
    pub runtimeCaps: str
}

// What a reply says. kind tells PARAMETER messages apart (the
// authentication pairs, or an execute's return parameters).
pub type Reply = record {
    pub kind: int
    pub columns: []Column
    pub described: bool
    pub rows: [][]Cell
    pub hasError: bool
    pub error: ErrorInfo
    pub params: []KeyValue
    pub warnings: []str
    pub callStatus: int
    pub protocol: ProtocolInfo
    pub eor: bool           // the reply ends with END_OF_RESPONSE (not at ERROR or STATUS)
    pub fast: bool          // a fast authentication's reply: PROTOCOL and DATA_TYPES do not end it
    last: []Cell            // the previous row, for BIT_VECTOR's repeated columns
    bitvec: str             // "" when the next row has every column
    done: bool
}

pub const K_PLAIN = 0
pub const K_AUTH = 1
pub const K_EXECUTE = 2

// An empty reply of a kind; columns and last row: the cursor's so far (a FETCH).
pub fn newReply(kind: int, columns: &[]Column, last: &[]Cell): Reply {
    var cols: []Column = []
    for x in columns { append(mut &cols, x) }
    var prev: []Cell = []
    for x in last { append(mut &prev, x) }
    return Reply{kind: kind, columns: cols, described: false, rows: [], hasError: false,
                 error: ErrorInfo{num: 0, msg: "", pos: 0, cursorId: 0, rowCount: 0, callStatus: 0}, params: [],
                 warnings: [], callStatus: 0,
                 protocol: ProtocolInfo{banner: "", charset: 0, ncharset: 0, compileCaps: "", runtimeCaps: ""},
                 eor: false, fast: false, last: prev, bitvec: "", done: false}
}

// The last row decoded (BIT_VECTOR repeats columns from it).
pub fn (r: &Reply) lastRow(): []Cell {
    var out: []Cell = []
    for x in r.last { append(mut &out, x) }
    return out
}

pub fn (r: &Reply) isDone(): bool { return r.done }

// Decodes one message into r. Each message is decoded into locals first and
// stored in r only once it is whole, so a message cut off at the end of c
// (c.short) leaves r as it was and can be decoded again with more bytes.
pub fn decodeMessage(c: mut &Cur, r: mut &Reply, fv: int): Result[Unit, Error] {
    let mt = try c.u8("message type")
    match mt {
        MT_PROTOCOL {
            r.protocol = try protocolInfo(c)
            r.done = !r.fast
        }
        MT_DATA_TYPES {
            while true {
                let t = try c.u16be("data type")
                if t == 0 { break }
                let conv = try c.u16be("data type")
                if conv != 0 { try c.skip(4, "data type") }
            }
            r.done = !r.fast
        }
        MT_ERROR {
            r.error = try errorInfo(c, fv)
            r.callStatus = r.error.callStatus
            r.hasError = true
            r.done = !r.eor
        }
        MT_STATUS {
            r.callStatus = try c.ub4("status")
            try c.skipUb("status")
            r.done = !r.eor
        }
        MT_END_OF_RESPONSE { r.done = true }
        MT_FLUSH_OUT_BINDS { r.done = true }
        MT_WARNING {
            let num = try c.ub2("warning")
            let n = try c.ub2("warning")
            try c.skipUb("warning")
            if num != 0 && n > 0 {
                let m = try c.bytesOrEmpty("warning")
                append(mut &r.warnings, strings.trimRight(m))
            }
        }
        MT_PARAMETER {
            if r.kind == K_AUTH {
                let n = try c.ub2("parameters")
                var kv: []KeyValue = []
                for i in 0..n {
                    let k = try c.str2("parameter key")
                    let v = try c.str2("parameter value")
                    let f = try c.ub4("parameter flags")
                    append(mut &kv, KeyValue{key: k, value: v, flags: f})
                }
                for x in kv { append(mut &r.params, x) }
            } else {
                let n = try c.ub2("return parameters")
                try c.skipN(n, "return parameters")
                let nb = try c.ub2("return parameters")
                try c.skip(nb, "return parameters")
                let np = try c.ub2("return parameters")
                try keywordPairs(c, np)
                let rb = try c.ub2("return parameters")
                try c.skip(rb, "return parameters")
            }
        }
        MT_SERVER_SIDE_PIGGYBACK { try serverPiggyback(c) }
        MT_TOKEN {
            let t = try c.ub8("token")
            if t != 0 { return Err(proto("a reply for token " + t.toStr())) }
        }
        MT_DESCRIBE_INFO {
            let skipped = try c.bytes("describe info")
            let cols = try describeInfo(c, fv)
            r.columns = cols
            r.described = true
            r.last = []
            r.bitvec = ""
        }
        MT_ROW_HEADER {
            try c.skip(1, "row header")
            try c.skipN(4, "row header")
            let n = try c.ub4("row header")
            var bv = ""
            if n > 0 {
                try c.skip(1, "row header")
                bv = try c.take(n, "row header")
            }
            let rid = try c.str2("row header")
            if n > 0 { r.bitvec = bv }
        }
        MT_BIT_VECTOR {
            try c.skipUb("bit vector")
            let n = (len(r.columns) + 7) / 8
            r.bitvec = try c.take(n, "bit vector")
        }
        MT_ROW_DATA {
            let row = try rowData(c, r)
            r.last = []
            for x in row { append(mut &r.last, x) }
            r.bitvec = ""
            append(mut &r.rows, row)
        }
        MT_IO_VECTOR {
            try c.skip(1, "IO vector")
            let req = try c.ub2("IO vector")
            let iters = try c.ub4("IO vector")
            let binds = iters * 256 + req
            try c.skipN(2, "IO vector")
            let a = try c.ub2("IO vector")
            try c.skip(a, "IO vector")
            let b = try c.ub2("IO vector")
            try c.skip(b, "IO vector")
            for i in 0..binds {
                let dir = try c.u8("IO vector")
                if dir != 32 { return Err(typeErr("PL/SQL OUT and IN OUT binds are not supported yet")) }
            }
        }
        else {
            return Err(proto("message type " + mt.toStr() + " is not supported"))
        }
    }
    return Ok(Unit{})
}

fn keywordPairs(c: mut &Cur, n: int): Result[Unit, Error] {
    for i in 0..n {
        let a = try c.ub2("keyword pair")
        if a > 0 { let t = try c.bytes("keyword pair") }
        let b = try c.ub2("keyword pair")
        if b > 0 { let v = try c.bytes("keyword pair") }
        try c.skipUb("keyword pair")
    }
    return Ok(Unit{})
}

fn serverPiggyback(c: mut &Cur): Result[Unit, Error] {
    let op = try c.u8("piggyback")
    match op {
        1 { }
        3 { }
        2 {
            try c.skipUb("piggyback")
            let b = try c.bytes("piggyback")
        }
        5 {
            try c.skipUb("piggyback")
            try c.skip(1, "piggyback")
            let n = try c.ub2("piggyback")
            try c.skip(1, "piggyback")
            try keywordPairs(c, n)
            try c.skipUb("piggyback")
        }
        9 {
            try c.skipUb("piggyback")
            try c.skip(1, "piggyback")
        }
        8 {
            try c.skipUb("piggyback")
            try c.skip(1, "piggyback")
            try c.skipN(2, "piggyback")
            try c.skip(1, "piggyback")
            let b = try c.str2("piggyback")
        }
        4 {
            try c.skipUb("piggyback")
            try c.skip(1, "piggyback")
            let n = try c.ub2("piggyback")
            if n > 0 {
                try c.skip(1, "piggyback")
                for i in 0..n {
                    let k = try c.ub2("piggyback")
                    if k > 0 { let kb = try c.bytes("piggyback") }
                    let v = try c.ub2("piggyback")
                    if v > 0 { let vb = try c.bytes("piggyback") }
                    try c.skipUb("piggyback")
                }
            }
            try c.skipN(3, "piggyback")
        }
        7 { let b = try c.str2("piggyback") }
        10 {
            try c.skipUb("piggyback")
            try c.skip(1, "piggyback")
            try c.skipN(3, "piggyback")
        }
        else { return Err(proto("server piggyback " + op.toStr())) }
    }
    return Ok(Unit{})
}

fn protocolInfo(c: mut &Cur): Result[ProtocolInfo, Error] {
    try c.skip(2, "protocol")
    var banner = newStrBuf()
    while true {
        let b = try c.u8("protocol banner")
        if b == 0 { break }
        banner.addByte(byte(b))
    }
    let cs = try c.u16le("protocol")
    try c.skip(1, "protocol")
    let ne = try c.u16le("protocol")
    try c.skip(ne * 5, "protocol")
    let fl = try c.u16be("protocol")
    let fdo = try c.take(fl, "protocol")
    if fl < 7 { return Err(proto("a protocol FDO of " + fl.toStr() + " bytes")) }
    let ix = 6 + int(fdo[5]) + int(fdo[6])
    if fl < ix + 5 { return Err(proto("a protocol FDO of " + fl.toStr() + " bytes")) }
    let ncs = (int(fdo[ix + 3]) << 8) + int(fdo[ix + 4])
    let cc = try c.bytesOrEmpty("compile capabilities")
    let rc = try c.bytesOrEmpty("runtime capabilities")
    return Ok(ProtocolInfo{banner: banner.toStr(), charset: cs, ncharset: ncs, compileCaps: cc, runtimeCaps: rc})
}

fn errorInfo(c: mut &Cur, fv: int): Result[ErrorInfo, Error] {
    let status = try c.ub4("error")
    try c.skipN(5, "error")
    let cursor = try c.ub2("error")
    let pos = try c.ub2("error")
    try c.skip(6, "error")
    try c.skipN(2, "error rowid")
    try c.skip(1, "error rowid")
    try c.skipN(2, "error rowid")
    try c.skipUb("error")
    try c.skip(2, "error")
    try c.skipN(2, "error")
    let dd = try c.str2("error")
    let ne = try c.ub2("error")
    if ne > 0 {
        let first = try c.u8("error")
        for i in 0..ne {
            if first == 254 { try c.skipUb("error") }
            try c.skipUb("error")
        }
        if first == 254 { try c.skip(1, "error") }
    }
    let no = try c.ub4("error")
    if no > 0 {
        if no > 65535 { return Err(proto("too many batch errors")) }
        let first = try c.u8("error")
        for i in 0..no {
            if first == 254 { try c.skipUb("error") }
            try c.skipUb("error")
        }
        if first == 254 { try c.skip(1, "error") }
    }
    let nm = try c.ub2("error")
    if nm > 0 {
        try c.skip(1, "error")
        for i in 0..nm {
            try c.skipUb("error")
            let m = try c.bytes("error")
            try c.skip(2, "error")
        }
    }
    let num = try c.ub4("error")
    let rows = try c.ub8("error")
    if fv >= FV_20_1 { try c.skipN(2, "error") }
    var msg = ""
    if num != 0 { msg = strings.trimRight(try c.bytesOrEmpty("error message")) }
    return Ok(ErrorInfo{num: num, msg: msg, pos: pos, cursorId: cursor, rowCount: rows, callStatus: status})
}

fn describeInfo(c: mut &Cur, fv: int): Result[[]Column, Error] {
    try c.skipUb("describe")
    let n = try c.ub4("describe")
    if n > 1000 { return Err(proto("a describe of " + n.toStr() + " columns")) }
    if n > 0 { try c.skip(1, "describe") }
    var cols: []Column = []
    for i in 0..n {
        let t = try c.u8("column")
        try c.skip(1, "column")
        let p0 = try c.u8("column")
        let s0 = try c.u8("column")
        let prec = if p0 >= 128 { p0 - 256 } else { p0 }
        let scale = if s0 >= 128 { s0 - 256 } else { s0 }
        let bs = try c.ub4("column")
        try c.skipN(2, "column")
        let oid = try c.str2("column")
        try c.skipN(2, "column")
        let cs = try c.u8("column")
        var ms = try c.ub4("column")
        if t == T_RAW { ms = bs }
        if fv >= FV_12_2 { try c.skipUb("column") }
        let nulls = try c.u8("column")
        try c.skip(1, "column")
        let name = try c.str2("column name")
        let schema = try c.str2("column")
        let tname = try c.str2("column")
        try c.skipUb("column")
        let uds = try c.ub4("column")
        if fv >= FV_23_1 {
            let ds = try c.str2("column")
            let dn = try c.str2("column")
        }
        if fv >= FV_23_1_EXT_3 {
            let na = try c.ub4("column")
            if na > 0 {
                try c.skip(1, "column")
                let m = try c.ub4("column")
                try c.skip(1, "column")
                for k in 0..m {
                    let key = try c.str2("column")
                    let val = try c.str2("column")
                    try c.skipUb("column")
                }
                try c.skipUb("column")
            }
        }
        if fv >= FV_23_4 {
            try c.skipUb("column")
            try c.skip(2, "column")
        }
        append(mut &cols, Column{name: try utf8(name, "a column name"), oraType: t, csfrm: cs, precision: prec, scale: scale,
                                 bufferSize: bs, maxSize: ms, nullable: nulls != 0})
    }
    let cd = try c.str2("describe")
    try c.skipN(4, "describe")
    let ck = try c.str2("describe")
    return Ok(cols)
}

fn rowData(c: mut &Cur, r: &Reply): Result[[]Cell, Error] {
    var row: []Cell = []
    for i in 0..len(r.columns) {
        let col = r.columns[i]
        if len(r.bitvec) > 0 && (int(r.bitvec[i / 8]) & (1 << (i % 8))) == 0 {
            if i >= len(r.last) { return Err(proto("a repeated column without a previous row")) }
            append(mut &row, r.last[i])
            continue
        }
        append(mut &row, try columnValue(c, &col))
    }
    return Ok(row)
}

fn columnValue(c: mut &Cur, col: &Column): Result[Cell, Error] {
    let t = col.oraType
    if col.bufferSize == 0 && t != T_LONG && t != T_LONG_RAW && t != T_UROWID { return Ok(Cell.Null) }
    if t == T_ROWID {
        let l = try c.u8("ROWID")
        if l == 0 || l == 255 { return Ok(Cell.Null) }
        let rba = try c.ub4("ROWID")
        let part = try c.ub2("ROWID")
        try c.skip(1, "ROWID")
        let block = try c.ub4("ROWID")
        let slot = try c.ub2("ROWID")
        return Ok(Cell.Text(rowidText(rba, part, block, slot)))
    }
    if t == T_CLOB || t == T_BLOB || t == T_BFILE {
        let n = try c.ub4("LOB")
        if n == 0 { return Ok(Cell.Null) }
        if t != T_BFILE { try c.skipN(2, "LOB") }
        let loc = try c.bytes("LOB")
        return Ok(Cell.Failed(col.typeName() + " columns are not supported yet"))
    }
    if t == T_CURSOR || t == T_JSON || t == T_VECTOR || t == T_OBJECT {
        return Err(typeErr(col.typeName() + " columns are not supported yet"))
    }
    let v = try c.bytes("column " + col.name)
    if t == T_LONG || t == T_LONG_RAW { try c.skipN(2, "LONG") }
    match v {
        None { return Ok(Cell.Null) }
        Some(b) { return Ok(cellOf(col, b)) }
    }
}

fn cellOf(col: &Column, b: str): Cell {
    let t = col.oraType
    if t == T_VARCHAR || t == T_CHAR || t == T_LONG {
        if col.csfrm == CS_NCHAR {
            match fromUtf16be(b) {
                Ok(s) { return Cell.Text(s) }
                Err(e) { return Cell.Failed(e.msg) }
            }
        }
        if !strings.isValidUtf8(b) { return Cell.Failed("invalid UTF-8 in column " + col.name) }
        return Cell.Text(b)
    }
    if t == T_NUMBER || t == T_BINARY_INTEGER {
        match decodeNumber(b) {
            Ok(n) { return Cell.Number(n) }
            Err(e) { return Cell.Failed(e.msg) }
        }
    }
    if t == T_DATE || t == T_TIMESTAMP || t == T_TIMESTAMP_TZ || t == T_TIMESTAMP_LTZ {
        match decodeStamp(b) {
            Ok(s) { return Cell.Stamp(s) }
            Err(e) { return Cell.Failed(e.msg) }
        }
    }
    if t == T_BINARY_DOUBLE {
        match decodeDouble(b) {
            Ok(f) { return Cell.Float(f) }
            Err(e) { return Cell.Failed(e.msg) }
        }
    }
    if t == T_BINARY_FLOAT {
        match decodeFloat(b) {
            Ok(f) { return Cell.Float(f) }
            Err(e) { return Cell.Failed(e.msg) }
        }
    }
    if t == T_RAW || t == T_LONG_RAW { return Cell.Bytes(b) }
    if t == T_BOOLEAN { return Cell.Bool(len(b) > 0 && int(b[len(b) - 1]) == 1) }
    if t == T_UROWID { return Cell.Failed("UROWID values are not supported yet") }
    return Cell.Failed(col.typeName() + " values are not supported yet")
}

// ---------------------------------------------------------------- statements

pub const S_QUERY = 1       // SELECT, WITH
pub const S_DML = 2         // INSERT, UPDATE, DELETE, MERGE
pub const S_DDL = 3         // CREATE, ALTER, DROP, TRUNCATE, GRANT, ...
pub const S_PLSQL = 4       // BEGIN, DECLARE, CALL
pub const S_OTHER = 5

// What kind of statement sql is, from its first keyword (after blanks and
// comments), as python-oracledb's Statement does.
pub fn statementKind(sql: str): int {
    var i = 0
    let n = len(sql)
    while i < n {
        let c = sql[i]
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '(' {
            i += 1
        } else if c == '-' && i + 1 < n && sql[i + 1] == '-' {
            while i < n && sql[i] != '\n' { i += 1 }
        } else if c == '/' && i + 1 < n && sql[i + 1] == '*' {
            i += 2
            while i + 1 < n && !(sql[i] == '*' && sql[i + 1] == '/') { i += 1 }
            i += 2
        } else {
            break
        }
    }
    var j = i
    while j < n && ((sql[j] >= 'a' && sql[j] <= 'z') || (sql[j] >= 'A' && sql[j] <= 'Z')) { j += 1 }
    let w = strings.toUpper(sql[min(i, n)..j])
    if w == "SELECT" || w == "WITH" { return S_QUERY }
    if w == "INSERT" || w == "UPDATE" || w == "DELETE" || w == "MERGE" { return S_DML }
    if w == "BEGIN" || w == "DECLARE" || w == "CALL" { return S_PLSQL }
    if w == "CREATE" || w == "ALTER" || w == "DROP" || w == "GRANT" || w == "REVOKE" || w == "ANALYZE" || w == "AUDIT" ||
            w == "COMMENT" || w == "TRUNCATE" || w == "RENAME" || w == "PURGE" || w == "FLASHBACK" {
        return S_DDL
    }
    return S_OTHER
}

// ---------------------------------------------------------------- requests

// A bind value, ready to send: its type, its buffer size and its bytes
// (None: NULL).
pub type Bind = value record {
    pub oraType: int
    pub csfrm: int
    pub bufferSize: int
    pub data: Option[str]
}

pub fn nullBind(): Bind { return Bind{oraType: T_VARCHAR, csfrm: CS_IMPLICIT, bufferSize: 1, data: None} }

// Text as VARCHAR2 (LONG beyond maxString bytes).
pub fn textBind(s: str, maxString: int): Result[Bind, Error] {
    if !strings.isValidUtf8(s) { return Err(sqldialect.inputError("text with invalid UTF-8")) }
    let t = if len(s) > maxString { T_LONG } else { T_VARCHAR }
    return Ok(Bind{oraType: t, csfrm: CS_IMPLICIT, bufferSize: max(len(s), 1), data: Some(s)})
}

// Bytes as RAW (LONG RAW beyond maxString bytes).
pub fn bytesBind(b: str, maxString: int): Bind {
    let t = if len(b) > maxString { T_LONG_RAW } else { T_RAW }
    return Bind{oraType: t, csfrm: 0, bufferSize: max(len(b), 1), data: Some(b)}
}

pub fn numberBind(n: &Num): Result[Bind, Error] {
    return Ok(Bind{oraType: T_NUMBER, csfrm: 0, bufferSize: 22, data: Some(try encodeNumber(n))})
}

pub fn doubleBind(f: float): Bind { return Bind{oraType: T_BINARY_DOUBLE, csfrm: 0, bufferSize: 8, data: Some(encodeDouble(f))} }

pub fn boolBind(v: bool): Bind {
    return Bind{oraType: T_BOOLEAN, csfrm: 0, bufferSize: 4, data: Some(if v { "\x01\x01" } else { "\x00" })}
}

pub fn dateBind(l: &time.LocalDateTime): Bind {
    return Bind{oraType: T_DATE, csfrm: 0, bufferSize: 7, data: Some(encodeDate(l))}
}

pub fn timestampBind(l: &time.LocalDateTime): Bind {
    return Bind{oraType: T_TIMESTAMP, csfrm: 0, bufferSize: 11, data: Some(encodeTimestamp(l))}
}

pub fn timestampTzBind(o: &time.OffsetDateTime): Bind {
    return Bind{oraType: T_TIMESTAMP_TZ, csfrm: 0, bufferSize: 13, data: Some(encodeTimestampTz(o))}
}

// An execute: the SQL (with cursor 0: parse it), its binds, the rows to
// prefetch for a query, and whether to commit after it.
pub type Execute = record {
    pub sql: str
    pub kind: int               // S_*
    pub cursorId: int           // 0: a new cursor (the SQL is parsed)
    pub binds: []Bind
    pub prefetch: int
    pub commit: bool
}

fn longBind(b: &Bind, maxString: int): bool { return b.bufferSize > maxString || b.oraType == T_LONG || b.oraType == T_LONG_RAW }

fn putBindValue(m: mut &[]byte, b: &Bind) {
    match b.data {
        None {
            if b.oraType == T_BOOLEAN {
                put8(m, 253)
                put8(m, 1)
            } else {
                put8(m, 0)
            }
        }
        Some(d) { putBytes(m, d) }
    }
}

pub fn executeBody(m: mut &[]byte, e: &Execute, fv: int, maxString: int) {
    let parse = e.cursorId == 0 || e.kind == S_DDL
    let query = e.kind == S_QUERY
    let nb = len(e.binds)
    var options = 0x20                                  // EXECUTE
    if parse { options = options | 0x01 }
    if query && e.prefetch > 0 { options = options | 0x40 }
    if e.kind != S_PLSQL { options = options | 0x8000 } else if nb > 0 { options = options | 0x400 }
    if nb > 0 { options = options | 0x08 }
    if e.commit { options = options | 0x100 }
    putUb(m, options)
    putUb(m, e.cursorId)
    if parse {
        put8(m, 1)
        putUb(m, len(e.sql))
    } else {
        put8(m, 0)
        putUb(m, 0)
    }
    put8(m, 1)
    putUb(m, 13)
    put8(m, 0)
    put8(m, 0)
    putUb(m, 0)
    putUb(m, if query { e.prefetch } else { 1 })
    putUb(m, 0x7fffffff)
    put8(m, if nb > 0 { 1 } else { 0 })
    putUb(m, nb)
    for i in 0..5 { put8(m, 0) }
    put8(m, 0)
    putUb(m, 0)
    putUb(m, 0)                                         // registration id (low)
    put8(m, 0)
    put8(m, 1)
    put8(m, 0)
    putUb(m, 0)
    put8(m, 0)
    putUb(m, 0)
    putUb(m, 0)                                         // registration id (high)
    put8(m, 0)
    putUb(m, 0)
    put8(m, 0)
    if fv >= FV_12_2 {
        put8(m, 0)
        putUb(m, 0)
        put8(m, 0)
        putUb(m, 0)
        put8(m, 0)
        if fv >= FV_12_2_EXT1 {
            put8(m, 0)
            putUb(m, 0)
        }
    }
    if parse {
        putBytes(m, e.sql)
        putUb(m, 1)
    } else {
        putUb(m, 0)
    }
    putUb(m, if query { if e.cursorId == 0 { 0 } else { e.prefetch } } else { 1 })
    for i in 0..5 { putUb(m, 0) }
    putUb(m, if query { 1 } else { 0 })
    putUb(m, 0)
    putUb(m, 0x8000)                                    // IMPLICIT_RESULTSET, as python-oracledb sends
    putUb(m, 0)
    putUb(m, 0)
    putUb(m, 0)
    if nb == 0 { return }
    for b in e.binds {
        put8(m, b.oraType)
        put8(m, 1)                                      // USE_INDICATORS
        put8(m, 0)
        put8(m, 0)
        putUb(m, b.bufferSize)
        putUb(m, 0)
        putUb(m, 0)
        putUb(m, 0)
        putUb(m, 0)
        putUb(m, if b.csfrm != 0 { CHARSET_UTF8 } else { 0 })
        put8(m, b.csfrm)
        putUb(m, 0)
        if fv >= FV_12_2 { putUb(m, 0) }
    }
    put8(m, MT_ROW_DATA)
    let plsql = e.kind == S_PLSQL
    for b in e.binds {
        if plsql || !longBind(&b, maxString) { putBindValue(m, &b) }
    }
    if !plsql {
        for b in e.binds {
            if longBind(&b, maxString) { putBindValue(m, &b) }
        }
    }
}

// ---------------------------------------------------------------- transport

type Stream = value closed {
    Plain(net.Conn)
    Tls(tls.Conn)
    Gone
}

fn (s: &Stream) isTls(): bool {
    match s {
        Stream.Tls(_) { return true }
        else { return false }
    }
}

fn (s: mut &Stream) takeTls(): tls.Conn {
    match replace(s, Stream.Gone) {
        Stream.Tls(t) { return t }
        else { panic("tns: not a TLS stream") }
    }
}

fn (s: mut &Stream) put(t: tls.Conn) { let old = replace(s, Stream.Tls(t)) }

fn (s: mut &Stream) read(b: mut &[byte], w: Where): Result[int, Error] {
    if s.isTls() {
        var t = s.takeTls()
        let r = t.read(b, w)
        s.put(t)
        return match r {
            Ok(n) { Ok(n) }
            Err(e) { Err(tlsFail(e)) }
        }
    }
    match s {
        Stream.Plain(c) {
            return match c.read(b, w) {
                Ok(n) { Ok(n) }
                Err(e) { Err(ioFail(e)) }
            }
        }
        else { return Err(ioErr("the connection is closed")) }
    }
}

fn (s: mut &Stream) write(data: &[byte], w: Where): Result[Unit, Error] {
    if s.isTls() {
        var t = s.takeTls()
        let r = t.write(data, w)
        s.put(t)
        return match r {
            Ok(_) { Ok(Unit{}) }
            Err(e) { Err(tlsFail(e)) }
        }
    }
    match s {
        Stream.Plain(c) {
            return match c.write(data, w) {
                Ok(_) { Ok(Unit{}) }
                Err(e) { Err(ioFail(e)) }
            }
        }
        else { return Err(ioErr("the connection is closed")) }
    }
}

type Inbox = record { buf: []byte; pos: int; end: int }

fn readFull(s: mut &Stream, ib: mut &Inbox, dst: mut &[byte], w: Where): Result[Unit, Error] {
    var have = 0
    while have < len(dst) {
        if ib.pos < ib.end {
            let n = min(ib.end - ib.pos, len(dst) - have)
            for k in 0..n { dst[have + k] = ib.buf[ib.pos + k] }
            ib.pos += n
            have += n
            continue
        }
        let n = try s.read(mut &ib.buf, w)
        if n == 0 { return Err(ioErr("the server closed the connection")) }
        ib.pos = 0
        ib.end = n
    }
    return Ok(Unit{})
}

// A packet received: its type, flags and payload (after the header).
pub type Packet = value record { pub ptype: int; pub flags: int; pub data: str }

pub type Transport = record {
    s: Stream
    inbox: Inbox
    hdr: []byte
    large: bool             // after an ACCEPT of version 315 and up: 32-bit lengths
    pub sdu: int
}

fn transport(s: Stream): Transport {
    return Transport{s: s, inbox: Inbox{buf: array(16384, byte(0)), pos: 0, end: 0}, hdr: array(HEADER, byte(0)),
                     large: false, sdu: SDU}
}

// The header of a packet of n bytes in all.
fn putHeader(b: mut &[]byte, n: int, ptype: int, flags: int, large: bool) {
    if large {
        put32be(b, n)
    } else {
        put16be(b, n)
        put16be(b, 0)
    }
    put8(b, ptype)
    put8(b, flags)
    put16be(b, 0)
}

pub fn packet(ptype: int, flags: int, payload: str, large: bool): []byte {
    var b: []byte = []
    putHeader(mut &b, HEADER + len(payload), ptype, flags, large)
    putStr(mut &b, payload)
    return b
}

fn (t: mut &Transport) sendPacket(ptype: int, flags: int, payload: str, w: Where): Result[Unit, Error] {
    let b = packet(ptype, flags, payload, t.large)
    return t.s.write(&b, w)
}

// Sends a TTC message in DATA packets of at most the SDU.
fn (t: mut &Transport) sendData(msg: &[]byte, w: Where): Result[Unit, Error] {
    let room = t.sdu - HEADER - 2
    var off = 0
    var out: []byte = []
    while true {
        let k = min(room, len(msg) - off)
        putHeader(mut &out, HEADER + 2 + k, PT_DATA, 0, t.large)
        put16be(mut &out, 0)
        for i in 0..k { append(mut &out, msg[off + i]) }
        off += k
        if off >= len(msg) { break }
    }
    return t.s.write(&out, w)
}

fn (t: mut &Transport) receive(w: Where): Result[Packet, Error] {
    try readFull(mut &t.s, mut &t.inbox, mut &t.hdr, w)
    var n = 0
    if t.large {
        n = (int(t.hdr[0]) << 24) | (int(t.hdr[1]) << 16) | (int(t.hdr[2]) << 8) | int(t.hdr[3])
    } else {
        n = (int(t.hdr[0]) << 8) | int(t.hdr[1])
    }
    if n < HEADER || n > 4194304 { return Err(proto("a packet length of " + n.toStr())) }
    var body = array(n - HEADER, byte(0))
    try readFull(mut &t.s, mut &t.inbox, mut &body, w)
    return Ok(Packet{ptype: int(t.hdr[4]), flags: int(t.hdr[5]), data: strFromBytes(&body)})
}

// ---------------------------------------------------------------- connecting

// Where and how to connect: oracle fills it from a connection string.
pub type Config = value record {
    pub host: str
    pub port: int
    pub service: str
    pub user: str
    pub password: str
    pub program: str
    pub tls: bool                       // tcps
    pub trustServerCertificate: bool    // tls's insecureSkipVerify
    pub serverCertName: str             // "" : host
    pub caFile: str                     // PEM of the CAs to trust instead of the system store ("" : the system's)
}

fn addrOf(host: str, port: int): str {
    if indexOf(host, ":", 0) >= 0 { return "[" + host + "]:" + port.toStr() }
    return host + ":" + port.toStr()
}

fn machine(): str {
    match os.env("HOSTNAME") {
        Some(h) { if h != "" { return h } }
        None { }
    }
    return "localhost"
}

fn osUser(): str { return os.envOr("USER", "obx") }

// The connect descriptor the listener reads.
pub fn descriptor(cfg: &Config): str {
    let proto = if cfg.tls { "tcps" } else { "tcp" }
    return "(DESCRIPTION=(ADDRESS=(PROTOCOL=" + proto + ")(HOST=" + cfg.host + ")(PORT=" + cfg.port.toStr() +
           "))(CONNECT_DATA=(SERVICE_NAME=" + cfg.service + ")(CID=(PROGRAM=" + cfg.program + ")(HOST=" + machine() +
           ")(USER=" + osUser() + "))))"
}

// The CONNECT packet's body (after the header) for a descriptor; the
// descriptor goes in a DATA packet of its own when it is long.
pub fn connectBody(desc: str): str {
    var b: []byte = []
    put16be(mut &b, VERSION_DESIRED)
    put16be(mut &b, VERSION_MINIMUM)
    put16be(mut &b, 0x0001)                 // service options: don't care (no out-of-band breaks)
    put16be(mut &b, SDU)
    put16be(mut &b, SDU)
    put16be(mut &b, 0x4f98)                 // protocol characteristics
    put16be(mut &b, 0)
    put16be(mut &b, 1)
    put16be(mut &b, len(desc))
    put16be(mut &b, 74)                     // offset of the connect data
    put32be(mut &b, 0)
    put8(mut &b, NSI_FLAGS)
    put8(mut &b, NSI_FLAGS)
    for i in 0..24 { put8(mut &b, 0) }
    put32be(mut &b, SDU)
    put32be(mut &b, SDU)
    put32be(mut &b, 0)
    put32be(mut &b, 0)
    if len(desc) <= MAX_CONNECT_DATA { putStr(mut &b, desc) }
    return strFromBytes(&b)
}

// The listener's answer to a CONNECT.
pub type Accept = value record { pub version: int; pub sdu: int; pub flags2: int }

pub fn parseAccept(d: str): Result[Accept, Error] {
    var c = cursor(d)
    let v = try c.u16be("ACCEPT")
    if v < VERSION_MIN_ACCEPTED {
        return Err(sqldialect.dbError(sqldialect.E_PROTOCOL, "tns: the server speaks TNS version " + v.toStr() +
                                      "; Oracle Database 12.1 or later (315) is needed"))
    }
    try c.skip(12, "ACCEPT")
    let f1 = try c.u8("ACCEPT")
    if (f1 & NSI_NA_REQUIRED) != 0 {
        return Err(sqldialect.dbError(sqldialect.E_PROTOCOL,
                                      "tns: the server requires Native Network Encryption, which is not supported (use TLS)"))
    }
    try c.skip(9, "ACCEPT")
    let sdu = try c.u32be("ACCEPT")
    var f2 = 0
    if v >= VERSION_MIN_OOB_CHECK {
        try c.skip(5, "ACCEPT")
        f2 = try c.u32be("ACCEPT")
    }
    return Ok(Accept{version: v, sdu: sdu, flags2: f2})
}

// The error a REFUSE packet gives: the listener's ERR= number as the code.
pub fn refuseError(d: str, cfg: &Config): Error {
    var text = ""
    if len(d) >= 4 {
        let n = (int(d[2]) << 8) | int(d[3])
        if 4 + n <= len(d) { text = d[4..4 + n] }
    }
    var code = 0
    let at = indexOf(text, "(ERR=", 0)
    if at >= 0 {
        let rest = text[at + 5..]
        let e = indexOf(rest, ")", 0)
        if e > 0 {
            match parseInt(rest[0..e]) {
                Some(v) { code = v }
                None { }
            }
        }
    }
    if code == 12514 {
        return Error{code: 12514, state: "", msg: "ORA-12514: the listener does not know the service " + cfg.service +
                                                    " (" + addrOf(cfg.host, cfg.port) + ")"}
    }
    if code == 0 { return sqldialect.dbError(sqldialect.E_PROTOCOL, "tns: the listener refused the connection") }
    let pad = if code < 10000 { "0" } else { "" }
    return Error{code: code, state: "", msg: "ORA-" + pad + code.toStr() + ": the listener refused the connection"}
}

// ---------------------------------------------------------------- sessions

// A logged-in connection.
pub type Session = record {
    t: Transport
    pub fieldVersion: int
    seq: int
    pub broken: bool
    pub maxString: int          // 32767 with MAX_STRING_SIZE=EXTENDED, else 4000
    pub charset: int
    pub ncharset: int
    pub banner: str
    pub version: str            // "23.0.0.0.0"
    pub sessionId: int
    pub serial: int
    pub inTransaction: bool     // the last call's status had a transaction in progress
    pub warnings: []str
    pub maxReply: int           // bytes a reply may have
    toClose: []int              // cursors to close with the next request
    eor: bool                   // the server ends every reply with END_OF_RESPONSE (ACCEPT's flag)
    fastAuth: bool              // the server takes the fast authentication (Oracle 23 and up)
}

fn compileCaps(fv: int, eor: bool): str {
    var c = array(55, byte(0))
    c[0] = byte(6)
    c[4] = byte(8 | 2 | 32 | 64 | 0x80)
    c[5] = byte(0x08 | 0x10)
    c[7] = byte(fv)
    c[8] = byte(1)
    c[9] = byte(1)
    c[15] = byte(0x20 | 0x01 | 0x08)
    c[16] = byte(0x10 | 0x80)
    c[17] = byte(3)
    c[18] = byte(7)
    c[19] = byte(3)
    c[21] = byte(1)
    c[23] = byte(0x01 | 0x02 | 0x40 | 0x08 | 0x80 | 0x04)
    c[26] = byte(0x04)
    c[27] = byte(1)
    c[31] = byte(0x10)
    c[34] = byte(12)
    c[35] = byte(0x20)
    c[37] = byte(0x10 | 0x20 | 0x80 | 0x08)
    c[39] = byte(FV_12_2)
    c[40] = byte(if eor { 0x04 | 0x20 } else { 0x04 })     // inband notification, end of response
    c[42] = byte(0x01 | 0x04)
    c[44] = byte(0x02)                                      // TTC5: a token in function headers
    return strFromBytes(&c)
}

fn runtimeCaps(): str {
    var c = array(13, byte(0))
    c[0] = byte(2)
    c[6] = byte(0x01 | 0x04)
    return strFromBytes(&c)
}

// The conversion table python-oracledb sends (data_types.pyx): 322 entries
// of (data type, conversion type, representation).
const DATA_TYPES: []int = [
    1, 1, 1, 2, 2, 10, 8, 8, 1, 12, 12, 10, 23, 23, 1, 24, 24, 1, 25, 25, 1, 26, 26, 1,
    27, 27, 10, 28, 28, 1, 29, 29, 1, 30, 30, 1, 31, 31, 1, 32, 32, 1, 33, 33, 1, 10, 10, 1,
    11, 11, 1, 40, 40, 1, 41, 41, 1, 117, 117, 1, 120, 120, 1, 290, 290, 1, 291, 291, 1, 292, 292, 1,
    293, 293, 1, 294, 294, 1, 298, 298, 1, 299, 299, 1, 300, 300, 1, 301, 301, 1, 302, 302, 1, 303, 303, 1,
    304, 304, 1, 305, 305, 1, 306, 306, 1, 307, 307, 1, 308, 308, 1, 309, 309, 1, 310, 310, 1, 311, 311, 1,
    312, 312, 1, 313, 313, 1, 315, 315, 1, 316, 316, 1, 317, 317, 1, 318, 318, 1, 319, 319, 1, 320, 320, 1,
    321, 321, 1, 322, 322, 1, 323, 323, 1, 327, 327, 1, 328, 328, 1, 329, 329, 1, 331, 331, 1, 333, 333, 1,
    334, 334, 1, 335, 335, 1, 336, 336, 1, 337, 337, 1, 338, 338, 1, 339, 339, 1, 340, 340, 1, 341, 341, 1,
    342, 342, 1, 343, 343, 1, 344, 344, 1, 345, 345, 1, 346, 346, 1, 348, 348, 1, 349, 349, 1, 354, 354, 1,
