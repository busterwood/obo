// postgres: PostgreSQL through libpq (libpq.so.5; a program that uses it is
// dynamically linked to it).
//
//     var conn = try postgres.connect("host=/var/run/postgresql dbname=app")
//     try conn.exec("CREATE TEMP TABLE t(id int8, price numeric(10,2))")
//     try conn.query("INSERT INTO t VALUES ($1, $2)", &[Value.Int(1), Value.Dec(2.50)])
//     let rows = try conn.query("SELECT id, price FROM t WHERE id = $1", &[Value.Int(1)])
//     for r in 0..rows.rowCount() {
//         println((try rows.int(r, 0)).toStr() + " " + (try rows.decimal(r, 0)).toStr())
//     }
//
// Resources: Conn and Rows own their libpq handle and release it when they
// are dropped (PQfinish, PQclear). Conn.close() consumes the connection, so
// there is no closed-handle state. Rows hold the whole result in client
// memory and do not borrow their Conn: they stay readable after it closes.
// openHandles() counts the live handles of both kinds, for tests.
//
// Parameters are $1, $2, ... with values from sqldialect.Value, sent in text
// format with an explicit type OID each: NULL 0 (untyped: cast it in the SQL
// where the server cannot infer a type, `$1::numeric`), Int int8 (20), Float
// float8 (701, shortest round-trip text), Bool bool (16), Text text (25, no
// NUL byte), Bytes bytea (17, hex), Dec numeric (1700, exact text). SQL is
// never interpolated. Results come in text format, which is exact for every
// type: numeric is never read through a float; bytea is decoded from hex.
// Columns report their type OID and typmod; decimal() uses the typmod of a
// numeric(p, s) column to restore its display scale and check the value.
//
// Errors are sqldialect.DbError. A failed statement is code
// PGRES_FATAL_ERROR (7) with the server's SQLSTATE in `state` ("23505") and
// its primary message; a failed connection CONNECTION_BAD (1); a connection
// string libpq cannot parse E_INPUT.

import "sqldialect"
import "math"
import "ffi"
import "task"
import "time"

pub type Value = sqldialect.Value
pub type Error = sqldialect.DbError
type Sql = sqldialect.Sql

pub const CONNECTION_OK = 0
pub const CONNECTION_BAD = 1
pub const PGRES_EMPTY_QUERY = 0
pub const PGRES_COMMAND_OK = 1
pub const PGRES_TUPLES_OK = 2
pub const PGRES_FATAL_ERROR = 7

pub const OID_BOOL = 16
pub const OID_BYTEA = 17
pub const OID_INT8 = 20
pub const OID_INT2 = 21
pub const OID_INT4 = 23
pub const OID_TEXT = 25
pub const OID_FLOAT4 = 700
pub const OID_FLOAT8 = 701
pub const OID_NUMERIC = 1700

const DIAG_SQLSTATE = 67           // 'C'
const DIAG_MESSAGE_PRIMARY = 77    // 'M'
const MAX_DSCALE = 16383           // numeric's largest display scale
const POLLING_FAILED = 0           // PostgresPollingStatusType
const POLLING_READING = 1
const POLLING_WRITING = 2
const POLLING_OK = 3
const PQTRANS_IDLE = 0
const ABORT_MS = 5000              // how long a cancelled query's results are waited for

extern "pq" fn PQlibVersion(): i32
extern "pq" fn PQconninfoParse(conninfo: str, err: mut &ptr): ptr
extern "pq" fn PQconninfoFree(opts: ptr)
extern "pq" fn PQfreemem(p: ptr)
extern "pq" fn PQconnectStart(conninfo: str): ptr blocking
extern "pq" fn PQconnectPoll(c: ptr): i32 blocking
extern "pq" fn PQconninfo(c: ptr): ptr
extern "pq" fn PQsocket(c: ptr): i32
extern "pq" fn PQsetnonblocking(c: ptr, on: i32): i32
extern "pq" fn PQtransactionStatus(c: ptr): i32
extern "pq" fn PQstatus(c: ptr): i32
extern "pq" fn PQerrorMessage(c: ptr): str
extern "pq" fn PQserverVersion(c: ptr): i32
extern "pq" fn PQfinish(c: ptr)
extern "pq" fn PQsendQuery(c: ptr, sql: str): i32
extern "pq" fn PQsendQueryParams(c: ptr, sql: str, n: i32, types: &[]u32, values: &[]ptr, lengths: ptr,
                                 formats: ptr, resultFormat: i32): i32
extern "pq" fn PQflush(c: ptr): i32
extern "pq" fn PQconsumeInput(c: ptr): i32
extern "pq" fn PQisBusy(c: ptr): i32
extern "pq" fn PQgetResult(c: ptr): ptr
extern "pq" fn PQgetCancel(c: ptr): ptr
extern "pq" fn PQcancel(cn: ptr, errbuf: mut &[]byte, n: i32): i32 blocking
extern "pq" fn PQfreeCancel(cn: ptr)
extern "c" fn rtFdWait(fd: int, dir: int, ms: int, cancellable: bool, w: ptr): int as "obxlib_fd_wait"
extern "pq" fn PQresultStatus(r: ptr): i32
extern "pq" fn PQresultErrorMessage(r: ptr): str
extern "pq" fn PQresultErrorField(r: ptr, field: i32): str
extern "pq" fn PQclear(r: ptr)
extern "pq" fn PQntuples(r: ptr): i32
extern "pq" fn PQnfields(r: ptr): i32
extern "pq" fn PQfname(r: ptr, col: i32): str
extern "pq" fn PQftype(r: ptr, col: i32): u32
extern "pq" fn PQfmod(r: ptr, col: i32): i32
extern "pq" fn PQgetisnull(r: ptr, row: i32, col: i32): i32
extern "pq" fn PQgetvalue(r: ptr, row: i32, col: i32): str
extern "pq" fn PQcmdTuples(r: ptr): str

var OPEN: int = 0

// The number of Conn and Rows handles not yet closed or dropped.
pub fn openHandles(): int { return OPEN }

// libpq's version: 160004 for 16.4.
pub fn libVersion(): int { return int(PQlibVersion()) }

fn chomp(s: str): str {
    var n = len(s)
    while n > 0 && isSpace(s[n - 1]) { n -= 1 }
    return s[..n]
}

// -------------------------------------------------------------- connections

pub type Conn = record { h: ptr }

fn (c: mut &Conn) drop() {
    if !isNull(c.h) {
        PQfinish(c.h)
        OPEN -= 1
    }
}

fn connError(h: ptr): Error { return sqldialect.dbError(CONNECTION_BAD, chomp(PQerrorMessage(h))) }

fn waitError(r: int, what: str): Error {
    if r == 1 { return sqldialect.dbError(sqldialect.E_CANCELLED, what + " cancelled") }
    if r == 3 { return sqldialect.dbError(sqldialect.E_TIMEOUT, what + ": deadline passed") }
    return sqldialect.dbError(CONNECTION_BAD, what + ": cannot wait for the socket (" + r.toStr() + ")")
}

// Parks until the connection's socket is readable (dir 0), writable (1) or
// either (2): 0, or 1 cancelled, 3 a deadline or ms passed, negative an error.
fn sockWait(h: ptr, dir: int, ms: int, cancellable: bool, w: Where): int {
    let fd = int(PQsocket(h))
    if fd < 0 { return -9 }
    return rtFdWait(fd, dir, ms, cancellable, w.cstr())
}

// The connection's connect_timeout in milliseconds (libpq: at least 2 s), or -1.
fn connectTimeout(h: ptr): int {
    let opts = PQconninfo(h)
    if isNull(opts) { return -1 }
    var ms = -1
    var i = 0
    while !isNull(ffi.peekPtr(opts, i * 7)) {
        let v = ffi.peekPtr(opts, i * 7 + 3)       // PQconninfoOption: keyword, envvar, compiled, val, ...
        if strFromC(ffi.peekPtr(opts, i * 7)) == "connect_timeout" && !isNull(v) {
            let t = parseInt(trim(strFromC(v))).unwrapOr(0)
            if t > 0 { ms = (if t < 2 { 2 } else { t }) * 1000 }
        }
        i += 1
    }
    PQconninfoFree(opts)
    return ms
}

// Connects with a libpq connection string ("host=... dbname=... user=...") or
// URI, without blocking the other tasks: PQconnectStart and PQconnectPoll
// (blocking externs: name lookup, TLS and password hashing run on the helper
// pool) with the task parked on the socket between the steps. The task's
// cancellation (E_CANCELLED) and deadline, and the connection's
// connect_timeout for the whole connect (E_TIMEOUT), end the wait.
pub fn connect(conninfo: str, w: Where): Result[Conn, Error] {
    try sqldialect.noNul(conninfo, "connection string")
    var msg = nullPtr()
    let opts = PQconninfoParse(conninfo, mut &msg)
    if isNull(opts) {
        let text = if isNull(msg) { "out of memory" } else { chomp(strFromC(msg)) }
        PQfreemem(msg)
        return Err(sqldialect.inputError(text))
    }
    PQconninfoFree(opts)
    let h = PQconnectStart(conninfo)
    if isNull(h) { return Err(sqldialect.dbError(CONNECTION_BAD, "out of memory")) }
    OPEN += 1
    let conn = Conn{h: h}             // finished when dropped, on the error paths too
    if int(PQstatus(h)) == CONNECTION_BAD { return Err(connError(h)) }
    let limit = connectTimeout(h)
    let t0 = time.monotonicNs()
    var st = POLLING_WRITING          // as libpq says: as if PQconnectPoll had returned it
    while st != POLLING_OK {
        if st == POLLING_FAILED { return Err(connError(h)) }
        var ms = -1
        if limit > 0 {
            ms = limit - (time.monotonicNs() - t0) / 1000000
            if ms <= 0 { return Err(sqldialect.dbError(sqldialect.E_TIMEOUT, "connect: connect_timeout passed")) }
        }
        let r = sockWait(h, if st == POLLING_READING { 0 } else { 1 }, ms, true, w)
        if r != 0 {
            if r == 3 && limit > 0 && (time.monotonicNs() - t0) / 1000000 >= limit {
                return Err(sqldialect.dbError(sqldialect.E_TIMEOUT, "connect: connect_timeout passed"))
            }
            return Err(waitError(r, "connect"))
        }
        st = int(PQconnectPoll(h))
    }
    if PQsetnonblocking(h, 1) != 0 { return Err(connError(h)) }
    return Ok(conn)
}

// Closes the connection (dropping it does the same).
pub fn (c: Conn) close() {}

// The server's version: 160015 for 16.15.
pub fn (c: &Conn) serverVersion(): int { return int(PQserverVersion(c.h)) }

// Whether the connection is up and outside a transaction, with no query
// running: what a pool keeps.
pub fn (c: &Conn) idle(): bool {
    return int(PQstatus(c.h)) == CONNECTION_OK && int(PQtransactionStatus(c.h)) == PQTRANS_IDLE
}

// Runs a script of any number of statements, without parameters.
pub fn (c: &Conn) exec(script: str, w: Where): Result[Unit, Error] {
    try sqldialect.noNul(script, "SQL text")
    let r = try c.finish(PQsendQuery(c.h, script), w)
    return Ok(Unit{})
}

// Runs one statement with $1, $2, ... bound to args, in order.
pub fn (c: &Conn) query(sql: str, args: &[Value], w: Where): Result[Rows, Error] {
    try sqldialect.noNul(sql, "SQL text")
    if len(args) > 65535 { return Err(sqldialect.inputError("more than 65535 parameters")) }
    var ps: []Param = []
    for v in args { append(mut &ps, try param(v)) }
    var types: []u32 = []
    var values: []ptr = []
    var copies: []ffi.Mem = []          // the NUL-terminated texts, freed when this returns
    for p in ps {
        append(mut &types, u32(p.oid))
        if p.null {
            append(mut &values, nullPtr())
        } else {
            append(mut &copies, ffi.cstr(p.text))
            append(mut &values, copies[len(copies) - 1].ptr())
        }
    }
    let sent = PQsendQueryParams(c.h, sql, i32(len(ps)), &types, &values, nullPtr(), nullPtr(), 0)
    return c.finish(sent, w)
}

// Runs a fragment with $1, $2, ... placeholders and its arguments.
pub fn (c: &Conn) querySql(q: &Sql, w: Where): Result[Rows, Error] {
    return c.query(q.render(sqldialect.Dialect.Postgres), q.args(), w)
}

// Runs body in a transaction: BEGIN, then COMMIT when it returns Ok, ROLLBACK
// when it returns Err (whose error is the result).
pub fn (c: &Conn) transaction[T](body: &fn(): Result[T, Error], w: Where): Result[T, Error] {
    try c.exec("BEGIN", w)
    match body() {
        Ok(v) {
            try c.exec("COMMIT", w)
            return Ok(v)
        }
        Err(e) {
            c.exec("ROLLBACK", w)
            return Err(e)
        }
    }
}

// After PQsendQuery or PQsendQueryParams (sent: its result): flushes the
// query, parks on the socket until the results are in, and collects them: the
// first error, else the last result (as PQexec). Cancellation and the task's
// deadline end the wait: the query is cancelled on the server then (abort).
fn (c: &Conn) finish(sent: i32, w: Where): Result[Rows, Error] {
    if sent == 0 { return Err(sqldialect.dbError(PGRES_FATAL_ERROR, chomp(PQerrorMessage(c.h)))) }
    while true {
        let f = int(PQflush(c.h))
        if f == 0 { break }
        if f < 0 { return Err(sqldialect.dbError(PGRES_FATAL_ERROR, chomp(PQerrorMessage(c.h)))) }
        let r = sockWait(c.h, 2, -1, true, w)
        if r != 0 { return Err(c.abort(r, w)) }
        if PQconsumeInput(c.h) == 0 { return Err(sqldialect.dbError(PGRES_FATAL_ERROR, chomp(PQerrorMessage(c.h)))) }
    }
    var keep = nullPtr()
    while true {
        while PQisBusy(c.h) != 0 {
            let r = sockWait(c.h, 0, -1, true, w)
            if r != 0 {
                PQclear(keep)
                return Err(c.abort(r, w))
            }
            if PQconsumeInput(c.h) == 0 {
                PQclear(keep)
                return Err(sqldialect.dbError(PGRES_FATAL_ERROR, chomp(PQerrorMessage(c.h))))
            }
        }
        let res = PQgetResult(c.h)
        if isNull(res) { break }
        if isNull(keep) || int(PQresultStatus(keep)) != PGRES_FATAL_ERROR {
            PQclear(keep)
            keep = res
        } else {
            PQclear(res)
        }
    }
    return c.result(keep)
}

// The query was given up (why: 1 cancelled, 3 deadline): asks the server to
// cancel it (PQcancel, a blocking extern: it opens a second connection), then
// reads what is left, for at most ABORT_MS, without being cancellable, so the
// connection is idle again. If the server does not answer in time the
// connection stays busy, and a pool closes it (idle() is false).
fn (c: &Conn) abort(why: int, w: Where): Error {
    let cn = PQgetCancel(c.h)
    if !isNull(cn) {
        var buf = array(256, byte(0))
        PQcancel(cn, mut &buf, i32(256))
        PQfreeCancel(cn)
    }
    let t0 = time.monotonicNs()
    var ok = true
    while ok {
        let left = ABORT_MS - (time.monotonicNs() - t0) / 1000000
        if left <= 0 { break }
        let f = int(PQflush(c.h))
        if f < 0 { break }
        if f == 1 || PQisBusy(c.h) != 0 {
            if sockWait(c.h, if f == 1 { 2 } else { 0 }, left, false, w) != 0 { break }
            ok = PQconsumeInput(c.h) != 0
            continue
        }
        let res = PQgetResult(c.h)
        if isNull(res) { break }
        PQclear(res)
    }
    return waitError(why, "query")
}

// Rows for a PGresult, or the error it reports (it is cleared then).
fn (c: &Conn) result(r: ptr): Result[Rows, Error] {
    if isNull(r) { return Err(sqldialect.dbError(PGRES_FATAL_ERROR, chomp(PQerrorMessage(c.h)))) }
    OPEN += 1
    let rows = Rows{h: r}
    let st = int(PQresultStatus(r))
    if st <= PGRES_TUPLES_OK { return Ok(rows) }
    var msg = PQresultErrorField(r, DIAG_MESSAGE_PRIMARY)
    if len(msg) == 0 { msg = chomp(PQresultErrorMessage(r)) }
    if len(msg) == 0 { msg = "unsupported result status " + st.toStr() + " (COPY?)" }
    return Err(Error{code: st, state: PQresultErrorField(r, DIAG_SQLSTATE), msg: msg})
}

// A parameter as sent: its type OID and text.
type Param = value record { oid: int; null: bool; text: str }

fn param(v: Value): Result[Param, Error] {
    match v {
        Value.Null { return Ok(Param{oid: 0, null: true, text: ""}) }
        Value.Int(n) { return Ok(Param{oid: OID_INT8, null: false, text: n.toStr()}) }
        Value.Float(f) { return Ok(Param{oid: OID_FLOAT8, null: false, text: floatText(f)}) }
        Value.Bool(b) { return Ok(Param{oid: OID_BOOL, null: false, text: if b { "t" } else { "f" }}) }
        Value.Text(s) {
            try sqldialect.noNul(s, "text value")
            return Ok(Param{oid: OID_TEXT, null: false, text: s})
        }
        Value.Bytes(b) { return Ok(Param{oid: OID_BYTEA, null: false, text: "\\x" + sqldialect.hex(b)}) }
        Value.Dec(d) { return Ok(Param{oid: OID_NUMERIC, null: false, text: try sqldialect.decimalText(d, MAX_DSCALE)}) }
    }
}

fn floatText(f: float): str {
    if f.isNaN() { return "NaN" }
    if f.isInf() { return if f > 0.0f { "Infinity" } else { "-Infinity" } }
    return f.toStr()
}

// The Dec value for numeric(p, s), checked first (sqldialect.fitDecimal): the
// server would round a value with more fraction digits instead of failing.
pub fn decimalParam(d: Decimal, p: int, s: int): Result[Value, Error] {
    return Ok(Value.Dec(try sqldialect.fitDecimal(d, p, s)))
}

// ------------------------------------------------------------------- rows

pub type Rows = record { h: ptr }

fn (r: mut &Rows) drop() {
    PQclear(r.h)
    OPEN -= 1
}

// Clears the result now (dropping it does the same).
pub fn (r: Rows) close() {}

pub fn (r: &Rows) rowCount(): int { return int(PQntuples(r.h)) }

pub fn (r: &Rows) columnCount(): int { return int(PQnfields(r.h)) }

// Rows inserted, updated, deleted, ... by the command (0 when it says none).
pub fn (r: &Rows) affected(): int { return parseInt(PQcmdTuples(r.h)).unwrapOr(0) }

fn (r: &Rows) col(col: int): Result[i32, Error] {
    if col < 0 || col >= r.columnCount() {
        return Err(sqldialect.inputError("column " + col.toStr() + " out of range (" + r.columnCount().toStr() + " columns)"))
    }
    return Ok(i32(col))
}

pub fn (r: &Rows) columnName(col: int): Result[str, Error] { return Ok(PQfname(r.h, try r.col(col))) }

// The column's type OID (OID_INT8, OID_NUMERIC, ...).
pub fn (r: &Rows) columnType(col: int): Result[int, Error] { return Ok(int(PQftype(r.h, try r.col(col)))) }

// The column's type modifier; -1 when it has none (also a valid value).
pub fn (r: &Rows) columnTypmod(col: int): Result[int, Error] { return Ok(int(PQfmod(r.h, try r.col(col)))) }

// The precision and scale of a numeric column; constrained is false for a
// plain numeric. E_TYPE for another type, E_DEC_METADATA for a typmod that
// is not a numeric one.
pub type DecimalType = value record { pub precision: int; pub scale: int; pub constrained: bool }

pub fn (r: &Rows) decimalType(col: int): Result[DecimalType, Error] {
    if try r.columnType(col) != OID_NUMERIC { return Err(typeError(col, "numeric")) }
    let tm = try r.columnTypmod(col)
    if tm == -1 { return Ok(DecimalType{precision: 0, scale: 0, constrained: false}) }
    let t = tm - 4
    let p = (t >> 16) & 0xffff
    let s = ((t & 0x7ff) ^ 1024) - 1024
    if tm < 4 || p < 1 || p > 1000 || s < -1000 || s > 1000 {
        return Err(sqldialect.dbError(sqldialect.E_DEC_METADATA, "invalid numeric typmod " + tm.toStr()))
    }
    return Ok(DecimalType{precision: p, scale: s, constrained: true})
}

fn typeError(col: int, want: str): Error {
    return sqldialect.dbError(sqldialect.E_TYPE, "column " + col.toStr() + " is not " + want)
}

pub fn (r: &Rows) isNull(row: int, col: int): Result[bool, Error] {
    let c = try r.col(col)
    if row < 0 || row >= r.rowCount() {
        return Err(sqldialect.inputError("row " + row.toStr() + " out of range (" + r.rowCount().toStr() + " rows)"))
    }
    return Ok(PQgetisnull(r.h, i32(row), c) == 1)
}

// The value's text form, as the server sent it. E_NULL for NULL.
pub fn (r: &Rows) text(row: int, col: int): Result[str, Error] {
    if try r.isNull(row, col) { return Err(sqldialect.dbError(sqldialect.E_NULL, "column " + col.toStr() + " is NULL")) }
    return Ok(PQgetvalue(r.h, i32(row), i32(col)))
}

// An int2, int4 or int8 value.
pub fn (r: &Rows) int(row: int, col: int): Result[int, Error] {
    let t = try r.text(row, col)
    let oid = try r.columnType(col)
    if oid != OID_INT8 && oid != OID_INT4 && oid != OID_INT2 { return Err(typeError(col, "an integer")) }
    return Ok(parseInt(t).unwrap())
}

pub fn (r: &Rows) bool(row: int, col: int): Result[bool, Error] {
    let t = try r.text(row, col)
    if try r.columnType(col) != OID_BOOL { return Err(typeError(col, "a boolean")) }
    return Ok(t == "t")
}

// A float4 or float8 value (exact: the server sends the shortest text that
// reads back as the same value).
pub fn (r: &Rows) float(row: int, col: int): Result[float, Error] {
    let t = try r.text(row, col)
    let oid = try r.columnType(col)
    if oid != OID_FLOAT8 && oid != OID_FLOAT4 { return Err(typeError(col, "a float")) }
    if t == "Infinity" { return Ok(math.inf()) }
    if t == "-Infinity" { return Ok(-math.inf()) }
    return Ok(math.parse(t).unwrap())
}

// A bytea's exact bytes, or the text of any other type.
pub fn (r: &Rows) bytes(row: int, col: int): Result[str, Error] {
    let t = try r.text(row, col)
    if try r.columnType(col) != OID_BYTEA { return Ok(t) }
    if len(t) < 2 || t[..2] != "\\x" { return Err(typeError(col, "bytea in hex format")) }
    match sqldialect.unhex(t[2..]) {
        Some(b) { return Ok(b) }
        None { return Err(typeError(col, "bytea in hex format")) }
    }
}

// A numeric value as an exact Decimal. For a numeric(p, s) column the display
// scale is s (zeros are added, never rounded away) and the value is checked
// against (p, s). E_TYPE for another type, E_NONFINITE for NaN and Infinity.
pub fn (r: &Rows) decimal(row: int, col: int): Result[Decimal, Error] {
    let t = try r.text(row, col)
    let ty = try r.decimalType(col)
    let d = try sqldialect.parseDecimal(t)
    if ty.constrained && ty.scale >= 0 { return sqldialect.fitDecimal(d, ty.precision, ty.scale) }
    return Ok(d)
}

// None for NULL (never zero), otherwise as decimal().
pub fn (r: &Rows) decimalOrNull(row: int, col: int): Result[Option[Decimal], Error] {
    if try r.isNull(row, col) { return Ok(None) }
    return Ok(Some(try r.decimal(row, col)))
}

// The value by its column's type: Null, Bool, Int (int2/4/8), Float
// (float4/8), Dec (numeric), Bytes (bytea), and Text for every other type.
pub fn (r: &Rows) value(row: int, col: int): Result[Value, Error] {
    if try r.isNull(row, col) { return Ok(Value.Null) }
    let oid = try r.columnType(col)
    if oid == OID_BOOL { return Ok(Value.Bool(try r.bool(row, col))) }
    if oid == OID_INT8 || oid == OID_INT4 || oid == OID_INT2 { return Ok(Value.Int(try r.int(row, col))) }
    if oid == OID_FLOAT8 || oid == OID_FLOAT4 { return Ok(Value.Float(try r.float(row, col))) }
    if oid == OID_NUMERIC { return Ok(Value.Dec(try r.decimal(row, col))) }
    if oid == OID_BYTEA { return Ok(Value.Bytes(try r.bytes(row, col))) }
    return Ok(Value.Text(try r.text(row, col)))
}

// -------------------------------------------------------------------- pools

// A pool of at most `size` connections to one server, for the tasks of a
// program (stage C1c). acquire takes an idle connection, opens a new one
// while fewer than size are open, or else parks until another task gives one
// back, first come first served. A Lease gives the connection back when it is
// dropped, unless it is no longer idle (broken, in a transaction, a query
// abandoned): that one is closed, and its place goes to the next waiter,
// which opens a new connection. A Pool is a counted handle (task.Shared):
// copies reach the same pool, and the connections close when the last copy
// and the last lease are gone.
//
//     let pool = postgres.newPool("host=/var/run/postgresql dbname=app", 16)
//     // in any task:
//     let c = try pool.acquire()
//     let rows = try c.query("SELECT name FROM users WHERE id = $1", &[Value.Int(id)])
pub type Pool = value record { sh: task.Shared[PoolState] }

type PoolState = record {
    conninfo: str
    size: int
    open: int                 // connections open or being opened, leased or idle
    idle: []Conn
    waiters: []Waiter         // first come first served
    nextId: int
}

// A task parked in acquire. Its promise brings a connection, or None: a
// place to open one in.
type Waiter = record { id: int; p: task.Promise[Option[Conn]] }

// A connection taken from a pool, given back when it is dropped.
pub type Lease = record {
    c: Conn
    pool: task.Shared[PoolState]
}

// What a pool holds: connections open (leased, idle or being opened), idle,
// and tasks waiting for one.
pub type PoolStats = value record { pub open: int; pub idle: int; pub waiting: int }

pub fn newPool(conninfo: str, size: int): Pool {
    let n = if size < 1 { 1 } else { size }
    return Pool{sh: task.shared(PoolState{conninfo: conninfo, size: n, open: 0, idle: [], waiters: [], nextId: 0})}
}

pub fn (p: &Pool) stats(): PoolStats {
    var r = PoolStats{open: 0, idle: 0, waiting: 0}
    p.sh.with(fn(st: mut &PoolState) { r = PoolStats{open: st.open, idle: len(st.idle), waiting: len(st.waiters)} })
    return r
}

// A connection of the pool; parks while all size are leased. Err when a new
// connection fails (connect's errors), or when the task is cancelled
// (E_CANCELLED) or its deadline passes (E_TIMEOUT) while it waits.
pub fn (p: &Pool) acquire(w: Where): Result[Lease, Error] {
    var got: Option[Conn] = None
    var place = false
    var wait: Option[task.Future[Option[Conn]]] = None
    var id = 0
    var conninfo = ""
    p.sh.with(fn(st: mut &PoolState) {
        conninfo = st.conninfo
        if len(st.idle) > 0 {
            got = Some(pop(mut &st.idle))
        } else if st.open < st.size {
            st.open += 1
            place = true
        } else {
            id = st.nextId
            st.nextId += 1
            let task.Handoff{promise: pr, future: f} = task.promise[Option[Conn]]()
            append(mut &st.waiters, Waiter{id: id, p: pr})
            wait = Some(f)
        }
    })
    match replace(mut &wait, None) {
        Some(f) {
            match f.wait(w) {
                Ok(v) {
                    got = v
                    place = got.isNone()
                }
                Err(e) {
                    // Still queued: leave the queue. Already served: what came was dropped
                    // with the future (a connection closed, or a place), so its place goes on.
                    var served = true
                    p.sh.with(fn(st: mut &PoolState) {
                        for i in 0..len(st.waiters) {
                            if st.waiters[i].id == id {
                                for j in i..len(st.waiters) - 1 { swap(mut &st.waiters, j, j + 1) }
                                let gone = pop(mut &st.waiters)
                                served = false
                                break
                            }
                        }
                    })
                    if served { handOn(&p.sh, None) }
                    return Err(sqldialect.dbError(if e == task.Cancelled.Timeout { sqldialect.E_TIMEOUT } else { sqldialect.E_CANCELLED },
                        "pool: " + e.toStr() + " while waiting for a connection"))
                }
            }
        }
        None {}
    }
    match replace(mut &got, None) {
        Some(c) {
            if c.idle() { return Ok(Lease{c: c, pool: p.sh}) }
            place = true                  // went bad while idle: closed here, its place reused
        }
        None {}
    }
    match connect(conninfo, w) {
        Ok(c) { return Ok(Lease{c: c, pool: p.sh}) }
        Err(e) {
            handOn(&p.sh, None)
            return Err(e)
        }
    }
}

// Gives a connection (or, for None, a place to open one) to the first waiter;
// with none, keeps the connection idle (or frees the place). The promise is
// completed outside with: if its future is gone, what it carries is dropped
// there, and that may come back here.
fn handOn(sh: &task.Shared[PoolState], var c: Option[Conn]) {
    var p: Option[task.Promise[Option[Conn]]] = None
    sh.with(fn(st: mut &PoolState) {
        if len(st.waiters) > 0 {
            for j in 0..len(st.waiters) - 1 { swap(mut &st.waiters, j, j + 1) }
            let Waiter{id: _, p: pr} = pop(mut &st.waiters)
            p = Some(pr)
        } else {
            match replace(mut &c, None) {
                Some(conn) { append(mut &st.idle, conn) }
                None { st.open -= 1 }
            }
        }
    })
    match replace(mut &p, None) {
        Some(pr) { pr.complete(replace(mut &c, None)) }
        None {}
    }
}

fn (l: mut &Lease) drop() {
    let c = replace(mut &l.c, Conn{h: nullPtr()})
    if isNull(c.h) { return }
    if c.idle() {
        handOn(&l.pool, Some(c))
    } else {
        c.close()                          // closed now; its place goes on
        handOn(&l.pool, None)
    }
}

pub fn (l: &Lease) exec(script: str, w: Where): Result[Unit, Error] { return l.c.exec(script, w) }

pub fn (l: &Lease) query(sql: str, args: &[Value], w: Where): Result[Rows, Error] { return l.c.query(sql, args, w) }

pub fn (l: &Lease) querySql(q: &Sql, w: Where): Result[Rows, Error] { return l.c.querySql(q, w) }

pub fn (l: &Lease) transaction[T](body: &fn(): Result[T, Error], w: Where): Result[T, Error] {
    return l.c.transaction(body, w)
}
