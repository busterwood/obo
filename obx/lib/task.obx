// task: concurrent tasks on one thread (SPEC 16; design/concurrency.md, stage C1a).
//
// A task is a function run on its own stack. Tasks are started on a scope and
// scheduled cooperatively: one runs at a time, until it parks (waits for a
// future, yields, or ends a scope with tasks still running). There are no
// threads, so a value is never touched by two tasks at once.
//
//     task.scope(fn(s: mut &task.Scope) {
//         let a = s.start(fetch, 1)
//         let b = s.start(fetch, 2)
//         println(a.wait().unwrap() + b.wait().unwrap())
//     })
//
// Every task belongs to a scope, and a scope ends only when all its tasks
// have finished, so no task outlives the call that started it (or main).
// A Future is owned: one place waits for it. Dropping it without waiting
// cancels its task, and the scope still waits for that task to finish.
//
// Cancellation is cooperative: a cancelled task runs on until it next parks,
// where the wait returns Err(Cancelled.Cancelled), and then unwinds with its
// drops. Cancelling a task also cancels the tasks of the scopes it has open,
// and a task started by a cancelled task starts cancelled.
//
// A Shared[T] is one value several tasks reach; with(f) is the only access.
// No task may park inside with (exit 13), so a with block is a critical
// section without a lock. If every task is parked, nothing can wake any of
// them, and the program stops with exit 14 (a deadlock).
//
// Every function that can park, and with, takes the caller's location as a
// last std.Where parameter, which a call leaves out (SPEC 15): the compiler
// passes the call's "file:line". The runtime reports it when the program
// stops: where the task parked (or the deadlock was found), and where the
// open with was called. A call through a function value must pass it
// (here() gives the location of its own call).

extern "c" fn rtScopeOpen(): ptr as "obxlib_task_scope_open"
extern "c" fn rtScopeClose(s: ptr, w: ptr) as "obxlib_task_scope_close"
extern "c" fn rtStart(s: ptr, run: extern fn(ptr): ptr, job: ptr, resdrop: extern fn(ptr)): ptr as "obxlib_task_start"
extern "c" fn rtWait(t: ptr, w: ptr): int as "obxlib_task_wait"
extern "c" fn rtWaitAny(ts: &[]ptr, n: int, w: ptr): int as "obxlib_task_wait_any"
extern "c" fn rtForget(t: ptr) as "obxlib_task_forget"
extern "c" fn rtDetach(t: ptr) as "obxlib_task_detach"
extern "c" fn rtJoin(t: ptr, w: ptr) as "obxlib_task_join"
extern "c" fn rtTake(t: ptr): ptr as "obxlib_task_take"
extern "c" fn rtYield(w: ptr): int as "obxlib_task_yield"
extern "c" fn rtCancelled(): int as "obxlib_task_cancelled"
extern "c" fn rtPromise(resdrop: extern fn(ptr)): ptr as "obxlib_task_promise"
extern "c" fn rtComplete(t: ptr, res: ptr) as "obxlib_task_complete"
extern "c" fn rtAbandon(t: ptr) as "obxlib_task_abandon"
extern "c" fn rtShNew(box: ptr, drop: extern fn(ptr)): ptr as "obxlib_sh_new"
extern "c" fn rtShEnter(s: ptr, w: ptr): ptr as "obxlib_sh_enter"
extern "c" fn rtShLeave(s: ptr, box: ptr) as "obxlib_sh_leave"
extern "c" fn rtSleep(ms: int, w: ptr): int as "obxlib_task_sleep"
extern "c" fn rtWithin(ms: int): int as "obxlib_task_within"
extern "c" fn rtRestore(old: int) as "obxlib_task_restore"

// Why a wait has no value: the waiting task was cancelled, the future's
// promise was dropped without being completed, or the deadline of an
// enclosing within passed.
pub type Cancelled = value closed { Cancelled; Abandoned; Timeout }

pub fn (c: Cancelled) eq(other: &Cancelled): bool { return c.toStr() == other.toStr() }

pub fn (c: Cancelled) toStr(): str {
    match c {
        Cancelled.Cancelled { return "cancelled" }
        Cancelled.Abandoned { return "abandoned" }
        Cancelled.Timeout { return "timeout" }
    }
}

// The tasks started in one call of scope.
pub type Scope = record { p: ptr }

// The result of a task or a promise, once there is one.
pub type Future[T] = record { t: ptr }

// A future completed by hand.
pub type Promise[T] = record { t: ptr }

// promise's result: the two ends of one hand-over, the promise that
// completes it and the future that waits for it.
pub type Handoff[T] = record {
    pub promise: Promise[T]
    pub future: Future[T]
}

// A counted handle to one value: a copy type; the value is dropped with the
// last handle.
pub type Shared[T] = value record { p: ptr }

// What a task runs (boxed until it starts), and the box of a result or a
// Shared value.
type Job[A, T] = record {
    f: fn(A): T
    arg: A
}

type Cell[T] = record { v: T }

fn run[A, T](p: ptr): ptr {
    let j: Job[A, T] = fromPtr(p)
    let Job{f: f, arg: a} = move(j)
    return intoPtr(Cell[T]{v: f(a)})
}

fn dropCell[T](p: ptr) {
    let c: Cell[T] = fromPtr(p)
}

fn unbox[T](p: ptr): T {
    let c: Cell[T] = fromPtr(p)
    let Cell{v: v} = move(c)
    return v
}

// ---- scopes

// Runs f with a new scope, then parks until every task started on it has
// finished (cancelled ones included). w: the call of scope.
pub fn scope(f: &fn(mut &Scope), w: Where) {
    var s = Scope{p: rtScopeOpen()}
    f(mut &s)
    rtScopeClose(s.p, w.cstr())
}

// scope for an f with a result.
pub fn scoped[R](f: &fn(mut &Scope): R, w: Where): R {
    var s = Scope{p: rtScopeOpen()}
    let r = f(mut &s)
    rtScopeClose(s.p, w.cstr())
    return r
}

// Starts f(arg) as a task of the scope. It runs once the current task parks.
pub fn (s: mut &Scope) start[A, T](f: fn(A): T, arg: A): Future[T] {
    let j = Job[A, T]{f: f, arg: arg}
    return Future[T]{t: rtStart(s.p, run[A, T], intoPtr(j), dropCell[T])}
}

// Starts f(arg) as a task of the scope with no future: nobody waits for it,
// and its result is dropped. The scope still waits for it to finish, and it
// is cancelled with the scope's task (an accept loop's connections).
pub fn (s: mut &Scope) spawn[A, T](f: fn(A): T, arg: A) {
    let j = Job[A, T]{f: f, arg: arg}
    rtDetach(rtStart(s.p, run[A, T], intoPtr(j), dropCell[T]))
}

// ---- futures

// Parks until the task has finished, and gives its result.
pub fn (var f: Future[T]) wait(w: Where): Result[T, Cancelled] {
    let t = replace(mut &f.t, nullPtr())
    let r = rtWait(t, w.cstr())
    if r != 0 {
        rtForget(t)
        return Err(waitError(r))
    }
    return Ok(unbox[T](rtTake(t)))
}

pub fn (f: mut &Future[T]) drop() {
    if !isNull(f.t) { rtForget(f.t) }
}

// Waits for every future, in order; the results in the same order. On an
// error the futures not yet waited for are dropped (their tasks cancelled).
pub fn all[T](var fs: []Future[T], w: Where): Result[[]T, Cancelled] {
    var out: []T = []
    for i in 0..len(fs) {
        let f = replace(mut &fs[i], Future[T]{t: nullPtr()})
        match f.wait(w) {
            Ok(v) { append(mut &out, v) }
            Err(e) { return Err(e) }
        }
    }
    return Ok(out)
}

// The result of the first future to finish. The other tasks are cancelled,
// and any returns once they have finished. fs must not be empty.
pub fn any[T](var fs: []Future[T], w: Where): Result[T, Cancelled] {
    if len(fs) == 0 { panic("task.any: no futures") }
    var ts: []ptr = []
    for i in 0..len(fs) { append(mut &ts, fs[i].t) }
    let k = rtWaitAny(&ts, len(ts), w.cstr())
    for i in 0..len(fs) {
        if i != k {
            fs[i].t = nullPtr()
            rtJoin(ts[i], w.cstr())
        }
    }
    if k < 0 { return Err(if k == -1 { Cancelled.Cancelled } else { Cancelled.Timeout }) }
    let f = replace(mut &fs[k], Future[T]{t: nullPtr()})
    return f.wait(w)
}

// Lets the other runnable tasks run first; Err when this task is cancelled
// or its deadline has passed.
pub fn yield(w: Where): Result[Unit, Cancelled] {
    let r = rtYield(w.cstr())
    if r != 0 { return Err(waitError(r)) }
    return Ok(Unit{})
}

// The error of a runtime wait's code: 1 cancelled, 2 abandoned, 3 timeout.
fn waitError(r: int): Cancelled {
    return if r == 1 { Cancelled.Cancelled } else if r == 2 { Cancelled.Abandoned } else { Cancelled.Timeout }
}

fn unitOr(r: int): Result[Unit, Cancelled] {
    if r != 0 { return Err(waitError(r)) }
    return Ok(Unit{})
}

// ---- time

// Parks for ms milliseconds (no time when ms <= 0); Err(Cancelled) when the
// task is cancelled (at once, or while it sleeps), Err(Timeout) when the
// deadline of an enclosing within comes first.
pub fn sleep(ms: int, w: Where): Result[Unit, Cancelled] { return unitOr(rtSleep(ms, w.cstr())) }

// Runs f with a deadline ms milliseconds from now (the earlier one wins when
// within is nested). Every call that can park in f, and in the tasks started
// during f, returns Err(Timeout) once the deadline has passed (a wait,
// yield, sleep, or a net read, write, accept or connect), so the work in f
// ends there through its Results. A wait that would park waits only until
// the deadline. within itself does not park.
pub fn within[R](ms: int, f: &fn(): R): R {
    let old = rtWithin(ms)
    let r = f()
    rtRestore(old)
    return r
}

// Whether the running task has been cancelled.
pub fn cancelled(): bool { return rtCancelled() != 0 }

// ---- promises

// A promise and the future it completes.
pub fn promise[T](): Handoff[T] {
    let t = rtPromise(dropCell[T])
    return Handoff[T]{promise: Promise[T]{t: t}, future: Future[T]{t: t}}
}

// Completes the future with v (never parks).
pub fn (var p: Promise[T]) complete(v: T) {
    let t = replace(mut &p.t, nullPtr())
    rtComplete(t, intoPtr(Cell[T]{v: v}))
}

// A promise dropped without complete: its future's wait gives Err(Cancelled.Abandoned).
pub fn (p: mut &Promise[T]) drop() {
    if !isNull(p.t) { rtAbandon(p.t) }
}

// ---- shared values

pub fn shared[T](v: T): Shared[T] {
    return Shared[T]{p: rtShNew(intoPtr(Cell[T]{v: v}), dropCell[T])}
}

// Runs f on the value. f must not park (exit 13), and a with on the same
// value inside f stops the program (exit 13). w: the call of with.
pub fn (s: &Shared[T]) with(f: &fn(mut &T), w: Where) {
    var c: Cell[T] = fromPtr(rtShEnter(s.p, w.cstr()))
    f(mut &c.v)
    rtShLeave(s.p, intoPtr(c))
}

// ---- frozen values
//
// A Frozen[T] is a counted handle to a value that can never change again:
// freeze(v) moves v into it, and nothing gives a mut & of it afterwards. So,
// unlike Shared.with, read may park (sleep, wait, a socket call): no writer
// exists whose change the reader could see half done, and the value cannot
// be freed while a reader holds a handle (each handle is a count). This is
// why set-once globals are sound too. For what every task reads and none
// writes: a server's router, configuration, templates.
//
// It is a copy type (copying adds a count, as for Shared); the value is
// dropped with the last handle. Tasks receive it as any copy argument. A
// worker process forked by workers gets a copy of it, with its own count:
// nothing is shared between processes.
//
// read lends the value as &T. A method returning &T (get(): &T) is not
// possible: SPEC 10 rule 5 lets a result borrow only a place rooted at the
// receiver, and the value lives in the runtime's box, not in the handle.
// The closure form keeps the borrow inside the call, and its result R
// cannot be a borrow (a borrow is not a type argument).
pub type Frozen[T] = value record {
    sh: Shared[T]   // the count; the box is never entered with with
    box: ptr        // the Cell[T] the Shared owns, the same for every copy
}

pub fn freeze[T](v: T): Frozen[T] {
    let box = intoPtr(Cell[T]{v: v})
    return Frozen[T]{sh: Shared[T]{p: rtShNew(box, dropCell[T])}, box: box}
}

// f(&value), and its result. f may park; any number of tasks may be inside
// read of the same value at once.
pub fn (fr: &Frozen[T]) read[R](f: &fn(&T): R): R {
    let c: Cell[T] = fromPtr(fr.box)
    let r = f(&c.v)
    let back = intoPtr(c)    // given back, not dropped: the handles own it
    return r
}

// A copy of the value.
pub fn (fr: &Frozen[T: copy]) get(): T {
    let c: Cell[T] = fromPtr(fr.box)
    let v = c.v
    let back = intoPtr(c)
    return v
}

// ---- signals (stage C2)
//
// A watched signal no longer has its default action (for SIGTERM and SIGINT:
// ending the process): it arrives as an event of the loop, given to every
// task waiting for it then, or kept for the next one that waits when none is
// (one of each signal: arrivals before a wait are merged). Watching starts
// with the first watchSignals or waitSignal for the signal and cannot be
// undone. A program that never watches a signal keeps its default action.

extern "c" fn rtSigWatch(mask: int): int as "obxlib_sig_watch"
extern "c" fn rtSigWait(mask: int, w: ptr): int as "obxlib_sig_wait"

pub const SIGHUP = 1
pub const SIGINT = 2
pub const SIGQUIT = 3
pub const SIGUSR1 = 10
pub const SIGUSR2 = 12
pub const SIGTERM = 15

// The runtime's mask of sigs; a signal that cannot be watched (not 1..31, or
// one the program cannot handle: SIGKILL, SIGSTOP, and the faults SIGILL,
// SIGTRAP, SIGBUS, SIGFPE, SIGSEGV) is a panic.
fn sigMask(sigs: &[]int): int {
    var m = 0
    for i in 0..len(sigs) {
        let s = sigs[i]
        if s < 1 || s > 31 || s == 4 || s == 5 || s == 7 || s == 8 || s == 9 || s == 11 || s == 19 {
            panic("task: signal " + intToStr(s) + " cannot be watched")
        }
        m = m | (1 << (s - 1))
    }
    return m
}

fn watchMask(m: int) {
    let r = rtSigWatch(m)
    if r < 0 { panic("task: cannot watch signals (errno " + intToStr(-r) + ")") }
}

// Starts watching the signals sigs without waiting: from now on an arrival
// is kept for waitSignal instead of ending the process. A worker calls it
// first, so that a SIGTERM that comes before its first wait is not lost.
pub fn watchSignals(sigs: &[]int) { watchMask(sigMask(sigs)) }

// Parks until one of the signals sigs arrives (watching them from now on),
// and gives it; Err(Cancelled) when the task is cancelled, Err(Timeout) when
// the deadline of an enclosing within passes first.
pub fn waitSignal(sigs: &[]int, w: Where): Result[int, Cancelled] {
    let m = sigMask(sigs)
    watchMask(m)
    let r = rtSigWait(m, w.cstr())
    if r > 0 { return Ok(r) }
    return Err(if r == -1 { Cancelled.Cancelled } else { Cancelled.Timeout })
}

// waitSignal for SIGTERM or SIGINT: the request to stop that task.workers
// forwards to every worker (and that a terminal's Ctrl-C sends).
pub fn terminated(w: Where): Result[int, Cancelled] {
    let sigs = [SIGTERM, SIGINT]
    return waitSignal(&sigs, w)
}

// ---- worker processes (stage C2)
//
// workers(n, f) forks n processes, each running f(i) (i: 0..n-1) and then
// ending, and supervises them until they have all ended. It is the way a
// program uses several cores: the workers share nothing but what was made
// before the fork (copy-on-write) and what they reach outside (a database,
// a listener made before the call). See SPEC 16.

extern "c" fn rtWorkersBegin(w: ptr) as "obxlib_workers_begin"
extern "c" fn rtWorkersEnd() as "obxlib_workers_end"
extern "c" fn rtFork(): int as "obxlib_proc_fork"
extern "c" fn rtProcWait(ms: int, status: mut &int): int as "obxlib_proc_wait"
extern "c" fn rtKill(pid: int, sig: int): int as "obxlib_proc_kill"
extern "c" fn rtWorkerExit(code: int) as "obxlib_worker_exit"
extern "c" fn rtWorkerStop(): int as "obxlib_worker_stop"
extern "c" fn clockNs(which: int): int as "obx_clock_ns"

const SIGKILL = 9

// How a worker ended (the last process that ran it).
pub type WorkerEnd = value record {
    pub index: int      // 0..n-1, as f was given it
    pub pid: int
    pub code: int       // its exit code, or -1 when a signal ended it
    pub signal: int     // the signal that ended it, or 0
    pub drained: bool   // it ended after the supervisor asked the workers to stop
    pub restarts: int   // how many times it was started again after a crash
}

// "worker 2 (pid 4711): exit 0, drained, 1 restart"
pub fn (e: WorkerEnd) toStr(): str {
    var s = "worker " + intToStr(e.index) + " (pid " + intToStr(e.pid) + "): "
    if e.signal != 0 { s = s + "signal " + intToStr(e.signal) } else { s = s + "exit " + intToStr(e.code) }
    if e.drained { s = s + ", drained" }
    if e.restarts == 1 { s = s + ", 1 restart" }
    if e.restarts > 1 { s = s + ", " + intToStr(e.restarts) + " restarts" }
    return s
}

// When the supervisor restarts a crashed worker, and when it gives up. A
// crash is a worker that a signal ended, or that exited with a code other
// than 0, while the supervisor had not asked the workers to stop.
pub type WorkerPolicy = value record {
    pub maxCrashes: int     // more crashes than this within windowMs (all workers together): give up
    pub windowMs: int
    pub backoffMs: int      // the wait before a restart; doubled for each crash in a row of one worker
    pub maxBackoffMs: int   // (a run that lasted windowMs ends the row), up to this
    pub drainMs: int        // after the stop signal, how long before SIGKILL; 0: no limit
}

// The defaults: more than 5 crashes in 10 s gives up; restarts after 100 ms,
// 200, 400, ... up to 5 s; the drain has no time limit (a second SIGTERM or
// SIGINT sends SIGKILL).
pub fn workerPolicy(): WorkerPolicy {
    return WorkerPolicy{maxCrashes: 5, windowMs: 10000, backoffMs: 100, maxBackoffMs: 5000, drainMs: 0}
}

// workers' error: the workers crashed too often, so the supervisor stopped
// restarting them, asked the others to stop (SIGTERM) and waited for them.
pub type GaveUp = record {
    pub crashes: int        // within the policy's window
    pub ends: []WorkerEnd
}

pub fn (g: &GaveUp) toStr(): str {
    return "workers: gave up after " + intToStr(g.crashes) + " crashes"
}

// A worker's state in the supervisor.
type Slot = value record {
    pid: int            // the running process, or 0
    started: int        // when it was started (ms)
    streak: int         // its crashes in a row
    restartAt: int      // when to start it again (ms), or -1
    done: bool          // ended, not to be started again
    end: WorkerEnd
}

fn nowMs(): int { return clockNs(1) / 1000000 }

// workersWith(n, workerPolicy(), f).
pub fn workers(n: int, f: &fn(int), w: Where): Result[[]WorkerEnd, GaveUp] {
    return workersWith(n, workerPolicy(), f, w)
}

// Forks n worker processes; worker i runs f(i) and then ends (exit 0; a
// panic or other runtime error ends it with its exit code, as a program).
// The calling process supervises them until all have ended:
//
// - a worker that crashes (a signal or a code other than 0) is started again
//   after p's backoff, unless the workers crashed more than p.maxCrashes
//   times within p.windowMs: then the others are asked to stop and workers
//   gives Err(GaveUp) once they have;
// - SIGTERM or SIGINT to the supervisor is forwarded to every worker (a
//   graceful drain: a worker that watches it with terminated() finishes its
//   work and returns; one that does not is ended by it), no worker is
//   started again, and after p.drainMs (when > 0) or a second signal the
//   workers left get SIGKILL; a worker asks for this with stopWorkers()
//   (asking twice, or from several workers, is one request);
// - workers returns, with how each ended, when all have ended.
//
// It stops the program (exit 15) when it cannot fork safely: after the
// helper pool has started (threads), while other tasks exist, or while the
// event loop holds registrations (a socket in use, a signal watch). Make the
// listener before the call (one shared accept queue) or listen in each
// worker with net.listenReusePort; open database connections in the worker.
// Output written before the call is flushed first, so it appears once. The
// supervisor itself runs no task meanwhile. At its end a worker drops the
// program's globals, as main's end does; under OBX_CHECK=1 it then checks
// that the objects it made are freed.
pub fn workersWith(n: int, p: WorkerPolicy, f: &fn(int), w: Where): Result[[]WorkerEnd, GaveUp] {
    if n < 1 { panic("task.workers: n must be at least 1") }
    rtWorkersBegin(w.cstr())
    var slots: []Slot = []
    for i in 0..n {
        append(mut &slots, Slot{pid: 0, started: 0, streak: 0, restartAt: -1, done: false,
                                end: WorkerEnd{index: i, pid: 0, code: 0, signal: 0, drained: false, restarts: 0}})
    }
    var crashes: []int = []     // the times of the crashes within the window
    var stopping = false
    var gaveUp = false
    var killAt = -1             // when stopping: when to send SIGKILL (ms), or -1
    for i in 0..n { launch(mut &slots[i], f, mut &crashes, &p) }
    while true {
        var running = false
        var next = -1
        for i in 0..n {
            if slots[i].pid != 0 { running = true }
            if slots[i].restartAt >= 0 && (next < 0 || slots[i].restartAt < next) { next = slots[i].restartAt }
        }
        if !running && next < 0 { break }
        if killAt >= 0 && (next < 0 || killAt < next) { next = killAt }
        let ms = if next < 0 { -1 } else if next > nowMs() { next - nowMs() } else { 0 }
        var st = 0
        let r = rtProcWait(ms, mut &st)
        let now = nowMs()
        if r > 0 {
            for i in 0..n {
                if slots[i].pid == r {
                    slots[i].pid = 0
                    slots[i].end.pid = r
                    if (st & 0x7f) == 0 {
                        slots[i].end.code = (st >> 8) & 0xff
                        slots[i].end.signal = 0
                    } else {
                        slots[i].end.code = -1
                        slots[i].end.signal = st & 0x7f
                    }
                    if stopping {
                        slots[i].done = true
                        slots[i].end.drained = true
                    } else if slots[i].end.signal == 0 && slots[i].end.code == 0 {
                        slots[i].done = true
                    } else {
                        crashed(mut &slots[i], mut &crashes, &p, now)
                    }
                }
            }
        } else if r < 0 {
            // st: the sender. A worker's stopWorkers is a request to stop, never the second
            // signal that ends the drain (several workers may ask).
            var fromWorker = false
            for i in 0..n {
                if st != 0 && (slots[i].pid == st || slots[i].end.pid == st) { fromWorker = true }
            }
            if stopping && fromWorker {
                // already stopping
            } else if stopping {
                killAt = -1
                for i in 0..n {
                    if slots[i].pid != 0 { rtKill(slots[i].pid, SIGKILL) }
                }
            } else {
                stopping = true
                killAt = stopAll(mut &slots, -r, &p, now)
            }
        } else {
            if killAt >= 0 && now >= killAt {
                killAt = -1
                for i in 0..n {
                    if slots[i].pid != 0 { rtKill(slots[i].pid, SIGKILL) }
                }
            }
            for i in 0..n {
                if slots[i].restartAt >= 0 && now >= slots[i].restartAt {
                    slots[i].restartAt = -1
                    slots[i].end.restarts += 1
                    launch(mut &slots[i], f, mut &crashes, &p)
                }
            }
        }
        if !gaveUp && len(crashes) > p.maxCrashes {
            gaveUp = true
            stopping = true
            killAt = stopAll(mut &slots, SIGTERM, &p, nowMs())
        }
    }
    rtWorkersEnd()
    var ends: []WorkerEnd = []
    for i in 0..n { append(mut &ends, slots[i].end) }
    if gaveUp { return Err(GaveUp{crashes: len(crashes), ends: ends}) }
    return Ok(ends)
}

// Starts the worker of s. In the child: runs f and ends; never returns. A
// fork that fails (EAGAIN, ENOMEM) counts as a crash.
fn launch(s: mut &Slot, f: &fn(int), crashes: mut &[]int, p: &WorkerPolicy) {
    let pid = rtFork()
    if pid == 0 {
        f(s.end.index)
        rtWorkerExit(0)
    }
    s.started = nowMs()
    if pid < 0 {
        s.pid = 0
        s.end.code = -1
        s.end.signal = 0
        crashed(s, crashes, p, s.started)
        return
    }
    s.pid = pid
}

// A crash of s's worker at now: its time in the window, and its restart.
fn crashed(s: mut &Slot, crashes: mut &[]int, p: &WorkerPolicy, now: int) {
    var k = 0
    for i in 0..len(crashes) {
        if now - crashes[i] < p.windowMs {
            crashes[k] = crashes[i]
            k += 1
        }
    }
    while len(crashes) > k { let x = pop(crashes) }
    append(crashes, now)
    s.streak = if now - s.started >= p.windowMs { 1 } else { s.streak + 1 }
    var d = p.backoffMs
    for j in 1..s.streak {
        if d >= p.maxBackoffMs { break }
        d = d * 2
    }
    if d > p.maxBackoffMs { d = p.maxBackoffMs }
    s.restartAt = now + d
}

// Asks every worker to stop (sig: SIGTERM or SIGINT); no restart is pending
// any more. When to send SIGKILL, or -1.
fn stopAll(slots: mut &[]Slot, sig: int, p: &WorkerPolicy, now: int): int {
    for i in 0..len(slots) {
        if slots[i].pid != 0 { rtKill(slots[i].pid, sig) }
        if slots[i].restartAt >= 0 {
            slots[i].restartAt = -1
            slots[i].done = true
        }
    }
    return if p.drainMs > 0 { now + p.drainMs } else { -1 }
}

// In a worker: asks the supervisor to stop every worker, this one included
// (SIGTERM to the supervisor, which forwards it to all of them, as when the
// supervisor gets it from outside). Asking again, or from several workers,
// changes nothing: unlike a second signal from outside it never turns the
// drain into SIGKILL. False when this process is not a worker of
// task.workers.
pub fn stopWorkers(): bool { return rtWorkerStop() == 0 }
