// sqlserver: Microsoft SQL Server over its own protocol, TDS 7.4 (the `tds`
// module), written in obx: no driver, no helper threads. Every call that
// waits for the server parks only its task, as net's calls do.
//
//     var conn = try sqlserver.connect("Server=db.example.com;Database=app;UID=app;PWD=...")
//     try conn.exec("CREATE TABLE #t(id bigint, name nvarchar(50))")
//     let n = try conn.run("INSERT INTO #t VALUES (1, N'café'), (2, N'naïve')", &[])
//     let rows = try conn.query("SELECT id, name FROM #t ORDER BY id", &[])
//     for r in 0..rows.rowCount() {
//         println((try rows.int(r, 0)).toStr() + " " + try rows.text(r, 1))
//     }
//
// Stages T1 and T2 (design/tds.md): SQL authentication, encryption by TLS
// (inside PRELOGIN, as MS-TDS says), SQL batches; parameters @p1, @p2, ...
// through sp_executesql (query, run, queryAll, call with OUTPUT
// parameters); every result set and row count of a batch (queryAll); every
// ERROR of a call (errors(), the first is the Err) and its INFOs
// (diagnostics()); procedures' return status; transaction[T] by Transaction
// Manager requests. Types: tinyint, smallint, int, bigint, bit, real,
// float, decimal, numeric, money, smallmoney, nchar, nvarchar, char and
// varchar (a UTF-8 collation, code page 1252 or ISO-8859-1; another code
// page is an error naming it, when that cell is read), binary, varbinary,
// date, time, datetime2, datetimeoffset, datetime, smalldatetime,
// uniqueidentifier, xml, and their (max) forms. sql_variant, UDTs and table
// types are an E_TYPE error naming the type for their cells. Rows are read
// whole (no streaming); ATTENTION (cancelling a running call) and pools come
// in T3.
//
// Connection strings (design/tds.md, section 4) take the ADO.NET keywords
// and the ODBC ones that mssql is given, so one string serves both modules:
//
//   Server, Data Source, Address, Addr, Network Address   host, host,port, tcp:host,port ([::1],1433)
//   Database, Initial Catalog
//   UID, User Id, User                                     SQL authentication only
//   PWD, Password
//   Encrypt            yes, true, mandatory (the default): TLS for everything, or no connection;
//                      no, false, optional: TLS for the login, more if the server requires it;
//                      strict (TDS 8.0): not supported yet
//   TrustServerCertificate    yes: the certificate is not verified (tls's insecureSkipVerify)
//   HostNameInCertificate     the name to verify instead of the host
//   Connect Timeout, Connection Timeout, Timeout, LoginTimeout   seconds for the whole connect
//                      (15; 0 none)
//   Application Name, APP
//   Packet Size        512 to 32767 (4096)
//   Driver             ignored (for ODBC)
//
// Keys are case-insensitive; a value may be in braces ({a;b}, `}}` for `}`)
// or quotes. An unknown keyword is E_INPUT. Errors name the entry by its
// position, never by its text: they contain no value of the string.
//
// Errors are sqldialect.DbError. A server error has its error number as the
// code (208 "Invalid object name 'nope'.", 18456 "Login failed for user
// ..."), state "" and the server's message; the adapter's own are the E_*
// codes: E_IO (the socket or TLS: the server cannot be reached, its
// certificate is refused, it closed the connection), E_PROTOCOL, E_TIMEOUT
// and E_CANCELLED (the task's deadline or cancellation), E_INPUT, E_TYPE,
// E_NULL, E_LIMIT. A failure on the wire leaves the connection broken (no
// ATTENTION yet, stage T3): its later calls are E_IO, and idle() is false.

import "tds"
import "sqldialect"
import "strings"
import "task"
import "time"

pub type Value = sqldialect.Value
pub type Error = sqldialect.DbError
pub type Message = tds.Message
type Sql = sqldialect.Sql

var OPEN: int = 0

// The number of Conn values not yet closed or dropped.
pub fn openHandles(): int { return OPEN }

// ---------------------------------------------------------------- connection strings

// A parsed connection string: what tds.open needs, and the connect timeout.
pub type Settings = value record {
    pub config: tds.Config
    pub connectTimeoutMs: int     // 0: none
}

fn bad(msg: str): Error { return sqldialect.inputError("connection string: " + msg) }

// One keyword=value entry, and where the next one starts.
type Entry = value record { key: str; value: str; next: int }

// Settings from a connection string (above). E_INPUT for a malformed
// string, an unknown keyword, a value that is not valid for its keyword,
// or no Server or no user.
pub fn parseConnString(s: str): Result[Settings, Error] {
    var cfg = tds.Config{host: "", port: 1433, user: "", password: "", database: "", appName: "obx",
                         encrypt: tds.Encrypt.Mandatory, trustServerCertificate: false, hostNameInCertificate: "",
                         packetSize: tds.DEFAULT_PACKET}
    var timeout = 15000
    var server = ""
    var haveServer = false
    var haveUser = false
    var i = 0
    var nth = 0
    while i < len(s) {
        let c = s[i]
        if c == ';' || isSpace(c) {
            i += 1
            continue
        }
        nth += 1
        let kv = try entry(s, i, nth)
        i = kv.next
        let k = kv.key
        let v = kv.value
        match k {
            "server", "data source", "address", "addr", "network address" {
                server = v
                haveServer = true
            }
            "database", "initial catalog" { cfg.database = v }
            "uid", "user id", "user" {
                cfg.user = v
                haveUser = true
            }
            "pwd", "password" { cfg.password = v }
            "encrypt" {
                match strings.toLower(trim(v)) {
                    "yes", "true", "mandatory" { cfg.encrypt = tds.Encrypt.Mandatory }
                    "no", "false", "optional" { cfg.encrypt = tds.Encrypt.Optional }
                    "strict" { cfg.encrypt = tds.Encrypt.Strict }
                    else { return Err(bad("Encrypt must be yes, no, mandatory, optional or strict")) }
                }
            }
            "trustservercertificate", "trust server certificate" {
                cfg.trustServerCertificate = try yesNo(v, "TrustServerCertificate")
            }
            "hostnameincertificate", "host name in certificate" { cfg.hostNameInCertificate = trim(v) }
            "connect timeout", "connection timeout", "timeout", "logintimeout" {
                let n = try number(v, "Connect Timeout")
                if n > 2147483 { return Err(bad("Connect Timeout is too large")) }
                timeout = n * 1000
            }
            "application name", "app" { cfg.appName = v }
            "packet size" {
                let n = try number(v, "Packet Size")
                if n < tds.MIN_PACKET || n > tds.MAX_PACKET { return Err(bad("Packet Size must be 512 to 32767")) }
                cfg.packetSize = n
            }
            "trusted_connection", "integrated security" {
                if try yesNo(v, kv.key) { return Err(bad("integrated (Windows) authentication is not supported")) }
            }
            "driver" {}
            else { return Err(bad("an unknown keyword" + at(nth))) }
        }
    }
    if !haveServer || len(trim(server)) == 0 { return Err(bad("no Server")) }
    if !haveUser { return Err(bad("no UID (User Id): only SQL authentication is supported")) }
    try serverOf(trim(server), mut &cfg)
    return Ok(Settings{config: cfg, connectTimeoutMs: timeout})
}

// " (entry 3)": where an error is, without its text (a password with an
// unescaped ';' would make part of it a keyword).
fn at(nth: int): str { return " (entry " + nth.toStr() + ")" }

// The keyword (lower case, inner spaces single) and value at s[from..], the
// nth entry.
fn entry(s: str, from: int, nth: int): Result[Entry, Error] {
    var i = from
    var key = newStrBuf()
    var space = false
    while i < len(s) && s[i] != '=' {
        let c = s[i]
        if c == ';' || c == '{' || c == '}' { return Err(bad("a keyword without '='" + at(nth))) }
        if isSpace(c) {
            space = key.size() > 0
        } else {
            if space { key.addByte(' ') }
            space = false
            key.addByte(if c >= 'A' && c <= 'Z' { c + 32 } else { c })
        }
        i += 1
    }
    if i >= len(s) { return Err(bad("a keyword without '='" + at(nth))) }
    let k = key.toStr()
    if len(k) == 0 { return Err(bad("an empty keyword" + at(nth))) }
    i += 1
    while i < len(s) && (s[i] == ' ' || s[i] == '\t') { i += 1 }
    var v = newStrBuf()
    if i < len(s) && (s[i] == '{' || s[i] == '"' || s[i] == '\'') {
        let close = if s[i] == '{' { '}' } else { s[i] }
        i += 1
        var ended = false
        while i < len(s) {
            if s[i] == close {
                if i + 1 < len(s) && s[i + 1] == close {
                    v.addByte(close)
                    i += 2
                    continue
                }
                ended = true
                i += 1
                break
            }
            v.addByte(s[i])
            i += 1
        }
        if !ended { return Err(bad("a value in braces or quotes is not closed" + at(nth))) }
        while i < len(s) && isSpace(s[i]) { i += 1 }
        if i < len(s) && s[i] != ';' { return Err(bad("text after a value in braces or quotes" + at(nth))) }
        return Ok(Entry{key: k, value: v.toStr(), next: i})
    }
    let start = i
    while i < len(s) && s[i] != ';' { i += 1 }
    return Ok(Entry{key: k, value: trim(s[start..i]), next: i})
}

fn yesNo(v: str, what: str): Result[bool, Error] {
    match strings.toLower(trim(v)) {
        "yes", "true", "1", "sspi" { return Ok(true) }
        "no", "false", "0" { return Ok(false) }
        else { return Err(bad(what + " must be yes or no")) }
    }
}

fn number(v: str, what: str): Result[int, Error] {
    match strings.parseInt(trim(v)) {
        Ok(n) {
            if n < 0 { return Err(bad(what + " must be a number of 0 or more")) }
            return Ok(n)
        }
        Err(_) { return Err(bad(what + " must be a number")) }
    }
}

// Server's value: [tcp:]host[\instance][,port].
fn serverOf(v: str, cfg: mut &tds.Config): Result[Unit, Error] {
    var s = v
    let low = strings.toLower(s)
    if startsWith(low, "tcp:") {
        s = s[4..]
    } else if startsWith(low, "np:") || startsWith(low, "lpc:") || startsWith(low, "admin:") {
        return Err(bad("only TCP servers are supported"))
    }
    var port = -1
    let comma = strings.lastIndexOf(s, ",")
    if comma >= 0 {
        port = try number(s[comma + 1..], "the server's port")
        if port < 1 || port > 65535 { return Err(bad("the server's port must be 1 to 65535")) }
        s = trim(s[..comma])
    }
    if startsWith(low, "(localdb)") { return Err(bad("LocalDB is not supported")) }
    let slash = strings.indexOfByte(s, '\\', 0)
    if slash >= 0 {
        if port < 0 { return Err(bad("a named instance needs SQL Server Browser, which is not supported: give the port (host,port)")) }
        s = s[..slash]
    }
    if len(s) > 1 && s[0] == '[' && s[len(s) - 1] == ']' { s = s[1..len(s) - 1] }
    let ls = strings.toLower(s)
    if ls == "." || ls == "(local)" { s = "localhost" }
    if len(s) == 0 { return Err(bad("no host in Server")) }
    cfg.host = s
    if port > 0 { cfg.port = port }
    return Ok(Unit{})
}

// The connection string with the values of PWD and Password replaced by
// "***", for messages and logs.
pub fn masked(s: str): str {
    var out = newStrBuf()
    var i = 0
    while i < len(s) {
        let c = s[i]
        if c == ';' || isSpace(c) {
            out.addByte(c)
            i += 1
            continue
        }
        match entry(s, i, 0) {
            Ok(kv) {
                let eq = strings.indexOfByte(s, '=', i)
                out.add(s[i..eq + 1])
                if kv.key == "pwd" || kv.key == "password" { out.add("***") } else { out.add(s[eq + 1..kv.next]) }
                i = kv.next
            }
            Err(_) {
                out.add("***")                 // the rest cannot be parsed: hide it
                i = len(s)
            }
        }
    }
    return out.toStr()
}

// ---------------------------------------------------------------- connections

// A connection: owns its socket, closed when dropped (closing never parks).
// One task uses it at a time; every call that waits parks only that task.
pub type Conn = record { s: tds.Session }

fn (c: mut &Conn) drop() { OPEN -= 1 }

// Connects and logs in, within the string's Connect Timeout (E_TIMEOUT when
// it passes) and the task's own deadline.
pub fn connect(connStr: str, w: Where): Result[Conn, Error] {
    let st = try parseConnString(connStr)
    return connectWith(&st, w)
}

// connect with settings already parsed.
pub fn connectWith(st: &Settings, w: Where): Result[Conn, Error] {
    let cfg = st.config
    let r = if st.connectTimeoutMs > 0 {
        task.within(st.connectTimeoutMs, fn(): Result[tds.Session, Error] { return tds.open(&cfg, w) })
    } else {
        tds.open(&cfg, w)
    }
    match move(r) {
        Ok(s) {
            OPEN += 1
            return Ok(Conn{s: s})
        }
        Err(e) {
            if e.code == sqldialect.E_TIMEOUT { return Err(sqldialect.dbError(e.code, "connect: the deadline or Connect Timeout passed")) }
            return Err(e)
        }
    }
}

// Closes the connection (dropping it does the same).
pub fn (c: Conn) close() {}

// "16.0.4135" (LOGINACK's version).
pub fn (c: &Conn) serverVersion(): str { return c.s.serverVersion }

// The current database (ENVCHANGE).
pub fn (c: &Conn) database(): str { return c.s.database }

// "full", "login only" or "off".
pub fn (c: &Conn) encryption(): str { return c.s.encryption.toStr() }

// The TDS version the server speaks: 0x74000004 for 7.4.
pub fn (c: &Conn) tdsVersion(): int { return c.s.tdsVersion }

pub fn (c: &Conn) packetSize(): int { return c.s.packetSize() }

// The database's default collation (ENVCHANGE at login and after USE).
pub fn (c: &Conn) collation(): tds.Collation { return c.s.collation }

// Whether a transaction is open.
pub fn (c: &Conn) inTransaction(): bool { return c.s.inTransaction() }

// Whether the connection can take the next request: not broken, outside a
// transaction (what a pool keeps).
pub fn (c: &Conn) idle(): bool { return !c.s.broken && !c.s.inTransaction() }

// The INFO messages of the last call (connect's "Changed database context
// to ...", PRINT, RAISERROR with severity 10 or less).
pub fn (c: &Conn) diagnostics(): []Message {
    var out: []Message = []
    for m in c.s.infos { append(mut &out, m) }
    return out
}

// The largest reply a call may read, in bytes (tds.MAX_REPLY, 256 MiB): a
// larger one is E_LIMIT and breaks the connection.
pub fn (c: mut &Conn) setMaxReply(n: int) { c.s.maxReply = max(n, 4096) }

// The ERROR messages of the last call, every one (the call's Err is the
// first): number, state, class (severity), text, server, procedure, line.
pub fn (c: &Conn) errors(): []Message {
    var out: []Message = []
    for m in c.s.errors { append(mut &out, m) }
    return out
}

// The session's language (ENVCHANGE): "us_english".
pub fn (c: &Conn) language(): str { return c.s.language }

// The reply of one request, its first ERROR as the Err.
fn checked(r: tds.Reply): Result[tds.Reply, Error] {
    if len(r.errors) > 0 { return Err(tds.serverError(&r.errors[0])) }
    return Ok(r)
}

// An output parameter of call: its name ("@total") and its SQL type
// ("int", "decimal(12,2)", "nvarchar(100)", "nvarchar(max)", "datetime2(7)",
// ...; the names tds.typeInfoOf knows). It goes in as NULL.
pub type Out = value record { pub name: str; pub sqlType: str }

// The type a NULL parameter is declared as: NULL carries no type. nvarchar
// converts implicitly to every type a value can be stored in or compared
// with except binary and varbinary (error 257); for those, write
// CONVERT(varbinary(10), @p1) in the SQL text. (Asking the server for the
// type, as ODBC's SQLDescribeParam does through
// sp_describe_undeclared_parameters, fails for temporary tables and for a
// parameter used twice, and its error rolls back an open transaction under
// XACT_ABORT ON: it is not done.)
pub const NULL_TYPE = "nvarchar(4000)"

// The RPC parameter for v, named name.
fn paramOf(v: &Value, name: str, coll: &tds.Collation): Result[tds.Param, Error] {
    var p = match v {
        Value.Null { try tds.nullParam(NULL_TYPE, coll) }
        Value.Int(n) { tds.intParam(n) }
        Value.Float(f) { try tds.floatParam(f) }
        Value.Bool(b) { tds.bitParam(b) }
        Value.Text(t) { try tds.textParam(t, coll) }
        Value.Bytes(b) { tds.bytesParam(b) }
        Value.Dec(d) { try tds.decimalParam(d) }
    }
    p.name = name
    return Ok(p)
}

// Sends sql: as a SQL batch without parameters or outputs, else through
// sp_executesql with args as @p1, @p2, ... and the outputs after them.
fn (c: mut &Conn) send(sql: str, args: &[Value], outs: &[Out], w: Where): Result[tds.Reply, Error] {
    if len(args) == 0 && len(outs) == 0 { return checked(try c.s.batch(sql, w)) }
    if len(args) + len(outs) > tds.MAX_PARAMS {
        return Err(sqldialect.inputError("more than " + tds.MAX_PARAMS.toStr() + " parameters"))
    }
    var ps: []tds.Param = []
    for i in 0..len(args) { append(mut &ps, try paramOf(&args[i], "@p" + (i + 1).toStr(), &c.s.collation)) }
    for o in outs {
        if !tds.validParamName(&o.name) {
            return Err(sqldialect.inputError("an output parameter's name must be @ and 1 to 127 letters, digits or _ @ # $"))
        }
        var p = try tds.nullParam(o.sqlType, &c.s.collation)
        p.name = o.name
        p.output = true
        append(mut &ps, p)
    }
    var r = try c.s.executeSql(sql, &ps, w)
    // sp_executesql's own RETURNSTATUS (0) comes last: it is not the SQL's
    if len(r.statuses) > 0 {
        let n = len(r.statuses) - 1
        let own = r.statuses[n]
        var rest: []int = []
        for i in 0..n { append(mut &rest, r.statuses[i]) }
        r.statuses = rest
        r.returnStatus = if n > 0 { Some(r.statuses[n - 1]) } else { None }
    }
    return checked(r)
}

// Runs a batch of any number of statements, without parameters. Its first
// error is the result; every error is in errors() (the statements after an
// error may have run: SQL Server goes on after most errors in a batch).
pub fn (c: mut &Conn) exec(sql: str, w: Where): Result[Unit, Error] {
    let r = try c.send(sql, &[], &[], w)
    return Ok(Unit{})
}

// Runs sql with @p1, @p2, ... bound to args, in order (through
// sp_executesql; without args, as a SQL batch), and returns its first result
// set with columns, every row read (Rows do not hold the connection).
//
// Parameters: Int is sent as bigint, Float as float (exact), Bool as bit,
// Text as nvarchar(4000) (nvarchar(max) beyond 4,000 UTF-16 units), Bytes
// as varbinary(8000) (varbinary(max) beyond), Dec as decimal(p, s) from the
// value, NULL as NULL_TYPE. Dates go in as text, which the server converts.
pub fn (c: mut &Conn) query(sql: str, args: &[Value], w: Where): Result[Rows, Error] {
    var r = try c.send(sql, args, &[], w)
    let sets = len(r.results)
    if sets == 0 { return Ok(Rows{cols: [], rows: [], affected: r.affected, sets: 0}) }
    let first = replace(mut &r.results[0], tds.ResultSet{columns: [], rows: [], count: -1})
    let tds.ResultSet{columns: cols, rows: rows, count: _} = move(first)
    return Ok(Rows{cols: cols, rows: rows, affected: r.affected, sets: sets})
}

pub fn (c: mut &Conn) querySql(q: &Sql, w: Where): Result[Rows, Error] {
    return c.query(q.render(sqldialect.Dialect.SqlServer), q.args(), w)
}

// Runs sql (with parameters as query): the rows changed by its last
// statement that has no result set, -1 when none says.
pub fn (c: mut &Conn) run(sql: str, args: &[Value], w: Where): Result[int, Error] {
    let r = try c.send(sql, args, &[], w)
    return Ok(r.affected)
}

// What a batch gave: every result set, every statement's row count, the
// return status of a procedure it ran, and output parameters.
pub type Results = record {
    pub sets: []Rows                    // every result set with columns, in order
    pub counts: []StatementCount        // every row count, in order: of result sets and of changes
    pub returnStatus: Option[int]       // the last RETURNSTATUS of a procedure a batch ran (EXEC); with
                                        // parameters (sp_executesql) the server does not send it: write
                                        // EXEC @r = p ... with an Out "@r"
    pub outputs: Rows                   // call's output parameters: one row, a column each (named as the parameter)
}

pub type StatementCount = tds.StatementCount

// Runs sql (with parameters as query) and returns every result set and
// every row count.
pub fn (c: mut &Conn) queryAll(sql: str, args: &[Value], w: Where): Result[Results, Error] {
    return c.call(sql, args, &[], w)
}

// queryAll with output parameters: outs are declared OUTPUT after args, the
// SQL sets them (SET @total = ..., EXEC p @x OUTPUT), and they come back in
// Results.outputs, in the order the server sends them.
pub fn (c: mut &Conn) call(sql: str, args: &[Value], outs: &[Out], w: Where): Result[Results, Error] {
    var r = try c.send(sql, args, outs, w)
    var sets: []Rows = []
    for k in 0..len(r.results) {
        let rs = replace(mut &r.results[k], tds.ResultSet{columns: [], rows: [], count: -1})
        let tds.ResultSet{columns: cols, rows: rows, count: n} = move(rs)
        append(mut &sets, Rows{cols: cols, rows: rows, affected: n, sets: 1})
    }
    var counts: []StatementCount = []
    let rpc = len(args) > 0 || len(outs) > 0
    for x in r.counts {
        if !(rpc && x.token == tds.TK_DONEPROC) { append(mut &counts, x) }
    }
    var ocols: []tds.Column = []
    var orow: []tds.Cell = []
    for v in r.returnValues {
        if v.status == 1 {
            append(mut &ocols, v.column)
            append(mut &orow, v.value)
        }
    }
    let outputs = Rows{cols: ocols, rows: if len(ocols) > 0 { [orow] } else { [] }, affected: -1, sets: 0}
    return Ok(Results{sets: sets, counts: counts, returnStatus: r.returnStatus, outputs: outputs})
}

// ---------------------------------------------------------------- transactions

// Runs body in a transaction: begins one (a Transaction Manager request; the
// server's descriptor goes with every request after it), then commits when
// body returns Ok and rolls back when it returns Err, whose error is the
// result. body gets the connection: obx lets one place change it at a time.
// Transactions do not nest (E_INPUT). When the server has ended the
// transaction itself (an error that dooms it, XACT_ABORT, a COMMIT or
// ROLLBACK in the SQL), there is nothing to roll back; an Ok from body is
// then E_INPUT, as nothing was committed. After a rollback for an error the
// connection is usable.
pub fn (c: mut &Conn) transaction[T](body: &fn(mut &Conn): Result[T, Error], w: Where): Result[T, Error] {
    if c.inTransaction() { return Err(sqldialect.inputError("a transaction is already open")) }
    let b = try checked(try c.s.transact(tds.TM_BEGIN_XACT, w))
    if !c.inTransaction() { return Err(sqldialect.dbError(sqldialect.E_PROTOCOL, "tds: BEGIN gave no transaction descriptor")) }
    match body(c) {
        Ok(v) {
            if !c.inTransaction() {
                return Err(sqldialect.inputError("the transaction ended inside the body: nothing was committed"))
            }
            let r = try checked(try c.s.transact(tds.TM_COMMIT_XACT, w))
            return Ok(v)
        }
        Err(e) {
            if c.inTransaction() && !c.s.broken {
                let errs = replace(mut &c.s.errors, [])
                let infos = replace(mut &c.s.infos, [])
                let r = c.s.transact(tds.TM_ROLLBACK_XACT, w)
                c.s.errors = errs               // the body's messages, not the rollback's
                c.s.infos = infos
            }
            return Err(e)
        }
    }
}

// ---------------------------------------------------------------- rows

// A result in client memory.
pub type Rows = record {
    cols: []tds.Column
    rows: [][]tds.Cell
    affected: int
    sets: int
}

pub fn (r: &Rows) rowCount(): int { return len(r.rows) }

pub fn (r: &Rows) columnCount(): int { return len(r.cols) }

// From query and run: rows changed by the batch's last statement without a
// result set, or -1. In Results.sets: the result set's own row count (its
// DONE), or -1.
pub fn (r: &Rows) affected(): int { return r.affected }

// The number of result sets with columns the batch gave (query keeps only
// the first: queryAll has them all).
pub fn (r: &Rows) resultSets(): int { return r.sets }

fn (r: &Rows) col(col: int): Result[int, Error] {
    if col < 0 || col >= len(r.cols) {
        return Err(sqldialect.inputError("column " + col.toStr() + " out of range (" + len(r.cols).toStr() + " columns)"))
    }
    return Ok(col)
}

pub fn (r: &Rows) columnName(col: int): Result[str, Error] { return Ok(r.cols[try r.col(col)].name) }

// The column's TDS type code (tds.T_INTN, tds.T_NVARCHAR, ...).
pub fn (r: &Rows) columnType(col: int): Result[int, Error] { return Ok(r.cols[try r.col(col)].tdsType) }

// The column's SQL Server type name: "int", "nvarchar", "float", ...
pub fn (r: &Rows) columnTypeName(col: int): Result[str, Error] { return Ok(r.cols[try r.col(col)].typeName()) }

// The column's length in bytes (-1 for (max)).
pub fn (r: &Rows) columnSize(col: int): Result[int, Error] { return Ok(r.cols[try r.col(col)].size) }

pub fn (r: &Rows) column(col: int): Result[tds.Column, Error] { return Ok(r.cols[try r.col(col)]) }

pub type DecimalType = value record { pub precision: int; pub scale: int }

// The precision and scale of a decimal or numeric column (money: 19, 4;
// smallmoney: 10, 4); E_TYPE for another.
pub fn (r: &Rows) decimalType(col: int): Result[DecimalType, Error] {
    let c = r.cols[try r.col(col)]
    let t = c.tdsType
    if t == tds.T_DECIMAL || t == tds.T_DECIMALN || t == tds.T_NUMERIC || t == tds.T_NUMERICN {
        return Ok(DecimalType{precision: c.precision, scale: c.scale})
    }
    if t == tds.T_MONEY4 || (t == tds.T_MONEYN && c.size == 4) { return Ok(DecimalType{precision: 10, scale: 4}) }
    if t == tds.T_MONEY || t == tds.T_MONEYN { return Ok(DecimalType{precision: 19, scale: 4}) }
    return Err(typeError(col, "a decimal"))
}

fn (r: &Rows) cell(row: int, col: int): Result[tds.Cell, Error] {
    let k = try r.col(col)
    if row < 0 || row >= len(r.rows) {
        return Err(sqldialect.inputError("row " + row.toStr() + " out of range (" + len(r.rows).toStr() + " rows)"))
    }
    return Ok(r.rows[row][k])
}

fn typeError(col: int, want: str): Error {
    return sqldialect.dbError(sqldialect.E_TYPE, "column " + col.toStr() + " is not " + want)
}

fn nullError(col: int): Error { return sqldialect.dbError(sqldialect.E_NULL, "column " + col.toStr() + " is NULL") }

fn failed(col: int, why: str): Error { return sqldialect.dbError(sqldialect.E_TYPE, "column " + col.toStr() + ": " + why) }

pub fn (r: &Rows) isNull(row: int, col: int): Result[bool, Error] {
    match try r.cell(row, col) {
        tds.Cell.Null { return Ok(true) }
        else { return Ok(false) }
    }
}

// A tinyint, smallint, int, bigint or bit value.
pub fn (r: &Rows) int(row: int, col: int): Result[int, Error] {
    match try r.cell(row, col) {
        tds.Cell.Int(n) { return Ok(n) }
        tds.Cell.Null { return Err(nullError(col)) }
        tds.Cell.Failed(why) { return Err(failed(col, why)) }
        else { return Err(typeError(col, "an integer")) }
    }
}

// A bit (or an integer that is 0 or 1).
pub fn (r: &Rows) bool(row: int, col: int): Result[bool, Error] {
    let n = try r.int(row, col)
    if n != 0 && n != 1 { return Err(typeError(col, "a 0 or 1 boolean")) }
    return Ok(n == 1)
}

// A real or float (exact), or an integer that a float holds exactly.
pub fn (r: &Rows) float(row: int, col: int): Result[float, Error] {
    match try r.cell(row, col) {
        tds.Cell.Float(f) { return Ok(f) }
        tds.Cell.Int(n) {
            if n > 9007199254740992 || n < -9007199254740992 { return Err(typeError(col, "a float")) }
            return Ok(float(n))
        }
        tds.Cell.Null { return Err(nullError(col)) }
        tds.Cell.Failed(why) { return Err(failed(col, why)) }
        else { return Err(typeError(col, "a float")) }
    }
}

// The value as text: a text value as it is (NUL characters kept), an
// integer's or float's digits, a decimal with its column's scale, dates,
// times and uniqueidentifiers as SQL Server writes them (tds.cellText:
// "2026-11-05 13:45:07.1234567"). E_TYPE for a binary value.
pub fn (r: &Rows) text(row: int, col: int): Result[str, Error] {
    let c = try r.cell(row, col)
    match c {
        tds.Cell.Null { return Err(nullError(col)) }
        tds.Cell.Failed(why) { return Err(failed(col, why)) }
        else {}
    }
    match tds.cellText(&r.cols[col], &c) {
        Some(t) { return Ok(t) }
        None { return Err(typeError(col, "text")) }
    }
}

// The exact bytes of a binary value, or the UTF-8 bytes of a text value
// (and of a uniqueidentifier's text).
pub fn (r: &Rows) bytes(row: int, col: int): Result[str, Error] {
    match try r.cell(row, col) {
        tds.Cell.Bytes(b) { return Ok(b) }
        tds.Cell.Text(t) { return Ok(t) }
        tds.Cell.Guid(g) { return Ok(g) }
        tds.Cell.Null { return Err(nullError(col)) }
        tds.Cell.Failed(why) { return Err(failed(col, why)) }
        else { return Err(typeError(col, "binary or text")) }
    }
}

// A decimal, numeric, money or smallmoney value as an exact Decimal with the
// column's scale as its display scale (money's is 4), or an integer (scale
// 0). E_INEXACT for float and real, E_TYPE otherwise.
pub fn (r: &Rows) decimal(row: int, col: int): Result[Decimal, Error] {
    match try r.cell(row, col) {
        tds.Cell.Dec(d) { return Ok(d) }
        tds.Cell.Int(n) { return Ok(decimalOf(n)) }
        tds.Cell.Float(_) { return Err(sqldialect.dbError(sqldialect.E_INEXACT, "column " + col.toStr() + " is a binary float")) }
        tds.Cell.Null { return Err(nullError(col)) }
        tds.Cell.Failed(why) { return Err(failed(col, why)) }
        else { return Err(typeError(col, "a decimal")) }
    }
}

// None for NULL (never zero), otherwise as decimal().
pub fn (r: &Rows) decimalOrNull(row: int, col: int): Result[Option[Decimal], Error] {
    if try r.isNull(row, col) { return Ok(None) }
    return Ok(Some(try r.decimal(row, col)))
}

// A date value.
pub fn (r: &Rows) date(row: int, col: int): Result[time.Date, Error] {
    match try r.cell(row, col) {
        tds.Cell.Date(d) { return Ok(d) }
        tds.Cell.Null { return Err(nullError(col)) }
        tds.Cell.Failed(why) { return Err(failed(col, why)) }
        else { return Err(typeError(col, "a date")) }
    }
}

// A time(n) value.
pub fn (r: &Rows) timeOfDay(row: int, col: int): Result[time.TimeOfDay, Error] {
    match try r.cell(row, col) {
        tds.Cell.Time(t) { return Ok(t) }
        tds.Cell.Null { return Err(nullError(col)) }
        tds.Cell.Failed(why) { return Err(failed(col, why)) }
        else { return Err(typeError(col, "a time")) }
    }
}

// A datetime2(n), datetime or smalldatetime value (datetime's 1/300 s
// rounded to the millisecond, as the server writes it: see tds).
pub fn (r: &Rows) localDateTime(row: int, col: int): Result[time.LocalDateTime, Error] {
    match try r.cell(row, col) {
        tds.Cell.DateTime(l) { return Ok(l) }
        tds.Cell.Null { return Err(nullError(col)) }
        tds.Cell.Failed(why) { return Err(failed(col, why)) }
        else { return Err(typeError(col, "a datetime2, datetime or smalldatetime")) }
    }
}

// A datetimeoffset(n) value: its local date-time and offset.
pub fn (r: &Rows) offsetDateTime(row: int, col: int): Result[time.OffsetDateTime, Error] {
    match try r.cell(row, col) {
        tds.Cell.Offset(o) { return Ok(o) }
        tds.Cell.Null { return Err(nullError(col)) }
        tds.Cell.Failed(why) { return Err(failed(col, why)) }
        else { return Err(typeError(col, "a datetimeoffset")) }
    }
}

// The value by its column's type: Null, Bool (bit), Int, Float, Dec
// (decimal, numeric, money, smallmoney), Bytes (binary types) or Text (text
// types, xml; and dates, times and uniqueidentifiers as text() gives them).
pub fn (r: &Rows) value(row: int, col: int): Result[Value, Error] {
    let c = try r.cell(row, col)
    let t = r.cols[col].tdsType
    match c {
        tds.Cell.Null { return Ok(Value.Null) }
        tds.Cell.Int(n) { return Ok(if t == tds.T_BIT || t == tds.T_BITN { Value.Bool(n == 1) } else { Value.Int(n) }) }
        tds.Cell.Float(f) { return Ok(Value.Float(f)) }
        tds.Cell.Text(s) { return Ok(Value.Text(s)) }
        tds.Cell.Bytes(b) { return Ok(Value.Bytes(b)) }
        tds.Cell.Dec(d) { return Ok(Value.Dec(d)) }
        tds.Cell.Failed(why) { return Err(failed(col, why)) }
        else { return Ok(Value.Text(tds.cellText(&r.cols[col], &c).unwrapOr(""))) }
    }
}
