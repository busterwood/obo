// The same with the assignment and the read in different branches of an if in a loop.
// error: 's' is borrowed by 'v' and cannot be assigned
fn head(s: &str): &str { return s[0..2] }
fn main() {
    var s = intToStr(12) + "abcdefghijklmnopqrstuvwxyz"
    let v = head(&s)
    for i in 0..3 {
        if i == 1 { s = "x" } else { println(v) }
    }
}
