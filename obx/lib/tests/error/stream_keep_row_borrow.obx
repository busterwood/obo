// A row of the caller's buffer cannot be kept by borrow across the next fill, which writes
// the buffer (a copy, append(mut &list, buf[i]), can be kept: sqlserver_live_stream).
// error: 'buf' is borrowed by 'first' and cannot be mutably borrowed while that borrow is in scope
import "sqlserver"

type Error = sqlserver.Error
type Row = value record { id: int; name: str }

fn bindRow(c: &sqlserver.Columns): Result[int, Error] { return c.index("id", sqlserver.Kind.Int) }
fn readRow(b: &int, r: &sqlserver.RowView): Result[Row, Error] { return Ok(Row{id: try r.int(b), name: "x"}) }

fn run(c: mut &sqlserver.Conn): Result[int, Error] {
    var src = try c.stream("SELECT 1 AS id", [], bindRow, readRow)
    var buf = array(4, Row{id: 0, name: ""})
    let n = try src.fill(mut &buf)
    let first = &buf[0]
    let m = try src.fill(mut &buf)
    return Ok(first.id + m)
}

fn main() {}
