// borrow-class types (design/borrow-types.md): a value holding borrows cannot be sent to a task.
// error: V holds borrows, so it cannot be a type argument for type parameter A
import "task"
type V = value record { s: &str }
fn f(v: V): int { return len(v.s) }
fn main() {
    let s = "abc"
    let v = V{s: &s}
    task.scope(fn(sc: mut &task.Scope) {
        let x = sc.start(f, v)
    })
}
