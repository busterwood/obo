// The same for a value holding borrows: Some(&mk()) would hold a view of a dropped string.
// error: an if branch cannot give a borrow of a temporary
fn mk(): str { return intToStr(123456) + "abcdefghijklmnopqrstuvwxyz" }
fn show(o: Option[&str]) {
    match o { Some(y) { println(y) } None {} }
}
fn main() {
    let b = len(mk()) > 3
    show(if b { Some(&mk()) } else { None })
}
