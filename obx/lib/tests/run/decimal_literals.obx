// Fractional literals with exponents and full 38-digit precision (SPEC 7.3).
// expect: 1500
// expect: 0.0000002
// expect: 12.50
// expect: 99999999999999999999999999999999999999
// expect: 1.2345678901234567890123456789012345678
// expect: -0.000000000000000000000000000000000000001
// expect: 6020000000000000000000000
// expect: true
fn main() {
    println(1.5e3)
    println(2e-7)
    println(12.50)
    println(99999999999999999999999999999999999999e0)
    println(1.2345678901234567890123456789012345678)
    println(-1e-39)
    println(6.02e24)
    let a: Decimal = 1.0e2
    println(a == 100.00)
}
