// Fractional literals with exponents and full 38-digit precision (SPEC 7.3).
// expect: 1500
// expect: 0.0000002
// expect: 12.50
// expect: 99999999999999999999999999999999999999
// expect: 1.2345678901234567890123456789012345678
// expect: -0.000000000000000000000000000000000000001
// expect: 6020000000000000000000000
// expect: true
fn main() {
    println(1.5e3m)
    println(2e-7m)
    println(12.50m)
    println(99999999999999999999999999999999999999e0m)
    println(1.2345678901234567890123456789012345678m)
    println(-1e-39m)
    println(6.02e24m)
    let a: Decimal = 1.0e2m
    println(a == 100.00m)
}
