// task: with on a Shared value whose with is already open (through another
// handle to it) stops the program (exit 13).
// exit: 13
// expect: outer 1
import "task"

fn main() {
    let a = task.shared(1)
    let b = a
    a.with(fn(x: mut &int) {
        println("outer " + intToStr(x))
        b.with(fn(y: mut &int) { println("not reached") })
    })
}
