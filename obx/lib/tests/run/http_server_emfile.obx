// httpserver: out of descriptors (design/http-server.md 3.4, EMFILE). The
// server runs in one worker process with RLIMIT_NOFILE lowered, after
// serve has started, to a few descriptors above those it holds; the
// client, in another worker, opens 12 connections at once and sends a
// request on each. The server takes what its descriptors allow and serves
// them; then every accept fails with EMFILE, and each time the accept loop
// frees its spare descriptor, accepts one waiting connection, closes it at
// once and reserves the spare again (shed), so the queue drains and the
// loop does not spin: every other client sees its connection closed
// without a reply, none is left waiting. When the client closes its
// connections, the server has descriptors again and serves a new one.
// expect: served: at least one
// expect: closed without a reply: the rest
// expect: waiting: 0
// expect: after the clients closed: 200 bye
// expect: server: shed the unanswered ones: true
// expect: server: stopped, open 0
import "task"
import "net"
import "io"
import "fs"
import "strings"
import "httpserver" as http
import "../support/srvtest" as t
import "../support/srvrun" as sr

extern "c" fn open(path: str, flags: i32, mode: i32): i32
extern "c" fn close(fd: i32): i32
extern "c" fn setrlimit(res: i32, rl: &[]byte): i32
extern "c" fn getrlimit(res: i32, rl: mut &[]byte): i32

type App = value record { n: int }

fn ok(app: &App, rq: mut &http.Request, w: mut &http.Response): Result[Unit, http.Error] { return w.text("ok\n") }

fn routes(): http.Router[App] {
    var r = http.router[App]()
    r.handle("GET /", ok)
    r.handle("POST /stop", sr.stop[App])
    return r
}

const CONNS = 12

// The lowest free descriptor.
fn lowestFree(): int {
    let fd = open("/dev/null", 0, 0)
    let r = close(fd)
    return int(fd)
}

// Sets the soft RLIMIT_NOFILE to n (the hard limit stays).
fn limitFds(n: int) {
    var rl = array(16, byte(0))
    let g = getrlimit(i32(7), mut &rl)        // RLIMIT_NOFILE: {cur, max}, the hard limit kept
    var v = n
    for i in 0..8 {
        rl[i] = byte(v % 256)
        v = v / 256
    }
    if setrlimit(i32(7), &rl) != 0 { println("setrlimit failed") }
}

// Serves until /stop: "shed N, open N", or the error.
fn serveShed(j: sr.Job[App]): str {
    let sr.Job{ln: ln, app: app, r: r, cfg: cfg} = move(j)
    match http.serve(ln, app, r, cfg) {
        Ok(st) { return "shed " + intToStr(st.shed) + ", open " + intToStr(st.open) }
        Err(e) { return "error: " + e.toStr() }
    }
}

fn cfgSmall(): http.Config {
    var cfg = sr.config()
    cfg.maxConns = 64
    cfg.fdMargin = 0
    cfg.deferAccept = false
    return cfg
}

// The server's side: lower the limit once serve has its descriptors, then
// serve until /stop.
fn serverSide(listener: net.Listener) {
    var hold = Some(listener)
    let out = task.scoped(fn(s: mut &task.Scope): str {
        let srv = s.start(serveShed, sr.Job[App]{ln: replace(mut &hold, None).unwrap(), app: App{n: 0}, r: routes(), cfg: cfgSmall()})
        task.sleep(100).unwrap()
        limitFds(lowestFree() + 3)
        return srv.wait().unwrap()
    })
    io.write("emfile_server.txt", out).unwrap()
}

// One request on its own connection, kept open: its connection.
fn send(addr: str): Option[net.Conn] {
    match net.connect(addr) {
        Ok(c) {
            if c.writeStr("GET / HTTP/1.1\r\nHost: t\r\n\r\n").isErr() { return Some(c) }
            return Some(c)
        }
        Err(e) { return None }
    }
}

// What came back on c within 2 s: "reply", "closed" (no bytes, then the
// end or a reset) or "waiting".
fn outcome(c: &net.Conn): str {
    var buf = array(4096, byte(0))
    return task.within(2000, fn(): str {
        match c.read(mut &buf) {
            Ok(n) { return if n > 0 { "reply" } else { "closed" } }
            Err(e) { return if e.isTimeout() { "waiting" } else { "closed" } }
        }
    })
}

fn clientSide(addr: str) {
    task.sleep(400).unwrap()
    var conns: []net.Conn = []
    var refused = 0
    for i in 0..CONNS {
        match send(addr) {
            Some(c) { append(mut &conns, c) }
            None { refused += 1 }
        }
    }
    var served = 0
    var shut = 0
    var waiting = 0
    for c in conns {
        let o = outcome(&c)
        if o == "reply" { served += 1 } else if o == "closed" { shut += 1 } else { waiting += 1 }
    }
    var lines = "served: " + (if served >= 1 { "at least one" } else { "none" }) + "\n"
    lines = lines + "closed without a reply: " + (if served + shut == CONNS && refused == 0 { "the rest" } else { intToStr(shut) + " of " + intToStr(CONNS) + ", refused " + intToStr(refused) }) + "\n"
    lines = lines + "waiting: " + intToStr(waiting) + "\n"
    conns = []
    task.sleep(300).unwrap()
    var after = "no reply"
    for k in 0..5 {
        let g = t.talk(addr, "POST /stop HTTP/1.1\r\nHost: t\r\nContent-Length: 0\r\n\r\n", 3000)
        let rs = t.replies(&g)
        if len(rs) > 0 {
            after = intToStr(rs[0].code) + " " + strings.trimRight(rs[0].body)
            break
        }
        task.sleep(200).unwrap()
    }
    lines = lines + "after the clients closed: " + after + "\n"
    lines = lines + "unanswered " + intToStr(shut) + "\n"
    io.write("emfile_client.txt", lines).unwrap()
}

fn main() {
    for f in ["emfile_server.txt", "emfile_client.txt"] { let r = fs.remove(f) }
    var lst: Option[net.Listener] = Some(net.listen("127.0.0.1:0").unwrap())
    var addr = ""
    match &lst {
        Some(l) { addr = l.localAddr() }
        None {}
    }
    match task.workers(2, fn(i: int) {
        let ln = replace(mut &lst, None).unwrap()
        if i == 0 {
            serverSide(ln)
        } else {
            let l = ln                             // the client's copy of the listener: closed here
            clientSide(addr)
        }
    }) {
        Ok(ends) {}
        Err(g) { println(g.toStr()) }
    }
    let c = io.read("emfile_client.txt").unwrapOr("no client output\n")
    var unanswered = 0
    for line in strings.split(&c, "\n") {
        if startsWith(line, "unanswered ") { unanswered = strings.parseInt(line[11..len(line)]).unwrapOr(0) } else if len(line) > 0 { println(line) }
    }
    let s = io.read("emfile_server.txt").unwrapOr("no server output")
    var shed = -1
    if startsWith(s, "shed ") {
        let parts = strings.split(&s, ",")
        shed = strings.parseInt(parts[0][5..len(parts[0])]).unwrapOr(-1)
    }
    println("server: shed the unanswered ones: " + (if unanswered >= 1 && shed >= unanswered { "true" } else { "false (" + s + "; unanswered " + intToStr(unanswered) + ")" }))
    println("server: stopped, " + (if endsWith(s, "open 0") { "open 0" } else { s }))
}
