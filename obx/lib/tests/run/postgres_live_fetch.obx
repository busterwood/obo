// postgres's streams in fire hose mode against a live server ($OBX_PG_DSN,
// default the local socket; exits 77, skipped, when it cannot connect). The
// statement is sent once with no row limit (design/pgwire.md 12); the rows are
// read off the socket as the caller's buffer needs them, a batch at most 256 KB.
// Checked: narrow and wide rows through a buffer of 7 give the rows of the
// buffered query; a stream of a million rows closed early after 10 rows, then
// the connection used again; a stream dropped with rows still coming, then the
// connection used again; an error on row 500 (the rows before it first, then
// the error, the connection used after); and roundTrips(): 1 per stream.
// expect: narrow buffer 7: 200000 rows in 28572 fills, 1 round trip, sum 20000100000 names 1888895 | buffered: sum 20000100000 names 1888895 | same true
// expect: wide buffer 7: 3000 rows in 429 fills, 1 round trip, bytes 12000000 | buffered: bytes 12000000 | same true
// expect: short: 3 rows in 1 round trip
// expect: one row: 1 round trip | after: 2
// expect: early close after 10 of 1000000: 10 rows | after: 2 | again: 7 rows | after: 2
// expect: dropped in flight: 3 rows | after: 2
// expect: error on row 500: 499 rows then error 7 22012 | after: 2 | buffer 1000: 499 rows then error 7 22012 | after: 2
// expect: query round trips: 1
// expect: open handles: 0

import "postgres"
import "sqldialect"
import "os"

type Kind = postgres.Kind
type Error = postgres.Error
type Columns = postgres.Columns
type RowView = postgres.RowView

fn err[T: borrow](r: Result[T, Error]): str {
    match r {
        Ok(_) { return "ok" }
        Err(e) { return e.toStr() }
    }
}

type Narrow = value record { id: int; name: str }
type NarrowCols = value record { id: int; name: int }

fn bindNarrow(c: &Columns): Result[NarrowCols, Error] {
    return Ok(NarrowCols{id: try c.index("id", Kind.Int), name: try c.index("name", Kind.Text)})
}

fn readNarrow(b: &NarrowCols, r: &RowView): Result[Narrow, Error] {
    return Ok(Narrow{id: try r.int(b.id), name: try r.text(b.name)})
}

fn emptyNarrow(): Narrow { return Narrow{id: 0, name: ""} }

const NARROW = "SELECT i::int8 AS id, 'name' || i AS name FROM generate_series(1, 200000) i"
const MILLION = "SELECT i::int8 AS id, 'name' || i AS name FROM generate_series(1, 1000000) i"

type Wide = value record { id: int; wide: str }
type WideCols = value record { id: int; wide: int }

fn bindWide(c: &Columns): Result[WideCols, Error] {
    return Ok(WideCols{id: try c.index("id", Kind.Int), wide: try c.index("wide", Kind.Text)})
}

fn readWide(b: &WideCols, r: &RowView): Result[Wide, Error] {
    return Ok(Wide{id: try r.int(b.id), wide: try r.text(b.wide)})
}

fn emptyWide(): Wide { return Wide{id: 0, wide: ""} }

const WIDE = "SELECT i::int8 AS id, repeat('w', 4000) AS wide FROM generate_series(1, 3000) i"

// The narrow rows through a buffer of size: fills, the round trips of the
// stream, the sum of the ids and the characters of the names; then the same
// figures from the buffered query.
fn narrowRun(c: mut &postgres.Conn, size: int): Result[Unit, Error] {
    let r0 = c.roundTrips()
    var src = try c.stream(NARROW, [], bindNarrow, readNarrow)
    var buf = array(size, emptyNarrow())
    var fills = 0
    var sum = 0
    var chars = 0
    var rows = 0
    while true {
        let n = try src.fill(mut &buf)
        if n == 0 { break }
        fills += 1
        for o in buf[0..n] {
            rows += 1
            sum += o.id
            chars += len(o.name)
        }
    }
    try src.close()
    let trips = c.roundTrips() - r0
    let q = try c.query(NARROW, &[])
    var bsum = 0
    var bchars = 0
    for i in 0..q.rowCount() {
        bsum += try q.int(i, 0)
        bchars += len(try q.text(i, 1))
    }
    let same = bsum == sum && bchars == chars && q.rowCount() == rows
    println("narrow buffer " + size.toStr() + ": " + rows.toStr() + " rows in " + fills.toStr() + " fills, " + trips.toStr() +
            " round trip, sum " + sum.toStr() + " names " + chars.toStr() + " | buffered: sum " + bsum.toStr() + " names " + bchars.toStr() +
            " | same " + same.toStr())
    return Ok(Unit{})
}

fn wideRun(c: mut &postgres.Conn): Result[Unit, Error] {
    let r0 = c.roundTrips()
    var src = try c.stream(WIDE, [], bindWide, readWide)
    var buf = array(7, emptyWide())
    var fills = 0
    var bytes = 0
    var rows = 0
    while true {
        let n = try src.fill(mut &buf)
        if n == 0 { break }
        fills += 1
        for o in buf[0..n] {
            rows += 1
            bytes += len(o.wide)
        }
    }
    try src.close()
    let trips = c.roundTrips() - r0
    let q = try c.query(WIDE, &[])
    var bbytes = 0
    for i in 0..q.rowCount() { bbytes += len(try q.text(i, 1)) }
    println("wide buffer 7: " + rows.toStr() + " rows in " + fills.toStr() + " fills, " + trips.toStr() +
            " round trip, bytes " + bytes.toStr() + " | buffered: bytes " + bbytes.toStr() + " | same " + (bytes == bbytes).toStr())
    return Ok(Unit{})
}

fn bindFirst(c: &Columns): Result[int, Error] { return c.at(0, Kind.Int) }
fn readInt(b: &int, r: &RowView): Result[int, Error] { return r.int(b) }

fn short(c: mut &postgres.Conn): Result[Unit, Error] {
    let r0 = c.roundTrips()
    var src = try c.stream("SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3", [], bindFirst, readInt)
    var n = 0
    while (try src.next()).isSome() { n += 1 }
    try src.close()
    println("short: " + n.toStr() + " rows in " + (c.roundTrips() - r0).toStr() + " round trip")
    return Ok(Unit{})
}

fn after(c: mut &postgres.Conn): str {
    match c.query("SELECT 1 + 1", &[]) {
        Ok(r) { return r.int(0, 0).unwrap().toStr() }
        Err(e) { return e.toStr() }
    }
}

// One row of a stream, then closed: one round trip, and the connection used after.
fn one(c: mut &postgres.Conn): Result[Unit, Error] {
    let r0 = c.roundTrips()
    var src = try c.stream(NARROW, [], bindNarrow, readNarrow)
    let first = try src.next()
    try src.close()
    println("one row: " + (c.roundTrips() - r0).toStr() + " round trip | after: " + after(c))
    return Ok(Unit{})
}

// A million-row stream closed after 10 rows: the rest of its reply is read and
// dropped, so the connection is used again. A second one, through a buffer of 7.
fn early(c: mut &postgres.Conn): Result[Unit, Error] {
    var src = try c.stream(MILLION, [], bindNarrow, readNarrow)
    var buf = array(10, emptyNarrow())
    let n = try src.fill(mut &buf)
    try src.close()
    let a = after(c)
    var src2 = try c.stream(MILLION, [], bindNarrow, readNarrow)
    var buf2 = array(7, emptyNarrow())
    let m = try src2.fill(mut &buf2)
    try src2.close()
    println("early close after 10 of 1000000: " + n.toStr() + " rows | after: " + a + " | again: " + m.toStr() + " rows | after: " + after(c))
    return Ok(Unit{})
}

fn dropped(c: mut &postgres.Conn): Result[Unit, Error] {
    var n = 0
    if true {
        var src = try c.stream(NARROW, [], bindNarrow, readNarrow)
        for i in 0..3 { if (try src.next()).isSome() { n += 1 } }
    }
    println("dropped in flight: " + n.toStr() + " rows | after: " + after(c))
    return Ok(Unit{})
}

// An error on row 500 of a streamed query: the rows before it come first, then
// the error, the connection usable after; through a buffer of 7 and of 1000.
fn errorMid(c: mut &postgres.Conn): Result[Unit, Error] {
    let sql = "SELECT 1 / (n - 500) AS d FROM generate_series(1, 1000) n"
    var line = "error on row 500:"
    for size in [7, 1000] {
        var src = try c.stream(sql, [], bindFirst, readInt)
        var buf = array(size, 0)
        var rows = 0
        var msg = "none"
        while true {
            match src.fill(mut &buf) {
                Ok(n) {
                    if n == 0 { break }
                    rows += n
                }
                Err(e) {
                    msg = "error " + e.code.toStr() + " " + e.state
                    break
                }
            }
        }
        try src.close()
        let a = after(c)
        if size == 7 {
            line = line + " " + rows.toStr() + " rows then " + msg + " | after: " + a
        } else {
            line = line + " | buffer 1000: " + rows.toStr() + " rows then " + msg + " | after: " + a
        }
    }
    println(line)
    return Ok(Unit{})
}

fn trips(c: mut &postgres.Conn): Result[Unit, Error] {
    let r0 = c.roundTrips()
    let r = try c.query("SELECT 1", &[])
    println("query round trips: " + (c.roundTrips() - r0).toStr())
    return Ok(Unit{})
}

fn run(c: mut &postgres.Conn): Result[Unit, Error] {
    try narrowRun(c, 7)
    try wideRun(c)
    try short(c)
    try one(c)
    try early(c)
    try dropped(c)
    try errorMid(c)
    try trips(c)
    return Ok(Unit{})
}

fn main() {
    let dsn = os.envOr("OBX_PG_DSN", "host=/var/run/postgresql dbname=postgres connect_timeout=3")
    if true {
        let r = postgres.connect(dsn)
        if r.isErr() { exit(77) }
        var c = r.unwrap()
        match run(mut &c) {
            Ok(_) {}
            Err(e) { println("FAIL " + e.toStr()) }
        }
    }
    println("open handles: " + postgres.openHandles().toStr())
}
