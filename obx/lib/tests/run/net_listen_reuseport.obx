// net: listenReusePort lets two sockets listen on one port at once (each
// with SO_REUSEPORT; the kernel spreads new connections between them),
// where a second plain listen on the port fails with the address in use
// (EADDRINUSE, 98).
// One process here: each listener's task answers with its name; 40
// connections all get an answer. The other way to share an address,
// one listener made before task.workers, is in task_workers_listen.
// expect: plain second listen: address in use
// expect: 40 answers
import "task"
import "net"
import "io"

type Srv = record {
    ln: net.Listener
    name: str
}

fn serve(s: Srv): int {
    var n = 0
    while true {
        match s.ln.accept() {
            Ok(c) {
                c.writeStr(s.name).unwrap()
                n += 1
            }
            Err(e) { break }               // cancelled
        }
    }
    return n
}

fn main() {
    task.scope(fn(s: mut &task.Scope) {
        let a = net.listenReusePort("127.0.0.1:0").unwrap()
        let addr = a.localAddr()
        let b = net.listenReusePort(addr).unwrap()
        match net.listen(addr) {
            Ok(l) { println("plain second listen: allowed") }
            Err(e) { println("plain second listen: " + (if e.errno == 98 { "address in use" } else { e.toStr() })) }
        }
        let fa = s.start(serve, Srv{ln: a, name: "a"})
        let fb = s.start(serve, Srv{ln: b, name: "b"})
        var answers = 0
        for i in 0..40 {
            let c = net.connect(addr).unwrap()
            var buf = array(4, byte(0))
            let k = c.read(mut &buf).unwrap()
            if k == 1 { answers += 1 }
        }
        println(intToStr(answers) + " answers")
        // fa and fb are dropped: their accept loops are cancelled
    })
}
