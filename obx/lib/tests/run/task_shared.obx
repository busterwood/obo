// task: Shared is a counted copy handle; with gives the only access; tasks
// update one value between yields; with on different values nests; the value
// is dropped with the last handle (in a task or in main), and a long chain of
// Shared values is dropped without deep recursion.
// expect: count 30
// expect: log a0 b0 c0 a1 b1 c1
// expect: nested 7 70
// expect: drop held
// expect: handles gone
// expect: chain 100000
// expect: drop last in task
// expect: after scope
import "task"

type Note = record { s: str }

fn (n: mut &Note) drop() { println("drop " + n.s) }

type Counter = record {
    n: int
    log: []str
}

type Work = value record {
    c: task.Shared[Counter]
    name: str
}

fn bump(w: Work): int {
    for i in 0..2 {
        w.c.with(fn(c: mut &Counter) {
            c.n += 5
            append(mut &c.log, w.name + intToStr(i))
        })
        task.yield().unwrap()
    }
    return 0
}

type Node = record {
    v: int
    next: Option[task.Shared[Node]]
}

fn keep(sh: task.Shared[Note]): int {
    task.yield().unwrap()
    return 0
}

fn main() {
    let c = task.shared(Counter{n: 0, log: []})
    task.scope(fn(s: mut &task.Scope) {
        let a = s.start(bump, Work{c: c, name: "a"})
        let b = s.start(bump, Work{c: c, name: "b"})
        let d = s.start(bump, Work{c: c, name: "c"})
        let r = a.wait().unwrap() + b.wait().unwrap() + d.wait().unwrap()
    })
    c.with(fn(x: mut &Counter) {
        println("count " + intToStr(x.n))
        var line = "log"
        for e in x.log { line = line + " " + e }
        println(line)
    })

    let p = task.shared(7)
    let q = task.shared(70)
    p.with(fn(x: mut &int) {
        q.with(fn(y: mut &int) { println("nested " + intToStr(x) + " " + intToStr(y)) })
    })

    var hs: []task.Shared[Note] = []
    append(mut &hs, task.shared(Note{s: "held"}))
    for i in 0..3 { append(mut &hs, hs[0]) }
    while len(hs) > 0 { let h = pop(mut &hs) }
    println("handles gone")

    var head = task.shared(Node{v: 0, next: None})
    for i in 1..100000 {
        head = task.shared(Node{v: i, next: Some(head)})
    }
    var n = 0
    var cur: Option[task.Shared[Node]] = Some(head)
    while true {
        match cur {
            Some(h) {
                n += 1
                var nx: Option[task.Shared[Node]] = None
                h.with(fn(x: mut &Node) { nx = x.next })
                cur = nx
            }
            None { break }
        }
    }
    println("chain " + intToStr(n))

    task.scope(fn(s: mut &task.Scope) {
        let f = s.start(keep, task.shared(Note{s: "last in task"}))
        let r = f.wait()
    })
    println("after scope")
}
