// Decimal.parse: the strict text grammar, the kept display scale, the
// canonical exponent and the error precedence (ported from obo's
// tests/run/decimal_text_parse.obx).
// expect: 0.00
// expect: 0.012300
// expect: 1500
// expect: -1.2300
// expect: parse: 37 ok, 40 errors ok

var good: int = 0
var bad: int = 0

fn parseIs(s: str, dscale: int, exp: int) {
    match Decimal.parse(s) {
        Ok(d) {
            if d.scale() == dscale && d.exponent() == exp {
                good += 1
            } else {
                println("FAIL " + s + ": scale " + d.scale().toStr() + " exponent " + d.exponent().toStr())
            }
        }
        Err(e) { println("FAIL " + s + ": " + e.toStr()) }
    }
}

fn parseErr(s: str, code: int) {
    match Decimal.parse(s) {
        Ok(d) { println("FAIL " + s + ": parsed as " + d.toStr()) }
        Err(e) {
            if e.code() == code {
                bad += 1
            } else {
                println("FAIL " + s + ": code " + e.code().toStr())
            }
        }
    }
}

fn main() {
    println(Decimal.parse("-0.00").unwrap())
    println(Decimal.parse("1.2300e-2").unwrap())
    println(Decimal.parse("1.5e3").unwrap())
    println(Decimal.parse("-0001.2300").unwrap())

    parseIs("0", 0, 0)
    parseIs("0.00", 2, 0)
    parseIs("-0", 0, 0)
    parseIs("+0", 0, 0)
    parseIs("-0.00", 2, 0)
    parseIs("1", 0, 0)
    parseIs("+1", 0, 0)
    parseIs("-1", 0, 0)
    parseIs("0001.2300", 4, -2)
    parseIs("+1.2300", 4, -2)
    parseIs("-1.2300", 4, -2)
    parseIs("1.2300", 4, -2)
    parseIs("0.001", 3, -3)
    parseIs("1e3", 0, 3)
    parseIs("1E+3", 0, 3)
    parseIs("1e+003", 0, 3)
    parseIs("1e0003", 0, 3)
    parseIs("1e-0003", 3, -3)
    parseIs("1.2300e3", 1, 1)
    parseIs("1.2300e-2", 6, -4)
    parseIs("1e32767", 0, 32767)
    parseIs("1e32768", 0, 32768)
    parseIs("1e32804", 0, 32804)
    parseIs("1e-32768", 32768, -32768)
    parseIs("1e-16383", 16383, -16383)
    parseIs("1e-16384", 16384, -16384)
    parseIs("1.0e-16383", 16384, -16383)
    parseIs("1000e-16384", 16384, -16381)
    parseIs("0e999999", 0, 0)
    parseIs("0e-32769", 32769, 0)
    parseIs("0e-65535", 65535, 0)
    parseIs("-0e-32769", 32769, 0)
    parseIs("99999999999999999999999999999999999999", 0, 0)
    // 38 significant digits followed by zeros, and a long zero fraction
    parseIs("12345678901234567890123456789012345678000", 0, 3)
    parseIs("1" + repeat("0", 60) + ".000", 3, 60)
    parseIs("0." + repeat("0", 65534) + "0", 65535, 0)
    parseIs("0000000000000000000000000000000000000000000001", 0, 0)

    parseErr("", 4)
    parseErr("+", 4)
    parseErr("-", 4)
    parseErr(".", 4)
    parseErr(".5", 4)
    parseErr("1.", 4)
    parseErr("1..2", 4)
    parseErr("1.2.3", 4)
    parseErr("1e", 4)
    parseErr("1e+", 4)
    parseErr("1e-", 4)
    parseErr("1e3.", 4)
    parseErr("1e3e4", 4)
    parseErr("++1", 4)
    parseErr("--1", 4)
    parseErr("+-1", 4)
    parseErr(" 1", 4)
    parseErr("1 ", 4)
    parseErr("1\t2", 4)
    parseErr("1_000", 4)
    parseErr("0x10", 4)
    parseErr("NaN", 4)
    parseErr("Inf", 4)
    parseErr("Infinity", 4)
    parseErr("-Infinity", 4)
    parseErr("1\0", 4)
    parseErr("\0", 4)
    parseErr("1\xc3\xa9", 4)
    parseErr("-.5", 4)
    parseErr("999999999999999999999999999999999999999", 7)
    parseErr("1234567890123456789012345678901234567891", 7)
    parseErr("1e32805", 8)
    parseErr("1e-32769", 8)
    parseErr("1e-65535", 8)
    parseErr("1e-65536", 9)
    parseErr("1e-70000", 9)
    parseErr("1.0e-70000", 9)
    parseErr("0e-70000", 9)
    parseErr("0e-65536", 9)
    parseErr("1e40000", 8)
    println("parse: " + good.toStr() + " ok, " + bad.toStr() + " errors ok")
}
