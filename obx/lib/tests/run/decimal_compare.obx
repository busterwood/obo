// Comparison and equality by value (1.0 == 1.00), hash consistent with eq,
// Decimals as Map keys and sorted; format and canonical text.
// expect: true false false true true true true true
// expect: true true true true true
// expect: 2 keys
// expect: 1.50 -> 3
// expect: -2.5 -0.25 0 0.1 1 1.5 100000000000000000000000000000000000000 1000000000000000000000000000000000000000
// expect: ok 1.440
// expect: err 3 1.2345
// expect: 38 0.000000000000000000000000000000000000005
// expect: 0.000
// expect: 0 -1 0 1
// expect: 2.5 2.50
// expect: err 3
// expect: 12.30 12.300 err 6
// expect: 0.1 0.30000000000000004
// expect: 1.5 -2.5
// expect: 12.34 21 0

fn d(s: str): Decimal { return Decimal.parse(s).unwrap() }

fn b(x: bool): str { return x.toStr() }

fn main() {
    println(b(1.0m == 1.00m) + " " + b(1.0m != 1.00m) + " " + b(1.0m < 1.00m) + " " + b(1.0m <= 1.00m) + " "
        + b(2.0m > 1.00m) + " " + b(-1.0m < 0.0m) + " " + b(0.0m == -0.00m) + " " + b(2.0m >= 2.00m))
    println(b(1.0m.hash() == 1.00m.hash()) + " " + b(d("1e2").hash() == 100.0m.hash()) + " "
        + b(d("-0").hash() == 0.000m.hash()) + " " + b(d("-1e-5") < d("-1e-6")) + " "
        + b(d("99999999999999999999999999999999999999") > d("9999999999999999999999999999999999999.9")))

    var m: Map[Decimal, int] = newMap()
    m.put(1.5m, 1)
    m.put(1.50m, 3)
    m.put(d("15e-1") + 0.0m, 3)
    m.put(-0.0m, 7)
    println(m.size().toStr() + " keys")
    println(1.50m.toStr() + " -> " + m.get(&1.5m).unwrap().toStr())

    var xs = [1.5m, d("1e39"), -2.5m, 0.1m, d("0"), d("1e38"), 1.00m, -0.25m]
    sort(mut &xs)
    var line = ""
    for x in xs { line += " " + x.canonical() }
    println(substr(line, 1, len(line)))

    // format is exact display text or DecError.Inexact; toStr falls back to canonical
    match (1.20m * 1.2m).format() {
        Ok(s) { println("ok " + s) }
        Err(e) { println("err") }
    }
    let p = d("1.2345")
    match p.withScale(2) {
        Ok(v) { println(v) }
        Err(e) { println("err " + e.code().toStr() + " " + p.toStr()) }
    }
    // a product whose scale is capped below its fraction digits shows canonical text
    let tiny = d("1e-38") * 0.5m
    println(tiny.scale().toStr() + " " + tiny.toStr())
    println(0.000m * d("1e30"))
    println(d("1234").exponent().toStr() + " " + (-1.5m).sign().toStr() + " " + 0.0m.sign().toStr() + " "
        + 3.0m.sign().toStr())
    println(2.5m.toStr() + " " + 2.5m.withScale(2).unwrap().toStr())
    match 2.55m.withScale(1) {
        Ok(v) { println(v) }
        Err(e) { println("err " + e.code().toStr()) }
    }
    let w = 12.3m
    var s = w.withScale(2).unwrap().toStr() + " " + w.withScale(3).unwrap().toStr()
    match w.withScale(-1) {
        Ok(v) { s += " " + v.toStr() }
        Err(e) { s += " err " + e.code().toStr() }
    }
    println(s)
    println(0.1m.toFloat().toStr() + " " + (0.1m.toFloat() + 0.2m.toFloat()).toStr())
    println(max(1.5m, 1.50m).toStr() + " " + min(-2.5m, 3.0m).toStr())
    println(Decimal.fromUnits(1234, 2).toStr() + " " + Decimal.fromInt(21).toStr() + " " + Decimal.zero().toStr())
}
