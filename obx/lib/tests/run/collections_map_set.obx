// Map with put/remove churn checked against a plain array model, owned keys
// and values (no leaks under OBX_CHECK), insertion-order iteration; Set
// operations; Heap order.
// expect: model ok after 20000 ops
// expect: one=1 two=2 three=3
// expect: after remove two: one three, got Some(2), again None
// expect: lists: a=[1, 2] b=[3]
// expect: words: the=3 cat=1 sat=1 on=1 mat=1
// expect: set 3 true false | 1 2 3 4 5 | 3 | 1 2 | subset true true
// expect: 1 2 3 5 8 13 | empty
// expect: alpha beta gamma
import "collections"

fn lists(m: &Map[str, []int]): str {
    var s = ""
    for i in 0..m.size() {
        if len(s) > 0 { s += " " }
        s += m.keyAt(i) + "=["
        var first = true
        for x in m.valAt(i) {
            if !first { s += ", " }
            s += x.toStr()
            first = false
        }
        s += "]"
    }
    return s
}

fn ints(xs: &[]int): str {
    var s = ""
    for x in xs {
        if len(s) > 0 { s += " " }
        s += x.toStr()
    }
    return s
}

fn main() {
    // churn: keys 0..499, values counted in a model array (-1 = absent)
    var m: Map[int, int] = newMap()
    var model = array(500, -1)
    var seed = 7
    var bad = 0
    for step in 0..20000 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        let k = seed / 7 % 500
        if seed % 3 == 0 {
            let got = m.remove(&k)
            if got.isSome() != (model[k] >= 0) { bad += 1 }
            if got.isSome() && got.unwrap() != model[k] { bad += 1 }
            model[k] = -1
        } else {
            m.put(k, step)
            model[k] = step
        }
    }
    var live = 0
    for k in 0..500 {
        if model[k] >= 0 {
            live += 1
            if m.getOr(&k, -2) != model[k] { bad += 1 }
        } else if m.has(&k) {
            bad += 1
        }
    }
    if live != m.size() { bad += 1 }
    // every entry is reachable by walking
    for i in 0..m.size() {
        if model[m.keyAt(i)] != m.valAt(i) { bad += 1 }
    }
    if bad == 0 { println("model ok after 20000 ops") }

    var w: Map[str, int] = newMap()
    w.put("one", 1)
    w.put("two", 2)
    w.put("three", 3)
    var s = ""
    for i in 0..w.size() { s += w.keyAt(i) + "=" + w.valAt(i).toStr() + " " }
    println(trim(s))
    let two = w.remove(&"two")
    let again = w.remove(&"two")
    var s2 = ""
    for k in w.keys() { s2 += k + " " }
    println("after remove two: " + trim(s2) + ", got " + two.toStr() + ", again " + again.toStr())

    // owned values: arrays in a map, grown in place, removed and dropped
    var ls: Map[str, []int] = newMap()
    ls.put("a", [1])
    ls.put("b", [3])
    ls.put("c", [7, 8])
    append(ls.atMut("a"), 2)
    ls.remove(&"c")
    println("lists: " + lists(&ls))

    var counts: Map[str, int] = newMap()
    for word in split("the cat sat on the mat the", ' ') {
        let n = counts.atOrPut(word, 0)
        n += 1
    }
    var cs = ""
    for i in 0..counts.size() { cs += counts.keyAt(i) + "=" + counts.valAt(i).toStr() + " " }
    println("words: " + trim(cs))

    var a = collections.setOf(&[1, 2, 3, 2, 1])
    let b = collections.setOf(&[3, 4, 5])
    let added = a.add(3)
    var line = "set " + a.size().toStr() + " " + a.has(&2).toStr() + " " + added.toStr() + " | "
    line += ints(&a.union(&b).sorted()) + " | " + ints(&a.intersect(&b).sorted()) + " | "
    line += ints(&a.minus(&b).sorted()) + " | subset "
    let ab = a.union(&b)
    line += a.isSubset(&ab).toStr() + " " + ab.eq(&collections.setOf(&[5, 4, 3, 2, 1])).toStr()
    println(line)

    var h: collections.Heap[int] = collections.newHeap()
    for x in [8, 3, 13, 1, 5, 2] { h.push(x) }
    var out: []int = []
    while !h.isEmpty() { append(mut &out, h.pop().unwrap()) }
    var tail = " | empty"
    if h.pop().isSome() { tail = " | not empty" }
    println(ints(&out) + tail)

    var hs: collections.Heap[str] = collections.newHeap()
    hs.push("gamma")
    hs.push("alpha")
    hs.push("beta")
    var names = ""
    while hs.size() > 0 {
        match hs.pop() {
            Some(n) { names += n + " " }
            None {}
        }
    }
    println(trim(names))
}
