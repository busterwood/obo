// std's string hash is SipHash-1-3 under a per-process key (std.obx, "keyed
// hashing"). sipHash13 against vectors computed with a reference
// implementation (key 00..0f, messages 00..i-1) and against Rust's
// DefaultHasher (SipHasher13, key 0); hashes of substrings; two processes get
// different hashes for the same string while Map iteration order is the same;
// a worker forked by task.workers keeps its supervisor's key; the other keyed
// hashes are consistent with eq.
// expect: vectors ok 64
// expect: rust vectors ok 20
// expect: substrings true true true
// expect: runs differ true
// expect: same order true
// expect: worker same key true
// expect: wide true true true true
// expect: ints true true
import "io"
import "task"

extern "c" fn system(cmd: str): i32

// SipHash-1-3, key 00 01 .. 0f, of the message 00 01 .. i-1
const V13: []u64 = [
    0xabac0158050fc4dc, 0xc9f49bf37d57ca93, 0x82cb9b024dc7d44d, 0x8bf80ab8e7ddf7fb,
    0xcf75576088d38328, 0xdef9d52f49533b67, 0xc50d2b50c59f22a7, 0xd3927d989bb11140,
    0x369095118d299a8e, 0x25a48eb36c063de4, 0x79de85ee92ff097f, 0x70c118c1f94dc352,
    0x78a384b157b4d9a2, 0x306f760c1229ffa7, 0x605aa111c0f95d34, 0xd320d86d2a519956,
    0xcc4fdd1a7d908b66, 0x9cf2689063dbd80c, 0x8ffc389cb473e63e, 0xf21f9de58d297d1c,
    0xc0dc2f46a6cce040, 0xb992abfe2b45f844, 0x7ffe7b9ba320872e, 0x525a0e7fdae6c123,
    0xf464aeb267349c8c, 0x45cd5928705b0979, 0x3a3e35e3ca9913a5, 0xa91dc74e4ade3b35,
    0xfb0bed02ef6cd00d, 0x88d93cb44ab1e1f4, 0x540f11d643c5e663, 0x2370dd1f8c21d1bc,
    0x81157b6c16a7b60d, 0x4d54b9e57a8ff9bf, 0x759f12781f2a753e, 0xcea1a3bebf186b91,
    0x2cf508d3ada26206, 0xb6101c2da3c33057, 0xb3f47496ae3a36a1, 0x626b57547b108392,
    0xc1d2363299e41531, 0x667cc1923f1ad944, 0x65704ffec8138825, 0x24f280d1c28949a6,
    0xc2ca1cedfaf8876b, 0xc2164bfc9f042196, 0xa16e9c9368b1d623, 0x49fb169c8b5114fd,
    0x9f3143f8df074c46, 0xc6fdaf2412cc86b3, 0x7eaf49d10a52098f, 0x1cf313559d292f9a,
    0xc44a30dda2f41f12, 0x36fae98943a71ed0, 0x318fb34c73f0bce6, 0xa27abf3670a7e980,
    0xb4bcc0db243c6d75, 0x23f8d852fdb71513, 0x8f035f4da67d8a08, 0xd89cd0e5b7e8f148,
    0xf6f4e6bcf7a644ee, 0xaec59ad80f1837f2, 0xc3b2f6154b6694e0, 0x9d199062b7bbb3a8]

// Rust's std::collections::hash_map::DefaultHasher::new() (SipHasher13 with
// key 0) after write(&[0, 1, .. i-1]), i = 0..19
const RUST: []u64 = [
    0xd1fba762150c532c, 0x68a914128e01e473, 0x010bac45c41e3669, 0x4d4c9a4a8ef6e0ad,
    0x7cc43f98813e4dbd, 0x5abe2169dff36275, 0xe3c25f87624f1cdb, 0x2f098ab0c751325a,
    0xead411e67ebe2eea, 0x75927f9d95124362, 0xaf9f77a65ab51a1d, 0xfe64ce8b6617fcff,
    0xa6baf4fb0f9fe1c2, 0xa0cf3211850f8e0d, 0x7f86049379fbfe67, 0xf30eb725bb91c9ea,
    0x8972188433a5c5b7, 0x4883c49a2c009c1d, 0xadc2c0b63044067d, 0x091f4a3329f87d19]

const WORDS: []str = ["the", "quick", "brown", "fox", "jumps", "over", "lazy", "dog", "a", "b",
    "content-type", "host", "accept", "cookie", "x-forwarded-for", "user-agent"]

fn message(n: int): str {
    var b: []byte = []
    for i in 0..n { append(mut &b, byte(i)) }
    return strFromBytes(&b)
}

// What a run reports: the hash of a fixed string, then the keys of a Map in order.
fn report(): str {
    var m: Map[str, int] = newMap()
    for w in WORDS { m.put(w, len(w)) }
    for i in 0..200 { m.put("k" + i.toStr(), i) }
    var s = u64ToStr("hello, world".hash())
    for i in 0..m.size() { s += " " + m.keyAt(i) }
    return s
}

fn firstWord(s: &str): str {
    var i = 0
    while i < len(s) && strByte(s, i) != ' ' { i += 1 }
    return strSlice(s, 0, i)
}

fn rest(s: &str): str { return strSlice(s, len(firstWord(s)), len(s)) }

fn main() {
    let av = args()
    if len(av) > 1 {
        io.write(av[1], report()).unwrap()
        return
    }
    var ok = 0
    let k0: u64 = 0x0706050403020100
    let k1: u64 = 0x0f0e0d0c0b0a0908
    for i in 0..len(V13) {
        if sipHash13(k0, k1, &message(i)) == V13[i] { ok += 1 }
    }
    println("vectors ok " + ok.toStr())
    var rk = 0
    for i in 0..len(RUST) {
        if sipHash13(0, 0, &message(i)) == RUST[i] { rk += 1 }
    }
    println("rust vectors ok " + rk.toStr())

    // a substring hashes as the string with the same bytes, at every offset and length
    let long = "0123456789abcdefghijklmnopqrstuvwxyz" + ""
    var subOk = true
    for a in 0..len(long) {
        for b in a..len(long) + 1 {
            let copy = strFromBytes(&strToBytes(long[a..b]))
            if long[a..b].hash() != copy.hash() { subOk = false }
        }
    }
    let s = "xxabc" + ""
    println("substrings " + subOk.toStr() + " " + (s[2..].hash() == "abc".hash()).toStr() + " " +
        ("".hash() != "\x00".hash()).toStr())

    // two more runs of this program: other keys, the same Map order
    let me = av[0]
    assert(system(me + " run1.txt") == 0)
    assert(system(me + " run2.txt") == 0)
    let r0 = report()
    let r1 = io.read("run1.txt").unwrap()
    let r2 = io.read("run2.txt").unwrap()
    let h0 = firstWord(&r0)
    let h1 = firstWord(&r1)
    let h2 = firstWord(&r2)
    println("runs differ " + (h0 != h1 && h1 != h2 && h0 != h2).toStr())
    println("same order " + (rest(&r0) == rest(&r1) && rest(&r1) == rest(&r2)).toStr())

    // a worker is a fork: it has its supervisor's key
    let ends = task.workers(1, fn(i: int) { io.write("worker.txt", report()).unwrap() }).unwrap()
    let rw = io.read("worker.txt").unwrap()
    println("worker same key " + (len(ends) == 1 && firstWord(&rw) == h0).toStr())

    // the keyed hashes of wider values agree with eq
    let big: u128 = 0xfedcba98765432100123456789abcdef
    let neg: i128 = -170141183460469231731687303715884105727
    println("wide " + (big.hash() == (big + 0).hash() && big.hash() != (big ^ 1).hash()).toStr() + " " +
        (neg.hash() == (neg + 0).hash() && neg.hash() != (-neg).hash()).toStr() + " " +
        (1.50m.hash() == 1.5m.hash() && 1.5m.hash() != (-1.5m).hash()).toStr() + " " +
        (0.001m.hash() != 1.0m.hash()).toStr())
    // int hashes: a bijection (MIN and 1 used to share one)
    let mn = -9223372036854775807 - 1
    println("ints " + (mn.hash() != 1.hash()).toStr() + " " + ((-1).hash() != 0.hash()).toStr())
}
