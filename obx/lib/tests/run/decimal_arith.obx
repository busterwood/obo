// Exact + - * % and display-scale propagation (obo's decimal_arithmetic and
// decimal_display): add/sub take the larger scale, mul the sum capped at 38
// minus the integer digits, % the larger scale; unary minus keeps the scale.
// expect: 2.40
// expect: 2.50
// expect: 1.440
// expect: 1.0
// expect: -1.0
// expect: 1.0
// expect: -1.25
// expect: 100000000000000000001.0
// expect: 3.00
// expect: 2.000
// expect: 0.10
// expect: 99999999999999999999999999999999999999.0
// expect: 0.100
// expect: 1234567890123456789012345678901234567.8
// expect: 1234567890123456789012345678901234567.8
// expect: 10000000000000000000000000000000000000
// expect: 10000000000000000000000000000000000000
// expect: 1524157875323883663907940987639079420.0
// expect: 1524157875323883663907940987639079420.0
// expect: true
// expect: true
// expect: 0.000
// expect: 0.00
// expect: -0.50
// expect: 0.50
// expect: 0.50
// expect: 0.0
// expect: 1.000
// expect: 0.3
// expect: 0.0
// expect: 2.5
// expect: 1.2
// expect: 7
// expect: 0.00000000000000000000000000000000000001
// expect: -99999999999999999999999999999999999999
// expect: 1E-4 canonical 0.0001
// expect: 123.45 canonical 123.45 0.012 1200 -0.5
// expect: 1e-200 1.5e200
// expect: 2
// expect: 4.0
// expect: 10.000

fn d(s: str): Decimal { return Decimal.parse(s).unwrap() }

fn main() {
    println(1.20m + 1.2m)
    println(5.00m - 2.5m)
    println(1.20m * 1.2m)
    println(10.0m % 3.0m)
    println(-10.0m % 3.0m)
    println(10.0m % -3.0m)
    println(-1.25m)
    println(d("1e20") + 1.0m)
    println(1.00m + 2.0m)
    println(1.00m * 2.0m)
    println(1.00m % 0.3m)
    println(d("99999999999999999999999999999999999998.0") + 1.0m)
    println(1.0m * 0.10m)
    // the capped multiplication scale: the value is unchanged
    let big = d("12345678901234567890123456789012345678.0")
    println(big * 0.1m)
    println(0.1m * big)
    println(d("1e38") * 0.1m)
    println(0.1m * d("1e38"))
    println(d("12345678901234567890.0") * d("123456789012345678.0"))
    println(d("123456789012345678.0") * d("12345678901234567890.0"))
    println(big * 0.1m == 0.1m * big)
    println(d("1e38") * 0.1m == 0.1m * d("1e38"))
    // zeros: canonical positive, scale kept
    println(0.00m * 1.5m)
    println(1.25m - 1.25m)
    println(-0.50m)
    println(-(-0.50m))
    println(0.25m + 0.25m)
    println(-0.0m + d("0"))
    println(0.5m + 0.500m)
    println(0.1m + 0.2m)
    println(0.3m - 0.3m)
    println((-2.5m).abs())
    println(2.4m % 1.2m + 1.2m)
    println(decimalOf(3) + decimalOf(4))
    // the extremes of the coefficient and exponent
    println(d("1e-38"))
    println(-d("99999999999999999999999999999999999999"))
    let tiny = d("1E-4")
    println("1E-4 canonical " + tiny.canonical())
    println(123.45m.toStr() + " canonical " + d("123.4500").canonical() + " " + d("0.0120").canonical() + " "
        + d("1.2e3").canonical() + " " + d("-0.50").canonical())
    println(d("1e-200").canonical() + " " + d("15e199").canonical())
    println(d("1e32767").exponent() - 32765)
    // the remainder for exponents far apart
    println(d("1e40") % 6.0m)
    println(Decimal.fromUnits(10000, 3))
}
