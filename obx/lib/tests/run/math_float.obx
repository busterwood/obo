// Float printing (shortest round trip), parsing, libm methods and fixed
// formatting.
// expect: 0.1 0.30000000000000004 0.3333333333333333 100 1e25 1e-20 5e-324 -0 inf -inf NaN
// expect: 1.7976931348623157e308 2.2250738585072014e-308 1.5e-7 0.0001 1.2345678901234568e17 1.2345678901234568e17
// expect: round trip 0 bad
// expect: 3 1.4142135623730951 1024 2 -2 -3 2 2 -3 -2
// expect: 2.718281828459045 1 3 0.5 1 0 0.7853981633974483 3.141592653589793
// expect: 1 -1 5 true false true false false
// expect: 3.14 3 3.1416 2.68 2.66 0.00 -0.01 1000000.000 0.12 26 inf 10 0
// expect: Some(2.5) Some(-1e-7) Some(0.5) None None None Some(inf) Some(8)
// expect: 0.1 ok, 2.5 ok
// expect: near true false
import "math"

fn main() {
    let one: float = 1.0
    let zero: float = 0.0
    println(math.parse("0.1").unwrap().toStr() + " " + (0.1 + float(0) + 0.2).toStr() + " " +
        (one / 3.0).toStr() + " " + (float(100)).toStr() + " " + math.parse("1e25").unwrap().toStr() + " " +
        math.parse("1e-20").unwrap().toStr() + " " + math.parse("5e-324").unwrap().toStr() + " " +
        (-zero).toStr() + " " + math.inf().toStr() + " " + (-math.inf()).toStr() + " " + math.nan().toStr())
    println(math.parse("1.7976931348623157e308").unwrap().toStr() + " " +
        math.parse("2.2250738585072014e-308").unwrap().toStr() + " " + math.parse("0.00000015").unwrap().toStr() +
        " " + math.parse("0.0001").unwrap().toStr() + " " + math.parse("123456789012345678").unwrap().toStr() +
        " " + math.parse("123456789012345678.9").unwrap().toStr())

    // toStr reads back exactly, over many magnitudes and subnormals
    var bad = 0
    var x: float = 1.0
    for i in 0..2000 {
        x = x * 1.37
        if x > f("1e300") { x = x / f("1e300") / f("1e300") / f("1e10") }
        for v in [x, -x, one / x, x * f("1e-310")] {
            let back = math.parse(v.toStr()).unwrap()
            if back != v { bad += 1 }
        }
    }
    println("round trip " + bad.toStr() + " bad")

    let nine: float = 9.0
    let two: float = 2.0
    let a: float = 2.5
    println(nine.sqrt().toStr() + " " + two.sqrt().toStr() + " " + two.pow(10.0).toStr() + " " +
        a.floor().toStr() + " " + (-a).ceil().toStr() + " " + (-a).round().toStr() + " " +
        a.roundEven().toStr() + " " + a.trunc().toStr() + " " + (-a).floor().toStr() + " " + (-a).trunc().toStr())
    println(one.exp().toStr() + " " + math.E.ln().toStr() + " " + (1000.0 + float(0)).log10().toStr() + " " +
        math.fixed((math.PI / 6.0).sin(), 1) + " " + zero.cos().toStr() + " " + zero.sin().toStr() + " " +
        one.atan().toStr() + " " + zero.atan2(-one).toStr())
    println((7.0 + float(0)).mod(3.0).toStr() + " " + (-nine).mod(two).toStr() + " " +
        (3.0 + float(0)).hypot(4.0).toStr() + " " + math.nan().isNaN().toStr() + " " + a.isNaN().toStr() + " " +
        math.inf().isInf().toStr() + " " + math.inf().isFinite().toStr() + " " + math.nan().isFinite().toStr())

    println(math.fixed(math.PI, 2) + " " + math.fixed(math.PI, 0) + " " + math.fixed(math.PI, 4) + " " +
        math.fixed(2.675, 2) + " " + math.fixed(2.665, 2) + " " + math.fixed(-0.001, 2) + " " +
        math.fixed(-0.005001, 2) + " " + math.fixed(float(1000000), 3) + " " + math.fixed(0.125, 2) + " " +
        len(math.fixed(f("1e25"), 0)).toStr() + " " + math.fixed(math.inf(), 2) + " " +
        math.fixed(9.5, 0) + " " + math.fixed(0.4, 0))

    var ps = ""
    for s in ["2.5", "-1e-7", ".5", "", " 1", "1x", "inf", "0x1p3"] { ps += math.parse(s).toStr() + " " }
    println(trim(ps))

    match math.toDecimal(0.1) {
        Some(d) {
            if d == 0.1 { print("0.1 ok, ") }
        }
        None { print("none, ") }
    }
    if math.toDecimal(2.5).unwrap() == 2.5 { println("2.5 ok") }
    println("near " + math.near(one, one + f("1e-12"), f("1e-9")).toStr() + " " + math.near(one, 1.1, f("1e-9")).toStr())
}

fn f(s: str): float { return math.parse(s).unwrap() }
