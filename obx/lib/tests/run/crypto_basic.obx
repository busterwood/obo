// crypto's wrappers against known answers (Python's hashlib and the
// openssl command line computed them): digests, PBKDF2-HMAC-SHA512, AES-CBC
// with and without padding, both ways, and the error paths.
// needs: ssl
// expect: sha1 a9993e364706816aba3e25717850c26c9cd0d89d
// expect: sha512 ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f
// expect: md5 900150983cd24fb0d6963f7d28e17f72
// expect: pbkdf2 2a3d6e97a8e6d3020d9ba398a27d21dceaa15639f586270c8327e0716269720fce72ab4df4f135211ace9a559f7863a8a1d9cc76e04223ba613f3c6e30f51455
// expect: aes256 9b8b0499c07b6239584044ccbff60c2a30a9de660d61d902f9c8acabe86296f1
// expect: back Hello, Oracle!!!
// expect: aes192 nopad 65b9f05ca3ae1a4c6721b73bae163065
// expect: back Hello, Oracle!!!
// expect: bad key: crypto: AES-CBC encrypt: a key of 5 bytes
// expect: not blocks: crypto: AES-CBC decrypt: 3 bytes, not whole blocks
// expect: random 32 32 different true
// expect: unhex true false false
// expect: sha256 e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
// expect: sha256 ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
// expect: hmac1 b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7
// expect: hmac2 5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843
// expect: hmac empty b613679a0814d9ec772f95d778c35fc5ff1697c493715653c6c712144292c5ad
// expect: pbkdf2-256 rfc7914 55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783
// expect: pbkdf2-256 c1 120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b
// expect: pbkdf2-256 c4096 c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a
// expect: pbkdf2-256 bad: crypto: PBKDF2: 0 iterations
// expect: pbkdf2-256 helper pool: other task ran true, same key true
// expect: base64 [] [Zg==] [Zm8=] [Zm9v] [Zm9vYg==] [Zm9vYmE=] [Zm9vYmFy]
// expect: unbase64 back: true
// expect: unbase64 binary: true
// expect: unbase64 rejects: true true true true true true true true true

import "crypto"
import "task"

fn show(label: str, r: Result[str, crypto.Error]) {
    match r {
        Ok(v) { println(label + " " + crypto.hex(v)) }
        Err(e) { println(label + ": " + e.toStr()) }
    }
}

fn text(r: Result[str, crypto.Error]): str {
    match r {
        Ok(v) { return v }
        Err(e) { return e.toStr() }
    }
}

fn main() {
    show("sha1", crypto.sha1("abc"))
    show("sha512", crypto.sha512("abc"))
    show("md5", crypto.md5("abc"))
    show("pbkdf2", crypto.pbkdf2Sha512("password", "salt\x00x", 4096, 64))
    let iv = "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    var k32 = crypto.unhex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f").unwrap()
    let c = text(crypto.aesCbcEncrypt(k32, iv, "Hello, Oracle!!!", true))
    println("aes256 " + crypto.hex(c))
    println("back " + text(crypto.aesCbcDecrypt(k32, iv, c, true)))
    let k24 = crypto.unhex("000102030405060708090a0b0c0d0e0f1011121314151617").unwrap()
    let c2 = text(crypto.aesCbcEncrypt(k24, iv, "Hello, Oracle!!!", false))
    println("aes192 nopad " + crypto.hex(c2))
    println("back " + text(crypto.aesCbcDecrypt(k24, iv, c2, false)))
    println("bad key: " + text(crypto.aesCbcEncrypt("12345", iv, "x", true)))
    println("not blocks: " + text(crypto.aesCbcDecrypt(k32, iv, "abc", false)))
    let r1 = text(crypto.randomBytes(32))
    let r2 = text(crypto.randomBytes(32))
    println("random " + len(r1).toStr() + " " + len(r2).toStr() + " different " + (r1 != r2).toStr())
    println("unhex " + crypto.unhex("0aFf").isSome().toStr() + " " + crypto.unhex("0g").isSome().toStr() + " " + crypto.unhex("abc").isSome().toStr())

    // SHA-256 and HMAC-SHA-256 (FIPS 180-4, RFC 4231 cases 1 and 2)
    show("sha256", crypto.sha256(""))
    show("sha256", crypto.sha256("abc"))
    show("hmac1", crypto.hmacSha256("\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b", "Hi There"))
    show("hmac2", crypto.hmacSha256("Jefe", "what do ya want for nothing?"))
    show("hmac empty", crypto.hmacSha256("", ""))

    // PBKDF2-HMAC-SHA-256 (RFC 7914 section 11; the published ones for "password"/"salt")
    show("pbkdf2-256 rfc7914", crypto.pbkdf2Sha256("passwd", "salt", 1, 64))
    show("pbkdf2-256 c1", crypto.pbkdf2Sha256("password", "salt", 1, 32))
    show("pbkdf2-256 c4096", crypto.pbkdf2Sha256("password", "salt", 4096, 32))
    println("pbkdf2-256 bad: " + text(crypto.pbkdf2Sha256("p", "s", 0, 32)))
    // a big count runs on the helper pool: another task goes on meanwhile
    let want = text(crypto.pbkdf2Sha256("pw", "salt", 1000, 32))
    task.scope(fn(s: mut &task.Scope) {
        let slow = s.start(slowKey, 600000)
        s.spawn(ticker, 0)
        let k = slow.wait().unwrap()
        println("pbkdf2-256 helper pool: other task ran " + OTHER_RAN.toStr() + ", same key " + (len(k) == 32).toStr())
    })

    // base64 (RFC 4648 section 10)
    var enc = ""
    for v in ["", "f", "fo", "foo", "foob", "fooba", "foobar"] { enc = enc + "[" + crypto.base64(v) + "] " }
    println("base64 " + trim(enc))
    var back = true
    for v in ["", "f", "fo", "foo", "foob", "fooba", "foobar"] {
        if crypto.unbase64(crypto.base64(v)).unwrapOr("?") != v { back = false }
    }
    println("unbase64 back: " + back.toStr())
    var all = ""
    for i in 0..256 { all = all + strFromBytes(&[byte(i)]) }
    println("unbase64 binary: " + (crypto.unbase64(crypto.base64(all)).unwrapOr("?") == all).toStr())
    // bad padding, white space, bad characters, a misplaced "="
    println("unbase64 rejects: " + crypto.unbase64("Zg").isNone().toStr() + " " + crypto.unbase64("Zg=").isNone().toStr() + " " +
            crypto.unbase64("Zm9vYg=").isNone().toStr() + " " + crypto.unbase64("Zm9v ").isNone().toStr() + " " +
            crypto.unbase64("Zm9v\n").isNone().toStr() + " " + crypto.unbase64("Z=9v").isNone().toStr() + " " +
            crypto.unbase64("Zg==Zg==").isNone().toStr() + " " + crypto.unbase64("Zm9-").isNone().toStr() + " " +
            crypto.unbase64("Z===").isNone().toStr())
}

var OTHER_RAN: bool = false

fn slowKey(n: int): str { return text(crypto.pbkdf2Sha256("pw", "salt", n, 32)) }

fn ticker(n: int): int {
    let r = task.sleep(2)
    OTHER_RAN = true
    return 0
}
