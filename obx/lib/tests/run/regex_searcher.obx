// regex: Searchers (findWith, matchEndWith), canMatchNewline and
// requiredLiteral. A Searcher's searches agree with findFrom on random texts,
// short and long, from every position and over several texts in turn; the
// end matchEndWith gives is the end of a match that starts at or after the
// position and no later than the leftmost match. matchingLines finds the
// lines a search of each line by itself finds, under every matcher, in
// batches of every size.
// expect: agree ok
// expect: lines ok
// expect: newline abc n
// expect: newline a.b n
// expect: newline (?s)a.b y
// expect: newline [^a]b y
// expect: newline [[:space:]]x y
// expect: newline a\nb y
// expect: newline (?i)[^k] y
// expect: newline [a-z]+ n
// expect: must abc "abc"
// expect: must [0-9]*7 alpha "7 alpha"
// expect: must a.*zz.*e "zz"
// expect: must (alpha|beta) gamma " gamma"
// expect: must x+(foo)+y{2} "foo"
// expect: must (?i)ab7 cd "7 "
// expect: must a|b ""
// expect: must (abc)? ""
// expect: must a*b{0,3} ""

import "regex"

fn randomText(n: int, alphabet: str, seed0: int): str {
    var seed = seed0
    var b = newStrBuf()
    for i in 0..n {
        seed = (seed * 1103515245 + 12345) % 2147483648
        b.addByte(alphabet[(seed >> 16) % len(alphabet)])
    }
    return b.toStr()
}

fn agree(): bool {
    var ok = true
    let pats = ["ab", "a+b", "a[bc]*d", "(a|bc)+", "b.*a", "x*", "(?i)AB", "[^a]b", "ab|ba|c", "a(b|c)*a", "\\bab", "^b", "a$"]
    for p in pats {
        for longest in [false, true] {
            let re = if longest { regex.compileLongest(p).unwrap() } else { regex.compile(p).unwrap() }
            // \z-anchored: the matches that end where the text ends
            let at = if longest { regex.compileLongest("(?:" + p + ")\\z").unwrap() } else { regex.compile("(?:" + p + ")\\z").unwrap() }
            var s = re.searcher()
            for n in [0, 5, 40, 300] {
                for seed in 1..4 {
                    let t = randomText(n, "abcd\nx", seed * 7 + n)
                    for from in 0..n + 1 {
                        let want = re.findFrom(t, from)
                        let got = re.findWith(mut &s, t, from)
                        match want {
                            None {
                                if got.isSome() { println("findWith /" + p + "/ found too much"); ok = false }
                                if re.matchEndWith(mut &s, t, from) != -1 { println("matchEndWith /" + p + "/ found too much"); ok = false }
                            }
                            Some(m) {
                                match got {
                                    None { println("findWith /" + p + "/ missed"); ok = false }
                                    Some(g) {
                                        if g.start != m.start || g.end != m.end { println("findWith /" + p + "/ differs"); ok = false }
                                    }
                                }
                                let e = re.matchEndWith(mut &s, t, from)
                                if e < m.start {
                                    println("matchEndWith /" + p + "/ ends before the leftmost match"); ok = false
                                }
                                // a match from `from` ends at e (patterns with $ and \b see other context there)
                                if e >= 0 && p != "a$" && p != "\\bab" && !at.findFrom(substr(t, 0, e), from).isSome() {
                                    println("matchEndWith /" + p + "/ " + e.toStr() + " is no match end"); ok = false
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return ok
}

// The lines of t[from..] (whole lines) with a match, each line searched by
// itself: start and end pairs.
fn linesOf(re: &regex.Regex, t: str, from: int): []int {
    var out: []int = []
    var p = from
    while p < len(t) {
        var e = p
        while t[e] != '\n' { e += 1 }
        if re.isMatch(substr(t, p, e)) {
            append(mut &out, p)
            append(mut &out, e)
        }
        p = e + 1
    }
    return out
}

fn showInts(a: &[]int): str {
    var b = newStrBuf()
    for x in a {
        b.addInt(x)
        b.addByte(' ')
    }
    return b.toStr()
}

fn lines(): bool {
    var ok = true
    let pats = ["(?m)ab", "(?m)^a", "(?m)b$", "(?m)^$", "(?m)a+b", "(?m)[^\\n]*c", "(?m)\\bab", "(?m)(a|bc)+d", "(?m)x*", "(?m)^(a|b)c+", "(?mi)AB", "(?m)ab|^c"]
    for p in pats {
        for m in ["onepass", "pike", "backtrack", "dfa", "prefilter", "dfatiny"] {
            for longest in [false, true] {
                let re = regex.compileForcing(p, longest, m).unwrap()
                let plain = regex.compileForcing(p, longest, "pike").unwrap()
                var s = re.searcher()
                for n in [1, 20, 400, 3000] {
                    for seed in 1..3 {
                        var t = randomText(n, "abcd\n\nx", seed * 11 + n) + "\n"
                        for from in [0, 1, 2] {
                            // from at a line start
                            var f = 0
                            var k = 0
                            while k < from && f < len(t) {
                                while t[f] != '\n' { f += 1 }
                                f += 1
                                k += 1
                            }
                            if f >= len(t) { continue }
                            let want = showInts(&linesOf(&plain, t, f))
                            for max in [-1, 1, 3] {
                                var got: []int = []
                                var at = f
                                while at < len(t) {
                                    let n0 = len(got)
                                    let stop = re.matchingLines(mut &s, t, at, len(t), max, mut &got)
                                    if stop <= at && len(got) == n0 { break }
                                    at = stop
                                }
                                if showInts(&got) != want {
                                    println("lines /" + p + "/ " + m + " max " + max.toStr() + ": " + showInts(&got) + "want " + want)
                                    ok = false
                                    return ok
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return ok
}

fn main() {
    println("agree " + (if agree() { "ok" } else { "FAILED" }))
    println("lines " + (if lines() { "ok" } else { "FAILED" }))
    for p in ["abc", "a.b", "(?s)a.b", "[^a]b", "[[:space:]]x", "a\\nb", "(?i)[^k]", "[a-z]+"] {
        let re = regex.compile(p).unwrap()
        println("newline " + p + " " + (if re.canMatchNewline() { "y" } else { "n" }))
    }
    for p in ["abc", "[0-9]*7 alpha", "a.*zz.*e", "(alpha|beta) gamma", "x+(foo)+y{2}", "(?i)ab7 cd", "a|b", "(abc)?", "a*b{0,3}"] {
        let re = regex.compile(p).unwrap()
        println("must " + p + " \"" + re.requiredLiteral() + "\"")
    }
}
