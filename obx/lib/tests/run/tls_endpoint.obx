// tls: the channel binding data (Engine.endPoint, RFC 5929 tls-server-end-point), Options.verifyName
// and Options.sni, against `openssl s_server` with certificates made at test time (skipped without
// the openssl command).
// needs: ssl
// expect: ecdsa-sha256: endPoint is the certificate's SHA-256 true, 32 bytes true
// expect: conn: same true
// expect: readFor idle: timeout true
// expect: readFor and writeFor: cba
// expect: rsa-sha256: endPoint is the certificate's SHA-256 true
// expect: rsa-sha384: endPoint is the certificate's SHA-384 true
// expect: rsa-sha1: endPoint is a SHA-256 true
// expect: ed25519: tls: verify: could not determine server certificate signature algorithm (localhost)
// expect: no certificate yet: tls: verify: no server certificate to take the channel binding data from
// expect: verifyName true: verify 62 hostname mismatch
// expect: verifyName false: ok
// expect: verifyName false, unknown CA: verify 20 unable to get local issuer certificate
// expect: verifyName false, engine(""): ok
// expect: verifyName true, engine(""): tls: config: a server name is needed to verify the server's certificate
// expect: sni true: name sent true
// expect: sni false: name sent false
import "tls"
import "net"
import "task"
import "strings"
import "os"
import "../support/tlstest" as tt

type Dial = record {
    ctx: tls.Context
    sock: net.Conn
    name: str
}

// A client connect that ends when the peer closes.
fn dial(d: Dial): int {
    let Dial{ctx: ctx, sock: sock, name: name} = move(d)
    let r = ctx.connect(sock, name)
    return 0
}

// Whether a ClientHello made with o for name carries the name (SNI is in the clear).
fn nameSent(ln: &net.Listener, o: tls.Options, name: str): bool {
    let ctx = tls.client(o).unwrap()
    var seen = false
    task.scope(fn(s: mut &task.Scope) {
        let sock = net.connect(ln.localAddr()).unwrap()
        s.spawn(dial, Dial{ctx: ctx.share(), sock: sock, name: name})
        let peer = ln.accept().unwrap()
        var buf = array(4096, byte(0))
        let n = peer.read(mut &buf).unwrap()
        seen = indexOf(strFromBytes(&buf[0..n]), name, 0) >= 0
    })
    return seen
}

fn hex(raw: str): str {
    let digits = "0123456789abcdef"
    var b = newStrBuf()
    for i in 0..len(raw) {
        let c = strByte(raw, i)
        b.addByte(digits[int(c >> 4)])
        b.addByte(digits[int(c & 15)])
    }
    return b.toStr()
}

// The openssl fingerprint of file (hash: "sha256"), lowercase hex without colons.
fn fingerprint(file: str, hash: str): str {
    let text = tt.opensslOut(["x509", "-in", file, "-noout", "-fingerprint", "-" + hash])
    return strings.toLower(strings.replaceAll(strings.cut(&trim(text), "=").unwrap().after, ":", ""))
}

// The channel binding data the client gets from a server with the certificate name (self-signed, trusted).
fn bound(name: str): Result[str, tls.Error] {
    let srv = tt.sServer(["-cert", name + ".pem", "-key", name + ".key", "-rev"])
    var o = tls.defaults()
    o.caFile = tt.path(name + ".pem")
    let ctx = tls.client(o).unwrap()
    let c = ctx.connect(net.connect(srv.addr).unwrap(), "localhost").unwrap()
    return c.engine().endPoint()
}

fn main() {
    tt.pki()
    // the test CA's server certificate: ECDSA with SHA-256
    {
        let srv = tt.sServer(["-cert", "srv.pem", "-key", "srv.key", "-rev"])
        let ctx = tls.client(tt.clientOptions()).unwrap()
        let c = ctx.connect(net.connect(srv.addr).unwrap(), "localhost").unwrap()
        let raw = c.engine().endPoint().unwrap()
        println("ecdsa-sha256: endPoint is the certificate's SHA-256 " + (hex(raw) == c.peer().unwrap().sha256).toStr() +
                ", 32 bytes " + (len(raw) == 32).toStr())
        println("conn: same " + (c.endPoint().unwrap() == raw).toStr())
    }
    // readFor and writeFor (s_server -rev answers a line with the line reversed)
    {
        let srv = tt.sServer(["-cert", "srv.pem", "-key", "srv.key", "-rev"])
        let ctx = tls.client(tt.clientOptions()).unwrap()
        var c = ctx.connect(net.connect(srv.addr).unwrap(), "localhost").unwrap()
        var buf = array(64, byte(0))
        let idle = c.readFor(mut &buf, 40)
        println("readFor idle: timeout " + idle.unwrapErr().isTimeout().toStr())
        let msg = strToBytes("abc\n")
        c.writeFor(&msg, 1000).unwrap()
        var got = ""
        while len(got) < 4 {
            let n = c.readFor(mut &buf, 1000).unwrap()
            got = got + strFromBytes(&buf[0..n])
        }
        println("readFor and writeFor: " + trim(got))
    }
    let id = "-" + os.pid().toStr()      // the C and native runs may share the directory
    tt.selfSigned("rsa256" + id, "rsa:2048", "sha256")
    tt.selfSigned("rsa384" + id, "rsa:2048", "sha384")
    tt.selfSigned("rsa1" + id, "rsa:2048", "sha1")
    tt.selfSigned("ed" + id, "ed25519", "")
    println("rsa-sha256: endPoint is the certificate's SHA-256 " + (hex(bound("rsa256" + id).unwrap()) == fingerprint("rsa256" + id + ".pem", "sha256")).toStr())
    println("rsa-sha384: endPoint is the certificate's SHA-384 " + (hex(bound("rsa384" + id).unwrap()) == fingerprint("rsa384" + id + ".pem", "sha384")).toStr())
    println("rsa-sha1: endPoint is a SHA-256 " + (hex(bound("rsa1" + id).unwrap()) == fingerprint("rsa1" + id + ".pem", "sha256")).toStr())
    match bound("ed" + id) {
        Ok(x) { println("ed25519: endPoint? " + hex(x)) }
        Err(e) { println("ed25519: " + e.toStr()) }
    }
    {
        let ctx = tls.client(tt.clientOptions()).unwrap()
        let e = ctx.engine("localhost").unwrap()
        println("no certificate yet: " + strings.replaceAll(e.endPoint().unwrapErr().toStr(), " (localhost)", ""))
    }

    // verifyName
    var named = tt.clientOptions()
    var loose = tt.clientOptions()
    loose.verifyName = false
    {
        let other = tt.sServer(["-cert", "other.pem", "-key", "other.key", "-rev"])
        println("verifyName true: " + attempt(named, other.addr, "localhost"))
        println("verifyName false: " + attempt(loose, other.addr, "localhost"))
    }
    {
        let rogue = tt.sServer(["-cert", "rogue.pem", "-key", "rogue.key", "-rev"])
        println("verifyName false, unknown CA: " + attempt(loose, rogue.addr, "localhost"))
    }
    {
        let srv = tt.sServer(["-cert", "srv.pem", "-key", "srv.key", "-rev"])
        println("verifyName false, engine(\"\"): " + attempt(loose, srv.addr, ""))
        println("verifyName true, engine(\"\"): " + attempt(named, srv.addr, ""))
    }

    // sni
    let ln = net.listen("127.0.0.1:0").unwrap()
    var withSni = tt.clientOptions()
    var noSni = tt.clientOptions()
    noSni.sni = false
    println("sni true: name sent " + nameSent(&ln, withSni, "localhost").toStr())
    println("sni false: name sent " + nameSent(&ln, noSni, "localhost").toStr())
}

fn attempt(o: tls.Options, addr: str, name: str): str {
    let ctx = match tls.client(o) {
        Ok(c) { c }
        Err(e) { return e.toStr() }
    }
    match ctx.connect(net.connect(addr).unwrap(), name) {
        Ok(c) { return "ok" }
        Err(e) {
            if e.kind == tls.Kind.Verify { return "verify " + intToStr(e.code) + " " + e.msg }
            return e.toStr()
        }
    }
}
