// tls: TLS 1.2 and 1.3 through OpenSSL 3 (libssl.so.3 and libcrypto.so.3;
// a program that uses it is dynamically linked to them). design/tls.md.
//
//     let ctx = try tls.client(tls.defaults())           // trust store, versions: once, shared
//     let sock = try net.dial("example.com:443")
//     var c = try ctx.connect(sock, "example.com")       // handshake; the task parks meanwhile
//     try c.writeStr("GET / HTTP/1.1\r\nHost: example.com\r\n\r\n")
//     var buf = array(16384, byte(0))
//     let n = try c.read(mut &buf)                        // 0: the peer closed
//     try c.close()                                       // close_notify
//
// One engine, two ways to drive it. An Engine is an OpenSSL SSL object
// over two memory BIOs: the caller feeds it the ciphertext that arrived
// (feed), takes the ciphertext it made (output, takeOutput) and sends it
// itself, so a protocol can carry the handshake inside its own packets
// (TDS pre-login). A Conn is an Engine over a net.Conn: it moves the
// ciphertext between the two, and its task parks on the socket while the
// engine wants input or the socket's buffer is full, so no call blocks the
// program's thread. Every OpenSSL call runs on the program's thread (none
// is a blocking extern): its error queue is read right after the call, on
// the same thread, and one SSL object is never used by two threads.
//
// Secure by default (defaults()): TLS 1.2 or newer; the server's
// certificate is verified against the system's trust store, and its name
// against the name given to connect (SSL_set1_host; an IP literal is
// checked as an address); SNI is sent for a name (not for an address).
// Options can trust another CA file or directory instead, pin certificates
// by their SHA-256 fingerprint, present a client certificate, offer ALPN
// protocols, and, named for what it does, turn verification off
// (insecureSkipVerify: test servers, SQL Server's TrustServerCertificate).
//
// Resources: a Context owns an SSL_CTX, an Engine an SSL (and its BIOs), a
// Conn its Engine and its socket; each is freed by its drop. Dropping an
// open Conn sends close_notify if the socket takes it at once (a drop never
// parks); close() sends it and parks until it is written. openHandles()
// counts live Contexts and Engines, for tests.
//
// Errors are Error {kind, msg, code, peer, cause}: Config (options, files),
// Handshake (the handshake failed: a protocol version, an alert, a closed
// connection), Verify (the certificate: code is X509's verify result, msg
// its text; a pin), Protocol (after the handshake: a bad record, a
// connection closed inside a record), Io, Timeout, Cancelled (the socket;
// cause is net's IoError). msg is OpenSSL's error queue, read and cleared
// at each call.

import "io"
import "fs"
import "net"
import "ffi"
import "time"

extern "ssl" fn TLS_client_method(): ptr
extern "ssl" fn TLS_server_method(): ptr
extern "ssl" fn SSL_CTX_new(m: ptr): ptr
extern "ssl" fn SSL_CTX_free(c: ptr)
extern "ssl" fn SSL_CTX_up_ref(c: ptr): i32
extern "ssl" fn SSL_CTX_ctrl(c: ptr, cmd: i32, larg: int, parg: ptr): int
extern "ssl" fn SSL_CTX_set_options(c: ptr, op: u64): u64
extern "ssl" fn SSL_CTX_set_verify(c: ptr, mode: i32, cb: ptr)
extern "ssl" fn SSL_CTX_set_default_verify_paths(c: ptr): i32
extern "ssl" fn SSL_CTX_load_verify_file(c: ptr, f: str): i32
extern "ssl" fn SSL_CTX_load_verify_dir(c: ptr, d: str): i32
extern "ssl" fn SSL_CTX_use_certificate_chain_file(c: ptr, f: str): i32
