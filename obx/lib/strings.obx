// strings: searching, splitting, joining, replacing, trimming, case,
// integer parsing and formatting, padding, and UTF-8.
//
// str is a byte string. Indexes and lengths are in bytes; the rune functions
// decode UTF-8. Case functions change ASCII letters only. std already has
// indexOf, startsWith, endsWith, contains, split (at a byte), trim, repeat,
// isSpace, isDigit and StrBuf.

// ------------------------------------------------------------ searching

// The last index of sub in s, or -1.
pub fn lastIndexOf(s: str, sub: str): int {
    var i = len(s) - len(sub)
    while i >= 0 {
        if matches(s, i, sub) { return i }
        i -= 1
    }
    return -1
}

// The first index of byte c in s at or after from, or -1.
pub fn indexOfByte(s: str, c: byte, from: int): int {
    for i in from..len(s) {
        if strByte(s, i) == c { return i }
    }
    return -1
}

// The number of non-overlapping occurrences of sub (sub not empty).
pub fn count(s: str, sub: str): int {
    if len(sub) == 0 { panic("strings.count: empty sub") }
    var n = 0
    var i = indexOf(s, sub, 0)
    while i >= 0 {
        n += 1
        i = indexOf(s, sub, i + len(sub))
    }
    return n
}

fn matches(s: str, at: int, sub: str): bool {
    if at < 0 || at + len(sub) > len(s) { return false }
    for j in 0..len(sub) {
        if strByte(s, at + j) != strByte(sub, j) { return false }
    }
    return true
}

// Whether a and b are equal ignoring ASCII case.
pub fn equalFold(a: str, b: str): bool {
    if len(a) != len(b) { return false }
    for i in 0..len(a) {
        if lowerByte(strByte(a, i)) != lowerByte(strByte(b, i)) { return false }
    }
    return true
}

// ------------------------------------------------------------ splitting
//
// The pieces are views (&str) of s: no copy and no count, valid while s is
// (design/borrow-types.md; s is frozen while they live). A piece converts to
// str where one is expected; owned(&pieces) keeps a whole array past s.

// The pieces of s between occurrences of sep (sep not empty); "" gives [""].
pub fn split(s: &str, sep: &str): []&str { return splitN(s, sep, -1) }

// At most n pieces (n < 0: all): the last one holds the rest of s.
pub fn splitN(s: &str, sep: &str, n: int): []&str {
    if len(sep) == 0 { panic("strings.split: empty separator") }
    var out: []&str = []
    var start = 0
    var i = strFind(s, 0, sep)
    while i >= 0 && (n < 0 || len(out) < n - 1) {
        append(mut &out, &s[start..i])
        start = i + len(sep)
        i = strFind(s, start, sep)
    }
    append(mut &out, &s[start..len(s)])
    return out
}

// The words of s: the runs of non-space bytes.
pub fn fields(s: &str): []&str {
    var out: []&str = []
    var i = 0
    while i < len(s) {
        while i < len(s) && isSpace(s[i]) { i += 1 }
        let start = i
        while i < len(s) && !isSpace(s[i]) { i += 1 }
        if i > start { append(mut &out, &s[start..i]) }
    }
    return out
}

// The pieces as owned strings, to keep past the text they view.
pub fn owned(pieces: &[]&str): []str {
    var out: []str = []
    for p in pieces { append(mut &out, p) }
    return out
}

// An iterator over the lines of a text: `for line in strings.lines(&text)`.
// Each line is a view without its '\n'; a final line without one is a line,
// and a text ending in '\n' has no empty line after it ("" has no lines).
pub type Lines = value record {
    text: &str
    pos: int
}

pub fn lines(text: &str): Lines { return Lines{text: text, pos: 0} }

pub fn (it: mut &Lines) next(): Option[&str] {
    let n = len(it.text)
    if it.pos >= n { return None }
    let start = it.pos
    var e = strFindByte(it.text, start, '\n')
    if e < 0 { e = n }
    it.pos = e + 1
    return Some(it.text[start..e])
}

// An iterator over the words of a text (fields', one at a time).
pub type Fields = value record {
    text: &str
    pos: int
}

pub fn fieldsIter(text: &str): Fields { return Fields{text: text, pos: 0} }

pub fn (it: mut &Fields) next(): Option[&str] {
    let n = len(it.text)
    var i = it.pos
    while i < n && isSpace(it.text[i]) { i += 1 }
    if i >= n {
        it.pos = n
        return None
    }
    let start = i
    while i < n && !isSpace(it.text[i]) { i += 1 }
    it.pos = i
    return Some(it.text[start..i])
}

// The text before and after the first sep, if s contains it: views of s.
pub type Cut = value record {
    pub before: &str
    pub after: &str
}

pub fn cut(s: &str, sep: &str): Option[Cut] {
    let i = strFind(s, 0, sep)
    if i < 0 { return None }
    return Some(Cut{before: s[0..i], after: s[i + len(sep)..len(s)]})
}

// The parts with sep between them. The parts are views (`&[&str]`): an array of views, or of
// owned strings (`&names`, read as views, SPEC 4.1), or a slice of either.
pub fn join(parts: &[&str], sep: str): str {
    var b = newStrBuf()
    for i in 0..len(parts) {
        if i > 0 { b.add(sep) }
        b.add(parts[i])
    }
    return b.toStr()
}

// ------------------------------------------------------------ replacing

// s with every occurrence of old (not empty) replaced by new.
pub fn replaceAll(s: str, old: str, new: str): str { return replaceN(s, old, new, -1) }

// s with the first n occurrences of old replaced (all when n < 0).
pub fn replaceN(s: str, old: str, new: str, n: int): str {
    if len(old) == 0 { panic("strings.replace: empty pattern") }
    var b = newStrBuf()
    var start = 0
    var done = 0
    var i = indexOf(s, old, 0)
    while i >= 0 && (n < 0 || done < n) {
        b.add(strSlice(s, start, i))
        b.add(new)
        start = i + len(old)
        done += 1
        i = indexOf(s, old, start)
    }
    if done == 0 { return s }
    b.add(strSlice(s, start, len(s)))
    return b.toStr()
}

// ------------------------------------------------------------ trimming

pub fn trimLeft(s: str): str {
    var a = 0
    while a < len(s) && isSpace(strByte(s, a)) { a += 1 }
    return strSlice(s, a, len(s))
}

pub fn trimRight(s: str): str {
    var b = len(s)
    while b > 0 && isSpace(strByte(s, b - 1)) { b -= 1 }
    return strSlice(s, 0, b)
}

// s without prefix, if it starts with it (else s).
pub fn trimPrefix(s: str, prefix: str): str {
    if startsWith(s, prefix) { return strSlice(s, len(prefix), len(s)) }
    return s
}

pub fn trimSuffix(s: str, suffix: str): str {
    if endsWith(s, suffix) { return strSlice(s, 0, len(s) - len(suffix)) }
    return s
}

// ------------------------------------------------------------ case

pub fn toUpper(s: str): str {
    var bs = strToBytes(s)
    for i in 0..len(bs) {
        if bs[i] >= 'a' && bs[i] <= 'z' { bs[i] -= 32 }
    }
    return strFromBytes(&bs)
}

pub fn toLower(s: str): str {
    var bs = strToBytes(s)
    for i in 0..len(bs) { bs[i] = lowerByte(bs[i]) }
    return strFromBytes(&bs)
}

fn lowerByte(c: byte): byte {
    if c >= 'A' && c <= 'Z' { return c + 32 }
    return c
}

pub fn isLetter(c: byte): bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') }
pub fn isAlnum(c: byte): bool { return isLetter(c) || isDigit(c) }

// ------------------------------------------------------------ integers

pub type ParseError = value closed {
    Empty           // no digits
    Invalid(int)    // the byte offset of the first byte that is not a digit
    OutOfRange      // does not fit in an int
}

pub fn (e: ParseError) toStr(): str {
    match e {
        ParseError.Empty { return "no digits" }
        ParseError.Invalid(at) { return "invalid digit at " + intToStr(at) }
        ParseError.OutOfRange { return "out of range" }
    }
}

pub fn (a: ParseError) eq(b: &ParseError): bool { return a.toStr() == b.toStr() }

// A decimal int with an optional sign: "42", "-7", "+3".
pub fn parseInt(s: str): Result[int, ParseError] { return parseIntBase(s, 10) }

// An int in base 2..36 with an optional sign; letters in either case. No
// prefix ("0x") is accepted: strip it first.
pub fn parseIntBase(s: str, base: int): Result[int, ParseError] {
    if base < 2 || base > 36 { panic("strings.parseIntBase: base must be 2..36") }
    var i = 0
    var neg = false
    if len(s) > 0 && (strByte(s, 0) == '-' || strByte(s, 0) == '+') {
        neg = strByte(s, 0) == '-'
        i = 1
    }
    if i == len(s) { return Err(ParseError.Empty) }
    var n: i128 = 0
    while i < len(s) {
        let d = digitValue(strByte(s, i))
        if d < 0 || d >= base { return Err(ParseError.Invalid(i)) }
        n = n * i128(base) + i128(d)
        if n > 9223372036854775808 { return Err(ParseError.OutOfRange) }
        i += 1
    }
    if neg { n = -n }
    if n > 9223372036854775807 { return Err(ParseError.OutOfRange) }
    return Ok(int(n))
}

fn digitValue(c: byte): int {
    if c >= '0' && c <= '9' { return int(c - '0') }
    if c >= 'a' && c <= 'z' { return int(c - 'a') + 10 }
    if c >= 'A' && c <= 'Z' { return int(c - 'A') + 10 }
    return -1
}

// n in base 2..36, lower-case letters, "-" when negative.
pub fn formatInt(n: int, base: int): str {
    if base < 2 || base > 36 { panic("strings.formatInt: base must be 2..36") }
    if n == 0 { return "0" }
    let digits = "0123456789abcdefghijklmnopqrstuvwxyz"
    var v = i128(n)
    var neg = false
    if v < 0 {
        neg = true
        v = -v
    }
    var bs: []byte = []
    while v > 0 {
        append(mut &bs, strByte(digits, int(v % i128(base))))
        v = v / i128(base)
    }
    if neg { append(mut &bs, '-') }
    reverseBytes(mut &bs)
    return strFromBytes(&bs)
}

fn reverseBytes(bs: mut &[]byte) {
    var i = 0
    var j = len(bs) - 1
    while i < j {
        swap(bs, i, j)
        i += 1
        j -= 1
    }
}

// n in lower-case hexadecimal ("ff"; "-1a" when negative).
pub fn hex(n: int): str { return formatInt(n, 16) }

// The 64 bits of n as hexadecimal, zero-padded to 16 digits.
pub fn hex64(n: u64): str {
    let digits = "0123456789abcdef"
    var bs = array(16, '0')
    var v = n
    var i = 15
    while v != 0 {
        bs[i] = strByte(digits, int(v & 15))
        v = v >> 4
        i -= 1
    }
    return strFromBytes(&bs)
}

// n in decimal, at least width digits with leading zeros: zeroPad(7, 3) is
// "007", zeroPad(-7, 3) is "-007".
pub fn zeroPad(n: int, width: int): str {
    var digits = intToStr(n)
    var sign = ""
    if n < 0 {
        sign = "-"
        digits = strSlice(digits, 1, len(digits))
    }
    return sign + padLeft(digits, width, '0')
}

// n with sep between groups of three digits: 1234567 is "1,234,567".
pub fn groupDigits(n: int, sep: str): str {
    let s = intToStr(n)
    var start = 0
    if n < 0 { start = 1 }
    var b = newStrBuf()
    b.add(strSlice(s, 0, start))
    for i in start..len(s) {
        if i > start && (len(s) - i) % 3 == 0 { b.add(sep) }
        b.addByte(strByte(s, i))
    }
    return b.toStr()
}

// ------------------------------------------------------------ padding

// s with fill bytes before it, to width bytes (s itself if it is as long).
pub fn padLeft(s: str, width: int, fill: byte): str {
    if len(s) >= width { return s }
    return strFromBytes(&array(width - len(s), fill)) + s
}

pub fn padRight(s: str, width: int, fill: byte): str {
    if len(s) >= width { return s }
    return s + strFromBytes(&array(width - len(s), fill))
}

// s centred in width bytes; an odd fill byte goes on the right.
pub fn center(s: str, width: int, fill: byte): str {
    if len(s) >= width { return s }
    let left = (width - len(s)) / 2
    return padRight(padLeft(s, len(s) + left, fill), width, fill)
}

// ------------------------------------------------------------ UTF-8

// A code point decoded from UTF-8 and the number of bytes it took. Invalid
// input decodes as U+FFFD (ok false) and takes the maximal invalid subpart:
// one byte, or the bytes of a sequence that started well and was cut short
// ("\xE2\x82(" is one U+FFFD then "("), as Unicode recommends and Rust's
// from_utf8_lossy does.
pub type Decoded = value record {
    pub rune: int
    pub size: int
    pub ok: bool
}

pub const REPLACEMENT = 0xFFFD

// The code point starting at byte i of s (0 <= i < len(s)).
pub fn decodeAt(s: str, i: int): Decoded {
    let c0 = int(strByte(s, i))
    if c0 < 0x80 { return Decoded{rune: c0, size: 1, ok: true} }
    var n = 0
    var r = 0
    var lo = 0x80   // the range of the second byte
    var hi = 0xBF
    if c0 >= 0xC2 && c0 <= 0xDF {
        n = 2
        r = c0 & 0x1F
    } else if c0 >= 0xE0 && c0 <= 0xEF {
        n = 3
        r = c0 & 0x0F
        if c0 == 0xE0 { lo = 0xA0 }   // no overlong forms
        if c0 == 0xED { hi = 0x9F }   // no surrogates
    } else if c0 >= 0xF0 && c0 <= 0xF4 {
        n = 4
        r = c0 & 0x07
        if c0 == 0xF0 { lo = 0x90 }
        if c0 == 0xF4 { hi = 0x8F }   // nothing past U+10FFFF
    } else {
        return Decoded{rune: REPLACEMENT, size: 1, ok: false}
    }
    for k in 1..n {
        if i + k >= len(s) { return Decoded{rune: REPLACEMENT, size: k, ok: false} }
        let c = int(strByte(s, i + k))
        if c < lo || c > hi { return Decoded{rune: REPLACEMENT, size: k, ok: false} }
        r = (r << 6) | (c & 0x3F)
        lo = 0x80
        hi = 0xBF
    }
    return Decoded{rune: r, size: n, ok: true}
}

// The code points of s.
pub fn runes(s: str): []int {
    var out: []int = []
    var i = 0
    while i < len(s) {
        let d = decodeAt(s, i)
        append(mut &out, d.rune)
        i += d.size
    }
    return out
}

// The number of code points in s (each invalid byte counts as one).
pub fn runeCount(s: str): int {
    var n = 0
    var i = 0
    while i < len(s) {
        i += decodeAt(s, i).size
        n += 1
    }
    return n
}

// Whether s is valid UTF-8.
pub fn isValidUtf8(s: str): bool {
    var i = 0
    while i < len(s) {
        if strByte(s, i) < 0x80 {
            i += 1
        } else {
            let d = decodeAt(s, i)
            if !d.ok { return false }
            i += d.size
        }
    }
    return true
}

// s with each invalid part (decodeAt) replaced by U+FFFD; s itself when it
// is valid UTF-8.
pub fn lossy(s: str): str {
    if isValidUtf8(s) { return s }
    var b = newStrBuf()
    var i = 0
    while i < len(s) {
        let d = decodeAt(s, i)
        if d.ok { b.add(s[i..i + d.size]) } else { addRune(mut &b, REPLACEMENT) }
        i += d.size
    }
    return b.toStr()
}

// Appends the UTF-8 encoding of r to b (U+FFFD for an invalid code point).
pub fn addRune(b: mut &StrBuf, r: int) {
    var c = r
    if c < 0 || c > 0x10FFFF || (c >= 0xD800 && c <= 0xDFFF) { c = REPLACEMENT }
    if c < 0x80 {
        b.addByte(byte(c))
    } else if c < 0x800 {
        b.addByte(byte(0xC0 | (c >> 6)))
        b.addByte(byte(0x80 | (c & 0x3F)))
    } else if c < 0x10000 {
        b.addByte(byte(0xE0 | (c >> 12)))
        b.addByte(byte(0x80 | ((c >> 6) & 0x3F)))
        b.addByte(byte(0x80 | (c & 0x3F)))
    } else {
        b.addByte(byte(0xF0 | (c >> 18)))
        b.addByte(byte(0x80 | ((c >> 12) & 0x3F)))
        b.addByte(byte(0x80 | ((c >> 6) & 0x3F)))
        b.addByte(byte(0x80 | (c & 0x3F)))
    }
}

// The UTF-8 text of one code point.
pub fn fromRune(r: int): str {
    var b = newStrBuf()
    addRune(mut &b, r)
    return b.toStr()
}

// The UTF-8 text of code points.
pub fn fromRunes(rs: &[int]): str {
    var b = newStrBuf()
    for r in rs { addRune(mut &b, r) }
    return b.toStr()
}

// The display width of s in a terminal columns: the width of each code
// point as unicode-width 0.1.14 gives it (East Asian wide and fullwidth forms
// and emoji 2, combining marks, format and control characters 0), and 1 for
// each invalid part (it shows as U+FFFD).
pub fn displayWidth(s: str): int {
    var w = 0
    var i = 0
    while i < len(s) {
        let c = strByte(s, i)
        if c >= 0x20 && c < 0x7F {
            w += 1
            i += 1
        } else {
            let d = decodeAt(s, i)
            w += if d.ok { runeWidth(d.rune) } else { 1 }
            i += d.size
        }
    }
    return w
}

// The columns of one code point (unicode-width 0.1.14).
pub fn runeWidth(r: int): int {
    if r < 0x20 || (r >= 0x7F && r < 0xA0) { return 0 }
    if r < 0x7F { return 1 }
    // binary search for the last range that starts at or before r
    var a = 0
    var b = len(WIDTHS) / 3
    while a < b {
        let m = (a + b) / 2
        if WIDTHS[3 * m] <= r { a = m + 1 } else { b = m }
    }
    if a > 0 && r <= WIDTHS[3 * a - 2] { return WIDTHS[3 * a - 1] }
    return 1
}

// Code point ranges whose width is not 1, as (first, last, width) triples in
// order; generated from unicode-width 0.1.14's per-character widths.
const WIDTHS: []int = [
    0xAD, 0xAD, 0, 0x300, 0x36F, 0, 0x483, 0x489, 0, 0x591, 0x5BD, 0, 0x5BF, 0x5BF, 0,
    0x5C1, 0x5C2, 0, 0x5C4, 0x5C5, 0, 0x5C7, 0x5C7, 0, 0x605, 0x605, 0, 0x610, 0x61A, 0,
    0x61C, 0x61C, 0, 0x64B, 0x65F, 0, 0x670, 0x670, 0, 0x6D6, 0x6DC, 0, 0x6DF, 0x6E4, 0,
    0x6E7, 0x6E8, 0, 0x6EA, 0x6ED, 0, 0x70F, 0x70F, 0, 0x711, 0x711, 0, 0x730, 0x74A, 0,
    0x7A6, 0x7B0, 0, 0x7EB, 0x7F3, 0, 0x7FD, 0x7FD, 0, 0x816, 0x819, 0, 0x81B, 0x823, 0,
    0x825, 0x827, 0, 0x829, 0x82D, 0, 0x859, 0x85B, 0, 0x890, 0x891, 0, 0x898, 0x89F, 0,
    0x8CA, 0x902, 0, 0x93A, 0x93A, 0, 0x93C, 0x93C, 0, 0x941, 0x948, 0, 0x94D, 0x94D, 0,
    0x951, 0x957, 0, 0x962, 0x963, 0, 0x981, 0x981, 0, 0x9BC, 0x9BC, 0, 0x9BE, 0x9BE, 0,
    0x9C1, 0x9C4, 0, 0x9CD, 0x9CD, 0, 0x9D7, 0x9D7, 0, 0x9E2, 0x9E3, 0, 0x9FE, 0x9FE, 0,
    0xA01, 0xA02, 0, 0xA3C, 0xA3C, 0, 0xA41, 0xA42, 0, 0xA47, 0xA48, 0, 0xA4B, 0xA4D, 0,
    0xA51, 0xA51, 0, 0xA70, 0xA71, 0, 0xA75, 0xA75, 0, 0xA81, 0xA82, 0, 0xABC, 0xABC, 0,
    0xAC1, 0xAC5, 0, 0xAC7, 0xAC8, 0, 0xACD, 0xACD, 0, 0xAE2, 0xAE3, 0, 0xAFA, 0xAFF, 0,
    0xB01, 0xB01, 0, 0xB3C, 0xB3C, 0, 0xB3E, 0xB3F, 0, 0xB41, 0xB44, 0, 0xB4D, 0xB4D, 0,
    0xB55, 0xB57, 0, 0xB62, 0xB63, 0, 0xB82, 0xB82, 0, 0xBBE, 0xBBE, 0, 0xBC0, 0xBC0, 0,
    0xBCD, 0xBCD, 0, 0xBD7, 0xBD7, 0, 0xC00, 0xC00, 0, 0xC04, 0xC04, 0, 0xC3C, 0xC3C, 0,
    0xC3E, 0xC40, 0, 0xC46, 0xC48, 0, 0xC4A, 0xC4D, 0, 0xC55, 0xC56, 0, 0xC62, 0xC63, 0,
    0xC81, 0xC81, 0, 0xCBC, 0xCBC, 0, 0xCBF, 0xCC0, 0, 0xCC2, 0xCC2, 0, 0xCC6, 0xCC8, 0,
    0xCCA, 0xCCD, 0, 0xCD5, 0xCD6, 0, 0xCE2, 0xCE3, 0, 0xD00, 0xD01, 0, 0xD3B, 0xD3C, 0,
    0xD3E, 0xD3E, 0, 0xD41, 0xD44, 0, 0xD4D, 0xD4E, 0, 0xD57, 0xD57, 0, 0xD62, 0xD63, 0,
    0xD81, 0xD81, 0, 0xDCA, 0xDCA, 0, 0xDCF, 0xDCF, 0, 0xDD2, 0xDD4, 0, 0xDD6, 0xDD6, 0,
    0xDDF, 0xDDF, 0, 0xE31, 0xE31, 0, 0xE34, 0xE3A, 0, 0xE47, 0xE4E, 0, 0xEB1, 0xEB1, 0,
    0xEB4, 0xEBC, 0, 0xEC8, 0xECE, 0, 0xF18, 0xF19, 0, 0xF35, 0xF35, 0, 0xF37, 0xF37, 0,
    0xF39, 0xF39, 0, 0xF71, 0xF7E, 0, 0xF80, 0xF84, 0, 0xF86, 0xF87, 0, 0xF8D, 0xF97, 0,
    0xF99, 0xFBC, 0, 0xFC6, 0xFC6, 0, 0x102D, 0x1030, 0, 0x1032, 0x1037, 0, 0x1039, 0x103A, 0,
    0x103D, 0x103E, 0, 0x1058, 0x1059, 0, 0x105E, 0x1060, 0, 0x1071, 0x1074, 0, 0x1082, 0x1082, 0,
    0x1085, 0x1086, 0, 0x108D, 0x108D, 0, 0x109D, 0x109D, 0, 0x1100, 0x115F, 2, 0x1160, 0x11FF, 0,
