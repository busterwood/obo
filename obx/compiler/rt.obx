    "    obx_str s = rt_str_new(len);",
    "    if (len) memcpy(s.b->data, p, (size_t)len);",
    "    return s;",
    "}",
    "static obx_str rt_str_dup(obx_str s) { if (s.b && s.b->rc >= 0) s.b->rc++; return s; }",
