    "    else if (!(c1 >> 22 & 1)) miss = \"MOVBE\";",
    "    else if (!(c1 >> 29 & 1)) miss = \"F16C\";",
    "    else if (!(b7 >> 5 & 1)) miss = \"AVX2\";",
    "    else if (!(b7 >> 3 & 1)) miss = \"BMI1\";",
