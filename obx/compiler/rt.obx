    "static void rt_cpu_check(void) {",
    "    unsigned a = 0, b, c = 0, d;",
    "    __asm__ volatile(\"cpuid\" : \"+a\"(a), \"=b\"(b), \"+c\"(c), \"=d\"(d));",
    "    unsigned top = a;",
    "    a = 1; c = 0;",
    "    __asm__ volatile(\"cpuid\" : \"+a\"(a), \"=b\"(b), \"+c\"(c), \"=d\"(d));",
