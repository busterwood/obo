// dump: --dump-ast, the canonical line-oriented dump of a module's tree.
// The same text as ref/dump.py (the format is in ref/README.md, "AST dump").

import "./syntax" as sx

type Dumper = record {
    out: []byte
}

fn (d: mut &Dumper) add(s: str) {
    for i in 0..len(s) { append(mut &d.out, strByte(s, i)) }
}

fn (d: mut &Dumper) addInt(n: int) { d.add(intToStr(n)) }

// The start of a line: indentation and the label.
fn (d: mut &Dumper) label(depth: int, label: str) {
    for i in 0..depth {
        append(mut &d.out, ' ')
        append(mut &d.out, ' ')
    }
    d.add(label)
    d.add(": ")
}

fn (d: mut &Dumper) indexLabel(depth: int, i: int) {
    d.label(depth, intToStr(i))
}

fn (d: mut &Dumper) end() { append(mut &d.out, '\n') }

fn (d: mut &Dumper) none(depth: int, label: str) {
    d.label(depth, label)
    d.add("-\n")
}

// A node line's kind and line: "kind 12" or "kind -".
fn (d: mut &Dumper) head(a: &sx.Ast, n: int) {
    d.add(sx.KIND_NAMES[a.nodes[n].kind])
    let line = a.nodes[n].line
    if line == 0 {
        d.add(" -")
    } else {
        append(mut &d.out, ' ')
        d.addInt(line)
    }
}

fn (d: mut &Dumper) scalar(name: str, v: str) {
    append(mut &d.out, ' ')
    d.add(name)
    append(mut &d.out, '=')
    d.add(v)
}

fn (d: mut &Dumper) flag(a: &sx.Ast, n: int, name: str, f: int) {
    if a.has(n, f) {
        d.scalar(name, "true")
    } else {
        d.scalar(name, "false")
    }
}

fn (d: mut &Dumper) optName(name: str, v: str) {
    if len(v) == 0 {
        d.scalar(name, "-")
    } else {
        d.scalar(name, v)
    }
}

// A string value: printable ASCII as is except \ and ", other bytes as \xHH.
fn (d: mut &Dumper) quoted(name: str, s: str) {
    append(mut &d.out, ' ')
    d.add(name)
    d.add("=\"")
    for i in 0..len(s) {
        let c = strByte(s, i)
        if c == '\\' {
            d.add("\\\\")
        } else if c == '"' {
            d.add("\\\"")
        } else if c >= 32 && c < 127 {
            append(mut &d.out, c)
        } else {
            d.add("\\x")
            let digits = "0123456789abcdef"
            append(mut &d.out, strByte(digits, int(c >> 4)))
            append(mut &d.out, strByte(digits, int(c & 15)))
        }
    }
    append(mut &d.out, '"')
}

// A name list (N_IDENT nodes): [a,b], or - when absent.
fn (d: mut &Dumper) names(a: &sx.Ast, name: str, list: int) {
    append(mut &d.out, ' ')
    d.add(name)
    append(mut &d.out, '=')
    if list < 0 {
        append(mut &d.out, '-')
        return
    }
    append(mut &d.out, '[')
    for i in 0..a.count(list) {
        if i > 0 { append(mut &d.out, ',') }
        d.add(a.nodes[a.item(list, i)].s)
    }
    append(mut &d.out, ']')
}

fn (d: mut &Dumper) intValue(a: &sx.Ast, n: int) {
    d.add(" v=")
    let s = a.nodes[n].s
    if a.has(n, sx.MINUS) && s != "0" { append(mut &d.out, '-') }
    d.add(s)
}

// A list field: "label: [n]", then its items.
fn (d: mut &Dumper) list(a: &sx.Ast, depth: int, label: str, list: int) {
    if list < 0 {
        d.none(depth, label)
        return
    }
    let n = a.count(list)
    d.label(depth, label)
    append(mut &d.out, '[')
    d.addInt(n)
    d.add("]\n")
    for i in 0..n { d.node(a, depth + 1, intToStr(i), a.item(list, i)) }
}

fn (d: mut &Dumper) opt(a: &sx.Ast, depth: int, label: str, n: int) {
    if n < 0 {
        d.none(depth, label)
    } else {
        d.node(a, depth, label, n)
    }
}

fn (d: mut &Dumper) node(a: &sx.Ast, depth: int, label: str, n: int) {
    let k = a.nodes[n].kind
    let x = depth + 1
    let na = a.nodes[n].a
    let nb = a.nodes[n].b
    let nc = a.nodes[n].c
    d.label(depth, label)
    d.head(a, n)
    if k == sx.N_IMPORT {
        d.quoted("path", a.nodes[n].s)
        d.optName("alias", a.nodes[n].t)
        d.end()
    } else if k == sx.N_TYPE {
        d.scalar("name", a.nodes[n].s)
        d.flag(a, n, "pub", sx.PUB)
        let forms: []str = ["record", "closed", "interface", "alias"]
        d.scalar("form", forms[nb])
        if nb == sx.F_RECORD || nb == sx.F_CLOSED { d.flag(a, n, "value", sx.VALUE) }
        d.end()
        d.list(a, x, "tparams", na)
        if nb == sx.F_RECORD {
            d.list(a, x, "fields", nc)
        } else if nb == sx.F_CLOSED {
            d.list(a, x, "variants", nc)
        } else if nb == sx.F_INTERFACE {
            d.list(a, x, "members", nc)
        } else {
            d.node(a, x, "target", nc)
        }
    } else if k == sx.N_FN {
        d.scalar("name", a.nodes[n].s)
        d.flag(a, n, "pub", sx.PUB)
        if a.has(n, sx.EXTERN) {
            d.quoted("extern", a.nodes[n].t)
            d.quoted("cname", a.nodes[n].u)
            if a.has(n, sx.DOTS) { d.scalar("varargs", "true") }
            if a.has(n, sx.BLOCKING) { d.scalar("blocking", "true") }
        } else {
            d.add(" extern=- cname=-")
        }
        d.end()
        d.opt(a, x, "recv", na)
        d.list(a, x, "tparams", nb)
        d.list(a, x, "params", nc)
        d.opt(a, x, "ret", a.nodes[n].d)
        d.opt(a, x, "body", a.nodes[n].e)
    } else if k == sx.N_CONST {
        d.scalar("name", a.nodes[n].s)
        d.flag(a, n, "pub", sx.PUB)
        d.end()
        d.opt(a, x, "ty", na)
        d.node(a, x, "e", nb)
    } else if k == sx.N_GLOBAL {
        d.scalar("name", a.nodes[n].s)
        d.flag(a, n, "pub", sx.PUB)
        d.flag(a, n, "once", sx.ONCE)
        d.end()
        d.node(a, x, "ty", na)
        d.opt(a, x, "e", nb)
    } else if k == sx.N_TPARAM {
        d.scalar("name", a.nodes[n].s)
        d.end()
        d.list(a, x, "cons", na)
    } else if k == sx.N_FIELD {
        d.scalar("name", a.nodes[n].s)
        d.flag(a, n, "pub", sx.PUB)
        d.end()
        d.node(a, x, "ty", na)
    } else if k == sx.N_VARIANT {
        d.scalar("name", a.nodes[n].s)
        d.flag(a, n, "named", sx.NAMED)
        d.end()
        d.list(a, x, "fields", na)
    } else if k == sx.N_MEMBER {
        d.scalar("name", a.nodes[n].s)
        let modes: []str = ["-", "val", "ref", "mut"]
        d.scalar("mode", modes[nc])
        d.end()
        d.list(a, x, "params", na)
        d.opt(a, x, "ret", nb)
    } else if k == sx.N_RECV {
        d.optName("name", a.nodes[n].s)
        if a.has(n, sx.VAR) { d.scalar("var", "true") }
        d.end()
        d.node(a, x, "ty", na)
    } else if k == sx.N_PARAM {
        d.scalar("name", a.nodes[n].s)
        d.flag(a, n, "var", sx.VAR)
        d.end()
        d.node(a, x, "ty", na)
    } else if k == sx.N_COPY || k == sx.N_TNEVER || k == sx.N_BREAK || k == sx.N_CONTINUE {
        d.end()
    } else if k == sx.N_TREF || k == sx.N_TSLICE {
        d.flag(a, n, "mut", sx.MUT)
        d.end()
        d.node(a, x, "t", na)
    } else if k == sx.N_TARR {
        d.end()
        d.node(a, x, "t", na)
    } else if k == sx.N_TFN {
        if a.has(n, sx.EXTERN) { d.flag(a, n, "extern", sx.EXTERN) }
        d.end()
        d.list(a, x, "params", na)
        d.opt(a, x, "ret", nb)
    } else if k == sx.N_TNAME {
        d.names(a, "parts", na)
        d.end()
        d.list(a, x, "args", nb)
    } else if k == sx.N_BLOCK {
        d.end()
        d.list(a, x, "stmts", na)
    } else if k == sx.N_LET {
        d.scalar("name", a.nodes[n].s)
        d.flag(a, n, "mutable", sx.MUTABLE)
        d.end()
        d.opt(a, x, "ty", na)
        d.node(a, x, "e", nb)
    } else if k == sx.N_DESTRUCTURE {
        d.flag(a, n, "mutable", sx.MUTABLE)
        d.end()
        d.node(a, x, "ty", na)
        d.list(a, x, "fields", nb)
        d.node(a, x, "e", nc)
    } else if k == sx.N_FIELDPAT {
        d.scalar("field", a.nodes[n].s)
        d.scalar("bind", a.nodes[n].t)
        d.end()
    } else if k == sx.N_IF {
        d.end()
        d.node(a, x, "cond", na)
        d.node(a, x, "then", nb)
        d.opt(a, x, "els", nc)
    } else if k == sx.N_WHILE {
        d.end()
        d.node(a, x, "cond", na)
        d.node(a, x, "body", nb)
    } else if k == sx.N_FOR {
        d.scalar("name", a.nodes[n].s)
        d.end()
        d.node(a, x, "a", na)
        d.opt(a, x, "b", nb)
        d.node(a, x, "body", nc)
    } else if k == sx.N_RETURN {
        d.end()
        d.opt(a, x, "e", na)
    } else if k == sx.N_MATCH || k == sx.N_MATCHX {
        d.end()
        d.node(a, x, "e", na)
        d.list(a, x, "arms", nb)
    } else if k == sx.N_ARM {
        d.optName("variant", a.nodes[n].s)
        d.names(a, "vpath", na)
        d.names(a, "binds", nb)
        d.end()
        d.list(a, x, "lits", nc)
        d.node(a, x, "body", a.nodes[n].d)
    } else if k == sx.N_ASSIGN {
        d.optName("op", a.nodes[n].s)
        d.end()
        d.node(a, x, "target", na)
        d.node(a, x, "e", nb)
    } else if k == sx.N_EXPR || k == sx.N_TRY {
        d.end()
        d.node(a, x, "e", na)
    } else if k == sx.N_IFX {
        d.end()
        d.node(a, x, "cond", na)
        d.node(a, x, "then", nb)
        d.node(a, x, "els", nc)
    } else if k == sx.N_LNAME {
        d.names(a, "v", na)
        d.end()
    } else if k == sx.N_LINT {
        d.intValue(a, n)
        d.end()
    } else if k == sx.N_LCHAR || k == sx.N_CHAR {
        d.add(" v=")
        d.addInt(na)
        d.end()
    } else if k == sx.N_LSTR || k == sx.N_STR {
        d.quoted("v", a.nodes[n].s)
        d.end()
    } else if k == sx.N_INT {
        d.intValue(a, n)
        d.flag(a, n, "neg", sx.NEG)
        d.end()
    } else if k == sx.N_FRAC || k == sx.N_NAME {
        d.scalar("v", a.nodes[n].s + (if k == sx.N_FRAC && na == 1 { "f" } else if k == sx.N_FRAC && na == 2 { "m" } else { "" }))
        d.end()
    } else if k == sx.N_BOOL {
        d.flag(a, n, "v", sx.TRUE)
        d.end()
    } else if k == sx.N_ARRLIT {
        d.end()
        d.list(a, x, "items", na)
    } else if k == sx.N_CLOSURE {
        d.end()
        d.list(a, x, "params", na)
        d.opt(a, x, "ret", nb)
        d.node(a, x, "body", nc)
    } else if k == sx.N_CPARAM {
        d.scalar("name", a.nodes[n].s)
        d.end()
        d.opt(a, x, "ty", na)
    } else if k == sx.N_BIN {
        d.scalar("op", a.nodes[n].s)
        d.end()
        d.node(a, x, "l", na)
        d.node(a, x, "r", nb)
    } else if k == sx.N_UN {
        d.scalar("op", a.nodes[n].s)
        d.end()
        d.node(a, x, "e", na)
    } else if k == sx.N_BORROW {
        d.flag(a, n, "mut", sx.MUT)
        d.end()
        d.node(a, x, "e", na)
    } else if k == sx.N_FIELDX {
        d.scalar("name", a.nodes[n].s)
        d.end()
        d.node(a, x, "e", na)
    } else if k == sx.N_SUB {
        d.end()
        d.node(a, x, "e", na)
        d.opt(a, x, "lo", nb)
        d.opt(a, x, "hi", nc)
    } else if k == sx.N_INDEX {
        d.end()
        d.node(a, x, "e", na)
        d.list(a, x, "items", nb)
    } else if k == sx.N_CALL {
        d.end()
        d.node(a, x, "fn", na)
        d.list(a, x, "args", nb)
    } else if k == sx.N_LIT {
        d.end()
        d.node(a, x, "ty", na)
        d.list(a, x, "inits", nb)
    } else if k == sx.N_INIT {
        d.scalar("name", a.nodes[n].s)
        d.end()
        d.node(a, x, "e", na)
    } else if k == sx.N_TARG {
        d.end()
        d.node(a, x, "ty", na)
    } else {
        panic("dump: unknown node kind " + intToStr(k))
    }
}

// The dump of a module, as text.
pub fn dumpAst(a: &sx.Ast): str {
    var d = Dumper{out: []}
    d.add("module: ")
    d.add(a.fname)
    d.end()
    d.list(a, 1, "imports", a.imports)
    d.list(a, 1, "decls", a.decls)
    return strFromBytes(&d.out)
}
