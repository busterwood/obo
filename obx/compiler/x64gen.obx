// x64gen: the x86-64 target layer (design/native.md, sections 3 to 6): instruction
// selection, the SysV calling convention, frames, and the link of the program with the
// runtime of rtx.obx. Its input is the IR (ir.obx); it emits machine code through the
// encoder (x64.obx) and hands the segments to the executable writer (elf.obx).
//
// build(p, libs) generates code for every function, lays out the data, links and returns the
// bytes of an ELF executable: a static one when libs is empty, else one dynamically linked
// with those libraries (design/native.md, "Dynamic linking"; dynNames says which).
//
// Code generation is simple and correct first (section 4): every local has a stack slot
// (rbp-relative); an expression's value is in rax (integers and pointers, normalized to 64
// bits from their type), rax:rdx (128-bit integers), xmm0 (double), or, for a struct or
// array, rax holds its address. Temporaries are stack slots that live until the end of
// the statement. rsp is fixed in a function's body; the outgoing-argument area is at its
// bottom.

import "./ir"
import "./x64"
import "./elf"
import "./rtx"
import "strings"

const RAX = 0
const RCX = 1
const RDX = 2
const RSP = 4
const RBP = 5
const RSI = 6
const RDI = 7
const R8 = 8
const R9 = 9
const R10 = 10
const R11 = 11

const INT_REGS: []int = [7, 6, 2, 1, 8, 9]       // rdi rsi rdx rcx r8 r9
const NO_MEM: x64.Mem = x64.Mem{base: -9, index: -1, scale: 1, disp: 0}
const LOCAL_REGS: []int = [3, 12, 13, 14, 15]     // rbx r12-r15 (callee-saved): locals
// Caller-saved registers that the code generator uses only for calls and for the operations
// that make a statement loud (scan): locals whose live range has no loud statement.
const QUIET_REGS: []int = [6, 7, 8, 9]            // rsi rdi r8 r9

// The largest frame that needs no stack probe: below a page, so that no access of the frame
// (nor the return address of a call from it) can skip the guard page.
const PROBE_FREE = 2048

// Functions start at multiples of this (the code segment's base is one): where a function falls
// in the fetch blocks changes the speed of a small recursive one by 15% (bench fib). int3 pads.
const FUNC_ALIGN = 16

// The generated code starts at a multiple of this, so FUNC_ALIGN holds for absolute addresses.
const CODE_ALIGN = 64

// A function that restores at most this many registers returns with a copy of the restores in
// place of a jump to its one copy.
const EPI_COPY = 2

// Symbol kinds.
const SK_FUNC = 0        // idx: a function with a body
const SK_GLOBAL = 1      // idx: a global
const SK_STR = 2         // idx: a string literal in rodata
const SK_ABS = 3         // addr: a runtime symbol
const SK_DYN = 4         // idx: an imported function (its GOT entry)

type Sym = value record {
    kind: int
    idx: int
    addr: int
}

type DataReloc = value record {
    ro: bool            // in rodata (else data)
    off: int
    sym: int
    addend: int
}

// Eightbyte classes (SysV): a value's list of them, or [CL_MEM].
const CL_NONE = 0
const CL_INT = 1
const CL_SSE = 2
const CL_MEM = -1

// Condition codes of float compares that need two flags.
const CC_FEQ = -2
const CC_FNE = -3

type Gen = record {
    u: ir.Ir
    a: x64.Asm
    syms: []Sym
    rtAddr: Map[str, int]
    funcSym: []int
    globalSym: []int
    strSym: Map[str, int]
    strs: []str
    funcPos: []int
    slots: []int
    reg: []int                  // per local: its register, or -1 (in its slot)
    uses: []int                 // per local: the times the function being generated names it
    weight: []int               // ... weighted by loop depth
    bad: []bool                 // ... whether it can't be in a register
    touched: []int              // the locals the scan of the function saw
    seen: []int                 // per local: the stamp of the last scan that touched it
    stamp: int
    counting: bool              // the scan counts uses (once, before code generation)
    scanStack: []int            // the functions whose bodies the scan is in, in place of calls
    first: []int                // per local: the first and last position the scan saw it at
    last: []int
    noInit: []int               // ... the loop (regions) it is declared in without an initializer, or -1
    inner: []bool               // ... a local of a function generated in place: live only at its calls
    pts: [][]int                // ... the positions it is named at, in order
    unused: bool                // genAssign: the value of the assignment generated next is not used
    tmpRegs: []int              // the registers of QUIET_REGS no local of the function has
    tmpUsed: int                // ... the number of them holding a temporary (pair)
    defAt: []int                // per local: the position of its declaration with an initializer, or -1
    tailEnd: []int              // per position: in the statements before a return that run straight
                                // into it, the return's position; else -1
    pos: int                    // the scan's position: its count of statements
    scanExpr: int               // > 0: the scan is in the body of a call generated in place (one position)
    loud: []bool                // per position: its code may change rsi, rdi, r8 or r9 (calls, ...)
    regions: []int              // the loops: first and last position of each
    openLoops: []int            // the regions the scan is in
    inlStack: []int             // the functions generated in place being generated
    inlEnd: []int               // ... the labels after their code
    inl: []int                  // per function: the size of its body if it can be generated in place
                                // of calls, else INLINE_NODES + 1 (-1: not yet known)
    loops: int                  // the loops the code generator is in (the scan's depth)
    curFunc: int
    callDest: x64.Mem           // for the next genCall: where its aggregate result goes (or base -9)
    callFresh: bool             // ... a new local (it may be the hidden result pointer)
    destUsed: bool              // genCall put the result there
    aTaken: []bool              // per local: its address (or a member's) is taken
    emptyS: int                 // an S_EMPTY node
    saved: []int                // the frame slots of the callee-saved registers the function uses
    frame: int
    maxFrame: int
    outArgs: int
    declMark: int
    breakL: []int
    contL: []int
    caseL: Map[int, int]
    retPtr: int
    retTy: int
    epiL: int                   // the label of the function's restores and return, or -1
    epiJmps: []int              // ... the positions of the jumps to it
    loopTops: []int             // the labels of the rotated loops' bodies, reached only by jumps
    loopEnds: []int             // and of their ends (right after the back branch)
    entrySym: int
    dyn: bool                   // dynamically linked: every C function the program calls is imported
    libs: []elf.Lib
    imports: []str              // the imported functions, in dynamic symbol order
    importSym: Map[str, int]
    stubs: []Stub               // the trap paths of the inlined runtime checks, after the function
    stubOf: Map[str, int]       // their labels by (code, where)
    codeEnd: int
    posOf: []int                // per node: the position the scan saw it at (posSeen: when), or -1 (at several)
    posSeen: []int
    inlPos: int                 // the position of the outermost call being generated in place
    held: []int                 // the callee-saved registers holding temporaries (hold), innermost last
    nLocalRegs: int             // the callee-saved registers some local has: LOCAL_REGS[0..nLocalRegs)
    bareRet: bool               // a return with no restores was generated: no register can be saved anew
}

// A call of rt_trap(code, msg, where) out of line, at the end of a function: its label.
type Stub = value record {
    label: int
    code: int
    msg: str
    where: int          // the node of the location string
}

fn newGen(u: ir.Ir): Gen {
    var g = Gen{u: u, a: x64.newAsm(), syms: [], rtAddr: newMap(), funcSym: [], globalSym: [], strSym: newMap(),
        strs: [], funcPos: [], slots: [], frame: 0, maxFrame: 0, outArgs: 0, declMark: 0, breakL: [], contL: [],
        caseL: newMap(), retPtr: 0, retTy: 0, epiL: -1, epiJmps: [], loopTops: [], loopEnds: [], entrySym: -1, dyn: false, libs: [], imports: [], importSym: newMap(), stubs: [],
        stubOf: newMap(), codeEnd: 0, reg: [], uses: [], weight: [], bad: [], touched: [], first: [], last: [],
        noInit: [], inner: [], pts: [], defAt: [], tmpRegs: [], tmpUsed: 0, unused: false, tailEnd: [], pos: 0, scanExpr: 0, loud: [], regions: [], openLoops: [],
        saved: [], seen: [], stamp: 1, counting: false, scanStack: [], inlStack: [], inlEnd: [], inl: [], curFunc: -1,
        loops: 0, aTaken: [], emptyS: -1, callDest: NO_MEM, callFresh: false, destUsed: false, posOf: [], posSeen: [],
        inlPos: -1, held: [], nLocalRegs: 0, bareRet: false}
    g.a.peep = true
    for i in 0..len(rtx.SYM_NAMES) { g.rtAddr.put(rtx.SYM_NAMES[i], rtx.SYM_ADDRS[i]) }
    for i in 0..len(g.u.funcs) {
        append(mut &g.funcSym, -1)
        append(mut &g.funcPos, -1)
        append(mut &g.inl, -1)
    }
    for i in 0..len(g.u.globals) {
        append(mut &g.syms, Sym{kind: SK_GLOBAL, idx: i, addr: 0})
        append(mut &g.globalSym, len(g.syms) - 1)
    }
    for i in 0..len(g.u.locals) {
        append(mut &g.slots, 0)
        append(mut &g.reg, -1)
        append(mut &g.uses, 0)
        append(mut &g.weight, 0)
        append(mut &g.bad, false)
        append(mut &g.seen, 0)
        append(mut &g.aTaken, false)
        append(mut &g.first, 0)
        append(mut &g.last, 0)
        append(mut &g.noInit, -1)
        append(mut &g.inner, false)
        append(mut &g.pts, [])
        append(mut &g.defAt, -1)
    }
    g.countUses()
    g.simplify()
    for i in 0..len(g.u.locals) { g.uses[i] = 0 }
    g.countUses()
    for i in 0..len(g.u.nodes) {
        append(mut &g.posOf, -1)
        append(mut &g.posSeen, 0)
    }
    return g
}

fn (g: &Gen) fail(e: int, msg: str): never { ir.failAt("C line", g.u.nodes[e].line, msg) }

// ---------------------------------------------------------------- the build

// The executable for the program p, linked with libs (static when there are none).
pub fn build(p: ir.Ir, libs: []elf.Lib): []byte {
    var m = ""
    return buildMap(p, libs, mut &m)
}

// build, and in symMap the address, size and name of every function, one per line in hex
// (perf's /tmp/perf-PID.map format; obxc --native writes it to $OBX_NATIVE_MAP).
pub fn buildMap(p: ir.Ir, libs: []elf.Lib, symMap: mut &str): []byte {
    var g = newGen(p)
    g.dyn = len(libs) > 0
    g.libs = libs
    g.genAll()
    let img = g.link()
    let codeBase = ir.alignUp(rtx.TEXT_ADDR + rtx.TEXT_SIZE, CODE_ALIGN)
    var b = newStrBuf()
    var fs: []int = []
    for f in 0..len(g.u.funcs) {
        if g.funcPos[f] >= 0 { append(mut &fs, f) }
    }
    for i in 0..len(fs) {
        let f = fs[i]
        let end = if i + 1 < len(fs) { g.funcPos[fs[i + 1]] } else { g.codeEnd }
        b.add(hex(codeBase + g.funcPos[f]) + " " + hex(end - g.funcPos[f]) + " " + g.u.funcs[f].name + "\n")
    }
    symMap = b.toStr()
    return img
}

fn hex(v: int): str {
    let d = "0123456789abcdef"
    var b = newStrBuf()
    var sh = 60
    var started = false
    while sh >= 0 {
        let x = (v >> sh) & 15
        if x != 0 || started || sh == 0 {
            b.addByte(strByte(d, x))
            started = true
        }
        sh -= 4
    }
    return b.toStr()
}

// The libc functions the runtime calls in a dynamically linked program (rt_n_libc in
// native/rt.c), in the order of that table.
const HOOKS: []str = ["exit", "getenv", "__errno_location"]

// The runtime's C helpers for the library (rt.h's obx_ and obxlib_ functions): always the
// runtime's own, in a dynamic program too.
fn rtHelper(name: str): bool { return startsWith(name, "obx_") || startsWith(name, "obxlib_") }

// The C functions a dynamically linked program imports (to be looked up in its libraries),
// or none when the program can be static: when every C function it calls is in the native
// runtime. A dynamic program imports every C function it calls (the obx_ and obxlib_ helpers
// of the runtime excepted), so that libc's errno, environment, heap and stdio are shared as in the
// C backend, plus libc's entry and the runtime's HOOKS.
pub fn dynNames(p: &ir.Ir): []str {
    var rt: Map[str, bool] = newMap()
    for n in rtx.SYM_NAMES { rt.put(n, true) }
    var need = false
    var seen: Map[str, bool] = newMap()
    var out: []str = ["__libc_start_main"]
    for h in HOOKS { append(mut &out, h) }
    for n in out { seen.put(n, true) }
    for i in 0..len(p.nodes) {
        if p.nodes[i].k != ir.E_FUNC { continue }
        let f = p.nodes[i].a
        if p.funcs[f].body >= 0 || !p.funcs[f].isExtern { continue }
        let name = p.funcs[f].asmName
        if rtHelper(name) { continue }
        if !rt.has(&name) { need = true }
        if !seen.has(&name) {
            seen.put(name, true)
            append(mut &out, name)
        }
    }
    if !need { return [] }
    return out
}

fn (g: mut &Gen) genAll() {
    let main = g.findFunc("main")
    if main < 0 { ir.failAt("C line", 1, "no main function") }
    if g.dyn {
        // the entry, as crt1's _start: __libc_start_main(main, argc, argv, 0, 0, rtld_fini, sp),
        // which calls main and then libc's exit with its result
        g.a.alu(x64.XOR, 4, RBP, RBP)
        g.a.movRR(8, R9, RDX)
        g.a.pop(RSI)
        g.a.movRR(8, RDX, RSP)
        g.a.aluI(x64.AND, 8, RSP, -16)
        g.a.push(RAX)
        g.a.push(RSP)
        g.a.alu(x64.XOR, 4, R8, R8)
        g.a.alu(x64.XOR, 4, RCX, RCX)
        g.a.movRSym(RDI, g.symFunc(main, -1), 0)
        g.a.callAt(g.symImport("__libc_start_main"))
        g.a.ud2()
        for h in HOOKS { g.symImport(h) }
    } else {
        // the entry: rt_n_start(sp, main)
        g.a.movRR(8, RDI, RSP)
        g.a.movRSym(RSI, g.symFunc(main, -1), 0)
        g.a.aluI(x64.AND, 8, RSP, -16)
        g.a.callSym(g.symRt("rt_n_start"))
        g.a.ud2()
    }
    for f in 0..len(g.u.funcs) {
        if g.u.funcs[f].body >= 0 {
            while g.a.pos() % FUNC_ALIGN != 0 { g.a.b(0xCC) }
            g.genFunc(f)
        }
    }
    g.a.fixLabels()
    g.codeEnd = g.a.pos()
}

fn (g: &Gen) findFunc(name: str): int {
    for f in 0..len(g.u.funcs) {
        if g.u.funcs[f].name == name { return f }
    }
    return -1
}

fn (g: mut &Gen) symFunc(f: int, e: int): int {
    if g.funcSym[f] >= 0 { return g.funcSym[f] }
    if g.u.funcs[f].body >= 0 {
        append(mut &g.syms, Sym{kind: SK_FUNC, idx: f, addr: 0})
    } else if g.dyn && g.u.funcs[f].isExtern && !rtHelper(g.u.funcs[f].asmName) {
        g.funcSym[f] = g.symImport(g.u.funcs[f].asmName)
        return g.funcSym[f]
    } else {
        let name = g.u.funcs[f].asmName
        let addr = g.rtAddr.getOr(&name, -1)
        if addr < 0 {
            let msg = if g.u.funcs[f].isExtern { "extern C function '" + name + "' needs dynamic linking" } else {
                "'" + name + "' is not in the native runtime" }
            if e >= 0 { g.fail(e, msg) }
            ir.failAt("C line", g.u.funcs[f].line, msg)
        }
        append(mut &g.syms, Sym{kind: SK_ABS, idx: -1, addr: addr})
    }
    g.funcSym[f] = len(g.syms) - 1
    return len(g.syms) - 1
}

// The symbol of the GOT entry of an imported function.
fn (g: mut &Gen) symImport(name: str): int {
    let have = g.importSym.getOr(&name, -1)
    if have >= 0 { return have }
    append(mut &g.imports, name)
    append(mut &g.syms, Sym{kind: SK_DYN, idx: len(g.imports) - 1, addr: 0})
    g.importSym.put(name, len(g.syms) - 1)
    return len(g.syms) - 1
}

fn (g: mut &Gen) symRt(name: str): int {
    let addr = g.rtAddr.getOr(&name, -1)
    if addr < 0 { panic("native: the runtime has no " + name) }
    append(mut &g.syms, Sym{kind: SK_ABS, idx: -1, addr: addr})
    return len(g.syms) - 1
}

fn (g: mut &Gen) symStr(s: str): int {
    let have = g.strSym.getOr(&s, -1)
    if have >= 0 { return have }
    append(mut &g.strs, s)
    append(mut &g.syms, Sym{kind: SK_STR, idx: len(g.strs) - 1, addr: 0})
    g.strSym.put(s, len(g.syms) - 1)
    return len(g.syms) - 1
}

// ---------------------------------------------------------------- types

fn (g: &Gen) tk(t: int): int { return g.u.tys[t].k }

fn (g: &Gen) size(t: int): int { return g.u.tys[t].size }

fn (g: &Gen) is128(t: int): bool { return g.tk(t) == ir.TY_I128 || g.tk(t) == ir.TY_U128 }

fn (g: &Gen) isF(t: int): bool { return g.tk(t) == ir.TY_F64 }

fn (g: &Gen) isAggr(t: int): bool { return g.u.isAggr(t) }

fn mergeCl(x: int, c: int): int {
    if x == CL_INT || c == CL_INT { return CL_INT }
    return CL_SSE
}

// The SysV classes of a value of type t, one per eightbyte; [CL_MEM] for memory.
fn (g: &Gen) classify(t: int): []int {
    let sz = g.size(t)
    if sz > 16 { return [CL_MEM] }
    var out: []int = []
    for i in 0..(sz + 7) / 8 { append(mut &out, CL_NONE) }
    g.classInto(t, 0, mut &out)
    return out
}

fn (g: &Gen) classInto(t: int, off: int, out: mut &[]int) {
    let k = g.tk(t)
    if k == ir.TY_STRUCT {
        let sid = g.u.tys[t].sid
        for f in g.u.structs[sid].fields { g.classInto(f.ty, off + f.off, out) }
    } else if k == ir.TY_ARR {
        let et = g.u.tys[t].base
        for j in 0..g.u.tys[t].n { g.classInto(et, off + j * g.size(et), out) }
    } else if k == ir.TY_F64 {
        out[off / 8] = mergeCl(out[off / 8], CL_SSE)
    } else if k == ir.TY_I128 || k == ir.TY_U128 {
        out[off / 8] = CL_INT
        out[off / 8 + 1] = CL_INT
    } else {
        out[off / 8] = mergeCl(out[off / 8], CL_INT)
    }
}

fn countCl(cls: &[]int, c: int): int {
    var n = 0
    for x in cls {
        if x == c { n += 1 }
    }
    return n
}

// ---------------------------------------------------------------- frames

fn (g: mut &Gen) temp(size: int, align: int): int {
    g.frame = ir.alignUp(g.frame + size, if align > 8 { align } else { 8 })
    if g.frame > g.maxFrame { g.maxFrame = g.frame }
    return -g.frame
}

fn (g: mut &Gen) tempFor(t: int): int {
    return g.temp(ir.alignUp(if g.size(t) > 8 { g.size(t) } else { 8 }, 8), g.u.alignOf(t))
}

fn at(m: x64.Mem, d: int): x64.Mem { return x64.memx(m.base, m.index, m.scale, m.disp + d) }

fn rbp(d: int): x64.Mem { return x64.mem(RBP, d) }

// ---------------------------------------------------------------- functions

fn (g: mut &Gen) genFunc(f: int) {
    let start = g.a.pos()
    let firstLabel = g.a.labelCount()
    g.funcPos[f] = start
    g.frame = 0
    g.maxFrame = 0
    g.outArgs = 0
    let ft = g.u.funcs[f].ty
    g.retTy = g.u.tys[ft].base
    g.epiL = -1
    g.epiJmps = []
    g.loopTops = []
    g.loopEnds = []
    g.curFunc = f
    g.allocRegs(f)
    g.nLocalRegs = len(g.saved)
    g.held = []
    g.bareRet = false
    g.inlPos = -1
    g.tmpRegs = []
    g.tmpUsed = 0
    for q in QUIET_REGS {
        var free = true
        for l in g.touched {
            if g.reg[l] == q { free = false }
        }
        if free { append(mut &g.tmpRegs, q) }
    }
    var ni = 0
    var nx = 0
    g.retPtr = 0
    if g.isAggr(g.retTy) && g.classify(g.retTy)[0] == CL_MEM {
        g.retPtr = g.temp(8, 8)
        g.a.store(8, rbp(g.retPtr), RDI)
        ni = 1
    }
    var stackOff = 16
    for j in 0..len(g.u.funcs[f].params) {
        let l = g.u.funcs[f].params[j]
        let t = g.u.locals[l].ty
        let cls = g.classify(t)
        let nInt = countCl(&cls, CL_INT)
        let nSse = countCl(&cls, CL_SSE)
        if cls[0] == CL_MEM || ni + nInt > 6 || nx + nSse > 8 {
            stackOff = ir.alignUp(stackOff, if g.u.alignOf(t) > 8 { g.u.alignOf(t) } else { 8 })
            g.slots[l] = stackOff
            if g.reg[l] >= 0 { g.loadInt(t, g.reg[l], rbp(stackOff)) }
            stackOff += ir.alignUp(g.size(t), 8)
        } else if g.reg[l] >= 0 {
            g.a.movRR(8, g.reg[l], INT_REGS[ni])
            g.normR(g.tk(t), g.reg[l])
            ni += 1
        } else {
            let s = g.tempFor(t)
            g.slots[l] = s
            if g.isAggr(t) || g.is128(t) {
                for i in 0..len(cls) {
                    if cls[i] == CL_SSE {
                        g.a.movsdStore(rbp(s + 8 * i), nx)
                        nx += 1
                    } else if cls[i] == CL_INT {
                        g.a.store(8, rbp(s + 8 * i), INT_REGS[ni])
                        ni += 1
                    }
                }
            } else if g.isF(t) {
                g.a.movsdStore(rbp(s), nx)
                nx += 1
            } else {
                g.a.store(g.size(t), rbp(s), INT_REGS[ni])
                ni += 1
            }
        }
    }
    g.stmt(g.u.funcs[f].body)
    g.epilogue()
    // the slots of the registers saved for temporaries (hold), below the rest of the frame: only
    // the prologue and the restores at epiL name them
    for i in 0..len(g.saved) {
        if g.saved[i] == 0 {
            g.maxFrame += 8
            g.saved[i] = -g.maxFrame
        }
    }
    if g.epiL >= 0 {
        g.a.bind(g.epiL)
        g.leaveFrame()
        if len(g.saved) <= EPI_COPY {
            // the returns: a copy of the restores in place of each jump to them (the set of
            // registers is known now)
            var e = x64.newAsm()
            for i in 0..len(g.saved) { e.load(8, LOCAL_REGS[i], rbp(g.saved[i])) }
            e.leave()
            e.ret()
            var i = len(g.epiJmps) - 1
            while i >= 0 {
                g.a.replaceJmp(g.epiJmps[i], g.epiL, &e.code, firstLabel)
                i -= 1
            }
        }
    }
    g.genStubs()
    let frame = ir.alignUp(g.maxFrame, 16) + ir.alignUp(g.outArgs, 16)
    // the prologue, now that the frame is known
    var p = x64.newAsm()
    p.push(RBP)
    p.movRR(8, RBP, RSP)
    // the saved registers whose slots are at the top of the frame, in order, are pushed
    var pushed = 0
    while pushed < len(g.saved) && g.saved[pushed] == -8 * (pushed + 1) {
        p.push(LOCAL_REGS[pushed])
        pushed += 1
    }
    if frame > 8 * pushed { p.aluI(x64.SUB, 8, RSP, frame - 8 * pushed) }
    if frame > PROBE_FREE {
        // touch the frame a page at a time from the top, so that a stack overflow faults at
        // the guard page (rt_segv reports it) and never skips past it
        let probe = p.newLabel()
        let probed = p.newLabel()
        p.movRR(8, R11, RBP)
        p.bind(probe)
        p.aluI(x64.SUB, 8, R11, 4096)
        p.alu(x64.CMP, 8, R11, RSP)
        p.jcc(x64.CC_B, probed)
        p.storeI(1, x64.mem(R11, 0), 0)
        p.jmp(probe)
        p.bind(probed)
        p.fixLabels()
    }
    for i in pushed..len(g.saved) { p.store(8, rbp(g.saved[i]), LOCAL_REGS[i]) }
    g.placeCode(start, &p.code, firstLabel)
}

// Inserts the prologue pro at start and, in the same pass, nops before the body of each rotated
// loop, as gcc pads (to a multiple of 16 when that takes at most 10 bytes, else of 8): a loop's
// back branch then fetches a whole block. An innermost loop of 64 bytes or less is moved further,
// to a multiple of 16 from which it does not cross a 64-byte boundary, so that each iteration
// runs from one line of the instruction cache (and one of the op cache): the sieve's inner loop,
// 17 bytes from 48 bytes into a line, ran at about 1.5 times the cycles. The pads follow the jump
// to the loop's test, so they never run (code reaches the body only by jumps). The code starts at
// a multiple of 64 and the positions here are final within it, so their remainders are the
// addresses'.
fn (g: mut &Gen) placeCode(start: int, pro: &[]byte, firstLabel: int) {
    var ats: []int = [start]
    var ns: []int = [len(pro)]
    var bytes: []byte = []
    for b in pro { append(mut &bytes, b) }
    var shift = len(pro)
    for j in 0..len(g.loopTops) {
        // the tops in the order of the code (a loop's top is bound before its inner loops')
        let at = g.a.labelPos(g.loopTops[j])
        if at <= ats[len(ats) - 1] { continue }
        let now = at + shift
        var pad = (16 - now % 16) % 16
        if pad > 10 { pad = (8 - now % 8) % 8 }
        let size = g.a.labelPos(g.loopEnds[j]) - at
        let inner = j + 1 == len(g.loopTops) || g.a.labelPos(g.loopTops[j + 1]) >= at + size
        if inner && size <= 64 && (now + pad) % 64 + size > 64 {
            pad = (16 - now % 16) % 16
            while (now + pad) % 64 + size > 64 { pad += 16 }
        }
        if pad == 0 { continue }
        append(mut &ats, at)
        append(mut &ns, pad)
        for b in x64.nops(pad) { append(mut &bytes, b) }
        shift += pad
    }
    g.a.insertAll(&ats, &ns, &bytes, firstLabel)
}

// Chooses the locals of function f that live in registers (g.reg), and saves the registers.
//
// Candidates: integers and pointers whose address is not taken. The scan numbers the
// statements of f (positions; everything in one statement, with the bodies of the calls
// generated in place there, is one position) and finds each local's live range: its first
// and last position, widened to a whole loop when it is named both in the loop and outside
// it (its value goes around the loop's back edge), or when it is declared in a loop without
// an initializer. Two locals whose ranges are disjoint never hold values at the same time
// (one statement's code runs before the next one's, and only loops go back), so they may
// share a register. The heaviest uses (a use in a loop counts 8 times one outside, nested
// loops more) choose first: a range with no loud statement (no call, no 128-bit operation,
// ...: the code there leaves rsi, rdi, r8 and r9 alone) can take one of those; else one of
// the callee-saved registers, which are saved in the prologue: a new one only for a local
// named three times or in a loop, or twice with a loud statement in its range (else saving it
// costs what it saves).
fn (g: mut &Gen) allocRegs(f: int) {
    g.resetScan()
    g.saved = []
    g.pos = 0
    g.loud = [true]                     // position 0: the entry, where the arguments arrive
    g.tailEnd = [-1]
    g.regions = []
    g.openLoops = []
    g.scanExpr = 0
    for j in 0..len(g.u.funcs[f].params) { g.occur(g.u.funcs[f].params[j]) }
    g.scan(g.u.funcs[f].body, 0)
    var cands: []int = []
    for l in g.touched {
        let t = g.u.locals[l].ty
        if !g.bad[l] && g.weight[l] >= 1 && g.u.isScalar(t) && !g.isF(t) && !g.is128(t) { append(mut &cands, l) }
    }
    // the live ranges: declared in a loop without an initializer, then named in and out of loops
    for l in cands {
        let r = g.noInit[l]
        if r >= 0 && !g.inner[l] { g.widen(l, g.regions[2 * r], g.regions[2 * r + 1]) }
    }
    var changed = true
    while changed {
        changed = false
        for r in 0..len(g.regions) / 2 {
            let ls = g.regions[2 * r]
            let le = g.regions[2 * r + 1]
            for l in cands {
                // in the loop and before or after it, but not around all of it
                if !g.inner[l] && g.first[l] <= le && g.last[l] >= ls && (g.first[l] < ls || g.last[l] > le) &&
                    !(g.first[l] <= ls && g.last[l] >= le) {
                    g.widen(l, ls, le)
                    changed = true
                }
            }
        }
    }
    // the count of loud positions before each position
    var loudBefore: []int = [0]
    for i in 0..len(g.loud) { append(mut &loudBefore, loudBefore[i] + (if g.loud[i] { 1 } else { 0 })) }
    // heaviest first (a stable insertion sort: the order of the touched list breaks ties)
    var order: []int = []
    for l in cands {
        append(mut &order, l)
        var i = len(order) - 1
        while i > 0 && g.weight[order[i - 1]] < g.weight[l] {
            order[i] = order[i - 1]
            i -= 1
        }
        order[i] = l
    }
    var given: []int = []
    var nSaved = 0
    for l in order {
        var r = -1
        let quiet = g.quietLive(l, &loudBefore) || g.quietTail(l)
        if quiet {
            for q in QUIET_REGS {
                if r < 0 && g.regFree(&given, q, l) { r = q }
            }
        }
        for i in 0..nSaved {
            if r < 0 && g.regFree(&given, LOCAL_REGS[i], l) { r = LOCAL_REGS[i] }
        }
        // a new one: for a value kept across a call even when named only twice (a slot's
        // store before the call and load after it cost more than the save and restore)
        if r < 0 && nSaved < len(LOCAL_REGS) && (g.weight[l] >= 3 || (g.weight[l] >= 2 && !quiet)) {
            r = LOCAL_REGS[nSaved]
            nSaved += 1
            append(mut &g.saved, g.temp(8, 8))
        }
        if r >= 0 {
            g.reg[l] = r
            append(mut &given, l)
        }
    }
}

// Whether register r is free over the live range of local l (no local given it overlaps).
fn (g: &Gen) regFree(given: &[]int, r: int, l: int): bool {
    for o in given {
        if g.reg[o] == r && g.first[o] <= g.last[l] && g.first[l] <= g.last[o] {
            // the ranges around them meet: compare the positions of inner locals
            if !g.inner[o] && !g.inner[l] { return false }
            let a = g.spans(o)
            let b = g.spans(l)
            for i in 0..len(a) / 2 {
                for j in 0..len(b) / 2 {
                    if a[2 * i] <= b[2 * j + 1] && b[2 * j] <= a[2 * i + 1] { return false }
                }
            }
        }
    }
    return true
}

// Where local l is live: pairs of first and last positions.
fn (g: &Gen) spans(l: int): []int {
    if !g.inner[l] { return [g.first[l], g.last[l]] }
    var out: []int = []
    for p in g.pts[l] {
        append(mut &out, p)
        append(mut &out, p)
    }
    return out
}

// Whether each loud position p local l is live at is in statements that run straight into a
// return with l not named from p to the return: there l's value is dead (the function or the
// body generated in place does not go on past the return but to its end), and a call may change
// its register.
fn (g: &Gen) quietTail(l: int): bool {
    let sp = g.callSpans(l)
    for i in 0..len(sp) / 2 {
        for p in sp[2 * i]..sp[2 * i + 1] + 1 {
            if g.loud[p] {
                let e = g.tailEnd[p]
                if e < 0 { return false }
                for q in g.pts[l] {
                    if q >= p && q <= e { return false }
                }
            }
        }
    }
    return true
}

// The spans of l where a call may change its register: without the statement that declares it
// with an initializer, whose code (calls included) runs before l is set.
fn (g: &Gen) callSpans(l: int): []int {
    if !g.inner[l] && g.defAt[l] == g.first[l] {
        if g.first[l] == g.last[l] { return [] }
        return [g.first[l] + 1, g.last[l]]
    }
    return g.spans(l)
}

// Whether no position local l is live at is loud.
fn (g: &Gen) quietLive(l: int, loudBefore: &[]int): bool {
    let sp = g.callSpans(l)
    for i in 0..len(sp) / 2 {
        if loudBefore[sp[2 * i + 1] + 1] != loudBefore[sp[2 * i]] { return false }
    }
    return true
}

fn (g: mut &Gen) widen(l: int, from: int, to: int) {
    if from < g.first[l] { g.first[l] = from }
    if to > g.last[l] { g.last[l] = to }
}

fn (g: mut &Gen) resetScan() {
    let old = replace(mut &g.touched, [])
    for l in old {
        g.reg[l] = -1
        g.weight[l] = 0
        g.bad[l] = false
    }
    g.stamp += 1
}

// The uses of every local in its own function (inlined copies of a function name its locals
// as often), for the fused declarations of stmt.
fn (g: mut &Gen) countUses() {
    g.counting = true
    for f in 0..len(g.u.funcs) {
        if g.u.funcs[f].body >= 0 {
            g.curFunc = f
            g.scan(g.u.funcs[f].body, 0)
            g.resetScan()
        }
    }
    g.counting = false
    g.curFunc = -1
}

// ---------------------------------------------------------------- simplification of the IR
//
// The C the emitter writes computes && and || into bool variables with ifs and copies values
// into temporaries, and the code generator works on the tree as it is. So before generation,
// in every function body (inner blocks first):
//
// (1) `bool b = A; if (b) { b = V; }`, or `if (b) { bool c = V; b = c; }`, becomes
//     `bool b = A && V` (with `if (!b)`, A || V). The same evaluation: V only when A is true
//     (false), and b the value of the last evaluated. b and c are named nowhere else there.
// (2) `T t = s;` where s is a local declared earlier in the same block, named nowhere after
//     this, and whose address (or a member's) is never taken: t is s. Nothing can read s after
//     t's declaration, so the one variable holds t's values.
// (3) `T t = s;` of scalars whose addresses are never taken, where the statements of the block
//     that name t (the next 8 at most) assign neither t nor s: t is s. Both hold the same value
//     wherever t is named.
//
// The C code is unchanged; only the native code generator sees the result.

fn (g: mut &Gen) simplify() {
    append(mut &g.u.nodes, ir.Node{k: ir.S_EMPTY, ty: 0, line: 0, a: -1, b: -1, c: -1, d: -1, v: 0, f: 0.0, s: ""})
    g.emptyS = len(g.u.nodes) - 1
    for f in 0..len(g.u.funcs) {
        if g.u.funcs[f].body >= 0 { g.walk(g.u.funcs[f].body, 3, -1, -1) }
    }
    for f in 0..len(g.u.funcs) {
        if g.u.funcs[f].body >= 0 { g.simpStmt(g.u.funcs[f].body) }
    }
}

fn (g: mut &Gen) simpStmt(s: int) {
    if s < 0 { return }
    let n = g.u.nodes[s]
    let k = n.k
    if k == ir.S_BLOCK {
        for j in 0..g.u.listLen(n.a) { g.simpStmt(g.u.listAt(n.a, j)) }
        g.simpList(n.a)
    } else if k == ir.S_IF {
        g.simpStmt(n.b)
        g.simpStmt(n.c)
    } else if k == ir.S_WHILE || k == ir.S_SWITCH {
        g.simpStmt(n.b)
    } else if k == ir.S_FOR {
        g.simpStmt(n.a)
        g.simpStmt(n.d)
    }
}

fn (g: mut &Gen) simpList(l: int) {
    // again while statements drop out (a merge can bring a declaration next to its if)
    var pass = 0
    while pass < 4 {
        let cnt = g.u.listLen(l)
        for j in 0..cnt {
            let x = g.u.listAt(l, j)
            if g.u.nk(x) != ir.S_DECL || g.u.nodes[x].b < 0 || g.u.nodes[x].c >= 0 { continue }
            let b = g.u.nodes[x].a
            if j + 1 < cnt && g.tk(g.u.locals[b].ty) == ir.TY_BOOL {
                let v = g.boolFold(x, g.u.listAt(l, j + 1))
                if v >= 0 {
                    g.u.nodes[x].b = v
                    g.u.items[l + 2 + j] = g.emptyS
                    g.uses[b] -= 2                  // the if's condition and assignment
                }
            }
            if g.u.nk(g.u.nodes[x].b) == ir.E_LOCAL { g.merge(l, j) }
            if g.u.listAt(l, j) == x && j + 1 < cnt { g.intoAssign(l, j) }
            if g.u.listAt(l, j) == x && j + 1 < cnt { g.intoReturn(l, j) }
            if g.u.listAt(l, j) == x && j + 1 < cnt { g.forward(l, j) }
        }
        // without the statements dropped (so that the fused pairs of stmt are next to each other)
        var n = 0
        for j in 0..cnt {
            let x = g.u.listAt(l, j)
            if x != g.emptyS {
                g.u.items[l + 1 + n] = x
                n += 1
            }
        }
        g.u.items[l] = n
        if n == cnt { return }
        pass += 1
    }
}

// (1) for the declaration d of a bool b and the statement s after it: the new initializer of b,
// or -1.
fn (g: mut &Gen) boolFold(d: int, s: int): int {
    let b = g.u.nodes[d].a
    let sn = g.u.nodes[s]
    if sn.k != ir.S_IF || sn.c >= 0 { return -1 }
    var cond = sn.a
    var isAnd = true
    if g.u.nk(cond) == ir.E_LNOT {
        cond = g.u.nodes[cond].a
        isAnd = false
    }
    if g.u.nk(cond) != ir.E_LOCAL || g.u.nodes[cond].a != b { return -1 }
    // the statements of the then part, without the empty ones
    var xs: []int = []
    if g.u.nk(sn.b) == ir.S_BLOCK {
        let l = g.u.nodes[sn.b].a
        for j in 0..g.u.listLen(l) {
            if g.u.nk(g.u.listAt(l, j)) != ir.S_EMPTY { append(mut &xs, g.u.listAt(l, j)) }
        }
    } else {
        append(mut &xs, sn.b)
    }
    if len(xs) == 0 || len(xs) > 2 { return -1 }
    let last = xs[len(xs) - 1]
    if g.u.nk(last) != ir.S_EXPR { return -1 }
    let as1 = g.u.nodes[last].a
    if g.u.nk(as1) != ir.E_ASSIGN { return -1 }
    let lhs = g.u.nodes[as1].a
    if g.u.nk(lhs) != ir.E_LOCAL || g.u.nodes[lhs].a != b { return -1 }
    var v = g.u.nodes[as1].b
    if len(xs) == 2 {
        let dn = g.u.nodes[xs[0]]
        if dn.k != ir.S_DECL || dn.b < 0 || dn.c >= 0 { return -1 }
        if g.u.nk(v) != ir.E_LOCAL || g.u.nodes[v].a != dn.a || g.u.locals[dn.a].ty != g.u.locals[b].ty { return -1 }
        v = dn.b
    }
    if g.walk(v, 0, b, -1) > 0 { return -1 }
    let a = g.u.nodes[d].b
    append(mut &g.u.nodes, ir.Node{k: if isAnd { ir.E_LAND } else { ir.E_LOR }, ty: g.u.locals[b].ty,
        line: g.u.nodes[a].line, a: a, b: v, c: -1, d: -1, v: 0, f: 0.0, s: ""})
    return len(g.u.nodes) - 1
}

// (2) and (3) for the declaration `T t = s;`, item j of list l.
fn (g: mut &Gen) merge(l: int, j: int) {
    let cnt = g.u.listLen(l)
    let x = g.u.listAt(l, j)
    let t = g.u.nodes[x].a
    let s = g.u.nodes[g.u.nodes[x].b].a
    if t == s || g.u.locals[t].ty != g.u.locals[s].ty { return }
    // (2): s's declaration in the 16 items before, and all its names from there to here
    if !g.aTaken[s] {
        var i = j - 1
        while i >= 0 && j - i <= 16 {
            let y = g.u.listAt(l, i)
            if g.u.nk(y) == ir.S_DECL && g.u.nodes[y].a == s { break }
            i -= 1
        }
        if i >= 0 && j - i <= 16 {
            let y = g.u.listAt(l, i)
            var named = 0
            for m in i..j + 1 { named += g.walk(g.u.listAt(l, m), 0, s, -1) }
            let total = g.uses[s] - (if g.u.nodes[y].b >= 0 { 1 } else { 0 })
            if named == total {
                g.rename(l, j, t, s, cnt)
                return
            }
        }
    }
    // (3)
    if !g.u.isScalar(g.u.locals[t].ty) || g.aTaken[s] || g.aTaken[t] { return }
    var need = g.uses[t] - 1
    var m = j + 1
    while need > 0 && m < cnt && m <= j + 8 {
        let y = g.u.listAt(l, m)
        if g.walk(y, 1, s, -1) > 0 || g.walk(y, 1, t, -1) > 0 { return }
        need -= g.walk(y, 0, t, -1)
        m += 1
    }
    if need != 0 { return }
    g.rename(l, j, t, s, m)
}

// (4) `T t = E; s = t;` with t named nowhere else and s a local of type T: `s = E;` (E is
// evaluated, then stored, as before).
fn (g: mut &Gen) intoAssign(l: int, j: int) {
    let x = g.u.listAt(l, j)
    let t = g.u.nodes[x].a
    let y = g.u.listAt(l, j + 1)
    if g.uses[t] != 2 || g.u.nk(y) != ir.S_EXPR { return }
    let as1 = g.u.nodes[y].a
    if g.u.nk(as1) != ir.E_ASSIGN { return }
    let lhs = g.u.nodes[as1].a
    let rhs = g.u.nodes[as1].b
    if g.u.nk(lhs) != ir.E_LOCAL || g.u.nk(rhs) != ir.E_LOCAL || g.u.nodes[rhs].a != t { return }
    if g.u.locals[g.u.nodes[lhs].a].ty != g.u.locals[t].ty || g.u.nodes[as1].ty != g.u.locals[t].ty { return }
    g.u.nodes[as1].b = g.u.nodes[x].b
    g.u.items[l + 1 + j] = g.emptyS
    g.uses[t] = 0
}

// (5) `T t = E; return t;` with t named nowhere else, T a scalar: `return E;`.
fn (g: mut &Gen) intoReturn(l: int, j: int) {
    let x = g.u.listAt(l, j)
    let t = g.u.nodes[x].a
    let y = g.u.listAt(l, j + 1)
    if g.uses[t] != 2 || g.u.nk(y) != ir.S_RETURN || !g.u.isScalar(g.u.locals[t].ty) { return }
    let r = g.u.nodes[y].a
    if r < 0 || g.u.nk(r) != ir.E_LOCAL || g.u.nodes[r].a != t { return }
    let v = g.u.nodes[x].b
    if g.u.nodes[r].ty != g.u.locals[t].ty || g.u.nodes[v].ty != g.u.locals[t].ty { return }
    g.u.nodes[y].a = v
    g.u.items[l + 1 + j] = g.emptyS
    g.uses[t] = 0
}

// (6) `T t = E; S` with T a scalar, t named once more, in S, the next statement (an expression,
// a return, a declaration with an initializer), on a path of operations that evaluate all
// their operands (no &&, ||, ?:), and every other value S reads one that E cannot change and
// whose reading cannot fail: constants, string and function addresses, members and values of
// locals whose addresses are never taken and that E does not assign. Then S reads E in t's
// place (E's node is copied over t's name): E is evaluated where t was read, which no other
// part of S can tell from before.
fn (g: mut &Gen) forward(l: int, j: int) {
    let x = g.u.listAt(l, j)
    let t = g.u.nodes[x].a
    let y = g.u.listAt(l, j + 1)
    if g.uses[t] != 2 || !g.u.isScalar(g.u.locals[t].ty) || g.aTaken[t] { return }
    let v = g.u.nodes[x].b
    if g.u.nodes[v].ty != g.u.locals[t].ty { return }
    let yk = g.u.nk(y)
    var root = -1
    if yk == ir.S_EXPR || yk == ir.S_RETURN {
        root = g.u.nodes[y].a
    } else if yk == ir.S_DECL && g.u.nodes[y].c < 0 {
        root = g.u.nodes[y].b
    }
    if root < 0 { return }
    let at = g.fwdSite(root, t, v)
    if at < 0 || g.u.nodes[at].ty != g.u.nodes[v].ty { return }
    g.u.nodes[at] = g.u.nodes[v]
    g.u.items[l + 1 + j] = g.emptyS
    g.uses[t] = 0
}

// For forward: in the tree x, the name of local t when x's other values are as forward needs
// them (E is v); -2 when x does not name t and is such a value; else -1.
fn (g: mut &Gen) fwdSite(x: int, t: int, v: int): int {
    let n = g.u.nodes[x]
    let k = n.k
    if k == ir.E_LOCAL {
        if n.a == t { return x }
        if g.aTaken[n.a] || g.walk(v, 1, n.a, -1) > 0 { return -1 }
        return -2
    }
    if k == ir.E_INT || k == ir.E_FLT || k == ir.E_STR || k == ir.E_FUNC { return -2 }
    if (k == ir.E_DECAY || k == ir.E_ADDR) && (g.u.nk(n.a) == ir.E_STR || g.u.nk(n.a) == ir.E_FUNC) { return -2 }
    if k == ir.E_MEMBER || k == ir.E_CAST {
        let r = g.fwdSite(n.a, t, v)
        if r >= 0 && k == ir.E_MEMBER { return -1 }
        return r
    }
    var kids: []int = []
    if k == ir.E_CALL {
        append(mut &kids, n.a)
        for i in 0..g.u.listLen(n.b) { append(mut &kids, g.u.listAt(n.b, i)) }
    } else if k == ir.E_BIN || k == ir.E_PADD {
        append(mut &kids, n.a)
        append(mut &kids, n.b)
    } else if k == ir.E_NEG || k == ir.E_BNOT || k == ir.E_DEREF {
        append(mut &kids, n.a)
    } else if k == ir.E_ASSIGN {
        // into a local or a member of one, the value naming t
        var r = n.a
        while g.u.nk(r) == ir.E_MEMBER { r = g.u.nodes[r].a }
        if g.u.nk(r) != ir.E_LOCAL || g.fwdSite(n.a, t, v) != -2 { return -1 }
        return g.fwdSite(n.b, t, v)
    } else {
        return -1
    }
    // the path to t goes through x (it evaluates all its operands, after them); no other
    // operand of x but values
    var site = -2
    for c in kids {
        let r = g.fwdSite(c, t, v)
        if r == -1 { return -1 }
        if r >= 0 {
            if site >= 0 { return -1 }
            site = r
        }
    }
    if site < 0 { return -1 }
    return site
}

// Names s for t in items j+1 up to end of list l, and drops t's declaration (item j).
fn (g: mut &Gen) rename(l: int, j: int, t: int, s: int, end: int) {
    for m in j + 1..end { g.walk(g.u.listAt(l, m), 2, t, s) }
    g.u.items[l + 1 + j] = g.emptyS
    g.uses[s] += g.uses[t] - 2           // t's names but its declaration; not s in it
    g.uses[t] = 0
    if g.aTaken[t] { g.aTaken[s] = true } // s now stands where t's address was taken
}

// Over the tree x: op 0 counts the names of local l; 1 counts its assignments and the taking
// of its address; 2 renames it to local to; 3 marks the locals whose addresses (or members')
// are taken (aTaken).
fn (g: mut &Gen) walk(x: int, op: int, l: int, to: int): int {
    if x < 0 { return 0 }
    let n = g.u.nodes[x]
    let k = n.k
    if k == ir.E_LOCAL {
        if n.a != l { return 0 }
        if op == 2 { g.u.nodes[x].a = to }
        return if op == 1 { 0 } else { 1 }
    }
    if k == ir.E_INT || k == ir.E_FLT || k == ir.E_STR || k == ir.E_GLOBAL || k == ir.E_FUNC ||
        k == ir.S_BREAK || k == ir.S_CONTINUE || k == ir.S_CASE || k == ir.S_DEFAULT || k == ir.S_EMPTY {
        return 0
    }
    var hit = 0
    if k == ir.E_ADDR || k == ir.E_DECAY {
        var r = n.a
        while g.u.nk(r) == ir.E_MEMBER { r = g.u.nodes[r].a }
        if g.u.nk(r) == ir.E_LOCAL {
            if op == 3 { g.aTaken[g.u.nodes[r].a] = true }
            if op == 1 && g.u.nodes[r].a == l { hit = 1 }
        }
    } else if op == 1 && (k == ir.E_ASSIGN || k == ir.E_POSTINC) {
        var r = n.a
        while g.u.nk(r) == ir.E_MEMBER { r = g.u.nodes[r].a }
        if g.u.nk(r) == ir.E_LOCAL && g.u.nodes[r].a == l { hit = 1 }
    }
    if k == ir.E_CALL { return hit + g.walk(n.a, op, l, to) + g.walkList(n.b, op, l, to) }
    if k == ir.E_CLIT { return hit + g.walkList(n.b, op, l, to) }
    if k == ir.S_BLOCK { return hit + g.walkList(n.a, op, l, to) }
    if k == ir.S_DECL { return hit + g.walk(n.b, op, l, to) + g.walkList(n.c, op, l, to) }
    if k == ir.S_FOR {
        return hit + g.walk(n.a, op, l, to) + g.walk(n.b, op, l, to) + g.walk(n.c, op, l, to) + g.walk(n.d, op, l, to)
    }
    if k == ir.E_MEMBER || k == ir.E_DEREF || k == ir.E_CAST || k == ir.E_NEG || k == ir.E_BNOT || k == ir.E_LNOT ||
        k == ir.E_POSTINC || k == ir.E_IENT || k == ir.S_EXPR || k == ir.S_RETURN || k == ir.E_ADDR || k == ir.E_DECAY {
        return hit + g.walk(n.a, op, l, to)
    }
    if k == ir.E_BIN || k == ir.E_LAND || k == ir.E_LOR || k == ir.E_ASSIGN || k == ir.E_PADD || k == ir.S_SWITCH ||
        k == ir.S_WHILE {
        return hit + g.walk(n.a, op, l, to) + g.walk(n.b, op, l, to)
    }
    if k == ir.E_COND || k == ir.S_IF {
        return hit + g.walk(n.a, op, l, to) + g.walk(n.b, op, l, to) + g.walk(n.c, op, l, to)
    }
    g.fail(x, "unknown node kind")
}

fn (g: mut &Gen) walkList(l: int, op: int, loc: int, to: int): int {
    if l < 0 { return 0 }
    var hit = 0
    for j in 0..g.u.listLen(l) { hit += g.walk(g.u.listAt(l, j), op, loc, to) }
    return hit
}

fn loopWeight(depth: int): int {
    var w = 1
    for i in 0..(if depth > 5 { 5 } else { depth }) { w *= 8 }
    return w
}

fn (g: mut &Gen) scanList(l: int, depth: int) {
    if l < 0 { return }
    for j in 0..g.u.listLen(l) { g.scan(g.u.listAt(l, j), depth) }
}

fn (g: mut &Gen) touch(l: int) {
    if g.seen[l] != g.stamp {
        g.seen[l] = g.stamp
        append(mut &g.touched, l)
        g.first[l] = g.pos
        g.last[l] = g.pos
        g.noInit[l] = -1
        g.inner[l] = !g.counting && g.scanExpr > 0
        g.pts[l] = []
        g.defAt[l] = -1
    }
}

// Local l is named at the scan's position. A local first named in the body of a call generated
// in place is a local of that function (a caller's local is named first in the caller's own
// statements, an argument &l included): its value lives within each copy of the body, all of
// which is one position, and is set there before it is read (parameters at the call, the others
// at their declarations); so it is live at those positions only.
fn (g: mut &Gen) occur(l: int) {
    g.touch(l)
    g.widen(l, g.pos, g.pos)
    if !g.counting {
        let n = len(g.pts[l])
        if n == 0 || g.pts[l][n - 1] != g.pos { append(mut &g.pts[l], g.pos) }
    }
}

// The next statement: a new position (not in the body of a call generated in place).
fn (g: mut &Gen) step() {
    if g.counting || g.scanExpr > 0 { return }
    g.pos += 1
    append(mut &g.loud, false)
    append(mut &g.tailEnd, -1)
}

fn (g: mut &Gen) enterLoop() {
    g.step()
    if g.counting || g.scanExpr > 0 { return }
    append(mut &g.openLoops, len(g.regions) / 2)
    append(mut &g.regions, g.pos)
    append(mut &g.regions, g.pos)
}

fn (g: mut &Gen) exitLoop() {
    if g.counting || g.scanExpr > 0 { return }
    let r = pop(mut &g.openLoops)
    g.regions[2 * r + 1] = g.pos
}

// Whether the code of node x itself (not its operands) may change rsi, rdi, r8 or r9: a call
// that is not generated inline (the caller looks at those), a 128-bit value, an aggregate over
// 128 bytes (copied with rep movsb), a conversion between double and u64 (a runtime helper).
fn (g: &Gen) loudNode(x: int): bool {
    let n = g.u.nodes[x]
    let t = n.ty
    if n.k >= ir.S_DECL { return false }
    if g.is128(t) || (g.isAggr(t) && g.size(t) > 128) { return true }
    if n.k == ir.E_CAST {
        let st = g.u.nodes[n.a].ty
        return (g.isF(t) && g.tk(st) == ir.TY_U64) || (g.isF(st) && g.tk(t) == ir.TY_U64)
    }
    return false
}

// Whether the call e of a runtime function is generated inline by inlineRt with no call, and
// changes no register but rax, rcx and rdx (and the frame).
fn (g: &Gen) quietRt(e: int): bool {
    let name = g.rtName(e)
    if name == "" { return false }
    let n = g.u.nodes[e]
    let nargs = g.u.listLen(n.b)
    let ar = arOp(name)
    if ar.k >= 0 { return nargs >= 2 && (ar.wrap || (nargs == 3 && g.isWhere(g.u.listAt(n.b, 2)))) }
    if g.cvInline(e) { return true }
    let dv = divOp(name)
    if dv.k >= 0 { return nargs == (if dv.op == ir.OP_SUB { 2 } else { 3 }) && g.isWhere(g.u.listAt(n.b, nargs - 1)) }
    if name == "rt_idx" || name == "rt_str_byte" { return nargs == 3 && g.isWhere(g.u.listAt(n.b, 2)) }
    return name == "rt_str_dup" && nargs == 1
}

// Whether the call e is an rt_cvs_N or rt_cvu_N that inlineCv generates inline (of a value of
// 64 bits or less widened to 128 bits).
fn (g: &Gen) cvInline(e: int): bool {
    let name = g.rtName(e)
    if !startsWith(name, "rt_cvs_") && !startsWith(name, "rt_cvu_") { return false }
    let n = g.u.nodes[e]
    if g.u.listLen(n.b) != 2 || !g.isWhere(g.u.listAt(n.b, 1)) || suffixKind(name[7..len(name)]) < 0 { return false }
    let vn = g.u.nodes[g.u.listAt(n.b, 0)]
    return vn.k == ir.E_CAST && g.is128(vn.ty) && g.u.isInt(g.u.nodes[vn.a].ty) && !g.is128(g.u.nodes[vn.a].ty)
}

// `bool c = e; if (c) ...` that stmt generates without c (fusedIf).
fn (g: &Gen) fusesIf(d: int, s: int): bool {
    let dn = g.u.nodes[d]
    if dn.k != ir.S_DECL || dn.b < 0 || dn.c >= 0 || g.uses[dn.a] != 2 { return false }
    if g.tk(g.u.locals[dn.a].ty) != ir.TY_BOOL || g.u.nk(s) != ir.S_IF { return false }
    var cond = g.u.nodes[s].a
    if g.u.nk(cond) == ir.E_LNOT { cond = g.u.nodes[cond].a }
    return g.u.nk(cond) == ir.E_LOCAL && g.u.nodes[cond].a == dn.a
}

// `T r = e; return r;` that stmt generates without r (fusedReturn).
fn (g: &Gen) fusesReturn(d: int, s: int): bool {
    let dn = g.u.nodes[d]
    if dn.k != ir.S_DECL || dn.b < 0 || dn.c >= 0 || g.uses[dn.a] != 2 || g.u.nk(s) != ir.S_RETURN { return false }
    let r = g.u.nodes[s].a
    if r < 0 || g.u.nk(r) != ir.E_LOCAL || g.u.nodes[r].a != dn.a { return false }
    return g.u.nodes[r].ty == g.u.nodes[dn.b].ty && !g.isAggr(g.u.nodes[r].ty)
}

// Weighs the uses of locals in the tree x (at loop depth depth), with the bodies of the calls
// that are generated in place; when counting, counts the times x names each (uses); else
// finds their positions, the loops and the loud positions (allocRegs).
fn (g: mut &Gen) scan(x: int, depth: int) {
    if x < 0 { return }
    let n = g.u.nodes[x]
    let k = n.k
    if !g.counting && g.scanExpr == 0 && x < len(g.posOf) {
        if g.posSeen[x] != g.stamp {
            g.posSeen[x] = g.stamp
            g.posOf[x] = g.pos
        } else if g.posOf[x] != g.pos {
            g.posOf[x] = -1
        }
    }
    if !g.counting && g.loudNode(x) { g.loud[g.pos] = true }
    if k == ir.E_LOCAL {
        g.occur(n.a)
        if g.counting { g.uses[n.a] += 1 }
        g.weight[n.a] += loopWeight(depth)
    } else if k == ir.E_ADDR || k == ir.E_DECAY {
        if g.u.nk(n.a) == ir.E_LOCAL {
            let l = g.u.nodes[n.a].a
            g.occur(l)
            g.bad[l] = true
        }
        g.scan(n.a, depth)
    } else if k == ir.S_EXPR || k == ir.S_RETURN {
        g.step()
        g.scan(n.a, depth)
    } else if k == ir.E_MEMBER || k == ir.E_DEREF || k == ir.E_CAST || k == ir.E_NEG || k == ir.E_BNOT ||
        k == ir.E_LNOT || k == ir.E_POSTINC || k == ir.E_IENT {
        g.scan(n.a, depth)
    } else if k == ir.E_BIN || k == ir.E_LAND || k == ir.E_LOR || k == ir.E_ASSIGN || k == ir.E_PADD {
        g.scan(n.a, depth)
        g.scan(n.b, depth)
    } else if k == ir.S_SWITCH {
        g.step()
        g.scan(n.a, depth)
        g.scan(n.b, depth)
    } else if k == ir.E_COND {
        g.scan(n.a, depth)
        g.scan(n.b, depth)
        g.scan(n.c, depth)
    } else if k == ir.S_IF {
        g.step()
        g.scan(n.a, depth)
        g.scan(n.b, depth)
        g.scan(n.c, depth)
    } else if k == ir.E_CALL {
        g.scan(n.a, depth)
        let f = if g.counting { -1 } else { g.inlineTarget(x, true, depth) }
        var al: []int = []
        if f >= 0 { al = g.aliases(f, x) }
        if !g.counting && g.cvInline(x) {
            // the 128-bit conversion of the operand is not generated
            g.scan(g.u.nodes[g.u.listAt(n.b, 0)].a, depth)
            g.scan(g.u.listAt(n.b, 1), depth)
        } else {
            for j in 0..g.u.listLen(n.b) {
                if f >= 0 && al[j] >= 0 {
                    // &l for a parameter the body only dereferences: the body names l
                    g.occur(al[j])
                    g.weight[al[j]] += loopWeight(depth)
                } else {
                    g.scan(g.u.listAt(n.b, j), depth)
                }
            }
        }
        if f >= 0 {
            // the body as it is generated in place: its parameters are assigned at the call
            g.scanExpr += 1
            for j in 0..len(g.u.funcs[f].params) {
                let p = g.u.funcs[f].params[j]
                if al[j] < 0 {
                    g.occur(p)
                    g.weight[p] += loopWeight(depth)
                }
            }
            let ch = g.applyAlias(f, &al)
            append(mut &g.scanStack, f)
            g.scan(g.u.funcs[f].body, depth)
            g.scanExpr -= 1
            pop(mut &g.scanStack)
            g.unalias(&ch)
        } else if !g.counting && !g.quietRt(x) {
            g.loud[g.pos] = true
        }
    } else if k == ir.E_CLIT {
        g.scanList(n.b, depth)
    } else if k == ir.S_BLOCK {
        let cnt = g.u.listLen(n.a)
        var starts: []int = []
        for j in 0..cnt {
            append(mut &starts, g.pos + 1)
            g.scan(g.u.listAt(n.a, j), depth)
        }
        if !g.counting && g.scanExpr == 0 && cnt > 0 && g.u.nk(g.u.listAt(n.a, cnt - 1)) == ir.S_RETURN {
            // the statements that run straight into the return (no jumps, no loops)
            var i = cnt - 1
            while i > 0 {
                let sk = g.u.nk(g.u.listAt(n.a, i - 1))
                if sk != ir.S_EXPR && sk != ir.S_DECL && sk != ir.S_EMPTY { break }
                i -= 1
            }
            for p in starts[i]..g.pos + 1 { g.tailEnd[p] = g.pos }
        }
        if !g.counting {
            // the locals that fused statements do without
            for j in 0..cnt - 1 {
                let d = g.u.listAt(n.a, j)
                let s = g.u.listAt(n.a, j + 1)
                if g.fusesIf(d, s) || g.fusesReturn(d, s) { g.bad[g.u.nodes[d].a] = true }
            }
        }
    } else if k == ir.S_DECL {
        g.step()
        let l = n.a
        g.occur(l)
        if n.b >= 0 && n.c < 0 && g.first[l] == g.pos { g.defAt[l] = g.pos }
        if n.b >= 0 {
            if g.counting { g.uses[l] += 1 }
            g.weight[l] += loopWeight(depth)
        }
        if n.c >= 0 {
            g.bad[l] = true
            g.scanList(n.c, depth)
        }
        if !g.counting {
            let t = g.u.locals[l].ty
            if g.isAggr(t) && g.size(t) > 128 { g.loud[g.pos] = true }
            if n.b < 0 && n.c < 0 && len(g.openLoops) > 0 {
                // its value may go around the loop it is declared in
                let r = g.openLoops[len(g.openLoops) - 1]
                if g.noInit[l] >= 0 && g.noInit[l] != r { g.bad[l] = true }
                if !g.inner[l] { g.noInit[l] = r }
            }
        }
        g.scan(n.b, depth)
    } else if k == ir.S_WHILE {
        g.enterLoop()
        g.scan(n.a, depth + 1)
        g.scan(n.b, depth + 1)
        g.exitLoop()
    } else if k == ir.S_FOR {
        g.scan(n.a, depth)
        g.enterLoop()
        g.scan(n.b, depth + 1)
        g.scan(n.c, depth + 1)
        g.scan(n.d, depth + 1)
        g.exitLoop()
    }
}

// Whether a and b are the same lvalue in memory that needs no code (a local or a member).
fn (g: &Gen) sameMem(a: int, b: int): bool {
    if g.u.nodes[a].ty != g.u.nodes[b].ty { return false }
    let ma = g.staticMem(a)
    let mb = g.staticMem(b)
    return ma.base != -9 && ma.base == mb.base && ma.index == mb.index && ma.disp == mb.disp
}

// The register of e if it is a local in one, else -1.
fn (g: &Gen) regOf(e: int): int {
    let n = g.u.nodes[e]
    if n.k == ir.E_LOCAL { return g.reg[n.a] }
    if g.noopCast(e) { return g.regOf(n.a) }
    return -1
}

// A return: the frame left in place when no register is to be restored, else a jump to the
// function's one copy of the restores.
fn (g: mut &Gen) epilogue() {
    if !g.a.reachable() { return }
    if len(g.inlEnd) > 0 {
        g.a.jmp(g.inlEnd[len(g.inlEnd) - 1])
        return
    }
    if len(g.saved) == 0 {
        g.bareRet = true
        g.leaveFrame()
        return
    }
    if g.epiL < 0 { g.epiL = g.a.newLabel() }
    let at = g.a.pos()
    g.a.jmp(g.epiL)
    if g.a.pos() == at + 5 { append(mut &g.epiJmps, at) }
}

fn (g: mut &Gen) leaveFrame() {
    for i in 0..len(g.saved) { g.a.load(8, LOCAL_REGS[i], rbp(g.saved[i])) }
    g.a.leave()
    g.a.ret()
}

// ---------------------------------------------------------------- statements

fn (g: &Gen) isDecl(s: int): bool {
    let n = g.u.nodes[s]
    return n.k == ir.S_DECL || (n.k == ir.S_BLOCK && n.v == 1)
}

fn (g: mut &Gen) stmt(s: int) {
    let n = g.u.nodes[s]
    let k = n.k
    if k == ir.S_BLOCK {
        let mark = g.frame
        g.stmtsFrom(n.a, 0)
        if n.v != 1 { g.frame = mark }
    } else if k == ir.S_DECL {
        let l = n.a
        let t = g.u.locals[l].ty
        if g.reg[l] >= 0 {
            g.declMark = g.frame
            if n.b >= 0 && g.simple(n.b) && g.u.nodes[n.b].ty == t {
                g.genInto(n.b, g.reg[l])
            } else if n.b >= 0 && g.u.nodes[n.b].ty == t && g.arithInto(n.b, g.reg[l], true) {
                // computed in the register
            } else if n.b >= 0 {
                g.gen(n.b)
                if !g.normAs(g.u.nodes[n.b].ty, t) { g.normR(g.tk(t), RAX) }
                g.a.movRR(8, g.reg[l], RAX)
            }
            return
        }
        let s2 = g.temp(ir.alignUp(g.size(t), 8), g.u.alignOf(t))
        g.slots[l] = s2
        g.declMark = g.frame
        if n.b >= 0 && g.isAggr(t) && g.u.nk(n.b) == ir.E_CALL && g.u.nodes[n.b].ty == t {
            // the result stored (or written by the callee) in the slot (whole words: the slot
            // is rounded up to them)
            g.callDest = rbp(s2)
            g.callFresh = true
            g.destUsed = false
            g.gen(n.b)
            if !g.destUsed { g.storeT(t, rbp(s2)) }
        } else if n.b >= 0 {
            g.gen(n.b)
            g.storeFrom(g.u.nodes[n.b].ty, t, rbp(s2))
        } else if n.c >= 0 {
            g.initEntries(s2, g.size(t), n.c)
        }
    } else if k == ir.S_EXPR {
        g.genEffect(n.a)
    } else if k == ir.S_IF && n.c < 0 && g.jumpOnly(n.b) >= 0 {
        g.branch(n.a, g.jumpOnly(n.b), true)
    } else if k == ir.S_IF {
        let elseL = g.a.newLabel()
        g.branch(n.a, elseL, false)
        g.stmt(n.b)
        if n.c >= 0 {
            let end = g.a.newLabel()
            g.a.jmp(end)
            g.a.bind(elseL)
            g.stmt(n.c)
            g.a.bind(end)
        } else {
            g.a.bind(elseL)
        }
    } else if k == ir.S_WHILE && g.rotTest(s) >= 0 {
        g.rotated(s)
    } else if k == ir.S_WHILE {
        let top = g.a.newLabel()
        let end = g.a.newLabel()
        g.a.bind(top)
        g.loops += 1
        g.branch(n.a, end, false)
        append(mut &g.breakL, end)
        append(mut &g.contL, top)
        g.stmt(n.b)
        pop(mut &g.breakL)
        pop(mut &g.contL)
        g.loops -= 1
        g.a.jmp(top)
        g.a.bind(end)
    } else if k == ir.S_FOR {
        let mark = g.frame
        let fill = g.fillLoop(s)
        var fillEnd = -1
        if fill >= 0 {
            // the loop stores one value into elements 0 to n - 1 in order: from 64 elements on,
            // rep stos writes the same elements (rdi kept in r11; rax, rcx and r11 hold nothing
            // between statements)
            let small = g.a.newLabel()
            fillEnd = g.a.newLabel()
            let st = g.u.nodes[g.u.nodes[fill].a]           // the store's place, *(p + i * size)
            g.genInto(g.u.nodes[g.forCond(s)].b, RCX)
            g.a.aluI(x64.CMP, 8, RCX, 64)
            g.a.jcc(x64.CC_L, small)
            let cv = g.intConst(g.u.nodes[fill].b, g.u.nodes[fill].ty)
            if cv.c == 0 { g.a.movRI(RAX, cv.v) } else { g.genInto(g.u.nodes[fill].b, RAX) }
            g.a.movRR(8, R11, RDI)
            g.genInto(g.fillBase(st.a), RDI)
            g.a.repStos(g.u.nodes[st.a].v)
            g.a.movRR(8, RDI, R11)
            g.a.jmp(fillEnd)
            g.a.bind(small)
        }
        if n.a >= 0 {
            let before = g.frame
            g.stmt(n.a)
            g.frame = if g.isDecl(n.a) { g.declMark } else { before }
        }
        let top = g.a.newLabel()
        let cont = g.a.newLabel()
        let test = g.a.newLabel()
        let end = g.a.newLabel()
        // rotated: the condition is tested at the bottom (one branch per iteration), and first
        // reached by a jump to it
        if n.b >= 0 {
            g.a.jmp(test)
            append(mut &g.loopTops, top)
            append(mut &g.loopEnds, end)
        }
        g.a.bind(top)
        g.loops += 1
        append(mut &g.breakL, end)
        append(mut &g.contL, cont)
        g.stmt(n.d)
        pop(mut &g.breakL)
        pop(mut &g.contL)
        g.a.bind(cont)
        if n.c >= 0 { g.genEffect(n.c) }
        g.a.bind(test)
        if n.b >= 0 { g.branch(n.b, top, true) } else { g.a.jmp(top) }
        g.loops -= 1
        g.a.bind(end)
        if fillEnd >= 0 { g.a.bind(fillEnd) }
        g.frame = mark
    } else if k == ir.S_BREAK {
        if len(g.breakL) == 0 { g.fail(s, "break outside a loop") }
        g.a.jmp(g.breakL[len(g.breakL) - 1])
    } else if k == ir.S_CONTINUE {
        if len(g.contL) == 0 { g.fail(s, "continue outside a loop") }
        g.a.jmp(g.contL[len(g.contL) - 1])
    } else if k == ir.S_RETURN {
        if n.a >= 0 { g.genReturn(n.a) }
        g.epilogue()
    } else if k == ir.S_SWITCH {
        g.genSwitch(s)
    } else if k == ir.S_CASE || k == ir.S_DEFAULT {
        let l = g.caseL.getOr(&s, -1)
        if l < 0 { g.fail(s, "a case label outside the top level of a switch") }
        g.a.bind(l)
    } else if k == ir.S_EMPTY {
    } else {
        g.fail(s, "statement kind " + intToStr(k))
    }
}

// The statements of the list l from index j0, as a block generates them (the frame of each
// statement's temporaries released after it, a declaration's slot kept).
fn (g: mut &Gen) stmtsFrom(l: int, j0: int) {
    var j = j0
    while j < g.u.listLen(l) {
        let x = g.u.listAt(l, j)
        let before = g.frame
        if j + 1 < g.u.listLen(l) && (g.fusedIf(x, g.u.listAt(l, j + 1)) || g.fusedReturn(x, g.u.listAt(l, j + 1))) {
            j += 2
            continue
        }
        g.stmt(x)
        g.frame = if g.isDecl(x) { g.declMark } else { before }
        j += 1
    }
}

// Whether s is `if (...) break;`: no else, a body that is only break.
fn (g: &Gen) breakIf(s: int): bool {
    let n = g.u.nodes[s]
    if n.k != ir.S_IF || n.c >= 0 { return false }
    var b = n.b
    while g.u.nk(b) == ir.S_BLOCK && g.u.listLen(g.u.nodes[b].a) == 1 { b = g.u.listAt(g.u.nodes[b].a, 0) }
    return g.u.nk(b) == ir.S_BREAK
}

// The condition of the for s without its conversion to bool.
fn (g: &Gen) forCond(s: int): int {
    var b = g.u.nodes[s].b
    if g.u.nk(b) == ir.E_CAST && g.tk(g.u.nodes[b].ty) == ir.TY_BOOL { b = g.u.nodes[b].a }
    return b
}

// The pointer local (or constant address) under the conversions of the pointer p, or -1.
fn (g: &Gen) fillBase(p: int): int {
    var x = g.u.nodes[p].a
    while g.u.nk(x) == ir.E_CAST && g.tk(g.u.nodes[x].ty) == ir.TY_PTR { x = g.u.nodes[x].a }
    return x
}

// Whether e is a value that no store through a pointer can change: an integer constant, or a
// local whose address is never taken (perhaps converted between integers or pointers).
fn (g: &Gen) fixedVal(e: int): bool {
    var x = e
    while g.u.nk(x) == ir.E_CAST && (g.tk(g.u.nodes[x].ty) == ir.TY_PTR || g.tk(g.u.nodes[x].ty) >= ir.TY_BOOL &&
        g.tk(g.u.nodes[x].ty) <= ir.TY_U64) {
        x = g.u.nodes[x].a
    }
    let k = g.u.nk(x)
    let t = g.tk(g.u.nodes[x].ty)
    if t != ir.TY_PTR && (t < ir.TY_BOOL || t > ir.TY_U64) { return false }
    return k == ir.E_INT || k == ir.E_LOCAL && !g.aTaken[g.u.nodes[x].a]
}

// The for s as `for (T i = 0; i < n; i++) { *((E*)p + i) = v; }`, a fill: the assignment, else -1.
// i, n, p and v are locals whose addresses are never taken (n and v may be constants), so only
// the loop's own writes change them, and it writes i and the elements; E is an integer type
// (or bool) of 1, 2, 4 or 8 bytes. The elements p[0] to p[n - 1] then get v in order, and the
// loop ends with i = n (unused after it: i is declared by the loop), which is what rep stos
// writes: n elements of v from p up.
fn (g: &Gen) fillLoop(s: int): int {
    let n = g.u.nodes[s]
    if n.a < 0 || n.b < 0 || n.c < 0 || n.d < 0 { return -1 }
    // T i = 0;
    let d = g.u.nodes[n.a]
    if d.k != ir.S_DECL || d.b < 0 || d.c >= 0 || g.u.nk(d.b) != ir.E_INT || g.u.nodes[d.b].v != 0 { return -1 }
    let i = d.a
    let it = g.tk(g.u.locals[i].ty)
    if g.aTaken[i] || it < ir.TY_I8 || it > ir.TY_U64 || g.size(g.u.locals[i].ty) != 8 { return -1 }
    // i < n (signed)
    let c = g.u.nodes[g.forCond(s)]
    if c.k != ir.E_BIN || c.v != ir.OP_LT || g.u.nk(c.a) != ir.E_LOCAL || g.u.nodes[c.a].a != i || !g.fixedVal(c.b) {
        return -1
    }
    if !g.u.isSigned(g.u.nodes[c.a].ty) || g.size(g.u.nodes[c.b].ty) != 8 || g.u.nk(c.b) != ir.E_LOCAL && g.u.nk(c.b) != ir.E_INT {
        return -1
    }
    if g.u.nk(c.b) == ir.E_LOCAL && g.u.nodes[c.b].a == i { return -1 }
    // i++
    let st = g.u.nodes[n.c]
    if st.k != ir.E_POSTINC || st.v != 1 || g.u.nk(st.a) != ir.E_LOCAL || g.u.nodes[st.a].a != i { return -1 }
    // { *((E*)p + i) = v; }
    var b = n.d
    while g.u.nk(b) == ir.S_BLOCK && g.u.listLen(g.u.nodes[b].a) == 1 { b = g.u.listAt(g.u.nodes[b].a, 0) }
    if g.u.nk(b) != ir.S_EXPR { return -1 }
    let e = g.u.nodes[b].a
    let sa = g.u.nodes[e]
    if sa.k != ir.E_ASSIGN || g.u.nk(sa.a) != ir.E_DEREF { return -1 }
    let pa = g.u.nodes[sa.a].a
    let p = g.u.nodes[pa]
    let et = g.tk(sa.ty)
    if p.k != ir.E_PADD || p.v != g.size(sa.ty) || et < ir.TY_BOOL || et > ir.TY_U64 { return -1 }
    if g.u.nk(p.b) != ir.E_LOCAL || g.u.nodes[p.b].a != i { return -1 }
    let base = g.fillBase(pa)
    if g.u.nk(base) != ir.E_LOCAL || !g.fixedVal(base) || g.u.nodes[base].a == i || !g.fixedVal(sa.b) { return -1 }
    var vx = sa.b
    while g.u.nk(vx) == ir.E_CAST { vx = g.u.nodes[vx].a }
    if g.u.nk(vx) == ir.E_LOCAL && g.u.nodes[vx].a == i { return -1 }
    return e
}

// The while loop s (`while (1) { [bool c = E;] if (!c) break; ... }`, the C of every obx loop,
// or `while (E) ...`) with its test at the bottom: the number of statements of the body that
// make the test (0: the loop's own condition is it), or -1 when it is not generated rotated.
fn (g: &Gen) rotTest(s: int): int {
    let n = g.u.nodes[s]
    if g.u.nk(n.a) != ir.E_INT { return 0 }
    if g.u.nodes[n.a].v == 0 || g.u.nk(n.b) != ir.S_BLOCK { return -1 }
    let l = g.u.nodes[n.b].a
    let cnt = g.u.listLen(l)
    if cnt >= 1 && g.breakIf(g.u.listAt(l, 0)) { return 1 }
    if cnt >= 2 && g.fusesIf(g.u.listAt(l, 0), g.u.listAt(l, 1)) && g.breakIf(g.u.listAt(l, 1)) { return 2 }
    return -1
}

// The while loop s rotated: a jump to the test, the rest of the body, then the test, which
// jumps back to the body while the loop goes on. The same tests run in the same order (each
// iteration starts with the test); only the layout changes, so the live ranges by position
// (allocRegs) still hold: the test is reached from the entry and from the end of the body,
// as the top was. A continue jumps to the test.
fn (g: mut &Gen) rotated(s: int) {
    let n = g.u.nodes[s]
    let nt = g.rotTest(s)
    let top = g.a.newLabel()
    let test = g.a.newLabel()
    let end = g.a.newLabel()
    g.a.jmp(test)
    append(mut &g.loopTops, top)
    append(mut &g.loopEnds, end)
    g.a.bind(top)
    g.loops += 1
    append(mut &g.breakL, end)
    append(mut &g.contL, test)
    let mark = g.frame
    if nt == 0 {
        g.stmt(n.b)
    } else {
        g.stmtsFrom(g.u.nodes[n.b].a, nt)
    }
    g.frame = mark
    pop(mut &g.breakL)
    pop(mut &g.contL)
    g.a.bind(test)
    if nt == 0 {
        g.branch(n.a, top, true)
    } else {
        let l = g.u.nodes[n.b].a
        let ifS = g.u.listAt(l, nt - 1)
        let cond = g.u.nodes[ifS].a
        if nt == 2 {
            // `bool c = E; if (!c) break;` (or `if (c)`): E for c
            g.branch(g.u.nodes[g.u.listAt(l, 0)].b, top, g.u.nk(cond) == ir.E_LNOT)
        } else {
            g.branch(cond, top, false)
        }
    }
    g.loops -= 1
    g.a.bind(end)
}

// The expression e for its effect only (its value unused).
fn (g: mut &Gen) genEffect(e: int) {
    let x = g.u.nodes[e]
    if x.k == ir.E_POSTINC && g.regOf(x.a) >= 0 && x64.fits32(x.v) {
        // r++ (the value unused): in place, then normalized as gen does
        let r = g.regOf(x.a)
        g.a.aluI(x64.ADD, 8, r, x.v)
        g.normR(g.tk(x.ty), r)
        return
    }
    if x.k != ir.E_ASSIGN {
        g.gen(e)
        return
    }
    let r = g.regOf(x.a)
    if g.sameMem(x.a, x.b) {
        // x = x: nothing
    } else if r >= 0 && g.simple(x.b) && g.u.nodes[x.b].ty == x.ty {
        g.genInto(x.b, r)                       // straight into the register
    } else if r >= 0 && g.inPlace(r, x.b) {
        // done
    } else if r >= 0 && g.u.nodes[x.b].ty == x.ty && g.arithInto(x.b, r, true) {
        // computed in the register
    } else {
        g.unused = true
        g.gen(e)
        g.unused = false
    }
}

// r = rt_add_int(r, b) or rt_sub_int (checked or wrapping) for the register r of a local, with
// b a constant, a register or a word in memory: the operation on r in place (when it traps,
// r's value is never used), and true. Else false, nothing generated.
fn (g: mut &Gen) inPlace(r: int, v: int): bool {
    if g.u.nk(v) != ir.E_CALL { return false }
    let ar = arOp(g.rtName(v))
    let n = g.u.nodes[v]
    if ar.k != ir.TY_I64 || ar.op == ir.OP_MUL || g.u.listLen(n.b) < 2 { return false }
    if !ar.wrap && (g.u.listLen(n.b) != 3 || !g.isWhere(g.u.listAt(n.b, 2))) { return false }
    let a = g.u.listAt(n.b, 0)
    let b = g.u.listAt(n.b, 1)
    let bn = g.u.nodes[b]
    if g.regOf(a) != r || !((bn.k == ir.E_INT && x64.fits32(bn.v)) || g.regOf(b) >= 0 || g.memOperand(b)) {
        return false
    }
    g.aluSrc(if ar.op == ir.OP_ADD { x64.ADD } else { x64.SUB }, 8, r, g.pairSrc(-1, b))
    if !ar.wrap { g.a.jcc(x64.CC_O, g.stub(10, "integer overflow", g.u.listAt(n.b, 2))) }
    return true
}

// `bool c = e; if (!c) ...` (the C of every loop condition) with c named nowhere else:
// generates the if with e for its condition and no c, and true. Else false, nothing generated.
fn (g: mut &Gen) fusedIf(d: int, s: int): bool {
    let dn = g.u.nodes[d]
    if dn.k != ir.S_DECL || dn.b < 0 || dn.c >= 0 || g.uses[dn.a] != 2 { return false }
    if g.tk(g.u.locals[dn.a].ty) != ir.TY_BOOL || g.u.nk(s) != ir.S_IF { return false }
    let sn = g.u.nodes[s]
    var cond = sn.a
    var neg = false
    if g.u.nk(cond) == ir.E_LNOT {
        cond = g.u.nodes[cond].a
        neg = true
    }
    if g.u.nk(cond) != ir.E_LOCAL || g.u.nodes[cond].a != dn.a { return false }
    let jl = g.jumpOnly(sn.b)
    if jl >= 0 && sn.c < 0 {
        g.branch(dn.b, jl, !neg)
        return true
    }
    let elseL = g.a.newLabel()
    g.branch(dn.b, elseL, neg)
    let before = g.frame
    g.stmt(sn.b)
    g.frame = before
    if sn.c >= 0 {
        let end = g.a.newLabel()
        g.a.jmp(end)
        g.a.bind(elseL)
        g.stmt(sn.c)
        g.frame = before
        g.a.bind(end)
    } else {
        g.a.bind(elseL)
    }
    return true
}

// `T r = e; return r;` with r named nowhere else: generates return e, and true.
fn (g: mut &Gen) fusedReturn(d: int, s: int): bool {
    let dn = g.u.nodes[d]
    if dn.k != ir.S_DECL || dn.b < 0 || dn.c >= 0 || g.uses[dn.a] != 2 || g.u.nk(s) != ir.S_RETURN { return false }
    let r = g.u.nodes[s].a
    if r < 0 || g.u.nk(r) != ir.E_LOCAL || g.u.nodes[r].a != dn.a { return false }
    if g.u.nodes[r].ty != g.u.nodes[dn.b].ty || g.isAggr(g.u.nodes[r].ty) { return false }
    g.genReturn(dn.b)
    g.epilogue()
    return true
}

// The label s jumps to if it is only a break or a continue (perhaps in a block), else -1.
fn (g: &Gen) jumpOnly(s: int): int {
    let n = g.u.nodes[s]
    if n.k == ir.S_BLOCK && g.u.listLen(n.a) == 1 { return g.jumpOnly(g.u.listAt(n.a, 0)) }
    if n.k == ir.S_BREAK && len(g.breakL) > 0 { return g.breakL[len(g.breakL) - 1] }
    if n.k == ir.S_CONTINUE && len(g.contL) > 0 { return g.contL[len(g.contL) - 1] }
    return -1
}

fn (g: mut &Gen) genReturn(x: int) {
    let t = g.retTy
    g.gen(x)
    if !g.isAggr(t) { return }
    let cls = g.classify(t)
    if cls[0] == CL_MEM {
        g.a.load(8, R11, rbp(g.retPtr))
        g.copyMem(x64.mem(R11, 0), x64.mem(RAX, 0), g.size(t))
        g.a.movRR(8, RAX, R11)
        return
    }
    if g.size(t) % 8 == 0 {
        // whole eightbytes: loaded from the value itself, the one for rax last
        var nx = 0
        var raxOff = -1
        for i in 0..len(cls) {
            if cls[i] == CL_SSE {
                g.a.movsdLoad(nx, x64.mem(RAX, 8 * i))
                nx += 1
            } else if cls[i] == CL_INT && raxOff < 0 {
                raxOff = 8 * i
            } else if cls[i] == CL_INT {
                g.a.load(8, RDX, x64.mem(RAX, 8 * i))
            }
        }
        if raxOff >= 0 { g.a.load(8, RAX, x64.mem(RAX, raxOff)) }
        return
    }
    let s = g.tempFor(t)
    g.copyMem(rbp(s), x64.mem(RAX, 0), g.size(t))
    g.loadEightbytes(&cls, s)
}

// Loads the eightbytes of the value at rbp+s into the result registers.
fn (g: mut &Gen) loadEightbytes(cls: &[]int, s: int) {
    var ni = 0
    var nx = 0
    for i in 0..len(cls) {
        if cls[i] == CL_SSE {
            g.a.movsdLoad(nx, rbp(s + 8 * i))
            nx += 1
        } else if cls[i] == CL_INT {
            g.a.load(8, if ni == 0 { RAX } else { RDX }, rbp(s + 8 * i))
            ni += 1
        }
    }
}

fn (g: mut &Gen) genSwitch(s: int) {
    let n = g.u.nodes[s]
    if g.size(n.ty) > 8 { g.fail(s, "switch on a 128-bit integer") }
    g.gen(n.a)
    let body = n.b
    if g.u.nk(body) != ir.S_BLOCK { g.fail(s, "a switch without a block") }
    let lst = g.u.nodes[body].a
    let end = g.a.newLabel()
    var deflt = end
    for j in 0..g.u.listLen(lst) {
        let x = g.u.listAt(lst, j)
        let xk = g.u.nk(x)
        if xk == ir.S_CASE || xk == ir.S_DEFAULT {
            let l = g.a.newLabel()
            g.caseL.put(x, l)
            if xk == ir.S_DEFAULT {
                deflt = l
            } else {
                let v = g.u.nodes[x].v
                if x64.fits32(v) {
                    g.a.aluI(x64.CMP, 8, RAX, v)
                } else {
                    g.a.movRI(RCX, v)
                    g.a.alu(x64.CMP, 8, RAX, RCX)
                }
                g.a.jcc(x64.CC_E, l)
            }
        }
    }
    g.a.jmp(deflt)
    append(mut &g.breakL, end)
    g.stmt(body)
    pop(mut &g.breakL)
    g.a.bind(end)
}

// ---------------------------------------------------------------- memory

// Copies n bytes from src to dst (bases other than rax for dst, r10, rsi, rdi, rcx).
fn (g: mut &Gen) copyMem(dst: x64.Mem, src: x64.Mem, n: int) {
    if n > 128 {
        g.a.lea(RSI, src)
        g.a.lea(RDI, dst)
        g.a.movRI(RCX, n)
        g.a.repMovsb()
        return
    }
    var o = 0
    for w in [8, 4, 2, 1] {
        while n - o >= w {
            g.a.load(w, R10, at(src, o))
            g.a.store(w, at(dst, o), R10)
            o += w
        }
    }
}

// Zeroes n bytes at rbp+s.
fn (g: mut &Gen) zeroFrame(s: int, n: int) {
    if n > 128 {
        g.a.lea(RDI, rbp(s))
        g.a.alu(x64.XOR, 4, RAX, RAX)
        g.a.movRI(RCX, n)
        g.a.repStosb()
        return
    }
    var o = 0
    for w in [8, 4, 2, 1] {
        while n - o >= w {
            g.a.storeI(w, rbp(s + o), 0)
            o += w
        }
    }
}

// Normalizes rax (or r) to the integer kind k.
fn (g: mut &Gen) normR(k: int, r: int) {
    if k == ir.TY_BOOL || k == ir.TY_U8 {
        g.a.zx(1, r, r)
    } else if k == ir.TY_I8 {
        g.a.sx(1, r, r)
    } else if k == ir.TY_U16 {
        g.a.zx(2, r, r)
    } else if k == ir.TY_I16 {
        g.a.sx(2, r, r)
    } else if k == ir.TY_U32 {
        g.a.zx(4, r, r)
    } else if k == ir.TY_I32 {
        g.a.sx(4, r, r)
    }
}

fn (g: mut &Gen) norm(t: int) { g.normR(g.tk(t), RAX) }

// Loads an integer or pointer of type t from m into r, normalized.
fn (g: mut &Gen) loadInt(t: int, r: int, m: x64.Mem) {
    let src = g.a.storedTag(m, t)
    if src >= 0 {
        // the value of type t the instruction before stored there, normalized in src
        if src != r { g.a.movRR(8, r, src) }
        return
    }
    let k = g.tk(t)
    if k == ir.TY_BOOL || k == ir.TY_U8 {
        g.a.loadZX(1, r, m)
    } else if k == ir.TY_I8 {
        g.a.loadSX(1, r, m)
    } else if k == ir.TY_U16 {
        g.a.loadZX(2, r, m)
    } else if k == ir.TY_I16 {
        g.a.loadSX(2, r, m)
    } else if k == ir.TY_U32 {
        g.a.loadZX(4, r, m)
    } else if k == ir.TY_I32 {
        g.a.loadSX(4, r, m)
    } else {
        g.a.load(8, r, m)
    }
}

// Loads the value of type t at m into the value registers (an aggregate: its address).
fn (g: mut &Gen) loadT(t: int, m: x64.Mem) {
    if g.isAggr(t) {
        g.a.lea(RAX, m)
    } else if g.isF(t) {
        g.a.movsdLoad(0, m)
    } else if g.is128(t) {
        if m.base == RAX || m.index == RAX {
            g.a.load(8, RDX, at(m, 8))
            g.a.load(8, RAX, m)
        } else {
            g.a.load(8, RAX, m)
            g.a.load(8, RDX, at(m, 8))
        }
    } else {
        g.loadInt(t, RAX, m)
    }
}

// Stores the value in the value registers (an aggregate: from the address in rax) at m.
// storeT of rax holding a value of type s (converted to t): when that is normalized for t and
// narrower than 8 bytes, a store loadInt can see (it holds t's value normalized).
fn (g: mut &Gen) storeFrom(s: int, t: int, m: x64.Mem) {
    if g.u.isScalar(t) && !g.isF(t) && !g.is128(t) && g.size(t) < 8 && g.normAs(s, t) {
        g.a.storeTag(g.size(t), m, RAX, t)
        return
    }
    g.storeT(t, m)
}

fn (g: mut &Gen) storeT(t: int, m: x64.Mem) {
    if g.isAggr(t) {
        g.copyMem(m, x64.mem(RAX, 0), g.size(t))
    } else if g.isF(t) {
        g.a.movsdStore(m, 0)
    } else if g.is128(t) {
        g.a.store(8, m, RAX)
        g.a.store(8, at(m, 8), RDX)
    } else {
        g.a.store(g.size(t), m, RAX)
    }
}

// The memory of an lvalue that needs no code (a local or a member of one), or base -9.
fn (g: &Gen) staticMem(e: int): x64.Mem {
    let n = g.u.nodes[e]
    if n.k == ir.E_LOCAL {
        if g.reg[n.a] >= 0 { return x64.mem(-9, 0) }
        return rbp(g.slots[n.a])
    }
    if n.k == ir.E_MEMBER {
        let m = g.staticMem(n.a)
        if m.base != -9 { return at(m, n.v) }
    }
    return x64.mem(-9, 0)
}

// ---------------------------------------------------------------- initializers

// Fills the n bytes at rbp+s from initializer entries (zero first).
fn (g: mut &Gen) initEntries(s: int, n: int, ents: int) {
    g.zeroFrame(s, n)
    for j in 0..g.u.listLen(ents) {
        let en = g.u.nodes[g.u.listAt(ents, j)]
        let t = en.ty
        let x = en.a
        if g.u.nk(x) == ir.E_STR && g.tk(t) == ir.TY_ARR {
            let str = g.u.nodes[x].s
            var cnt = len(str) + 1
            if cnt > g.size(t) { cnt = g.size(t) }
            g.a.movRSym(RAX, g.symStr(str), 0)
            g.copyMem(rbp(s + en.v), x64.mem(RAX, 0), cnt)
        } else {
            g.gen(x)
            g.storeT(t, rbp(s + en.v))
        }
    }
}

// ---------------------------------------------------------------- expressions

fn (g: mut &Gen) genAddr(e: int) {
    let n = g.u.nodes[e]
    let k = n.k
    if k == ir.E_LOCAL {
        if g.reg[n.a] >= 0 { g.fail(e, "the address of a local in a register") }
        g.a.lea(RAX, rbp(g.slots[n.a]))
    } else if k == ir.E_GLOBAL {
        g.a.movRSym(RAX, g.globalSym[n.a], 0)
    } else if k == ir.E_FUNC {
        let s = g.symFunc(n.a, e)
        if g.syms[s].kind == SK_DYN { g.a.loadAt(RAX, s) } else { g.a.movRSym(RAX, s, 0) }
    } else if k == ir.E_STR {
        g.a.movRSym(RAX, g.symStr(n.s), 0)
    } else if k == ir.E_DEREF {
        g.gen(n.a)
    } else if k == ir.E_MEMBER {
        let m = g.place(e)
        if m.base != RAX || m.index >= 0 || m.disp != 0 { g.a.lea(RAX, m) }
    } else if k == ir.E_CLIT {
        let s = g.tempFor(n.ty)
        g.initEntries(s, g.size(n.ty), n.b)
        g.a.lea(RAX, rbp(s))
    } else if g.isAggr(n.ty) {
        g.gen(e)
    } else {
        g.fail(e, "the address of a non-lvalue")
    }
}

// Whether e can be loaded into a register other than rax with no other register used.
fn (g: &Gen) simple(e: int): bool {
    let n = g.u.nodes[e]
    if n.k == ir.E_INT || g.regOf(e) >= 0 || g.constAddrSym(e) >= 0 { return true }
    if g.noopCast(e) { return g.simple(n.a) }
    if g.isAggr(n.ty) || g.isF(n.ty) || g.is128(n.ty) { return false }
    return (n.k == ir.E_LOCAL || n.k == ir.E_MEMBER) && g.staticMem(e).base != -9
}

fn (g: mut &Gen) genInto(e: int, r: int) {
    let n = g.u.nodes[e]
    if n.k == ir.E_INT {
        g.a.movRI(r, n.v)
    } else if g.regOf(e) >= 0 {
        g.a.movRR(8, r, g.regOf(e))
    } else if g.constAddrSym(e) >= 0 {
        g.a.movRSym(r, g.constAddrSym(e), 0)
    } else if g.noopCast(e) {
        g.genInto(n.a, r)
    } else {
        g.loadInt(n.ty, r, g.staticMem(e))
    }
}

// Whether e is a conversion between integers or pointers that needs no code: the value of the
// operand, normalized, is also normalized for the result type (normAs).
fn (g: &Gen) noopCast(e: int): bool {
    let n = g.u.nodes[e]
    if n.k != ir.E_CAST { return false }
    let s = g.u.nodes[n.a].ty
    if g.tk(n.ty) == ir.TY_VOID || g.isF(n.ty) || g.isF(s) || g.isAggr(n.ty) || g.isAggr(s) || g.is128(n.ty) ||
        g.is128(s) {
        return false
    }
    return g.normAs(s, n.ty)
}

// Whether evaluating x has no effect but its value or a trap (no assignments, and no calls
// but those of the runtime functions generated inline that change nothing).
fn (g: &Gen) pure(x: int): bool {
    if x < 0 { return true }
    let n = g.u.nodes[x]
    let k = n.k
    if k == ir.E_ASSIGN || k == ir.E_POSTINC || k == ir.E_CLIT { return false }
    if k == ir.E_CALL {
        let c = n.a
        if g.u.nk(c) != ir.E_DECAY || g.u.nk(g.u.nodes[c].a) != ir.E_FUNC { return false }
        let name = g.u.funcs[g.u.nodes[g.u.nodes[c].a].a].name
        if name != "rt_idx" && name != "rt_str_byte" && arOp(name).k < 0 && divOp(name).k < 0 { return false }
        for j in 0..g.u.listLen(n.b) {
            if !g.pure(g.u.listAt(n.b, j)) { return false }
        }
        return true
    }
    if k == ir.E_INT || k == ir.E_LOCAL || k == ir.E_GLOBAL || k == ir.E_STR || k == ir.E_FUNC || k == ir.E_FLT {
        return true
    }
    if k == ir.E_BIN { return g.pure(n.a) && g.pure(n.b) }
    return g.pure(n.a) && g.pure(n.b) && g.pure(n.c)
}

// The symbol of e if it is the address of a string literal or a global, else -1.
fn (g: &Gen) constAddrSym(e: int): int {
    let n = g.u.nodes[e]
    if n.k != ir.E_DECAY && n.k != ir.E_ADDR { return -1 }
    let x = g.u.nodes[n.a]
    if x.k == ir.E_GLOBAL { return g.globalSym[x.a] }
    if x.k == ir.E_STR { return g.strSym.getOr(&x.s, -1) }
    return -1
}

// Whether evaluating x may assign the local in a register r.
fn (g: &Gen) writesReg(x: int, r: int): bool {
    if x < 0 { return false }
    let n = g.u.nodes[x]
    let k = n.k
    if k == ir.E_INT || k == ir.E_LOCAL || k == ir.E_GLOBAL || k == ir.E_STR || k == ir.E_FUNC || k == ir.E_FLT {
        return false
    }
    if (k == ir.E_ASSIGN || k == ir.E_POSTINC) && g.regOf(n.a) == r { return true }
    // &l of a local in a register: an argument of a call generated in place whose body names l
    // for the parameter (aliases), and may assign it
    if k == ir.E_ADDR && g.u.nk(n.a) == ir.E_LOCAL && g.reg[g.u.nodes[n.a].a] == r { return true }
    if k == ir.E_CALL || k == ir.E_CLIT {
        if g.writesReg(n.a, r) && k == ir.E_CALL { return true }
        for j in 0..g.u.listLen(n.b) {
            if g.writesReg(g.u.listAt(n.b, j), r) { return true }
        }
        return false
    }
    if k == ir.E_BIN { return g.writesReg(n.a, r) || g.writesReg(n.b, r) }
    return g.writesReg(n.a, r) || g.writesReg(n.b, r) || g.writesReg(n.c, r)
}

// The second operand of an instruction: an immediate or a register.
type Src = value record {
    imm: bool
    v: int
    r: int              // -2: the memory m
    m: x64.Mem
}

// a into rax, and b as an operand: an immediate, the register of a local, or rcx.
fn (g: mut &Gen) pairSrc(a: int, b: int): Src { return g.pairSrcK(a, b, false) }

// pairSrc; when comm (the operation is commutative) and both operands need code, the operand
// may be a, which waited in a register or slot while b was generated into rax (pairC).
fn (g: mut &Gen) pairSrcK(a: int, b: int, comm: bool): Src {
    let bn = g.u.nodes[b]
    if a < 0 {
        if bn.k == ir.E_INT { return Src{imm: true, v: bn.v, r: -1, m: NO_MEM} }
        if g.regOf(b) >= 0 { return Src{imm: false, v: 0, r: g.regOf(b), m: NO_MEM} }
        return Src{imm: false, v: 0, r: -2, m: g.staticMem(b)}
    }
    if bn.k == ir.E_INT && x64.fits32(bn.v) {
        g.gen(a)
        return Src{imm: true, v: bn.v, r: -1, m: NO_MEM}
    }
    if g.regOf(b) >= 0 {
        g.gen(a)
        return Src{imm: false, v: 0, r: g.regOf(b), m: NO_MEM}
    }
    if g.memOperand(b) {
        g.gen(a)
        return Src{imm: false, v: 0, r: -2, m: g.staticMem(b)}
    }
    return g.pairC(a, b, comm)
}

// pairSrc for a commutative operation: b into rax and a as the operand when a needs no code
// and b does (a read after b: b assigns neither a's register nor, for a in memory, anything).
fn (g: mut &Gen) pairSrcC(a: int, b: int): Src {
    if !g.srcOnly(b) && g.srcOnly(a) && (g.regOf(a) < 0 || !g.writesReg(b, g.regOf(a))) &&
        (!g.memOperand(a) || g.pure(b)) {
        return g.pairSrcK(b, a, true)
    }
    return g.pairSrcK(a, b, true)
}

// Whether pairSrc takes x as the operand without code.
fn (g: &Gen) srcOnly(x: int): bool {
    let n = g.u.nodes[x]
    return (n.k == ir.E_INT && x64.fits32(n.v)) || g.regOf(x) >= 0 || g.memOperand(x)
}

// Whether e is an 8-byte integer or pointer in memory that needs no code (a local in its
// slot, a member of one).
fn (g: &Gen) memOperand(e: int): bool {
    let n = g.u.nodes[e]
    return (n.k == ir.E_LOCAL || n.k == ir.E_MEMBER) && g.size(n.ty) == 8 && !g.isF(n.ty) && !g.isAggr(n.ty) &&
        g.regOf(e) < 0 && g.staticMem(e).base != -9
}

// Compares a with b (integers or pointers of 8 bytes or less, normalized), comparing the
// register of a local in place.
fn (g: mut &Gen) cmpPair(a: int, b: int) {
    let ra = g.regOf(a)
    let bn = g.u.nodes[b]
    if ra >= 0 && (g.regOf(b) >= 0 || (bn.k == ir.E_INT && x64.fits32(bn.v)) || g.memOperand(b)) {
        g.aluSrc(x64.CMP, 8, ra, g.pairSrc(-1, b))
        return
    }
    if ra >= 0 && g.simple(b) {
        g.genInto(b, RCX)
        g.a.alu(x64.CMP, 8, ra, RCX)
        return
    }
    g.aluSrc(x64.CMP, 8, RAX, g.pairSrc(a, b))
}

fn (g: mut &Gen) aluSrc(op: int, size: int, dst: int, s: Src) {
    if s.imm {
        g.a.aluI(op, size, dst, s.v)
    } else if s.r == -2 {
        g.a.aluRM(op, size, dst, s.m)
    } else {
        g.a.alu(op, size, dst, s.r)
    }
}

fn (g: mut &Gen) imulSrc(size: int, dst: int, s: Src) {
    if s.imm {
        g.a.imulI(size, dst, dst, s.v)
    } else if s.r == -2 {
        g.a.load(8, RCX, s.m)
        g.a.imul(size, dst, RCX)
    } else {
        g.a.imul(size, dst, s.r)
    }
}

// The operand into rcx.
fn (g: mut &Gen) srcRCX(s: Src) {
    if s.imm {
        g.a.movRI(RCX, s.v)
    } else if s.r == -2 {
        g.a.load(8, RCX, s.m)
    } else if s.r != RCX {
        g.a.movRR(8, RCX, s.r)
    }
}

// a into rax, b into rcx (integers or pointers).
fn (g: mut &Gen) pair(a: int, b: int) {
    let s = g.pairC(a, b, false)
    if s.r != RCX { g.fail(a, "pair") }
}

// a into rax and b into rcx, the operand returned; or, when comm (the operation is commutative)
// and a waits while b is generated, b into rax and the operand is where a waited.
fn (g: mut &Gen) pairC(a: int, b: int, comm: bool): Src {
    let rcx = Src{imm: false, v: 0, r: RCX, m: NO_MEM}
    if g.simple(b) {
        g.gen(a)
        g.genInto(b, RCX)
        return rcx
    }
    let an = g.u.nodes[a]
    if !g.isAggr(an.ty) && !g.isF(an.ty) && !g.is128(an.ty) &&
        (an.k == ir.E_INT || g.constAddrSym(a) >= 0 || (g.regOf(a) >= 0 && !g.writesReg(b, g.regOf(a))) ||
        (g.simple(a) && g.pure(b))) {
        g.gen(b)
        g.a.movRR(8, RCX, RAX)
        g.genInto(a, RAX)
        return rcx
    }
    g.gen(a)
    let h = g.hold(b, g.quietTree(b))
    g.gen(b)
    g.unhold(h)
    if comm { return g.heldSrc(h) }
    g.a.movRR(8, RCX, RAX)
    g.unholdInto(h, RAX)
    return rcx
}

// Where a value waits while other code runs (hold): a register, or the frame slot s.
type Hold = value record {
    r: int              // the register, or -1
    s: int              // the slot when r < 0
    quiet: bool         // r is one of tmpRegs
}

// Puts rax (an integer or pointer, 8 bytes) aside while the code of the expression x (and of the
// others of its statement that the caller generates before unhold) runs: in a register of
// tmpRegs when that code is quiet, else in a callee-saved register that no local holds at x's
// position nor another temporary (calleeTemp; a new one only when the code is not quiet), else
// in a frame slot. Holds are released in the reverse order.
fn (g: mut &Gen) hold(x: int, quiet: bool): Hold {
    if quiet && g.tmpUsed < len(g.tmpRegs) {
        let r = g.tmpRegs[g.tmpUsed]
        g.tmpUsed += 1
        g.a.movRR(8, r, RAX)
        return Hold{r: r, s: 0, quiet: true}
    }
    let r = g.calleeTemp(x, !quiet)
    if r >= 0 {
        g.a.movRR(8, r, RAX)
        return Hold{r: r, s: 0, quiet: false}
    }
    let s = g.temp(8, 8)
    g.a.store(8, rbp(s), RAX)
    return Hold{r: -1, s: s, quiet: false}
}

// Releases h: its register may be taken again. The value can still be read before any other
// code is generated (heldSrc, unholdInto).
fn (g: mut &Gen) unhold(h: Hold) {
    if h.quiet {
        g.tmpUsed -= 1
    } else if h.r >= 0 {
        pop(mut &g.held)
    }
}

// The held value as an operand.
fn (g: &Gen) heldSrc(h: Hold): Src {
    if h.r >= 0 { return Src{imm: false, v: 0, r: h.r, m: NO_MEM} }
    return Src{imm: false, v: 0, r: -2, m: rbp(h.s)}
}

// The held value into register r.
fn (g: mut &Gen) unholdInto(h: Hold, r: int) {
    if h.r >= 0 {
        if h.r != r { g.a.movRR(8, r, h.r) }
    } else {
        g.a.load(8, r, rbp(h.s))
    }
}

// The position of the code of node x: the scan's (a node it saw at one position), in a body
// generated in place that of the outermost call; -1 when not known.
fn (g: &Gen) posAt(x: int): int {
    if len(g.inlStack) > 0 { return g.inlPos }
    if x >= 0 && x < len(g.posOf) && g.posSeen[x] == g.stamp { return g.posOf[x] }
    return -1
}

// Whether callee-saved register LOCAL_REGS[i] holds no temporary and no local's value at
// position p: no local given it is live there (p < 0, not known: no local has it at all).
fn (g: &Gen) calleeFree(i: int, p: int): bool {
    let r = LOCAL_REGS[i]
    for h in g.held {
        if h == r { return false }
    }
    if i >= g.nLocalRegs { return true }
    if p < 0 { return false }
    for l in g.touched {
        if g.reg[l] == r {
            let sp = g.spans(l)
            for j in 0..len(sp) / 2 {
                if sp[2 * j] <= p && p <= sp[2 * j + 1] { return false }
            }
        }
    }
    return true
}

// A callee-saved register for a temporary at the position of node x, held from now on (unhold
// releases it), or -1: a free one of those saved, else, when fresh, the next one, saved from now
// on (its slot is placed after the body). Not when a return without restores was generated
// already: that return would not restore it. A new register costs its save and restore on every
// call of the function; a slot costs a store and a load, which are slow around a call (the
// load waits for the store through the callee's frame), so fresh is for values held across
// calls.
fn (g: mut &Gen) calleeTemp(x: int, fresh: bool): int {
    let p = g.posAt(x)
    var r = -1
    for i in 0..len(g.saved) {
        if r < 0 && g.calleeFree(i, p) { r = LOCAL_REGS[i] }
    }
    if r < 0 && fresh && len(g.saved) < len(LOCAL_REGS) && !g.bareRet {
        append(mut &g.saved, 0)
        r = LOCAL_REGS[len(g.saved) - 1]
    }
    if r >= 0 { append(mut &g.held, r) }
    return r
}

// Whether the code of the expression x changes no register of QUIET_REGS but those of locals
// (no node of it is loud, and its calls are runtime functions generated inline that change only
// rax, rcx and rdx); its own pairs take the next of tmpRegs.
fn (g: &Gen) quietTree(x: int): bool {
    if x < 0 { return true }
    let n = g.u.nodes[x]
    let k = n.k
    if k >= ir.S_DECL || g.loudNode(x) { return false }
    if k == ir.E_CALL { return g.quietRt(x) && g.quietList(n.b) }
    if k == ir.E_CLIT { return g.quietList(n.b) }
    if k == ir.E_INT || k == ir.E_FLT || k == ir.E_STR || k == ir.E_LOCAL || k == ir.E_GLOBAL || k == ir.E_FUNC {
        return true
    }
    if !g.quietTree(n.a) { return false }
    if k == ir.E_BIN || k == ir.E_LAND || k == ir.E_LOR || k == ir.E_ASSIGN || k == ir.E_PADD || k == ir.E_COND {
        if !g.quietTree(n.b) { return false }
    }
    if k == ir.E_COND { return g.quietTree(n.c) }
    return true
}

fn (g: &Gen) quietList(l: int): bool {
    if l < 0 { return true }
    for j in 0..g.u.listLen(l) {
        if !g.quietTree(g.u.listAt(l, j)) { return false }
    }
    return true
}

// a into rax:rdx, b into r8:r9 (128-bit).
fn (g: mut &Gen) pair128(a: int, b: int) {
    g.gen(a)
    let s = g.temp(16, 16)
    g.a.store(8, rbp(s), RAX)
    g.a.store(8, rbp(s + 8), RDX)
    g.gen(b)
    g.a.movRR(8, R8, RAX)
    g.a.movRR(8, R9, RDX)
    g.a.load(8, RAX, rbp(s))
    g.a.load(8, RDX, rbp(s + 8))
}

// a into xmm0, b into xmm1.
fn (g: mut &Gen) pairF(a: int, b: int) {
    g.gen(a)
    let s = g.temp(8, 8)
    g.a.movsdStore(rbp(s), 0)
    g.gen(b)
    g.a.sse(x64.MOVSD, 1, 0)
    g.a.movsdLoad(0, rbp(s))
}

fn (g: mut &Gen) gen(e: int) {
    let n = g.u.nodes[e]
    let k = n.k
    let t = n.ty
    if k == ir.E_INT {
        g.a.movRI(RAX, n.v)
    } else if k == ir.E_FLT {
        g.a.movRI(RAX, floatBits(n.f))
        g.a.movqXR(0, RAX)
    } else if k == ir.E_LOCAL || k == ir.E_MEMBER || k == ir.E_DEREF || k == ir.E_GLOBAL || k == ir.E_STR ||
        k == ir.E_FUNC {
        if g.isAggr(t) || k == ir.E_FUNC {
            g.genAddr(e)
            return
        }
        if g.regOf(e) >= 0 {
            g.a.movRR(8, RAX, g.regOf(e))
            return
        }
        let m = g.staticMem(e)
        if m.base != -9 {
            g.loadT(t, m)
        } else {
            g.loadT(t, g.place(e))
        }
    } else if k == ir.E_ADDR || k == ir.E_DECAY {
        g.genAddr(n.a)
    } else if k == ir.E_CLIT {
        g.genAddr(e)
    } else if k == ir.E_CALL {
        g.genCall(e)
    } else if k == ir.E_CAST {
        g.genCast(e)
    } else if k == ir.E_BIN {
        g.genBin(e)
    } else if k == ir.E_NEG {
        g.gen(n.a)
        if g.isF(t) {
            g.a.movRI(RCX, -9223372036854775807 - 1)
            g.a.movqXR(1, RCX)
            g.a.sse66(x64.XORPD, 0, 1)
        } else if g.is128(t) {
            g.a.unary(x64.NEG, 8, RAX)
            g.a.aluI(x64.ADC, 8, RDX, 0)
            g.a.unary(x64.NEG, 8, RDX)
        } else {
            g.a.unary(x64.NEG, 8, RAX)
            g.norm(t)
        }
    } else if k == ir.E_BNOT {
        g.gen(n.a)
        g.a.unary(x64.NOT, 8, RAX)
        if g.is128(t) {
            g.a.unary(x64.NOT, 8, RDX)
        } else {
            g.norm(t)
        }
    } else if k == ir.E_LNOT {
        g.genTest(n.a)
        g.a.setcc(x64.CC_E, RAX)
        g.a.zx(1, RAX, RAX)
    } else if k == ir.E_LAND || k == ir.E_LOR {
        let other = g.a.newLabel()
        let end = g.a.newLabel()
        let isAnd = k == ir.E_LAND
        g.branch(n.a, other, !isAnd)
        g.branch(n.b, other, !isAnd)
        g.a.movRI(RAX, if isAnd { 1 } else { 0 })
        g.a.jmp(end)
        g.a.bind(other)
        g.a.movRI(RAX, if isAnd { 0 } else { 1 })
        g.a.bind(end)
    } else if k == ir.E_COND {
        let elseL = g.a.newLabel()
        let end = g.a.newLabel()
        g.branch(n.a, elseL, false)
        g.gen(n.b)
        g.a.jmp(end)
        g.a.bind(elseL)
        g.gen(n.c)
        g.a.bind(end)
    } else if k == ir.E_ASSIGN {
        g.genAssign(e)
    } else if k == ir.E_POSTINC && g.regOf(n.a) >= 0 {
        let r = g.regOf(n.a)
        g.a.movRR(8, RAX, r)
        g.a.lea(r, x64.mem(RAX, n.v))
        g.normR(g.tk(t), r)
    } else if k == ir.E_POSTINC {
        var m = g.staticMem(n.a)
        if m.base == -9 {
            g.genAddr(n.a)
            g.a.movRR(8, R11, RAX)
            m = x64.mem(R11, 0)
        }
        g.loadInt(t, RAX, m)
        g.a.lea(RCX, x64.mem(RAX, n.v))
        g.a.store(g.size(t), m, RCX)
    } else if k == ir.E_PADD && g.paddFold(e) {
        g.a.lea(RAX, g.paddMem(e))
    } else if k == ir.E_PADD {
        let b = n.b
        if g.u.nk(b) == ir.E_INT && x64.fits32(g.u.nodes[b].v * n.v) {
            g.gen(n.a)
            let d = g.u.nodes[b].v * n.v
            if d != 0 { g.a.lea(RAX, x64.mem(RAX, d)) }
        } else {
            g.pair(n.a, b)
            let sc = n.v
            if sc == 1 || sc == 2 || sc == 4 || sc == 8 {
                g.a.lea(RAX, x64.memx(RAX, RCX, sc, 0))
            } else {
                g.a.movRI(RDX, sc)
                g.a.imul(8, RCX, RDX)
                g.a.alu(x64.ADD, 8, RAX, RCX)
            }
        }
    } else {
        g.fail(e, "expression kind " + intToStr(k))
    }
}

// The code of the lvalue e but the last address arithmetic: the operand that names it (in the
// frame, at a register local, at rax, or at what paddMem makes).
fn (g: mut &Gen) place(e: int): x64.Mem {
    let n = g.u.nodes[e]
    let k = n.k
    if k == ir.E_LOCAL && g.reg[n.a] < 0 { return rbp(g.slots[n.a]) }
    if k == ir.E_MEMBER {
        let m = g.staticMem(e)
        if m.base != -9 { return m }
        return at(g.place(n.a), n.v)
    }
    if k == ir.E_DEREF {
        if g.paddFold(n.a) { return g.paddMem(n.a) }
        if g.regOf(n.a) >= 0 { return x64.mem(g.regOf(n.a), 0) }
        g.gen(n.a)
        return x64.mem(RAX, 0)
    }
    g.genAddr(e)
    return x64.mem(RAX, 0)
}

// Whether the pointer e is p + i * size that paddMem folds into an operand: size 1, 2, 4 or 8,
// p needs no code but a load, and i is a local in a register, an rt_idx of one (the check done
// first, in place), or pure (generated first, as pair does).
fn (g: &Gen) paddFold(e: int): bool {
    let n = g.u.nodes[e]
    if n.k != ir.E_PADD || g.u.nk(n.b) == ir.E_INT || !g.simple(n.a) { return false }
    if n.v != 1 && n.v != 2 && n.v != 4 && n.v != 8 { return false }
    return g.regOf(n.b) >= 0 || g.idxReg(n.b) >= 0 || g.pure(n.b)
}

// The register of local i in rt_idx(i, len, w) (inline, len needing no code), else -1.
fn (g: &Gen) idxReg(b: int): int {
    if g.u.nk(b) != ir.E_CALL || g.rtName(b) != "rt_idx" { return -1 }
    let l = g.u.nodes[b].b
    if g.u.listLen(l) != 3 || !g.isWhere(g.u.listAt(l, 2)) || !g.srcOnly(g.u.listAt(l, 1)) { return -1 }
    return g.regOf(g.u.listAt(l, 0))
}

// The code of p + i * size (paddFold) but the last add: the operand [p + i * size].
fn (g: mut &Gen) paddMem(e: int): x64.Mem {
    let n = g.u.nodes[e]
    let sc = n.v
    var ri = g.regOf(n.b)
    if ri < 0 && g.idxReg(n.b) >= 0 {
        let l = g.u.nodes[n.b].b
        ri = g.idxReg(n.b)
        g.aluSrc(x64.CMP, 8, ri, g.pairSrc(-1, g.u.listAt(l, 1)))
        g.a.jcc(x64.CC_AE, g.stub(3, "index out of range", g.u.listAt(l, 2)))
    }
    if ri >= 0 {
        if g.regOf(n.a) >= 0 { return x64.memx(g.regOf(n.a), ri, sc, 0) }
        g.genInto(n.a, RAX)
        return x64.memx(RAX, ri, sc, 0)
    }
    g.gen(n.b)
    if g.regOf(n.a) >= 0 { return x64.memx(g.regOf(n.a), RAX, sc, 0) }
    g.genInto(n.a, RCX)
    return x64.memx(RCX, RAX, sc, 0)
}

fn (g: mut &Gen) genAssign(e: int) {
    let unused = replace(mut &g.unused, false)
    let n = g.u.nodes[e]
    let lhs = n.a
    let t = n.ty
    if g.regOf(lhs) >= 0 {
        g.gen(n.b)
        if !g.normAs(g.u.nodes[n.b].ty, t) { g.normR(g.tk(t), RAX) }
        g.a.movRR(8, g.regOf(lhs), RAX)
        return
    }
    let m = g.staticMem(lhs)
    if m.base != -9 && g.u.nk(n.b) == ir.E_CALL && g.rtName(n.b) == "rt_str_dup" &&
        g.sameMem(lhs, g.u.listAt(g.u.nodes[n.b].b, 0)) {
        g.gen(n.b)                          // x = rt_str_dup(x): the count only
        return
    }
    if m.base != -9 && g.isAggr(t) && g.u.nk(lhs) == ir.E_LOCAL && g.u.nk(n.b) == ir.E_CALL && g.u.nodes[n.b].ty == t {
        // a result in registers stored in the local after the call (whole words: its slot is
        // rounded up to them)
        g.callDest = m
        g.callFresh = false
        g.destUsed = false
        g.gen(n.b)
        if !g.destUsed { g.storeT(t, m) }
        g.a.lea(RAX, m)
        return
    }
    if m.base != -9 {
        g.gen(n.b)
        g.storeFrom(g.u.nodes[n.b].ty, t, m)
        if g.isAggr(t) { g.a.lea(RAX, m) }
        return
    }
    let lk = g.u.nk(lhs)
    if (lk == ir.E_DEREF || lk == ir.E_MEMBER) && g.simple(n.b) && !g.isAggr(t) && !g.isF(t) && !g.is128(t) {
        // through a pointer: the place as an operand (in rax, rcx and registers of locals),
        // then the value
        let pm = g.place(lhs)
        let cv = g.intConst(n.b, t)
        if cv.c == 0 && unused {
            g.a.storeI(g.size(t), pm, cv.v)       // mov byte [p + i], 0
            return
        }
        var r = g.regOf(n.b)
        if r < 0 || g.u.nodes[n.b].ty != t {
            g.genInto(n.b, RDX)
            r = RDX
        }
        g.a.store(g.size(t), pm, r)
        if !unused { g.a.movRR(8, RAX, r) }
        return
    }
    if g.u.nk(lhs) == ir.E_GLOBAL {
        g.gen(n.b)
        g.a.movRSym(R11, g.globalSym[g.u.nodes[lhs].a], 0)
    } else if g.simple(n.b) && !g.isAggr(t) && !g.isF(t) && !g.is128(t) {
        g.genAddr(lhs)
        g.a.movRR(8, R11, RAX)
        g.genInto(n.b, RAX)
    } else {
        // the address waits while the value is evaluated
        g.genAddr(lhs)
        let h = g.hold(n.b, g.quietTree(n.b))
        g.gen(n.b)
        g.unhold(h)
        g.unholdInto(h, R11)
    }
    g.storeT(t, x64.mem(R11, 0))
    if g.isAggr(t) { g.a.movRR(8, RAX, R11) }
}

fn (g: mut &Gen) callRt(name: str) { g.a.callSym(g.symRt(name)) }

// The value of e as stored into an integer place of type t when e is an integer constant (perhaps
// converted between integer types) that a store's 32-bit immediate holds: c 0 and v the value;
// else c 1.
fn (g: &Gen) intConst(e: int, t: int): IntK {
    let k = g.tk(t)
    if k < ir.TY_BOOL || k > ir.TY_U64 { return IntK{v: 0, c: 1} }
    var x = e
    while g.u.nk(x) == ir.E_CAST {
        let ck = g.tk(g.u.nodes[x].ty)
        if ck < ir.TY_BOOL || ck > ir.TY_U64 { return IntK{v: 0, c: 1} }
        x = g.u.nodes[x].a
    }
    if g.u.nk(x) != ir.E_INT { return IntK{v: 0, c: 1} }
    // the conversions in order, innermost first
    var v = g.u.nodes[x].v
    var y = e
    var chain: []int = []
    while g.u.nk(y) == ir.E_CAST {
        append(mut &chain, g.tk(g.u.nodes[y].ty))
        y = g.u.nodes[y].a
    }
    var j = len(chain) - 1
    while j >= 0 {
        v = ir.truncTo(chain[j], v)
        j -= 1
    }
    v = ir.truncTo(k, v)
    if g.size(t) == 8 && !x64.fits32(v) { return IntK{v: 0, c: 1} }
    return IntK{v: v, c: 0}
}

type IntK = value record {
    v: int
    c: int
}

fn (g: mut &Gen) genCast(e: int) {
    let n = g.u.nodes[e]
    let t = n.ty
    let s = g.u.nodes[n.a].ty
    g.gen(n.a)
    let tk = g.tk(t)
    let sk = g.tk(s)
    if tk == ir.TY_VOID || s == t { return }
    if g.isAggr(t) || g.isAggr(s) { g.fail(e, "a cast of an aggregate") }
    if tk == ir.TY_F64 {
        if sk == ir.TY_F64 { return }
        if sk == ir.TY_I128 || sk == ir.TY_U128 {
            g.a.movRR(8, RDI, RAX)
            g.a.movRR(8, RSI, RDX)
            g.callRt(if sk == ir.TY_I128 { "rt_n_i128_to_double" } else { "rt_n_u128_to_double" })
        } else if sk == ir.TY_U64 {
            g.a.movRR(8, RDI, RAX)
            g.callRt("rt_n_u64_to_double")
        } else {
            g.a.cvtsi2sd(0, RAX)
        }
        return
    }
    if sk == ir.TY_F64 {
        if tk == ir.TY_BOOL {
            g.a.sse66(x64.XORPD, 1, 1)
            g.a.sse66(x64.UCOMISD, 0, 1)
            g.a.setcc(x64.CC_NE, RAX)
            g.a.setcc(x64.CC_P, RCX)
            g.a.alu(x64.OR, 1, RAX, RCX)
            g.a.zx(1, RAX, RAX)
        } else if tk == ir.TY_I128 {
            g.callRt("rt_n_double_to_i128")
        } else if tk == ir.TY_U128 {
            g.callRt("rt_n_double_to_u128")
        } else if tk == ir.TY_U64 {
            g.callRt("rt_n_double_to_u64")
        } else {
            g.a.cvttsd2si(RAX, 0)
            g.norm(t)
        }
        return
    }
    let s128 = g.is128(s)
    let t128 = g.is128(t)
    if t128 && !s128 {
        if g.u.isSigned(s) {
            g.a.cqo()
        } else {
            g.a.alu(x64.XOR, 4, RDX, RDX)
        }
    } else if s128 && !t128 {
        if tk == ir.TY_BOOL {
            g.a.alu(x64.OR, 8, RAX, RDX)
            g.a.setcc(x64.CC_NE, RAX)
            g.a.zx(1, RAX, RAX)
        } else {
            g.norm(t)
        }
    } else if !s128 && !t128 {
        if tk == ir.TY_BOOL {
            if sk != ir.TY_BOOL && !g.isBoolVal(n.a) {
                g.a.test(8, RAX, RAX)
                g.a.setcc(x64.CC_NE, RAX)
                g.a.zx(1, RAX, RAX)
            }
        } else if !g.normAs(s, t) {
            g.norm(t)
        }
    }
}

// Whether an integer (or pointer) of type s, normalized, is also normalized as a t: a value of
// 8 bytes needs nothing; a widening keeps the value unless it is from signed to unsigned.
fn (g: &Gen) normAs(s: int, t: int): bool {
    if g.isF(s) || g.isF(t) || g.isAggr(s) || g.isAggr(t) || g.is128(s) || g.is128(t) { return s == t }
    let tk = g.tk(t)
    if tk == ir.TY_BOOL { return g.tk(s) == ir.TY_BOOL }
    if g.size(t) == 8 { return true }
    let ss = g.u.isSigned(s)
    let ts = g.u.isSigned(t)
    if g.size(s) < g.size(t) { return !ss || ts }
    return g.size(s) == g.size(t) && ss == ts
}

fn isCmp(op: int): bool { return op >= ir.OP_EQ }

// Whether e's value is always 0 or 1 (a comparison or a logical operator).
fn (g: &Gen) isBoolVal(e: int): bool {
    let n = g.u.nodes[e]
    return (n.k == ir.E_BIN && isCmp(n.v)) || n.k == ir.E_LNOT || n.k == ir.E_LAND || n.k == ir.E_LOR
}

fn (g: mut &Gen) genBin(e: int) {
    let n = g.u.nodes[e]
    let op = n.v
    if isCmp(op) {
        g.setFromCC(g.genCmp(e))
        return
    }
    let c = n.c
    let ck = g.tk(c)
    if ck == ir.TY_F64 {
        g.pairF(n.a, n.b)
        let ops: []int = [x64.ADDSD, x64.SUBSD, x64.MULSD, x64.DIVSD]
        if op > ir.OP_DIV { g.fail(e, "operator on double") }
        g.a.sse(ops[op], 0, 1)
        return
    }
    if g.is128(c) {
        if op == ir.OP_SHL || op == ir.OP_SHR {
            g.gen(n.a)
            let s = g.temp(16, 16)
            g.a.store(8, rbp(s), RAX)
            g.a.store(8, rbp(s + 8), RDX)
            g.gen(n.b)
            g.a.movRR(8, RCX, RAX)
            g.a.load(8, RAX, rbp(s))
            g.a.load(8, RDX, rbp(s + 8))
            g.shift128(op, ck == ir.TY_I128)
            return
        }
        g.pair128(n.a, n.b)
        if op == ir.OP_ADD {
            g.a.alu(x64.ADD, 8, RAX, R8)
            g.a.alu(x64.ADC, 8, RDX, R9)
        } else if op == ir.OP_SUB {
            g.a.alu(x64.SUB, 8, RAX, R8)
            g.a.alu(x64.SBB, 8, RDX, R9)
        } else if op == ir.OP_AND || op == ir.OP_OR || op == ir.OP_XOR {
            let a = if op == ir.OP_AND { x64.AND } else if op == ir.OP_OR { x64.OR } else { x64.XOR }
            g.a.alu(a, 8, RAX, R8)
            g.a.alu(a, 8, RDX, R9)
        } else if op == ir.OP_MUL {
            g.a.movRR(8, R10, RDX)
            g.a.imul(8, R10, R8)
            g.a.movRR(8, R11, RAX)
            g.a.imul(8, R11, R9)
            g.a.alu(x64.ADD, 8, R10, R11)
            g.a.unary(x64.MUL, 8, R8)
            g.a.alu(x64.ADD, 8, RDX, R10)
        } else {
            g.a.movRR(8, RDI, RAX)
            g.a.movRR(8, RSI, RDX)
            g.a.movRR(8, RDX, R8)
            g.a.movRR(8, RCX, R9)
            let sgn = ck == ir.TY_I128
            if op == ir.OP_DIV {
                g.callRt(if sgn { "rt_n_sdiv128" } else { "rt_n_udiv128" })
            } else {
                g.callRt(if sgn { "rt_n_smod128" } else { "rt_n_umod128" })
            }
        }
        return
    }
    let comm = op == ir.OP_ADD || op == ir.OP_AND || op == ir.OP_OR || op == ir.OP_XOR || op == ir.OP_MUL
    let src = if comm { g.pairSrcC(n.a, n.b) } else { g.pairSrc(n.a, n.b) }
    let sz = if g.size(c) == 8 { 8 } else { 4 }
    let sgn = g.u.isSigned(c)
    if op == ir.OP_ADD {
        g.aluSrc(x64.ADD, sz, RAX, src)
    } else if op == ir.OP_SUB {
        g.aluSrc(x64.SUB, sz, RAX, src)
    } else if op == ir.OP_AND {
        g.aluSrc(x64.AND, sz, RAX, src)
    } else if op == ir.OP_OR {
        g.aluSrc(x64.OR, sz, RAX, src)
    } else if op == ir.OP_XOR {
        g.aluSrc(x64.XOR, sz, RAX, src)
    } else if op == ir.OP_MUL {
        g.imulSrc(sz, RAX, src)
    } else if op == ir.OP_SHL && src.imm {
        g.a.shiftI(x64.SHL, sz, RAX, src.v & (sz * 8 - 1))
    } else if op == ir.OP_SHR && src.imm {
        g.a.shiftI(if sgn { x64.SAR } else { x64.SHR }, sz, RAX, src.v & (sz * 8 - 1))
    } else if op == ir.OP_DIV || op == ir.OP_REM {
        g.srcRCX(src)
        if sgn {
            if sz == 8 { g.a.cqo() } else { g.a.cdq() }
            g.a.unary(x64.IDIV, sz, RCX)
        } else {
            g.a.alu(x64.XOR, 4, RDX, RDX)
            g.a.unary(x64.DIV, sz, RCX)
        }
        if op == ir.OP_REM { g.a.movRR(8, RAX, RDX) }
    } else if op == ir.OP_SHL {
        g.srcRCX(src)
        g.a.shiftCL(x64.SHL, sz, RAX)
    } else if op == ir.OP_SHR {
        g.srcRCX(src)
        g.a.shiftCL(if sgn { x64.SAR } else { x64.SHR }, sz, RAX)
    }
    g.norm(c)
}

// rax:rdx shifted by cl (0 to 127).
fn (g: mut &Gen) shift128(op: int, sgn: bool) {
    let done = g.a.newLabel()
    if op == ir.OP_SHL {
        g.a.shldCL(RDX, RAX)
        g.a.shiftCL(x64.SHL, 8, RAX)
    } else {
        g.a.shrdCL(RAX, RDX)
        g.a.shiftCL(if sgn { x64.SAR } else { x64.SHR }, 8, RDX)
    }
    g.a.movRR(8, R10, RCX)
    g.a.aluI(x64.AND, 4, R10, 64)
    g.a.jcc(x64.CC_E, done)
    if op == ir.OP_SHL {
        g.a.movRR(8, RDX, RAX)
        g.a.alu(x64.XOR, 4, RAX, RAX)
    } else {
        g.a.movRR(8, RAX, RDX)
        if sgn {
            g.a.shiftI(x64.SAR, 8, RDX, 63)
        } else {
            g.a.alu(x64.XOR, 4, RDX, RDX)
        }
    }
    g.a.bind(done)
}

// Evaluates a comparison and sets the flags; the condition code that is true when the
// comparison is (or CC_FEQ, CC_FNE).
fn (g: mut &Gen) genCmp(e: int): int {
    let n = g.u.nodes[e]
    let op = n.v
    let c = n.c
    if g.isF(c) {
        if op == ir.OP_LT || op == ir.OP_LE {
            g.pairF(n.b, n.a)
        } else {
            g.pairF(n.a, n.b)
        }
        g.a.sse66(x64.UCOMISD, 0, 1)
        if op == ir.OP_EQ { return CC_FEQ }
        if op == ir.OP_NE { return CC_FNE }
        if op == ir.OP_GT || op == ir.OP_LT { return x64.CC_A }
        return x64.CC_AE
    }
    let sgn = g.u.isSigned(c)
    if g.is128(c) {
        g.pair128(n.a, n.b)
        if op == ir.OP_EQ || op == ir.OP_NE {
            g.a.alu(x64.XOR, 8, RAX, R8)
            g.a.alu(x64.XOR, 8, RDX, R9)
            g.a.alu(x64.OR, 8, RAX, RDX)
            return if op == ir.OP_EQ { x64.CC_E } else { x64.CC_NE }
        }
        if op == ir.OP_LT || op == ir.OP_GE {
            g.a.alu(x64.CMP, 8, RAX, R8)
            g.a.alu(x64.SBB, 8, RDX, R9)
        } else {
            g.a.alu(x64.CMP, 8, R8, RAX)
            g.a.alu(x64.SBB, 8, R9, RDX)
        }
        let lt = op == ir.OP_LT || op == ir.OP_GT
        if sgn { return if lt { x64.CC_L } else { x64.CC_GE } }
        return if lt { x64.CC_B } else { x64.CC_AE }
    }
    g.cmpPair(n.a, n.b)
    if op == ir.OP_EQ { return x64.CC_E }
    if op == ir.OP_NE { return x64.CC_NE }
    if op == ir.OP_LT { return if sgn { x64.CC_L } else { x64.CC_B } }
    if op == ir.OP_LE { return if sgn { x64.CC_LE } else { x64.CC_BE } }
    if op == ir.OP_GT { return if sgn { x64.CC_G } else { x64.CC_A } }
    return if sgn { x64.CC_GE } else { x64.CC_AE }
}

fn (g: mut &Gen) setFromCC(cc: int) {
    if cc == CC_FEQ {
        g.a.setcc(x64.CC_E, RAX)
        g.a.setcc(x64.CC_NP, RCX)
        g.a.alu(x64.AND, 1, RAX, RCX)
    } else if cc == CC_FNE {
        g.a.setcc(x64.CC_NE, RAX)
        g.a.setcc(x64.CC_P, RCX)
        g.a.alu(x64.OR, 1, RAX, RCX)
    } else {
        g.a.setcc(cc, RAX)
    }
    g.a.zx(1, RAX, RAX)
}

fn (g: mut &Gen) jumpCC(cc: int, l: int, when: bool) {
    if cc >= 0 {
        g.a.jcc(if when { cc } else { cc ^ 1 }, l)
        return
    }
    // equal: ZF and not PF
    let eq = cc == CC_FEQ
    if eq == when {
        let skip = g.a.newLabel()
        g.a.jcc(x64.CC_P, skip)
        g.a.jcc(x64.CC_E, l)
        g.a.bind(skip)
    } else {
        g.a.jcc(x64.CC_P, l)
        g.a.jcc(x64.CC_NE, l)
    }
}

// Evaluates a scalar and sets ZF when it is zero (false).
fn (g: mut &Gen) genTest(e: int) {
    let t = g.u.nodes[e].ty
    let k = g.tk(t)
    if g.u.nk(e) == ir.E_DEREF && (k == ir.TY_PTR || k >= ir.TY_BOOL && k <= ir.TY_U64) {
        g.a.aluMI(x64.CMP, g.size(t), g.place(e), 0)     // cmp byte [p + i], 0
        return
    }
    g.gen(e)
    if g.isF(t) {
        g.a.sse66(x64.XORPD, 1, 1)
        g.a.sse66(x64.UCOMISD, 0, 1)
        g.a.setcc(x64.CC_NE, RAX)
        g.a.setcc(x64.CC_P, RCX)
        g.a.alu(x64.OR, 1, RAX, RCX)
    } else if g.is128(t) {
        g.a.movRR(8, RCX, RAX)
        g.a.alu(x64.OR, 8, RCX, RDX)
    } else {
        g.a.test(8, RAX, RAX)
    }
}

// Jumps to l when the truth of e is when.
fn (g: mut &Gen) branch(e: int, l: int, when: bool) {
    let n = g.u.nodes[e]
    let k = n.k
    if k == ir.E_INT {
        if (n.v != 0) == when { g.a.jmp(l) }
    } else if k == ir.E_LNOT {
        g.branch(n.a, l, !when)
    } else if k == ir.E_LAND || k == ir.E_LOR {
        // a && b jumps when false if either is false; when true only if both are
        let isAnd = k == ir.E_LAND
        if isAnd != when {
            g.branch(n.a, l, when)
            g.branch(n.b, l, when)
        } else {
            let skip = g.a.newLabel()
            g.branch(n.a, skip, !when)
            g.branch(n.b, l, when)
            g.a.bind(skip)
        }
    } else if k == ir.E_CALL && g.branchInline(e, l, when) {
        // done
    } else if k == ir.E_BIN && isCmp(n.v) {
        g.jumpCC(g.genCmp(e), l, when)
    } else if k == ir.E_CAST && g.tk(n.ty) == ir.TY_BOOL && !g.is128(g.u.nodes[n.a].ty) {
        g.branch(n.a, l, when)              // the truth of a value is that of its conversion to bool
    } else {
        g.genTest(e)
        g.a.jcc(if when { x64.CC_NE } else { x64.CC_E }, l)
    }
}

// ---------------------------------------------------------------- calls

fn (g: mut &Gen) genCall(e: int) {
    // where the aggregate result goes, if the caller said (callDest), and whether it may be
    // the hidden result pointer (the place is new: nothing reads it during the call)
    let dest = g.callDest
    let fresh = g.callFresh
    g.callDest = NO_MEM
    g.callFresh = false
    let n = g.u.nodes[e]
    let ft = n.c
    let rt = g.u.tys[ft].base
    let pts = g.u.fnParams(ft)
    let callee = n.a
    var direct = -1
    if g.u.nk(callee) == ir.E_DECAY && g.u.nk(g.u.nodes[callee].a) == ir.E_FUNC {
        direct = g.u.nodes[g.u.nodes[callee].a].a
    }
    if direct >= 0 && g.u.funcs[direct].body < 0 && !g.u.funcs[direct].isExtern &&
        g.inlineRt(e, g.u.funcs[direct].name) {
        g.destUsed = false
        return
    }
    let inl = g.inlineTarget(e, false, g.loops)
    if inl >= 0 {
        g.genInline(inl, e)
        g.destUsed = false
        return
    }
    var calleeSlot = 0
    var calleeReg = -1
    let nargs = g.u.listLen(n.b)
    if direct < 0 {
        // the function pointer waits while the arguments are evaluated
        g.gen(callee)
        calleeReg = g.calleeTemp(e, !g.quietList(n.b))
        if calleeReg >= 0 {
            g.a.movRR(8, calleeReg, RAX)
        } else {
            calleeSlot = g.temp(8, 8)
            g.a.store(8, rbp(calleeSlot), RAX)
        }
    }
    var ni = 0
    var nx = 0
    var retSlot = 0
    let aggrRet = g.isAggr(rt)
    var rcls: []int = []
    if aggrRet {
        rcls = g.classify(rt)
        if rcls[0] == CL_MEM { ni = 1 }
    }
    // where each argument goes: -1 registers, else its offset in the outgoing area
    var place: []int = []
    var argReg: []int = []          // the first integer register of an argument in registers
    var stackOff = 0
    var ti = ni
    var tx = 0
    for j in 0..nargs {
        let t = pts[j]
        let cls = g.classify(t)
        let nInt = countCl(&cls, CL_INT)
        let nSse = countCl(&cls, CL_SSE)
        if cls[0] == CL_MEM || ti + nInt > 6 || tx + nSse > 8 {
            stackOff = ir.alignUp(stackOff, if g.u.alignOf(t) > 8 { g.u.alignOf(t) } else { 8 })
            append(mut &place, stackOff)
            stackOff += ir.alignUp(g.size(t), 8)
        } else {
            append(mut &place, -1)
            ti += nInt
            tx += nSse
        }
        append(mut &argReg, if ti - nInt < 6 { INT_REGS[ti - nInt] } else { -1 })
    }
    // the arguments into temporaries, except those loaded straight into their registers
    // below (slot 0: constants, locals, members of locals; slot 1: in rax)
    // the last of the others stays in rax if it is an integer and no argument is on the stack
    var inRax = -1
    for j in 0..nargs {
        let x = g.u.listAt(n.b, j)
        if !(place[j] < 0 && g.argDirect(x, pts[j])) { inRax = j }
    }
    if inRax >= 0 && (stackOff > 0 || g.isAggr(pts[inRax]) || g.isF(pts[inRax]) || g.is128(pts[inRax])) {
        inRax = -1
    }
    var slots: []int = []
    var dups: []int = []
    var hregs: []int = []           // an integer argument held in a callee-saved register, or -1
    for j in 0..nargs {
        let x = g.u.listAt(n.b, j)
        let t = pts[j]
        append(mut &dups, -1)
        append(mut &hregs, -1)
        if place[j] < 0 && g.argDirect(x, t) {
            append(mut &slots, 0)
            continue
        }
        if g.isAggr(t) && g.u.nk(x) == ir.E_CALL && g.u.nodes[x].ty == t && !(place[j] < 0 && g.dupArg(e, j)) {
            // the result straight into the argument's temporary (new: nothing reads it)
            let s = g.tempFor(t)
            g.callDest = rbp(s)
            g.callFresh = true
            g.destUsed = false
            g.gen(x)
            if !g.destUsed { g.copyMem(rbp(s), x64.mem(RAX, 0), g.size(t)) }
            append(mut &slots, s)
            continue
        }
        if j == inRax && g.arithInto(x, argReg[j], false) {
            // computed straight into its register below (only direct arguments come after it)
            append(mut &slots, 3)
            continue
        }
        g.gen(x)
        if j == inRax {
            append(mut &slots, 1)
            continue
        }
        if place[j] < 0 && g.dupArg(e, j) {
            // its count incremented here, its bytes loaded from the str below (slot -1)
            dups[j] = g.u.listAt(g.u.nodes[x].b, 0)
            append(mut &slots, -1)
            continue
        }
        if place[j] < 0 && !g.isAggr(t) && !g.isF(t) && !g.is128(t) {
            // while the later arguments are evaluated: across their calls, a new register if
            // need be
            var quiet = true
            for k in j + 1..nargs {
                if !g.quietTree(g.u.listAt(n.b, k)) { quiet = false }
            }
            hregs[j] = g.calleeTemp(x, !quiet)
            if hregs[j] >= 0 {
                g.a.movRR(8, hregs[j], RAX)
                append(mut &slots, 2)
                continue
            }
        }
        let s = g.tempFor(t)
        if g.isAggr(t) {
            g.copyMem(rbp(s), x64.mem(RAX, 0), g.size(t))
        } else if g.isF(t) {
            g.a.movsdStore(rbp(s), 0)
        } else if g.is128(t) {
            g.a.store(8, rbp(s), RAX)
            g.a.store(8, rbp(s + 8), RDX)
        } else {
            g.a.store(8, rbp(s), RAX)
        }
        append(mut &slots, s)
    }
    // (set after the arguments, whose calls set it too)
    g.destUsed = false
    var rm = NO_MEM
    if aggrRet {
        if dest.base != -9 && (fresh || rcls[0] != CL_MEM) {
            rm = dest
            g.destUsed = true
        } else {
            retSlot = g.tempFor(rt)
            rm = rbp(retSlot)
        }
    }
    for j in 0..nargs {
        if place[j] >= 0 {
            let t = pts[j]
            g.copyMem(x64.mem(RSP, place[j]), rbp(slots[j]), ir.alignUp(g.size(t), 8))
        }
    }
    if stackOff > g.outArgs { g.outArgs = stackOff }
    for j in 0..nargs {
        if place[j] < 0 {
            let x = g.u.listAt(n.b, j)
            let cls = g.classify(pts[j])
            if slots[j] == 0 && !g.isAggr(pts[j]) && !g.isF(pts[j]) {
                g.genInto(x, INT_REGS[ni])
                ni += 1
                continue
            }
            if slots[j] == 1 {
                g.a.movRR(8, INT_REGS[ni], RAX)
                ni += 1
                continue
            }
            if slots[j] == 2 {
                g.a.movRR(8, INT_REGS[ni], hregs[j])
                ni += 1
                continue
            }
            if slots[j] == 3 {
                g.arithInto(x, INT_REGS[ni], true)
                ni += 1
                continue
            }
            let m = if slots[j] == 0 { g.staticMem(x) } else if slots[j] == -1 { g.staticMem(dups[j]) } else {
                rbp(slots[j])
            }
            for i in 0..len(cls) {
                if cls[i] == CL_SSE {
                    g.a.movsdLoad(nx, at(m, 8 * i))
                    nx += 1
                } else if cls[i] == CL_INT {
                    g.a.load(8, INT_REGS[ni], at(m, 8 * i))
                    ni += 1
                }
            }
        }
    }
    if aggrRet && rcls[0] == CL_MEM { g.a.lea(RDI, rm) }
    // the held registers are free again (the callee preserves them; the call reads the callee's)
    var k = nargs - 1
    while k >= 0 {
        if hregs[k] >= 0 { pop(mut &g.held) }
        k -= 1
    }
    if calleeReg >= 0 { pop(mut &g.held) }
    if direct >= 0 {
        let s = g.symFunc(direct, e)
        if g.syms[s].kind == SK_DYN {
            g.a.movRI(RAX, nx)          // for a variadic C function: the vector registers used
            g.a.callAt(s)
        } else {
            g.a.callSym(s)
        }
    } else if calleeReg >= 0 {
        g.a.callR(calleeReg)
    } else {
        g.a.load(8, R11, rbp(calleeSlot))
        g.a.callR(R11)
    }
    if aggrRet {
        if rcls[0] != CL_MEM {
            var ri = 0
            var rx = 0
            for i in 0..len(rcls) {
                if rcls[i] == CL_SSE {
                    g.a.movsdStore(at(rm, 8 * i), rx)
                    rx += 1
                } else if rcls[i] == CL_INT {
                    g.a.store(8, at(rm, 8 * i), if ri == 0 { RAX } else { RDX })
                    ri += 1
                }
            }
        }
        g.a.lea(RAX, rm)
    } else if g.u.isInt(rt) && g.size(rt) < 8 {
        g.norm(rt)
    }
}

// The name of the runtime function call e calls directly, or "".
fn (g: &Gen) rtName(e: int): str {
    let c = g.u.nodes[e].a
    if g.u.nk(c) != ir.E_DECAY || g.u.nk(g.u.nodes[c].a) != ir.E_FUNC { return "" }
    let f = g.u.nodes[g.u.nodes[c].a].a
    if g.u.funcs[f].body >= 0 || g.u.funcs[f].isExtern { return "" }
    return g.u.funcs[f].name
}

// Whether argument j of call e is rt_str_dup(s) of a str s in memory that needs no code (a
// local or a member of one) whose bytes stay as they are until the call: the local's address is
// never taken and the arguments after j assign nothing of it. Then s's bytes are the argument
// (the count is incremented when the argument is evaluated, in order).
fn (g: mut &Gen) dupArg(e: int, j: int): bool {
    let l = g.u.nodes[e].b
    let x = g.u.listAt(l, j)
    if g.u.nk(x) != ir.E_CALL || g.rtName(x) != "rt_str_dup" || g.u.listLen(g.u.nodes[x].b) != 1 { return false }
    let s = g.u.listAt(g.u.nodes[x].b, 0)
    if g.staticMem(s).base == -9 { return false }
    var r = s
    while g.u.nk(r) == ir.E_MEMBER { r = g.u.nodes[r].a }
    if g.u.nk(r) != ir.E_LOCAL || g.aTaken[g.u.nodes[r].a] { return false }
    for k in j + 1..g.u.listLen(l) {
        if g.walk(g.u.listAt(l, k), 1, g.u.nodes[r].a, -1) > 0 { return false }
    }
    return true
}

// Whether argument x (of type t, passed in registers) can be loaded into its registers at the
// call with no other register used: a simple integer, or a double or aggregate in memory that
// needs no code.
fn (g: &Gen) argDirect(x: int, t: int): bool {
    if g.is128(t) { return false }
    if g.isAggr(t) || g.isF(t) { return g.staticMem(x).base != -9 }
    return g.simple(x)
}

// ---------------------------------------------------------------- functions generated in place

// The size limits of a function generated in place of its calls (nodes of its body): anywhere,
// and in loops; and the depth of such calls within each other.
const INLINE_SMALL = 16
const INLINE_NODES = 40
const INLINE_DEPTH = 3

// The function call e (in loops loops deep) calls, if it is generated in place: a small function
// of the program (inlinable; within INLINE_SMALL nodes, or INLINE_NODES in a loop) that is not
// the function being generated nor one being generated in place (the scan's stack of them when
// inScan, else the code generator's). Else -1. The scan and the code generator ask the same.
fn (g: mut &Gen) inlineTarget(e: int, inScan: bool, loops: int): int {
    let c = g.u.nodes[e].a
    if g.u.nk(c) != ir.E_DECAY || g.u.nk(g.u.nodes[c].a) != ir.E_FUNC { return -1 }
    let f = g.u.nodes[g.u.nodes[c].a].a
    if f == g.curFunc || !g.inlinable(f) { return -1 }
    if loops == 0 && g.inl[f] > INLINE_SMALL { return -1 }
    let depth = if inScan { len(g.scanStack) } else { len(g.inlStack) }
    if depth >= INLINE_DEPTH { return -1 }
    for i in 0..depth {
        if (if inScan { g.scanStack[i] } else { g.inlStack[i] }) == f { return -1 }
    }
    return f
}

// Whether f can be generated in place of its calls: a function of the program with integer,
// pointer or double parameters and result (or none), and a body of INLINE_NODES nodes or less.
fn (g: mut &Gen) inlinable(f: int): bool {
    if g.inl[f] >= 0 { return g.inl[f] <= INLINE_NODES }
    g.inl[f] = INLINE_NODES + 1
    if g.u.funcs[f].body < 0 || g.u.funcs[f].isExtern || g.u.funcs[f].name == "main" { return false }
    let rt = g.u.tys[g.u.funcs[f].ty].base
    if g.tk(rt) != ir.TY_VOID && (!g.u.isScalar(rt) || g.is128(rt)) { return false }
    for p in g.u.funcs[f].params {
        let t = g.u.locals[p].ty
        if !g.u.isScalar(t) || g.is128(t) { return false }
    }
    var budget = INLINE_NODES
    if !g.small(g.u.funcs[f].body, mut &budget) { return false }
    g.inl[f] = INLINE_NODES - budget
    return true
}

// Whether the tree x has no more nodes than budget (which it uses up).
fn (g: &Gen) small(x: int, budget: mut &int): bool {
    if x < 0 { return true }
    budget -= 1
    if budget < 0 { return false }
    let n = g.u.nodes[x]
    let k = n.k
    if k == ir.E_INT || k == ir.E_FLT || k == ir.E_STR || k == ir.E_LOCAL || k == ir.E_GLOBAL || k == ir.E_FUNC ||
        k == ir.S_BREAK || k == ir.S_CONTINUE || k == ir.S_CASE || k == ir.S_DEFAULT || k == ir.S_EMPTY {
        return true
    }
    if k == ir.E_CALL { return g.small(n.a, budget) && g.smallList(n.b, budget) }
    if k == ir.E_CLIT { return g.smallList(n.b, budget) }
    if k == ir.S_BLOCK { return g.smallList(n.a, budget) }
    if k == ir.S_DECL { return g.small(n.b, budget) && g.smallList(n.c, budget) }
    if k == ir.S_FOR {
        return g.small(n.a, budget) && g.small(n.b, budget) && g.small(n.c, budget) && g.small(n.d, budget)
    }
    if k == ir.E_MEMBER || k == ir.E_DEREF || k == ir.E_CAST || k == ir.E_NEG || k == ir.E_BNOT || k == ir.E_LNOT ||
        k == ir.E_POSTINC || k == ir.E_IENT || k == ir.S_EXPR || k == ir.S_RETURN || k == ir.E_ADDR || k == ir.E_DECAY {
        return g.small(n.a, budget)
    }
    if k == ir.E_BIN || k == ir.E_LAND || k == ir.E_LOR || k == ir.E_ASSIGN || k == ir.E_PADD || k == ir.S_SWITCH ||
        k == ir.S_WHILE {
        return g.small(n.a, budget) && g.small(n.b, budget)
    }
    if k == ir.E_COND || k == ir.S_IF { return g.small(n.a, budget) && g.small(n.b, budget) && g.small(n.c, budget) }
    return false
}

fn (g: &Gen) smallList(l: int, budget: mut &int): bool {
    if l < 0 { return true }
    for j in 0..g.u.listLen(l) {
        if !g.small(g.u.listAt(l, j), budget) { return false }
    }
    return true
}

// The arguments of the call e of f generated in place, evaluated as for a call (left to right;
// the simple ones last) and assigned to f's parameters. f's locals live in this frame (slots,
// or the registers the scan of the function gave them).
fn (g: mut &Gen) inlineArgs(f: int, e: int, al: &[]int) {
    let n = g.u.nodes[e]
    var ps: []int = []
    for p in g.u.funcs[f].params { append(mut &ps, p) }
    let nargs = g.u.listLen(n.b)
    var lastNon = -1
    for j in 0..nargs {
        if al[j] < 0 && !g.inlineDirect(g.u.listAt(n.b, j), ps[j]) { lastNon = j }
    }
    // the others into temporaries (tmp: a frame slot, below 0, or a callee-saved register, 3), the
    // last integer one in rax (1); an aliased parameter (2) is not assigned: the body names its local
    var tmp: []int = []
    var hregs: []int = []
    for j in 0..nargs {
        append(mut &hregs, -1)
    }
    for j in 0..nargs {
        let x = g.u.listAt(n.b, j)
        let t = g.u.locals[ps[j]].ty
        if al[j] >= 0 {
            append(mut &tmp, 2)
            continue
        }
        if g.inlineDirect(x, ps[j]) {
            append(mut &tmp, 0)
            continue
        }
        g.gen(x)
        if !g.isF(t) && !g.normAs(g.u.nodes[x].ty, t) { g.normR(g.tk(t), RAX) }
        if j == lastNon && !g.isF(t) {
            append(mut &tmp, 1)
            continue
        }
        if !g.isF(t) {
            // while the later arguments are evaluated (across their calls, a new register if
            // need be); not a register of the parameters, which are live at the call
            var quiet = true
            for k in j + 1..nargs {
                if !g.quietTree(g.u.listAt(n.b, k)) { quiet = false }
            }
            hregs[j] = g.calleeTemp(x, !quiet)
            if hregs[j] >= 0 {
                g.a.movRR(8, hregs[j], RAX)
                append(mut &tmp, 3)
                continue
            }
        }
        let s = g.tempFor(t)
        g.storeT(t, rbp(s))
        append(mut &tmp, s)
    }
    var k = nargs - 1
    while k >= 0 {
        if hregs[k] >= 0 { pop(mut &g.held) }
        k -= 1
    }
    for j in 0..nargs {
        let p = ps[j]
        let t = g.u.locals[p].ty
        if tmp[j] == 1 {
            if g.reg[p] >= 0 {
                g.a.movRR(8, g.reg[p], RAX)
            } else {
                g.slots[p] = g.tempFor(t)
                g.storeT(t, rbp(g.slots[p]))
            }
        }
    }
    for j in 0..nargs {
        let p = ps[j]
        let t = g.u.locals[p].ty
        if tmp[j] < 0 {
            if g.reg[p] >= 0 {
                g.loadInt(t, g.reg[p], rbp(tmp[j]))
            } else {
                g.slots[p] = tmp[j]
            }
        } else if tmp[j] == 3 {
            if g.reg[p] >= 0 {
                g.a.movRR(8, g.reg[p], hregs[j])
            } else {
                g.slots[p] = g.tempFor(t)
                g.a.movRR(8, RAX, hregs[j])
                g.storeT(t, rbp(g.slots[p]))
            }
        }
    }
    for j in 0..nargs {
        let p = ps[j]
        let t = g.u.locals[p].ty
        if tmp[j] == 0 {
            let x = g.u.listAt(n.b, j)
            if g.reg[p] >= 0 {
                g.genInto(x, g.reg[p])
            } else {
                g.slots[p] = g.tempFor(t)
                g.genInto(x, RAX)
                g.a.store(g.size(t), rbp(g.slots[p]), RAX)
            }
        }
    }
}

// The call e of f generated in place: the arguments into the parameters, then f's body, whose
// returns jump to the end with the result in the value registers.
fn (g: mut &Gen) genInline(f: int, e: int) {
    let al = g.aliases(f, e)
    g.inlineArgs(f, e, &al)
    let ch = g.applyAlias(f, &al)
    let saveRet = g.retTy
    let saveDecl = g.declMark
    g.retTy = g.u.tys[g.u.funcs[f].ty].base
    let end = g.a.newLabel()
    if len(g.inlStack) == 0 { g.inlPos = g.posAt(e) }
    append(mut &g.inlStack, f)
    append(mut &g.inlEnd, end)
    g.stmt(g.u.funcs[f].body)
    pop(mut &g.inlStack)
    pop(mut &g.inlEnd)
    g.unalias(&ch)
    g.a.bind(end)
    g.retTy = saveRet
    g.declMark = saveDecl
}

// A call e of a function generated in place whose body is `return x;`, as a condition: the
// arguments into the parameters, then a jump to l on x (when). Else false, nothing generated.
fn (g: mut &Gen) branchInline(e: int, l: int, when: bool): bool {
    let f = g.inlineTarget(e, false, g.loops)
    if f < 0 { return false }
    let x = g.onlyReturn(f)
    if x < 0 || g.u.nodes[x].ty != g.u.tys[g.u.funcs[f].ty].base { return false }
    let al = g.aliases(f, e)
    g.inlineArgs(f, e, &al)
    let ch = g.applyAlias(f, &al)
    if len(g.inlStack) == 0 { g.inlPos = g.posAt(e) }
    append(mut &g.inlStack, f)
    g.branch(x, l, when)
    pop(mut &g.inlStack)
    g.unalias(&ch)
    return true
}

// For each parameter of f at the call e generated in place: the local l when the argument is
// &l and the body only dereferences the parameter (never assigns it nor names it otherwise),
// with l of the pointee type; else -1. Then the body's *p is l itself (applyAlias): the same
// object, read and written where the body reads and writes it, and l needs no address.
fn (g: mut &Gen) aliases(f: int, e: int): []int {
    var out: []int = []
    let args = g.u.nodes[e].b
    let body = g.u.funcs[f].body
    for j in 0..len(g.u.funcs[f].params) {
        let p = g.u.funcs[f].params[j]
        let pt = g.u.locals[p].ty
        let x = g.u.listAt(args, j)
        var l = -1
        if g.tk(pt) == ir.TY_PTR && g.u.nk(x) == ir.E_ADDR && g.u.nk(g.u.nodes[x].a) == ir.E_LOCAL {
            l = g.u.nodes[g.u.nodes[x].a].a
            if g.u.locals[l].ty != g.u.tys[pt].base || g.walk(body, 1, p, -1) > 0 { l = -1 }
        }
        if l >= 0 {
            var ds: []int = []
            g.derefsOf(body, p, mut &ds)
            if len(ds) != g.walk(body, 0, p, -1) { l = -1 }
        }
        append(mut &out, l)
    }
    return out
}

// The nodes *p (E_DEREF of local p) in the tree x.
fn (g: &Gen) derefsOf(x: int, p: int, out: mut &[]int) {
    if x < 0 { return }
    let n = g.u.nodes[x]
    if n.k == ir.E_DEREF && g.u.nk(n.a) == ir.E_LOCAL && g.u.nodes[n.a].a == p {
        append(out, x)
        return
    }
    let k = n.k
    if k == ir.E_CALL || k == ir.E_CLIT || k == ir.S_BLOCK || k == ir.S_DECL {
        if k == ir.E_CALL { g.derefsOf(n.a, p, out) }
        if k == ir.S_DECL { g.derefsOf(n.b, p, out) }
        let l = if k == ir.S_BLOCK { n.a } else if k == ir.S_DECL { n.c } else { n.b }
        if l >= 0 {
            for j in 0..g.u.listLen(l) { g.derefsOf(g.u.listAt(l, j), p, out) }
        }
        return
    }
    if k == ir.E_INT || k == ir.E_FLT || k == ir.E_STR || k == ir.E_LOCAL || k == ir.E_GLOBAL || k == ir.E_FUNC ||
        k == ir.S_BREAK || k == ir.S_CONTINUE || k == ir.S_CASE || k == ir.S_DEFAULT || k == ir.S_EMPTY {
        return
    }
    g.derefsOf(n.a, p, out)
    if k == ir.E_BIN || k == ir.E_LAND || k == ir.E_LOR || k == ir.E_ASSIGN || k == ir.E_PADD || k == ir.S_SWITCH ||
        k == ir.S_WHILE || k == ir.E_COND || k == ir.S_IF || k == ir.S_FOR {
        g.derefsOf(n.b, p, out)
    }
    if k == ir.E_COND || k == ir.S_IF || k == ir.S_FOR { g.derefsOf(n.c, p, out) }
    if k == ir.S_FOR { g.derefsOf(n.d, p, out) }
}

// The body of f with each *p of an aliased parameter p (al) made its local, in place: the
// nodes changed and what they were, for unalias, which puts them back (the body is generated,
// or scanned, in between; f is never generated in place within itself).
fn (g: mut &Gen) applyAlias(f: int, al: &[]int): []int {
    var ch: []int = []
    for j in 0..len(al) {
        if al[j] < 0 { continue }
        var ds: []int = []
        g.derefsOf(g.u.funcs[f].body, g.u.funcs[f].params[j], mut &ds)
        for x in ds {
            append(mut &ch, x)
            append(mut &ch, g.u.nodes[x].a)
            g.u.nodes[x].k = ir.E_LOCAL
            g.u.nodes[x].a = al[j]
        }
    }
    return ch
}

fn (g: mut &Gen) unalias(ch: &[]int) {
    for i in 0..len(ch) / 2 {
        g.u.nodes[ch[2 * i]].k = ir.E_DEREF
        g.u.nodes[ch[2 * i]].a = ch[2 * i + 1]
    }
}

// The value a function generated in place is only a return of (its body is `return x;`), or -1.
fn (g: &Gen) onlyReturn(f: int): int {
    let body = g.u.funcs[f].body
    if g.u.nk(body) != ir.S_BLOCK || g.u.listLen(g.u.nodes[body].a) != 1 { return -1 }
    let s = g.u.listAt(g.u.nodes[body].a, 0)
    if g.u.nk(s) != ir.S_RETURN { return -1 }
    return g.u.nodes[s].a
}

// Whether argument x for parameter p of a function generated in place is loaded straight into
// it: a simple integer or pointer of p's type.
fn (g: &Gen) inlineDirect(x: int, p: int): bool {
    let t = g.u.locals[p].ty
    return g.simple(x) && !g.isF(t) && g.normAs(g.u.nodes[x].ty, t)
}

// ---------------------------------------------------------------- inlined runtime functions

// The label of a jump to rt_trap(code, msg, where) for the location string w (a node).
fn (g: mut &Gen) stub(code: int, msg: str, w: int): int {
    let key = intToStr(code) + " " + msg + "\n" + g.u.nodes[g.u.nodes[w].a].s
    let have = g.stubOf.getOr(&key, -1)
    if have >= 0 { return have }
    let l = g.a.newLabel()
    append(mut &g.stubs, Stub{label: l, code: code, msg: msg, where: w})
    g.stubOf.put(key, l)
    return l
}

fn (g: mut &Gen) genStubs() {
    let sts = replace(mut &g.stubs, [])
    for st in sts {
        g.a.bind(st.label)
        g.a.movRI(RDI, st.code)
        g.a.movRSym(RSI, g.symStr(st.msg), 0)
        g.a.movRSym(RDX, g.symStr(g.u.nodes[g.u.nodes[st.where].a].s), 0)
        g.callRt("rt_trap")
    }
    g.stubOf.clear()
}

// The integer kind and operation of a checked or wrapping runtime arithmetic function
// (rt_add_int, rt_wmul_u32, ...): kind -1 when name is not one.
type ArOp = value record {
    k: int
    op: int
    wrap: bool
}

fn arOp(name: str): ArOp {
    let none = ArOp{k: -1, op: 0, wrap: false}
    if !startsWith(name, "rt_") { return none }
    var rest = name[3..len(name)]
    var wrap = false
    if startsWith(rest, "w") {
        wrap = true
        rest = rest[1..len(rest)]
    }
    let op = if startsWith(rest, "add_") { ir.OP_ADD } else if startsWith(rest, "sub_") { ir.OP_SUB } else if
        startsWith(rest, "mul_") { ir.OP_MUL } else { -1 }
    if op < 0 { return none }
    return ArOp{k: suffixKind(rest[4..len(rest)]), op: op, wrap: wrap}
}

// The integer kind of a runtime function's type suffix (int, i32, u32, u64, byte), or -1.
fn suffixKind(ty: str): int {
    return if ty == "int" { ir.TY_I64 } else if ty == "i32" { ir.TY_I32 } else if ty == "u32" { ir.TY_U32 } else if
        ty == "u64" { ir.TY_U64 } else if ty == "byte" { ir.TY_U8 } else { -1 }
}

// The kind and operation of a checked division, remainder, negation or shift of the runtime
// (rt_div_int, rt_shl_u32, ...): kind -1 when name is not one.
fn divOp(name: str): ArOp {
    let none = ArOp{k: -1, op: 0, wrap: false}
    if !startsWith(name, "rt_") || len(name) < 8 || strByte(name, 6) != '_' { return none }
    let o = name[3..6]
    let op = if o == "div" { ir.OP_DIV } else if o == "rem" { ir.OP_REM } else if o == "shl" { ir.OP_SHL } else if
        o == "shr" { ir.OP_SHR } else if o == "neg" { ir.OP_SUB } else { -1 }
    if op < 0 { return none }
    let k = suffixKind(name[7..len(name)])
    if op == ir.OP_SUB && k != ir.TY_I64 && k != ir.TY_I32 { return none }
    return ArOp{k: k, op: op, wrap: false}
}

// The range of the integer kind k (64 bits at most; u64's top is -1, read unsigned).
fn kindMin(k: int): int {
    if k == ir.TY_I8 { return -128 }
    if k == ir.TY_I16 { return -32768 }
    if k == ir.TY_I32 { return -2147483648 }
    if k == ir.TY_I64 { return -9223372036854775807 - 1 }
    return 0
}

fn kindMax(k: int): int {
    if k == ir.TY_BOOL { return 1 }
    if k == ir.TY_I8 { return 127 }
    if k == ir.TY_U8 { return 255 }
    if k == ir.TY_I16 { return 32767 }
    if k == ir.TY_U16 { return 65535 }
    if k == ir.TY_I32 { return 2147483647 }
    if k == ir.TY_U32 { return 4294967295 }
    if k == ir.TY_I64 { return 9223372036854775807 }
    return -1
}

// Whether the location argument w is a string literal (the runtime functions' last argument).
fn (g: &Gen) isWhere(w: int): bool {
    return g.u.nk(w) == ir.E_DECAY && g.u.nk(g.u.nodes[w].a) == ir.E_STR
}

// The overflow test of a checked operation ar (rt_add_int, ...) whose result is in register r:
// a jump to the trap stub for the location string w. Only a u32 multiply uses another register
// (rcx).
fn (g: mut &Gen) ovfCheck(ar: ArOp, r: int, w: int) {
    let k = ar.k
    let l = g.stub(10, "integer overflow", w)
    if k == ir.TY_I64 || k == ir.TY_I32 {
        g.a.jcc(x64.CC_O, l)
    } else if k == ir.TY_U8 {
        // operands are 0..255: the 32-bit result is out of range when above 255
        g.a.aluI(x64.CMP, 4, r, 255)
        g.a.jcc(x64.CC_A, l)
    } else if ar.op == ir.OP_MUL && k == ir.TY_U32 {
        g.a.movRR(8, RCX, r)                        // the 64-bit product of two u32s
        g.a.shiftI(x64.SHR, 8, RCX, 32)
        g.a.jcc(x64.CC_NE, l)
    } else {
        g.a.jcc(x64.CC_B, l)                        // the carry: unsigned overflow
    }
}

// Generates e into register r with no other register changed, when e is an add or subtract of
// integers (the runtime's checked or wrapping rt_add_*, rt_sub_*, or +, -, &, |, ^ of 8 bytes
// or less) with one operand simple and the other an operand that needs no code (srcOnly) and
// is not r: the simple one into r (the left one; for a commutative operation either), the
// operation on r, the overflow test, the normalization, as gen does in rax. With gen false,
// only whether it would. False: not such an e, nothing generated.
fn (g: mut &Gen) arithInto(e: int, r: int, gen: bool): bool {
    let n = g.u.nodes[e]
    var a = -1
    var b = -1
    var op = 0
    var k = 0
    var sz = 8
    var ar = ArOp{k: -1, op: 0, wrap: true}
    var w = -1
    if n.k == ir.E_CALL {
        ar = arOp(g.rtName(e))
        let nargs = g.u.listLen(n.b)
        if ar.k < 0 || ar.op == ir.OP_MUL || nargs < 2 { return false }
        if !ar.wrap && (nargs != 3 || !g.isWhere(g.u.listAt(n.b, 2))) { return false }
        if !ar.wrap { w = g.u.listAt(n.b, 2) }
        a = g.u.listAt(n.b, 0)
        b = g.u.listAt(n.b, 1)
        op = ar.op
        k = ar.k
        sz = if k == ir.TY_I64 || k == ir.TY_U64 { 8 } else { 4 }
    } else if n.k == ir.E_BIN {
        op = n.v
        if op != ir.OP_ADD && op != ir.OP_SUB && op != ir.OP_AND && op != ir.OP_OR && op != ir.OP_XOR { return false }
        if g.isF(n.c) || g.is128(n.c) { return false }
        a = n.a
        b = n.b
        k = g.tk(n.c)
        sz = if g.size(n.c) == 8 { 8 } else { 4 }
    } else {
        return false
    }
    if !(g.simple(a) && g.srcOnly(b) && g.regOf(b) != r) {
        // commutative: the other way round
        if op == ir.OP_SUB || !(g.simple(b) && g.srcOnly(a) && g.regOf(a) != r) { return false }
        let x = a
        a = b
        b = x
    }
    if !gen { return true }
    g.genInto(a, r)
    let alu = if op == ir.OP_ADD { x64.ADD } else if op == ir.OP_SUB { x64.SUB } else if op == ir.OP_AND { x64.AND }
        else if op == ir.OP_OR { x64.OR } else { x64.XOR }
    g.aluSrc(alu, sz, r, g.pairSrc(-1, b))
    if w >= 0 { g.ovfCheck(ar, r, w) }
    g.normR(k, r)
    return true
}

// Generates the call e of the runtime function name inline, if it is one of those the code
// generator knows (checked arithmetic, index checks, str reference counts): the same
// results, traps and messages as the runtime's code. False: not inlined, nothing emitted.
fn (g: mut &Gen) inlineRt(e: int, name: str): bool {
    let n = g.u.nodes[e]
    let nargs = g.u.listLen(n.b)
    let ar = arOp(name)
    if ar.k >= 0 {
        let a = g.u.listAt(n.b, 0)
        let b = g.u.listAt(n.b, 1)
        if !ar.wrap && (nargs != 3 || !g.isWhere(g.u.listAt(n.b, 2))) { return false }
        let src = if ar.op == ir.OP_SUB { g.pairSrc(a, b) } else { g.pairSrcC(a, b) }
        let k = ar.k
        let sz = if k == ir.TY_I64 || k == ir.TY_U64 { 8 } else { 4 }
        if ar.op == ir.OP_MUL && k == ir.TY_U64 && !ar.wrap {
            g.srcRCX(src)
            g.a.unary(x64.MUL, 8, RCX)                  // rdx:rax; CF and OF when rdx != 0
        } else if ar.op == ir.OP_MUL {
            g.imulSrc(if k == ir.TY_I32 || k == ir.TY_I64 { sz } else { 8 }, RAX, src)
        } else {
            g.aluSrc(if ar.op == ir.OP_ADD { x64.ADD } else { x64.SUB }, sz, RAX, src)
        }
        if !ar.wrap { g.ovfCheck(ar, RAX, g.u.listAt(n.b, 2)) }
        g.normR(k, RAX)
        return true
    }
    if (startsWith(name, "rt_cvs_") || startsWith(name, "rt_cvu_")) && nargs == 2 && g.isWhere(g.u.listAt(n.b, 1)) &&
        g.inlineCv(name, g.u.listAt(n.b, 0), g.u.listAt(n.b, 1)) {
        return true
    }
    let dv = divOp(name)
    if dv.k >= 0 && nargs == (if dv.op == ir.OP_SUB { 2 } else { 3 }) && g.isWhere(g.u.listAt(n.b, nargs - 1)) {
        g.inlineDiv(dv, e)
        return true
    }
    if name == "rt_idx" && nargs == 3 && g.isWhere(g.u.listAt(n.b, 2)) {
        // the index into rax (the result) and compared unsigned: a negative one is above any length
        g.aluSrc(x64.CMP, 8, RAX, g.pairSrc(g.u.listAt(n.b, 0), g.u.listAt(n.b, 1)))
        g.a.jcc(x64.CC_AE, g.stub(3, "index out of range", g.u.listAt(n.b, 2)))
        return true
    }
    if name == "rt_str_byte" && nargs == 3 && g.isWhere(g.u.listAt(n.b, 2)) {
        let sx = g.u.listAt(n.b, 0)
        let ix = g.u.listAt(n.b, 1)
        let m = g.staticMem(sx)
        if m.base != -9 {
            // a str in the frame, read in place; the index from its register if it has one
            var ri = g.regOf(ix)
            if ri < 0 {
                ri = RCX
                if g.simple(ix) {
                    g.genInto(ix, RCX)
                } else {
                    g.gen(ix)
                    g.a.movRR(8, RCX, RAX)
                }
            }
            g.a.loadZX(4, RDX, at(m, 12))               // len
            g.a.alu(x64.CMP, 8, ri, RDX)
            g.a.jcc(x64.CC_AE, g.stub(3, "string index out of range", g.u.listAt(n.b, 2)))
            g.a.loadZX(4, RAX, at(m, 8))                // off
            g.a.aluRM(x64.ADD, 8, RAX, m)               // + the block
            g.a.loadZX(1, RAX, x64.memx(RAX, ri, 1, 8)) // data[off + i]
            return true
        }
        g.gen(sx)                                       // the address of the str
        if g.simple(ix) {
            g.genInto(ix, RCX)
        } else {
            let h = g.hold(ix, g.quietTree(ix))
            g.gen(ix)
            g.unhold(h)
            g.a.movRR(8, RCX, RAX)
            g.unholdInto(h, RAX)
        }
        g.a.loadZX(4, RDX, x64.mem(RAX, 12))            // len
        g.a.alu(x64.CMP, 8, RCX, RDX)
        g.a.jcc(x64.CC_AE, g.stub(3, "string index out of range", g.u.listAt(n.b, 2)))
        g.a.loadZX(4, RDX, x64.mem(RAX, 8))             // off
        g.a.load(8, RAX, x64.mem(RAX, 0))               // the block
        g.a.alu(x64.ADD, 8, RAX, RDX)
        g.a.loadZX(1, RAX, x64.memx(RAX, RCX, 1, 8))    // data[off + i]
        return true
    }
    if name == "rt_str_dup" && nargs == 1 {
        // if (b && b->rc >= 0) b->rc++; the result is the same str: a local or a member of
        // one is its own result (an aggregate value is the address of its bytes, used at once)
        let x = g.u.listAt(n.b, 0)
        let m = g.staticMem(x)
        var s = 0
        if m.base != -9 {
            g.a.load(8, RCX, m)
        } else {
            s = g.temp(16, 8)
            g.gen(x)
            g.a.load(8, RCX, x64.mem(RAX, 0))
            g.a.load(8, RDX, x64.mem(RAX, 8))
            g.a.store(8, rbp(s), RCX)
            g.a.store(8, rbp(s + 8), RDX)
        }
        let done = g.a.newLabel()
        g.a.test(8, RCX, RCX)
        g.a.jcc(x64.CC_E, done)
        g.a.load(8, RDX, x64.mem(RCX, 0))
        g.a.test(8, RDX, RDX)
        g.a.jcc(x64.CC_S, done)
        g.a.aluI(x64.ADD, 8, RDX, 1)
        g.a.store(8, x64.mem(RCX, 0), RDX)
        g.a.bind(done)
        g.a.lea(RAX, if m.base != -9 { m } else { rbp(s) })
        return true
    }
    if name == "rt_arr_push" && nargs == 2 && g.u.nk(g.u.listAt(n.b, 1)) == ir.E_INT &&
        x64.fits32(g.u.nodes[g.u.listAt(n.b, 1)].v) {
        // if (a->len == a->cap) the runtime grows it; then data + len++ * size
        let size = g.u.nodes[g.u.listAt(n.b, 1)].v
        g.gen(g.u.listAt(n.b, 0))
        let slow = g.a.newLabel()
        let done = g.a.newLabel()
        g.a.load(8, RCX, x64.mem(RAX, 8))
        g.a.aluRM(x64.CMP, 8, RCX, x64.mem(RAX, 16))
        g.a.jcc(x64.CC_E, slow)
        g.a.lea(RDX, x64.mem(RCX, 1))
        g.a.store(8, x64.mem(RAX, 8), RDX)
        g.a.load(8, RDX, x64.mem(RAX, 0))
        if size == 1 || size == 2 || size == 4 || size == 8 {
            g.a.lea(RAX, x64.memx(RDX, RCX, size, 0))
        } else {
            g.a.imulI(8, RCX, RCX, size)
            g.a.lea(RAX, x64.memx(RDX, RCX, 1, 0))
        }
        g.a.jmp(done)
        g.a.bind(slow)
        g.a.movRR(8, RDI, RAX)
        g.a.movRI(RSI, size)
        g.callRt("rt_arr_push")
        g.a.bind(done)
        return true
    }
    if name == "rt_str_drop" && nargs == 1 {
        // if (b && b->rc > 0 && --b->rc == 0) rt_free(b)
        let m = g.staticMem(g.u.listAt(n.b, 0))
        if m.base != -9 {
            g.a.load(8, RDI, m)
        } else {
            g.gen(g.u.listAt(n.b, 0))
            g.a.load(8, RDI, x64.mem(RAX, 0))
        }
        let done = g.a.newLabel()
        g.a.test(8, RDI, RDI)
        g.a.jcc(x64.CC_E, done)
        g.a.load(8, RCX, x64.mem(RDI, 0))
        g.a.test(8, RCX, RCX)
        g.a.jcc(x64.CC_LE, done)
        g.a.aluI(x64.SUB, 8, RCX, 1)
        g.a.store(8, x64.mem(RDI, 0), RCX)
        g.a.jcc(x64.CC_NE, done)
        g.callRt("rt_free")
        g.a.bind(done)
        return true
    }
    if name == "rt_str_eq" && nargs == 2 {
        // a.len == b.len && (a.len == 0 || rt_str_eq(a, b)): the lengths first, inline
        let a = g.u.listAt(n.b, 0)
        let b = g.u.listAt(n.b, 1)
        if g.strPlace(b) {
            g.gen(a)
            g.a.movRR(8, RCX, RAX)
            g.strAddr(b, RDX)
        } else if g.strPlace(a) && g.pure(b) {
            g.gen(b)
            g.a.movRR(8, RDX, RAX)
            g.strAddr(a, RCX)
        } else {
            g.gen(a)
            let h = g.hold(b, g.quietTree(b))
            g.gen(b)
            g.unhold(h)
            g.a.movRR(8, RDX, RAX)
            g.unholdInto(h, RCX)
        }
        let no = g.a.newLabel()
        let yes = g.a.newLabel()
        let done = g.a.newLabel()
        g.a.load(4, RAX, x64.mem(RCX, 12))
        g.a.aluRM(x64.CMP, 4, RAX, x64.mem(RDX, 12))
        g.a.jcc(x64.CC_NE, no)
        g.a.test(4, RAX, RAX)
        g.a.jcc(x64.CC_E, yes)
        g.a.load(8, RDI, x64.mem(RCX, 0))
        g.a.load(8, RSI, x64.mem(RCX, 8))
        g.a.load(8, RCX, x64.mem(RDX, 8))
        g.a.load(8, RDX, x64.mem(RDX, 0))
        g.callRt("rt_str_eq")
        g.normR(ir.TY_BOOL, RAX)
        g.a.jmp(done)
        g.a.bind(no)
        g.a.movRI(RAX, 0)
        g.a.jmp(done)
        g.a.bind(yes)
        g.a.movRI(RAX, 1)
        g.a.bind(done)
        return true
    }
    return false
}

// Whether the str x is a place strAddr can name without code that changes registers: a local
// or a member of one in the frame, or a global.
fn (g: &Gen) strPlace(x: int): bool {
    return g.staticMem(x).base != -9 || g.u.nk(x) == ir.E_GLOBAL
}

fn (g: mut &Gen) strAddr(x: int, r: int) {
    let m = g.staticMem(x)
    if m.base != -9 {
        g.a.lea(r, m)
    } else {
        g.a.movRSym(r, g.globalSym[g.u.nodes[x].a], 0)
    }
}

// rt_cvs_N(v, w) and rt_cvu_N(v, w) (a conversion to the integer type N with a range check)
// inline when v is an integer of 64 bits or less widened to 128 bits: the check, if the
// range of v's type is not within N's, is a compare or two. False: not inlined, nothing emitted.
fn (g: mut &Gen) inlineCv(name: str, v: int, w: int): bool {
    let tk = suffixKind(name[7..len(name)])
    let vn = g.u.nodes[v]
    if tk < 0 || vn.k != ir.E_CAST || !g.is128(vn.ty) || !g.u.isInt(g.u.nodes[vn.a].ty) || g.is128(g.u.nodes[vn.a].ty) {
        return false
    }
    let sk = g.tk(g.u.nodes[vn.a].ty)
    g.gen(vn.a)
    let ssgn = ir.isSignedK(sk)
    let fitsLo = !ssgn || kindMin(sk) >= kindMin(tk)
    let fitsHi = if ssgn { kindMax(tk) == -1 || kindMax(sk) <= kindMax(tk) } else {
        kindMax(tk) == -1 || (kindMax(sk) != -1 && kindMax(sk) <= kindMax(tk)) }
    if fitsLo && fitsHi { return true }
    let l = g.stub(10, "conversion out of range", w)
    if tk == ir.TY_I64 || tk == ir.TY_U64 {
        // from signed to u64, or from u64 to int: the sign bit
        g.a.test(8, RAX, RAX)
        g.a.jcc(x64.CC_S, l)
    } else if tk == ir.TY_U32 {
        g.a.movRR(8, RCX, RAX)
        g.a.shiftI(x64.SHR, 8, RCX, 32)
        g.a.jcc(x64.CC_NE, l)
    } else if tk == ir.TY_I32 && ssgn {
        g.a.sx(4, RCX, RAX)
        g.a.alu(x64.CMP, 8, RCX, RAX)
        g.a.jcc(x64.CC_NE, l)
    } else {
        // to byte, or from unsigned to i32: compared unsigned (a negative value is above any)
        g.a.aluI(x64.CMP, 8, RAX, kindMax(tk))
        g.a.jcc(x64.CC_A, l)
    }
    return true
}

// A checked division, remainder, negation or shift of the runtime (divOp) inline: the same
// checks, in the same order, and trap messages.
fn (g: mut &Gen) inlineDiv(dv: ArOp, e: int) {
    let n = g.u.nodes[e]
    let k = dv.k
    let sz = if k == ir.TY_I64 || k == ir.TY_U64 { 8 } else { 4 }
    let sgn = k == ir.TY_I64 || k == ir.TY_I32
    let a = g.u.listAt(n.b, 0)
    if dv.op == ir.OP_SUB {
        g.gen(a)
        g.a.unary(x64.NEG, sz, RAX)
        g.a.jcc(x64.CC_O, g.stub(10, "integer overflow", g.u.listAt(n.b, 1)))
        g.normR(k, RAX)
        return
    }
    let b = g.u.listAt(n.b, 1)
    let w = g.u.listAt(n.b, 2)
    let bn = g.u.nodes[b]
    let bits = if k == ir.TY_U8 { 8 } else { sz * 8 }
    if dv.op == ir.OP_SHL || dv.op == ir.OP_SHR {
        let sop = if dv.op == ir.OP_SHL { x64.SHL } else if sgn { x64.SAR } else { x64.SHR }
        if bn.k == ir.E_INT && bn.v >= 0 && bn.v < bits {
            g.gen(a)
            if bn.v != 0 { g.a.shiftI(sop, sz, RAX, bn.v) }
        } else {
            g.srcRCX(g.pairSrc(a, b))
            g.a.aluI(x64.CMP, 8, RCX, bits - 1)
            g.a.jcc(x64.CC_A, g.stub(10, "shift count out of range", w))
            g.a.shiftCL(sop, sz, RAX)
        }
        g.normR(k, RAX)
        return
    }
    let constB = bn.k == ir.E_INT && bn.v != 0 && bn.v != -1
    g.srcRCX(g.pairSrc(a, b))
    if !constB {
        g.a.test(8, RCX, RCX)
        g.a.jcc(x64.CC_E, g.stub(10, "division by zero", w))
        if sgn {
            let ok = g.a.newLabel()
            g.a.aluI(x64.CMP, 8, RCX, -1)
            g.a.jcc(x64.CC_NE, ok)
            if sz == 8 {
                g.a.movRI(RDX, kindMin(k))
                g.a.alu(x64.CMP, 8, RAX, RDX)
            } else {
                g.a.aluI(x64.CMP, 4, RAX, kindMin(k))
            }
            g.a.jcc(x64.CC_E, g.stub(10, "integer overflow", w))
            g.a.bind(ok)
        }
    }
    if sgn {
        if sz == 8 { g.a.cqo() } else { g.a.cdq() }
        g.a.unary(x64.IDIV, sz, RCX)
    } else {
        g.a.alu(x64.XOR, 4, RDX, RDX)
        g.a.unary(x64.DIV, sz, RCX)
    }
    if dv.op == ir.OP_REM { g.a.movRR(8, RAX, RDX) }
    g.normR(k, RAX)
}

// ---------------------------------------------------------------- constants

// The bits of a double (obx has no bit cast: the fields are found arithmetically, exactly).
pub fn floatBits(f0: float): int {
    if f0 == 0.0 { return 0 }
    var f = f0
    var sign = 0
    if f < 0.0 {
        sign = 1
        f = -f
    }
    var e = 0
    while f >= 2.0 {
        f = f / 2.0
        e += 1
    }
    while f < 1.0 && e > -1022 {
        f = f * 2.0
        e -= 1
    }
    if f < 1.0 { return (sign << 63) | int(f * 4503599627370496.0) }
    return (sign << 63) | ((e + 1023) << 52) | int((f - 1.0) * 4503599627370496.0)
}

// A constant: a 128-bit value (lo, hi), plus the address of sym when sym >= 0.
type K = value record {
    lo: int
    hi: int
    sym: int
}

fn (g: mut &Gen) constOf(e: int): K {
    let n = g.u.nodes[e]
    let k = n.k
    if k == ir.E_INT {
        return K{lo: n.v, hi: if n.v < 0 && g.u.isSigned(n.ty) { -1 } else { 0 }, sym: -1}
    }
    if k == ir.E_FLT { return K{lo: floatBits(n.f), hi: 0, sym: -1} }
    if k == ir.E_NEG && g.isF(n.ty) {
        let x = g.constOf(n.a)
        return K{lo: x.lo ^ (-9223372036854775807 - 1), hi: 0, sym: -1}
    }
    if k == ir.E_ADDR || k == ir.E_DECAY { return g.constAddr(n.a) }
    if k == ir.E_CAST {
        let x = g.constOf(n.a)
        let st = g.u.nodes[n.a].ty
        if g.isF(n.ty) || g.isF(st) {
            if g.isF(n.ty) && g.isF(st) { return x }
            g.fail(e, "a float conversion in a constant")
        }
        if g.is128(n.ty) {
            if g.is128(st) { return x }
            return K{lo: x.lo, hi: if x.lo < 0 && g.u.isSigned(st) { -1 } else { 0 }, sym: -1}
        }
        if x.sym >= 0 { return x }
        let v = ir.truncTo(g.tk(n.ty), x.lo)
        return K{lo: v, hi: if v < 0 && g.u.isSigned(n.ty) { -1 } else { 0 }, sym: -1}
    }
    if k == ir.E_BIN {
        let a = g.constOf(n.a)
        let b = g.constOf(n.b)
        if a.sym < 0 && b.sym < 0 {
            if n.v == ir.OP_OR { return K{lo: a.lo | b.lo, hi: a.hi | b.hi, sym: -1} }
            if n.v == ir.OP_AND { return K{lo: a.lo & b.lo, hi: a.hi & b.hi, sym: -1} }
            if n.v == ir.OP_SHL && g.is128(n.ty) && b.lo == 64 { return K{lo: 0, hi: a.lo, sym: -1} }
            if n.v == ir.OP_SHL && g.is128(n.ty) && b.lo == 0 { return a }
        }
    }
    g.fail(e, "a constant initializer of this form")
}

fn (g: mut &Gen) constAddr(e: int): K {
    let n = g.u.nodes[e]
    if n.k == ir.E_GLOBAL { return K{lo: 0, hi: 0, sym: g.globalSym[n.a]} }
    if n.k == ir.E_FUNC {
        let s = g.symFunc(n.a, e)
        if g.syms[s].kind == SK_DYN { g.fail(e, "the address of a C library function in a constant") }
        return K{lo: 0, hi: 0, sym: s}
    }
    if n.k == ir.E_STR { return K{lo: 0, hi: 0, sym: g.symStr(n.s)} }
    if n.k == ir.E_MEMBER {
        let x = g.constAddr(n.a)
        return K{lo: x.lo + n.v, hi: 0, sym: x.sym}
    }
    g.fail(e, "an address constant of this form")
}

// ---------------------------------------------------------------- the link

fn putN(buf: mut &[]byte, off: int, v: int, n: int) {
    var x = v
    for i in 0..n {
        buf[off + i] = byte(x & 255)
        x = x >> 8
    }
}

fn growTo(buf: mut &[]byte, n: int) {
    while len(buf) < n { append(buf, 0) }
}

fn chunks(parts: &[str], out: mut &[]byte) {
    for p in parts {
        for i in 0..len(p) { append(out, strByte(p, i)) }
    }
}

// Writes the initializer entries of a global at off of buf.
fn (g: mut &Gen) initData(buf: mut &[]byte, ro: bool, off: int, ents: int, relocs: mut &[]DataReloc) {
    for j in 0..g.u.listLen(ents) {
        let en = g.u.nodes[g.u.listAt(ents, j)]
        let t = en.ty
        let x = en.a
        let o = off + en.v
        if g.u.nk(x) == ir.E_STR && g.tk(t) == ir.TY_ARR {
            let s = g.u.nodes[x].s
            for i in 0..len(s) {
                if i < g.size(t) { buf[o + i] = strByte(s, i) }
            }
        } else if g.isAggr(t) {
            g.fail(x, "a global initialized from an aggregate value")
        } else {
            let c = g.constOf(x)
            if c.sym >= 0 {
                if g.size(t) != 8 { g.fail(x, "an address constant in a narrow field") }
                append(relocs, DataReloc{ro: ro, off: o, sym: c.sym, addend: c.lo})
            } else if g.size(t) == 16 {
                putN(buf, o, c.lo, 8)
                putN(buf, o + 8, c.hi, 8)
            } else {
                putN(buf, o, c.lo, g.size(t))
            }
        }
    }
}

fn (g: mut &Gen) link(): []byte {
    let codeBase = ir.alignUp(rtx.TEXT_ADDR + rtx.TEXT_SIZE, CODE_ALIGN)
    let roBase = ir.alignUp(codeBase + len(g.a.code), 16)
    let dataBase = ir.alignUp(rtx.BSS_ADDR + rtx.BSS_SIZE, elf.PAGE)
    var ro: []byte = []
    var data: []byte = []
    var relocs: []DataReloc = []
    var gAddr: []int = []
    // initialized globals (constant ones in rodata), then the bss
    var bssList: []int = []
    for i in 0..len(g.u.globals) {
        append(mut &gAddr, 0)
        let t = g.u.globals[i].ty
        let init = g.u.globals[i].init
        let isConst = g.u.globals[i].isConst
        let al = g.u.alignOf(t)
        if init < 0 && !isConst {
            append(mut &bssList, i)
        } else if isConst {
            let off = ir.alignUp(len(ro), al)
            growTo(mut &ro, off + g.size(t))
            gAddr[i] = roBase + off
            if init >= 0 { g.initData(mut &ro, true, off, init, mut &relocs) }
        } else {
            let off = ir.alignUp(len(data), al)
            growTo(mut &data, off + g.size(t))
            gAddr[i] = dataBase + off
            g.initData(mut &data, false, off, init, mut &relocs)
        }
    }
    // string literals (symStr may have been called by initData, so after the globals)
    var sAddr: []int = []
    for i in 0..len(g.strs) {
        let s = g.strs[i]
        append(mut &sAddr, roBase + len(ro))
        for j in 0..len(s) { append(mut &ro, strByte(s, j)) }
        append(mut &ro, 0)
    }
    // dynamic linking: the dynamic section and the GOT at the end of the data, the tables at
    // the end of the rodata
    var dynAt = 0
    var dynLen = 0
    var gotAt = 0
    if g.dyn {
        var needed: []str = []
        var ims: []elf.Import = []
        g.resolve(mut &needed, mut &ims)
        let dynOff = ir.alignUp(len(data), 8)
        dynLen = elf.dynSize(len(needed))
        growTo(mut &data, dynOff + dynLen)
        let gotOff = len(data)
        growTo(mut &data, gotOff + 8 * len(g.imports))
        dynAt = dataBase + dynOff
        gotAt = dataBase + gotOff
        var rels: []elf.DynRel = []
        for i in 0..len(g.imports) {
            append(mut &rels, elf.DynRel{at: gotAt + 8 * i, sym: i + 1, kind: elf.R_X86_64_GLOB_DAT, addend: 0})
        }
        let hooks = g.rtAddr.getOr(&"rt_n_libc", -1)
        if hooks < 0 { panic("native: the runtime has no rt_n_libc") }
        for k in 0..len(HOOKS) {
            let h = HOOKS[k]
            let im = g.syms[g.importSym.getOr(&h, -1)].idx
            append(mut &rels, elf.DynRel{at: hooks + 8 * k, sym: im + 1, kind: elf.R_X86_64_GLOB_DAT, addend: 0})
        }
        let tabOff = ir.alignUp(len(ro), 8)
        growTo(mut &ro, tabOff)
        let d = elf.dynamic(&needed, &ims, &rels, roBase + tabOff)
        for x in d.tables { append(mut &ro, x) }
        for i in 0..len(d.dyn) { data[dynOff + i] = d.dyn[i] }
    }
    var memEnd = ir.alignUp(len(data), 16)
    for i in bssList {
        let t = g.u.globals[i].ty
        memEnd = ir.alignUp(memEnd, g.u.alignOf(t))
        gAddr[i] = dataBase + memEnd
        memEnd += g.size(t)
    }
    // symbol addresses
    var addr: []int = []
    for i in 0..len(g.syms) {
        let s = g.syms[i]
        if s.kind == SK_FUNC {
            append(mut &addr, codeBase + g.funcPos[s.idx])
        } else if s.kind == SK_GLOBAL {
            append(mut &addr, gAddr[s.idx])
        } else if s.kind == SK_STR {
            append(mut &addr, sAddr[s.idx])
        } else if s.kind == SK_DYN {
            append(mut &addr, gotAt + 8 * s.idx)
        } else {
            append(mut &addr, s.addr)
        }
    }
    for i in 0..len(g.a.relocs) {
        let r = g.a.relocs[i]
        let v = addr[r.sym] + r.addend
        if r.kind == x64.R_REL32 {
            g.a.put32(r.at, v - (codeBase + r.at + 4))
        } else if r.kind == x64.R_ABS32 {
            g.a.put32(r.at, v)
        } else {
            panic("native: a 64-bit code relocation")
        }
    }
    for r in relocs {
        if r.ro {
            putN(mut &ro, r.off, addr[r.sym] + r.addend, 8)
        } else {
            putN(mut &data, r.off, addr[r.sym] + r.addend, 8)
        }
    }
    // the segments
    var text: []byte = []
    chunks(&rtx.TEXT, mut &text)
    growTo(mut &text, codeBase - rtx.TEXT_ADDR)
    for x in g.a.code { append(mut &text, x) }
    growTo(mut &text, roBase - rtx.TEXT_ADDR)
    for x in ro { append(mut &text, x) }
    var rdata: []byte = []
    chunks(&rtx.DATA, mut &rdata)
    let rmem = rtx.BSS_ADDR + rtx.BSS_SIZE - rtx.DATA_ADDR
    var segs: []elf.Seg = [elf.Seg{vaddr: rtx.TEXT_ADDR, flags: elf.PF_R | elf.PF_X, data: text, memsz: 0},
        elf.Seg{vaddr: rtx.DATA_ADDR, flags: elf.PF_R | elf.PF_W, data: rdata, memsz: rmem}]
    if memEnd == 0 { memEnd = 16 }
    append(mut &segs, elf.Seg{vaddr: dataBase, flags: elf.PF_R | elf.PF_W, data: data, memsz: memEnd})
    return elf.image(codeBase, &segs, dynAt, dynLen)
}

// Finds the library of every import (the first of libs that defines it, as a linker searches
// its libraries in order); needed: the SONAMEs of the libraries that define one (as with
// --as-needed), in the order of libs.
fn (g: mut &Gen) resolve(needed: mut &[]str, ims: mut &[]elf.Import) {
    var libOf: []int = []
    var used: []bool = []
    for l in g.libs { append(mut &used, false) }
    for name in g.imports {
        var found = -1
        for li in 0..len(g.libs) {
            if found < 0 && g.libs[li].defs.has(&name) { found = li }
        }
        if found < 0 {
            var names: []str = []
            for l in g.libs { append(mut &names, l.soname) }
            writeFd(2, "native: undefined C function '" + name + "' (not in " + strings.join(&names, ", ") + ")\n")
            exit(1)
        }
        used[found] = true
        append(mut &libOf, found)
    }
    var index: []int = []
    for li in 0..len(g.libs) {
        append(mut &index, len(needed))
        if used[li] { append(needed, g.libs[li].soname) }
    }
    for i in 0..len(g.imports) {
        let li = libOf[i]
        append(ims, elf.Import{name: g.imports[i], lib: index[li], ver: g.libs[li].defs.getOr(&g.imports[i], "")})
    }
}
