// cfront: the C front end of the native backend (design/native.md, sections 1 and 1a):
// reads the C that emit writes, after the runtime interface (native/obxrt.h), into the IR
// (ir.obx). It is a thin step, to be replaced by check.obx building the IR directly: it
// only parses and makes C's rules explicit; nothing after it sees C syntax.
//
// The input is a fixed, narrow subset of C: typedefs, structs and unions, prototypes,
// function definitions, globals with constant initializers; the statements if, while, for,
// switch/case, break, continue, return, blocks, declarations and expressions; the
// expressions of C without the comma operator. Anything else stops the compiler with
// `native: unsupported: ...` and the C line. Types follow gcc on x86-64: char is signed,
// long is 64 bits, __int128 is 16-aligned; struct layout as gcc's.
//
// C's implicit conversions (integer promotions, the usual arithmetic conversions,
// assignment and argument conversions, array and function decay, pointer arithmetic) become
// explicit IR nodes here.

import "./ir"
import "./rt"
import "./rtx"
import "strings"

// The IR of the C program c (the text emit writes, the runtime prefix included).
pub fn read(c: str): ir.Ir {
    let prefix = strings.join(&rt.RT, "\n")
    if !startsWith(c, prefix) { ir.failAt("C line", 1, "the C does not start with the runtime (rt.h)") }
    var u = newUnit()
    u.parse(strings.join(&rtx.HEADER, "\n"), "runtime header line", 0)
    var lines = 0
    for i in 0..len(prefix) {
        if strByte(prefix, i) == '\n' { lines += 1 }
    }
    u.parse(c[len(prefix)..len(c)], "C line", lines)
    return replace(mut &u.ir, ir.newIr())
}

// ---------------------------------------------------------------- tokens

const K_ID = 0
const K_INT = 1
const K_FLT = 2
const K_STR = 3
const K_CHAR = 4
const K_P = 5
const K_EOF = 6

type Tok = value record {
    k: int
    p: int          // the text is src[p..e]
    e: int
    line: int
    op: int         // K_P: the index in PUNCT
}

// Longest first, so that the lexer can take the first that matches.
const PUNCT: []str = ["<<=", ">>=", "...", "->", "++", "--", "<<", ">>", "<=", ">=", "==", "!=", "&&", "||",
    "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "(", ")", "{", "}", "[", "]", ";", ",", ".", "&", "*", "+",
    "-", "~", "!", "/", "%", "<", ">", "^", "|", "?", ":", "="]

type Unit = record {
    pub ir: ir.Ir
    typedefs: Map[str, int]
    tags: Map[str, int]
    funcIdx: Map[str, int]
    globalIdx: Map[str, int]
    scope: Map[str, int]        // local names in scope -> local
    undo: []str                 // names declared in the open blocks, with their shadowed locals
    undoVal: []int
    curRet: int                 // the result type of the function being parsed
    src: str
    toks: []Tok
    i: int
    lineBase: int               // added to token lines in messages (the header comes first)
    what: str                   // "C line" or "runtime header line"
}

fn newUnit(): Unit {
    var u = Unit{ir: ir.newIr(), typedefs: newMap(), tags: newMap(), funcIdx: newMap(), globalIdx: newMap(),
        scope: newMap(), undo: [], undoVal: [], curRet: ir.TY_VOID, src: "", toks: [], i: 0, lineBase: 0, what: "C line"}
    let names: []str = ["int8_t", "uint8_t", "int16_t", "uint16_t", "int32_t", "uint32_t", "int64_t", "uint64_t",
        "size_t", "ssize_t", "intptr_t", "uintptr_t", "_Bool"]
    let ids: []int = [ir.TY_I8, ir.TY_U8, ir.TY_I16, ir.TY_U16, ir.TY_I32, ir.TY_U32, ir.TY_I64, ir.TY_U64, ir.TY_U64, ir.TY_I64, ir.TY_I64, ir.TY_U64,
        ir.TY_BOOL]
    for j in 0..len(names) { u.typedefs.put(names[j], ids[j]) }
    return u
}

// ---------------------------------------------------------------- errors

fn (u: &Unit) fail(msg: str): never {
    let t = u.toks[if u.i < len(u.toks) { u.i } else { len(u.toks) - 1 }]
    ir.failAt(u.what, t.line + u.lineBase, msg)
}


// ---------------------------------------------------------------- the lexer

fn isIdStart(c: byte): bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' }

fn isIdChar(c: byte): bool { return isIdStart(c) || (c >= '0' && c <= '9') }

fn (u: mut &Unit) lex() {
    let s = u.src
    let n = len(s)
    var i = 0
    var line = 1
    while i < n {
        let c = strByte(s, i)
        if c == '\n' {
            line += 1
            i += 1
        } else if c == ' ' || c == '\t' || c == '\r' {
            i += 1
        } else if c == '/' && i + 1 < n && strByte(s, i + 1) == '/' {
            while i < n && strByte(s, i) != '\n' { i += 1 }
        } else if c == '/' && i + 1 < n && strByte(s, i + 1) == '*' {
            i += 2
            while i + 1 < n && !(strByte(s, i) == '*' && strByte(s, i + 1) == '/') {
                if strByte(s, i) == '\n' { line += 1 }
                i += 1
            }
            i += 2
        } else if c == '#' {
            while i < n && strByte(s, i) != '\n' { i += 1 }
        } else if isIdStart(c) {
            let st = i
            while i < n && isIdChar(strByte(s, i)) { i += 1 }
            append(mut &u.toks, Tok{k: K_ID, p: st, e: i, line: line, op: -1})
        } else if (c >= '0' && c <= '9') || (c == '.' && i + 1 < n && strByte(s, i + 1) >= '0' && strByte(s, i + 1) <= '9') {
            let st = i
            var flt = false
            if c == '0' && i + 1 < n && (strByte(s, i + 1) == 'x' || strByte(s, i + 1) == 'X') {
                i += 2
                while i < n && isIdChar(strByte(s, i)) { i += 1 }
            } else {
                while i < n {
                    let d = strByte(s, i)
                    if d == '.' || ((d == 'e' || d == 'E') && i + 1 < n) {
                        flt = true
                        if (d == 'e' || d == 'E') && (strByte(s, i + 1) == '+' || strByte(s, i + 1) == '-') { i += 1 }
                        i += 1
                    } else if isIdChar(d) {
                        i += 1
                    } else {
                        break
                    }
                }
            }
            append(mut &u.toks, Tok{k: if flt { K_FLT } else { K_INT }, p: st, e: i, line: line, op: -1})
        } else if c == '"' || c == '\'' {
            let st = i
            i += 1
            while i < n && strByte(s, i) != c {
                if strByte(s, i) == '\\' { i += 1 }
                i += 1
            }
            i += 1
            append(mut &u.toks, Tok{k: if c == '"' { K_STR } else { K_CHAR }, p: st, e: i, line: line, op: -1})
        } else {
            var found = -1
            for j in 0..len(PUNCT) {
                let p = PUNCT[j]
                if found < 0 && i + len(p) <= n && s[i..i + len(p)] == p { found = j }
            }
            if found < 0 { ir.failAt(u.what, line + u.lineBase, "unexpected character in the C text") }
            append(mut &u.toks, Tok{k: K_P, p: i, e: i + len(PUNCT[found]), line: line, op: found})
            i += len(PUNCT[found])
        }
    }
    append(mut &u.toks, Tok{k: K_EOF, p: n, e: n, line: line, op: -1})
}

fn (u: &Unit) tok(): Tok { return u.toks[u.i] }

fn (u: &Unit) peekTok(d: int): Tok {
    let j = u.i + d
    return u.toks[if j < len(u.toks) { j } else { len(u.toks) - 1 }]
}

fn (u: &Unit) text(t: Tok): str { return u.src[t.p..t.e] }

fn (u: &Unit) isP(p: str): bool {
    let t = u.toks[u.i]
    return t.k == K_P && PUNCT[t.op] == p
}

fn (u: &Unit) isPAt(d: int, p: str): bool {
    let t = u.peekTok(d)
    return t.k == K_P && PUNCT[t.op] == p
}

fn (u: &Unit) isId(name: str): bool {
    let t = u.toks[u.i]
    return t.k == K_ID && u.text(t) == name
}

fn (u: mut &Unit) next() { u.i += 1 }

fn (u: mut &Unit) accept(p: str): bool {
    if u.isP(p) {
        u.i += 1
        return true
    }
    return false
}

fn (u: mut &Unit) expect(p: str) {
    if !u.accept(p) { u.fail("expected '" + p + "', found '" + u.text(u.tok()) + "'") }
}

fn (u: mut &Unit) ident(): str {
    let t = u.tok()
    if t.k != K_ID { u.fail("expected a name, found '" + u.text(t) + "'") }
    u.i += 1
    return u.text(t)
}

fn (u: mut &Unit) mk(k: int, ty: int, a: int, b: int, c: int, v: int): int {
    let line = u.toks[if u.i < len(u.toks) { u.i } else { len(u.toks) - 1 }].line + u.lineBase
    append(mut &u.ir.nodes, ir.Node{k: k, ty: ty, line: line, a: a, b: b, c: c, d: -1, v: v, f: 0.0, s: ""})
    return len(u.ir.nodes) - 1
}

// ---------------------------------------------------------------- the top level

// Parses the text (the runtime header first, then the program, into the same unit).
fn (u: mut &Unit) parse(text: str, what: str, lineBase: int) {
    u.src = text
    u.toks = []
    u.i = 0
    u.what = what
    u.lineBase = lineBase
    u.lex()
    while u.tok().k != K_EOF { u.topDecl() }
}

fn (u: mut &Unit) topDecl() {
    if u.accept(";") { return }
    if u.isId("typedef") {
        u.next()
        let base = u.declSpec()
        let d = u.declarator(base, true)
        u.typedefs.put(d.name, d.ty)
        u.expect(";")
        return
    }
    let isExtern = u.isId("extern")
    let isConst = u.hasConstBefore()
    let base = u.declSpec()
    if u.accept(";") { return }         // struct S {...};
    while true {
        let d = u.declarator(base, true)
        if u.ir.tk(d.ty) == ir.TY_FN {
            u.funcDecl(d, isExtern)
            return
        }
        u.globalDecl(d, isConst)
        if !u.accept(",") { break }
    }
    u.expect(";")
}

// Whether a `const` qualifies the declared object (before the base type, not after a `*`).
fn (u: &Unit) hasConstBefore(): bool {
    var j = u.i
    while true {
        let t = u.toks[j]
        if t.k != K_ID { return false }
        let w = u.text(t)
        if w == "const" { return true }
        if w != "static" && w != "extern" && w != "inline" && w != "volatile" { return false }
        j += 1
    }
    return false
}

type Decl = value record {
    name: str
    ty: int
    params: []str       // a function declarator's parameter names
    asmName: str
}

fn (u: mut &Unit) funcDecl(d: Decl, isExtern: bool) {
    let name = d.name
    var f = u.funcIdx.getOr(&name, -1)
    if f < 0 {
        append(mut &u.ir.funcs, ir.Func{name: name, ty: d.ty, params: [], body: -1,
            asmName: if d.asmName != "" { d.asmName } else { name }, isExtern: d.asmName != "", line: u.tok().line})
        f = len(u.ir.funcs) - 1
        u.funcIdx.put(name, f)
    }
    if !u.isP("{") {
        u.expect(";")
        return
    }
    if u.ir.funcs[f].body >= 0 { u.fail("function " + name + " defined twice") }
    u.ir.funcs[f].ty = d.ty
    u.ir.funcs[f].line = u.tok().line + u.lineBase
    let pts = u.ir.fnParams(d.ty)
    var ps: []int = []
    let mark = len(u.undo)
    for j in 0..len(d.params) {
        if d.params[j] == "" { u.fail("a parameter without a name") }
        append(mut &ps, u.declareLocal(d.params[j], pts[j]))
    }
    u.ir.funcs[f].params = ps
    u.curRet = u.ir.tys[d.ty].base
    let body = u.block()
    u.closeScope(mark)
    u.ir.funcs[f].body = body
}

fn (u: mut &Unit) globalDecl(d: Decl, isConst: bool) {
    let name = d.name
    var g = u.globalIdx.getOr(&name, -1)
    if g < 0 {
        append(mut &u.ir.globals, ir.Global{name: name, ty: d.ty, init: -1, isConst: isConst, line: u.tok().line + u.lineBase})
        g = len(u.ir.globals) - 1
        u.globalIdx.put(name, g)
    }
    if u.accept("=") {
        var ents: []int = []
        var ty = d.ty
        u.initializer(mut &ty, 0, mut &ents, true)
        u.ir.globals[g].ty = ty
        u.ir.globals[g].init = u.ir.list(&ents)
    }
}

// ---------------------------------------------------------------- declarations

fn (u: mut &Unit) declSpec(): int {
    var signed = false
    var unsigned = false
    var longs = 0
    var base = -1
    var any = false
    while true {
        let t = u.tok()
        if t.k != K_ID { break }
        let w = u.text(t)
        if w == "static" || w == "const" || w == "extern" || w == "inline" || w == "volatile" || w == "register" {
            u.next()
        } else if w == "__attribute__" {
            u.next()
            u.skipParens()
        } else if w == "unsigned" {
            unsigned = true
            any = true
            u.next()
        } else if w == "signed" {
            signed = true
            any = true
            u.next()
        } else if w == "long" {
            longs += 1
            any = true
            u.next()
        } else if w == "short" {
            base = ir.TY_I16
            any = true
            u.next()
        } else if w == "int" {
            if base < 0 { base = ir.TY_I32 }
            any = true
            u.next()
        } else if w == "char" {
            base = ir.TY_I8
            any = true
            u.next()
        } else if w == "__int128" {
            base = ir.TY_I128
            any = true
            u.next()
        } else if w == "void" {
            base = ir.TY_VOID
            any = true
            u.next()
        } else if w == "double" {
            base = ir.TY_F64
            any = true
            u.next()
        } else if w == "bool" || w == "_Bool" {
            base = ir.TY_BOOL
            any = true
            u.next()
        } else if w == "struct" || w == "union" {
            base = u.structSpec(w == "union")
            any = true
        } else if !any && u.typedefs.has(&w) {
            base = u.typedefs.getOr(&w, -1)
            any = true
            u.next()
        } else {
            break
        }
    }
    if !any { u.fail("expected a type, found '" + u.text(u.tok()) + "'") }
    if base < 0 || (base == ir.TY_I32 && longs > 0) { base = if longs > 0 { ir.TY_I64 } else { ir.TY_I32 } }
    if unsigned {
        if base == ir.TY_I8 { base = ir.TY_U8 }
        if base == ir.TY_I16 { base = ir.TY_U16 }
        if base == ir.TY_I32 { base = ir.TY_U32 }
        if base == ir.TY_I64 { base = ir.TY_U64 }
        if base == ir.TY_I128 { base = ir.TY_U128 }
    }
    if signed && base == ir.TY_I8 { base = ir.TY_I8 }
    return base
}

fn (u: mut &Unit) skipParens() {
    u.expect("(")
    var depth = 1
    while depth > 0 {
        if u.tok().k == K_EOF { u.fail("unbalanced parentheses") }
        if u.isP("(") { depth += 1 }
        if u.isP(")") { depth -= 1 }
        u.next()
    }
}

// struct [tag] [{ fields }]: the type.
fn (u: mut &Unit) structSpec(isUnion: bool): int {
    u.next()
    var tag = ""
    if u.tok().k == K_ID {
        tag = u.ident()
    }
    var sid = -1
    if tag != "" { sid = u.tags.getOr(&tag, -1) }
    if sid < 0 {
        append(mut &u.ir.structs, ir.Struct{name: if tag == "" { "<anonymous>" } else { tag }, isUnion: isUnion, fields: [], ty: -1,
            size: 0, align: 1, complete: false})
        sid = len(u.ir.structs) - 1
        if tag != "" { u.tags.put(tag, sid) }
        append(mut &u.ir.tys, ir.Ty{k: ir.TY_STRUCT, size: 0, align: 1, base: -1, n: 0, sid: sid})
        u.ir.structs[sid].ty = len(u.ir.tys) - 1
    }
    let ty = u.ir.structs[sid].ty
    if !u.accept("{") { return ty }
    if u.ir.structs[sid].complete { u.fail("struct " + tag + " defined twice") }
    var fields: []ir.Field = []
    while !u.accept("}") {
        let base = u.declSpec()
        while true {
            let d = u.declarator(base, true)
            append(mut &fields, ir.Field{name: d.name, ty: d.ty, off: 0})
            if !u.accept(",") { break }
        }
        u.expect(";")
    }
    // gcc's layout: each field at the next offset of its alignment (a union: all at 0)
    var off = 0
    var al = 1
    var size = 0
    for j in 0..len(fields) {
        let ft = fields[j].ty
        let fa = u.ir.alignOf(ft)
        if fa > al { al = fa }
        if isUnion {
            fields[j].off = 0
            if u.ir.sizeOf(ft) > size { size = u.ir.sizeOf(ft) }
        } else {
            off = ir.alignUp(off, fa)
            fields[j].off = off
            off += u.ir.sizeOf(ft)
            size = off
        }
    }
    size = ir.alignUp(size, al)
    u.ir.structs[sid].fields = fields
    u.ir.structs[sid].align = al
    u.ir.structs[sid].complete = true
    u.ir.tys[ty].size = size
    u.ir.tys[ty].align = al
    u.ir.structs[sid].size = size
    return ty
}

// A declarator over base: pointers, a name (unless abstract), array and function suffixes,
// and the one nested form the C uses, (*name)(params), for function pointers.
fn (u: mut &Unit) declarator(base: int, named: bool): Decl {
    var t = base
    while u.accept("*") {
        t = u.ir.ptrTo(t)
        while u.isId("const") || u.isId("volatile") || u.isId("restrict") { u.next() }
    }
    if u.isP("(") && u.isPAt(1, "*") {
        u.next()
        var stars = 0
        while u.accept("*") { stars += 1 }
        var name = ""
        if u.tok().k == K_ID { name = u.ident() }
        u.expect(")")
        var pnames: []str = []
        let ft = u.suffixes(t, mut &pnames)
        var r = ft
        for j in 0..stars { r = u.ir.ptrTo(r) }
        return Decl{name: name, ty: r, params: [], asmName: ""}
    }
    var name = ""
    if u.tok().k == K_ID && !u.typedefs.has(&u.text(u.tok())) {
        name = u.ident()
    } else if named && u.tok().k == K_ID {
        name = u.ident()        // a typedef name redeclared as an object (typedef struct S S;)
    }
    var pnames: []str = []
    t = u.suffixes(t, mut &pnames)
    var asmName = ""
    while u.isId("__asm__") || u.isId("__attribute__") {
        let isAsm = u.isId("__asm__")
        u.next()
        if isAsm {
            u.expect("(")
            let st = u.tok()
            if st.k != K_STR { u.fail("expected a string in __asm__") }
            asmName = u.strBytes(st)
            u.next()
            u.expect(")")
        } else {
            u.skipParens()
        }
    }
    return Decl{name: name, ty: t, params: pnames, asmName: asmName}
}

fn (u: mut &Unit) suffixes(base: int, pnames: mut &[]str): int {
    if u.accept("[") {
        var n = 0
        if !u.isP("]") { n = u.constInt() }
        u.expect("]")
        let inner = u.suffixes(base, pnames)
        return u.ir.arrOf(inner, n)
    }
    if u.accept("(") {
        var pts: []int = []
        if u.isId("void") && u.isPAt(1, ")") {
            u.next()
        } else if !u.isP(")") {
            while true {
                if u.accept("...") { u.fail("variadic functions") }
                let pb = u.declSpec()
                let d = u.declarator(pb, false)
                var pt = d.ty
                if u.ir.tk(pt) == ir.TY_ARR { pt = u.ir.ptrTo(u.ir.tys[pt].base) }
                if u.ir.tk(pt) == ir.TY_FN { pt = u.ir.ptrTo(pt) }
                append(mut &pts, pt)
                append(pnames, d.name)
                if !u.accept(",") { break }
            }
        }
        u.expect(")")
        let ret = u.suffixes(base, pnames)
        return u.ir.fnType(ret, &pts)
    }
    return base
}

// Whether the tokens at the cursor start a type name (for casts, compound literals, sizeof).
fn (u: &Unit) startsType(d: int): bool {
    let t = u.peekTok(d)
    if t.k != K_ID { return false }
    let w = u.text(t)
    if w == "struct" || w == "union" || w == "unsigned" || w == "signed" || w == "int" || w == "long" || w == "char" ||
        w == "short" || w == "void" || w == "double" || w == "bool" || w == "_Bool" || w == "__int128" ||
        w == "const" || w == "volatile" {
        return true
    }
    return u.typedefs.has(&w) && !u.scope.has(&w)
}

fn (u: mut &Unit) parseTypeName(): int {
    let base = u.declSpec()
    let d = u.declarator(base, false)
    if d.name != "" { u.fail("a name in a type name") }
    return d.ty
}

fn (u: mut &Unit) constInt(): int {
    let e = u.condExpr()
    if u.ir.nk(e) != ir.E_INT { u.fail("expected an integer constant") }
    return u.ir.nodes[e].v
}

// ---------------------------------------------------------------- locals and scopes

fn (u: mut &Unit) declareLocal(name: str, ty: int): int {
    append(mut &u.ir.locals, ir.Local{name: name, ty: ty})
    let l = len(u.ir.locals) - 1
    append(mut &u.undo, name)
    append(mut &u.undoVal, u.scope.getOr(&name, -1))
    u.scope.put(name, l)
    return l
}

fn (u: mut &Unit) closeScope(mark: int) {
    while len(u.undo) > mark {
        let name = pop(mut &u.undo)
        let old = pop(mut &u.undoVal)
        if old < 0 {
            u.scope.remove(&name)
        } else {
            u.scope.put(name, old)
        }
    }
}

// ---------------------------------------------------------------- statements

fn (u: mut &Unit) block(): int {
    u.expect("{")
    let mark = len(u.undo)
    var ss: []int = []
    while !u.accept("}") {
        if u.tok().k == K_EOF { u.fail("unexpected end of the C text") }
        append(mut &ss, u.stmt())
    }
    u.closeScope(mark)
    return u.mk(ir.S_BLOCK, ir.TY_VOID, u.ir.list(&ss), -1, -1, 0)
}

fn (u: mut &Unit) stmt(): int {
    if u.isP("{") { return u.block() }
    if u.accept(";") { return u.mk(ir.S_EMPTY, ir.TY_VOID, -1, -1, -1, 0) }
    let t = u.tok()
    if t.k == K_ID {
        let w = u.text(t)
        if w == "if" {
            u.next()
            u.expect("(")
            let c = u.condition()
            u.expect(")")
            let th = u.stmt()
            var el = -1
            if u.isId("else") {
                u.next()
                el = u.stmt()
            }
            return u.mk(ir.S_IF, ir.TY_VOID, c, th, el, 0)
        }
        if w == "while" {
            u.next()
            u.expect("(")
            let c = u.condition()
            u.expect(")")
            let body = u.stmt()
            return u.mk(ir.S_WHILE, ir.TY_VOID, c, body, -1, 0)
        }
        if w == "for" {
            u.next()
            u.expect("(")
            let mark = len(u.undo)
            var init = -1
            if !u.accept(";") {
                init = if u.startsType(0) { u.declStmt() } else { u.exprStmt() }
            }
            var c = -1
            if !u.isP(";") { c = u.condition() }
            u.expect(";")
            var step = -1
            if !u.isP(")") { step = u.expr() }
            u.expect(")")
            let body = u.stmt()
            u.closeScope(mark)
            let n = u.mk(ir.S_FOR, ir.TY_VOID, init, c, step, 0)
            u.ir.nodes[n].d = body
            return n
        }
        if w == "switch" {
            u.next()
            u.expect("(")
            let x = u.promote(u.rv(u.expr()))
            if !u.ir.isInt(u.ir.nty(x)) { u.fail("switch on a non-integer") }
            u.expect(")")
            let body = u.stmt()
            return u.mk(ir.S_SWITCH, u.ir.nty(x), x, body, -1, 0)
        }
        if w == "case" {
            u.next()
            let v = u.constInt()
            u.expect(":")
            return u.mk(ir.S_CASE, ir.TY_VOID, -1, -1, -1, v)
        }
        if w == "default" {
            u.next()
            u.expect(":")
            return u.mk(ir.S_DEFAULT, ir.TY_VOID, -1, -1, -1, 0)
        }
        if w == "break" {
            u.next()
            u.expect(";")
            return u.mk(ir.S_BREAK, ir.TY_VOID, -1, -1, -1, 0)
        }
        if w == "continue" {
            u.next()
            u.expect(";")
            return u.mk(ir.S_CONTINUE, ir.TY_VOID, -1, -1, -1, 0)
        }
        if w == "return" {
            u.next()
            var x = -1
            if !u.isP(";") { x = u.convert(u.expr(), u.curRet) }
            u.expect(";")
            return u.mk(ir.S_RETURN, ir.TY_VOID, x, -1, -1, 0)
        }
        if w == "goto" || w == "do" { u.fail("'" + w + "' statements") }
        if u.startsType(0) && !u.isPAt(1, "(") || (u.startsType(0) && u.isPAt(1, "(") && !u.typedefs.has(&w)) {
            return u.declStmt()
        }
        if u.startsType(0) && u.isPAt(1, "*") { return u.declStmt() }
    }
    return u.exprStmt()
}

fn (u: mut &Unit) exprStmt(): int {
    let e = u.expr()
    u.expect(";")
    return u.mk(ir.S_EXPR, ir.TY_VOID, e, -1, -1, 0)
}

// A declaration of one local (several are a block of declarations).
fn (u: mut &Unit) declStmt(): int {
    let base = u.declSpec()
    var ds: []int = []
    while true {
        let d = u.declarator(base, true)
        var ty = d.ty
        var init = -1
        var ents = -1
        let l = u.declareLocal(d.name, ty)      // in scope in its own initializer (sizeof(*p))
        if u.accept("=") {
            if u.isP("{") || u.isAggrInit(ty) {
                var es: []int = []
                u.initializer(mut &ty, 0, mut &es, false)
                ents = u.ir.list(&es)
                u.ir.locals[l].ty = ty
            } else {
                init = u.convert(u.assignExpr(), ty)
            }
        }
        append(mut &ds, u.mk(ir.S_DECL, ir.TY_VOID, l, init, ents, 0))
        if !u.accept(",") { break }
    }
    u.expect(";")
    if len(ds) == 1 { return ds[0] }
    return u.mk(ir.S_BLOCK, ir.TY_VOID, u.ir.list(&ds), -1, -1, 1)      // v 1: no scope of its own
}

// A char array initialized by a string.
fn (u: &Unit) isAggrInit(ty: int): bool { return u.ir.tk(ty) == ir.TY_ARR && u.tok().k == K_STR }

// A controlling expression: a scalar.
fn (u: mut &Unit) condition(): int {
    let c = u.rv(u.expr())
    if !u.ir.isScalar(u.ir.nty(c)) { u.fail("a condition that is not a scalar") }
    return c
}

// ---------------------------------------------------------------- initializers

// Appends the entries that initialize an object of type ty at off. An array of unknown
// length takes it from the initializer (ty changes). top: a static initializer.
fn (u: mut &Unit) initializer(ty: mut &int, off: int, out: mut &[]int, top: bool) {
    let t: int = ty
    let k = u.ir.tk(t)
    if k == ir.TY_ARR && u.ir.tys[u.ir.tys[t].base].size == 1 && u.tok().k == K_STR {
        let s = u.strBytes(u.tok())
        u.next()
        if u.ir.tys[t].n == 0 { ty = u.ir.arrOf(u.ir.tys[t].base, len(s) + 1) }
        let sn = u.mk(ir.E_STR, u.ir.arrOf(ir.TY_I8, len(s) + 1), -1, -1, -1, 0)
        u.ir.nodes[sn].s = s
        append(out, u.mk(ir.E_IENT, ty, sn, -1, -1, off))
        return
    }
    if u.isP("{") {
        u.next()
        if k == ir.TY_STRUCT {
            let sid = u.ir.tys[t].sid
            var cur = 0
            while !u.accept("}") {
                if u.isP(".") {
                    var fo = 0
                    var ft = t
                    var top2 = -1
                    while u.accept(".") {
                        let name = u.ident()
                        let fx = u.fieldOf(ft, name)
                        if top2 < 0 { top2 = fx.idx }
                        fo += fx.off
                        ft = fx.ty
                    }
                    u.expect("=")
                    var ft2 = ft
                    u.initializer(mut &ft2, off + fo, out, top)
                    cur = top2 + 1
                } else {
                    if cur >= len(u.ir.structs[sid].fields) { u.fail("too many initializers") }
                    let f = u.ir.structs[sid].fields[cur]
                    var ft = f.ty
                    u.initializer(mut &ft, off + f.off, out, top)
                    cur += 1
                }
                if !u.accept(",") {
                    u.expect("}")
                    break
                }
            }
            return
        }
        if k == ir.TY_ARR {
            let et = u.ir.tys[t].base
            let es = u.ir.sizeOf(et)
            var j = 0
            while !u.accept("}") {
                var e2 = et
                u.initializer(mut &e2, off + j * es, out, top)
                j += 1
                if !u.accept(",") {
                    u.expect("}")
                    break
                }
            }
            if u.ir.tys[t].n == 0 { ty = u.ir.arrOf(et, j) }
            return
        }
        // a scalar in braces
        if !u.isP("}") {
            var t2 = t
            u.initializer(mut &t2, off, out, top)
            u.accept(",")
        }
        u.expect("}")
        return
    }
    let e = u.assignExpr()
    if k == ir.TY_STRUCT {
        if u.ir.nty(e) != t {
            // the first field of the struct, from the expression (brace elision)
            let sid = u.ir.tys[t].sid
            if len(u.ir.structs[sid].fields) == 0 { u.fail("initializing an empty struct") }
            let f = u.ir.structs[sid].fields[0]
            if u.ir.isAggr(f.ty) { u.fail("brace elision into a nested aggregate") }
            append(out, u.mk(ir.E_IENT, f.ty, u.convert(e, f.ty), -1, -1, off + f.off))
            return
        }
        append(out, u.mk(ir.E_IENT, t, e, -1, -1, off))
        return
    }
    if k == ir.TY_ARR { u.fail("initializing an array from an expression") }
    append(out, u.mk(ir.E_IENT, t, u.convert(e, t), -1, -1, off))
}

type FieldAt = value record {
    idx: int
    off: int
    ty: int
}

fn (u: &Unit) fieldOf(t: int, name: str): FieldAt {
    if u.ir.tk(t) != ir.TY_STRUCT { u.fail("member '" + name + "' of a non-struct") }
    let sid = u.ir.tys[t].sid
    if !u.ir.structs[sid].complete { u.fail("member of an incomplete struct " + u.ir.structs[sid].name) }
    for j in 0..len(u.ir.structs[sid].fields) {
        let f = u.ir.structs[sid].fields[j]
        if f.name == name { return FieldAt{idx: j, off: f.off, ty: f.ty} }
    }
    u.fail("no member '" + name + "' in " + u.ir.structs[sid].name)
}

// ---------------------------------------------------------------- literals

fn hexVal(c: byte): int {
    if c >= '0' && c <= '9' { return int(c - '0') }
    if c >= 'a' && c <= 'f' { return int(c - 'a') + 10 }
    return int(c - 'A') + 10
}

// The bytes of a string or character literal token.
fn (u: &Unit) strBytes(t: Tok): str {
    let s = u.src
    var b = newStrBuf()
    var i = t.p + 1
    while i < t.e - 1 {
        let c = strByte(s, i)
        if c != '\\' {
            b.addByte(c)
            i += 1
            continue
        }
        i += 1
        let d = strByte(s, i)
        if d >= '0' && d <= '7' {
            var v = 0
            var n = 0
            while n < 3 && i < t.e - 1 && strByte(s, i) >= '0' && strByte(s, i) <= '7' {
                v = v * 8 + int(strByte(s, i) - '0')
                i += 1
                n += 1
            }
            b.addByte(byte(v & 255))
            continue
        }
        if d == 'x' {
            i += 1
            var v = 0
            while i < t.e - 1 && isHex(strByte(s, i)) {
                v = v * 16 + hexVal(strByte(s, i))
                i += 1
            }
            b.addByte(byte(v & 255))
            continue
        }
        i += 1
        if d == 'n' {
            b.addByte('\n')
        } else if d == 't' {
            b.addByte('\t')
        } else if d == 'r' {
            b.addByte('\r')
        } else if d == 'a' {
            b.addByte(7)
        } else if d == 'b' {
            b.addByte(8)
        } else if d == 'f' {
            b.addByte(12)
        } else if d == 'v' {
            b.addByte(11)
        } else {
            b.addByte(d)
        }
    }
    return b.toStr()
}

fn isHex(c: byte): bool { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F') }

// An integer literal: its value (as int, two's complement) and its C type.
fn (u: mut &Unit) intLit(t: Tok): int {
    let s = u.text(t)
    var i = 0
    var v: u128 = 0
    var hex = false
    if len(s) > 2 && strByte(s, 0) == '0' && (strByte(s, 1) == 'x' || strByte(s, 1) == 'X') {
        hex = true
        i = 2
        while i < len(s) && isHex(strByte(s, i)) {
            v = v * 16 + u128(hexVal(strByte(s, i)))
            if v > 0xFFFFFFFFFFFFFFFF { u.fail("an integer literal over 64 bits") }
            i += 1
        }
    } else {
        var octal = len(s) > 1 && strByte(s, 0) == '0'
        while i < len(s) && strByte(s, i) >= '0' && strByte(s, i) <= '9' {
            v = v * (if octal { 8 } else { 10 }) + u128(strByte(s, i) - '0')
            if v > 0xFFFFFFFFFFFFFFFF { u.fail("an integer literal over 64 bits") }
            i += 1
        }
        hex = octal
    }
    var uns = false
    var longs = 0
    while i < len(s) {
        let c = strByte(s, i)
        if c == 'u' || c == 'U' {
            uns = true
        } else if c == 'l' || c == 'L' {
            longs += 1
        } else {
            u.fail("integer literal suffix in " + s)
        }
        i += 1
    }
    // C's type for the literal: the first of int, (unsigned int,) long, unsigned long that holds it
    var ty = ir.TY_I32
    if uns {
        ty = if longs == 0 && v <= 0xFFFFFFFF { ir.TY_U32 } else { ir.TY_U64 }
    } else if longs == 0 && v <= 0x7FFFFFFF {
        ty = ir.TY_I32
    } else if longs == 0 && hex && v <= 0xFFFFFFFF {
        ty = ir.TY_U32
    } else if v <= 0x7FFFFFFFFFFFFFFF {
        ty = ir.TY_I64
    } else if hex || uns {
        ty = ir.TY_U64
    } else {
        u.fail("a decimal literal over the range of long")
    }
    if longs > 0 && ty == ir.TY_I32 { ty = ir.TY_I64 }
    let iv = if v > 0x7FFFFFFFFFFFFFFF { int(i128(v) - 18446744073709551616) } else { int(v) }
    return u.mk(ir.E_INT, ty, -1, -1, -1, iv)
}

// ---------------------------------------------------------------- conversions

// Integer promotion: types narrower than int become int.
fn (u: &Unit) promotedType(t: int): int {
    let k = u.ir.tk(t)
    if k == ir.TY_BOOL || k == ir.TY_I8 || k == ir.TY_U8 || k == ir.TY_I16 || k == ir.TY_U16 { return ir.TY_I32 }
    return t
}

fn (u: mut &Unit) promote(e: int): int { return u.convert(e, u.promotedType(u.ir.nty(e))) }

fn rankOf(k: int): int {
    if k == ir.TY_I32 || k == ir.TY_U32 { return 1 }
    if k == ir.TY_I64 || k == ir.TY_U64 { return 2 }
    return 3
}

fn unsignedOf(k: int): int {
    if k == ir.TY_I32 { return ir.TY_U32 }
    if k == ir.TY_I64 { return ir.TY_U64 }
    if k == ir.TY_I128 { return ir.TY_U128 }
    return k
}

// The usual arithmetic conversions: the common type of two arithmetic types.
fn (u: &Unit) commonType(a: int, b: int): int {
    if u.ir.tk(a) == ir.TY_F64 || u.ir.tk(b) == ir.TY_F64 { return ir.TY_F64 }
    let x = u.promotedType(a)
    let y = u.promotedType(b)
    if x == y { return x }
    let sx = ir.isSignedK(x)
    let sy = ir.isSignedK(y)
    if sx == sy { return if rankOf(x) >= rankOf(y) { x } else { y } }
    let s = if sx { x } else { y }
    let us = if sx { y } else { x }
    if rankOf(us) >= rankOf(s) { return us }
    if u.ir.sizeOf(s) > u.ir.sizeOf(us) { return s }
    return unsignedOf(s)
}

// An rvalue: arrays and functions decay to pointers.
fn (u: mut &Unit) rv(e: int): int {
    let t = u.ir.nty(e)
    if u.ir.tk(t) == ir.TY_ARR { return u.mk(ir.E_DECAY, u.ir.ptrTo(u.ir.tys[t].base), e, -1, -1, 0) }
    if u.ir.tk(t) == ir.TY_FN { return u.mk(ir.E_DECAY, u.ir.ptrTo(t), e, -1, -1, 0) }
    return e
}

// e converted to t, as by assignment (or a cast: explicit allows any scalar conversion).
fn (u: mut &Unit) convert(e0: int, t: int): int {
    let e = u.rv(e0)
    let s = u.ir.nty(e)
    if s == t { return e }
    let sk = u.ir.tk(s)
    let tk = u.ir.tk(t)
    if tk == ir.TY_VOID { return u.mk(ir.E_CAST, t, e, -1, -1, 0) }
    if tk == ir.TY_STRUCT || sk == ir.TY_STRUCT {
        if tk == ir.TY_STRUCT && sk == ir.TY_STRUCT && u.ir.tys[t].sid == u.ir.tys[s].sid { return e }
        u.fail("conversion between " + u.ir.typeName(s) + " and " + u.ir.typeName(t))
    }
    if !u.ir.isScalar(s) || !u.ir.isScalar(t) { u.fail("conversion from " + u.ir.typeName(s) + " to " + u.ir.typeName(t)) }
    // a constant integer converted at once (no node)
    if u.ir.nk(e) == ir.E_INT && u.ir.isInt(t) && tk != ir.TY_I128 && tk != ir.TY_U128 {
        return u.mk(ir.E_INT, t, -1, -1, -1, ir.truncTo(tk, u.ir.nodes[e].v))
    }
    return u.mk(ir.E_CAST, t, e, -1, -1, 0)
}

// ---------------------------------------------------------------- expressions

fn (u: mut &Unit) expr(): int { return u.assignExpr() }

fn (u: &Unit) isLvalue(e: int): bool {
    let k = u.ir.nk(e)
    if k == ir.E_LOCAL || k == ir.E_GLOBAL || k == ir.E_DEREF || k == ir.E_STR || k == ir.E_CLIT || k == ir.E_FUNC { return true }
    if k == ir.E_MEMBER { return u.isLvalue(u.ir.nodes[e].a) }
    return false
}

fn (u: mut &Unit) assignExpr(): int {
    let l = u.condExpr()
    if u.accept("=") {
        if !u.isLvalue(l) { u.fail("assignment to a non-lvalue") }
        let r = u.assignExpr()
        return u.mk(ir.E_ASSIGN, u.ir.nty(l), l, u.convert(r, u.ir.nty(l)), -1, 0)
    }
    let t = u.tok()
    if t.k == K_P {
        let p = PUNCT[t.op]
        if p == "+=" || p == "-=" || p == "*=" || p == "/=" || p == "%=" || p == "&=" || p == "|=" || p == "^=" ||
            p == "<<=" || p == ">>=" {
            u.fail("compound assignment " + p)
        }
    }
    return l
}

fn (u: mut &Unit) condExpr(): int {
    let c = u.lorExpr()
    if !u.accept("?") { return c }
    let cc = u.rv(c)
    let a = u.rv(u.expr())
    u.expect(":")
    let b = u.rv(u.condExpr())
    let ta = u.ir.nty(a)
    let tb = u.ir.nty(b)
    var t = ta
    if u.ir.isArith(ta) && u.ir.isArith(tb) {
        t = u.commonType(ta, tb)
    } else if ta != tb {
        if u.ir.tk(ta) == ir.TY_PTR && u.ir.nk(b) == ir.E_INT {
            t = ta
        } else if u.ir.tk(tb) == ir.TY_PTR && u.ir.nk(a) == ir.E_INT {
            t = tb
        } else if u.ir.tk(ta) == ir.TY_PTR && u.ir.tk(tb) == ir.TY_PTR {
            t = ta
        } else {
            u.fail("?: with " + u.ir.typeName(ta) + " and " + u.ir.typeName(tb))
        }
    }
    return u.mk(ir.E_COND, t, cc, u.convert(a, t), u.convert(b, t), 0)
}

fn (u: mut &Unit) lorExpr(): int {
    var l = u.landExpr()
    while u.accept("||") {
        let r = u.landExpr()
        l = u.mk(ir.E_LOR, ir.TY_I32, u.scalar(l), u.scalar(r), -1, 0)
    }
    return l
}

fn (u: mut &Unit) landExpr(): int {
    var l = u.binLevel(0)
    while u.accept("&&") {
        let r = u.binLevel(0)
        l = u.mk(ir.E_LAND, ir.TY_I32, u.scalar(l), u.scalar(r), -1, 0)
    }
    return l
}

fn (u: mut &Unit) scalar(e: int): int {
    let r = u.rv(e)
    if !u.ir.isScalar(u.ir.nty(r)) { u.fail("a scalar is needed, not " + u.ir.typeName(u.ir.nty(r))) }
    return r
}

// The binary operators by level, lowest first: | ^ & (== !=) (< <= > >=) (<< >>) (+ -) (* / %).
const LEVELS: []str = ["|", "^", "&", "== !=", "< <= > >=", "<< >>", "+ -", "* / %"]

fn (u: &Unit) opAt(level: int): str {
    let t = u.tok()
    if t.k != K_P { return "" }
    let p = PUNCT[t.op]
    for w in split(LEVELS[level], ' ') {
        if w == p { return p }
    }
    return ""
}

fn (u: mut &Unit) binLevel(level: int): int {
    if level == len(LEVELS) { return u.castExpr() }
    var l = u.binLevel(level + 1)
    while true {
        let p = u.opAt(level)
        if p == "" { break }
        u.next()
        let r = u.binLevel(level + 1)
        l = u.binary(p, l, r)
    }
    return l
}

fn opCode(p: str): int {
    let ops: []str = ["+", "-", "*", "/", "%", "<<", ">>", "&", "|", "^", "==", "!=", "<", "<=", ">", ">="]
    for j in 0..len(ops) {
        if ops[j] == p { return j }
    }
    return -1
}

fn (u: mut &Unit) binary(p: str, l0: int, r0: int): int {
    let l = u.rv(l0)
    let r = u.rv(r0)
    let op = opCode(p)
    let lt = u.ir.nty(l)
    let rt = u.ir.nty(r)
    let lp = u.ir.tk(lt) == ir.TY_PTR
    let rp = u.ir.tk(rt) == ir.TY_PTR
    if (op == ir.OP_ADD || op == ir.OP_SUB) && lp && u.ir.isInt(rt) {
        let es = u.ir.sizeOf(u.ir.tys[lt].base)
        var idx = u.convert(r, ir.TY_I64)
        if op == ir.OP_SUB { idx = u.mk(ir.E_NEG, ir.TY_I64, idx, -1, -1, 0) }
        return u.mk(ir.E_PADD, lt, l, idx, -1, if es == 0 { 1 } else { es })
    }
    if op == ir.OP_ADD && rp && u.ir.isInt(lt) {
        let es = u.ir.sizeOf(u.ir.tys[rt].base)
        return u.mk(ir.E_PADD, rt, r, u.convert(l, ir.TY_I64), -1, if es == 0 { 1 } else { es })
    }
    if op >= ir.OP_EQ {
        if lp || rp {
            // pointers compare as unsigned 64-bit integers (a null constant on either side)
            let a = u.mk(ir.E_CAST, ir.TY_U64, l, -1, -1, 0)
            let b = u.mk(ir.E_CAST, ir.TY_U64, r, -1, -1, 0)
            return u.mk(ir.E_BIN, ir.TY_I32, a, b, ir.TY_U64, op)
        }
        if !u.ir.isArith(lt) || !u.ir.isArith(rt) { u.fail("comparison of " + u.ir.typeName(lt) + " and " + u.ir.typeName(rt)) }
        let ct = u.commonType(lt, rt)
        return u.mk(ir.E_BIN, ir.TY_I32, u.convert(l, ct), u.convert(r, ct), ct, op)
    }
    if !u.ir.isArith(lt) || !u.ir.isArith(rt) { u.fail("operator " + p + " on " + u.ir.typeName(lt) + " and " + u.ir.typeName(rt)) }
    if op == ir.OP_SHL || op == ir.OP_SHR {
        let pt = u.promotedType(lt)
        let lc = u.convert(l, pt)
        let rc = u.convert(r, u.promotedType(rt))
        if u.ir.nk(lc) == ir.E_INT && u.ir.nk(rc) == ir.E_INT && u.ir.sizeOf(pt) <= 8 {
            return u.foldBin(op, pt, u.ir.nodes[lc].v, u.ir.nodes[rc].v, lc, rc)
        }
        return u.mk(ir.E_BIN, pt, lc, rc, pt, op)
    }
    let ct = u.commonType(lt, rt)
    if u.ir.tk(ct) == ir.TY_F64 && (op == ir.OP_REM || op >= ir.OP_SHL) { u.fail("operator " + p + " on double") }
    let a = u.convert(l, ct)
    let b = u.convert(r, ct)
    if u.ir.nk(a) == ir.E_INT && u.ir.nk(b) == ir.E_INT && u.ir.sizeOf(ct) <= 8 {
        return u.foldBin(op, ct, u.ir.nodes[a].v, u.ir.nodes[b].v, a, b)
    }
    return u.mk(ir.E_BIN, ct, a, b, ct, op)
}

// A binary operation on two integer constants of type t (at most 64 bits), folded when that
// is simple; otherwise the node.
fn (u: mut &Unit) foldBin(op: int, t: int, x: int, y: int, a: int, b: int): int {
    let k = u.ir.tk(t)
    var v = 0
    if op == ir.OP_ADD {
        v = x +% y
    } else if op == ir.OP_SUB {
        v = x -% y
    } else if op == ir.OP_MUL {
        v = x *% y
    } else if op == ir.OP_AND {
        v = x & y
    } else if op == ir.OP_OR {
        v = x | y
    } else if op == ir.OP_XOR {
        v = x ^ y
    } else if op == ir.OP_SHL && y >= 0 && y < u.ir.sizeOf(t) * 8 {
        v = x << y
    } else if op == ir.OP_SHR && y >= 0 && y < u.ir.sizeOf(t) * 8 && ir.isSignedK(k) {
        v = x >> y
    } else {
        return u.mk(ir.E_BIN, t, a, b, t, op)
    }
    return u.mk(ir.E_INT, t, -1, -1, -1, ir.truncTo(k, v))
}

fn (u: mut &Unit) castExpr(): int {
    if u.isP("(") && u.startsType(1) {
        u.next()
        let t = u.parseTypeName()
        u.expect(")")
        if u.isP("{") {         // a compound literal
            var ty = t
            var ents: []int = []
            u.initializer(mut &ty, 0, mut &ents, false)
            let n = u.mk(ir.E_CLIT, ty, -1, u.ir.list(&ents), -1, 0)
            return u.postfix(n)
        }
        let e = u.castExpr()
        return u.castTo(e, t)
    }
    return u.unaryExpr()
}

fn (u: mut &Unit) castTo(e0: int, t: int): int {
    let e = u.rv(e0)
    let s = u.ir.nty(e)
    if u.ir.tk(t) == ir.TY_VOID { return u.mk(ir.E_CAST, ir.TY_VOID, e, -1, -1, 0) }
    if s == t { return e }
    if u.ir.tk(t) == ir.TY_STRUCT { u.fail("a cast to a struct") }
    if u.ir.tk(t) == ir.TY_PTR && u.ir.tk(s) == ir.TY_PTR { return u.mk(ir.E_CAST, t, e, -1, -1, 0) }
    return u.convert(e, t)
}

fn (u: mut &Unit) unaryExpr(): int {
    let t = u.tok()
    if t.k == K_P {
        let p = PUNCT[t.op]
        if p == "-" || p == "+" || p == "~" {
            u.next()
            let a = u.promote(u.scalar(u.castExpr()))
            if p == "+" { return a }
            let at = u.ir.nty(a)
            if p == "~" && !u.ir.isInt(at) { u.fail("~ on " + u.ir.typeName(at)) }
            if u.ir.nk(a) == ir.E_INT && u.ir.sizeOf(at) <= 8 {
                let v = u.ir.nodes[a].v
                return u.mk(ir.E_INT, at, -1, -1, -1, ir.truncTo(u.ir.tk(at), if p == "-" { 0 -% v } else { ~v }))
            }
            return u.mk(if p == "-" { ir.E_NEG } else { ir.E_BNOT }, at, a, -1, -1, 0)
        }
        if p == "!" {
            u.next()
            let a = u.scalar(u.castExpr())
            return u.mk(ir.E_LNOT, ir.TY_I32, a, -1, -1, 0)
        }
        if p == "*" {
            u.next()
            let a = u.rv(u.castExpr())
            let at = u.ir.nty(a)
            if u.ir.tk(at) != ir.TY_PTR { u.fail("* on " + u.ir.typeName(at)) }
            let pt = u.ir.tys[at].base
            if u.ir.tk(pt) == ir.TY_VOID { u.fail("* on void*") }
            return u.mk(ir.E_DEREF, pt, a, -1, -1, 0)
        }
        if p == "&" {
            u.next()
            let a = u.castExpr()
            if !u.isLvalue(a) { u.fail("& of a non-lvalue") }
            if u.ir.nk(a) == ir.E_DEREF { return u.ir.nodes[a].a }      // &*p is p
            return u.mk(ir.E_ADDR, u.ir.ptrTo(u.ir.nty(a)), a, -1, -1, 0)
        }
        if p == "++" || p == "--" { u.fail("prefix " + p) }
    }
    if t.k == K_ID && u.text(t) == "sizeof" {
        u.next()
        if u.isP("(") && u.startsType(1) {
            u.next()
            let ty = u.parseTypeName()
            u.expect(")")
            return u.mk(ir.E_INT, ir.TY_U64, -1, -1, -1, u.ir.sizeOf(ty))
        }
        let e = u.unaryExpr()
        return u.mk(ir.E_INT, ir.TY_U64, -1, -1, -1, u.ir.sizeOf(u.ir.nty(e)))
    }
    return u.postfix(u.primary())
}

fn (u: mut &Unit) postfix(e0: int): int {
    var e = e0
    while true {
        if u.accept("[") {
            let p = u.rv(e)
            let i = u.rv(u.expr())
            u.expect("]")
            let pt = u.ir.nty(p)
            if u.ir.tk(pt) != ir.TY_PTR || !u.ir.isInt(u.ir.nty(i)) { u.fail("indexing " + u.ir.typeName(pt)) }
            let et = u.ir.tys[pt].base
            let a = u.mk(ir.E_PADD, pt, p, u.convert(i, ir.TY_I64), -1, u.ir.sizeOf(et))
            e = u.mk(ir.E_DEREF, et, a, -1, -1, 0)
        } else if u.accept("(") {
            e = u.call(e)
        } else if u.accept(".") {
            let name = u.ident()
            let f = u.fieldOf(u.ir.nty(e), name)
            e = u.mk(ir.E_MEMBER, f.ty, e, -1, -1, f.off)
        } else if u.accept("->") {
            let p = u.rv(e)
            let pt = u.ir.nty(p)
            if u.ir.tk(pt) != ir.TY_PTR { u.fail("-> on " + u.ir.typeName(pt)) }
            let name = u.ident()
            let d = u.mk(ir.E_DEREF, u.ir.tys[pt].base, p, -1, -1, 0)
            let f = u.fieldOf(u.ir.tys[pt].base, name)
            e = u.mk(ir.E_MEMBER, f.ty, d, -1, -1, f.off)
        } else if u.isP("++") || u.isP("--") {
            let inc = u.isP("++")
            u.next()
            if !u.isLvalue(e) { u.fail("++ on a non-lvalue") }
            let t = u.ir.nty(e)
            var step = 1
            if u.ir.tk(t) == ir.TY_PTR {
                step = u.ir.sizeOf(u.ir.tys[t].base)
            } else if !u.ir.isInt(t) || u.ir.sizeOf(t) > 8 {
                u.fail("++ on " + u.ir.typeName(t))
            }
            e = u.mk(ir.E_POSTINC, t, e, -1, -1, if inc { step } else { -step })
        } else {
            return e
        }
    }
    return e
}

fn (u: mut &Unit) call(callee0: int): int {
    let callee = u.rv(callee0)
    let ct = u.ir.nty(callee)
    if u.ir.tk(ct) != ir.TY_PTR || u.ir.tk(u.ir.tys[ct].base) != ir.TY_FN { u.fail("a call of a non-function") }
    let ft = u.ir.tys[ct].base
    let pts = u.ir.fnParams(ft)
    var args: []int = []
    if !u.accept(")") {
        while true {
            let a = u.assignExpr()
            if len(args) >= len(pts) { u.fail("too many arguments") }
            append(mut &args, u.convert(a, pts[len(args)]))
            if !u.accept(",") { break }
        }
        u.expect(")")
    }
    if len(args) != len(pts) { u.fail("too few arguments") }
    return u.mk(ir.E_CALL, u.ir.tys[ft].base, callee, u.ir.list(&args), ft, 0)
}

fn (u: mut &Unit) primary(): int {
    let t = u.tok()
    if t.k == K_INT {
        u.next()
        return u.intLit(t)
    }
    if t.k == K_FLT {
        u.next()
        let s = u.text(t)
        var f: float = 0.0
        if !parseFloat(s, mut &f) { u.fail("a float literal " + s) }
        let n = u.mk(ir.E_FLT, ir.TY_F64, -1, -1, -1, 0)
        u.ir.nodes[n].f = f
        return n
    }
    if t.k == K_STR {
        var b = newStrBuf()
        while u.tok().k == K_STR {
            b.add(u.strBytes(u.tok()))
            u.next()
        }
        let s = b.toStr()
        let n = u.mk(ir.E_STR, u.ir.arrOf(ir.TY_I8, len(s) + 1), -1, -1, -1, 0)
        u.ir.nodes[n].s = s
        return n
    }
    if t.k == K_CHAR {
        u.next()
        let s = u.strBytes(t)
        if len(s) != 1 { u.fail("a character literal") }
        return u.mk(ir.E_INT, ir.TY_I32, -1, -1, -1, ir.truncTo(ir.TY_I8, int(strByte(s, 0))))
    }
    if u.accept("(") {
        let e = u.expr()
        u.expect(")")
        return e
    }
    if t.k == K_ID {
        let name = u.text(t)
        u.next()
        let l = u.scope.getOr(&name, -1)
        if l >= 0 { return u.mk(ir.E_LOCAL, u.ir.locals[l].ty, l, -1, -1, 0) }
        let g = u.globalIdx.getOr(&name, -1)
        if g >= 0 { return u.mk(ir.E_GLOBAL, u.ir.globals[g].ty, g, -1, -1, 0) }
        let f = u.funcIdx.getOr(&name, -1)
        if f >= 0 { return u.mk(ir.E_FUNC, u.ir.funcs[f].ty, f, -1, -1, 0) }
        if name == "NULL" { return u.mk(ir.E_CAST, ir.T_VOIDP, u.mk(ir.E_INT, ir.TY_I32, -1, -1, -1, 0), -1, -1, 0) }
        if name == "true" || name == "false" { return u.mk(ir.E_INT, ir.TY_I32, -1, -1, -1, if name == "true" { 1 } else { 0 }) }
        u.fail("unknown name '" + name + "'")
    }
    u.fail("unexpected '" + u.text(t) + "'")
}
