// obxc: the self-hosted obx compiler driver, as ref/obxc.py: it compiles a
// program to C and builds it with gcc (or runs it, or prints the C).
//
//     obxc file.obx [-o out] [--run] [--emit-c] [-L libroot] [-- args...]
//     obxc file.obx --native [-o out] [--run] [-- args...]   x86-64 ELF, no C compiler (design/native.md)
//     obxc file.obx --emit-c-json          {"c": C text, "cmd": gcc command} for tools/cbuild.py
//     obxc --emit-c file.obx file.obx...   the C of each program, in `== path` sections
//     obxc --dump-ast file.obx...          the tree of each file (no imports)
//     obxc --dump-types file.obx...        what sema computes for each program
//
// In the multi-file forms an error is written to stdout as `error: ...` and
// ends the run (the first error stops the compiler, as in ref).
//
// The library is $OBX_LIB, or ../lib next to the directory of the executable
// given as argv[0] (the compiler is built into obx/compiler/out/).

import "os"
import "io"
import "fs"
import "proc"
import "./syntax" as sx
import "./sema"
import "./dump"
import "./tdump"
import "./check" as ck
import "./emit"
import "./x64"
import "./ir"
import "./cgen"
import "./rt"
import "strings"
import "./x64gen"
import "./opt"
import "./loops"
import "./elf"

extern "c" fn mkdtemp(template: str): str

const USAGE = "usage: obxc file.obx [-o out] [--run] [--emit-c] [--native] [-L libroot]\n"

fn usage(): never {
    writeFd(2, USAGE)
    exit(1)
}

fn dumpFile(path: str) {
    let fname = sema.baseName(path)
    var data = ""
    if readFile(path, mut &data) != 0 { sx.failText("cannot read " + sema.absPath(path)) }
    let src = sx.sourceText(data, fname)
    let ast = sx.parse(src, fname)
    writeFd(1, dump.dumpAst(&ast))
}

fn libDir(argv0: str): str {
    let env = os.envOr("OBX_LIB", "")
    if len(env) > 0 { return sema.absPath(env) }
    return sema.absPath(sema.dirName(sema.dirName(sema.absPath(argv0))) + "/../lib")
}

fn typesFile(lib: str, path: str) {
    var pg = sema.newProgram(lib + "/std.obx", [lib], sema.baseName(path))
    pg.loadMain(path)
    pg.resolveAll()
    writeFd(1, tdump.dumpTypes(mut &pg))
}

// The IR of the program in the file at path, and the libraries its externs name.
fn compileIr(lib: str, roots: &[]str, path: str, libs: mut &[]str): ir.Ir {
    var rs: []str = []
    for r in roots { append(mut &rs, r) }
    append(mut &rs, lib)
    var pg = sema.newProgram(lib + "/std.obx", rs, sema.baseName(path))
    pg.loadMain(path)
    pg.resolveAll()
    var c = ck.newChecker(pg)
    c.checkAll()
    let m = c.pg.main
    let s = c.pg.mods[m].scope.getOr(&"main", sema.Sym{k: -1, i: -1})
    if s.k != sema.D_FN || c.pg.fns[s.i].isExtern { sx.fail(sema.baseName(path), 1, "the program has no function main") }
    var e = emit.newEmitter(c)
    return e.program(s.i, libs)
}

// The C program of the file at path: the IR printed after the C runtime.
fn compileC(lib: str, roots: &[]str, path: str, libs: mut &[]str): str {
    return cgen.print(compileIr(lib, roots, path, libs), strings.join(&rt.RT, "\n"))
}

const LIBDIRS: []str = ["/usr/lib/x86_64-linux-gnu", "/lib/x86_64-linux-gnu", "/usr/lib64", "/usr/lib", "/usr/local/lib",
    "/lib"]

// ref's lib_flags: -l<lib> when lib<lib>.so is installed, else the first versioned file, else -l<lib>.
fn libFlags(libs: &[]str): []str {
    var out: []str = []
    for l in libs {
        var have = false
        for d in LIBDIRS {
            if fs.exists(d + "/lib" + l + ".so") { have = true }
        }
        if have {
            append(mut &out, "-l" + l)
            continue
        }
        var found: []str = []
        let pre = "lib" + l + ".so."
        for d in LIBDIRS {
            match fs.listNames(d) {
                Ok(ns) {
                    for n in ns {
                        if startsWith(n, pre) { append(mut &found, d + "/" + n) }
                    }
                }
                Err(e) {}
            }
        }
        sort(mut &found)
        append(mut &out, if len(found) > 0 { found[0] } else { "-l" + l })
    }
    return out
}

// Runs a command (found in PATH, its output as ours); with errFile its standard output is
// dropped and its standard error written to that file. The exit status, or -signal as Python
// reports it; 127 when it cannot be started.
fn run(words: &[]str, errFile: str): int {
    var args: []str = []
    for i in 1..len(words) { append(mut &args, words[i]) }
    var c = proc.command(words[0], args)
    if len(errFile) > 0 {
        c.stdout = proc.Stdio.Null
        c.stderr = proc.Stdio.File(errFile)
    }
    match proc.run(&c) {
        Ok(e) { return if e.signal() != 0 { -e.signal() } else { e.code() } }
        Err(e) { return 127 }
    }
}

// The gcc command of a normal build.
fn gccCmd(exe: str, cfile: str, libs: &[]str): []str {
    // -falign-functions=64: a small recursive function's speed depends on where it falls in
    // the fetch blocks (bench fib: 15%), so a change in the runtime's size must not move it.
    var cmd: []str = ["gcc", "-O2", "-falign-functions=64", "-fno-math-errno", "-w", "-std=gnu11", "-o", exe, cfile]
    for f in libFlags(libs) { append(mut &cmd, f) }
    append(mut &cmd, "-lm")
    return cmd
}

// s as a JSON string.
fn jsonStr(s: str): str {
    var b = newStrBuf()
    b.addByte('"')
    for i in 0..len(s) {
        let x = strByte(s, i)
        match x {
            '"' { b.add("\\\"") }
            '\\' { b.add("\\\\") }
            '\n' { b.add("\\n") }
            '\t' { b.add("\\t") }
            else {
                if x < 32 || x == 127 {
                    let hex = "0123456789abcdef"
                    b.add("\\u00")
                    b.addByte(strByte(hex, int(x) / 16))
                    b.addByte(strByte(hex, int(x) % 16))
                } else {
                    b.addByte(x)
                }
            }
        }
    }
    b.addByte('"')
    return b.toStr()
}

fn build(lib: str, roots: &[]str, src: str, out: str, isRun: bool, emitc: bool, json: bool, isNative: bool, rest: &[]str): int {
    var libs: []str = []
    let p = compileIr(lib, roots, src, mut &libs)
    if isNative { return buildNative(p, &libs, src, out, isRun, rest) }
    let csrc = cgen.print(p, strings.join(&rt.RT, "\n"))
    if emitc {
        writeFd(1, csrc)
        return 0
    }
    if json {
        var b = newStrBuf()
        b.add("{\"c\": " + jsonStr(csrc) + ", \"cmd\": [")
        let cmd = gccCmd("@OUT@", "@SRC@", &libs)
        for i in 0..len(cmd) {
            if i > 0 { b.add(", ") }
            b.add(jsonStr(cmd[i]))
        }
        b.add("]}")
        writeFd(1, b.toStr())
        return 0
    }
    let tmp = mkdtemp(os.envOr("TMPDIR", "/tmp") + "/obxcXXXXXX")
    if tmp == "" { sx.failText("obxc: cannot make a temporary directory") }
    let cfile = tmp + "/prog.c"
    match io.write(cfile, csrc) {
        Ok(u) {}
        Err(e) { sx.failText("obxc: cannot write " + cfile + ": " + e.toStr()) }
    }
    let exe = if len(out) > 0 { out } else if isRun { tmp + "/prog" } else {
        if endsWith(src, ".obx") { src[0..len(src) - 4] } else { src } }
    let cmd = gccCmd(exe, cfile, &libs)
    let errf = tmp + "/gcc.err"
    if run(&cmd, errf) != 0 {
        var msg = ""
        readFile(errf, mut &msg)
        let m = if len(msg) > 4000 { msg[0..4000] } else { msg }
        writeFd(2, "obxc: internal error: the C compiler failed (C kept in " + cfile + ")\n" + m + "\n")
        return 3
    }
    fs.remove(cfile)
    fs.remove(errf)
    if !isRun {
        fs.remove(tmp)
        return 0
    }
    var words: []str = [exe]
    for a in rest { append(mut &words, a) }
    let st = run(&words, "")
    if len(out) == 0 { fs.removeAll(tmp) }
    return st
}

// The shared library files of a dynamically linked native program, in link order: those the
// externs name, found as libFlags finds them (lib<name>.so when it is an ELF file and not a
// linker script, else the first versioned lib<name>.so.N), then libm and libc.
fn libPaths(libs: &[]str): []str {
    var out: []str = []
    var names: []str = []
    for l in libs {
        if l != "m" { append(mut &names, l) }
    }
    for l in names {
        var path = ""
        for d in LIBDIRS {
            let p = d + "/lib" + l + ".so"
            if path == "" && fs.exists(p) && isElf(p) { path = p }
        }
        if path == "" {
            var found: []str = []
            let pre = "lib" + l + ".so."
            for d in LIBDIRS {
                match fs.listNames(d) {
                    Ok(ns) {
                        for n in ns {
                            if startsWith(n, pre) { append(mut &found, d + "/" + n) }
                        }
                    }
                    Err(e) {}
                }
            }
            sort(mut &found)
            if len(found) > 0 { path = found[0] }
        }
        if path == "" { sx.failText("native: cannot find the library '" + l + "' (lib" + l + ".so)") }
        append(mut &out, path)
    }
    for so in ["libm.so.6", "libc.so.6"] {
        var path = ""
        for d in LIBDIRS {
            if path == "" && fs.exists(d + "/" + so) { path = d + "/" + so }
        }
        if path == "" { sx.failText("native: cannot find " + so) }
        append(mut &out, path)
    }
    return out
}

fn isElf(path: str): bool {
    var data = ""
    if readFile(path, mut &data) != 0 { return false }
    return len(data) >= 4 && data[0..4] == "\x7fELF"
}

// The native backend: the executable written directly (no gcc; design/native.md).
fn buildNative(p: ir.Ir, libs: &[]str, src: str, out: str, isRun: bool, rest: &[]str): int {
    let names = x64gen.dynNames(&p)
    var dl: []elf.Lib = []
    if len(names) > 0 {
        var wanted: Map[str, bool] = newMap()
        for n in names { wanted.put(n, true) }
        for path in libPaths(libs) {
            var data = ""
            if readFile(path, mut &data) != 0 { sx.failText("native: cannot read " + path) }
            let l = elf.readLib(path, &data, &wanted)
            if l.err != "" { sx.failText("native: " + path + ": " + l.err) }
            append(mut &dl, l)
        }
    }
    var symMap = ""
    let q = loops.optimize(opt.optimize(p))
    let irFile = os.envOr("OBX_NATIVE_IR", "")
    if irFile != "" {
        // the IR the native backend would compile, printed as C (for reading; nothing is built)
        match io.write(irFile, cgen.print(q, "")) {
            Ok(u) {}
            Err(e) { sx.failText("obxc: cannot write " + irFile + ": " + e.toStr()) }
        }
        return 0
    }
    let img = x64gen.buildMap(q, dl, mut &symMap)
    let mapFile = os.envOr("OBX_NATIVE_MAP", "")
    if mapFile != "" {
        match io.write(mapFile, symMap) {
            Ok(u) {}
            Err(e) { sx.failText("obxc: cannot write " + mapFile + ": " + e.toStr()) }
        }
    }
    var tmp = ""
    var exe = out
    if len(exe) == 0 {
        if isRun {
            tmp = mkdtemp(os.envOr("TMPDIR", "/tmp") + "/obxcXXXXXX")
            if tmp == "" { sx.failText("obxc: cannot make a temporary directory") }
            exe = tmp + "/prog"
        } else {
            exe = if endsWith(src, ".obx") { src[0..len(src) - 4] } else { src + ".out" }
        }
    }
    fs.remove(exe)
    match io.write(exe, strFromBytes(&img)) {
        Ok(u) {}
        Err(e) { sx.failText("obxc: cannot write " + exe + ": " + e.toStr()) }
    }
    fs.chmod(exe, 493)
    if !isRun { return 0 }
    var words: []str = [exe]
    for a in rest { append(mut &words, a) }
    let st = run(&words, "")
    if len(tmp) > 0 { fs.removeAll(tmp) }
    return st
}

fn main() {
    let argv = args()
    if len(argv) == 3 && argv[1] == "--encode-test" {      // the x86-64 encoder test (tools/x64_encode_test.py)
        var text = ""
        if readFile(argv[2], mut &text) != 0 { sx.failText("cannot read " + argv[2]) }
        writeFd(1, x64.runTest(text))
        return
    }
    if len(argv) >= 3 && (argv[1] == "--dump-ast" || argv[1] == "--dump-types" || argv[1] == "--emit-c") {
        let types = argv[1] == "--dump-types"
        let emitc = argv[1] == "--emit-c"
        let lib = if types || emitc { libDir(argv[0]) } else { "" }
        let multi = len(argv) > 3
        sx.errorsToStdout(multi)
        for i in 2..len(argv) {
            if multi { writeFd(1, "== " + argv[i] + "\n") }
            if emitc {
                var libs: []str = []
                writeFd(1, compileC(lib, &[], argv[i], mut &libs))
            } else if types {
                typesFile(lib, argv[i])
            } else {
                dumpFile(argv[i])
            }
        }
        return
    }
    var out = ""
    var isRun = false
    var emitc = false
    var json = false
    var isNative = false
    var roots: []str = []
    var src = ""
    var rest: []str = []
    var i = 1
    while i < len(argv) {
        let a = argv[i]
        if a == "--" {
            for j in i + 1..len(argv) { append(mut &rest, argv[j]) }
            break
        }
        if a == "-o" {
            i += 1
            if i >= len(argv) { usage() }
            out = argv[i]
        } else if a == "--run" {
            isRun = true
        } else if a == "--emit-c" {
            emitc = true
        } else if a == "--emit-c-json" {
            json = true
        } else if a == "--native" {
            isNative = true
        } else if a == "-L" {
            i += 1
            if i >= len(argv) { usage() }
            append(mut &roots, sema.absPath(argv[i]))
        } else if startsWith(a, "-L") {
            append(mut &roots, sema.absPath(a[2..len(a)]))
        } else if src == "" {
            src = a
        } else {
            usage()
        }
        i += 1
    }
    if src == "" { usage() }
    exit(build(libDir(argv[0]), &roots, src, out, isRun, emitc, json, isNative, &rest))
}
