// obxc: the self-hosted obx compiler driver. For now (stage 4, step 1) it
// only parses: --dump-ast prints the tree of each file given, as
// `python3 ref/obxc.py --dump-ast` does.
//
//     obxc --dump-ast file.obx...

import "os"
import "./syntax" as sx
import "./dump"

fn usage(): never {
    writeFd(2, "usage: obxc --dump-ast file.obx...\n")
    exit(2)
}

// The last component of a path.
fn baseName(path: str): str {
    var i = len(path)
    while i > 0 && strByte(path, i - 1) != '/' { i -= 1 }
    return path[i..]
}

// Python's os.path.abspath: joined with the working directory, normalized.
fn absPath(path: str): str {
    var p = path
    if len(p) == 0 || strByte(p, 0) != '/' { p = os.cwd() + "/" + p }
    var parts: []str = []
    for part in split(p, '/') {
        if len(part) == 0 || part == "." { continue }
        if part == ".." {
            if len(parts) > 0 { pop(mut &parts) }
            continue
        }
        append(mut &parts, part)
    }
    var b = newStrBuf()
    for part in parts {
        b.addByte('/')
        b.add(part)
    }
    if len(parts) == 0 { return "/" }
    return b.toStr()
}

fn dumpFile(path: str) {
    let fname = baseName(path)
    var data = ""
    if readFile(path, mut &data) != 0 { sx.failText("cannot read " + absPath(path)) }
    let src = sx.sourceText(data, fname)
    let ast = sx.parse(src, fname)
    writeFd(1, dump.dumpAst(&ast))
}

fn main() {
    let argv = args()
    if len(argv) < 3 || argv[1] != "--dump-ast" { usage() }
    let multi = len(argv) > 3
    sx.errorsToStdout(multi)
    for i in 2..len(argv) {
        if multi { writeFd(1, "== " + argv[i] + "\n") }
        dumpFile(argv[i])
    }
}
