// tdump: --dump-types, what sema computes before bodies are checked. The same
// text as ref/dump.py's dump_types (the format is in ref/README.md, "Types dump").

import "./syntax" as sx
import "./sema"
import "./num"

type TDumper = record {
    b: StrBuf
    tpn: Map[int, int]     // a TParam -> its number, in the order the dump meets them
}

const FORMS: []str = ["record", "closed", "interface", "alias"]

fn join(xs: &[]str, sep: str): str {
    var b = newStrBuf()
    for i in 0..len(xs) {
        if i > 0 { b.add(sep) }
        b.add(xs[i])
    }
    return b.toStr()
}

fn flag(x: bool): str { return if x { "true" } else { "false" } }

fn opt(s: str): str { return if len(s) == 0 { "-" } else { s } }

// ref's q: a quoted string, printable ASCII as is except \ and ", other bytes as \xHH.
fn quote(s: str): str {
    var b = newStrBuf()
    b.addByte('"')
    let digits = "0123456789abcdef"
    for i in 0..len(s) {
        let c = strByte(s, i)
        if c == '\\' {
            b.add("\\\\")
        } else if c == '"' {
            b.add("\\\"")
        } else if c >= 32 && c < 127 {
            b.addByte(c)
        } else {
            b.add("\\x")
            b.addByte(strByte(digits, int(c >> 4)))
            b.addByte(strByte(digits, int(c & 15)))
        }
    }
    b.addByte('"')
    return b.toStr()
}

fn (d: mut &TDumper) tp(pg: &sema.Program, p: int): str {
    var n = d.tpn.getOr(&p, 0)
    if n == 0 {
        n = d.tpn.size() + 1
        d.tpn.put(p, n)
    }
    return pg.tparams[p].name + "#" + intToStr(n)
}

fn (d: mut &TDumper) list(pg: &sema.Program, ts: &[]int): str {
    var b = newStrBuf()
    for i in 0..len(ts) {
        if i > 0 { b.add(", ") }
        b.add(d.ts(pg, ts[i]))
    }
    return b.toStr()
}

fn (d: mut &TDumper) ts(pg: &sema.Program, t: int): str {
    let k = pg.tk(t)
    match k {
        sema.TK_PRIM { return sema.PRIM_NAMES[t] }
        sema.TK_ARR { return "[]" + d.ts(pg, pg.ta(t)) }
        sema.TK_REF { return (if pg.tm(t) { "mut &" } else { "&" }) + d.ts(pg, pg.ta(t)) }
        sema.TK_SLICE { return (if pg.tm(t) { "mut &[" } else { "&[" }) + d.ts(pg, pg.ta(t)) + "]" }
        sema.TK_TP { return d.tp(pg, pg.ta(t)) }
        sema.TK_SELF { return "Self" }
        else {}
    }
    let args = pg.targs(t)
    if k == sema.TK_FN || k == sema.TK_CLO {
        let s = (if k == sema.TK_CLO { "&fn(" } else { "fn(" }) + d.list(pg, &args) + ")"
        return if pg.tb(t) != sema.T_VOID { s + ": " + d.ts(pg, pg.tb(t)) } else { s }
    }
    if len(args) == 0 { return pg.types[pg.ta(t)].cname }
    return pg.types[pg.ta(t)].cname + "[" + d.list(pg, &args) + "]"
}

fn (d: mut &TDumper) line(s: str) {
    d.b.add(s)
    d.b.addByte('\n')
}

fn (d: mut &TDumper) tparam(pg: &sema.Program, ind: str, p: int) {
    let name = d.tp(pg, p)
    let cons = d.list(pg, &pg.tparams[p].cons)
    d.line(ind + "tparam " + name + " copy=" + flag(pg.tparams[p].copy) + " cons=[" + cons + "]")
}

// ref's val: a folded constant value.
fn (d: mut &TDumper) value(pg: &sema.Program, v: sema.CVal): str {
    if v.kind == sema.CK_TABLE { return "table " + d.ts(pg, v.ty) }
    let k = if v.kind != sema.CK_TYPED { v.kind } else if v.ty == sema.T_FLOAT { sema.CK_FLOAT }
        else if v.ty == sema.T_STR { sema.CK_STR } else if v.ty == sema.T_BOOL { sema.CK_BOOL } else { sema.CK_INT }
    let s = match k {
        sema.CK_FLOAT { num.pyFloatRepr(v.f) } sema.CK_FRAC { v.s } sema.CK_STR { quote(v.s) }
        sema.CK_BOOL { flag(v.b) } else { num.bigStr(v.i) }
    }
    let ty = if v.ty >= 0 { d.ts(pg, v.ty) } else { "-" }
    return sema.CK_NAMES[v.kind] + " " + ty + " " + s
}

fn (d: mut &TDumper) typeDecl(pg: mut &sema.Program, t: int) {
    var cp = "-"
    var drop = "-"
    let form = pg.types[t].form
    if form == sx.F_RECORD || form == sx.F_CLOSED {
        var args: []int = []
        for i in 0..len(pg.types[t].tparams) { append(mut &args, pg.mkTp(pg.types[t].tparams[i])) }
        cp = flag(pg.isCopy(pg.mkInst(t, &args)))
        if pg.types[t].drop >= 0 { drop = pg.label(pg.types[t].drop) }
    }
    d.typeBody(pg, t, cp, drop)
}

fn (d: mut &TDumper) typeBody(pg: &sema.Program, t: int, cp: str, drop: str) {
    let td = &pg.types[t]
    d.line("  type " + td.name + " " + intToStr(td.line) + " pub=" + flag(td.isPub) + " form=" +
        FORMS[td.form] + " value=" + flag(td.value) + " cname=" + td.cname + " copy=" + cp + " drop=" + drop)
    for p in td.tparams { d.tparam(pg, "    ", p) }
    for f in td.fields { d.line("    field " + f.name + " pub=" + flag(f.isPub) + " " + d.ts(pg, f.ty)) }
    for v in td.variants {
        let vr = &pg.variants[v]
        d.line("    variant " + intToStr(vr.index) + " " + vr.name + " " + intToStr(vr.line) + " named=" +
            flag(vr.named))
        for f in vr.fields { d.line("      field " + f.name + " " + d.ts(pg, f.ty)) }
    }
    for mb in td.members {
        let mode = if mb.mode != sx.M_NONE { sema.RM_NAMES[mb.mode] } else { "-" }
        d.line("    member " + mb.name + " " + intToStr(mb.line) + " mode=" + mode + " params=[" +
            d.list(pg, &mb.params) + "] ret=" + d.ts(pg, mb.ret))
    }
    if td.form == sx.F_ALIAS { d.line("    target " + d.ts(pg, td.target)) }
    if len(td.methodNames) > 0 { d.line("    methods " + join(&td.methodNames, " ")) }
}

fn (d: mut &TDumper) fnDecl(pg: &sema.Program, f: int) {
    let fd = &pg.fns[f]
    let ext = if fd.isExtern { quote(fd.lib) } else { "-" }
    let cname = if fd.isExtern { quote(fd.cname) } else { "-" }
    let rt = if fd.recvType >= 0 { d.ts(pg, fd.recvType) } else { "-" }
    d.line("  fn " + pg.label(f) + " " + intToStr(fd.line) + " pub=" + flag(fd.isPub) + " extern=" + ext + " cname=" +
        cname + " recv=" + sema.RM_NAMES[fd.recvMode] + " recvname=" + opt(fd.recvName) + " recvtype=" + rt)
    for p in fd.tps { d.tparam(pg, "    ", p) }
    for p in fd.params {
        d.line("    param " + p.name + " " + intToStr(p.line) + " var=" + flag(p.isVar) + " " + d.ts(pg, p.ty))
    }
    d.line("    ret " + d.ts(pg, fd.ret) + " bparam=" + opt(fd.bparam))
}

fn (d: mut &TDumper) header(pg: &sema.Program, m: int) {
    let md = &pg.mods[m]
    d.line("module " + md.name + " file=" + sema.baseName(md.path) + " cprefix=" + md.cprefix + " std=" +
        flag(md.isStd))
    for i in 0..len(md.importNames) {
        d.line("  import " + md.importNames[i] + " " + pg.mods[md.importMods[i]].cprefix)
    }
    var sc = newStrBuf()
    sc.add("  scope")
    for n in md.scopeNames {
        sc.addByte(' ')
        sc.add(n)
    }
    d.line(sc.toStr())
}

fn (d: mut &TDumper) constDecl(pg: &sema.Program, i: int) {
    let c = &pg.consts[i]
    d.line("  const " + c.name + " " + intToStr(c.line) + " pub=" + flag(c.isPub) + " cname=" + c.cname + " " +
        d.value(pg, c.value))
}

fn (d: mut &TDumper) globalDecl(pg: &sema.Program, i: int) {
    let g = &pg.globals[i]
    d.line("  global " + g.name + " " + intToStr(g.line) + " pub=" + flag(g.isPub) + " once=" + flag(g.isOnce) +
        " cname=" + g.cname + " type=" + d.ts(pg, g.ty))
}

pub fn dumpTypes(pg: mut &sema.Program): str {
    var d = TDumper{b: newStrBuf(), tpn: newMap()}
    for m in 0..len(pg.mods) {
        d.header(pg, m)
        for k in 0..len(pg.mods[m].scopeNames) {
            let s = pg.scopeGet(m, pg.mods[m].scopeNames[k])
            match s.k {
                sema.D_TYPE { d.typeDecl(pg, s.i) } sema.D_CONST { d.constDecl(pg, s.i) }
                sema.D_GLOBAL { d.globalDecl(pg, s.i) } else {}
            }
        }
        for k in 0..len(pg.mods[m].fns) { d.fnDecl(pg, pg.mods[m].fns[k]) }
    }
    for p in 0..sema.NPRIMS {
        if len(pg.primMethodNames[p]) > 0 {
            d.line("prim " + sema.PRIM_NAMES[p] + " methods " + join(&pg.primMethodNames[p], " "))
        }
    }
    for n in pg.preludeNames {
        let v = pg.prelude.getOr(&n, -1)
        d.line("prelude " + n + " " + pg.types[pg.variants[v].decl].cname + "." + pg.variants[v].name)
    }
    for c in pg.externNames {
        let f = pg.externs.getOr(&c, -1)
        d.line("extern " + c + " " + pg.mods[pg.fns[f].mod].cprefix + "." + pg.fns[f].name)
    }
    return d.b.toStr()
}
