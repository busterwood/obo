    "int32_t rt_add_i32(int32_t a, int32_t b, const char* w);",
    "int32_t rt_sub_i32(int32_t a, int32_t b, const char* w);",
    "int32_t rt_mul_i32(int32_t a, int32_t b, const char* w);",
    "int32_t rt_wadd_i32(int32_t a, int32_t b);",
