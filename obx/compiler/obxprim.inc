/* obxprim.inc: the libm functions that are single instructions (generated by gen_obxmath.py;
   do not edit). In rt.h and native/rt.c; obxmath.inc uses them. Needs SSE4.1 and FMA3. */
#include <stdint.h>
#define OBXP static __attribute__((unused))
/* the instructions */
OBXP inline double obx_sqrt(double x) { double r; __asm__("sqrtsd %1, %0" : "=x"(r) : "x"(x)); return r; }
OBXP inline double obx_floor(double x) { double r; __asm__("roundsd $9, %1, %0" : "=x"(r) : "x"(x)); return r; }
OBXP inline double obx_ceil(double x) { double r; __asm__("roundsd $10, %1, %0" : "=x"(r) : "x"(x)); return r; }
OBXP inline double obx_trunc(double x) { double r; __asm__("roundsd $11, %1, %0" : "=x"(r) : "x"(x)); return r; }
OBXP inline double obx_rint(double x) { double r; __asm__("roundsd $12, %1, %0" : "=x"(r) : "x"(x)); return r; }
OBXP inline double obx_fma(double a, double b, double c) { __asm__("vfmadd213sd %2, %1, %0" : "+x"(a) : "x"(b), "x"(c)); return a; }
OBXP inline double obx_fabs(double x) { union { double d; uint64_t u; } v; v.d = x; v.u &= ~(1ULL << 63); return v.d; }
OBXP inline double obx_copysign(double x, double y) {
    union { double d; uint64_t u; } a, b;
    a.d = x; b.d = y;
    a.u = (a.u & ~(1ULL << 63)) | (b.u & (1ULL << 63));
    return a.d;
}
/* half away from zero: trunc(x + copysign(0.49999999999999994, x)) */
OBXP inline double obx_round(double x) { return obx_trunc(x + obx_copysign(0.49999999999999994, x)); }
