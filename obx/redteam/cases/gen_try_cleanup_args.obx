// expect: 1
// expect: err
type D = record { v: int }
fn (d: mut &D) drop() { println(d.v) }
fn bad(): Result[int, str] { return Err("err") }
fn use(a: D, n: int, b: D) {}
fn f(): Result[int, str] {
    let a = D{v: 1}
    use(a, try bad(), D{v: 2})
    return Ok(0)
}
fn main() {
    match f() { Ok(n) {} Err(e) { println(e) } }
}
