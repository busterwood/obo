// expect: c
type L[T] = closed { Nil; Cons(T, L[T]) }
fn last[T](l: L[T], d: T): T {
    match move(l) {
        L.Nil { return d }
        L.Cons(x, rest) {
            var done = false
            match rest {
                L.Nil { done = true }
                else {}
            }
            if done { return x }
            return last(rest, d)
        }
    }
}
fn main() {
    let l = L.Cons("a" + "", L.Cons("b" + "", L.Cons("c" + "", L.Nil)))
    println(last(l, "z"))
}
