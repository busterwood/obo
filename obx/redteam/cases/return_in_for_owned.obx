// expect: 1
// expect: 3
// expect: 1
type D = record { v: int }
fn (d: mut &D) drop() { println(d.v) }
fn find(xs: []D): int {
    for x in xs {
        if x.v == 1 { return x.v }
    }
    return 0
}
fn main() {
    var xs: []D = []
    append(mut &xs, D{v: 1})
    append(mut &xs, D{v: 3})
    let n = find(move(xs))
    println(n)
}
