// expect: 2
type L = closed { Nil; Cons(int, L) }
type W = value closed { Has(L); Empty }
fn len2(l: &L): int {
    match l { L.Nil { return 0 } L.Cons(_, r) { return 1 + len2(r) } }
}
fn main() {
    let w = W.Has(L.Cons(1, L.Cons(2, L.Nil)))
    match w { W.Has(l) { println(len2(l)) } W.Empty {} }
}
