// A drop method cannot be called directly (5.3), also not through a constraint.
// error: drop
type Dropper = interface { fn (mut &Self) drop() }
type D = record { v: int }
fn (d: mut &D) drop() { println(d.v) }
fn kill[T: Dropper](x: mut &T) { x.drop() }
fn main() {
    var d = D{v: 1}
    kill(mut &d)
}
