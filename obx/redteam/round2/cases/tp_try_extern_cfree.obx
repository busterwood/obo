// expect: 2
// expect: err
extern "c" fn strlen(s: str): u64
fn get(n: int): Result[int, str] { if n < 0 { return Err("neg") }; return Ok(n) }
fn two(a: u64, b: int): u64 { return a }
fn f(n: int): Result[u64, str] {
    let s = "abcd" + ""
    return Ok(two(strlen(s[1..3]), try get(n)))
}
fn main() {
    match f(1) { Ok(v) { println(v.toStr()) } Err(e) { println("err") } }
    match f(-1) { Ok(v) { println(v.toStr()) } Err(e) { println("err") } }
}
