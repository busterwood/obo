// expect: 3
// expect: err
fn get(n: int): Result[int, str] { if n < 0 { return Err("neg") }; return Ok(n) }
fn acc(n: int): Result[int, str] {
    var xs: []str = ["a" + "", "b" + ""]
    var t = 1
    t += try get(n)
    xs[0] += "q"
    return Ok(t)
}
fn main() {
    match acc(2) { Ok(v) { println(v.toStr()) } Err(e) { println("err") } }
    match acc(-1) { Ok(v) { println(v.toStr()) } Err(e) { println("err") } }
}
