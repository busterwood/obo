// expect: a b c
import "collections"
fn main() {
    var h: collections.Heap[str] = collections.newHeap()
    h.push("c" + "")
    h.push("a" + "")
    h.push("b")
    var out = ""
    while !h.isEmpty() {
        match h.pop() { Some(x) { out = out + x + " " } None {} }
    }
    println(out[0..len(out) - 1])
}
