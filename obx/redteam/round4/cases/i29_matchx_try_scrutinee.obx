// expect: one
// expect: err
fn p(s: str): Result[int, str] { return if s == "1" { Ok(1) } else { Err(s) } }
fn g(s: str): Result[str, str] { return Ok(match try p(s) { 1 { "one" } else { "other" } }) }
fn main() {
    match g("1") { Ok(n) { println(n) } Err(e) { println("err") } }
    match g("x") { Ok(n) { println(n) } Err(e) { println("err") } }
}
