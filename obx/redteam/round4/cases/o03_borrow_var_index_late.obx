// q is a borrow variable of an array; q[0] is a place of a local with an index
// expect: 2
type B = record { v: []int }
fn (b: mut &B) push(k: int) { append(mut &b.v, k) }
fn g(xs: mut &[]B): int { append(mut &xs, B{v: []}); return 1 }
fn main() {
    var xs = [B{v: [0]}]
    {
        let q = mut &xs
        q[0].push(g(q))
    }
    println(len(xs[0].v))
}
