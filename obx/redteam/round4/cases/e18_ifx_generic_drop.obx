// SPEC 9.1 (lang batch): as e17; the path that keeps a drops it
// expect: drop a
// expect: b
// expect: drop b
type D = record { s: str }
fn (d: mut &D) drop() { println("drop " + d.s) }
fn pick[T](c: bool, a: T, b: T): T { return if c { a } else { b } }
fn main() {
    let d = pick(false, D{s: "a"}, D{s: "b"})
    println(d.s)
}
