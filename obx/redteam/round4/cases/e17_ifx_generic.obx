// SPEC 9.1 (lang batch): moved on one path only; the other path drops it (was an error)
// expect: b
// expect: 2
fn pick[T](c: bool, a: T, b: T): T { return if c { a } else { b } }
type D = record { s: str }
fn main() {
    let d = pick(false, D{s: "a"}, D{s: "b"})
    println(d.s)
    println(pick(false, 1, 2))
}
