// a == b means a.eq(&b): a borrowed; the call form a.eq(&f(mut &a)) would take a at the call
// expect: true
type D = value record { u: int }
fn (a: &D) eq(b: &D): bool { return a.u == b.u }
fn bump(d: mut &D): D { d.u += 10; return D{u: 11} }
fn main() {
    var a = D{u: 1}
    println(a.eq(&bump(mut &a)))
}
