// SPEC 7.5: "The index expressions in p still run in their position, left to
// right; when the call is made the place is found again and its indexes are
// checked again (exit 3)." The index 5 is out of range in its position, so the
// program stops there, before g runs. The reference compiler only checks the
// index in the C call expression, after g has run (and printed).
// Same for &xs[5], a receiver bs[3].add(g()), append(mut &rs[3].v, g()) and
// replace(mut &xs[2], g()) (see cases/a01..a14).
// exit: 3
fn g(): int { println("g ran"); return 1 }
fn f(x: mut &int, y: int) { x += y }
fn main() {
    var xs = [1, 2]
    f(mut &xs[5], g())
    println("not reached")
}
