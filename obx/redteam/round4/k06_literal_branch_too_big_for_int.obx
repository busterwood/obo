// SPEC 7.8: "an integer literal branch takes the type of the others", as a
// literal operand takes the other operand's type (u + 18446744073709551615
// type-checks). Both expressions below are u64. The literal branch is first
// checked with no expected type, as an int, and is rejected there ("integer
// literal 18446744073709551615 does not fit int") before x_ifx would re-check
// it with the else branch's type; x_matchx (body) does the same for an arm.
// expect: 18446744073709551615
// expect: 18446744073709551615
fn main() {
    let u: u64 = 5
    let c = true
    let k = 1
    let y = if c { 18446744073709551615 } else { u }
    println(y)
    let z = match k { 1 { 18446744073709551615 } else { u } }
    println(z)
}
