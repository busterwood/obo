// The units 2^127 do not fit an i128, so this is a compile error (spec 7.3).
// error: too many digits
type Fx = value record { u: i128; s: int }
fn (Fx) fromFraction(u: i128, s: int): Fx { return Fx{u: u, s: s} }
fn (a: Fx) neg(): Fx { return Fx{u: -a.u, s: a.s} }
fn main() {
    let x: Fx = -17014118346046923173168730371588410572.8m
    println("ok")
}
