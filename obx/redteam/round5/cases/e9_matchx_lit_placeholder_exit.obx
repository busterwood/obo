// a match expression whose literal arm is written later, and an exit arm; moves too
// expect: drop 1
// expect: 5
// expect: take 1
// expect: drop 1
// expect: 0
// expect: drop 1
// expect: -1
type D = record { v: int }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn take(d: D): int {
    println("take " + intToStr(d.v))
    return 0
}
fn f(k: int): int {
    let x = D{v: 1}
    let n = match k {
        1 { 5 }
        2 { take(x) }
        else { return -1 }
    }
    return n
}
fn main() {
    println(f(1))
    println(f(2))
    println(f(3))
}
