// compound assignment to a field of x from an if expression that moves x on one path
// error: moved
type D = record { v: int }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn take(d: D): int { return 0 }
fn main() {
    let c = true
    var x = D{v: 1}
    x.v += if c { take(x) } else { 5 }
}
