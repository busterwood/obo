// break as an exit arm after an earlier argument moved a variable declared outside the loop:
// after the loop, x is moved on the break path only.
// error: moved
type D = record { v: int }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn pair(a: D, b: int): int { return a.v + b }
fn main() {
    var x = D{v: 1}
    var i = 0
    while i < 3 {
        i += 1
        let n = pair(move(x), if i == 2 { break } else { 1 })
        x = D{v: 10 + i}
        println(n)
    }
    println(x.v)
}
