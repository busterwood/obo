// len of x's array on the left, the right moves x on one path
// expect: take 1
// expect: drop 1
// expect: 2
// expect: drop 1
// expect: 7
type D = record { v: int; ys: []int }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn take(d: D): int {
    println("take " + intToStr(d.v))
    return 0
}
fn f(c: bool) {
    let x = D{v: 1, ys: [10, 20]}
    println(len(x.ys) + (if c { take(x) } else { 5 }))
}
fn main() {
    f(true)
    f(false)
}
