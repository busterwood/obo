// a str field of x as a receiver, and the argument moves x on one path
// expect: take 1
// expect: drop 1
// expect: 1
// expect: drop 1
// expect: 0
type D = record { v: int; name: str }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn take(d: D): int {
    println("take " + intToStr(d.v))
    return 0
}
fn f(c: bool) {
    let x = D{v: 1, name: "ab" + "c"}
    println(x.name.cmp(&(if c { "" + intToStr(take(x)) } else { "abc" })))
}
fn main() {
    f(true)
    f(false)
}
