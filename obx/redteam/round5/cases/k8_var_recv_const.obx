// a var by-value receiver on a constant: a copy is changed, the constant is not
// expect: 11
// expect: 1
type Pair = value record { a: int; b: int }
const P: Pair = Pair{a: 1, b: 2}
fn (var p: Pair) bumped(): int {
    p.a += 10
    return p.a
}
fn main() {
    println(P.bumped())
    println(P.a)
}
