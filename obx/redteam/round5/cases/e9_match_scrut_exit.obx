// an exit arm in the scrutinee of a match statement
// expect: mk 1
// expect: drop 1
// expect: ret
// expect: mk 1
// expect: a 1
// expect: drop 1
type D = record { v: int }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn mk(v: int): D {
    println("mk " + intToStr(v))
    return D{v: v}
}
type E = closed { A(D); B }
fn f(c: bool) {
    let d = mk(1)
    match (if c { return } else { E.A(d) }) {
        E.A(x) { println("a " + intToStr(x.v)) }
        E.B { println("b") }
    }
}
fn main() {
    f(true)
    println("ret")
    f(false)
}
