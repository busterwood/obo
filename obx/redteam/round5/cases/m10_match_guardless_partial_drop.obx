// a match expression moving x in one arm, borrowing it in another: dropped on the others at
// the join, before the statement's later effects
// expect: drop 1
// expect: a 1
// expect: after
// expect: drop 2
// expect: b 2
// expect: after
type D = record { v: int }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn take(d: D): int { return d.v }
fn rd(d: &D): int { return d.v }
fn f(k: int) {
    let x = D{v: k}
    let n = match k { 1 { rd(&x) } else { take(x) } }
    if k == 1 { println("a " + intToStr(n)) } else { println("b " + intToStr(n)) }
    println("after")
}
fn main() {
    f(1)
    f(2)
}
