// the kept variable is dropped after the path's own locals (and its temporaries)
// expect: inner
// expect: drop 50
// expect: drop 1
// expect: after
type D = record { v: int }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn take(d: D): int { return 0 }
fn main() {
    let c = false
    let x = D{v: 1}
    if c {
        take(x)
    } else {
        let z = D{v: 50}
        println("inner")
    }
    println("after")
}
