// an array literal: an earlier item reads x, a later one moves x on one path (in a match)
// expect: take 1
// expect: drop 1
// expect: 1 0
// expect: drop 1
// expect: 1 4
type D = record { v: int; name: str }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
type E = closed { A; B }
fn take(d: D): int {
    println("take " + intToStr(d.v))
    return 0
}
fn f(e: E) {
    let x = D{v: 1, name: "ab" + "c"}
    let r = [x.v, match e { E.A { take(x) } E.B { 4 } }]
    println(intToStr(r[0]) + " " + intToStr(r[1]))
}
fn main() {
    f(E.A)
    f(E.B)
}
