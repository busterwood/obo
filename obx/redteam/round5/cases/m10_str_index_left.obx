// s[i] of x's str on the left, the right moves x on one path
// expect: take 1
// expect: drop 1
// expect: 97
// expect: drop 1
// expect: 102
type D = record { v: int; name: str }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn take(d: D): int {
    println("take " + intToStr(d.v))
    return 0
}
fn f(c: bool) {
    let x = D{v: 1, name: "a" + "bc"}
    println(int(x.name[0]) + (if c { take(x) } else { 5 }))
}
fn main() {
    f(true)
    f(false)
}
