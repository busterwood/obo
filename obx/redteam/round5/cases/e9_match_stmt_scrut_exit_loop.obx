// break in a consumed match scrutinee inside a loop
// expect: a 10
// expect: drop 10
// expect: b
// expect: end
type D = record { v: int }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
type E = closed { A(D); B }
fn main() {
    for i in 0..5 {
        match (if i == 2 { break } else if i == 0 { E.A(D{v: 10}) } else { E.B }) {
            E.A(d) { println("a " + intToStr(d.v)) }
            E.B { println("b") }
        }
    }
    println("end")
}
