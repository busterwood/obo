// as above, but the argument names x without move(): the implicit move happens at the call,
// so on the break path x still has its value.
// expect: drop 1
// expect: 2
// expect: 11
// expect: drop 11
type D = record { v: int }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn pair(a: D, b: int): int { return a.v + b }
fn main() {
    var x = D{v: 1}
    var i = 0
    while true {
        i += 1
        let n = pair(x, if i == 2 { break } else { 1 })
        x = D{v: 10 + i}
        println(n)
    }
    println(x.v)
}
