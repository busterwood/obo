// declared outside a loop, moved on one path of an if inside it: the next iteration uses it
// error: moved
type D = record { v: int }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn take(d: D): int { return 0 }
fn main() {
    let x = D{v: 1}
    for i in 0..3 {
        if i == 1 { take(x) }
    }
}
