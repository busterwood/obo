// exit arms in a generic function with owned and copy instances
// expect: drop 9
// expect: drop 1
// expect: none
// expect: drop 3
// expect: 2
// expect: drop 2
// expect: none
// expect: 7
type D = record { v: int }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn second[T](a: T, b: T, c: bool): Option[T] {
    var xs = [a, if c { return None } else { b }]
    return Some(pop(mut &xs))
}
fn main() {
    match second(D{v: 1}, D{v: 9}, true) { Some(d) { println(d.v) } None { println("none") } }
    match second(D{v: 3}, D{v: 2}, false) { Some(d) { println(d.v) } None { println("none") } }
    match second(5, 6, true) { Some(d) { println(d) } None { println("none") } }
    println(second(6, 7, false).unwrapOr(0))
}
