// a match expression arm's value is a str field of x borrowed by the arm, x dropped by that arm
// expect: drop 2
// expect: n2
// expect: take 1
// expect: drop 1
// expect: t
type D = record { v: int; name: str }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
type E = closed { A; B }
fn take(d: D): str {
    println("take " + intToStr(d.v))
    return "t"
}
fn f(e: E, k: int): str {
    let x = D{v: k, name: "n" + intToStr(k)}
    return match e {
        E.A { take(x) }
        E.B { x.name }
    }
}
fn main() {
    println(f(E.B, 2))
    println(f(E.A, 1))
}
