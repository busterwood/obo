// continue in the middle of a record literal, temporaries before it dropped once per iteration
// expect: mk 0
// expect: drop 0
// expect: mk 1
// expect: mk 101
// expect: r 1 101
// expect: drop 101
// expect: drop 1
// expect: mk 2
// expect: drop 2
type D = record { v: int }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn mk(v: int): D {
    println("mk " + intToStr(v))
    return D{v: v}
}
type R = record { a: D; b: D }
fn main() {
    for i in 0..3 {
        let r = R{a: mk(i), b: if i != 1 { continue } else { mk(100 + i) }}
        println("r " + intToStr(r.a.v) + " " + intToStr(r.b.v))
    }
}
