// moved then break on one path of an infinite loop, kept on the other break
// error: moved
type D = record { v: int }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn take(d: D): int { return 0 }
fn main() {
    let x = D{v: 1}
    var i = 0
    while true {
        i += 1
        if i == 1 { take(x); break }
        if i == 2 { break }
    }
}
