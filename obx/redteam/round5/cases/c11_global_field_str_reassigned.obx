// the key is a str field of a global record; the callback replaces the record
// expect: found
// expect: 2
extern "c" fn bsearch(key: str, base: ptr, n: int, size: int, cmp: extern fn(ptr, ptr): i32): ptr
extern "c" fn obxlib_alloc(n: int): ptr
extern "c" fn obxlib_free(p: ptr)
extern "c" fn obxlib_peek(p: ptr, i: int): int
extern "c" fn obxlib_poke(p: ptr, i: int, v: int)
type Cfg = value record { key: str; n: int }
var G: Cfg = Cfg{key: "", n: 0}
fn cmp(a: ptr, b: ptr): i32 {
    G = Cfg{key: "q" + intToStr(G.n), n: G.n + 1}
    let x = obxlib_peek(a, 0)
    let y = obxlib_peek(b, 0)
    return i32(if x < y { -1 } else if x > y { 1 } else { 0 })
}
fn main() {
    let p = obxlib_alloc(3)
    for i in 0..3 { obxlib_poke(p, i, 97 + 2 * i) }
    G = Cfg{key: "e" + "x", n: 0}
    let r = bsearch(G.key, p, 3, 1, cmp)
    println(if isNull(r) { "no" } else { "found" })
    println(G.n)
    obxlib_free(p)
}
