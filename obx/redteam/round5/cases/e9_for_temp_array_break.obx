// break as an exit arm in a for over a temporary array of owned values
// expect: mk 1
// expect: mk 2
// expect: mk 3
// expect: 1
// expect: drop 1
// expect: drop 2
// expect: drop 3
// expect: end
type D = record { v: int }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn mk(v: int): D {
    println("mk " + intToStr(v))
    return D{v: v}
}
fn main() {
    for d in [mk(1), mk(2), mk(3)] {
        let n = if d.v == 2 { break } else { d.v }
        println(n)
    }
    println("end")
}
