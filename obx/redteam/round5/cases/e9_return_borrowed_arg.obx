// return x after &x was passed earlier in the call: the borrow is taken at the call, so the
// exit arm may move x (nothing borrowed yet); x is returned and dropped once by the caller.
// expect: 1
// expect: drop 1
type D = record { v: int }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn pk(a: &D, b: int): int { return a.v + b }
fn f(c: bool): D {
    let x = D{v: 1}
    let n = pk(&x, if c { return x } else { 1 })
    return D{v: n}
}
fn main() { println(f(true).v) }
