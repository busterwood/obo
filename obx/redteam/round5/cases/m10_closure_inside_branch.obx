// a closure inside the non-moving branch captures x, which is dropped at the end of that branch
// expect: 1
// expect: drop 1
// expect: after
type D = record { v: int }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn take(d: D): int { return 0 }
fn main() {
    let c = false
    let x = D{v: 1}
    if c {
        take(x)
    } else {
        let f = fn(): int { return x.v }
        println(f())
    }
    println("after")
}
