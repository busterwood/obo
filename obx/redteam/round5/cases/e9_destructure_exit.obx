// an exit arm as the initializer of a destructuring let
// expect: 0
// expect: drop 2
// expect: drop 1
// expect: 3
// expect: drop 2
// expect: drop 1
type D = record { v: int }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
type P = record { a: D; b: D }
fn f(c: bool): int {
    let P{a, b} = if c { return 0 } else { P{a: D{v: 1}, b: D{v: 2}} }
    return a.v + b.v
}
fn main() {
    let x = P{a: D{v: 1}, b: D{v: 2}}
    println(f(true))
    println(f(false))
}
