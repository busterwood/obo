// str concatenation: the left operand reads x, the right one moves x on one path
// expect: take 1
// expect: drop 1
// expect: abc!
// expect: drop 1
// expect: abc?
type D = record { v: int; name: str }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn take(d: D): str {
    println("take " + intToStr(d.v))
    return "!"
}
fn f(c: bool) {
    let x = D{v: 1, name: "ab" + "c"}
    println(x.name + (if c { take(x) } else { "?" }))
}
fn main() {
    f(true)
    f(false)
}
