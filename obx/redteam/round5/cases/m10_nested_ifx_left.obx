// two if expressions in one call: the first reads x on the path that keeps it, the second moves it
// expect: take 1
// expect: drop 1
// expect: abc 0
// expect: drop 1
// expect: abc 5
type D = record { v: int; name: str }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn take(d: D): int {
    println("take " + intToStr(d.v))
    return 0
}
fn show(s: str, n: int) { println(s + " " + intToStr(n)) }
fn f(c: bool) {
    let x = D{v: 1, name: "ab" + "c"}
    show(if !c || c { x.name } else { "" }, if c { take(x) } else { 5 })
}
fn main() {
    f(true)
    f(false)
}
