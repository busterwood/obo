// libsqlite3 (no dev symlink here: the C backend links /usr/lib/.../libsqlite3.so.0, the
// native backend reads its SONAME): open an in-memory database, create, insert, bind and
// select. Floats go in and out through xmm registers, `mut &ptr` out-parameters, `str`
// arguments and results.
// needs: sqlite3
// expect: version ok
// expect: open 0
// expect: exec 0 0
// expect: 3 three 4.5
// expect: 2 two 3
// expect: 1 one 1.5
// expect: rows 3 done 101
// expect: bound 2.5 x
// expect: error 1 no such table: nope
// expect: close 0
extern "sqlite3" fn sqlite3_libversion(): str
extern "sqlite3" fn sqlite3_libversion_number(): i32
extern "sqlite3" fn sqlite3_open(path: str, db: mut &ptr): i32
extern "sqlite3" fn sqlite3_close(db: ptr): i32
extern "sqlite3" fn sqlite3_exec(db: ptr, sql: str, cb: ptr, arg: ptr, err: ptr): i32
extern "sqlite3" fn sqlite3_prepare_v2(db: ptr, sql: str, n: i32, st: mut &ptr, tail: ptr): i32
extern "sqlite3" fn sqlite3_step(st: ptr): i32
extern "sqlite3" fn sqlite3_column_int64(st: ptr, i: i32): int
extern "sqlite3" fn sqlite3_column_text(st: ptr, i: i32): str
extern "sqlite3" fn sqlite3_column_double(st: ptr, i: i32): float
extern "sqlite3" fn sqlite3_bind_double(st: ptr, i: i32, v: float): i32
extern "sqlite3" fn sqlite3_bind_text(st: ptr, i: i32, s: str, n: i32, destructor: int): i32
extern "sqlite3" fn sqlite3_finalize(st: ptr): i32
extern "sqlite3" fn sqlite3_errmsg(db: ptr): str
extern "c" fn strchr(s: str, c: i32): ptr

fn main() {
    let null = strchr("", 1)
    let v = sqlite3_libversion()
    println(if len(v) > 0 && sqlite3_libversion_number() >= 3000000 { "version ok" } else { "version bad" })
    var db = null
    println("open " + sqlite3_open(":memory:", mut &db).toStr())
    let a = sqlite3_exec(db, "CREATE TABLE t(a INTEGER, b TEXT, c REAL)", null, null, null)
    let b = sqlite3_exec(db, "INSERT INTO t VALUES (1, 'one', 1.5), (2, 'two', 3.0), (3, 'three', 4.5)", null, null, null)
    println("exec " + a.toStr() + " " + b.toStr())
    var st = null
    sqlite3_prepare_v2(db, "SELECT a, b, c FROM t ORDER BY a DESC", -1, mut &st, null)
    var rows = 0
    var rc = sqlite3_step(st)
    while rc == 100 {
        println(intToStr(sqlite3_column_int64(st, 0)) + " " + sqlite3_column_text(st, 1) + " " +
            floatToStr(sqlite3_column_double(st, 2)))
        rows += 1
        rc = sqlite3_step(st)
    }
    println("rows " + intToStr(rows) + " done " + rc.toStr())
    sqlite3_finalize(st)
    sqlite3_prepare_v2(db, "SELECT ?1, ?2", -1, mut &st, null)
    sqlite3_bind_double(st, 1, 2.5f)
    sqlite3_bind_text(st, 2, "x", -1, -1)       // SQLITE_TRANSIENT: sqlite copies the text
    sqlite3_step(st)
    println("bound " + floatToStr(sqlite3_column_double(st, 0)) + " " + sqlite3_column_text(st, 1))
    sqlite3_finalize(st)
    let e = sqlite3_exec(db, "SELECT * FROM nope", null, null, null)
    println("error " + e.toStr() + " " + sqlite3_errmsg(db))
    println("close " + sqlite3_close(db).toStr())
}
