// libm through dynamic linking: functions the native runtime does not have, bound to the
// same (default) symbol versions as gcc's link.
// expect: hypot 5 1.4142135623730951
// expect: pow 1024 0.001 2
// expect: exp 2.718281828459045 1
// expect: log 2.302585092994046 0
// expect: sin 0.8414709848078965 0
// expect: atan2 0.7853981633974483 -2.356194490192345
// expect: cbrt 3.0000000000000004 tanh 0.7615941559557649
// expect: floor -2 sqrt 1.4142135623730951
extern "c" fn hypot(x: float, y: float): float
extern "c" fn pow(x: float, y: float): float
extern "c" fn exp(x: float): float
extern "c" fn log(x: float): float
extern "c" fn sin(x: float): float
extern "c" fn atan2(y: float, x: float): float
extern "c" fn cbrt(x: float): float
extern "c" fn tanh(x: float): float
extern "c" fn floor(x: float): float
extern "c" fn sqrt(x: float): float

fn f(x: float): str { return floatToStr(x) }

fn main() {
    println("hypot " + f(hypot(3.0, 4.0)) + " " + f(hypot(1.0, 1.0)))
    println("pow " + f(pow(2.0, 10.0)) + " " + f(pow(10.0, -3.0)) + " " + f(pow(8.0, 1.0 / 3.0)))
    println("exp " + f(exp(1.0)) + " " + f(exp(0.0)))
    println("log " + f(log(10.0)) + " " + f(log(1.0)))
    println("sin " + f(sin(1.0)) + " " + f(sin(0.0)))
    println("atan2 " + f(atan2(1.0, 1.0)) + " " + f(atan2(-1.0, -1.0)))
    println("cbrt " + f(cbrt(27.0)) + " tanh " + f(tanh(1.0)))
    println("floor " + f(floor(-1.5)) + " sqrt " + f(sqrt(2.0)))
}
