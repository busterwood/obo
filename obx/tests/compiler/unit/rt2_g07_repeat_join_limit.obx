// Red-team round 2, g07: repeat and join check the str limit (exit 2).
// cflags: -DRT_STR_MAX=100
// expect: 100
// expect: 98
// exit: 2
import "strings"
fn main() {
    println(len(repeat("ab", 50)).toStr())
    let parts: []str = [repeat("x", 49), repeat("y", 48)]
    println(len(strings.join(&parts, ".")).toStr())
    let more: []str = [repeat("x", 50), repeat("y", 50)]
    println(len(strings.join(&more, ".")).toStr())
}
