// Decimal (std) and Money (lib/money) are library code. The currencies are
// user types that supply associated functions.
// expect: 12.50 USD
// expect: 20.00 USD
// expect: 32.50 USD
// expect: 2.68 USD
// expect: 1500 JPY
// expect: 1650 JPY
// expect: true
// expect: -1.5
// expect: 0.05
import "money"

type USD = value record {}
fn (USD) code(): str { return "USD" }
fn (USD) scale(): int { return 2 }

type JPY = value record {}
fn (JPY) code(): str { return "JPY" }
fn (JPY) scale(): int { return 0 }

fn main() {
    let a: money.Money[USD] = money.of(12.5m)
    let b: money.Money[USD] = money.of(20.00m)
    println(a)
    println(b)
    let c = a + b
    println(c)
    let tax = c.times(0.0825m)
    println(tax)
    let y: money.Money[JPY] = money.of(decimalOf(1500))
    println(y)
    let y2 = y.times(1.1m)
    println(y2)
    if a < b { println("true") }
    let d: Decimal = -1.5m
    println(d)
    let e: Decimal = 0.05m
    println(e)
}
