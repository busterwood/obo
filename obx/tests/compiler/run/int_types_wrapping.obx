// expect: 18446744073709551614
// expect: -2147483648
// expect: 44
// expect: 15
// expect: -3
// expect: -1
// expect: 4611686018427387904
// expect: -4
// expect: 254
// expect: 170141183460469231731687303715884105728
// expect: true
// expect: 3
// expect: -3
// expect: true
// expect: 0.1
// expect: 0.3333333333333333
fn main() {
    let a: u128 = 340282366920938463463374607431768211455
    println(a.toStr())
    let b: i128 = -170141183460469231731687303715884105728
    println(b.toStr())
    println((a +% 1).toStr())
    let c: u64 = 18446744073709551615
    println(c.toStr())
    println((c *% 2).toStr())
    let x: i32 = 2147483647
    println(int(x +% 1))
    let y: byte = 200
    println(int(y +% 100))
    println(int(byte(255) >> 4))
    println(-7 / 2)
    println(-7 % 2)
    println(1 << 62)
    println(-16 >> 2)
    println(int(~byte(1)))
    println((u128(1) << 127).toStr())
    println(i128(9223372036854775807) * 4 > 0 && true == true)
    let f: float = 3.75f
    println(int(f))
    let g: float = -3.75f
    println(int(g))
    println(float(7) / 2.0f == 3.5f)
    println(floatToStr(0.1f))
    println(floatToStr(1.0f / 3.0f))
}
