// expect: 42
// expect: 15001
import "./lib/ast"
import "./lib/ast" as a2
fn fromFraction(d: i128, s: int): int { return int(d) * 1000 + s }
fn eval(e: &ast.Expr, env: &ast.Env[int]): int {
    match e {
        ast.Expr.Num(n) { return n }
        ast.Expr.Add(l, r) { return eval(l, env) + eval(r, env) }
        ast.Expr.Var(nm) { return env.find(nm) }
    }
}
fn main() {
    var env: ast.Env[int] = ast.newEnv()
    env.bind("x", 40)
    let e = ast.Expr.Add(ast.Expr.Var{name: "x"}, a2.Expr.Num(2))
    println(eval(&e, &env))
    let f = 1.5m
    println(f)
}
