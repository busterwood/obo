// Red-team round 2, g02 (SPEC 10 rule 3): while xs[0..2][...] is evaluated, the
// slice, and so xs, is held, so clear(mut &xs) in the index is an error. The
// slice lost its root when it was indexed, and was read after clear() freed it.
// error: xs
// error: borrow|held
fn clear(xs: mut &[]int): int { xs = []; return 0 }
fn main() {
    var xs: []int = [1, 2, 3]
    println(xs[0..2][clear(mut &xs)])
}
