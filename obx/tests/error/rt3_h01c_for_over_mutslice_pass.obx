// Red-team round 3, h01: a for loop freezes the slice it walks; passing the
// slice on as mut &[T] inside the body is an error.
// error: borrowed
type B = record { v: []int }
fn reset(s: mut &[B]) { s[0] = B{v: [9]} }
fn f(s: mut &[B]) {
    for b in s {
        reset(s)
        println(b.v[0])
    }
}
fn main() {
    var xs = [B{v: [1]}]
    f(mut &xs)
}
