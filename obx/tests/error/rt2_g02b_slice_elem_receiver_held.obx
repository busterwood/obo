// Red-team round 2, g02: a method receiver that is an element of a slice holds
// the array while the arguments are evaluated (SPEC 10 rule 3).
// error: bs
// error: borrow|held
type B = record { s: str }
fn (b: &B) get(n: int): str { return b.s }
fn clear(g: mut &[]B): int { g = []; return 0 }
fn main() {
    var bs: []B = [B{s: "a" + "b"}]
    println(bs[0..1][0].get(clear(mut &bs)))
}
