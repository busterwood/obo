// Red-team round 3, h01: a mut &[]T passed where a mut &[T] is expected
// borrows its root mutably too.
// error: borrowed
type B = record { v: int }
fn reset(s: mut &[B]) { s[0] = B{v: 9} }
fn f(xs: mut &[]B) {
    let r = &xs[0].v
    reset(xs)
    println(r)
}
fn main() {
    var xs = [B{v: 1}, B{v: 2}]
    f(mut &xs)
}
