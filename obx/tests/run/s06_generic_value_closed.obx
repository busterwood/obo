// expect: 3
// expect: none
type Maybe[T] = value closed { Has(T); Nothing }
fn show(m: &Maybe[int]) {
    match m {
        Maybe.Has(v) { println(v) }
        Maybe.Nothing { println("none") }
    }
}
fn main() {
    let a = Maybe.Has(3)
    let b: Maybe[int] = Maybe.Nothing
    show(&a)
    show(&b)
}
