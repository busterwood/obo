// expect: f
// expect: 2
// expect: 5
type Ast = closed {
    Lit(int)
    Call { name: str; args: []Ast }
}
fn show(a: &Ast) {
    match a {
        Ast.Lit(n) { println(n) }
        Ast.Call(name, args) {
            println(name)
            println(len(args))
        }
    }
}
fn main() {
    let c = Ast.Call{name: "f", args: [Ast.Lit(1), Ast.Lit(2)]}
    show(&c)
    let l = Ast.Lit(5)
    show(&l)
}
