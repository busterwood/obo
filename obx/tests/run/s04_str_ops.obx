// expect: ok
// expect: ok
// expect: ok
// expect: ok
// expect: ok
// expect: 4
fn check(c: bool) { if c { println("ok") } else { println("FAIL") } }
fn main() {
    var s = "ab"
    s += "cd"
    println(s)
    check("abc" == "abc")
    check("abc" != "abd")
    check("abc" < "abd")
    check("ab" < "abc")
    check("b" > "abc")
    println(len(s))
}
