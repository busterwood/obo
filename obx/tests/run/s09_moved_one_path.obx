// SPEC 9.1: moved on one path only (an error before): the other path drops it.
// expect: eat 1
// expect: drop 1
// expect: end
type D = record { id: int }
fn (d: mut &D) drop() { println("drop " + intToStr(d.id)) }
fn eat(d: D) { println("eat " + intToStr(d.id)) }
fn main() {
    let n = D{id: 1}
    if n.id > 0 { eat(n) }
    println("end")
}
