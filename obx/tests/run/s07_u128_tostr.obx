// expect: 0 9 10 99 100 101 9999999999999999999 10000000000000000000 18446744073709551615 18446744073709551616 99999999999999999999999999999999999999 100000000000000000000000000000000000000 340282366920938463463374607431768211455 123456789012345678901234567890123456789 184467440737095516150000000000000000000
// expect: -170141183460469231731687303715884105728 170141183460469231731687303715884105727 -10000000000000000000
// u128 and i128 text at the digit-count and 10^19-chunk boundaries
fn main() {
    let e19: u128 = 10000000000000000000
    let vals: []u128 = [0, 9, 10, 99, 100, 101, e19 - 1, e19, (u128(1) << 64) - 1, u128(1) << 64,
        e19 * e19 - 1, e19 * e19, u128(0) -% 1, 123456789012345678901234567890123456789,
        e19 * ((u128(1) << 64) - 1)]
    var line = ""
    for v in vals {
        if len(line) > 0 { line = line + " " }
        line = line + v.toStr()
    }
    println(line)
    let lo = i128(0) - i128((u128(1) << 127) - 1) - 1
    println(lo.toStr() + " " + i128((u128(1) << 127) - 1).toStr() + " " + (i128(0) - i128(e19)).toStr())
}
