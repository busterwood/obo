// expect: -3
// expect: -1
// expect: -3
// expect: 1
// expect: 3
// expect: 1
// expect: 0
fn div(a: int, b: int): int { return a / b }
fn rem(a: int, b: int): int { return a % b }
fn main() {
    println(div(-7, 2))
    println(rem(-7, 2))
    println(div(7, -2))
    println(rem(7, -2))
    println(div(7, 2))
    println(rem(7, 2))
    println(rem(-6, 3))
}
