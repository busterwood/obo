// SPEC 12: C varargs: printf and snprintf with each kind of extra argument (promotions, floats and
// integers past the registers); obx output is buffered, so C's flushed line comes first.
// expect: C -7 1099511627776 str 2.50 4000000000 A 1|0 (nil)
// expect: obx 1
// expect: obx 2
// expect: 10 [bc=  0.3 x]
// expect: 1.000000 2.000000 3.000000 4.000000 5.000000 6.000000 7.000000 8.000000 9.000000 10.000000
// expect: 1 2 3 4 5 6 7 8 nine
// expect: no extras
extern "c" fn printf(fmt: str, ...): i32
extern "c" fn snprintf(buf: ptr, n: int, fmt: str, ...): i32
extern "c" fn fflush(f: ptr): i32
extern "c" fn obxlib_alloc(n: int): ptr
extern "c" fn obxlib_free(p: ptr)
fn main() {
    println("obx 1")
    printf("C %d %ld %s %.2f %u %c %d|%d %p\n", i32(-7), 1 << 40, "str", 2.5f, u32(4000000000), byte(65), true, false, nullPtr())
    fflush(nullPtr())
    println("obx 2")
    let p = obxlib_alloc(64)
    let s = "abcdef"
    let n = snprintf(p, 64, "%s=%5.1f %s", s[1..3], float(1) / float(3), "x")
    println(intToStr(int(n)) + " [" + strFromC(p) + "]")
    obxlib_free(p)
    printf("%f %f %f %f %f %f %f %f %f %f\n", float(1), float(2), float(3), float(4), float(5), float(6), float(7), float(8), float(9), float(10))
    printf("%d %d %d %d %d %d %d %d %s\n", i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8), "nine")
    printf("no extras\n")
}
