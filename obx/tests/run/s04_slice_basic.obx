// SPEC 4.2a: slices of arrays: &[T] params, xs[a..b], xs[a..], xs[..b],
// &xs converting to a slice, len, indexing, for, re-slicing.
// expect: 15
// expect: 5 3 9 0
// expect: 4 3 2
// expect: 7 8
// expect: 2

fn sum(xs: &[int]): int {
    var t = 0
    for x in xs { t += x }
    return t
}

fn firstOr(xs: &[int], d: int): int {
    if len(xs) == 0 { return d }
    return xs[0]
}

fn main() {
    let a: []int = [1, 2, 3, 4, 5]
    println(sum(&a))
    println(sum(a[1..3]).toStr() + " " + sum(a[..2]).toStr() + " " + sum(a[3..]).toStr() + " " +
            sum(a[2..2]).toStr())
    let s = a[1..]
    let t = s[1..3]
    println(len(s).toStr() + " " + t[0].toStr() + " " + len(t).toStr())
    let u = &a[3..5]
    println((u[0] + 3).toStr() + " " + (u[1] + 3).toStr())
    let e: []int = []
    println(firstOr(&e, 2))
}
