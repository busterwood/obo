// expect: drop 3
// expect: 1
// expect: 2
// expect: 4
// expect: drop 2
// expect: drop 1
type D = record { id: int }
fn (d: mut &D) drop() { println("drop " + d.id.toStr()) }
type P = record { a: D; b: D; c: D; n: int }
fn mk(): P { return P{a: D{id: 1}, b: D{id: 2}, c: D{id: 3}, n: 4} }
fn main() {
    let P{a, b: x, c: _, n} = mk()
    println(a.id)
    println(x.id)
    println(n)
}
