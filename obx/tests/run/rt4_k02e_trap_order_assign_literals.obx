// Red-team round 4, k02 (SPEC 7, 7.4, 8): p = e evaluates e before p's
// indexes; a compound assignment's indexes run before b; literal fields run
// in source order. Each check passes until the record literal, whose field y
// is written first: xs[5] stops the program (exit 3), not 10 / z.
// expect: 7
// expect: 9
// expect: 3
// exit: 3
type P = record { x: int; y: int }
fn main() {
    var xs = [1, 2]
    var z = 0
    var one = 1
    xs[1] = 14 / (one + one)
    println(xs[1])
    xs[1] += 4 / (one + one)
    println(xs[1])
    let a = [xs[0], xs[1] / 3]
    println(a[1])
    let p = P{y: xs[5], x: 10 / z}
    println(p.x)
}
