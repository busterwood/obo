// expect: 3
// expect: 2
// expect: none
type Stack[T] = record { items: []T }
fn newStack[T](): Stack[T] { return Stack[T]{items: []} }
fn (s: mut &Stack[T]) push(v: T) { append(mut &s.items, v) }
fn (s: mut &Stack[T]) take(): Option[T] {
    if len(s.items) == 0 { return None }
    return Some(pop(mut &s.items))
}
fn (s: &Stack[T]) size(): int { return len(s.items) }
fn show(o: Option[int]) {
    match o {
        Some(n) { println(n) }
        None { println("none") }
    }
}
fn main() {
    var s: Stack[int] = newStack()
    s.push(1)
    s.push(2)
    s.push(3)
    show(s.take())
    println(s.size())
    s.take()
    s.take()
    show(s.take())
}
