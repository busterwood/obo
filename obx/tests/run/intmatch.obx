const TEN = 10
const BIG = 0x1_0000_0000

var calls = 0

fn next(n: int): int {
    calls += 1
    return n
}

fn name(n: int): string {
    match n {
        0 { return "zero" }
        1, 2, 3 { return "small" }
        TEN { return "ten" }
        -1 { return "minus one" }
        BIG { return "big" }
        0x7FFF_FFFF_FFFF_FFFF { return "max" }
        else { return "other" }
    }
}

fn classify(c: byte): int {
    match c {
        'a', 'e', 'i', 'o', 'u' { return 1 }
        ' ', '\t', '\n' { return 2 }
        else {
            if c >= '0' && c <= '9' { return 3 }
            return 0
        }
    }
}

fn main() {
    println(name(0), " ", name(2), " ", name(10), " ", name(-1), " ", name(4294967296), " ", name(9223372036854775807), " ", name(7))
    // expect: zero small ten minus one big max other
    let text = "obx is\tfun 42\n"
    var vowels = 0
    var spaces = 0
    var digits = 0
    for i in 0..len(text) {
        match classify(text[i]) {
            1 { vowels += 1 }
            2 { spaces += 1 }
            3 { digits += 1 }
        }
    }
    println(vowels, " ", spaces, " ", digits)            // expect: 3 4 2
    match next(5) {                                      // the subject is evaluated once
        1 { println("one") }
        2 { println("two") }
        else { println("else, calls=", calls) }          // expect: else, calls=1
    }
    var hits = 0
    for i in 0..10 {
        match i % 4 {
            0 { continue }
            3 {
                defer hits += 100
                if i > 5 { break }
            }
        }
        hits += 1
    }
    println(hits)                                         // expect: 205
    var nothing = 0
    match 99 {
        1 { nothing = 1 }
    }
    println(nothing)                                      // expect: 0
    let b: byte = 200
    match b {
        200 { println("byte 200") }                       // expect: byte 200
        else { println("no") }
    }
    match 'x' {
        'x' {
            match 1 + 1 {
                2 { println("nested") }                   // expect: nested
            }
        }
    }
}
