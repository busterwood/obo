// An inlined function taking a str by value, given a copy of a place (rt_str_dup), reads the
// place itself when nothing can change it meanwhile (compiler/opt.obx, M_LENT): the copy and
// its drop go. A later argument that changes the place keeps the copy.
// Run with OBX_CHECK=1: every count must come back to zero.
// expect: true false
// expect: -1 1 0
// expect: 5 2
// expect: old new
// expect: found 7 missing

fn same(a: str, b: &str): bool { return a == b }
fn order(a: str, b: &str): int { return a.cmp(b) }
fn twice(a: str, b: str): str { return a + "/" + b }
fn keep(a: str, b: str): str { return a + " " + b }
fn setNew(s: mut &[]str, i: int): str {
    s[i] = "new"
    return s[i]
}

fn main() {
    var names: []str = []
    for i in 0..4 { append(mut &names, "n" + i.toStr()) }
    let k = "n" + "1"
    println(same(names[1], &k).toStr() + " " + same(names[2], &k).toStr())
    println(order(names[0], &k).toStr() + " " + order(names[3], &k).toStr() + " " + order(names[1], &k).toStr())
    println(len(twice(names[2], names[2])).toStr() + " " + len(names[1]).toStr())
    names[0] = "old"
    println(keep(names[0], setNew(mut &names, 0)))
    var m = newMap[str, int]()
    m.put("x" + "y", 7)
    let q = "x" + "y"
    println("found " + m.getOr(&q, -1).toStr() + " " + (if m.has(&("z" + "")) { "present" } else { "missing" }))
}
