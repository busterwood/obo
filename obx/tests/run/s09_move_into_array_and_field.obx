// expect: 3
// expect: 0
// expect: 2
// expect: 1
type D = record { id: int }
fn (d: mut &D) drop() { println(d.id) }
type Hold = record { d: D }
fn main() {
    let a = D{id: 1}
    let b = D{id: 2}
    var xs: []D = []
    append(mut &xs, a)
    let h = Hold{d: b}
    println(len(xs) + h.d.id)
    println(0)
}
