// expect: 2
type List[T] = closed { Cons(T, List[T]); Nil }
fn (l: &List[T]) length(): int {
    var r = 0
    match l {
        List.Cons(_, rest) { r = 1 + rest.length() }
        List.Nil { }
    }
    return r
}
fn main() {
    let nil: List[int] = List.Nil
    let l = List.Cons(2, nil)
    let l2 = List.Cons(1, l)
    println(l2.length())
}
