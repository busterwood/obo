// expect: 100
// expect: 4
// expect: 1111
// expect: 110
// expect: a1
// expect: b3
// expect: 0
// expect: yy
// expect: none
// expect: 2
type Pt = value record { x: int; y: int; name: str }
const POW10: []u128 = [1, 10, 100, 1000]
const PTS: []Pt = [Pt{x: 1, y: 2, name: "a"}, Pt{x: 3, y: 4, name: "b"}]
const EMPTY: []int = []
const NAMES: []str = ["x", "yy"]
const OPTS: []Option[int] = [Some(1), None]
const K = 2
const KS: []int = [K, K * 3]
fn sum(xs: &[u128]): u128 {
    var s = u128(0)
    for x in xs { s += x }
    return s
}
fn main() {
    println(u128ToStr(POW10[2]))
    println(len(POW10))
    println(u128ToStr(sum(POW10)))
    println(u128ToStr(sum(POW10[1..3])))
    for p in PTS { println(p.name + intToStr(p.x)) }
    println(len(EMPTY))
    let t = NAMES
    println(t[1])
    match OPTS[1] {
        Some(v) { println(v) }
        None { println("none") }
    }
    println(KS[0])
}
