// expect: 5
// expect: 5
// expect: 0
type D = record { id: int }
fn (d: mut &D) drop() { println(d.id * 0) }
type Op = closed { Has(D); Nope }
fn main() {
    let o = Op.Has(D{id: 5})
    match o {
        Op.Has(d) { println(d.id) }
        Op.Nope { println(1) }
    }
    match o {
        Op.Has(d) { println(d.id) }
        Op.Nope { println(1) }
    }
}
