// expect: drop 3
// expect: drop 2
// expect: 1
// expect: drop 1
type D = record { id: int }
fn (d: mut &D) drop() { println("drop " + d.id.toStr()) }
type P = value record { a: D; b: D; c: D }
fn main() {
    let p = P{a: D{id: 1}, b: D{id: 2}, c: D{id: 3}}
    let P{a} = move(p)
    println(a.id)
}
