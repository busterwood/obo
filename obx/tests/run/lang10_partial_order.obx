// SPEC 7.8, 9.1: operands left of an if expression are evaluated before it, so a value
// read from a variable that a branch drops is read first.
// expect: drop 2
// expect: drop 1
// expect: 3
// expect: drop 1
// expect: drop 2
// expect: 4
type D = record { v: int; s: []int }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn two(a: int, d: D): int { return a + d.v }
fn pick(c: bool): int {
    let x = D{v: 1, s: [1]}
    let y = D{v: 2, s: [2]}
    return two(x.v + len(x.s), if c { x } else { y })
}
fn main() {
    println(pick(true))
    println(pick(false))
}
