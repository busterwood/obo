// Native code generation (x64gen allocRegs, eighth performance step): a
// local saved in its slot around a statement with a call still has its value
// when that statement traps, and the trap is the one of the C build, at its
// own line, after the output of the earlier iterations.
// expect: 0 0
// expect: 1 1
// expect: 2 3
// stderr: obx: index out of range at x64_spill_sites_trap.obx:23
// exit: 3

fn show(i: int, s: int) { println(i.toStr() + " " + s.toStr()) }

fn run(xs: &[]int, n: int) {
    var s = 0
    var i = 0
    var k = 0
    while i < n {
        s += i
        k += 2
        if i % 1 == 0 {
            show(i, s)
        }
        k += xs[i + 1] - xs[i + 1]
        i += 1
    }
    println(k.toStr())
}

fn main() {
    run(&[1, 2, 3], 5)
}
