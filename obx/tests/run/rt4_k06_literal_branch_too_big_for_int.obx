// Red-team round 4, k06 (SPEC 7.8): an integer literal branch takes the type
// of the others and is never first made an int, so a u64 literal that does
// not fit int is a u64 branch (as in u + 18446744073709551615). The literal
// was rejected ("does not fit int") before it was checked again.
// expect: 18446744073709551615
// expect: 18446744073709551615
// expect: 7
fn main() {
    let u: u64 = 5
    let c = true
    let k = 1
    let y = if c { 18446744073709551615 } else { u }
    println(y.toStr())
    let z = match k { 1 { 18446744073709551615 } else { u } }
    println(z.toStr())
    let w = if c { 7 } else if k == 2 { 8 } else { u }
    println(w.toStr())
}
