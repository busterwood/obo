// expect: No such file or directory
// expect: 0
// expect: yes
extern "c" fn strerror(e: i32): str
extern "c" fn cGetenv(name: str): str as "getenv"
fn main() {
    println(strerror(i32(2)))
    println(len(cGetenv("OBX_SURELY_NOT_SET_ANYWHERE")))
    let p = cGetenv("PATH")
    if len(p) > 0 { println("yes") }
}
