// expect: 4
// expect: no
type Opt = value closed { Yes(int); No }
type Wrap = value closed { W(Opt); Bare }
fn f(w: &Wrap) {
    match w {
        Wrap.W(o) {
            match o {
                Opt.Yes(n) { println(n) }
                Opt.No { println("no") }
            }
        }
        Wrap.Bare { println("bare") }
    }
}
fn main() {
    let a = Wrap.W(Opt.Yes(4))
    let b = Wrap.W(Opt.No)
    f(&a)
    f(&b)
}
