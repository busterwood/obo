// expect: 7
// expect: 3
type Expr = closed {
    Num(int)
    Add(Expr, Expr)
    Neg(Expr)
}
fn (e: &Expr) eval(): int {
    var r = 0
    match e {
        Expr.Num(n) { r = n }
        Expr.Add(l, x) { r = l.eval() + x.eval() }
        Expr.Neg(i) { r = 0 - i.eval() }
    }
    return r
}
fn main() {
    let e = Expr.Add(Expr.Num(3), Expr.Add(Expr.Num(1), Expr.Num(3)))
    println(e.eval())
    let f = Expr.Add(Expr.Num(6), Expr.Neg(Expr.Num(3)))
    println(f.eval())
}
