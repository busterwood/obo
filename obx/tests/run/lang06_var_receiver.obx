// SPEC 5.3: var before a by-value receiver or parameter makes it assignable in the
// body; the caller's copy is unchanged, an owned receiver is moved in and may be returned.
// expect: 5 4
// expect: 1 2 3 9
// expect: 3
// expect: 11
type P = value record { x: int }
type Stack = record { items: []int }
fn (var p: P) bumped(): P {
    p.x += 1
    return p
}
fn (var s: Stack) with(v: int): Stack {
    append(mut &s.items, v)
    return s
}
fn (var s: Stack) total(var extra: int): int {
    for x in s.items { extra += x }
    s.items = []
    return extra
}
fn inc(n: mut &int) { n += 1 }
fn f(var n: int): int {
    inc(mut &n)
    n = n * 10 + 1
    return n
}
fn main() {
    let p = P{x: 4}
    let q = p.bumped()
    println(intToStr(q.x) + " " + intToStr(p.x))
    let s = Stack{items: [1, 2]}
    let t = s.with(3).with(9)
    var b = newStrBuf()
    for x in t.items { b.add(intToStr(x) + " ") }
    println(b.toStr()[0..len(b.toStr()) - 1])
    println(Stack{items: [1, 2]}.total(0))
    println(f(0))
}
