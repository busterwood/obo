// Red-team round 2, g01 (SPEC 4.2a, 14): an out-of-range slice bound stops the
// program (exit 3). A computed upper bound of -1 was read as "to the end" (the
// sentinel for a missing bound), so xs[1..b] with b = -1 gave xs[1..3].
// exit: 3
fn main() {
    let xs: []int = [1, 2, 3]
    var b = 0
    b -= 1
    let s = xs[1..b]
    println(len(s))
}
