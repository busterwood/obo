// expect: 1500
// expect: ok
// expect: ok
// expect: ok
// expect: 1200
fn main() {
    let x: float = 1.5e3f
    println(int(x))
    let a: float = 6.02e23f
    if a == 602000000000000000000000.0f { println("ok") }
    let b: float = 2e-7f
    if b == 0.0000002f { println("ok") }
    let c: float = 1_0.0E+2f
    if c == 1000.0f { println("ok") }
    let d: float = 12e2f
    println(int(d))
}
