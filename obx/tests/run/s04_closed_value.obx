// expect: 12
// expect: 6
// expect: 0
type Shape = value closed { Rect(int, int); Sq(int); Empty }
fn (s: &Shape) area(): int {
    var r = 0
    match s {
        Shape.Rect(w, h) { r = w * h }
        Shape.Sq(n) { r = n * n }
        Shape.Empty { r = 0 }
    }
    return r
}
fn main() {
    let a = Shape.Rect(3, 4)
    let b = a
    println(a.area())
    let c = Shape.Rect(2, 3)
    println(c.area())
    let e: Shape = Shape.Empty
    println(e.area())
}
