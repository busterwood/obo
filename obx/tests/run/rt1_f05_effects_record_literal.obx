// SPEC 7.5: a copy argument is copied when it is evaluated. The call hidden in
// the record literal is not seen, so first(&xs).v is read after grow has
// reallocated xs (use after free).
// expect: 7
type D = record { v: int }
type P = record { n: int }
fn first(xs: &[]D): &D { return &xs[0] }
fn grow(xs: mut &[]D): int {
    for i in 0..100 { append(xs, D{v: i}) }
    return 0
}
fn use(a: int, p: P) { println(a) }
fn main() {
    var xs: []D = [D{v: 7}]
    use(first(&xs).v, P{n: grow(mut &xs)})
}
