// httpload: an HTTP/1.1 load client for httpd (cmd/http_gate.py). CONNS
// keep-alive connections, each a task sending GET PATH and reading the reply,
// one request at a time, for SECONDS seconds.
//
//     httpload [-p PROCS] [-r] [--client] ADDR CONNS SECONDS [PATH]
//
//     -p PROCS  spread the connections over PROCS processes (task.workers),
//               so that the client is not the limit when the server has
//               several cores; default 1, this process alone
//     -r        reconnect after an error (and count it) instead of ending
//               that connection: the gate's kill test
//     --client  send the requests through lib/http instead: one
//               http.Client (per process) with maxPerHost its connections,
//               shared by its tasks, each request a client.get and a text()
//               of its body (the HTTP client's gate, design/http-client.md)
//
// Prints one line: requests, requests per second, and the latency
// percentiles in microseconds (from the write of a request to the end of its
// reply), e.g.
//     requests 812345 rps 81234 p50 120 p90 150 p99 310 max 2100 errors 0
// With PROCS > 1 each process counts its latencies in 1 µs buckets and
// leaves them in a file of $TMPDIR (default /tmp); this one adds them up and
// removes the files.
import "task"
import "net"
import "io"
import "os"
import "fs"
import "time"
import "strings"
import "http"

type Load = record {
    addr: str
    path: str
    end: int          // time.monotonicNs() when it stops
    reconnect: bool
}

type Tally = record {
    lat: []int        // ns per request
    errors: int
}

fn client(l: Load): Tally {
    var t = Tally{lat: [], errors: 0}
    while time.monotonicNs() < l.end {
        match run(&l, mut &t.lat) {
            Ok(again) { if !again { break } }   // again: the server closed after a reply (Connection: close)
            Err(e) {
                t.errors += 1
                if !l.reconnect {
                    eprintln("httpload: " + e.toStr())
                    break
                }
            }
        }
    }
    return t
}

// Requests on one connection until the end: Ok(true) when the server ends
// the connection first, with Connection: close on a reply (a server's limit
// of requests per connection), so the caller connects again.
fn run(l: &Load, lat: mut &[]int): Result[bool, io.IoError] {
    let c = try net.connect(l.addr)
    try c.setNoDelay(true)
    let rq = strToBytes("GET " + l.path + " HTTP/1.1\r\nHost: obx\r\n\r\n")
    var buf = array(4096, byte(0))
    while time.monotonicNs() < l.end {
        let t0 = time.monotonicNs()
        try c.write(&rq)
        let closing = try response(&c, mut &buf, l.addr)
        append(mut &lat, time.monotonicNs() - t0)
        if closing { return Ok(true) }
    }
    return Ok(false)
}

// --client: the same loop through an http.Client.
type ClientLoad = record {
    c: http.Client
    url: str
    end: int
}

fn viaClient(l: ClientLoad): Tally {
    var t = Tally{lat: [], errors: 0}
    while time.monotonicNs() < l.end {
        let t0 = time.monotonicNs()
        match l.c.get(l.url) {
            Ok(r) {
                match r.text() {
                    Ok(_) { append(mut &t.lat, time.monotonicNs() - t0) }
                    Err(e) {
                        t.errors += 1
                        eprintln("httpload: " + e.toStr())
                        return t
                    }
                }
            }
            Err(e) {
                t.errors += 1
                eprintln("httpload: " + e.toStr())
                return t
            }
        }
    }
    return t
}

// Reads one reply (its head and Content-Length bytes of body); the server
// sends nothing else until the next request. True when the reply says
// Connection: close.
fn response(c: &net.Conn, buf: mut &[]byte, addr: str): Result[bool, io.IoError] {
    var have = 0
    var end = -1
    while end < 0 {
        if have == len(buf) { return Err(io.IoError{errno: 7, op: "reply", path: addr}) }
        let n = try c.read(mut &buf[have..len(buf)])
        if n == 0 { return Err(io.IoError{errno: 104, op: "reply", path: addr}) }
        have += n
        end = headEnd(&buf, have)
    }
    let head = strFromBytes(&buf[0..end])
    var body = 0
    var closing = false
    for line in strings.splitOn(head, "\r\n") {
        match strings.cut(line, ":") {
            Some(kv) {
                let name = strings.toLower(kv.before)
                if name == "content-length" { body = strings.parseInt(trim(kv.after)).unwrapOr(0) }
                if name == "connection" && strings.toLower(trim(kv.after)) == "close" { closing = true }
            }
            None {}
        }
    }
    var left = end + 4 + body - have
    while left > 0 {
        let n = try c.read(mut &buf[0..len(buf)])
        if n == 0 { return Err(io.IoError{errno: 104, op: "reply", path: addr}) }
        left -= n
    }
    return Ok(closing)
}

fn headEnd(b: &[]byte, n: int): int {
    for i in 0..n - 3 {
        if b[i] == '\r' && b[i + 1] == '\n' && b[i + 2] == '\r' && b[i + 3] == '\n' { return i }
    }
    return -1
}

// conns connections in this process until end: the latencies (ns, sorted) and the errors.
fn load(addr: str, path: str, conns: int, end: int, reconnect: bool, viaHttp: bool): Tally {
    var lat: []int = []
    var errors = 0
    task.scope(fn(s: mut &task.Scope) {
        var fs: []task.Future[Tally] = []
        if viaHttp {
            var o = http.defaults()
            o.maxPerHost = conns
            let c = http.newClient(o)
            for i in 0..conns { append(mut &fs, s.start(viaClient, ClientLoad{c: c, url: "http://" + addr + path, end: end})) }
        } else {
            for i in 0..conns { append(mut &fs, s.start(client, Load{addr: addr, path: path, end: end, reconnect: reconnect})) }
        }
        for t in task.all(fs).unwrap() {
            for x in t.lat { append(mut &lat, x) }
            errors += t.errors
        }
    })
    sort(mut &lat)
    return Tally{lat: lat, errors: errors}
}

// The latencies of all processes, in 1 µs buckets.
type Hist = record {
    count: []int      // count[us]: requests that took us microseconds
    n: int
    errors: int
}

// A worker's file: "errors E", then "us count" for each bucket in use.
fn writeHist(path: str, t: &Tally) {
    var b = newStrBuf()
    b.add("errors " + intToStr(t.errors) + "\n")
    var i = 0
    while i < len(t.lat) {
        let us = t.lat[i] / 1000
        var k = 0
        while i < len(t.lat) && t.lat[i] / 1000 == us {
            k += 1
            i += 1
        }
        b.add(intToStr(us) + " " + intToStr(k) + "\n")
    }
    io.write(path, b.toStr()).unwrap()
}

fn addHist(h: mut &Hist, path: str) {
    for line in io.readLines(path).unwrap() {
        let kv = strings.cut(line, " ").unwrap()
        let v = strings.parseInt(kv.after).unwrap()
        if kv.before == "errors" {
            h.errors += v
        } else {
            let us = strings.parseInt(kv.before).unwrap()
            while len(h.count) <= us { append(mut &h.count, 0) }
            h.count[us] += v
            h.n += v
        }
    }
}

// the p-th percentile (µs) of the histogram
fn hpct(h: &Hist, p: int): int {
    let want = min(h.n - 1, h.n * p / 100)
    var seen = 0
    for us in 0..len(h.count) {
        seen += h.count[us]
        if seen > want { return us }
    }
    return len(h.count) - 1
}

// the p-th percentile of the sorted ns latencies, in microseconds
fn pct(xs: &[]int, p: int): int { return xs[min(len(xs) - 1, len(xs) * p / 100)] / 1000 }

fn usage(): never {
    eprintln("usage: httpload [-p PROCS] [-r] [--client] ADDR CONNS SECONDS [PATH]")
    os.quit(2)
}

fn main() {
    let args = os.arguments()
    var procs = 1
    var reconnect = false
    var viaHttp = false
    var k = 0                        // the first argument after the options
    while k < len(args) && startsWith(args[k], "-") {
        if args[k] == "-r" {
            reconnect = true
            k += 1
        } else if args[k] == "--client" {
            viaHttp = true
            k += 1
        } else if args[k] == "-p" && k + 1 < len(args) {
            procs = strings.parseInt(args[k + 1]).unwrapOr(0)
            k += 2
        } else {
            usage()
        }
    }
    if len(args) - k < 3 { usage() }
    let addr = args[k]
    let conns = strings.parseInt(args[k + 1]).unwrapOr(0)
    let secs = strings.parseInt(args[k + 2]).unwrapOr(0)
    if conns <= 0 || secs <= 0 || procs <= 0 || procs > conns { usage() }
    let path = if len(args) - k > 3 { args[k + 3] } else { "/" }
    let t0 = time.monotonicNs()
    let end = t0 + secs * 1000000000
    if procs == 1 {
        let t = load(addr, path, conns, end, reconnect, viaHttp)
        let dt = time.monotonicNs() - t0
        let n = len(t.lat)
        if n == 0 {
            println("requests 0 errors " + intToStr(t.errors))
            os.quit(1)
        }
        println("requests " + intToStr(n) + " rps " + intToStr(n * 1000000000 / dt) +
                " p50 " + intToStr(pct(&t.lat, 50)) + " p90 " + intToStr(pct(&t.lat, 90)) +
                " p99 " + intToStr(pct(&t.lat, 99)) + " max " + intToStr(t.lat[n - 1] / 1000) +
                " errors " + intToStr(t.errors))
        return
    }
    let base = fs.join(os.envOr("TMPDIR", "/tmp"), "httpload-" + intToStr(os.pid()) + "-")
    let r = task.workers(procs, fn(i: int) {
        let mine = conns / procs + (if i < conns % procs { 1 } else { 0 })
        let t = load(addr, path, mine, end, reconnect, viaHttp)
        writeHist(base + intToStr(i), &t)
    })
    match r {
        Ok(ends) {}
        Err(g) {
            eprintln("httpload: " + g.toStr())
            os.quit(1)
        }
    }
    let dt = time.monotonicNs() - t0
    var h = Hist{count: [], n: 0, errors: 0}
    for i in 0..procs {
        addHist(mut &h, base + intToStr(i))
        let x = fs.remove(base + intToStr(i))
    }
    if h.n == 0 {
        println("requests 0 errors " + intToStr(h.errors))
        os.quit(1)
    }
    println("requests " + intToStr(h.n) + " rps " + intToStr(h.n * 1000000000 / dt) +
            " p50 " + intToStr(hpct(&h, 50)) + " p90 " + intToStr(hpct(&h, 90)) +
            " p99 " + intToStr(hpct(&h, 99)) + " max " + intToStr(len(h.count) - 1) +
            " errors " + intToStr(h.errors))
}
