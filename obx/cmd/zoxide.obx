// zoxide: a smarter cd. An obx port of zoxide 0.9.9 (github.com/ajeetdsouza/zoxide)
// that reads and writes the same database file:
//
//     obxc cmd/zoxide.obx --native -o zoxide
//
// Subcommands: add, query (--all --list --score --exclude --base-dir -i),
// remove, init (bash elvish fish nushell posix powershell tcsh xonsh zsh, with
// --cmd --no-cmd --hook; the code is generated from zoxide's own templates by
// cmd/zoxide_gen.py into cmd/zoxide_init.obx) and import (--from autojump|z,
// --merge). `edit` is not supported. The environment is zoxide's: _ZO_DATA_DIR,
// _ZO_ECHO, _ZO_EXCLUDE_DIRS, _ZO_FZF_OPTS, _ZO_MAXAGE, _ZO_RESOLVE_SYMLINKS.
//
// The database is db.zo in _ZO_DATA_DIR (else $XDG_DATA_HOME/zoxide, else
// ~/.local/share/zoxide): bincode, version 3, fixed-width little-endian fields:
// u32 version, u64 count, then per directory u64 length + UTF-8 path, f64 rank,
// u64 last-accessed. It is written to a temporary file in the same directory
// and renamed. Like zoxide, query sorts the entries by score and saves them,
// removes the entries that _ZO_EXCLUDE_DIRS matches and, after three months
// unused, the ones that no longer exist; and add ages all ranks when their sum
// passes _ZO_MAXAGE (default 10000).
//
// Command-line errors imitate clap's (the message, the usage line, exit 2),
// for the cases zoxide's own tests would see. Other errors print
// `zoxide: message`, then the causes as anyhow does, and exit 1.
//
// Not the same as zoxide 0.9.9:
//   * `edit` and the hidden `edit` subcommands.
//   * Case folding is for ASCII only (zoxide lowercases all Unicode).
//   * Entries with equal scores keep their database order (zoxide's sort is
//     unstable, and gives the same order only for up to 20 entries).
//   * `query -i` collects every candidate before it starts fzf (zoxide streams
//     them). fzf is run with zoxide's options; it is not needed otherwise.
//   * clap's suggestions ("a similar argument exists") are not made.
//   * A home directory comes from $HOME only (not the password file).

import "io"
import "fs"
import "os"
import "time"
import "math"
import "strings"
import "proc"
import "collections"
import "./zoxide_init"

const VERSION = "0.9.9"

const HOUR = 3600
const DAY = 86400
const WEEK = 604800
const MONTH = 2592000
const DB_VERSION = 3
const MAX_SIZE = 33554432   // the limit of bincode's reader: 32 MiB

// ---------------------------------------------------------------- errors

// Prints `zoxide: chain[0]` and the causes the way anyhow's {:?} does, then
// stops with status 1.
fn die(chain: []str): never {
    var m = "zoxide: " + chain[0]
    if len(chain) == 2 {
        m = m + "\n\nCaused by:\n    " + chain[1]
    } else if len(chain) > 2 {
        m = m + "\n\nCaused by:"
        for i in 1..len(chain) {
            m = m + "\n    " + intToStr(i - 1) + ": " + chain[i]
        }
    }
    eprintln(m)
    exit(1)
}

fn die1(msg: str): never {
    die([msg])
}

// Rust's text for an I/O error.
fn osErr(errno: int): str {
    return io.errorText(errno) + " (os error " + intToStr(errno) + ")"
}

fn dieIo(msg: str, errno: int): never {
    die([msg, osErr(errno)])
}

// ---------------------------------------------------------------- command line

type OptSpec = value record {
    short: str         // "" for none
    long: str
    val: str           // the value's name in clap's text, "" for a flag
    required: bool
}

type Args = record {
    names: []str       // the long name of each option given, in order
    vals: []str
    pos: []str
}

fn (a: &Args) has(name: str): bool {
    for n in a.names {
        if n == name { return true }
    }
    return false
}

fn (a: &Args) get(name: str): Option[str] {
    for i in 0..len(a.names) {
        if a.names[i] == name { return Some(a.vals[i]) }
    }
    return None
}

fn specsFor(sub: str): []OptSpec {
    var s: []OptSpec = []
    match sub {
        "add" {
            append(mut &s, OptSpec{short: "s", long: "score", val: "<SCORE>", required: false})
        }
        "query" {
            append(mut &s, OptSpec{short: "a", long: "all", val: "", required: false})
            append(mut &s, OptSpec{short: "i", long: "interactive", val: "", required: false})
            append(mut &s, OptSpec{short: "l", long: "list", val: "", required: false})
            append(mut &s, OptSpec{short: "s", long: "score", val: "", required: false})
            append(mut &s, OptSpec{short: "", long: "exclude", val: "<path>", required: false})
            append(mut &s, OptSpec{short: "", long: "base-dir", val: "<path>", required: false})
        }
        "init" {
            append(mut &s, OptSpec{short: "", long: "no-cmd", val: "", required: false})
            append(mut &s, OptSpec{short: "", long: "cmd", val: "<CMD>", required: false})
            append(mut &s, OptSpec{short: "", long: "hook", val: "<HOOK>", required: false})
        }
        "import" {
            append(mut &s, OptSpec{short: "", long: "from", val: "<FROM>", required: true})
            append(mut &s, OptSpec{short: "", long: "merge", val: "", required: false})
        }
        else {}
    }
    return s
}

fn posText(sub: str): str {
    match sub {
        "add" { return "<PATHS>..." }
        "query" { return "[KEYWORDS]..." }
        "remove" { return "[PATHS]..." }
        "init" { return "<SHELL>" }
        "import" { return "<PATH>" }
        else { return "" }
    }
}

fn helpOf(sub: str): str {
    match sub {
        "add" { return helpAdd() }
        "query" { return helpQuery() }
        "remove" { return helpRemove() }
        "init" { return helpInit() }
        "import" { return helpImport() }
        else { return helpTop() }
    }
}

fn optText(s: &OptSpec): str {
    if s.val == "" { return "--" + s.long }
    return "--" + s.long + " " + s.val
}

// The usage line clap prints in an error: the required options, the options
// given, then the positional arguments; [OPTIONS] when `unexpected` and none
// was given.
fn usageLine(sub: str, specs: &[OptSpec], a: &Args, unexpected: bool): str {
    var parts: []str = ["zoxide " + sub]
    var anyUsed = false
    for s in specs {
        if !s.required && a.has(s.long) { anyUsed = true }
    }
    var hasOptional = false
    for s in specs {
        if !s.required { hasOptional = true }
    }
    if unexpected && hasOptional { append(mut &parts, "[OPTIONS]") }
    for s in specs {
        if s.required { append(mut &parts, optText(&s)) }
    }
    if !unexpected {
        for s in specs {
            if !s.required && a.has(s.long) { append(mut &parts, optText(&s)) }
        }
    }
    let p = posText(sub)
    if p != "" { append(mut &parts, p) }
    return strings.join(&parts, " ")
}

const MORE = "For more information, try '--help'.\n"

fn clapDie(msg: str): never {
    eprint("error: " + msg + "\n\n" + MORE)
    exit(2)
}

fn clapUsageDie(msg: str, usage: str): never {
    eprint("error: " + msg + "\n\nUsage: " + usage + "\n\n" + MORE)
    exit(2)
}

fn possible(what: str): str {
    match what {
        "hook" { return "\n  [possible values: none, prompt, pwd]" }
        "from" { return "\n  [possible values: autojump, z]" }
        else { return "\n  [possible values: bash, elvish, fish, nushell, posix, powershell, tcsh, xonsh, zsh]" }
    }
}

fn checkValue(name: str, v: str) {
    match name {
        "hook" {
            if v != "none" && v != "prompt" && v != "pwd" {
                clapDie("invalid value '" + v + "' for '--hook <HOOK>'" + possible("hook"))
            }
        }
        "from" {
            if v != "autojump" && v != "z" && v != "fasd" {
                clapDie("invalid value '" + v + "' for '--from <FROM>'" + possible("from"))
            }
        }
        "score" {
            if v == "" { clapDie("invalid value '' for '--score <SCORE>': cannot parse float from empty string") }
            if parseRustFloat(v).isNone() {
                // only add's --score takes a value
                clapDie("invalid value '" + v + "' for '--score <SCORE>': invalid float literal")
            }
        }
        else {}
    }
}

fn findLong(specs: &[OptSpec], name: str): int {
    for i in 0..len(specs) {
        if specs[i].long == name { return i }
    }
    return -1
}

fn findShort(specs: &[OptSpec], c: str): int {
    for i in 0..len(specs) {
        if specs[i].short == c { return i }
    }
    return -1
}

fn unexpectedArg(sub: str, specs: &[OptSpec], a: &Args, arg: str, tip: bool): never {
    var m = "unexpected argument '" + arg + "' found"
    if tip { m = m + "\n\n  tip: to pass '" + arg + "' as a value, use '-- " + arg + "'" }
    clapUsageDie(m, usageLine(sub, specs, a, true))
}

fn printHelp(sub: str): never {
    print(helpOf(sub))
    exit(0)
}

fn printVersion(sub: str): never {
    if sub == "" {
        println("zoxide " + VERSION)
    } else {
        println("zoxide-" + sub + " " + VERSION)
    }
    exit(0)
}

// Notes an option as given: errors for a repeat or, for query, a conflict.
fn give(sub: str, specs: &[OptSpec], a: mut &Args, si: int, value: str) {
    let s = specs[si]
    let name = s.long
    if a.has(name) {
        let none = Args{names: [], vals: [], pos: []}
        clapUsageDie("the argument '" + optText(&s) + "' cannot be used multiple times", usageLine(sub, specs, &none, true))
    }
    if sub == "query" {
        var other = ""
        if name == "interactive" && a.has("list") { other = "list" }
        if name == "list" && a.has("interactive") { other = "interactive" }
        if other != "" {
            let usage = "zoxide query --" + other + " [KEYWORDS]..."
            clapUsageDie("the argument '--" + other + "' cannot be used with '--" + name + "'", usage)
        }
    }
    if s.val != "" { checkValue(name, value) }
    if name == "no-cmd" { }
    append(mut &a.names, name)
    append(mut &a.vals, value)
}

fn parseSub(sub: str, argv: []str, start: int): Args {
    let specs = specsFor(sub)
    var a = Args{names: [], vals: [], pos: []}
    var i = start
    var onlyPos = false
    while i < len(argv) {
        let arg = argv[i]
        i += 1
        if onlyPos || arg == "-" || len(arg) < 2 || arg[0] != '-' {
            append(mut &a.pos, arg)
            checkPos(sub, &specs, &a)
            continue
        }
        if arg == "--" {
            onlyPos = true
            continue
        }
        if arg == "--help" || arg == "-h" { printHelp(sub) }
        if arg == "--version" || arg == "-V" { printVersion(sub) }
        if arg[1] == '-' {
            // --name or --name=value
            var name = arg[2..]
            var value = ""
            var hasEq = false
            let eq = strings.indexOfByte(name, '=', 0)
            if eq >= 0 {
                value = name[eq + 1..]
                name = name[..eq]
                hasEq = true
            }
            if sub == "init" && name == "no-aliases" { name = "no-cmd" }
            let si = findLong(&specs, name)
            if si < 0 { unexpectedArg(sub, &specs, &a, arg, true) }
            if specs[si].val == "" {
                if hasEq {
                    append(mut &a.names, name)
                    append(mut &a.vals, "")
                    let u = usageLine(sub, &specs, &a, false)
                    clapUsageDie("unexpected value '" + value + "' for '--" + name + "' found; no more were expected", u)
                }
                give(sub, &specs, mut &a, si, "")
            } else {
                if !hasEq {
                    value = needValue(sub, &specs, &a, specs[si], &argv, i)
                    i += 1
                }
                give(sub, &specs, mut &a, si, value)
            }
            continue
        }
        // short options, possibly bundled: -la, -s2, -s=2
        var k = 1
        while k < len(arg) {
            let c = arg[k..k + 1]
            let si = findShort(&specs, c)
            if si < 0 { unexpectedArg(sub, &specs, &a, "-" + c, true) }
            if specs[si].val == "" {
                give(sub, &specs, mut &a, si, "")
                k += 1
            } else {
                var value = arg[k + 1..]
                if len(value) > 0 && value[0] == '=' { value = value[1..] }
                if len(arg) == k + 1 {
                    value = needValue(sub, &specs, &a, specs[si], &argv, i)
                    i += 1
                }
                give(sub, &specs, mut &a, si, value)
                k = len(arg)
            }
        }
    }
    // required arguments
    var missing: []str = []
    for s in specs {
        if s.required && !a.has(s.long) { append(mut &missing, optText(&s)) }
    }
    let p = posText(sub)
    if sub == "add" || sub == "init" || sub == "import" {
        if len(a.pos) == 0 { append(mut &missing, p) }
    }
    if len(missing) > 0 {
        let m = "the following required arguments were not provided:\n  " + strings.join(&missing, "\n  ")
        clapUsageDie(m, usageLine(sub, &specs, &a, false))
    }
    return a
}

// The value of an option given as `--name value`: the next argument, which
// must not look like an option.
fn needValue(sub: str, specs: &[OptSpec], a: &Args, s: OptSpec, argv: &[str], i: int): str {
    if i >= len(argv) { valueRequired(&s) }
    let v = argv[i]
    if len(v) >= 2 && v[0] == '-' {
        var known = false
        if v[1] == '-' {
            known = findLong(specs, v[2..]) >= 0 || v == "--help" || v == "--version"
        } else {
            known = findShort(specs, v[1..2]) >= 0 || v == "-h" || v == "-V"
        }
        if known { valueRequired(&s) }
        unexpectedArg(sub, specs, a, v, true)
    }
    return v
}

fn valueRequired(s: &OptSpec): never {
    var m = "a value is required for '" + optText(s) + "' but none was supplied"
    if s.long == "hook" || s.long == "from" { m = m + possible(s.long) }
    clapDie(m)
}

// A positional argument beyond the allowed number, or one with a bad value.
fn checkPos(sub: str, specs: &[OptSpec], a: &Args) {
    let n = len(a.pos)
    if sub == "init" {
        if n == 1 {
            let v = a.pos[0]
            var ok = false
            for s in zoxide_init.shells() {
                if s == v { ok = true }
            }
            if v == "ksh" { ok = true }
            if !ok { clapDie("invalid value '" + v + "' for '<SHELL>'" + possible("shell")) }
        }
        if n > 1 { unexpectedArg(sub, specs, a, a.pos[n - 1], false) }
    }
    if sub == "import" && n > 1 { unexpectedArg(sub, specs, a, a.pos[n - 1], false) }
}

// ---------------------------------------------------------------- numbers

// Rust's f64::from_str: [+-] digits [. digits] [e [+-] digits], .5, 5., inf,
// infinity, nan (any case).
fn parseRustFloat(s: str): Option[float] {
    if len(s) == 0 { return None }
    var i = 0
    var neg = false
    if s[0] == '+' || s[0] == '-' {
        neg = s[0] == '-'
        i = 1
    }
    let rest = strings.toLower(s[i..])
    if rest == "inf" || rest == "infinity" {
        return Some(if neg { -math.inf() } else { math.inf() })
    }
    if rest == "nan" { return Some(math.nan()) }
    var digits = 0
    var j = i
    while j < len(s) && s[j] >= '0' && s[j] <= '9' {
        j += 1
        digits += 1
    }
    if j < len(s) && s[j] == '.' {
        j += 1
        while j < len(s) && s[j] >= '0' && s[j] <= '9' {
            j += 1
            digits += 1
        }
    }
    if digits == 0 { return None }
    if j < len(s) && (s[j] == 'e' || s[j] == 'E') {
        j += 1
        if j < len(s) && (s[j] == '+' || s[j] == '-') { j += 1 }
        var ed = 0
        while j < len(s) && s[j] >= '0' && s[j] <= '9' {
            j += 1
            ed += 1
        }
        if ed == 0 { return None }
    }
    if j != len(s) { return None }
    return math.parse(s)
}

// Rust's u32::from_str; the error is its message.
fn parseU32(s: str): Result[int, str] {
    if len(s) == 0 { return Err("cannot parse integer from empty string") }
    var i = 0
    if s[0] == '+' { i = 1 }
    if i == len(s) { return Err("invalid digit found in string") }
    var v = 0
    while i < len(s) {
        let c = s[i]
        if c < '0' || c > '9' { return Err("invalid digit found in string") }
        v = v * 10 + (int(c) - 48)
        if v > 4294967295 { return Err("number too large to fit in target type") }
        i += 1
    }
    return Ok(v)
}

fn parseU64(s: str): Result[int, str] {
    if len(s) == 0 { return Err("cannot parse integer from empty string") }
    var i = 0
    if s[0] == '+' { i = 1 }
    if i == len(s) { return Err("invalid digit found in string") }
    var v = 0
    while i < len(s) {
        let c = s[i]
        if c < '0' || c > '9' { return Err("invalid digit found in string") }
        let d = int(c) - 48
        if v > (9223372036854775807 - d) / 10 { return Err("number too large to fit in target type") }
        v = v * 10 + d
        i += 1
    }
    return Ok(v)
}

// x * 2^e, exact when the result is a float (each step is a power of two).
fn pow2(x: float, e: int): float {
    var f = x
    var k = e
    while k > 0 {
        let s = if k > 60 { 60 } else { k }
        f = f * float(1 << s)
        k -= s
    }
    while k < 0 {
        let s = if k < -60 { 60 } else { -k }
        f = f / float(1 << s)
        k += s
    }
    return f
}

// The float with IEEE 754 bits b.
fn floatOfBits(b: int): float {
    let e = (b >> 52) & 0x7ff
    let m = b & 0xfffffffffffff
    var f: float = 0.0f
    if e == 0x7ff {
        f = if m == 0 { math.inf() } else { math.nan() }
    } else {
        f = pow2(float(if e == 0 { m } else { m | (1 << 52) }), (if e == 0 { 1 } else { e }) - 1075)
    }
    if f != f { return math.nan().copySign(if b < 0 { -1.0f } else { 1.0f }) }
    return if b < 0 { -f } else { f }
}

// The IEEE 754 bits of x.
fn bitsOfFloat(x: float): int {
    if x != x {
        return 0x7ff8000000000000 | (if negNaN(x) { 1 << 63 } else { 0 })
    }
    var sign = 0
    if x < 0.0f || (x == 0.0f && 1.0f / x < 0.0f) { sign = 1 << 63 }
    var a = if x < 0.0f { -x } else { x }
    if a == 0.0f { return sign }
    if a == math.inf() { return sign | 0x7ff0000000000000 }
    var e = 0
    while a >= 9007199254740992.0f {
        a = a / 2.0f
        e += 1
    }
    while a < 4503599627370496.0f && e > -1074 {
        a = a * 2.0f
        e -= 1
    }
    var m = int(a)
    let biased = e + 1075
    if m < (1 << 52) || biased <= 0 {
        // subnormal: m * 2^e with e = -1074
        while e < -1074 {
            m = m >> 1
            e += 1
        }
        return sign | m
    }
    return sign | (biased << 52) | (m & 0xfffffffffffff)
}

// The score as zoxide prints it: clamped to 0..9999, one decimal, width 6.
// Rust rounds the exact value half to even; so does this.
fn scoreText(x: float): str {
    var v = x
    if v < 0.0f { v = 0.0f }
    if v > 9999.0f { v = 9999.0f }
    if v != v { return "   NaN" }
    return strings.padLeft(fixed1(v), 6, ' ')
}

fn fixed1(x: float): str {
    if x < 0.01f { return "0.0" }
    var a = x
    var e = 0
    while a < 4503599627370496.0f {
        a = a * 2.0f
        e -= 1
    }
    let t = int(a) * 10
    var q = 0
    if e >= 0 {
        q = t << e
    } else {
        let s = -e
        q = t >> s
        let rem = t & ((1 << s) - 1)
        let half = 1 << (s - 1)
        if rem > half || (rem == half && q % 2 == 1) { q += 1 }
    }
    return intToStr(q / 10) + "." + intToStr(q % 10)
}

// ---------------------------------------------------------------- UTF-8

// Rust's message for a string that is not UTF-8, or "" when it is.
fn utf8Error(s: str): str {
    var i = 0
    while i < len(s) {
        if s[i] < 0x80 {
            i += 1
            continue
        }
        let d = strings.decodeAt(s, i)
        if d.ok {
            i += d.size
            continue
        }
        let c = int(s[i])
        if c < 0xc2 || c > 0xf4 || i + d.size < len(s) {
            return "invalid utf-8 sequence of " + intToStr(d.size) + " bytes from index " + intToStr(i)
        }
        return "incomplete utf-8 byte sequence from index " + intToStr(i)
    }
    return ""
}

// ASCII lower case (zoxide lowercases all of Unicode).
fn lower(s: str): str {
    return strings.toLower(s)
}

// ---------------------------------------------------------------- paths

fn splitComps(path: str): []str {
    var out: []str = []
    for c in strings.split(&path, "/") {
        if c != "" && c != "." { append(mut &out, c) }
    }
    return out
}

// An absolute version of a path with no `.` and `..`, links not followed.
fn resolvePath(path: str): str {
    var stack: []str = []
    if len(path) == 0 || path[0] != '/' { stack = splitComps(os.cwd()) }
    for c in splitComps(path) {
        if c == ".." {
            if len(stack) > 0 { pop(mut &stack) }
        } else {
            append(mut &stack, c)
        }
    }
    return "/" + strings.join(&stack, "/")
}

// realpath: Ok(path), or the errno.
fn realpath(path: str): Result[str, int] {
    var stack: []str = []
    var todo: []str = []
    if len(path) == 0 || path[0] != '/' {
        for c in splitComps(os.cwd()) { append(mut &todo, c) }
    }
    for c in strings.split(&path, "/") { append(mut &todo, c) }
    // process todo from the front
    var pos = 0
    var links = 0
    while pos < len(todo) {
        let c = todo[pos]
        pos += 1
        if c == "" || c == "." { continue }
        if c == ".." {
            if len(stack) > 0 { pop(mut &stack) }
            continue
        }
        let cand = "/" + strings.join(&stack, "/") + (if len(stack) > 0 { "/" } else { "" }) + c
        match fs.lstat(cand) {
            Err(e) { return Err(e.errno) }
            Ok(st) {
                if st.isLink() {
                    links += 1
                    if links > 40 { return Err(40) }
                    match fs.readlink(cand) {
                        Err(e) { return Err(e.errno) }
                        Ok(target) {
                            var rest: []str = []
                            for k in pos..len(todo) { append(mut &rest, todo[k]) }
                            var nt: []str = []
                            if len(target) > 0 && target[0] == '/' { stack = [] }
                            for t in strings.split(&target, "/") { append(mut &nt, t) }
                            for r in rest { append(mut &nt, r) }
                            todo = nt
                            pos = 0
                        }
                    }
                } else {
                    append(mut &stack, c)
                }
            }
        }
    }
    return Ok("/" + strings.join(&stack, "/"))
}

// Path::starts_with: whole components.
fn startsWithPath(path: str, base: str): bool {
    let p = splitComps(path)
    let b = splitComps(base)
    if len(b) > len(p) { return false }
    let pAbs = len(path) > 0 && path[0] == '/'
    let bAbs = len(base) > 0 && base[0] == '/'
    if pAbs != bAbs { return false }
    for i in 0..len(b) {
        if p[i] != b[i] { return false }
    }
    return true
}

// ---------------------------------------------------------------- globs

// A glob::Pattern: Char (kind 0), `?` (1), `*` (2), `**` (3), [..] (4) and
// [!..] (5); a set is pairs lo, hi in set.
type Tok = record {
    kind: int
    ch: int
    set: []int
}

type Glob = record {
    toks: []Tok
}

type GlobError = value record {
    pos: int
    msg: str
}

fn isSep(c: int): bool { return c == 47 }

fn parseSet(cs: &[int]): []int {
    var set: []int = []
    var i = 0
    while i < len(cs) {
        if i + 3 <= len(cs) && cs[i + 1] == 45 {
            append(mut &set, cs[i])
            append(mut &set, cs[i + 2])
            i += 3
        } else {
            append(mut &set, cs[i])
            append(mut &set, cs[i])
            i += 1
        }
    }
    return set
}

fn globNew(pattern: str): Result[Glob, GlobError] {
    let chars = strings.runes(pattern)
    var toks: []Tok = []
    var i = 0
    while i < len(chars) {
        let c = chars[i]
        if c == 63 {
            append(mut &toks, Tok{kind: 1, ch: 0, set: []})
            i += 1
        } else if c == 42 {
            let old = i
            while i < len(chars) && chars[i] == 42 { i += 1 }
            let count = i - old
            if count > 2 {
                return Err(GlobError{pos: old + 2, msg: "wildcards are either regular `*` or recursive `**`"})
            } else if count == 2 {
                let recMsg = "recursive wildcards must form a single path component"
                if i == 2 || isSep(chars[i - count - 1]) {
                    if i < len(chars) && isSep(chars[i]) {
                        i += 1
                    } else if i != len(chars) {
                        return Err(GlobError{pos: i, msg: recMsg})
                    }
                } else {
                    return Err(GlobError{pos: old - 1, msg: recMsg})
                }
                let n = len(toks)
                if !(n > 1 && toks[n - 1].kind == 3) {
                    append(mut &toks, Tok{kind: 3, ch: 0, set: []})
                }
            } else {
                append(mut &toks, Tok{kind: 2, ch: 0, set: []})
            }
        } else if c == 91 {
            var done = false
            if i + 4 <= len(chars) && chars[i + 1] == 33 {
                var j = i + 3
                while j < len(chars) && chars[j] != 93 { j += 1 }
                if j < len(chars) {
                    append(mut &toks, Tok{kind: 5, ch: 0, set: parseSet(&chars[i + 2..j])})
                    i = j + 1
                    done = true
                }
            } else if i + 3 <= len(chars) && chars[i + 1] != 33 {
                var j = i + 2
                while j < len(chars) && chars[j] != 93 { j += 1 }
                if j < len(chars) {
                    append(mut &toks, Tok{kind: 4, ch: 0, set: parseSet(&chars[i + 1..j])})
                    i = j + 1
                    done = true
                }
            }
            if !done { return Err(GlobError{pos: i, msg: "invalid range pattern"}) }
        } else {
            append(mut &toks, Tok{kind: 0, ch: c, set: []})
            i += 1
        }
    }
    return Ok(Glob{toks: toks})
}

fn inSet(set: &[int], c: int): bool {
    var i = 0
    while i < len(set) {
        if c >= set[i] && c <= set[i + 1] { return true }
        i += 2
    }
    return false
}

fn globFrom(toks: &[Tok], ti: int, text: &[int], si: int): bool {
    var t = ti
    var s = si
    while t < len(toks) {
        let tok = &toks[t]
        if tok.kind == 2 || tok.kind == 3 {
            if globFrom(toks, t + 1, text, s) { return true }
            var k = s
            while k < len(text) {
                let c = text[k]
                k += 1
                if tok.kind == 3 && !isSep(c) { continue }
                if globFrom(toks, t + 1, text, k) { return true }
            }
            return tok.kind == 3 && globFrom(toks, t + 1, text, len(text))
        }
        if s >= len(text) { return false }
        let c = text[s]
        var ok = false
        match tok.kind {
            0 { ok = tok.ch == c }
            1 { ok = true }
            4 { ok = inSet(&tok.set, c) }
            else { ok = !inSet(&tok.set, c) }
        }
        if !ok { return false }
        s += 1
        t += 1
    }
    return s == len(text)
}

fn globMatches(g: &Glob, path: str): bool {
    return globFrom(&g.toks, 0, &strings.runes(path), 0)
}

// ---------------------------------------------------------------- config

fn homeDir(): Option[str] {
    match os.env("HOME") {
        Some(h) {
            if h != "" { return Some(h) }
        }
        None {}
    }
    return passwdHome()
}

// The home directory of the user in /etc/passwd (getpwuid_r's answer).
fn passwdHome(): Option[str] {
    var uid = ""
    match io.read("/proc/self/status") {
        Ok(t) {
            for line in strings.lines(&t) {
                if startsWith(line, "Uid:") {
                    let f = strings.fields(&line)
                    if len(f) > 1 { uid = f[1] }
                }
            }
        }
        Err(_) {}
    }
    if uid == "" { return None }
    match io.read("/etc/passwd") {
        Ok(t) {
            for line in strings.lines(&t) {
                let f = strings.split(&line, ":")
                if len(f) >= 6 && f[2] == uid && f[5] != "" { return Some(f[5]) }
            }
        }
        Err(_) {}
    }
    return None
}

fn dataDir(): str {
    var dir = ""
    match os.env("_ZO_DATA_DIR") {
        Some(p) { dir = p }
        None {
            var base = ""
            match os.env("XDG_DATA_HOME") {
                Some(x) {
                    if len(x) > 0 && x[0] == '/' { base = x }
                }
                None {}
            }
            if base == "" {
                match homeDir() {
                    Some(h) { base = h + "/.local/share" }
                    None { die1("could not find data directory, please set _ZO_DATA_DIR manually") }
                }
            }
            dir = base + "/zoxide"
        }
    }
    if len(dir) == 0 || dir[0] != '/' { die1("_ZO_DATA_DIR must be an absolute path") }
    return dir
}

fn echoOn(): bool {
    return os.env("_ZO_ECHO") == Some("1")
}

fn resolveSymlinksOn(): bool {
    return os.env("_ZO_RESOLVE_SYMLINKS") == Some("1")
}

// The patterns of _ZO_EXCLUDE_DIRS; by default the home directory itself.
fn excludeDirs(): []Glob {
    var out: []Glob = []
    match os.env("_ZO_EXCLUDE_DIRS") {
        Some(v) {
            for p in strings.split(&v, ":") {
                match globNew(p) {
                    Ok(g) { append(mut &out, g) }
                    Err(e) {
                        die(["invalid glob in _ZO_EXCLUDE_DIRS: " + p,
                             "Pattern syntax error near position " + intToStr(e.pos) + ": " + e.msg])
                    }
                }
            }
        }
        None {
            match homeDir() {
                Some(h) {
                    // Pattern::escape(home): matches the home directory only
                    var toks: []Tok = []
                    for r in strings.runes(h) { append(mut &toks, Tok{kind: 0, ch: r, set: []}) }
                    append(mut &out, Glob{toks: toks})
                }
                None {}
            }
        }
    }
    return out
}

fn maxAge(): float {
    match os.env("_ZO_MAXAGE") {
        Some(v) {
            match parseU32(v) {
                Ok(n) { return float(n) }
                Err(m) { die(["unable to parse _ZO_MAXAGE as integer: " + v, m]) }
            }
        }
        None { return 10000.0f }
    }
}

// ---------------------------------------------------------------- database

type Dir = value record {
    path: str
    rank: float
    last: int
}

type Db = record {
    file: str
    dirs: []Dir
    dirty: bool
}

fn (d: &Dir) score(now: int): float {
    var dur = now - d.last
    if dur < 0 { dur = 0 }
    if dur < HOUR { return d.rank * 4.0f }
    if dur < DAY { return d.rank * 2.0f }
    if dur < WEEK { return d.rank * 0.5f }
    return d.rank * 0.25f
}

fn le(s: str, at: int, n: int): int {
    var v = 0
    for k in 0..n { v = v | (int(s[at + k]) << (8 * k)) }
    return v
}

fn dbOpen(): Db {
    let dir = dataDir()
    var file = dir + "/db.zo"
    match realpath(file) {
        Ok(p) { file = p }
        Err(_) {}
    }
    match io.read(file) {
        Ok(bytes) { return decode(file, bytes) }
        Err(e) {
            if e.errno == 2 {
                match fs.mkdirAll(dir) {
                    Ok(_) {}
                    Err(e2) { dieIo("unable to create data directory: " + dir, e2.errno) }
                }
                return Db{file: file, dirs: [], dirty: false}
            }
            dieIo("could not read from database: " + file, e.errno)
        }
    }
}

fn badDb(cause: str): never {
    die(["could not deserialize database", cause])
}

fn decode(file: str, s: str): Db {
    if len(s) < 4 { die1("could not deserialize database: corrupted data") }
    let version = le(s, 0, 4)
    if version != DB_VERSION {
        die1("unsupported version (got " + intToStr(version) + ", supports " + intToStr(DB_VERSION) + ")")
    }
    var pos = 4
    var budget = MAX_SIZE
    let eof = "io error: unexpected end of file"
    let limit = "the size limit has been reached"
    // the count
    if budget < 8 { badDb(limit) }
    if pos + 8 > len(s) { badDb(eof) }
    let count = le(s, pos, 8)
    pos += 8
    budget -= 8
    var dirs: []Dir = []
    var n = 0
    while n < count || count < 0 {
        if budget < 8 { badDb(limit) }
        if pos + 8 > len(s) { badDb(eof) }
        let plen = le(s, pos, 8)
        pos += 8
        budget -= 8
        if plen < 0 || plen > len(s) - pos { badDb("io error: ") }
        if plen > budget { badDb(limit) }
        let path = s[pos..pos + plen]
        pos += plen
        budget -= plen
        let bad = utf8Error(path)
        if bad != "" { badDb("string is not valid utf8: " + bad) }
        if budget < 16 { badDb(limit) }
        if pos + 16 > len(s) { badDb(eof) }
        let rank = floatOfBits(le(s, pos, 8))
        let last = le(s, pos + 8, 8)
        pos += 16
        budget -= 16
        append(mut &dirs, Dir{path: path, rank: rank, last: last})
        n += 1
    }
    if pos != len(s) { badDb("Slice had bytes remaining after deserialization") }
    return Db{file: file, dirs: dirs, dirty: false}
}

fn putLe(b: mut &StrBuf, v: int, n: int) {
    for k in 0..n { b.addByte(byte((v >> (8 * k)) & 0xff)) }
}

fn tmpName(): str {
    let alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    var x = time.monotonicNs() ^ (os.pid() << 32) ^ time.unixSeconds()
    var name = "tmp_"
    while len(name) < 16 {
        x = (x *% 6364136223846793005) +% 1442695040888963407
        name = name + alphabet[((x >> 33) & 0x7fffffff) % 62..((x >> 33) & 0x7fffffff) % 62 + 1]
    }
    return name
}

fn (db: mut &Db) save() {
    if !db.dirty { return }
    var b = newStrBuf()
    putLe(mut &b, DB_VERSION, 4)
    putLe(mut &b, len(db.dirs), 8)
    for d in db.dirs {
        putLe(mut &b, len(d.path), 8)
        b.add(d.path)
        putLe(mut &b, bitsOfFloat(d.rank), 8)
        putLe(mut &b, d.last, 8)
    }
    let tmp = fs.dirName(db.file) + "/" + tmpName()
    match io.write(tmp, b.toStr()) {
        Ok(_) {}
        Err(e) {
            if e.op == "open" {
                die(["could not write to database", "could not create file: " + tmp, osErr(e.errno)])
            }
            fs.remove(tmp)
            die(["could not write to database", "could not write to file: " + tmp, osErr(e.errno)])
        }
    }
    match fs.rename(tmp, db.file) {
        Ok(_) {}
        Err(e) {
            fs.remove(tmp)
            die(["could not write to database", "could not rename file: " + tmp + " -> " + db.file, osErr(e.errno)])
        }
    }
    db.dirty = false
}

fn (db: mut &Db) swapRemove(idx: int) {
    let last = len(db.dirs) - 1
    db.dirs[idx] = db.dirs[last]
    pop(mut &db.dirs)
    db.dirty = true
}

fn (db: mut &Db) addUpdate(path: str, by: float, now: int) {
    for i in 0..len(db.dirs) {
        if db.dirs[i].path == path {
            var r = db.dirs[i].rank + by
            if !(r > 0.0f) { r = 0.0f }
            db.dirs[i].rank = r
            db.dirs[i].last = now
            db.dirty = true
            return
        }
    }
    var r = by
    if !(r > 0.0f) { r = 0.0f }
    append(mut &db.dirs, Dir{path: path, rank: r, last: now})
    db.dirty = true
}

fn (db: mut &Db) addUnchecked(path: str, rank: float, now: int) {
    append(mut &db.dirs, Dir{path: path, rank: rank, last: now})
    db.dirty = true
}

fn (db: mut &Db) remove(path: str): bool {
    for i in 0..len(db.dirs) {
        if db.dirs[i].path == path {
            db.swapRemove(i)
            return true
        }
    }
    return false
}

fn (db: mut &Db) age(maxAge: float) {
    var total: float = 0.0f
    for d in db.dirs { total = total + d.rank }
    if total > maxAge {
        let factor = 0.9f * maxAge / total
        var idx = len(db.dirs)
        while idx > 0 {
            idx -= 1
            db.dirs[idx].rank = db.dirs[idx].rank * factor
            if db.dirs[idx].rank < 1.0f { db.swapRemove(idx) }
        }
        db.dirty = true
    }
}

fn negNaN(x: float): bool {
    let one: float = 1.0f
    return one.copySign(x) < 0.0f
}

// f64::total_cmp's key.
fn totalKey(x: float): int {
    let i = bitsOfFloat(x)
    if i < 0 { return i ^ 0x7fffffffffffffff }
    return i
}

fn byPath(a: &Dir, b: &Dir): int {
    if a.path < b.path { return -1 }
    if a.path > b.path { return 1 }
    return 0
}

fn (db: mut &Db) sortByPath() {
    collections.sortBy(mut &db.dirs, byPath)
    db.dirty = true
}

fn (db: mut &Db) sortByScore(now: int) {
    collections.sortBy(mut &db.dirs, fn(a: &Dir, b: &Dir): int {
        let x = a.score(now)
        let y = b.score(now)
        if x != x || y != y { return totalKey(x).cmp(&totalKey(y)) }
        if x < y { return -1 }
        if x > y { return 1 }
        return 0
    })
    db.dirty = true
}

fn (db: mut &Db) dedup() {
    db.sortByPath()
    var idx = len(db.dirs)
    while idx > 1 {
        idx -= 1
        if db.dirs[idx - 1].path != db.dirs[idx].path { continue }
        let rank = db.dirs[idx].rank
        let last = db.dirs[idx].last
        if last > db.dirs[idx - 1].last { db.dirs[idx - 1].last = last }
        db.dirs[idx - 1].rank = db.dirs[idx - 1].rank + rank
        db.swapRemove(idx)
    }
}

// ---------------------------------------------------------------- stream

type Stream = record {
    idx: int
    now: int
    keywords: []str
    exclude: []Glob
    exists: bool
    resolve: bool
    ttl: int
    base: Option[str]
}

// The last index of sub in s, or -1.
fn rfind(s: str, sub: str): int {
    var i = len(s) - len(sub)
    while i >= 0 {
        if s[i..i + len(sub)] == sub { return i }
        i -= 1
    }
    return -1
}

fn matchKeywords(keywords: &[str], path: str): bool {
    if len(keywords) == 0 { return true }
    var p = lower(path)
    let lastKw = keywords[len(keywords) - 1]
    let idx = rfind(p, lastKw)
    if idx < 0 { return false }
    if strings.indexOfByte(p[idx + len(lastKw)..], '/', 0) >= 0 { return false }
    p = p[..idx]
    var k = len(keywords) - 1
    while k > 0 {
        k -= 1
        let j = rfind(p, keywords[k])
        if j < 0 { return false }
        p = p[..j]
    }
    return true
}

fn (st: mut &Stream) next(db: mut &Db): Option[Dir] {
    while st.idx > 0 {
        st.idx -= 1
        let idx = st.idx
        let dir = db.dirs[idx]
        if !matchKeywords(&st.keywords, dir.path) { continue }
        match st.base {
            Some(b) {
                if !startsWithPath(dir.path, b) { continue }
            }
            None {}
        }
        var excluded = false
        for g in st.exclude {
            if globMatches(&g, dir.path) { excluded = true }
        }
        if excluded {
            db.swapRemove(idx)
            continue
        }
        if st.exists {
            var isDir = false
            if st.resolve {
                match fs.lstat(dir.path) {
                    Ok(s) { isDir = s.isDir() }
                    Err(_) {}
                }
            } else {
                match fs.stat(dir.path) {
                    Ok(s) { isDir = s.isDir() }
                    Err(_) {}
                }
            }
            if !isDir {
                if dir.last < st.ttl { db.swapRemove(idx) }
                continue
            }
        }
        return Some(dir)
    }
    return None
}

// ---------------------------------------------------------------- commands

fn cmdAdd(a: &Args) {
    var by: float = 1.0f
    match a.get("score") {
        Some(v) {
            match parseRustFloat(v) {
                Some(f) { by = f }
                None {}
            }
        }
        None {}
    }
    let excl = excludeDirs()
    let max = maxAge()
    let now = time.unixSeconds()
    var db = dbOpen()
    for arg in a.pos {
        var path = ""
        if resolveSymlinksOn() {
            match realpath(arg) {
                Ok(p) { path = p }
                Err(en) { dieIo("could not resolve path: " + arg, en) }
            }
        } else {
            path = resolvePath(arg)
        }
        let bad = utf8Error(path)
        if bad != "" { die1("invalid unicode in path: " + path) }
        if strings.indexOfByte(path, '\n', 0) >= 0 || strings.indexOfByte(path, '\r', 0) >= 0 { continue }
        var skip = false
        for g in excl {
            if globMatches(&g, path) { skip = true }
        }
        if skip { continue }
        if !fs.isDir(path) { die1("not a directory: " + path) }
        db.addUpdate(path, by, now)
    }
    if db.dirty { db.age(max) }
    db.save()
}

fn cmdRemove(a: &Args) {
    var db = dbOpen()
    for p in a.pos {
        if !db.remove(p) {
            let abs = resolvePath(p)
            if abs == p || !db.remove(abs) { die1("path not found in database: " + p) }
        }
    }
    db.save()
}

fn writeOut(w: mut &io.Writer, s: str) {
    w.write(s)
}

fn flushOut(w: mut &io.Writer) {
    match w.flush() {
        Ok(_) {}
        Err(e) {
            if e.errno == 32 { exit(0) }
            dieIo("could not write to stdout", e.errno)
        }
    }
}

fn dirLine(d: &Dir, score: bool, now: int): str {
    if score { return scoreText(d.score(now)) + " " + d.path }
    return d.path
}

fn cmdQuery(a: &Args) {
    var db = dbOpen()
    let err = queryRun(a, mut &db)
    db.save()
    if err != "" { die1(err) }
}

// Runs the query; the error message, or "".
fn queryRun(a: &Args, db: mut &Db): str {
    let now = time.unixSeconds()
    var kws: []str = []
    for k in a.pos { append(mut &kws, lower(k)) }
    let excl = excludeDirs()
    var st = Stream{idx: 0, now: now, keywords: kws, exclude: excl, exists: false, resolve: false,
        ttl: if now > 3 * MONTH { now - 3 * MONTH } else { 0 }, base: a.get("base-dir")}
    if !a.has("all") {
        st.exists = true
        st.resolve = resolveSymlinksOn()
    }
    db.sortByScore(now)
    st.idx = len(db.dirs)
    let exclude = a.get("exclude")
    let score = a.has("score")
    if a.has("interactive") { return queryInteractive(mut &st, db, exclude, score, now) }
    var w = io.stdout()
    if a.has("list") {
        while true {
            match st.next(db) {
                Some(d) {
                    if Some(d.path) == exclude { continue }
                    writeOut(mut &w, dirLine(&d, score, now) + "\n")
                }
                None { break }
            }
        }
        flushOut(mut &w)
        return ""
    }
    var first = st.next(db)
    if first.isNone() { return "no match found" }
    while Some(first.unwrap().path) == exclude {
        first = st.next(db)
        if first.isNone() { return "you are already in the only match" }
    }
    let d = first.unwrap()
    writeOut(mut &w, dirLine(&d, score, now) + "\n")
    flushOut(mut &w)
    return ""
}

fn queryInteractive(st: mut &Stream, db: mut &Db, exclude: Option[str], score: bool, now: int): str {
    var input = newStrBuf()
    while true {
        match st.next(db) {
            Some(d) {
                if Some(d.path) == exclude { continue }
                input.add(scoreText(d.score(now)) + "\t" + d.path)
                input.addByte(0)
            }
            None { break }
        }
    }
    var c = proc.command("fzf", ["--delimiter=\t", "--nth=2", "--read0"])
    match os.env("_ZO_FZF_OPTS") {
        Some(o) { c.setEnv("FZF_DEFAULT_OPTS", o) }
        None {
            for x in ["--exact", "--no-sort", "--bind=ctrl-z:ignore,btab:up,tab:down", "--cycle", "--keep-right",
                      "--border=sharp", "--height=45%", "--info=inline", "--layout=reverse", "--tabstop=1",
                      "--exit-0",
                      "--preview=\\command -p ls -Cp --color=always --group-directories-first {2..}",
                      "--preview-window=down,30%,sharp"] {
                c.arg(x)
            }
            c.setEnv("CLICOLOR", "1")
            c.setEnv("CLICOLOR_FORCE", "1")
            c.setEnv("SHELL", "sh")
        }
    }
    c.stdin = proc.Stdio.Pipe
    c.stdout = proc.Stdio.Pipe
    c.stderr = proc.Stdio.Inherit
    var bytes = strToBytes(input.toStr())
    match proc.communicate(&c, &bytes) {
        Err(e) {
            if e.isNotFound() { return "could not find fzf, is it installed?" }
            return "could not launch fzf"
        }
        Ok(out) {
            match out.exit {
                proc.Exit.Code(code) {
                    if code == 0 {
                        let sel = out.stdoutStr()
                        if score {
                            print(sel)
                        } else {
                            if len(sel) < 7 { return "could not read selection from fzf" }
                            print(sel[7..])
                        }
                        return ""
                    }
                    if code == 1 { return "no match found" }
                    if code == 2 { return "fzf returned an error" }
                    if code == 130 { exit(130) }
                    if code >= 128 && code <= 254 { return "fzf was terminated" }
                    return "fzf returned an unknown error"
                }
                proc.Exit.Signaled(_) { return "fzf was terminated" }
            }
        }
    }
}

fn sigmoid(x: float): float {
    // x86 gives a negative NaN here
    if x != x { return math.nan().copySign(-1.0f) }
    return 1.0f / (1.0f + (-x).exp())
}

// line without a final '\r'.
fn noCR(line: &str): &str {
    if len(line) > 0 && line[len(line) - 1] == '\r' { return line[..len(line) - 1] }
    return line
}

fn cmdImport(a: &Args) {
    let path = a.pos[0]
    var buffer = ""
    match io.read(path) {
        Ok(s) { buffer = s }
        Err(e) { dieIo("could not open database for importing: " + path, e.errno) }
    }
    if utf8Error(buffer) != "" {
        die(["could not open database for importing: " + path, "stream did not contain valid UTF-8"])
    }
    var db = dbOpen()
    if !a.has("merge") && len(db.dirs) > 0 {
        die1("current database is not empty, specify --merge to continue anyway")
    }
    let from = a.get("from").unwrap()
    for line in strings.lines(&buffer) {
        let l = noCR(&line)
        if l == "" { continue }
        if from == "autojump" {
            let c = strings.cut(&l, "\t")
            match c {
                None { die(["import error", "invalid entry: " + l]) }
                Some(cut) {
                    match parseRustFloat(cut.before) {
                        None { die(["import error", "invalid rank: " + cut.before, "invalid float literal"]) }
                        Some(r) { db.addUnchecked(cut.after, sigmoid(r), 0) }
                    }
                }
            }
        } else {
            // path|rank|epoch, split from the right
            let i2 = rfind(l, "|")
            if i2 < 0 {
                match parseU64(l) {
                    Err(m) { die(["import error", "invalid epoch: " + l, m]) }
                    Ok(_) { die(["import error", "invalid entry: " + l]) }
                }
            }
            let epoch = l[i2 + 1..]
            let head = l[..i2]
            let i1 = rfind(head, "|")
            let rankText = if i1 < 0 { head } else { head[i1 + 1..] }
            let p = if i1 < 0 { "" } else { head[..i1] }
            match parseU64(epoch) {
                Err(m) { die(["import error", "invalid epoch: " + epoch, m]) }
                Ok(ep) {
                    match parseRustFloat(rankText) {
                        None { die(["import error", "invalid rank: " + rankText, "invalid float literal"]) }
                        Some(r) {
                            if i1 < 0 { die(["import error", "invalid entry: " + l]) }
                            db.addUnchecked(p, r, ep)
                        }
                    }
                }
            }
        }
    }
    if db.dirty { db.dedup() }
    db.save()
}

fn cmdInit(a: &Args) {
    var shell = a.pos[0]
    if shell == "ksh" { shell = "posix" }
    var cmd: Option[str] = Some(a.get("cmd").unwrapOr("z"))
    if a.has("no-cmd") { cmd = None }
    var hook = zoxide_init.Hook.Pwd
    match a.get("hook") {
        Some(h) {
            if h == "none" { hook = zoxide_init.Hook.Off }
            if h == "prompt" { hook = zoxide_init.Hook.Prompt }
        }
        None {}
    }
    let o = zoxide_init.InitOpts{cmd: cmd, hook: hook, echo: echoOn(), resolveSymlinks: resolveSymlinksOn()}
    var w = io.stdout()
    writeOut(mut &w, zoxide_init.render(shell, &o) + "\n")
    flushOut(mut &w)
}

fn main() {
    let argv = os.arguments()
    if len(argv) == 0 {
        eprint(helpTop())
        exit(2)
    }
    let first = argv[0]
    if first == "-h" || first == "--help" { printHelp("") }
    if first == "-V" || first == "--version" { printVersion("") }
    match first {
        "add", "query", "remove", "init", "import" {
            let a = parseSub(first, argv, 1)
            match first {
                "add" { cmdAdd(&a) }
                "query" { cmdQuery(&a) }
                "remove" { cmdRemove(&a) }
                "init" { cmdInit(&a) }
                else { cmdImport(&a) }
            }
        }
        "edit" {
            if len(argv) > 1 && argv[1] != "decrement" && argv[1] != "delete" && argv[1] != "increment" && argv[1] != "reload" {
                if argv[1] == "-h" || argv[1] == "--help" { printHelp("") }
                if len(argv[1]) > 1 && argv[1][0] == '-' {
                    clapUsageDie("unexpected argument '" + argv[1] + "' found", "zoxide edit")
                }
                clapUsageDie("unrecognized subcommand '" + argv[1] + "'", "zoxide edit")
            }
            die1("edit is not supported by this port")
        }
        else {
            if len(first) > 1 && first[0] == '-' {
                clapUsageDie("unexpected argument '" + first + "' found", "zoxide <COMMAND>")
            }
            clapUsageDie("unrecognized subcommand '" + first + "'", "zoxide <COMMAND>")
        }
    }
}

