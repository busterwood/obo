    "  _ZO_FZF_OPTS          Custom flags to pass to fzf\n" +
    "  _ZO_MAXAGE            Maximum total age after which entries start getting deleted\n" +
    "  _ZO_RESOLVE_SYMLINKS  Resolve symlinks when storing paths\n"

