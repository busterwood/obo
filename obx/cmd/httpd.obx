// httpd: a small HTTP/1.1 server on lib/httpserver (design/http-server.md,
// stage S1; before it, the gates of stages C1b, C1c and C2 of
// design/concurrency.md). One task per connection, keep-alive by default.
//
//     httpd [ADDR [POOL [WORKERS [MODE]]]]
//         ADDR     host:port, default 127.0.0.1:8080 (port 0: any)
//         POOL     connections of the Postgres pool, default 0: no /db
//         WORKERS  worker processes (task.workers), default 0: serve in this
//                  process
//         MODE     with WORKERS: "shared" (default), one listener made before
//                  the fork and shared by the workers (one accept queue), or
//                  "reuseport", a listener of its own in each worker on the
//                  same port (SO_REUSEPORT: the kernel spreads connections)
//
// The pool connects to $OBX_PG_DSN (default the local socket,
// host=/var/run/postgresql dbname=postgres), at most POOL connections, opened
// as requests need them. With WORKERS each worker has its own pool: up to
// WORKERS x POOL connections to the database in all. It prints
// "listening on HOST:PORT" once it listens (with WORKERS, then a line saying
// how many and how they listen).
// Routes (GET also answers HEAD):
//     GET /             "hello, world\n"
//     GET /db           one query through the pool (SELECT $1::int8 + 1, $1 the
//                       worker's request count): "db N\n"; 503 without a pool
//                       or when the query fails
//     GET /stats        counters: open connections, accepted, requests; with
//                       WORKERS those of the worker that answers ("worker I"
//                       first): the workers share no memory
//     GET /shutdown     "bye\n", then a graceful stop: no new connections, the
//                       idle ones closed, the requests in flight finished
//                       (http.serve's drain); the program prints its counters
//                       and ends. With WORKERS the whole server stops: the
//                       worker asks the supervisor (task.stopWorkers), which
//                       sends SIGTERM to every worker; each drains and prints
//                       its own counters, then the supervisor one line per
//                       worker.
// SIGTERM or SIGINT (Ctrl-C) is the same graceful stop, with or without
// WORKERS.
// Anything else is the library's: 404, 405 with Allow for another method, and
// for a request it refuses (malformed, smuggling, over a limit) a 4xx and the
// connection closed (lib/README.md, the server's rules). Request bodies,
// Content-Length or chunked, are read and dropped (up to 1 MiB). Pipelined
// requests are answered in order.
import "task"
import "net"
import "io"
import "os"
import "strings"
import "postgres"
import "httpserver" as http

// What every handler gets: handles only, so a copy type; each connection's
// task has its own copy.
type App = value record {
    db: Option[postgres.Pool]
    worker: int                       // the worker's index, or -1 without workers
}

const HELLO = "hello, world\n"

fn hello(app: &App, rq: mut &http.Request, w: mut &http.Response): Result[Unit, http.Error] {
    return w.text(HELLO)
}

fn db(app: &App, rq: mut &http.Request, w: mut &http.Response): Result[Unit, http.Error] {
    match app.db {
        Some(pool) {
            match query(&pool, rq.serverStats().requests) {
                Ok(v) { return w.text("db " + intToStr(v) + "\n") }
                Err(e) {
                    w.status(503)
                    return w.text(e.toStr() + "\n")
                }
            }
        }
        None {
            w.status(503)
            return w.text("no database\n")
        }
    }
}

fn stats(app: &App, rq: mut &http.Request, w: mut &http.Response): Result[Unit, http.Error] {
    let s = rq.serverStats()
    let who = if app.worker >= 0 { "worker " + intToStr(app.worker) + "\n" } else { "" }
    return w.text(who + "open " + intToStr(s.open) + "\naccepted " + intToStr(s.accepted) + "\nrequests " + intToStr(s.requests) + "\n")
}

fn shutdown(app: &App, rq: mut &http.Request, w: mut &http.Response): Result[Unit, http.Error] {
    if app.worker >= 0 {
        let asked = task.stopWorkers()        // asking twice is one request
    } else {
        rq.stopServer()
    }
    w.header("Connection", "close")
    return w.text("bye\n")
}

// One query on a connection of the pool, given back when the lease drops.
fn query(pool: &postgres.Pool, n: int): Result[int, postgres.Error] {
    var c = try pool.acquire()
    let rows = try c.query("SELECT $1::int8 + 1", &[postgres.Value.Int(n)])
    return rows.int(0, 0)
}

fn routes(): http.Router[App] {
    var r = http.router[App]()
    r.handle("GET /{$}", hello)
    r.handle("GET /db", db)
    r.handle("GET /stats", stats)
    r.handle("GET /shutdown", shutdown)
    return r
}

// ---- main

// Serves on ln until /shutdown, SIGTERM or SIGINT; then prints its counters.
fn run(ln: net.Listener, size: int, worker: int) {
    let pool: Option[postgres.Pool] =
        if size > 0 { Some(postgres.newPool(os.envOr("OBX_PG_DSN", "host=/var/run/postgresql dbname=postgres"), size)) } else { None }
    var cfg = http.defaults()
    cfg.maxConns = 30000                  // the gates hold 10,000 idle connections and more
    let who = if worker >= 0 { "worker " + intToStr(worker) + ": " } else { "" }
    match http.serve(ln, App{db: pool, worker: worker}, routes(), cfg) {
        Ok(s) {
            var pg = ""
            match &pool {
                Some(p) {
                    let ps = p.stats()
                    pg = ", pool open " + intToStr(ps.open) + " idle " + intToStr(ps.idle) + " waiting " + intToStr(ps.waiting)
                }
                None {}
            }
            println("stopped: " + who + "accepted " + intToStr(s.accepted) + ", requests " + intToStr(s.requests) +
                    ", open " + intToStr(s.open) + pg)
        }
        Err(e) {
            eprintln("httpd: " + who + e.toStr())
            os.quit(1)
        }
    }
}

fn listenOr(addr: str, reuseport: bool): net.Listener {
    let r = if reuseport { net.listenReusePort(addr) } else { net.listen(addr) }
    match move(r) {
        Ok(ln) { return ln }
        Err(e) {
            eprintln("httpd: " + e.toStr())
            os.quit(1)
        }
    }
}

// WORKERS processes, supervised by this one (task.workersWith and the
// server's policy: a worker that crashes after it serves is restarted, and
// such crashes never make the supervisor give up).
fn runWorkers(addr: str, size: int, n: int, reuseport: bool) {
    var lst: Option[net.Listener] = None
    var at = addr
    if reuseport {
        // the workers listen; this socket only fixes the port when ADDR's is 0
        // (each worker's port 0 would be a port of its own). It is closed before
        // the fork: open, it would take connections that nobody accepts.
        var probe = Some(listenOr(addr, true))
        match &probe {
            Some(l) { at = l.localAddr() }
            None {}
        }
        probe = None
    } else {
        let ln = listenOr(addr, false)
        at = ln.localAddr()
        lst = Some(ln)
    }
    println("listening on " + at)
    println(intToStr(n) + " workers, " + (if reuseport { "a listener in each (reuseport)" } else { "one shared listener" }))
    io.flushStdout().unwrap()
    let r = task.workersWith(n, http.workerPolicy(), fn(i: int) {
        task.watchSignals(&[task.SIGTERM, task.SIGINT])   // before anything: a stop is never lost
        let ln = if reuseport { listenOr(at, true) } else { replace(mut &lst, None).unwrap() }
        run(ln, size, i)
    })
    match r {
        Ok(ends) { for e in ends { println("stopped: " + e.toStr()) } }
        Err(g) {
            for e in g.ends { println("stopped: " + e.toStr()) }
            eprintln("httpd: " + g.toStr())
            os.quit(1)
        }
    }
}

fn main() {
    let args = os.arguments()
    let addr = if len(args) > 0 { args[0] } else { "127.0.0.1:8080" }
    let size = if len(args) > 1 { strings.parseInt(args[1]).unwrapOr(0) } else { 0 }
    let n = if len(args) > 2 { strings.parseInt(args[2]).unwrapOr(0) } else { 0 }
    let mode = if len(args) > 3 { args[3] } else { "shared" }
    if mode != "shared" && mode != "reuseport" {
        eprintln("httpd: MODE is shared or reuseport, not " + mode)
        os.quit(2)
    }
    if n > 0 {
        runWorkers(addr, size, n, mode == "reuseport")
        return
    }
    task.watchSignals(&[task.SIGTERM, task.SIGINT])
    let ln = listenOr(addr, false)
    println("listening on " + ln.localAddr())
    io.flushStdout().unwrap()
    run(ln, size, -1)
}
