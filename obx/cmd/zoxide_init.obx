// Generated by cmd/zoxide_gen.py from the shell templates of zoxide 0.9.9; do not edit.
// render(shell, opts) is `zoxide init <shell>` without its final newline.

pub type Hook = value closed { Off; Prompt; Pwd }

pub type InitOpts = record {
    pub cmd: Option[str]       // the prefix of z and zi, None for --no-cmd
    pub hook: Hook
    pub echo: bool             // _ZO_ECHO=1
    pub resolveSymlinks: bool  // _ZO_RESOLVE_SYMLINKS=1
}

pub fn shells(): []str { return ["bash", "elvish", "fish", "nushell", "posix", "powershell", "tcsh", "xonsh", "zsh"] }

pub fn render(shell: str, o: &InitOpts): str {
    var b = newStrBuf()
    match shell {
        "bash" { bash(o, mut &b) }
        "elvish" { elvish(o, mut &b) }
        "fish" { fish(o, mut &b) }
        "nushell" { nushell(o, mut &b) }
        "posix" { posix(o, mut &b) }
        "powershell" { powershell(o, mut &b) }
        "tcsh" { tcsh(o, mut &b) }
        "xonsh" { xonsh(o, mut &b) }
        "zsh" { zsh(o, mut &b) }
        else { panic("zoxide_init: unknown shell") }
    }
    return b.toStr()
}

fn bash(o: &InitOpts, b: mut &StrBuf) {
    b.add("# shellcheck shell=bash\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Utility functions for zoxide.\n")
    b.add("#\n")
    b.add("\n")
    b.add("# pwd based on the value of _ZO_RESOLVE_SYMLINKS.\n")
    b.add("function __zoxide_pwd() {")
    if o.resolveSymlinks {
        b.add("\n")
        b.add("    \\builtin pwd -P")
    } else {
        b.add("\n")
        b.add("    \\builtin pwd -L")
    }
    b.add("\n")
    b.add("}\n")
    b.add("\n")
    b.add("# cd + custom logic based on the value of _ZO_ECHO.\n")
    b.add("function __zoxide_cd() {\n")
    b.add("    # shellcheck disable=SC2164\n")
    b.add("    \\builtin cd -- \"$@\"")
    if o.echo {
        b.add(" && __zoxide_pwd")
    }
    b.add("\n")
    b.add("}\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Hook configuration for zoxide.\n")
    b.add("#")
    if o.hook != Hook.Off {
        b.add("\n")
        b.add("\n")
        b.add("# Hook to add new entries to the database.")
        if o.hook == Hook.Prompt {
            b.add("\n")
            b.add("function __zoxide_hook() {\n")
            b.add("    \\builtin local -r retval=\"$?\"\n")
            b.add("    # shellcheck disable=SC2312\n")
            b.add("    \\command zoxide add -- \"$(__zoxide_pwd)\"\n")
            b.add("    return \"${retval}\"\n")
            b.add("}")
        } else if o.hook == Hook.Pwd {
            b.add("\n")
            b.add("__zoxide_oldpwd=\"$(__zoxide_pwd)\"\n")
            b.add("\n")
            b.add("function __zoxide_hook() {\n")
            b.add("    \\builtin local -r retval=\"$?\"\n")
            b.add("    \\builtin local pwd_tmp\n")
            b.add("    pwd_tmp=\"$(__zoxide_pwd)\"\n")
            b.add("    if [[ ${__zoxide_oldpwd} != \"${pwd_tmp}\" ]]; then\n")
            b.add("        __zoxide_oldpwd=\"${pwd_tmp}\"\n")
            b.add("        \\command zoxide add -- \"${__zoxide_oldpwd}\"\n")
            b.add("    fi\n")
            b.add("    return \"${retval}\"\n")
            b.add("}")
        }
        b.add("\n")
        b.add("\n")
        b.add("# Initialize hook.\n")
        b.add("if [[ ${PROMPT_COMMAND:=} != *'__zoxide_hook'* ]]; then\n")
        b.add("    if [[ \"$(declare -p PROMPT_COMMAND 2>&1)\" == \"declare -a\"* ]]; then\n")
        b.add("        PROMPT_COMMAND=(\"${PROMPT_COMMAND[@]}\" __zoxide_hook)\n")
        b.add("    else\n")
        b.add("        # shellcheck disable=SC2128,SC2178\n")
        b.add("        PROMPT_COMMAND=\"${PROMPT_COMMAND%\"${PROMPT_COMMAND##*[![:space:]]}\"}\"\n")
        b.add("        # shellcheck disable=SC2128,SC2178\n")
        b.add("        PROMPT_COMMAND=\"${PROMPT_COMMAND:+${PROMPT_COMMAND};}__zoxide_hook\"\n")
        b.add("    fi\n")
        b.add("fi")
    }
    b.add("\n")
    b.add("\n")
    b.add("# Report common issues.\n")
    b.add("function __zoxide_doctor() {")
    if o.hook == Hook.Off {
        b.add("\n")
        b.add("    return 0")
    } else {
        b.add("\n")
        b.add("    [[ ${_ZO_DOCTOR:-1} -eq 0 ]] && return 0\n")
        b.add("    # shellcheck disable=SC2199\n")
        b.add("    [[ ${PROMPT_COMMAND[@]:-} == *'__zoxide_hook'* ]] && return 0\n")
        b.add("    # shellcheck disable=SC2199\n")
        b.add("    [[ ${__vsc_original_prompt_command[@]:-} == *'__zoxide_hook'* ]] && return 0\n")
        b.add("\n")
        b.add("    _ZO_DOCTOR=0\n")
        b.add("    \\builtin printf '%s\\n' \\\n")
        b.add("        'zoxide: detected a possible configuration issue.' \\\n")
        b.add("        'Please ensure that zoxide is initialized right at the end of your shell configuration file (usually ~/.bashrc).' \\\n")
        b.add("        '' \\\n")
        b.add("        'If the issue persists, consider filing an issue at:' \\\n")
        b.add("        'https://github.com/ajeetdsouza/zoxide/issues' \\\n")
        b.add("        '' \\\n")
        b.add("        'Disable this message by setting _ZO_DOCTOR=0.' \\\n")
        b.add("        '' >&2")
    }
    b.add("\n")
    b.add("}\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# When using zoxide with --no-cmd, alias these internal functions as desired.\n")
    b.add("#\n")
    b.add("\n")
    b.add("__zoxide_z_prefix='z#'\n")
    b.add("\n")
    b.add("# Jump to a directory using only keywords.\n")
    b.add("function __zoxide_z() {\n")
    b.add("    __zoxide_doctor\n")
    b.add("\n")
    b.add("    # shellcheck disable=SC2199\n")
    b.add("    if [[ $# -eq 0 ]]; then\n")
    b.add("        __zoxide_cd ~\n")
    b.add("    elif [[ $# -eq 1 && $1 == '-' ]]; then\n")
    b.add("        __zoxide_cd \"${OLDPWD}\"\n")
    b.add("    elif [[ $# -eq 1 && -d $1 ]]; then\n")
    b.add("        __zoxide_cd \"$1\"\n")
    b.add("    elif [[ $# -eq 2 && $1 == '--' ]]; then\n")
    b.add("        __zoxide_cd \"$2\"\n")
    b.add("    elif [[ ${@: -1} == \"${__zoxide_z_prefix}\"?* ]]; then\n")
    b.add("        # shellcheck disable=SC2124\n")
    b.add("        \\builtin local result=\"${@: -1}\"\n")
    b.add("        __zoxide_cd \"")
    b.add("${result:${#__zoxide_z_prefix}}")
    b.add("\"\n")
    b.add("    else\n")
    b.add("        \\builtin local result\n")
    b.add("        # shellcheck disable=SC2312\n")
    b.add("        result=\"$(\\command zoxide query --exclude \"$(__zoxide_pwd)\" -- \"$@\")\" &&\n")
    b.add("            __zoxide_cd \"${result}\"\n")
    b.add("    fi\n")
    b.add("}\n")
    b.add("\n")
    b.add("# Jump to a directory using interactive search.\n")
    b.add("function __zoxide_zi() {\n")
    b.add("    __zoxide_doctor\n")
    b.add("    \\builtin local result\n")
    b.add("    result=\"$(\\command zoxide query --interactive -- \"$@\")\" && __zoxide_cd \"${result}\"\n")
    b.add("}\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Commands for zoxide. Disable these using --no-cmd.\n")
    b.add("#")
    match o.cmd {
        Some(cmd) {
            b.add("\n")
            b.add("\n")
            b.add("\\builtin unalias ")
            b.add(cmd)
            b.add(" &>/dev/null || \\builtin true\n")
            b.add("function ")
            b.add(cmd)
            b.add("() {\n")
            b.add("    __zoxide_z \"$@\"\n")
            b.add("}\n")
            b.add("\n")
            b.add("\\builtin unalias ")
            b.add(cmd)
            b.add("i &>/dev/null || \\builtin true\n")
            b.add("function ")
            b.add(cmd)
            b.add("i() {\n")
            b.add("    __zoxide_zi \"$@\"\n")
            b.add("}\n")
            b.add("\n")
            b.add("# Load completions.\n")
            b.add("# - Bash 4.4+ is required to use `@Q`.\n")
            b.add("# - Completions require line editing. Since Bash supports only two modes of\n")
            b.add("#   line editing (`vim` and `emacs`), we check if either them is enabled.\n")
            b.add("# - Completions don't work on `dumb` terminals.\n")
            b.add("if [[ ${BASH_VERSINFO[0]:-0} -eq 4 && ${BASH_VERSINFO[1]:-0} -ge 4 || ${BASH_VERSINFO[0]:-0} -ge 5 ]] &&\n")
            b.add("    [[ :\"${SHELLOPTS}\": =~ :(vi|emacs): && ${TERM} != 'dumb' ]]; then\n")
            b.add("\n")
            b.add("    function __zoxide_z_complete_helper() {\n")
            b.add("        READLINE_LINE=\"")
            b.add(cmd)
            b.add(" ${__zoxide_result@Q}\"\n")
            b.add("        READLINE_POINT=")
            b.add("${#READLINE_LINE}")
            b.add("\n")
            b.add("        bind '\"\\e[0n\": accept-line'\n")
            b.add("        \\builtin printf '\\e[5n' >/dev/tty\n")
            b.add("    }\n")
            b.add("\n")
            b.add("    function __zoxide_z_complete() {\n")
            b.add("        # Only show completions when the cursor is at the end of the line.\n")
            b.add("        [[ ")
            b.add("${#COMP_WORDS[@]}")
            b.add(" -eq $((COMP_CWORD + 1)) ]] || return\n")
            b.add("\n")
            b.add("        # If there is only one argument, use `cd` completions.\n")
            b.add("        if [[ ")
            b.add("${#COMP_WORDS[@]}")
            b.add(" -eq 2 ]]; then\n")
            b.add("            \\builtin mapfile -t COMPREPLY < <(\n")
            b.add("                \\builtin compgen -A directory -- \"${COMP_WORDS[-1]}\" || \\builtin true\n")
            b.add("            )\n")
            b.add("        # If there is a space after the last word, use interactive selection.\n")
            b.add("        elif [[ -z ${COMP_WORDS[-1]} ]]; then\n")
            b.add("            # shellcheck disable=SC2312\n")
            b.add("            __zoxide_result=\"$(\\command zoxide query --exclude \"$(__zoxide_pwd)\" --interactive -- \"")
            b.add("${COMP_WORDS[@]:1:${#COMP_WORDS[@]}-2}")
            b.add("\")\" && {\n")
            b.add("                # In case the terminal does not respond to \\e[5n or another\n")
            b.add("                # mechanism steals the response, it is still worth completing\n")
            b.add("                # the directory in the command line.\n")
            b.add("                COMPREPLY=(\"${__zoxide_z_prefix}${__zoxide_result}/\")\n")
            b.add("\n")
            b.add("                # Note: We here call \"bind\" without prefixing \"\\builtin\" to be\n")
            b.add("                # compatible with frameworks like ble.sh, which emulates Bash's\n")
            b.add("                # builtin \"bind\".\n")
            b.add("                bind -x '\"\\e[0n\": __zoxide_z_complete_helper'\n")
            b.add("                \\builtin printf '\\e[5n' >/dev/tty\n")
            b.add("            }\n")
            b.add("        fi\n")
            b.add("    }\n")
            b.add("\n")
            b.add("    \\builtin complete -F __zoxide_z_complete -o filenames -- ")
            b.add(cmd)
            b.add("\n")
            b.add("    \\builtin complete -r ")
            b.add(cmd)
            b.add("i &>/dev/null || \\builtin true\n")
            b.add("fi")
        }
        None {
            b.add("\n")
            b.add("\n")
            b.add("# -- not configured --")
        }
    }
    b.add("\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# To initialize zoxide, add this to your shell configuration file (usually ~/.bashrc):\n")
    b.add("#\n")
    b.add("# eval \"$(zoxide init bash)\"")
}

fn elvish(o: &InitOpts, b: mut &StrBuf) {
    b.add("use builtin\n")
    b.add("use path\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Utility functions for zoxide.\n")
    b.add("#\n")
    b.add("\n")
    b.add("# cd + custom logic based on the value of _ZO_ECHO.\n")
    b.add("fn __zoxide_cd {|path|\n")
    b.add("    builtin:cd $path")
    if o.echo {
        b.add("\n")
        b.add("    builtin:echo $pwd")
    }
    b.add("\n")
    b.add("}\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Hook configuration for zoxide.\n")
    b.add("#\n")
    b.add("\n")
    b.add("# Initialize hook to track previous directory.\n")
    b.add("var oldpwd = $builtin:pwd\n")
    b.add("set builtin:before-chdir = [$@builtin:before-chdir {|_| set oldpwd = $builtin:pwd }]\n")
    b.add("\n")
    b.add("# Initialize hook to add directories to zoxide.")
    if o.hook == Hook.Off {
        b.add("\n")
        b.add("# -- not configured --")
    } else {
        b.add("\n")
        b.add("if (builtin:not (builtin:eq $E:__zoxide_shlvl $E:SHLVL)) {\n")
        b.add("    set E:__zoxide_shlvl = $E:SHLVL")
        if o.hook == Hook.Prompt {
            b.add("\n")
            b.add("    set edit:before-readline = [$@edit:before-readline {|| zoxide add -- $pwd }]")
        } else if o.hook == Hook.Pwd {
            b.add("\n")
            b.add("    set builtin:after-chdir = [$@builtin:after-chdir {|_| zoxide add -- $pwd }]")
        }
        b.add("\n")
        b.add("}")
    }
    b.add("\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# When using zoxide with --no-cmd, alias these internal functions as desired.\n")
    b.add("#\n")
    b.add("\n")
    b.add("# Jump to a directory using only keywords.\n")
    b.add("fn __zoxide_z {|@rest|\n")
    b.add("    if (builtin:eq [] $rest) {\n")
    b.add("        __zoxide_cd ~\n")
    b.add("    } elif (builtin:eq [-] $rest) {\n")
    b.add("        __zoxide_cd $oldpwd\n")
    b.add("    } elif (and ('builtin:==' (builtin:count $rest) 1) (path:is-dir &follow-symlink=$true $rest[0])) {\n")
    b.add("        __zoxide_cd $rest[0]\n")
    b.add("    } else {\n")
    b.add("        var path\n")
    b.add("        try {\n")
    b.add("            set path = (zoxide query --exclude $pwd -- $@rest)\n")
    b.add("        } catch {\n")
    b.add("        } else {\n")
    b.add("            __zoxide_cd $path\n")
    b.add("        }\n")
    b.add("    }\n")
    b.add("}\n")
    b.add("edit:add-var __zoxide_z~ $__zoxide_z~\n")
    b.add("\n")
    b.add("# Jump to a directory using interactive search.\n")
    b.add("fn __zoxide_zi {|@rest|\n")
    b.add("    var path\n")
    b.add("    try {\n")
    b.add("        set path = (zoxide query --interactive -- $@rest)\n")
    b.add("    } catch {\n")
    b.add("    } else {\n")
    b.add("        __zoxide_cd $path\n")
    b.add("    }\n")
    b.add("}\n")
    b.add("edit:add-var __zoxide_zi~ $__zoxide_zi~\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Commands for zoxide. Disable these using --no-cmd.\n")
    b.add("#")
    match o.cmd {
        Some(cmd) {
            b.add("\n")
            b.add("\n")
            b.add("edit:add-var ")
            b.add(cmd)
            b.add("~ $__zoxide_z~\n")
            b.add("edit:add-var ")
            b.add(cmd)
            b.add("i~ $__zoxide_zi~\n")
            b.add("\n")
            b.add("# Load completions.")
            b.add("\n")
            b.add("fn __zoxide_z_complete {|@rest|\n")
            b.add("    if (!= (builtin:count $rest) 2) {\n")
            b.add("        builtin:return\n")
            b.add("    }\n")
            b.add("    edit:complete-filename $rest[1] |\n")
            b.add("        builtin:each {|completion|\n")
            b.add("            var dir = $completion[stem]\n")
            b.add("            if (path:is-dir $dir) {\n")
            b.add("                builtin:put $dir\n")
            b.add("            }\n")
            b.add("        }\n")
            b.add("}\n")
            b.add("set edit:completion:arg-completer[")
            b.add(cmd)
            b.add("] = $__zoxide_z_complete~")
        }
        None {
            b.add("\n")
            b.add("\n")
            b.add("# -- not configured --")
        }
    }
    b.add("\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# To initialize zoxide, add this to your configuration (usually\n")
    b.add("# ~/.elvish/rc.elv):\n")
    b.add("#\n")
    b.add("#   eval (zoxide init elvish | slurp)\n")
    b.add("#\n")
    b.add("# Note: zoxide only supports elvish v0.18.0 and above.")
}

fn fish(o: &InitOpts, b: mut &StrBuf) {
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Utility functions for zoxide.\n")
    b.add("#\n")
    b.add("\n")
    b.add("# pwd based on the value of _ZO_RESOLVE_SYMLINKS.\n")
    b.add("function __zoxide_pwd")
    if o.resolveSymlinks {
        b.add("\n")
        b.add("    builtin pwd -P")
    } else {
        b.add("\n")
        b.add("    builtin pwd -L")
    }
    b.add("\n")
    b.add("end\n")
    b.add("\n")
    b.add("# A copy of fish's internal cd function. This makes it possible to use\n")
    b.add("# `alias cd=z` without causing an infinite loop.\n")
    b.add("if ! builtin functions --query __zoxide_cd_internal\n")
    b.add("    if status list-files functions/cd.fish &>/dev/null\n")
    b.add("        status get-file functions/cd.fish | string replace --regex -- '^function cd\\s' 'function __zoxide_cd_internal ' | source\n")
    b.add("    else\n")
    b.add("        string replace --regex -- '^function cd\\s' 'function __zoxide_cd_internal ' <$__fish_data_dir/functions/cd.fish | source\n")
    b.add("    end\n")
    b.add("end\n")
    b.add("\n")
    b.add("# cd + custom logic based on the value of _ZO_ECHO.\n")
    b.add("function __zoxide_cd\n")
    b.add("    if set -q __zoxide_loop\n")
    b.add("        builtin echo \"zoxide: infinite loop detected\"\n")
    b.add("        builtin echo \"Avoid aliasing `cd` to `z` directly, use `zoxide init --cmd=cd fish` instead\"\n")
    b.add("        return 1\n")
    b.add("    end")
    b.add("\n")
    b.add("    __zoxide_loop=1 __zoxide_cd_internal $argv")
    if o.echo {
        b.add("\n")
        b.add("    and __zoxide_pwd")
    }
    b.add("\n")
    b.add("end\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Hook configuration for zoxide.\n")
    b.add("#\n")
    b.add("\n")
    if o.hook == Hook.Off {
        b.add("# -- not configured --")
    } else {
        b.add("# Initialize hook to add new entries to the database.")
        if o.hook == Hook.Prompt {
            b.add("\n")
            b.add("function __zoxide_hook --on-event fish_prompt")
        } else if o.hook == Hook.Pwd {
            b.add("\n")
            b.add("function __zoxide_hook --on-variable PWD")
        }
        b.add("\n")
        b.add("    test -z \"$fish_private_mode\"\n")
        b.add("    and command zoxide add -- (__zoxide_pwd)\n")
        b.add("end")
    }
    b.add("\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# When using zoxide with --no-cmd, alias these internal functions as desired.\n")
    b.add("#\n")
    b.add("\n")
    b.add("# Jump to a directory using only keywords.\n")
    b.add("function __zoxide_z\n")
    b.add("    set -l argc (builtin count $argv)\n")
    b.add("    if test $argc -eq 0\n")
    b.add("        __zoxide_cd $HOME\n")
    b.add("    else if test \"$argv\" = -\n")
    b.add("        __zoxide_cd -\n")
    b.add("    else if test $argc -eq 1 -a -d $argv[1]\n")
    b.add("        __zoxide_cd $argv[1]\n")
    b.add("    else if test $argc -eq 2 -a $argv[1] = --\n")
    b.add("        __zoxide_cd -- $argv[2]\n")
    b.add("    else\n")
    b.add("        set -l result (command zoxide query --exclude (__zoxide_pwd) -- $argv)\n")
    b.add("        and __zoxide_cd $result\n")
    b.add("    end\n")
    b.add("end\n")
    b.add("\n")
    b.add("# Completions.\n")
    b.add("function __zoxide_z_complete\n")
    b.add("    set -l tokens (builtin commandline --current-process --tokenize)\n")
    b.add("    set -l curr_tokens (builtin commandline --cut-at-cursor --current-process --tokenize)\n")
    b.add("\n")
    b.add("    if test (builtin count $tokens) -le 2 -a (builtin count $curr_tokens) -eq 1\n")
    b.add("        # If there are < 2 arguments, use `cd` completions.\n")
    b.add("        complete --do-complete \"'' \"(builtin commandline --cut-at-cursor --current-token) | string match --regex -- '.*/$'\n")
    b.add("    else if test (builtin count $tokens) -eq (builtin count $curr_tokens)\n")
    b.add("        # If the last argument is empty, use interactive selection.\n")
    b.add("        set -l query $tokens[2..-1]\n")
    b.add("        set -l result (command zoxide query --exclude (__zoxide_pwd) --interactive -- $query)\n")
    b.add("        and __zoxide_cd $result\n")
    b.add("        and builtin commandline --function cancel-commandline repaint\n")
    b.add("    end\n")
    b.add("end\n")
    b.add("complete --command __zoxide_z --no-files --arguments '(__zoxide_z_complete)'\n")
    b.add("\n")
    b.add("# Jump to a directory using interactive search.\n")
    b.add("function __zoxide_zi\n")
    b.add("    set -l result (command zoxide query --interactive -- $argv)\n")
    b.add("    and __zoxide_cd $result\n")
    b.add("end\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Commands for zoxide. Disable these using --no-cmd.\n")
    b.add("#")
    match o.cmd {
        Some(cmd) {
            b.add("\n")
            b.add("\n")
            b.add("abbr --erase ")
            b.add(cmd)
            b.add(" &>/dev/null\n")
            b.add("complete --erase --command ")
            b.add(cmd)
            b.add("\n")
            b.add("alias ")
            b.add(cmd)
            b.add("=__zoxide_z\n")
            b.add("\n")
            b.add("abbr --erase ")
            b.add(cmd)
            b.add("i &>/dev/null\n")
            b.add("complete --erase --command ")
            b.add(cmd)
            b.add("i\n")
            b.add("alias ")
            b.add(cmd)
            b.add("i=__zoxide_zi")
        }
        None {
            b.add("\n")
            b.add("\n")
            b.add("# -- not configured --")
        }
    }
    b.add("\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# To initialize zoxide, add this to your configuration (usually\n")
    b.add("# ~/.config/fish/config.fish):\n")
    b.add("#\n")
    b.add("#   zoxide init fish | source")
}

fn nushell(o: &InitOpts, b: mut &StrBuf) {
    b.add("# Code generated by zoxide. DO NOT EDIT.\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Hook configuration for zoxide.\n")
    b.add("#\n")
    b.add("\n")
    if o.hook == Hook.Off {
        b.add("# -- not configured --")
    } else {
        b.add("# Initialize hook to add new entries to the database.\n")
        b.add("export-env {")
        if o.hook == Hook.Prompt {
            b.add("\n")
            b.add("  $env.config = (\n")
            b.add("    $env.config?\n")
            b.add("    | default {}\n")
            b.add("    | upsert hooks { default {} }\n")
            b.add("    | upsert hooks.pre_prompt { default [] }\n")
            b.add("  )\n")
            b.add("  let __zoxide_hooked = (\n")
            b.add("    $env.config.hooks.pre_prompt | any { try { get __zoxide_hook } catch { false } }\n")
            b.add("  )\n")
            b.add("  if not $__zoxide_hooked {\n")
            b.add("    $env.config.hooks.pre_prompt = ($env.config.hooks.pre_prompt | append {\n")
            b.add("      __zoxide_hook: true,\n")
            b.add("      code: {|| ^zoxide add -- $env.PWD}\n")
            b.add("    })\n")
            b.add("  }")
        } else if o.hook == Hook.Pwd {
            b.add("\n")
            b.add("  $env.config = (\n")
            b.add("    $env.config?\n")
            b.add("    | default {}\n")
            b.add("    | upsert hooks { default {} }\n")
            b.add("    | upsert hooks.env_change { default {} }\n")
            b.add("    | upsert hooks.env_change.PWD { default [] }\n")
            b.add("  )\n")
            b.add("  let __zoxide_hooked = (\n")
            b.add("    $env.config.hooks.env_change.PWD | any { try { get __zoxide_hook } catch { false } }\n")
            b.add("  )\n")
            b.add("  if not $__zoxide_hooked {\n")
            b.add("    $env.config.hooks.env_change.PWD = ($env.config.hooks.env_change.PWD | append {\n")
            b.add("      __zoxide_hook: true,\n")
            b.add("      code: {|_, dir| ^zoxide add -- $dir}\n")
            b.add("    })\n")
            b.add("  }")
        }
        b.add("\n")
        b.add("}")
    }
    b.add("\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# When using zoxide with --no-cmd, alias these internal functions as desired.\n")
    b.add("#\n")
    b.add("\n")
    b.add("# Jump to a directory using only keywords.\n")
    b.add("def --env --wrapped __zoxide_z [...rest: string] {\n")
    b.add("  let path = match $rest {\n")
    b.add("    [] => {'~'},\n")
    b.add("    [ '-' ] => {'-'},\n")
    b.add("    [ $arg ] if ($arg | path expand | path type) == 'dir' => {$arg}\n")
    b.add("    _ => {\n")
    b.add("      ^zoxide query --exclude $env.PWD -- ...$rest | str trim -r -c \"\\n\"\n")
    b.add("    }\n")
    b.add("  }\n")
    b.add("  cd $path")
    if o.echo {
        b.add("\n")
        b.add("  echo $env.PWD")
    }
    b.add("\n")
    b.add("}\n")
    b.add("\n")
    b.add("# Jump to a directory using interactive search.\n")
    b.add("def --env --wrapped __zoxide_zi [...rest:string] {\n")
    b.add("  cd $'(^zoxide query --interactive -- ...$rest | str trim -r -c \"\\n\")'")
    if o.echo {
        b.add("\n")
        b.add("  echo $env.PWD")
    }
    b.add("\n")
    b.add("}\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Commands for zoxide. Disable these using --no-cmd.\n")
    b.add("#")
    match o.cmd {
        Some(cmd) {
            b.add("\n")
            b.add("\n")
            b.add("alias ")
            b.add(cmd)
            b.add(" = __zoxide_z\n")
            b.add("alias ")
            b.add(cmd)
            b.add("i = __zoxide_zi")
        }
        None {
            b.add("\n")
            b.add("\n")
            b.add("# -- not configured --")
        }
    }
    b.add("\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Add this to your env file (find it by running `$nu.env-path` in Nushell):\n")
    b.add("#\n")
    b.add("#   zoxide init nushell | save -f ~/.zoxide.nu\n")
    b.add("#\n")
    b.add("# Now, add this to the end of your config file (find it by running\n")
    b.add("# `$nu.config-path` in Nushell):\n")
    b.add("#\n")
    b.add("#   source ~/.zoxide.nu\n")
    b.add("#\n")
    b.add("# Note: zoxide only supports Nushell v0.89.0+.")
}

fn posix(o: &InitOpts, b: mut &StrBuf) {
    b.add("# shellcheck shell=sh\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Utility functions for zoxide.\n")
    b.add("#\n")
    b.add("\n")
    b.add("# pwd based on the value of _ZO_RESOLVE_SYMLINKS.\n")
    b.add("__zoxide_pwd() {")
    if o.resolveSymlinks {
        b.add("\n")
        b.add("    \\command pwd -P")
    } else {
        b.add("\n")
        b.add("    \\command pwd -L")
    }
    b.add("\n")
    b.add("}\n")
    b.add("\n")
    b.add("# cd + custom logic based on the value of _ZO_ECHO.\n")
    b.add("__zoxide_cd() {\n")
    b.add("    # shellcheck disable=SC2164\n")
    b.add("    \\command cd \"$@\"")
    if o.echo {
        b.add(" && __zoxide_pwd")
    }
    b.add("\n")
    b.add("}\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Hook configuration for zoxide.\n")
    b.add("#\n")
    b.add("\n")
    match o.hook {
        Hook.Off {
            b.add("# -- not configured --")
        }
        Hook.Prompt {
            b.add("# Hook to add new entries to the database.\n")
            b.add("__zoxide_hook() {\n")
            b.add("    \\command zoxide add -- \"$(__zoxide_pwd || \\command true)\"\n")
            b.add("}\n")
            b.add("\n")
            b.add("# Initialize hook.\n")
            b.add("if [ \"${PS1:=}\" = \"${PS1#*\\$(__zoxide_hook)}\" ]; then\n")
            b.add("    PS1=\"${PS1}\\$(__zoxide_hook)\"\n")
            b.add("fi\n")
            b.add("\n")
            b.add("# Report common issues.\n")
            b.add("__zoxide_doctor() {")
            if o.hook != Hook.Prompt {
                b.add("\n")
                b.add("    return 0")
            } else {
                b.add("\n")
                b.add("    [ \"${_ZO_DOCTOR:-1}\" -eq 0 ] && return 0\n")
                b.add("    case \"${PS1:-}\" in\n")
                b.add("    *__zoxide_hook*) return 0 ;;\n")
                b.add("    *) ;;\n")
                b.add("    esac\n")
                b.add("\n")
                b.add("    _ZO_DOCTOR=0\n")
                b.add("    \\command printf '%s\\n' \\\n")
                b.add("        'zoxide: detected a possible configuration issue.' \\\n")
                b.add("        'Please ensure that zoxide is initialized right at the end of your shell configuration file.' \\\n")
                b.add("        '' \\\n")
                b.add("        'If the issue persists, consider filing an issue at:' \\\n")
                b.add("        'https://github.com/ajeetdsouza/zoxide/issues' \\\n")
                b.add("        '' \\\n")
                b.add("        'Disable this message by setting _ZO_DOCTOR=0.' \\\n")
                b.add("        '' >&2")
            }
            b.add("\n")
            b.add("}")
        }
        Hook.Pwd {
            b.add("\\command printf \"%s\\n%s\\n\" \\\n")
            b.add("    \"zoxide: PWD hooks are not supported on POSIX shells.\" \\\n")
            b.add("    \"        Use 'zoxide init posix --hook prompt' instead.\"")
        }
    }
    b.add("\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# When using zoxide with --no-cmd, alias these internal functions as desired.\n")
    b.add("#\n")
    b.add("\n")
    b.add("# Jump to a directory using only keywords.\n")
    b.add("__zoxide_z() {\n")
    b.add("    __zoxide_doctor\n")
    b.add("\n")
    b.add("    if [ \"$#\" -eq 0 ]; then\n")
    b.add("        __zoxide_cd ~\n")
    b.add("    elif [ \"$#\" -eq 1 ] && [ \"$1\" = '-' ]; then\n")
    b.add("        if [ -n \"${OLDPWD}\" ]; then\n")
    b.add("            __zoxide_cd \"${OLDPWD}\"\n")
    b.add("        else\n")
    b.add("            # shellcheck disable=SC2016\n")
    b.add("            \\command printf 'zoxide: $OLDPWD is not set'\n")
    b.add("            return 1\n")
    b.add("        fi\n")
    b.add("    elif [ \"$#\" -eq 1 ] && [ -d \"$1\" ]; then\n")
    b.add("        __zoxide_cd \"$1\"\n")
    b.add("    else\n")
    b.add("        __zoxide_result=\"$(\\command zoxide query --exclude \"$(__zoxide_pwd || \\command true)\" -- \"$@\")\" &&\n")
    b.add("            __zoxide_cd \"${__zoxide_result}\"\n")
    b.add("    fi\n")
    b.add("}\n")
    b.add("\n")
    b.add("# Jump to a directory using interactive search.\n")
    b.add("__zoxide_zi() {\n")
    b.add("    __zoxide_doctor\n")
    b.add("    __zoxide_result=\"$(\\command zoxide query --interactive -- \"$@\")\" && __zoxide_cd \"${__zoxide_result}\"\n")
    b.add("}\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Commands for zoxide. Disable these using --no-cmd.\n")
    b.add("#")
    match o.cmd {
        Some(cmd) {
            b.add("\n")
            b.add("\n")
            b.add("\\command unalias ")
            b.add(cmd)
            b.add(" >/dev/null 2>&1 || \\true\n")
            b.add(cmd)
            b.add("() {\n")
            b.add("    __zoxide_z \"$@\"\n")
            b.add("}\n")
            b.add("\n")
            b.add("\\command unalias ")
            b.add(cmd)
            b.add("i >/dev/null 2>&1 || \\true\n")
            b.add(cmd)
            b.add("i() {\n")
            b.add("    __zoxide_zi \"$@\"\n")
            b.add("}")
        }
        None {
            b.add("\n")
            b.add("\n")
            b.add("# -- not configured --")
        }
    }
    b.add("\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# To initialize zoxide, add this to your configuration:\n")
    b.add("#\n")
    b.add("# eval \"$(zoxide init posix --hook prompt)\"")
}

fn powershell(o: &InitOpts, b: mut &StrBuf) {
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Utility functions for zoxide.\n")
    b.add("#\n")
    b.add("\n")
    b.add("# Call zoxide binary, returning the output as UTF-8.\n")
    b.add("function global:__zoxide_bin {\n")
    b.add("    $encoding = [Console]::OutputEncoding\n")
    b.add("    try {\n")
    b.add("        [Console]::OutputEncoding = [System.Text.Utf8Encoding]::new()\n")
    b.add("        $result = zoxide @args\n")
    b.add("        return $result\n")
    b.add("    } finally {\n")
    b.add("        [Console]::OutputEncoding = $encoding\n")
    b.add("    }\n")
    b.add("}\n")
    b.add("\n")
    b.add("# pwd based on zoxide's format.\n")
    b.add("function global:__zoxide_pwd {\n")
    b.add("    $cwd = Get-Location\n")
    b.add("    if ($cwd.Provider.Name -eq \"FileSystem\") {\n")
    b.add("        $cwd.ProviderPath\n")
    b.add("    }\n")
    b.add("}\n")
    b.add("\n")
    b.add("# cd + custom logic based on the value of _ZO_ECHO.\n")
    b.add("function global:__zoxide_cd($dir, $literal) {\n")
    b.add("    $dir = if ($literal) {\n")
    b.add("        Set-Location -LiteralPath $dir -Passthru -ErrorAction Stop\n")
    b.add("    } else {\n")
    b.add("        if ($dir -eq '-' -and ($PSVersionTable.PSVersion -lt 6.1)) {\n")
    b.add("            Write-Error \"cd - is not supported below PowerShell 6.1. Please upgrade your version of PowerShell.\"\n")
    b.add("        }\n")
    b.add("        elseif ($dir -eq '+' -and ($PSVersionTable.PSVersion -lt 6.2)) {\n")
    b.add("            Write-Error \"cd + is not supported below PowerShell 6.2. Please upgrade your version of PowerShell.\"\n")
    b.add("        }\n")
    b.add("        else {\n")
    b.add("            Set-Location -Path $dir -Passthru -ErrorAction Stop\n")
    b.add("        }\n")
    b.add("    }")
    if o.echo {
        b.add("\n")
        b.add("    Write-Output $dir.Path")
    }
    b.add("\n")
    b.add("}\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Hook configuration for zoxide.\n")
    b.add("#\n")
    b.add("\n")
    if o.hook == Hook.Off {
        b.add("# -- not configured --")
    } else {
        if o.hook == Hook.Prompt {
            b.add("# Hook to add new entries to the database.\n")
            b.add("function global:__zoxide_hook {\n")
            b.add("    $result = __zoxide_pwd\n")
            b.add("    if ($null -ne $result) {\n")
            b.add("        zoxide add \"--\" $result\n")
            b.add("    }\n")
            b.add("}")
        } else if o.hook == Hook.Pwd {
            b.add("# Hook to add new entries to the database.\n")
            b.add("$global:__zoxide_oldpwd = __zoxide_pwd\n")
            b.add("function global:__zoxide_hook {\n")
            b.add("    $result = __zoxide_pwd\n")
            b.add("    if ($result -ne $global:__zoxide_oldpwd) {\n")
            b.add("        if ($null -ne $result) {\n")
            b.add("            zoxide add \"--\" $result\n")
            b.add("        }\n")
            b.add("        $global:__zoxide_oldpwd = $result\n")
            b.add("    }\n")
            b.add("}")
        }
        b.add("\n")
        b.add("\n")
        b.add("# Initialize hook.\n")
        b.add("$global:__zoxide_hooked = (Get-Variable __zoxide_hooked -ErrorAction Ignore -ValueOnly)\n")
        b.add("if ($global:__zoxide_hooked -ne 1) {\n")
        b.add("    $global:__zoxide_hooked = 1\n")
        b.add("    $global:__zoxide_prompt_old = $function:prompt\n")
        b.add("\n")
        b.add("    function global:prompt {\n")
        b.add("        if ($null -ne $__zoxide_prompt_old) {\n")
        b.add("            & $__zoxide_prompt_old\n")
        b.add("        }\n")
        b.add("        $null = __zoxide_hook\n")
        b.add("    }\n")
        b.add("}")
    }
    b.add("\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# When using zoxide with --no-cmd, alias these internal functions as desired.\n")
    b.add("#\n")
    b.add("\n")
    b.add("# Jump to a directory using only keywords.\n")
    b.add("function global:__zoxide_z {\n")
    b.add("    if ($args.Length -eq 0) {\n")
    b.add("        __zoxide_cd ~ $true\n")
    b.add("    }\n")
    b.add("    elseif ($args.Length -eq 1 -and ($args[0] -eq '-' -or $args[0] -eq '+')) {\n")
    b.add("        __zoxide_cd $args[0] $false\n")
    b.add("    }\n")
    b.add("    elseif ($args.Length -eq 1 -and (Test-Path -PathType Container -LiteralPath $args[0])) {\n")
    b.add("        __zoxide_cd $args[0] $true\n")
    b.add("    }\n")
    b.add("    elseif ($args.Length -eq 1 -and (Test-Path -PathType Container -Path $args[0] )) {\n")
    b.add("        __zoxide_cd $args[0] $false\n")
    b.add("    }\n")
    b.add("    else {\n")
    b.add("        $result = __zoxide_pwd\n")
    b.add("        if ($null -ne $result) {\n")
    b.add("            $result = __zoxide_bin query --exclude $result \"--\" @args\n")
    b.add("        }\n")
    b.add("        else {\n")
    b.add("            $result = __zoxide_bin query \"--\" @args\n")
    b.add("        }\n")
    b.add("        if ($LASTEXITCODE -eq 0) {\n")
    b.add("            __zoxide_cd $result $true\n")
    b.add("        }\n")
    b.add("    }\n")
    b.add("}\n")
    b.add("\n")
    b.add("# Jump to a directory using interactive search.\n")
    b.add("function global:__zoxide_zi {\n")
    b.add("    $result = __zoxide_bin query -i \"--\" @args\n")
    b.add("    if ($LASTEXITCODE -eq 0) {\n")
    b.add("        __zoxide_cd $result $true\n")
    b.add("    }\n")
    b.add("}\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Commands for zoxide. Disable these using --no-cmd.\n")
    b.add("#")
    match o.cmd {
        Some(cmd) {
            b.add("\n")
            b.add("\n")
            b.add("Set-Alias -Name ")
            b.add(cmd)
            b.add(" -Value __zoxide_z -Option AllScope -Scope Global -Force\n")
            b.add("Set-Alias -Name ")
            b.add(cmd)
            b.add("i -Value __zoxide_zi -Option AllScope -Scope Global -Force")
        }
        None {
            b.add("\n")
            b.add("\n")
            b.add("# -- not configured --")
        }
    }
    b.add("\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# To initialize zoxide, add this to your configuration (find it by running\n")
    b.add("# `echo $profile` in PowerShell):\n")
    b.add("#\n")
    b.add("# Invoke-Expression (& { (zoxide init powershell | Out-String) })")
}

fn tcsh(o: &InitOpts, b: mut &StrBuf) {
    var pwd_cmd = ""
    if o.resolveSymlinks {
        pwd_cmd = "pwd -P"
    } else {
        pwd_cmd = "pwd -L"
    }
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Hook configuration for zoxide.\n")
    b.add("#")
    if o.hook != Hook.Off {
        b.add("\n")
        b.add("\n")
        b.add("# Hook to add new entries to the database.")
        if o.hook == Hook.Prompt {
            b.add("\n")
            b.add("alias __zoxide_hook 'zoxide add -- \"`")
            b.add(pwd_cmd)
            b.add("`\"'")
        } else if o.hook == Hook.Pwd {
            b.add("\n")
            b.add("set __zoxide_pwd_old = `")
            b.add(pwd_cmd)
            b.add("`\n")
            b.add("alias __zoxide_hook 'set __zoxide_pwd_tmp = \"`")
            b.add(pwd_cmd)
            b.add("`\"; test \"$__zoxide_pwd_tmp\" != \"$__zoxide_pwd_old\" && zoxide add -- \"$__zoxide_pwd_tmp\"; set __zoxide_pwd_old = \"$__zoxide_pwd_tmp\"'")
        }
        b.add("\n")
        b.add("\n")
        b.add("# Initialize hook.\n")
        b.add("alias precmd ';__zoxide_hook'")
    }
    b.add("\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# When using zoxide with --no-cmd, alias these internal functions as desired.\n")
    b.add("#\n")
    b.add("\n")
    b.add("# Jump to a directory using only keywords.\n")
    b.add("alias __zoxide_z 'set __zoxide_args = (\\!*)\\\n")
    b.add("if (\"$#__zoxide_args\" == 0) then\\\n")
    b.add("    cd ~\\\n")
    b.add("else\\\n")
    b.add("    if (\"$#__zoxide_args\" == 1 && \"$__zoxide_args[1]\" == \"-\") then\\\n")
    b.add("        cd -\\\n")
    b.add("    else if (\"$#__zoxide_args\" == 1 && -d \"$__zoxide_args[1]\") then\\\n")
    b.add("        cd \"$__zoxide_args[1]\"\\\n")
    b.add("    else\\\n")
    b.add("        set __zoxide_pwd = `")
    b.add(pwd_cmd)
    b.add("`\\\n")
    b.add("        set __zoxide_result = \"`zoxide query --exclude '\"'\"'$__zoxide_pwd'\"'\"' -- $__zoxide_args`\" && cd \"$__zoxide_result\"\\\n")
    b.add("    endif\\\n")
    b.add("endif'\n")
    b.add("\n")
    b.add("# Jump to a directory using interactive search.\n")
    b.add("alias __zoxide_zi 'set __zoxide_args = (\\!*)\\\n")
    b.add("set __zoxide_pwd = `")
    b.add(pwd_cmd)
    b.add("`\\\n")
    b.add("set __zoxide_result = \"`zoxide query --exclude '\"'\"'$__zoxide_pwd'\"'\"' --interactive -- $__zoxide_args`\" && cd \"$__zoxide_result\"'\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Commands for zoxide. Disable these using --no-cmd.\n")
    b.add("#")
    match o.cmd {
        Some(cmd) {
            b.add("\n")
            b.add("\n")
            b.add("alias ")
            b.add(cmd)
            b.add(" __zoxide_z\n")
            b.add("alias ")
            b.add(cmd)
            b.add("i __zoxide_zi")
        }
        None {
            b.add("\n")
            b.add("\n")
            b.add("# -- not configured --")
        }
    }
    b.add("\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# To initialize zoxide, add this to your shell configuration file (usually ~/.tcshrc):\n")
    b.add("#\n")
    b.add("#     zoxide init tcsh > ~/.zoxide.tcsh\n")
    b.add("#     source ~/.zoxide.tcsh")
}

fn xonsh(o: &InitOpts, b: mut &StrBuf) {
    b.add("# pylint: disable=missing-module-docstring\n")
    b.add("\n")
    b.add("import builtins  # pylint: disable=unused-import\n")
    b.add("import os\n")
    b.add("import os.path\n")
    b.add("import subprocess\n")
    b.add("import sys\n")
    b.add("import typing\n")
    b.add("\n")
    b.add("import xonsh.dirstack  # type: ignore # pylint: disable=import-error\n")
    b.add("import xonsh.environ  # type: ignore # pylint: disable=import-error\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Utility functions for zoxide.\n")
    b.add("#\n")
    b.add("\n")
    b.add("\n")
    b.add("def __zoxide_bin() -> str:\n")
    b.add("    \"\"\"Finds and returns the location of the zoxide binary.\"\"\"\n")
    b.add("    zoxide = typing.cast(str, xonsh.environ.locate_binary(\"zoxide\"))\n")
    b.add("    if zoxide is None:\n")
    b.add("        zoxide = \"zoxide\"\n")
    b.add("    return zoxide\n")
    b.add("\n")
    b.add("\n")
    b.add("def __zoxide_env() -> dict[str, str]:\n")
    b.add("    \"\"\"Returns the current environment.\"\"\"\n")
    b.add("    return builtins.__xonsh__.env.detype()  # type: ignore  # pylint:disable=no-member\n")
    b.add("\n")
    b.add("\n")
    b.add("def __zoxide_pwd() -> str:\n")
    b.add("    \"\"\"pwd based on the value of _ZO_RESOLVE_SYMLINKS.\"\"\"")
    if o.resolveSymlinks {
        b.add("\n")
        b.add("    pwd = os.getcwd()")
    } else {
        b.add("\n")
        b.add("    pwd = __zoxide_env().get(\"PWD\")\n")
        b.add("    if pwd is None:\n")
        b.add("        raise RuntimeError(\"$PWD not found\")")
    }
    b.add("\n")
    b.add("    return pwd\n")
    b.add("\n")
    b.add("\n")
    b.add("def __zoxide_cd(path: str | bytes | None = None) -> None:\n")
    b.add("    \"\"\"cd + custom logic based on the value of _ZO_ECHO.\"\"\"\n")
    b.add("    if path is None:\n")
    b.add("        args = []\n")
    b.add("    elif isinstance(path, bytes):\n")
    b.add("        args = [path.decode(\"utf-8\")]\n")
    b.add("    else:\n")
    b.add("        args = [path]\n")
    b.add("    _, exc, _ = xonsh.dirstack.cd(args)\n")
    b.add("    if exc is not None:\n")
    b.add("        raise RuntimeError(exc)")
    if o.echo {
        b.add("\n")
        b.add("    print(__zoxide_pwd())")
    }
    b.add("\n")
    b.add("\n")
    b.add("\n")
    b.add("class ZoxideSilentException(Exception):\n")
    b.add("    \"\"\"Exit without complaining.\"\"\"\n")
    b.add("\n")
    b.add("\n")
    b.add("def __zoxide_errhandler(\n")
    b.add("    func: typing.Callable[[list[str]], None],\n")
    b.add(") -> typing.Callable[[list[str]], int]:\n")
    b.add("    \"\"\"Print exception and exit with error code 1.\"\"\"\n")
    b.add("\n")
    b.add("    def wrapper(args: list[str]) -> int:\n")
    b.add("        try:\n")
    b.add("            func(args)\n")
    b.add("            return 0\n")
    b.add("        except ZoxideSilentException:\n")
    b.add("            return 1\n")
    b.add("        except Exception as exc:  # pylint: disable=broad-except\n")
    b.add("            print(f\"zoxide: {exc}\", file=sys.stderr)\n")
    b.add("            return 1\n")
    b.add("\n")
    b.add("    return wrapper\n")
    b.add("\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Hook configuration for zoxide.\n")
    b.add("#\n")
    b.add("\n")
    if o.hook == Hook.Off {
        b.add("# -- not configured --")
    } else {
        b.add("# Initialize hook to add new entries to the database.\n")
        b.add("if \"__zoxide_hook\" not in globals():\n")
        if o.hook == Hook.Prompt {
            b.add("\n")
            b.add("    @builtins.events.on_post_prompt  # type: ignore  # pylint:disable=no-member")
        } else if o.hook == Hook.Pwd {
            b.add("\n")
            b.add("    @builtins.events.on_chdir  # type: ignore  # pylint:disable=no-member")
        }
        b.add("\n")
        b.add("    def __zoxide_hook(**_kwargs: typing.Any) -> None:\n")
        b.add("        \"\"\"Hook to add new entries to the database.\"\"\"\n")
        b.add("        pwd = __zoxide_pwd()\n")
        b.add("        zoxide = __zoxide_bin()\n")
        b.add("        subprocess.run(\n")
        b.add("            [zoxide, \"add\", \"--\", pwd],\n")
        b.add("            check=False,\n")
        b.add("            env=__zoxide_env(),\n")
        b.add("        )\n")
    }
    b.add("\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# When using zoxide with --no-cmd, alias these internal functions as desired.\n")
    b.add("#\n")
    b.add("\n")
    b.add("\n")
    b.add("@__zoxide_errhandler\n")
    b.add("def __zoxide_z(args: list[str]) -> None:\n")
    b.add("    \"\"\"Jump to a directory using only keywords.\"\"\"\n")
    b.add("    if args == []:\n")
    b.add("        __zoxide_cd()\n")
    b.add("    elif args == [\"-\"]:\n")
    b.add("        __zoxide_cd(\"-\")\n")
    b.add("    elif len(args) == 1 and os.path.isdir(args[0]):\n")
    b.add("        __zoxide_cd(args[0])\n")
    b.add("    else:\n")
    b.add("        try:\n")
    b.add("            zoxide = __zoxide_bin()\n")
    b.add("            cmd = subprocess.run(\n")
    b.add("                [zoxide, \"query\", \"--exclude\", __zoxide_pwd(), \"--\"] + args,\n")
    b.add("                check=True,\n")
    b.add("                env=__zoxide_env(),\n")
    b.add("                stdout=subprocess.PIPE,\n")
    b.add("            )\n")
    b.add("        except subprocess.CalledProcessError as exc:\n")
    b.add("            raise ZoxideSilentException() from exc\n")
    b.add("\n")
    b.add("        result = cmd.stdout[:-1]\n")
    b.add("        __zoxide_cd(result)\n")
    b.add("\n")
    b.add("\n")
    b.add("@__zoxide_errhandler\n")
    b.add("def __zoxide_zi(args: list[str]) -> None:\n")
    b.add("    \"\"\"Jump to a directory using interactive search.\"\"\"\n")
    b.add("    try:\n")
    b.add("        zoxide = __zoxide_bin()\n")
    b.add("        cmd = subprocess.run(\n")
    b.add("            [zoxide, \"query\", \"-i\", \"--\"] + args,\n")
    b.add("            check=True,\n")
    b.add("            env=__zoxide_env(),\n")
    b.add("            stdout=subprocess.PIPE,\n")
    b.add("        )\n")
    b.add("    except subprocess.CalledProcessError as exc:\n")
    b.add("        raise ZoxideSilentException() from exc\n")
    b.add("\n")
    b.add("    result = cmd.stdout[:-1]\n")
    b.add("    __zoxide_cd(result)\n")
    b.add("\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Commands for zoxide. Disable these using --no-cmd.\n")
    b.add("#")
    match o.cmd {
        Some(cmd) {
            b.add("\n")
            b.add("\n")
            b.add("builtins.aliases[\"")
            b.add(cmd)
            b.add("\"] = __zoxide_z  # type: ignore  # pylint:disable=no-member\n")
            b.add("builtins.aliases[\"")
            b.add(cmd)
            b.add("i\"] = __zoxide_zi  # type: ignore  # pylint:disable=no-member")
        }
        None {
            b.add("\n")
            b.add("\n")
            b.add("# -- not configured --")
        }
    }
    b.add("\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# To initialize zoxide, add this to your configuration (usually ~/.xonshrc):\n")
    b.add("#\n")
    b.add("# execx($(zoxide init xonsh), 'exec', __xonsh__.ctx, filename='zoxide')")
}

fn zsh(o: &InitOpts, b: mut &StrBuf) {
    b.add("# shellcheck shell=bash\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Utility functions for zoxide.\n")
    b.add("#\n")
    b.add("\n")
    b.add("# pwd based on the value of _ZO_RESOLVE_SYMLINKS.\n")
    b.add("function __zoxide_pwd() {")
    if o.resolveSymlinks {
        b.add("\n")
        b.add("    \\builtin pwd -P")
    } else {
        b.add("\n")
        b.add("    \\builtin pwd -L")
    }
    b.add("\n")
    b.add("}\n")
    b.add("\n")
    b.add("# cd + custom logic based on the value of _ZO_ECHO.\n")
    b.add("function __zoxide_cd() {\n")
    b.add("    # shellcheck disable=SC2164\n")
    b.add("    \\builtin cd -- \"$@\"")
    if o.echo {
        b.add(" && __zoxide_pwd")
    }
    b.add("\n")
    b.add("}\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Hook configuration for zoxide.\n")
    b.add("#\n")
    b.add("\n")
    b.add("# Hook to add new entries to the database.\n")
    b.add("function __zoxide_hook() {\n")
    b.add("    # shellcheck disable=SC2312\n")
    b.add("    \\command zoxide add -- \"$(__zoxide_pwd)\"\n")
    b.add("}\n")
    b.add("\n")
    b.add("# Initialize hook.\n")
    b.add("\\builtin typeset -ga precmd_functions\n")
    b.add("\\builtin typeset -ga chpwd_functions\n")
    b.add("# shellcheck disable=SC2034,SC2296\n")
    b.add("precmd_functions=(\"${(@)precmd_functions:#__zoxide_hook}\")\n")
    b.add("# shellcheck disable=SC2034,SC2296\n")
    b.add("chpwd_functions=(\"${(@)chpwd_functions:#__zoxide_hook}\")")
    if o.hook == Hook.Prompt {
        b.add("\n")
        b.add("precmd_functions+=(__zoxide_hook)")
    } else if o.hook == Hook.Pwd {
        b.add("\n")
        b.add("chpwd_functions+=(__zoxide_hook)")
    }
    b.add("\n")
    b.add("\n")
    b.add("# Report common issues.\n")
    b.add("function __zoxide_doctor() {")
    if o.hook == Hook.Off {
        b.add("\n")
        b.add("    return 0")
    } else {
        b.add("\n")
        b.add("    [[ ${_ZO_DOCTOR:-1} -ne 0 ]] || return 0")
        if o.hook == Hook.Prompt {
            b.add("\n")
            b.add("    [[ ${precmd_functions[(Ie)__zoxide_hook]:-} -eq 0 ]] || return 0")
        } else if o.hook == Hook.Pwd {
            b.add("\n")
            b.add("    [[ ${chpwd_functions[(Ie)__zoxide_hook]:-} -eq 0 ]] || return 0")
        }
        b.add("\n")
        b.add("\n")
        b.add("    _ZO_DOCTOR=0\n")
        b.add("    \\builtin printf '%s\\n' \\\n")
        b.add("        'zoxide: detected a possible configuration issue.' \\\n")
        b.add("        'Please ensure that zoxide is initialized right at the end of your shell configuration file (usually ~/.zshrc).' \\\n")
        b.add("        '' \\\n")
        b.add("        'If the issue persists, consider filing an issue at:' \\\n")
        b.add("        'https://github.com/ajeetdsouza/zoxide/issues' \\\n")
        b.add("        '' \\\n")
        b.add("        'Disable this message by setting _ZO_DOCTOR=0.' \\\n")
        b.add("        '' >&2")
    }
    b.add("\n")
    b.add("}\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# When using zoxide with --no-cmd, alias these internal functions as desired.\n")
    b.add("#\n")
    b.add("\n")
    b.add("# Jump to a directory using only keywords.\n")
    b.add("function __zoxide_z() {\n")
    b.add("    __zoxide_doctor\n")
    b.add("    if [[ \"$#\" -eq 0 ]]; then\n")
    b.add("        __zoxide_cd ~\n")
    b.add("    elif [[ \"$#\" -eq 1 ]] && { [[ -d \"$1\" ]] || [[ \"$1\" = '-' ]] || [[ \"$1\" =~ ^[-+][0-9]+$ ]]; }; then\n")
    b.add("        __zoxide_cd \"$1\"\n")
    b.add("    elif [[ \"$#\" -eq 2 ]] && [[ \"$1\" = \"--\" ]]; then\n")
    b.add("        __zoxide_cd \"$2\"\n")
    b.add("    else\n")
    b.add("        \\builtin local result\n")
    b.add("        # shellcheck disable=SC2312\n")
    b.add("        result=\"$(\\command zoxide query --exclude \"$(__zoxide_pwd)\" -- \"$@\")\" && __zoxide_cd \"${result}\"\n")
    b.add("    fi\n")
    b.add("}\n")
    b.add("\n")
    b.add("# Jump to a directory using interactive search.\n")
    b.add("function __zoxide_zi() {\n")
    b.add("    __zoxide_doctor\n")
    b.add("    \\builtin local result\n")
    b.add("    result=\"$(\\command zoxide query --interactive -- \"$@\")\" && __zoxide_cd \"${result}\"\n")
    b.add("}\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# Commands for zoxide. Disable these using --no-cmd.\n")
    b.add("#")
    match o.cmd {
        Some(cmd) {
            b.add("\n")
            b.add("\n")
            b.add("function ")
            b.add(cmd)
            b.add("() {\n")
            b.add("    __zoxide_z \"$@\"\n")
            b.add("}\n")
            b.add("\n")
            b.add("function ")
            b.add(cmd)
            b.add("i() {\n")
            b.add("    __zoxide_zi \"$@\"\n")
            b.add("}")
        }
        None {
            b.add("\n")
            b.add("\n")
            b.add("# -- not configured --")
        }
    }
    b.add("\n")
    b.add("\n")
    b.add("# Completions.\n")
    b.add("if [[ -o zle ]]; then\n")
    b.add("    __zoxide_result=''\n")
    b.add("\n")
    b.add("    function __zoxide_z_complete() {\n")
    b.add("        # Only show completions when the cursor is at the end of the line.\n")
    b.add("        # shellcheck disable=SC2154\n")
    b.add("        [[ \"")
    b.add("${#words[@]}")
    b.add("\" -eq \"${CURRENT}\" ]] || return 0\n")
    b.add("\n")
    b.add("        if [[ \"")
    b.add("${#words[@]}")
    b.add("\" -eq 2 ]]; then\n")
    b.add("            # Show completions for local directories.\n")
    b.add("            _cd -/\n")
    b.add("\n")
    b.add("        elif [[ \"${words[-1]}\" == '' ]]; then\n")
    b.add("            # Show completions for Space-Tab.\n")
    b.add("            # shellcheck disable=SC2086\n")
    b.add("            __zoxide_result=\"$(\\command zoxide query --exclude \"$(__zoxide_pwd || \\builtin true)\" --interactive -- ${words[2,-1]})\" || __zoxide_result=''\n")
    b.add("\n")
    b.add("            # Set a result to ensure completion doesn't re-run\n")
    b.add("            compadd -Q \"\"\n")
    b.add("\n")
    b.add("            # Bind '\\e[0n' to helper function.\n")
    b.add("            \\builtin bindkey '\\e[0n' '__zoxide_z_complete_helper'\n")
    b.add("            # Sends query device status code, which results in a '\\e[0n' being sent to console input.\n")
    b.add("            \\builtin printf '\\e[5n'\n")
    b.add("\n")
    b.add("            # Report that the completion was successful, so that we don't fall back\n")
    b.add("            # to another completion function.\n")
    b.add("            return 0\n")
    b.add("        fi\n")
    b.add("    }\n")
    b.add("\n")
    b.add("    function __zoxide_z_complete_helper() {\n")
    b.add("        if [[ -n \"${__zoxide_result}\" ]]; then\n")
    b.add("            # shellcheck disable=SC2034,SC2296\n")
    b.add("            BUFFER=\"")
    b.add(o.cmd.unwrapOr("cd"))
    b.add(" ${(q-)__zoxide_result}\"\n")
    b.add("            __zoxide_result=''\n")
    b.add("            \\builtin zle reset-prompt\n")
    b.add("            \\builtin zle accept-line\n")
    b.add("        else\n")
    b.add("            \\builtin zle reset-prompt\n")
    b.add("        fi\n")
    b.add("    }\n")
    b.add("    \\builtin zle -N __zoxide_z_complete_helper")
    match o.cmd {
        Some(cmd) {
            b.add("\n")
            b.add("\n")
            b.add("    [[ \"${+functions[compdef]}\" -ne 0 ]] && \\compdef __zoxide_z_complete ")
            b.add(cmd)
        }
        None {}
    }
    b.add("\n")
    b.add("fi\n")
    b.add("\n")
    b.add("# =============================================================================\n")
    b.add("#")
    b.add("\n")
    b.add("# To initialize zoxide, add this to your shell configuration file (usually ~/.zshrc):\n")
    b.add("#\n")
    b.add("# eval \"$(zoxide init zsh)\"")
}
