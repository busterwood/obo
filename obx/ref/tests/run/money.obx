// Decimal and Money are library code (std.obx). The currencies are user types
// that supply associated functions.
// expect: 12.50 USD
// expect: 20.00 USD
// expect: 32.50 USD
// expect: 2.68 USD
// expect: 1500 JPY
// expect: 1650 JPY
// expect: true
// expect: -1.5
// expect: 0.05
type USD = value record {}
fn (USD) code(): str { return "USD" }
fn (USD) scale(): int { return 2 }

type JPY = value record {}
fn (JPY) code(): str { return "JPY" }
fn (JPY) scale(): int { return 0 }

fn main() {
    let a: Money[USD] = money(12.5)
    let b: Money[USD] = money(20.00)
    println(a)
    println(b)
    let c = a + b
    println(c)
    let tax = c.times(0.0825)
    println(tax)
    let y: Money[JPY] = money(decimalOf(1500))
    println(y)
    let y2 = y.times(1.1)
    println(y2)
    if a < b { println("true") }
    let d: Decimal = -1.5
    println(d)
    let e: Decimal = 0.05
    println(e)
}
