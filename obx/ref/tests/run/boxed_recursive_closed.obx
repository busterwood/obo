// expect: -5
// expect: (1 + mul 2)
// expect: 42
// expect: sum()
// expect: mul 5
// boxed recursive closed type, borrowing and consuming match
type Expr = closed {
    Num(int)
    Add(Expr, Expr)
    Mul(Expr, Expr)
    Neg(Expr)
    Call { name: str; args: []Expr }
}
fn eval(e: &Expr): int {
    match e {
        Expr.Num(n) { return n }
        Expr.Add(a, b) { return eval(a) + eval(b) }
        Expr.Mul(a, b) { return eval(a) * eval(b) }
        Expr.Neg(a) { return -eval(a) }
        Expr.Call(name, args) {
            var s = 0
            for x in args { s += eval(x) }
            return s
        }
    }
}
fn show(e: Expr): str {
    match move(e) {
        Expr.Num(n) { return n.toStr() }
        Expr.Add(a, b) { return "(" + show(a) + " + " + show(b) + ")" }
        Expr.Mul(a, _) { return "mul " + show(a) }
        Expr.Neg(a) { return "-" + show(a) }
        Expr.Call(name, _) { return name + "()" }
    }
}
fn main() {
    let e = Expr.Add(Expr.Num(1), Expr.Mul(Expr.Num(2), Expr.Neg(Expr.Num(3))))
    println(eval(&e))
    println(show(e))
    let c = Expr.Call{name: "sum", args: [Expr.Num(1), Expr.Num(2), Expr.Num(39)]}
    println(eval(&c))
    println(show(c))
    println(show(Expr.Mul(Expr.Num(5), Expr.Call{name: "f", args: []})))
}
