module shapes

type Shape = closed {
    Circle { r: int }
    Rect   { w, h: int }
    Tri    { b, h: int }
}

// a missing arm here is a compile error
fn area(s: Shape): int {
    match s {
        Circle { return 3 * s.r * s.r }
        Rect   { return s.w * s.h }
        Tri    { return s.b * s.h / 2 }
    }
}

fn name(s: Shape): string {
    match s {
        Circle { return "circle r=" + string(s.r) }
        else   { return "polygon" }
    }
}

fn main() {
    let shapes = new []?Shape(3)
    shapes[0] = new Circle{r: 2}
    shapes[1] = new Rect{w: 3, h: 4}
    shapes[2] = new Tri{b: 6, h: 5}
    var total = 0
    for s in shapes {
        if s != nil {
            println(name(s), ": ", area(s))
            total += area(s)
        }
    }
    println("total area ", total)
}
