// The regex benchmark (design/regex.md section 4), obx's driver: for each
// pattern, the best time of REPS searches of the corpus. The Go and Rust
// drivers (go/main.go, rust/src/main.rs) do the same work.
//
// usage: regex_bench CORPUS [REPS [NAME]]   (NAME: only that pattern)
// prints: NAME COUNT MS (the number of matches, the best time in ms)

import "regex"
import "io"
import "os"
import "time"

const NAMES: []str = ["literal", "alternation", "words", "nocase", "email", "errors", "dates", "hostile"]
const PATTERNS: []str = [
    "Sherlock Holmes",
    "Sherlock|Holmes|Watson|Irene",
    "\\w+",
    "(?i)sherlock",
    "[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}",
    "(?m)^ERROR .*timeout$",
    "(?P<y>\\d{4})-(?P<m>\\d{2})-(?P<d>\\d{2})",
    "(a*)*b",
]

// One search: the number of matches (for dates, of matches with their groups;
// the sum of the year lengths keeps the groups used).
fn work(re: &regex.Regex, k: int, text: str): int {
    if k == 6 {
        var n = 0
        for c in re.capturesAll(text) {
            n += 1
            match c.name("y") {
                Some(y) { n += len(y.text) - 4 }
                None {}
            }
        }
        return n
    }
    if k == 7 { return if re.isMatch(text) { 1 } else { 0 } }
    return len(re.findAllIndex(text))
}

fn main() {
    let args = os.arguments()
    let corpus = io.read(args[0]).unwrap()
    let reps = if len(args) > 1 { parseInt(args[1]).unwrap() } else { 5 }
    let hostile = repeat("a", 100000)
    let only = if len(args) > 2 { args[2] } else { "" }
    for k in 0..len(NAMES) {
        if only != "" && NAMES[k] != only { continue }
        let re = regex.mustCompile(PATTERNS[k])
        let text = if k == 7 { hostile } else { corpus }
        var best = 0
        var count = 0
        for r in 0..reps {
            let t0 = time.monotonicNs()
            count = work(&re, k, text)
            let t = time.monotonicNs() - t0
            if r == 0 || t < best { best = t }
        }
        println(NAMES[k] + " " + count.toStr() + " " + (best / 1000000).toStr() + "." + ((best / 10000) % 100 + 100).toStr()[1..])
    }
}
