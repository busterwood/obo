// 5M calls of one math function (exp, log, sin, pow, atan or tan, the first argument), the
// argument varying; prints a checksum, the same for both builds. PERFORMANCE.md, "Math".
import "math"

fn run_exp(): float {
    var s = 0.0f
    var x = 0.1f
    var i = 0
    while i < 5000000 {
        s = s + x.exp()
        x = x + 0.0000001f
        i = i + 1
    }
    return s
}

fn run_log(): float {
    var s = 0.0f
    var x = 0.1f
    var i = 0
    while i < 5000000 {
        s = s + (x + 1.0f).ln()
        x = x + 0.0000001f
        i = i + 1
    }
    return s
}

fn run_sin(): float {
    var s = 0.0f
    var x = 0.1f
    var i = 0
    while i < 5000000 {
        s = s + x.sin()
        x = x + 0.0000001f
        i = i + 1
    }
    return s
}

fn run_pow(): float {
    var s = 0.0f
    var x = 0.1f
    var i = 0
    while i < 5000000 {
        s = s + (x + 1.0f).pow(1.7f)
        x = x + 0.0000001f
        i = i + 1
    }
    return s
}

fn run_atan(): float {
    var s = 0.0f
    var x = 0.1f
    var i = 0
    while i < 5000000 {
        s = s + x.atan()
        x = x + 0.0000001f
        i = i + 1
    }
    return s
}

fn run_tan(): float {
    var s = 0.0f
    var x = 0.1f
    var i = 0
    while i < 5000000 {
        s = s + x.tan()
        x = x + 0.0000001f
        i = i + 1
    }
    return s
}

fn main() {
    let w = args()[1]
    var s = 0.0f
    if w == "exp" { s = run_exp() }
    if w == "log" { s = run_log() }
    if w == "sin" { s = run_sin() }
    if w == "pow" { s = run_pow() }
    if w == "atan" { s = run_atan() }
    if w == "tan" { s = run_tan() }
    println(s.toStr())
}
