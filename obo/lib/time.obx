// obo/lib/time.obx: UTC civil time from Unix seconds, integer arithmetic.
//
//     import "time.obx" as time        // from obo/lib/
//
// No floats, no locale, no leap seconds, no TZ: the caller's seconds are
// interpreted as UTC (the differential pins TZ=UTC; a user timezone is a
// documented divergence until a timezone phase).
//
// Negative values use floor division, not obo's truncation toward zero:
// -1 is 1969-12-31 23:59:59, and -2208988800 is 1900-01-01 00:00:00.
// floorDiv/floorMod are exported because the tests and later callers need the
// same division rule; floorMod is non-negative for a positive divisor.
//
// civil(secs) returns [year, month, day, hour, minute, second, weekday], with
// month 1..12 and weekday 0 = Sunday (the Unix epoch, 1970-01-01, is a
// Thursday: weekday 4). It uses the standard days-to-civil integer algorithm
// (Howard Hinnant's), so leap years follow the Gregorian rule (2000 is a leap
// year, 2100 is not).
//
// formatLongIso is minute precision "YYYY-MM-DD HH:MM"; formatIso is
// "MM-DD HH:MM". Eza's long layer writes "-" instead of calling these for a
// negative mtime (SystemTime cannot represent it in 0.23.3); the functions
// still handle negatives correctly for tests and future use. full-iso is out
// of scope.
module time

// floor(a / b): truncation adjusted down when the remainder is nonzero and the
// signs differ
pub fn floorDiv(a: int, b: int): int {
    var q = a / b
    if a % b != 0 && (a < 0) != (b < 0) { q -= 1 }
    return q
}

// a - floorDiv(a, b) * b; non-negative when b > 0
pub fn floorMod(a: int, b: int): int {
    return a - floorDiv(a, b) * b
}

// append n right-aligned in width using decimal digits, with a leading '-' for
// a negative n (width counts digits, not the sign)
fn appendNum(mut out: &[]byte, n: int, width: int) {
    var v = n
    if v < 0 {
        append(out, '-')
        v = -v
    }
    var d = 1
    var t = v
    while t >= 10 {
        t = t / 10
        d += 1
    }
    var pad = width - d
    while pad > 0 {
        append(out, '0')
        pad -= 1
    }
    var p = 1
    for i in 1..d { p *= 10 }
    for i in 0..d {
        let digit = v / p
        append(out, byte('0' + digit))
        v = v - digit * p
        if p > 1 { p = p / 10 }
    }
}

// [year, month (1..12), day, hour, minute, second, weekday (0 = Sunday)]
pub fn civil(secs: int): []int {
    let days = floorDiv(secs, 86400)
    let rem = floorMod(secs, 86400)
    let hour = rem / 3600
    let minute = (rem % 3600) / 60
    let second = rem % 60
    let z = days + 719468
    let era = floorDiv(z, 146097)
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    var m = mp + 3
    if mp >= 10 { m = mp - 9 }
    var year = y
    if m <= 2 { year = y + 1 }
    let wd = floorMod(days + 4, 7)
    var out = new []int(7)
    out[0] = year
    out[1] = m
    out[2] = d
    out[3] = hour
    out[4] = minute
    out[5] = second
    out[6] = wd
    return out
}

// "YYYY-MM-DD HH:MM" in UTC (minute precision; eza's long-iso cell)
pub fn formatLongIso(secs: int): string {
    let c = civil(secs)
    var out = new []byte(0)
    appendNum(out, c[0], 4)
    append(out, '-')
    appendNum(out, c[1], 2)
    append(out, '-')
    appendNum(out, c[2], 2)
    append(out, ' ')
    appendNum(out, c[3], 2)
    append(out, ':')
    appendNum(out, c[4], 2)
    return string(out)
}

// "MM-DD HH:MM" in UTC
pub fn formatIso(secs: int): string {
    let c = civil(secs)
    var out = new []byte(0)
    appendNum(out, c[1], 2)
    append(out, '-')
    appendNum(out, c[2], 2)
    append(out, ' ')
    appendNum(out, c[3], 2)
    append(out, ':')
    appendNum(out, c[4], 2)
    return string(out)
}
