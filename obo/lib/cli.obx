// obo/lib/cli.obx: the eza command-line grammar over an argv array.
//
//     import "cli.obx" as cli         // from obo/lib/
//
// The module is `cli`, not `args`: args() is a universe builtin and the alias
// check rejects an alias equal to it. parse() walks args[from..] and returns a
// Parsed whose Option records and operands are new owned strings (substr
// copies); it never retains a reference into argv or the specs. It does not
// print and does not exit: the caller prefixes "eza: " and exits 3. Usage
// errors are err(message, 22) (EINVAL); the messages are the pinned eza
// 0.23.3 wording.
//
// Grammar (design section 5.6):
//   * Options and free operands are interspersed; "-" alone and "" are
//     operands. A "--" token ends option parsing and the remaining tokens are
//     operands (a second "--" after it is an operand too).
//   * Equals splitting applies to long and short tokens: split at the FIRST
//     '=' only when the name before it is non-empty and at least one byte
//     follows. Otherwise the token is not split and a trailing '=' is an
//     ordinary byte. A split long token reports only the name before '=';
//     a non-split token is reported whole.
//   * Long: --name / --name=value. With no split, VALUE_REQUIRED consumes the
//     next token as its value, VALUE_OPTIONAL consumes it only when it is in
//     consume, and otherwise the flag uses its default. A VALUE_NONE flag
//     given a split value is an error.
//   * Short clusters: every byte after '-' is a flag. Without a split,
//     VALUE_NONE continues the cluster, VALUE_REQUIRED takes the rest of the
//     cluster (including a leading '=') or the next token, and VALUE_OPTIONAL
//     takes a non-empty rest only when it is in consume (else an error) or the
//     next token only when it is in consume. With a split, the bytes before
//     '=' are the cluster and only the LAST prefix flag takes the split value,
//     validated against accept. An earlier prefix flag mirrors eza 0.23.3:
//     VALUE_NONE records no value and the walk continues, VALUE_OPTIONAL
//     records the spec's default and the walk continues, and VALUE_REQUIRED is
//     `err(missingShortMessage(spec, c), 22)`. A prefix flag never consumes
//     the remainder of the token (design 5.6 leaves this unpinned).
//   * Values validated against accept when accept is non-empty, after the
//     whole token walk (eza parses every token before deduction): a bad
//     required value is `Option --long (-s) has no "v" setting (choices:
//     ...)`; a bad optional value is the same without the choices text.
//     Deferring means a syntax error later in argv wins over an earlier bad
//     value: `--sort=foo -Q` is `Unknown argument -Q`. Every occurrence is
//     then validated in occurrence order; eza deduces only the effective
//     (last) occurrence and in fixed category order, so differing bad values
//     in one argv can still report a different one. That multi-error
//     precedence is left to P0/P4.
//
// Option.value carries the EFFECTIVE value: an explicit value is copied in;
// when a bare VALUE_OPTIONAL flag uses a non-empty default, value is that
// default. hasValue is true when value is effective this way and false for
// VALUE_NONE and for an optional flag with an empty default. The eza layer
// reads value to decide WHEN; hasValue remains for callers that need to know
// whether a value is present.
//
// The helper functions are the token predicates used by parse:
//   isLong(a)        len(a) > 2 and a starts with "--" ("--" itself is not long)
//   longName(a)      "" when not long; else the bytes after "--", split at the
//                    first '=' when the split rule applies, otherwise the whole
//                    rest (so "--classify=" has name "classify=")
//   hasLongValue(a)  true when the split rule applies to a long token
//   longValue(a)     bytes after the first '=' when hasLongValue, else ""
//   shortName(a, i)  a[i], or the byte 0 when i is out of range
// A short form byte 0 in a FlagSpec means "no short form"; it is distinct from
// '-' (45), so 0 never matches a real token byte except a NUL byte in argv,
// which the C argv cannot contain.
module cli

pub const VALUE_NONE = 0
pub const VALUE_REQUIRED = 1
pub const VALUE_OPTIONAL = 2

pub type FlagSpec = ref record {
    short: byte          // 0 = no short form
    long: string         // canonical long name, never ""
    mode: int            // VALUE_NONE / VALUE_REQUIRED / VALUE_OPTIONAL
    consume: []string    // optional: values consumed as a separate next token
    accept: []string     // values accepted after '=' or attached; empty = any
    choices: []string    // text for error/help choices; empty = no choices text
    default: string      // optional: value when no value is given
}

pub type Option = ref record {
    short: byte          // the occurrence's short form, or 0
    long: string         // the matched long name
    value: string        // the effective value; "" for VALUE_NONE
    hasValue: bool
}

pub type Parsed = ref record {
    options: []Option
    operands: []string
}

// a one-byte string for error wording ("Unknown argument -Q")
fn oneChar(c: byte): string {
    var b = new []byte(0)
    append(b, c)
    return string(b)
}

// an independent copy of s (parse copies everything it stores)
fn dup(s: string): string {
    return substr(s, 0, len(s))
}

// true when xs contains s (xs is borrowed; empty means "not listed")
fn inList(xs: &[]string, s: string): bool {
    for i in 0..len(xs) {
        if xs[i] == s { return true }
    }
    return false
}

// index of the first '=' at or after from, or -1
fn firstEquals(a: string, from: int): int {
    for i in from..len(a) {
        if a[i] == '=' { return i }
    }
    return -1
}

fn specByShort(specs: &[]FlagSpec, c: byte): int {
    for i in 0..len(specs) {
        if specs[i].short == c && c != 0 { return i }
    }
    return -1
}

fn specByLong(specs: &[]FlagSpec, name: string): int {
    for i in 0..len(specs) {
        if specs[i].long == name { return i }
    }
    return -1
}

// accept is a whitelist when non-empty
fn accepts(spec: &FlagSpec, value: string): bool {
    if len(spec.accept) == 0 { return true }
    return inList(spec.accept, value)
}

// "--long" or "--long (-s)"
fn optionLabel(spec: &FlagSpec): string {
    if spec.short == 0 { return "--" + spec.long }
    return "--" + spec.long + " (-" + oneChar(spec.short) + ")"
}

// the bad-value message; withChoices is true only for VALUE_REQUIRED, because
// eza's Optional bad-value has no choices text even when choices are listed.
// The attempted value is inserted raw between the quotes. eza formats it with
// Rust's OsString Debug (options/error.rs), which escapes quotes, backslashes
// and control bytes; P1 leaves that to the errors layer (P2), which owns the
// debug-escaping primitive, and P0's bad values are simple.
fn noSettingMessage(spec: &FlagSpec, value: string, withChoices: bool): string {
    var msg = "Option " + optionLabel(spec) + " has no \"" + value + "\" setting"
    if withChoices && len(spec.choices) > 0 {
        msg = msg + " (choices: "
        for i in 0..len(spec.choices) {
            if i > 0 { msg = msg + ", " }
            msg = msg + spec.choices[i]
        }
        msg = msg + ")"
    }
    return msg
}

// "Flag --long needs a value" plus the choices text when listed
fn missingLongMessage(spec: &FlagSpec): string {
    var msg = "Flag --" + spec.long + " needs a value"
    if len(spec.choices) > 0 {
        msg = msg + " (choices: "
        for i in 0..len(spec.choices) {
            if i > 0 { msg = msg + ", " }
            msg = msg + spec.choices[i]
        }
        msg = msg + ")"
    }
    return msg
}

// the short spelling of the same message ("Flag -s needs a value ...")
fn missingShortMessage(spec: &FlagSpec, c: byte): string {
    var msg = "Flag -" + oneChar(c) + " needs a value"
    if len(spec.choices) > 0 {
        msg = msg + " (choices: "
        for i in 0..len(spec.choices) {
            if i > 0 { msg = msg + ", " }
            msg = msg + spec.choices[i]
        }
        msg = msg + ")"
    }
    return msg
}

// args() including argv[0]; eza calls parse(argv(), 1, specs)
pub fn argv(): []string {
    return args()
}

// a[i], or 0 when i is out of range (0 is the "no short form" byte)
pub fn shortName(a: string, i: int): byte {
    if i < 0 || i >= len(a) { return byte(0) }
    return a[i]
}

// a long option token: at least "--x" ("--" is the terminator, not long)
pub fn isLong(a: string): bool {
    return len(a) > 2 && a[0] == '-' && a[1] == '-'
}

// true when the long token splits into a name and a value: the first '=' has a
// non-empty name before it and at least one byte after it
pub fn hasLongValue(a: string): bool {
    if !isLong(a) { return false }
    let e = firstEquals(a, 2)
    return e > 2 && e + 1 < len(a)
}

// the long option's name; the whole rest when the token does not split
pub fn longName(a: string): string {
    if !isLong(a) { return "" }
    let e = firstEquals(a, 2)
    if e > 2 && e + 1 < len(a) { return substr(a, 2, e) }
    return substr(a, 2, len(a))
}

// the value after the first '=' when the token splits, else ""
pub fn longValue(a: string): string {
    if !hasLongValue(a) { return "" }
    let e = firstEquals(a, 2)
    return substr(a, e + 1, len(a))
}

// parse args[from..]; from must satisfy 0 <= from <= len(args)
pub fn parse(args: &[]string, from: int, specs: &[]FlagSpec): Result[Parsed] {
    if from < 0 || from > len(args) { return err("invalid argument start", 22) }
    var options = new []Option(0)
    var operands = new []string(0)
    var i = from
    var stop = false
    while i < len(args) && !stop {
        let a = args[i]
        if a == "--" {
            // everything after -- is an operand, including a second --
            i += 1
            while i < len(args) {
                append(operands, dup(args[i]))
                i += 1
            }
            stop = true
        } else if isLong(a) {
            if hasLongValue(a) {
                let name = longName(a)
                let value = longValue(a)
                let si = specByLong(specs, name)
                if si < 0 { return err("Unknown argument --" + name, 22) }
                if specs[si].mode == VALUE_NONE {
                    return err("Flag --" + specs[si].long + " cannot take a value", 22)
                }
                append(options, new Option{short: specs[si].short,
                                           long: dup(specs[si].long),
                                           value: dup(value), hasValue: true})
            } else {
                let name = longName(a)
                let si = specByLong(specs, name)
                if si < 0 { return err("Unknown argument " + a, 22) }
                if specs[si].mode == VALUE_NONE {
                    append(options, new Option{short: specs[si].short,
                                               long: dup(specs[si].long),
                                               value: "", hasValue: false})
                } else if specs[si].mode == VALUE_REQUIRED {
                    if i + 1 >= len(args) {
                        return err(missingLongMessage(specs[si]), 22)
                    }
                    i += 1
                    let value = args[i]
                    append(options, new Option{short: specs[si].short,
                                               long: dup(specs[si].long),
                                               value: dup(value), hasValue: true})
                } else {
                    if i + 1 < len(args) && inList(specs[si].consume, args[i + 1]) {
                        i += 1
                        let value = args[i]
                        append(options, new Option{short: specs[si].short,
                                                   long: dup(specs[si].long),
                                                   value: dup(value), hasValue: true})
                    } else {
                        let value = specs[si].default
                        append(options, new Option{short: specs[si].short,
                                                   long: dup(specs[si].long),
                                                   value: dup(value),
                                                   hasValue: len(value) > 0})
                    }
                }
            }
        } else if len(a) > 1 && a[0] == '-' {
            // a short token ("-" alone was an operand above)
            let e = firstEquals(a, 1)
            if e > 1 && e + 1 < len(a) {
                // split: the bytes 1..e-1 are the cluster; the last takes value
                var j = 1
                var done = false
                while j < e && !done {
                    let c = a[j]
                    let si = specByShort(specs, c)
                    if si < 0 { return err("Unknown argument -" + oneChar(c), 22) }
                    if j == e - 1 {
                        let value = substr(a, e + 1, len(a))
                        if specs[si].mode == VALUE_NONE {
                            return err("Flag -" + oneChar(c) + " cannot take a value", 22)
                        }
                        append(options, new Option{short: c,
                                                   long: dup(specs[si].long),
                                                   value: dup(value), hasValue: true})
                        done = true
                    } else if specs[si].mode == VALUE_NONE {
                        append(options, new Option{short: c,
                                                   long: dup(specs[si].long),
                                                   value: "", hasValue: false})
                        j += 1
                    } else if specs[si].mode == VALUE_OPTIONAL {
                        // an earlier optional prefix flag records its default
                        // and the walk continues (eza 0.23.3 parser.rs)
                        let value = specs[si].default
                        append(options, new Option{short: c,
                                                   long: dup(specs[si].long),
                                                   value: dup(value),
                                                   hasValue: len(value) > 0})
                        j += 1
                    } else {
                        // an earlier required prefix flag is missing its value
                        // (eza 0.23.3 parser.rs needs-value error)
                        return err(missingShortMessage(specs[si], c), 22)
                    }
                }
            } else {
                var j = 1
                var done = false
                while j < len(a) && !done {
                    let c = a[j]
                    let si = specByShort(specs, c)
                    if si < 0 { return err("Unknown argument -" + oneChar(c), 22) }
                    if specs[si].mode == VALUE_NONE {
                        append(options, new Option{short: c,
                                                   long: dup(specs[si].long),
                                                   value: "", hasValue: false})
                        j += 1
                    } else if specs[si].mode == VALUE_REQUIRED {
                        if j + 1 < len(a) {
                            let value = substr(a, j + 1, len(a))
                            append(options, new Option{short: c,
                                                       long: dup(specs[si].long),
                                                       value: dup(value), hasValue: true})
                        } else if i + 1 < len(args) {
                            i += 1
                            let value = args[i]
                            append(options, new Option{short: c,
                                                       long: dup(specs[si].long),
                                                       value: dup(value), hasValue: true})
                        } else {
                            return err(missingShortMessage(specs[si], c), 22)
                        }
                        done = true
                    } else {
                        if j + 1 < len(a) {
                            let value = substr(a, j + 1, len(a))
                            if !inList(specs[si].consume, value) {
                                return err("Flag -" + oneChar(c) + " cannot take a value", 22)
                            }
                            append(options, new Option{short: c,
                                                       long: dup(specs[si].long),
                                                       value: dup(value), hasValue: true})
                        } else if i + 1 < len(args) && inList(specs[si].consume, args[i + 1]) {
                            i += 1
                            let value = args[i]
                            append(options, new Option{short: c,
                                                       long: dup(specs[si].long),
                                                       value: dup(value), hasValue: true})
                        } else {
                            let value = specs[si].default
                            append(options, new Option{short: c,
                                                       long: dup(specs[si].long),
                                                       value: dup(value),
                                                       hasValue: len(value) > 0})
                        }
                        done = true
                    }
                }
            }
        } else {
            append(operands, dup(a))
        }
        i += 1
    }
    // Value validation runs after the whole token walk, as in eza: every
    // token is parsed before any option is deduced, so a later unknown,
    // forbidden-value or missing-value error wins over an earlier bad value.
    var k = 0
    while k < len(options) {
        let si = specByLong(specs, options[k].long)
        if si >= 0 && specs[si].mode != VALUE_NONE {
            let value = options[k].value
            if !accepts(specs[si], value) {
                return err(noSettingMessage(specs[si], value,
                                            specs[si].mode == VALUE_REQUIRED), 22)
            }
        }
        k += 1
    }
    return ok(new Parsed{options: options, operands: operands})
}
