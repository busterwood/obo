// Decimal global initializers that need several live temporaries, and calls whose bodies need their own
// (0.16): each initializer's temporaries are hidden global slots, so nested and call-carrying expressions
// must not share one. The values are checked by hand: g1 = 3.75 * (4.0 - 21.0), g2 = 11.5 + 9.00 - 21.0,
// g4 = 21.0 * 5.5 + 0.75.
//
// A Result-returning builtin in an initializer has no frame for its status word or its result, so both
// are hidden global slots. Each initializer below hands its temporary straight to a function that
// consumes it and prints it, so a wrong status or a wrong result address fails here; building the value
// and freeing it at exit is checked by the plain q1..q4 globals as well.

type R = ref record { d: decimal }
var a = new R{d: 1.5}
var b = new R{d: 2.25}
var c = new R{d: 4.0}
var base = 10.0

fn f(): decimal {
    var t = base + 0.5
    return t * 2.0
}

fn g(x: decimal): decimal { return x + base }

var g1 = (a.d + b.d) * (c.d - f())
var g2 = g(a.d) + (b.d * c.d) - f()
var g4 = f() * (a.d + c.d) + (b.d - a.d)

// consumers of an initializer's temporary: a Result (decimal, int or string) is taken by value and
// matched, so the value is printed from a real read, not only constructed.
fn useQ(tag: string, r: Result[decimal]): int {
    match r {
        ok(v) { println(tag, " ok ", v) }
        err(m, c) { println(tag, " err ", c, " ", m) }
    }
    return 0
}

fn useI(tag: string, r: Result[int]): int {
    match r {
        ok(v) { println(tag, " ok ", v) }
        err(m, c) { println(tag, " err ", c, " ", m) }
    }
    return 0
}

fn useT(tag: string, r: Result[string]): int {
    match r {
        ok(s) { println(tag, " ok ", s) }
        err(m, c) { println(tag, " err ", c, " ", m) }
    }
    return 0
}

// The values, in declaration (initializer) order.
var o1 = useQ("div", decimal::div(1.0, 3.0, 4, HALF_AWAY))           // expect: div ok 0.3333
var o2 = useQ("quantize", decimal::quantize(1.234, 2, HALF_EVEN))   // expect: quantize ok 1.23
var o3 = useI("toInt", decimal::toInt(7.5, HALF_AWAY))              // expect: toInt ok 8
var o4 = useQ("check", decimal::check(1.5, 5, 2))                   // expect: check ok 1.5
var o5 = useQ("check bad", decimal::check(1.23456, 10, 4))          // expect: check bad err 3 obo: value does not fit the declared scale without rounding
var o6 = useQ("parse", decimal::parse("1.50"))                      // expect: parse ok 1.50
var o7 = useQ("parse bad", decimal::parse(".5"))                    // expect: parse bad err 4 obo: invalid decimal text
var o8 = useT("format", decimal::format(1.2300))                    // expect: format ok 1.2300
var o9 = useT("format bad", decimal::format(1e-20 * 1e-20))         // expect: format bad err 3 obo: decimal display scale would drop nonzero digits

// The same builtins as plain owned globals: construction and freeing at exit, with no read.
var q1: Result[decimal] = decimal::div(1.0, 3.0, 4, HALF_AWAY)
var q2: Result[decimal] = decimal::quantize(1.234, 2, HALF_EVEN)
var q3: Result[int] = decimal::toInt(7.5, HALF_AWAY)
var q4: Result[decimal] = decimal::check(1.5, 5, 2)

fn main() {
    println(g1, " ", g2, " ", g4)                 // expect: -63.7500 -0.500 116.250
    println(a.d, " ", b.d, " ", c.d, " ", base)   // expect: 1.5 2.25 4.0 10.0
    println(o1 + o2 + o3 + o4 + o5 + o6 + o7 + o8 + o9)   // expect: 0
}
