type Item = ref record { n: int }
var G = 0
var XS: []int = new []int(0)

fn call(f: fn(int): int): int { return f(1) }

fn main() {
    let f = fn (x: int): int {
        G += 1
        append(XS, x)
        return G
    }
    println(call(f))
    println(call(f))
    println(G, " ", len(XS))

    let items = new []Item(0)
    append(items, new Item{n: 7})
    let read = fn (i: &Item): int { return i.n }
    println(read(&items[0]))

    let s = fn (x: int): string { return "s" }
    println(s(1))
    let own = fn (x: int): Item { return new Item{n: x} }
    let made = own(8)
    println(made.n)
    let res = fn (x: int): Result[int] { return ok(x) }
    let r = res(9)
    match r {
        ok(v) { println(v) }
        err(m, c) { println(m) }
    }
}

// expect: 1
// expect: 2
// expect: 2 2
// expect: 7
// expect: s
// expect: 8
// expect: 9
