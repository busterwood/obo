// A recursive call may write through a handle, which could empty a field of an owned local unseen: the handle made
// from the field is no longer tracked (FORK.md, "Field and element origins"), so the free after the call is not
// reported, and the use is checked where it runs.
type Kid = ref record { n: int }
type Par = ref record { child: Kid }
fn rec(n: int) {
    if n == 0 { return }
    var p = new Par{child: new Kid{n: 1}}
    let h = handle(p.child)
    rec(n - 1)
    p.child = new Kid{n: 2}          // frees the first kid
    println(h.n)
}
fn main() {
    rec(1)
}
// expect-exit: 7
// expect-stderr: the object this handle names has been freed
