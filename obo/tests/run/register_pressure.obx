    ga[i & 3] += gp.y + ga[(i + 1) & 3] * ga[(i + 3) & 3] + gps[i & 1].x * gp.x
    return v + u + w + g + r.y + rr.inner.y + len(ga) + gp.x + gp.y + gps[0].x + gps[1].y
}

