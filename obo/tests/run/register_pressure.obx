// Register pressure: four hot locals take r12-r15, which leaves five temporaries, and a statement that
// holds a destination (an element, a field, a chain of them) or the earlier arguments of a call while its
// value is computed needs more as the value nests deeper. The compiler gives fewer registers to locals in a
// function that has such a statement (FORK.md, Phase 2), so each of these must still compile and run as it
// does with no registers. Each function is one shape at one depth of right-nested parentheses.

type P = ref record { x: int; y: int }
type R = ref record { inner: P }

var ga = new []int(0)
var gp = new P{x: 1, y: 2}
var gps = new []P(0)
var g = 0
var s = "abcdefgh"

fn id(a: int): int { return a }

fn p_asg_3(n: int): int {
    var v = 1
    var i = 0
    var u = 2
    var w = 3
    let r = new P{x: 1, y: 2}
    let rr = new R{inner: new P{x: 1, y: 1}}
    while i < n { v += i; u += v; w += u; i += 1 }
    ga[i & 3] = (v*2 + (v*2 + (v*2 + v*2)))
    return v + u + w + g + r.y + rr.inner.y + len(ga) + gp.x + gp.y + gps[0].x + gps[1].y
}

