fn p_lines3(n: int): int {
    var v = 1
    var i = 0
    var u = 2
    var w = 3
    let r = new P{x: 1, y: 2}
    let rr = new R{inner: new P{x: 1, y: 1}}
    while i < n { v += i; u += v; w += u; i += 1 }
    ga[i & 3] = v*2 + // continues
        (v*2 + (v*2 + v*2))
    return v + u + w + g + r.y + rr.inner.y + len(ga) + gp.x + gp.y + gps[0].x + gps[1].y
}

fn p_lines4(n: int): int {
    var v = 1
    var i = 0
    var u = 2
    var w = 3
    let r = new P{x: 1, y: 2}
    let rr = new R{inner: new P{x: 1, y: 1}}
    while i < n { v += i; u += v; w += u; i += 1 }
    ga[i & 3] = gp.y +
        gp.x *
        ga[i & 3] +
        gps[i & 1].x * rr.inner.y
    return v + u + w + g + r.y + rr.inner.y + len(ga) + gp.x + gp.y + gps[0].x + gps[1].y
}

// a function that is compiled twice: it runs out of registers with its locals in them, so it is compiled again
// with none. What the first pass left behind (a call waiting for a function declared later, in the body and in
// a loop's condition) must not survive it.
fn later(x: int): int
fn p_retry(n: int): int {
    var v = 1
    var i = 0
    var u = 2
    var w = 3
    let r = new P{x: 1, y: 2}
    let rr = new R{inner: new P{x: 1, y: 1}}
    while i < n { v += i; u += v; w += u; v += w; u += i; w += v; v += u; w += i; u += w; i += 1 }
    let l1 = later(u)
    ga[i & 3] = gps[i & 1].x + gp.x * ga[i & 3]
    let l2 = later(w) + later(v)
    g = l1 + l2 + later(i) + later(l1)
    ga[i & 3] += gps[i & 1].x + gp.x * ga[i & 3]
    g += later(w + u) + later(v)
    return v + u + w + g + r.y + rr.inner.y + len(ga) + gp.x + gp.y + gps[0].x + gps[1].y
}
fn later(x: int): int { return x * 3 + 1 }

