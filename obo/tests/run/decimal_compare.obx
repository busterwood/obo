// Comparison ignores display scale and compares numeric value only.

fn main() {
    println(1.0 == 1.00)             // expect: true
    println(1.0 != 1.00)             // expect: false
    println(1.0 < 1.00)              // expect: false
    println(1.0 <= 1.00)             // expect: true
    println(2.0 > 1.00)              // expect: true
    println(-1.0 < 0.0)              // expect: true
    println(0.0 == -0.00)            // expect: true
    if 2.0 >= 2.00 { println("ge") } // expect: ge
    let d = 3.14
    if d != 3.140 { println("bad") }
}
