type Node = ref record { v: int; kids: []Node; opt: ?Node }
type Bag = ref record { items: []Node; opt: ?Node }
fn mk(v: int): Node { return new Node{v: v, kids: new []Node(0), opt: nil} }
fn sinkI(a: []Node): int { return 0 }
fn sinkN(n: ?Node): int { return 0 }
fn sinkN2(a: []Node): Node { return mk(4) }
fn sinkArrRet(a: []Node): []Node { return a }
fn sinkBag(b: Bag): int { return 0 }
fn passOpt(o: ?Node): ?Node { return o }
// a handle's field assigned the take of the same field: the take empties it before the store writes it
fn c_own_take() {
    var t = new Bag{items: new []Node(0), opt: nil}
    t.opt = new Node{v: 3, kids: new []Node(0), opt: nil}
    let h = handle(t)
    h.opt = passOpt(take(h.opt))
    let p = take(t.opt)
    if p != nil { println(p.v) }      // expect: 3
}
// a handle's array assigned the replace of the array itself: the replace is the value the store writes
fn c_self_replace() {
    var b = new Bag{items: new []Node(0), opt: nil}
    append(b.items, mk(1))
    let h = handle(b)
    h.items = sinkArrRet(replace(h.items, new []Node(0)))
    println(len(b.items))             // expect: 1
}
// a take through a handle beside an index of the owner's own array: the take frees the field, not the array
fn c_take_sibling() {
    var b = new Bag{items: new []Node(0), opt: nil}
    append(b.items, mk(1))
    b.opt = mk(7)
    let h = handle(b)
    println(b.items[sinkN(take(h.opt))].v)   // expect: 1
}
// a replace through a handle beside an index of the owner's own array: the replace frees the field
fn c_replace_sibling() {
    var b = new Bag{items: new []Node(0), opt: nil}
    append(b.items, mk(1))
    let h = handle(b)
    println(h.items[sinkN(replace(h.opt, nil))].v)   // expect: 1
}
// a temporary handle beside an index of the owner's own array: the take frees the field, not the array
fn c_temp_handle_take() {
    var b = new Bag{items: new []Node(0), opt: nil}
    append(b.items, mk(1))
    b.opt = mk(3)
    println(b.items[sinkN(take(handle(b).opt))].v)   // expect: 1
}
// a local array indexed while a replace through a handle frees a different array of the owner
fn c_local_index_replace() {
    var b = new Bag{items: new []Node(0), opt: nil}
    append(b.items, mk(1))
    var xs = new []Node(0)
    append(xs, mk(7))
    let h = handle(b)
    println(xs[sinkI(replace(h.items, new []Node(0)))].v)   // expect: 7
}
// a local array appended a value that replaces a different array of the owner
fn c_local_append_replace() {
    var b = new Bag{items: new []Node(0), opt: nil}
    append(b.items, mk(1))
    var xs = new []Node(0)
    let h = handle(b)
    append(xs, sinkN2(replace(h.items, new []Node(0))))
    println(len(xs))                  // expect: 1
    println(len(b.items))             // expect: 0
}
// a local array indexed while a take through a handle frees a field of the owner
fn c_local_index_take() {
    var b = new Bag{items: new []Node(0), opt: nil}
    b.opt = mk(3)
    var xs = new []Node(0)
    append(xs, mk(7))
    let h = handle(b)
    println(xs[sinkN(take(h.opt)) + 0].v)   // expect: 7
}
// a mut parameter's array indexed by a take of a sibling field of the same parameter
fn setOptIdx(mut p: &Bag): int {
    p.items[sinkN(take(p.opt))].v = 2
    return 0
}
fn c_mutref_sibling_take() {
    var t = new Bag{items: new []Node(0), opt: nil}
    append(t.items, mk(1))
    t.opt = mk(7)
    println(setOptIdx(t))             // expect: 0
}
// a mut parameter's field assigned the take of the same field
fn setOptOwn(mut p: &Bag) {
    p.opt = passOpt(take(p.opt))
}
fn c_mutref_own_take() {
    var t = new Bag{items: new []Node(0), opt: nil}
    t.opt = mk(3)
    setOptOwn(t)
    let p = take(t.opt)
    if p != nil { println(p.v) }      // expect: 3
}
// a handle to one local indexed by a move of another local: the move frees nothing the handle names
fn c_handle_other_move() {
    var ob = new Bag{items: new []Node(0), opt: nil}
    append(ob.items, mk(9))
    var ot = new Bag{items: new []Node(0), opt: nil}
    let hob = handle(ob)
    println(hob.items[sinkBag(ot)].v)   // expect: 9
}
// a local array indexed while a replace through a handle parameter frees the parameter's array: the local is no
// field of the owner, so the replace cannot free it
fn idxLocal(h: ^Bag): int {
    var xs = new []Node(0)
    append(xs, mk(7))
    return xs[sinkI(replace(h.items, new []Node(0)))].v
}
fn c_local_param_replace() {
    var b = new Bag{items: new []Node(0), opt: nil}
    append(b.items, mk(1))
    println(idxLocal(handle(b)))   // expect: 7
}
// a mut parameter's array indexed by a move of a local the callee declared: a reference cannot point into it
fn f1(mut p: &Bag): int {
    var t = new Bag{items: new []Node(0), opt: nil}
    return p.items[sinkBag(t)].v
}
fn c_f1_callee_local_move() {
    var b = new Bag{items: new []Node(0), opt: nil}
    append(b.items, mk(5))
    println(f1(b))                    // expect: 5
}
// a reference parameter's array indexed by a move of a local the callee declared
fn f2(p: &Bag): int {
    var t = new Bag{items: new []Node(0), opt: nil}
    return p.items[sinkBag(t)].v
}
fn c_f2_callee_local_move() {
    var b = new Bag{items: new []Node(0), opt: nil}
    append(b.items, mk(6))
    println(f2(b))                    // expect: 6
}
// a reference parameter's array indexed by a replace of an array the callee declared: no reference names it
fn f4(p: &Bag): int {
    var t = new Bag{items: new []Node(0), opt: nil}
    append(t.items, mk(2))
    return p.items[sinkI(replace(t.items, new []Node(0)))].v
}
fn c_f4_callee_local_replace() {
    var b = new Bag{items: new []Node(0), opt: nil}
    append(b.items, mk(8))
    println(f4(b))                    // expect: 8
}
// a reference parameter's array indexed by a take of an optional the callee declared
fn f5(p: &Bag): int {
    var t = new Bag{items: new []Node(0), opt: nil}
    t.opt = mk(3)
    return p.items[sinkN(take(t.opt))].v
}
fn c_f5_callee_local_take() {
    var b = new Bag{items: new []Node(0), opt: nil}
    append(b.items, mk(8))
    println(f5(b))                    // expect: 8
}
fn main() {
    c_own_take()
    c_self_replace()
    c_take_sibling()
    c_replace_sibling()
    c_temp_handle_take()
    c_local_index_replace()
    c_local_append_replace()
    c_local_index_take()
    c_mutref_sibling_take()
    c_mutref_own_take()
    c_handle_other_move()
    c_local_param_replace()
    c_f1_callee_local_move()
    c_f2_callee_local_move()
    c_f4_callee_local_replace()
    c_f5_callee_local_take()
}
