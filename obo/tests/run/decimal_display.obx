// Printing is display-scale preserving, including print() without a newline
// and several arguments in one call.

fn main() {
    print(1.20) // expect: 1.20
    println()
    println(1.2300, " ", 0.00) // expect: 1.2300 0.00
    println(1.0 * 0.10) // expect: 0.100
    println(1.00 + 2.0) // expect: 3.00
    println(1.00 * 2.0) // expect: 2.000
    println(1.00 % 0.3) // expect: 0.10
    println(12345678901234567890123456789012345678.0 * 0.1) // expect: 1234567890123456789012345678901234567.8
    println(0.1 * 12345678901234567890123456789012345678.0) // expect: 1234567890123456789012345678901234567.8
    println(1e38 * 0.1) // expect: 10000000000000000000000000000000000000
    println(0.1 * 1e38) // expect: 10000000000000000000000000000000000000
    println(12345678901234567890.0 * 123456789012345678.0) // expect: 1524157875323883663907940987639079420.0
    println(123456789012345678.0 * 12345678901234567890.0) // expect: 1524157875323883663907940987639079420.0
    println(12345678901234567890123456789012345678.0 * 0.1 == 0.1 * 12345678901234567890123456789012345678.0) // expect: true
    println(1e38 * 0.1 == 0.1 * 1e38) // expect: true
}
