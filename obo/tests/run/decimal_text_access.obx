// Public exponent/dscale: normalised exponent vs stored display scale.

fn accessIs(d: decimal, dscale: int, exp: int) {
    if decimal::dscale(d) == dscale && decimal::exponent(d) == exp {
        println("ok")
    } else {
        println("bad ", decimal::dscale(d), " ", decimal::exponent(d))
    }
}

fn main() {
    accessIs(1.2300, 4, -2)                     // expect: ok
    accessIs(0.001, 3, -3)                      // expect: ok
    accessIs(1e3, 0, 3)                         // expect: ok
    accessIs(1.2300e3, 1, 1)                    // expect: ok
    accessIs(0.00, 2, 0)                        // expect: ok
    accessIs(0e-32769, 32769, 0)                // expect: ok
    accessIs(0e-65535, 65535, 0)                // expect: ok
    accessIs(1e-16383, 16383, -16383)           // expect: ok
    accessIs(1.0e-16383, 16384, -16383)         // expect: ok
    accessIs(1000e-16384, 16384, -16381)        // expect: ok
    accessIs(1e32804, 0, 32804)                 // expect: ok
    accessIs(1e-32768, 32768, -32768)           // expect: ok

    // The arithmetic fixture keeps a raw exponent below int16-normalised
    // range but has two coefficient trailing zeros, so the normalised
    // exponent is the PostgreSQL-safe -16383.  A raw-word accessor would
    // return -16385 and fail the boundary.
    let tiny = (1.20 * 1.5) * 1e-16382
    accessIs(tiny, 38, -16383)                  // expect: ok

    let tiny2 = 1e-20 * 1e-20
    accessIs(tiny2, 38, -40)                    // expect: ok
}
