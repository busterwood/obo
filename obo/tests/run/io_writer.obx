// io_writer: flush thresholds 1, 3 and 16; write (string) and writeBytes (array)
// across the boundaries; flush success; the content is verified by reading the
// file back inside the program.
// expect: threshold 1 ok
// expect: threshold 3 ok
// expect: threshold 16 ok
// expect: big ok
import "io.obx" as io

fn addText(mut out: &[]byte, s: string) {
    for i in 0..len(s) { append(out, s[i]) }
}

fn verify(path: string, want: &[]byte) {
    let got = readFile(path)
    if got == nil { println("unreadable ", path); exit(1) }
    if len(got) != len(want) { println("length ", len(got), " want ", len(want)); exit(1) }
    for i in 0..len(got) {
        if got[i] != want[i] { println("byte ", i); exit(1) }
    }
}

fn runThreshold(path: string, size: int) {
    let s = "hello, writer\n"
    let o = openFile(path, "w")
    match o {
        ok(fd) {
            var w = io::newWriter(fd, size)
            let a = io::write(w, s)
            match a {
                ok(v) { }
                err(m, c) { println("write: ", m, " (", c, ")"); exit(1) }
            }
            var arr = new []byte(0)
            for i in 0..10 { append(arr, byte(i)) }
            let b = io::writeBytes(w, arr)
            match b {
                ok(v) { }
                err(m, c) { println("writeBytes: ", m, " (", c, ")"); exit(1) }
            }
            let f = io::flush(w)
            match f {
                ok(v) { if !v { println("flush false"); exit(1) } }
                err(m, c) { println("flush: ", m, " (", c, ")"); exit(1) }
            }
            let c = closeFile(fd)
            match c { ok(v) { } err(m, code) { println("close: ", m, " (", code, ")"); exit(1) } }
        }
        err(m, c) { println("open: ", m, " (", c, ")"); exit(1) }
    }
    var want = new []byte(0)
    addText(want, s)
    for i in 0..10 { append(want, byte(i)) }
    verify(path, want)
}

fn main() {
    let a = args()
    let dir = a[1]
    runThreshold(dir + "/w1.bin", 1)
    println("threshold 1 ok")
    runThreshold(dir + "/w3.bin", 3)
    println("threshold 3 ok")
    runThreshold(dir + "/w16.bin", 16)
    println("threshold 16 ok")

    // 10 KiB through a 64-byte threshold
    let path = dir + "/wbig.bin"
    let o = openFile(path, "w")
    match o {
        ok(fd) {
            var w = io::newWriter(fd, 64)
            var data = new []byte(10240)
            for i in 0..len(data) { data[i] = byte(i * 13) }
            let b = io::writeBytes(w, data)
            match b {
                ok(v) { }
                err(m, c) { println("big writeBytes: ", m, " (", c, ")"); exit(1) }
            }
            let f = io::flush(w)
            match f {
                ok(v) { if !v { println("big flush false"); exit(1) } }
                err(m, c) { println("big flush: ", m, " (", c, ")"); exit(1) }
            }
            let c = closeFile(fd)
            match c { ok(v) { } err(m, code) { println("big close: ", m, " (", code, ")"); exit(1) } }
            verify(path, data)
        }
        err(m, c) { println("big open: ", m, " (", c, ")"); exit(1) }
    }
    println("big ok")
}
