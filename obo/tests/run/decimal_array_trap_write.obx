// Writing an element past the end of a []decimal traps with exit 3, and so does a
// compound assignment to one: the bounds check runs before any element is touched.
fn main() {
    var xs = new []decimal(2)
    xs[1] = 3.5
    println(xs[1])                              // expect: 3.5
    xs[1] += 1.0
    println(xs[1])                              // expect: 4.5
    xs[2] = 1.0
    println("unreachable")
}

// expect-exit: 3
// expect-stderr: index out of range
