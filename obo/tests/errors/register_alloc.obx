// Register allocation changes where an int or bool local lives, never what is accepted: these are
// refused as they are with no registers. The locals are hot (used in a loop), so they are in registers.
// === a hot int local used as a statement
fn main() {
    var i = 0
    var t = 0
    while i < 10 {
        t += i
        i += 1
        i  // error: this expression does nothing
    }
    println(t)
}
// === a hot bool local used as a statement
fn main() {
    var i = 0
    var done = false
    while i < 10 {
        done = i > 5
        i += 1
        done  // error: this expression does nothing
    }
    println(i)
}
// === a hot int parameter used as a statement
fn f(n: int): int {
    var i = 0
    while i < n {
        i += 1
        n  // error: this expression does nothing
    }
    return i
}
fn main() { println(f(3)) }
