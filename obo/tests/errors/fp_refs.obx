fn later(mut b: &Bag): int
fn main() {
    var b = nb()
    println(two(&b.items[0], later(b)))  // error: argument 2 of two may free what argument 1 points into, and runs after
}
fn later(mut b: &Bag): int { b.items = new []Node(0); return 1 }
// === a global passed mut to a callee that frees it
var gx = new []Node(0)
fn gf(mut a: &[]Node): int { gx = new []Node(0); return 1 }
fn main() {
    append(gx, mk(1))
    println(two(&gx[0], gf(gx)))  // error: cannot pass a reference into global 'gx' to gf: it might free it
}
// === a mut argument passed on: the caller inherits the free of the global it passed
var gy = new []Node(0)
fn cut2(mut a: &[]Node): int { truncate(a, 0); return 0 }
fn wrap2(n: &Node): int { return cut2(gy) + n.v }
fn main() {
    append(gy, mk(1))
    println(wrap2(&gy[0]))  // error: cannot pass a reference into global 'gy' to wrap2: it might free it
}
// === the second of two parameters is the one that frees
fn sec(a: &Bag, mut b: &Bag): int { b.items = new []Node(0); return a.n }
fn main() {
    var b = nb()
    println(two(&b.items[0], sec(b, b)))  // error: argument 2 of two may free what argument 1 points into, and runs after
}
// === two mut parameters, the first one frees
fn tw(mut a: &Bag, mut b: &Bag): int { b.items = new []Node(0); return a.n }
fn main() {
    var a = nb()
    var b = nb()
    println(two(&a.items[0], tw(b, a)))  // error: argument 2 of two may free what argument 1 points into, and runs after
}
