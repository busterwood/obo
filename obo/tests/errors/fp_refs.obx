// === a loop's recursive call, the reference walked on every iteration
fn rec(n: &Item, h: ^Hold, d: int): int {
    if d == 0 {
        h.items = new []Item(0)
        return 0
    }
    var k = &n.kids
    var s = 0
    k = &n.kids
    for x in k {  // error: a recursive call in this loop writes through a handle, which could fre
        s += x.v
        s += rec(n, h, d - 1)
    }
    return s
}
fn main() {}
