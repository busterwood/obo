// === a mut callee that frees an element's children
fn nest(mut n: &Node): int { n.kids = new []Node(0); return 1 }
fn main() {
    var xs = new []Node(0)
    append(xs, mk(1))
    append(xs[0].kids, mk(2))
    println(two(&xs[0].kids[0], nest(xs[0])))  // error: argument 2 of two may free what argument 1 points into, and runs after
}
// === a mut callee that frees through an element of a walk
fn wk(mut b: &Bag): int {
    let items = &b.items
    for it in items { it.kids = new []Node(0) }
    return 1
}
fn main() {
    var b = nb()
    println(two(&b.items[0], wk(b)))  // error: argument 2 of two may free what argument 1 points into, and runs after
}
// === the same field of a parameter passed both as mut and as read-only
fn cutx(mut a: &[]Node, b: &[]Node): int { a[0] = mk(1); return len(b) }
fn g(mut p: &Pair): int { return cutx(p.xs, p.xs) }  // error: argument 2 of cutx may point inside argument 1, which is mut
fn main() {
    var q = new Pair{xs: new []Node(0), ys: new []Node(0)}
    append(q.xs, mk(3))
    println(g(q))
}
