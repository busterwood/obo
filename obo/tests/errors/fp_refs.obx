// === a mut callee that replaces the array through replace
fn sw(mut b: &Bag): int {
    var t = replace(b.items, new []Node(0))
    return 1
}
fn main() {
    var b = nb()
    println(two(&b.items[0], sw(b)))  // error: argument 2 of two may free what argument 1 points into, and runs after
}
// === a mut callee that writes through a handle
fn hw(mut a: &[]Node, h: ^Bag): int { h.items = new []Node(0); return 1 }
fn main() {
    var b = nb()
    var xs = new []Node(0)
    append(xs, mk(1))
    println(two(&xs[0], hw(xs, handle(b))))  // error: argument 2 of two may free what argument 1 points into, and runs after
}
// === a recursive mut callee
fn rr(mut a: &[]Node, d: int): int {
    if d == 0 { return 0 }
    return rr(a, d - 1)
}
fn main() {
    var xs = new []Node(0)
    append(xs, mk(1))
    println(two(&xs[0], rr(xs, 1)))  // error: argument 2 of two may free what argument 1 points into, and runs after
}
