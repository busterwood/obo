// The unsafe neighbours of the shapes in run/fp_refs.obx: each is still refused.
type Node = ref record { v: int; kids: []Node }
type Bag = ref record { items: []Node; opt: ?Node; n: int }
type Pair = ref record { xs: []Node; ys: []Node }
type Item = ref record { v: int; kids: []Item }
type Hold = ref record { items: []Item }
fn mk(v: int): Node { return new Node{v: v, kids: new []Node(0)} }
fn nb(): Bag {
    var b = new Bag{items: new []Node(0), opt: nil, n: 0}
    append(b.items, mk(9))
    return b
}
fn two(r: &Node, k: int): int { return r.v + k }
// === a mut callee that replaces an element
fn upd(mut a: &[]Node, k: int): int { a[k] = mk(7); return 1 }
fn main() {
    var xs = new []Node(0)
    append(xs, mk(1))
    append(xs, mk(2))
    println(two(&xs[0], upd(xs, 1)))  // error: argument 2 of two may free what argument 1 points into, and runs after
}
// === a mut callee that replaces an element, the reference held in a local
fn upd(mut a: &[]Node, k: int): int { a[k] = mk(7); return 1 }
fn main() {
    var xs = new []Node(0)
    append(xs, mk(1))
    append(xs, mk(2))
    let r = &xs[0]
    let z = upd(xs, 1)
    println(r.v + z)  // error: 'r' may point to freed memory: something under what it points into was
}
// === a mut callee that replaces a field
fn cut(mut b: &Bag): int { b.items = new []Node(0); return 1 }
fn main() {
    var b = nb()
    println(two(&b.items[0], cut(b)))  // error: argument 2 of two may free what argument 1 points into, and runs after
}
// === a mut callee that passes its parameter on to one that frees
fn cut(mut b: &Bag): int { b.items = new []Node(0); return 1 }
fn mid(mut b: &Bag): int { return cut(b) }
fn main() {
    var b = nb()
    println(two(&b.items[0], mid(b)))  // error: argument 2 of two may free what argument 1 points into, and runs after
}
// === a mut callee that passes a field of its parameter on to one that frees
fn sub2(mut a: &[]Node): int { a[0] = mk(1); return 1 }
fn sub(mut b: &Bag): int { return sub2(b.items) }
fn main() {
    var b = nb()
    println(two(&b.items[0], sub(b)))  // error: argument 2 of two may free what argument 1 points into, and runs after
}
// === a mut callee that frees through a reference it made
fn cut(mut b: &Bag): int {
    let it = &b.items
    it[0] = mk(3)
    return 1
}
fn main() {
    var b = nb()
    println(two(&b.items[0], cut(b)))  // error: argument 2 of two may free what argument 1 points into, and runs after
}
// === a mut callee that takes a field
fn tk(mut b: &Bag): int {
    var t = take(b.opt)
    return 1
}
fn main() {
    var b = nb()
    b.opt = mk(4)
    let r = &b.opt
    let z = tk(b)
    println(r == nil)  // error: 'r' may point to freed memory: something under what it points into was
}
// === a mut callee that truncates an array of owned elements
fn tr(mut a: &[]Node): int { truncate(a, 0); return 1 }
fn main() {
    var xs = new []Node(0)
    append(xs, mk(1))
    println(two(&xs[0], tr(xs)))  // error: argument 2 of two may free what argument 1 points into, and runs after
}
// === a mut callee that replaces an element through replace
fn rp(mut a: &[]Node): int { var o = replace(a[0], mk(5)); return 1 }
fn main() {
    var xs = new []Node(0)
    append(xs, mk(1))
    println(two(&xs[0], rp(xs)))  // error: argument 2 of two may free what argument 1 points into, and runs after
