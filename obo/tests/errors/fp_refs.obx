// === a loop's recursive call, the reference read before it is pointed afresh
fn rec(n: &Item, h: ^Hold, d: int): int {
    if d == 0 {
        h.items = new []Item(0)
        return 0
    }
    var k = &n.kids[0]
    var i = 0
    var s = 0
    while i < 2 {  // error: a recursive call in this loop writes through a handle, which could fre
        s += k.v
        k = &n.kids[0]
        s += rec(n, h, d - 1)
        i += 1
    }
    return s
}
fn main() {}
