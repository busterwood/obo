type Item = ref record { v: int; kids: []Item }
type Bag = ref record { items: []Item; n: int }
// no global variables here: each case's invalidation must come from the reference's own binding
// === a reference re-pointed on one branch of an if: the owner is freed on the other path
fn main() {
    var a = new Item{v: 1, kids: new []Item(0)}
    var b = new Item{v: 2, kids: new []Item(0)}
    var k = &a
    if a.v == 2 { k = &b }
    a = new Item{v: 3, kids: new []Item(0)}   // frees the old a, which k still points to
    println(k.v)  // error: 'k' may point to freed memory
}
// === the same, through a handle, with a deep reference
fn main() {
    var root = new Item{v: 1, kids: new []Item(0)}
    append(root.kids, new Item{v: 7, kids: new []Item(0)})
    let h = handle(root)
    var k = &root.kids[0]
    if root.v == 2 { k = &root }
    h.kids = new []Item(0)                    // frees the kids that k points into on one path
    println(k.v)  // error: 'k' may point to freed memory
}
// === the same in a recursive walk: the re-point is on one path only
fn rec(n: &Item, h: ^Item, d: int) {
    var k = &n.kids[0]
    if d == 5 { k = &n }
    if d > 0 { rec(n, h, d - 1) }
    println(k.v)  // error: 'k' may point to freed memory
    if d == 0 {
        h.kids = new []Item(0)
        return
    }
}
fn main() {
    var root = new Item{v: 1, kids: new []Item(0)}
    append(root.kids, new Item{v: 7, kids: new []Item(0)})
    rec(root, handle(root), 2)
}
// === a re-point in one arm of a match
fn main() {
    var a = new Item{v: 1, kids: new []Item(0)}
    var b = new Item{v: 2, kids: new []Item(0)}
    var k = &a
    match a.v {
        2 { k = &b }
        else { }
    }
    a = new Item{v: 3, kids: new []Item(0)}
    println(k.v)  // error: 'k' may point to freed memory
}
// === a re-point in an else-if chain: the path that takes no branch keeps the old root
fn main() {
    var a = new Item{v: 1, kids: new []Item(0)}
    var b = new Item{v: 2, kids: new []Item(0)}
    var c = new Item{v: 3, kids: new []Item(0)}
    var k = &a
    let n = a.v
    if n == 1 {
        k = &b
    } else if n == 2 {
        k = &c
    }
    a = new Item{v: 4, kids: new []Item(0)}
    println(k.v)  // error: 'k' may point to freed memory
}
// === a loop points the reference at a new root and reads it at the top of the body
fn main() {
    var a = new Item{v: 1, kids: new []Item(0)}
    var b = new Item{v: 2, kids: new []Item(0)}
    var k = &a
    var i = 0
    while i < 3 {  // error: 'k' is pointed somewhere new inside the loop
        println(k.v)
        b = new Item{v: 3, kids: new []Item(0)}   // frees what k may point into, from an earlier pass
        if i == 1 { k = &b }
        i += 1
    }
}
// === a reference that may point into either of two roots, after both are changed
fn main() {
    var a = new Item{v: 1, kids: new []Item(0)}
    var b = new Item{v: 2, kids: new []Item(0)}
    var k = &a
    if a.v == 2 { k = &b }
    b = new Item{v: 5, kids: new []Item(0)}
    a = new Item{v: 6, kids: new []Item(0)}
    println(k.v)  // error: 'k' may point to freed memory
}
// === a reference re-pointed on both branches to two roots: a change under the second one is seen
fn main() {
    var a = new Item{v: 1, kids: new []Item(0)}
    var b = new Item{v: 2, kids: new []Item(0)}
    var c = new Item{v: 3, kids: new []Item(0)}
    var k = &a
    if a.v == 1 { k = &b } else { k = &c }
    c = new Item{v: 4, kids: new []Item(0)}
    println(k.v)  // error: 'k' may point to freed memory
}
// === the same array element joined from two indexes: a change under the other one is seen
fn main() {
    var items = new []Item(0)
    append(items, new Item{v: 1, kids: new []Item(0)})
    append(items, new Item{v: 2, kids: new []Item(0)})
    var k = &items[1]
    if items[0].v == 1 { k = &items[0] }
    items[1] = new Item{v: 5, kids: new []Item(0)}   // frees what k points into on the other path
    println(k.v)  // error: 'k' may point to freed memory
}
