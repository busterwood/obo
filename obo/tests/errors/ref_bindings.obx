type Item = ref record { v: int; kids: []Item }
type Bag = ref record { items: []Item; n: int }
// no global variables here, except in a case that says so: each case's invalidation must come from the reference's own binding
// === a reference re-pointed on one branch of an if: the owner is freed on the other path
fn main() {
    var a = new Item{v: 1, kids: new []Item(0)}
    var b = new Item{v: 2, kids: new []Item(0)}
    var k = &a
    if a.v == 2 { k = &b }
    a = new Item{v: 3, kids: new []Item(0)}   // frees the old a, which k still points to
    println(k.v)  // error: 'k' may point to freed memory
}
// === the same, through a handle, with a deep reference
fn main() {
    var root = new Item{v: 1, kids: new []Item(0)}
    append(root.kids, new Item{v: 7, kids: new []Item(0)})
    let h = handle(root)
    var k = &root.kids[0]
    if root.v == 2 { k = &root }
    h.kids = new []Item(0)                    // frees the kids that k points into on one path
    println(k.v)  // error: 'k' may point to freed memory
}
// === the same in a recursive walk: the re-point is on one path only
fn rec(n: &Item, h: ^Item, d: int) {
    var k = &n.kids[0]
    if d == 5 { k = &n }
    if d > 0 { rec(n, h, d - 1) }
    println(k.v)  // error: 'k' may point to freed memory
    if d == 0 {
        h.kids = new []Item(0)
        return
    }
}
fn main() {
    var root = new Item{v: 1, kids: new []Item(0)}
    append(root.kids, new Item{v: 7, kids: new []Item(0)})
    rec(root, handle(root), 2)
}
// === a re-point in one arm of a match
fn main() {
    var a = new Item{v: 1, kids: new []Item(0)}
    var b = new Item{v: 2, kids: new []Item(0)}
    var k = &a
    match a.v {
        2 { k = &b }
        else { }
    }
    a = new Item{v: 3, kids: new []Item(0)}
    println(k.v)  // error: 'k' may point to freed memory
}
// === a re-point in an else-if chain: the path that takes no branch keeps the old root
fn main() {
    var a = new Item{v: 1, kids: new []Item(0)}
    var b = new Item{v: 2, kids: new []Item(0)}
    var c = new Item{v: 3, kids: new []Item(0)}
    var k = &a
    let n = a.v
    if n == 1 {
        k = &b
    } else if n == 2 {
        k = &c
    }
    a = new Item{v: 4, kids: new []Item(0)}
    println(k.v)  // error: 'k' may point to freed memory
}
// === a loop points the reference at a new root and reads it at the top of the body
fn main() {
    var a = new Item{v: 1, kids: new []Item(0)}
    var b = new Item{v: 2, kids: new []Item(0)}
    var k = &a
    var i = 0
    while i < 3 {  // error: 'k' is pointed somewhere new inside the loop
        println(k.v)
        b = new Item{v: 3, kids: new []Item(0)}   // frees what k may point into, from an earlier pass
        if i == 1 { k = &b }
        i += 1
    }
}
// === a reference that may point into either of two roots, after both are changed
fn main() {
    var a = new Item{v: 1, kids: new []Item(0)}
    var b = new Item{v: 2, kids: new []Item(0)}
    var k = &a
    if a.v == 2 { k = &b }
    b = new Item{v: 5, kids: new []Item(0)}
    a = new Item{v: 6, kids: new []Item(0)}
    println(k.v)  // error: 'k' may point to freed memory
}
// === a reference re-pointed on both branches to two roots: a change under the second one is seen
fn main() {
    var a = new Item{v: 1, kids: new []Item(0)}
    var b = new Item{v: 2, kids: new []Item(0)}
    var c = new Item{v: 3, kids: new []Item(0)}
    var k = &a
    if a.v == 1 { k = &b } else { k = &c }
    c = new Item{v: 4, kids: new []Item(0)}
    println(k.v)  // error: 'k' may point to freed memory
}
// === the same array element joined from two indexes: a change under the other one is seen
fn main() {
    var items = new []Item(0)
    append(items, new Item{v: 1, kids: new []Item(0)})
    append(items, new Item{v: 2, kids: new []Item(0)})
    var k = &items[1]
    if items[0].v == 1 { k = &items[0] }
    items[1] = new Item{v: 5, kids: new []Item(0)}   // frees what k points into on the other path
    println(k.v)  // error: 'k' may point to freed memory
}
// === a reference joined from a place and the place below it: a change at the lower place is seen
fn main() {
    var root = new Item{v: 1, kids: new []Item(0)}
    append(root.kids, new Item{v: 2, kids: new []Item(0)})
    append(root.kids[0].kids, new Item{v: 3, kids: new []Item(0)})
    var k = &root.kids[0]
    if root.v == 1 { k = &root.kids[0].kids[0] }
    root.kids[0].kids = new []Item(0)     // frees what k may point into, on one path
    println(k.v)  // error: 'k' may point to freed memory
}
// === a reference shallow on one path and deep on the other: a change under the deep one is seen
fn main() {
    var root = new Item{v: 1, kids: new []Item(0)}
    append(root.kids, new Item{v: 2, kids: new []Item(0)})
    var k = &root
    if root.v == 1 { k = &root.kids[0] }
    root.kids = new []Item(0)             // frees the kids that k may point into, on one path
    println(k.v)  // error: 'k' may point to freed memory
}
// === a reference writable on one path and read-only on the other: writing through it is refused
fn pick(r: &Item) {
    var a = new Item{v: 1, kids: new []Item(0)}
    var k = &a
    if r.v == 2 { k = r }
    k.v = 5  // error: cannot change through 'k': it is a read-only reference
    println(a.v)
}
fn main() {
    var x = new Item{v: 2, kids: new []Item(0)}
    pick(x)
}
// === a defer that re-points a reference declared before it: the body runs where the block is left
fn main() {
    var a = new Item{v: 1, kids: new []Item(0)}
    var b = new Item{v: 2, kids: new []Item(0)}
    var k = &a
    if a.v == 1 {
        defer k = &b  // error: cannot point 'k' elsewhere in a defer
        println(k.v)
    }
    println(k.v)
}
// === the same in a loop, with a break: the change would not be seen where the loop is left
fn main() {
    var a = new Item{v: 1, kids: new []Item(0)}
    var b = new Item{v: 2, kids: new []Item(0)}
    var k = &a
    var i = 0
    while i < 3 {
        defer k = &b  // error: cannot point 'k' elsewhere in a defer
        i += 1
        break
    }
    println(k.v)
}
// === a while condition that frees a global the reference points into, and the body reads it at the top
var h = new Item{v: 1, kids: new []Item(0)}
fn bump(): bool {
    h = new Item{v: 2, kids: new []Item(0)}
    return false
}
fn main() {
    var a = new Item{v: 5, kids: new []Item(0)}
    var k = &a
    var i = 0
    while !bump() && i < 3 {  // error: 'k' is pointed somewhere new inside the loop
        println(k.v)
        k = &h
        i += 1
    }
}
// === a loop that frees what the reference points into, then reads it at the top of the next pass
fn main() {
    var a = new Item{v: 1, kids: new []Item(0)}
    var b = new Item{v: 2, kids: new []Item(0)}
    var k = &a
    var i = 0
    while i < 3 {  // error: 'k' is pointed somewhere new inside the loop
        b = new Item{v: 7, kids: new []Item(0)}
        println(k.v)
        k = &b
        i += 1
    }
}
// === a reference writable where a loop starts, read-only where the loop starts again
fn walk(r: &Item) {
    var a = new Item{v: 1, kids: new []Item(0)}
    var k = &a
    var i = 0
    while i < 2 {  // error: 'k' is read-only where the loop starts again
        k.v = 5
        k = r
        i += 1
    }
    println(a.v)
}
fn main() {
    var x = new Item{v: 2, kids: new []Item(0)}
    walk(x)
}
// === a break after a call that frees what the reference points into on an earlier pass
var h = new Item{v: 1, kids: new []Item(0)}
var n = 0
fn bump(): bool {
    h = new Item{v: n, kids: new []Item(0)}
    n += 1
    return n == 3
}
fn main() {
    var a = new Item{v: 5, kids: new []Item(0)}
    var k = &a
    var i = 0
    while i < 10 {
        if bump() { break }
        k = &h
        i += 1
    }
    println(k.v)  // error: 'k' may point to freed memory
}
// === a while condition that frees what the reference points into, read after the loop
var h = new Item{v: 1, kids: new []Item(0)}
fn bump(): bool {
    h = new Item{v: 2, kids: new []Item(0)}
    return true
}
fn main() {
    var a = new Item{v: 5, kids: new []Item(0)}
    var k = &a
    var i = 0
    while bump() && i < 3 {
        k = &h
        i += 1
    }
    println(k.v)  // error: 'k' may point to freed memory
}
// === a continue after a call that frees what the reference points into on an earlier pass
var h = new Item{v: 1, kids: new []Item(0)}
var n = 0
fn bump(): bool {
    h = new Item{v: n, kids: new []Item(0)}
    n += 1
    return n == 3
}
fn main() {
    var a = new Item{v: 5, kids: new []Item(0)}
    var k = &a
    var i = 0
    while i < 10 {  // error: 'k' is invalidated inside the loop
        i += 1
        if bump() { continue }
        k = &h
    }
    println(k.v)
}
// === a deferred free of a reference's target at block exit, read after the block
fn main() {
    var a = new Item{v: 1, kids: new []Item(0)}
    var b = new Item{v: 2, kids: new []Item(0)}
    var k = &b
    {
        defer { a = new Item{v: 9, kids: new []Item(0)} }
        k = &a
        println(k.v)
    }
    println(k.v)  // error: 'k' may point to freed memory
}
// === a deferred free in a loop body of what the reference points into, read at the top of the next pass
fn main() {
    var a = new Item{v: 1, kids: new []Item(0)}
    var b = new Item{v: 2, kids: new []Item(0)}
    var k = &a
    var i = 0
    while i < 3 {  // error: 'k' is invalidated inside the loop
        println(k.v)
        {
            defer { b = new Item{v: 7, kids: new []Item(0)} }
            k = &b
            i += 1
        }
    }
}
// === a recursive call that frees through a handle on its innermost pass, and a deep reference read on the next pass
fn rec(n: &Item, h: ^Item, d: int) {
    var k = &n.kids[0]
    var i = 0
    while i < 2 {
        println(k.v)
        if d > 0 { rec(n, h, d - 1) }
        i += 1
    }
    if d == 0 { h.kids = new []Item(0) }  // error: 'k' is invalidated on one path but not another
}
fn main() {
    var root = new Item{v: 1, kids: new []Item(0)}
    append(root.kids, new Item{v: 7, kids: new []Item(0)})
    rec(root, handle(root), 2)
}
// === a loop frees what the reference points into, then an inner loop, then the reference is read at the top of the next pass
fn main() {
    var a = new Item{v: 1, kids: new []Item(0)}
    var b = new Item{v: 2, kids: new []Item(0)}
    var k = &a
    var i = 0
    while i < 3 {  // error: 'k' is pointed somewhere new inside the loop
        println(k.v)
        b = new Item{v: 7, kids: new []Item(0)}
        var j = 0
        while j < 1 { j += 1 }
        if i == 1 { k = &b }
        i += 1
    }
}
