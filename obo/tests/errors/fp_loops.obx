// === the owner moved in a returning arm, the handle used after the loop: the origin is cleared for what follows
fn f(): int {
    var a = nb()
    let h = handle(a)
    var i = 0
    while i < 3 {
        if i == 1 { println(count(a)); return 4 }
        i += 1
    }
    println(h.n)  // error: handle 'h' was made from an owner that a loop moved: make the handle a
    return 0
}
fn main() { println(f()) }
// === the owner moved on the continue path
fn f(): int {
    var a = nb()
    let h = handle(a)
    var i = 0
    while i < 3 {
        if i == 1 { println(count(a)); a = nb(); i += 1; continue }  // error: cannot move 'a' inside a loop while handle 'h' made from it is in scop
        if i == 2 { return 2 }
        println(h.n)
        i += 1
    }
    return 0
}
fn main() { println(f()) }
// === an arm that frees and breaks out of an inner loop, then breaks the outer one
fn f() {
    var a = nb()
    let h = handle(a)
    var i = 0
    while i < 3 {
        if i == 1 {
            a = nb()
            var j = 0
            while j < 2 {
                j += 1
                if j == 1 { break }
            }
            break
        }
        i += 1
    }
    println(h.n)  // error: handle 'h' may name a freed object: 'a' was assigned or dropped after 
}
fn main() { f() }
