// === a free then a break in an inner loop, the handle used after the inner loop
fn f() {
    var a = nb()
    let h = handle(a)
    var i = 0
    while i < 3 {
        var j = 0
        while j < 3 {
            j += 1
            if j == 1 {
                a = nb()
                break
            }
        }
        i += 1
    }
    println(h.n)  // error: handle 'h' may name a freed object: 'a' was assigned or dropped after 
}
