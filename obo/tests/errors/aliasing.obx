type Node = ref record { value: int; next: ?Node }
type Box = ref record { node: ?Node; items: []Node }
var g = new Box{items: new []Node(0)}
fn make(): Node { return new Node{value: 0} }
fn grow(mut b: &Box, n: &Node) {}
fn both(mut b: &Box, mut n: &Node) {}
fn elemFirst(mut n: &Node, mut b: &Box) {}
fn twoMut(mut a: &Node, mut b: &Node) {}
fn clear(mut b: &Box) { b.items = new []Node(0) }
fn main() {}
// === a change through a parameter may free inside a global: the parameter may be it
fn f(mut p: &Box) {
    let x = &g.items
    p.items = new []Node(0)
    println(len(x))  // error: 'x' may point to freed memory
}
// === a change through a parameter reaches another parameter
fn f(a: &Box, mut b: &Box) {
    let x = &a.items
    b.items = new []Node(0)
    println(len(x))  // error: 'x' may point to freed memory
}
// === a mut call through a parameter reaches another parameter
fn f(a: &Box, mut b: &Box) {
    let x = &a.items
    clear(b)
    println(len(x))  // error: 'x' may point to freed memory
}
// === a mut call through a parameter reaches a global
fn f(mut p: &Box) {
    let x = &g.items
    clear(p)
    println(len(x))  // error: 'x' may point to freed memory
}
// === truncating through one parameter while a loop walks another, then using the element
fn f(a: &[]Node, mut b: &[]Node) {
    for n in a {
        truncate(b, 0)
        println(n.value)  // error: 'n' may point to freed memory
    }
}
// === a mut argument and a reference inside it
fn f() {
    let b = new Box{items: new []Node(0)}
    append(b.items, make())
    grow(b, b.items[0])  // error: argument 2 of grow may point inside argument 1, which is mut
}
// === a mut parameter and a reference inside a global
fn f(mut p: &Box) {
    grow(p, g.items[0])  // error: argument 2 of grow may point inside argument 1, which is mut
}
// === a mut parameter and a reference inside another parameter
fn f(mut p: &Box, q: &Box) {
    grow(p, q.items[0])  // error: argument 2 of grow may point inside argument 1, which is mut
}
// === two mut references, one inside the other
fn f() {
    let b = new Box{items: new []Node(0)}
    append(b.items, make())
    both(b, b.items[0])  // error: argument 2 of both may point inside argument 1, which is mut
}
// === the inner mut reference first
fn f() {
    let b = new Box{items: new []Node(0)}
    append(b.items, make())
    elemFirst(b.items[0], b)  // error: argument 1 of elemFirst may point inside argument 2, which is mut
}
// === two mut elements (conservative until paths are finer: they might be one inside the other)
fn f() {
    let b = new Box{items: new []Node(0)}
    append(b.items, make())
    append(b.items, make())
    twoMut(b.items[0], b.items[1])  // error: argument 2 of twoMut may point inside argument 1, which is mut
}
