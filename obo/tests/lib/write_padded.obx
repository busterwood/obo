// write_padded: io::writePadded. One fixed sequence exercises
// width 0 (no padding), a padded zero, values narrower/wider than the width and
// a width larger than the digits; each is written through Writer thresholds 1,
// 3, 8 and 65536 so the flush-inside-writePadded path is covered too. The file
// is read back and compared byte for byte; OBO_CHECK=1 covers leaks and fds.
// expect: case 1 ok
// expect: case 3 ok
// expect: case 8 ok
// expect: case 65536 ok
import "io.obx" as io

fn emitSeq(mut w: &io::Writer): Result[bool] {
    try io::writePadded(w, 0, 0)
    try io::write(w, "|")
    try io::writePadded(w, 0, 2)
    try io::write(w, "|")
    try io::writePadded(w, 7, 5)
    try io::write(w, "|")
    try io::writePadded(w, 42, 1)
    try io::write(w, "|")
    try io::writePadded(w, 1000001, 6)
    try io::write(w, "|")
    try io::writePadded(w, 999999, 8)
    try io::write(w, "\n")
    return ok(true)
}

fn oneCase(dir: string, size: int) {
    let name = "wp" + string(size)
    let path = dir + "/" + name
    let f = openFile(path, "w")
    match f {
        ok {
            let fd = f.value
            defer closeFile(fd)
            var w = io::newWriter(fd, size)
            let e = emitSeq(w)
            match e {
                ok { }
                err { println("case ", size, " write error ", e.code); exit(1) }
            }
            let fl = io::flush(w)
            match fl {
                ok { }
                err { println("case ", size, " flush error ", fl.code); exit(1) }
            }
        }
        err { println("case ", size, " open error ", f.code); exit(1) }
    }
    let got = readFile(path)
    if got == nil { println("case ", size, " read failed"); exit(1) }
    let want = "0| 0|    7|42|1000001|  999999\n"
    if len(got) != len(want) {
        println("case ", size, " length ", len(got), " want ", len(want)); exit(1)
    }
    for i in 0..len(want) {
        if got[i] != want[i] {
            println("case ", size, " byte ", i, " is ", int(got[i]), " want ", int(want[i]))
            exit(1)
        }
    }
    println("case ", size, " ok")
}

fn main() {
    let a = args()
    let dir = a[1]
    oneCase(dir, 1)
    oneCase(dir, 3)
    oneCase(dir, 8)
    oneCase(dir, 65536)
}
