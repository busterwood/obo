module main
import "l1.obx"
type Box = ref record { v: int }
type Bag = ref record { items: []Box; n: int }
fn main() {
    let b = new Bag{items: new []Box(0), n: 0}
    append(b.items, new Box{v: 1})
    let h = handle(b)
    let r = &h.items[0]
    println(l1::mid(fn [r](x: int): int { return x + r.v }, 1))
}
