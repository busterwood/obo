module main
import "html.obx" as html
fn templates() {
    let t = html`<p>${"<x>"}</p>`
    println(html::toText(t))          // expect: <p>&lt;x&gt;</p>
    let nested = html`<div>${html.copy(t)}</div>`
    println(html::toText(nested))     // expect: <div><p>&lt;x&gt;</p></div>
    let q = sql`SELECT * FROM t WHERE id = ${1}`
    println(len(q.text), " ", len(q.params))  // expect: 2 1
}

fn main() {
    templates()
    let h = html::raw("<b>hi</b>")
    println(html::toText(h))     // expect: <b>hi</b>
    let e = html::escapeText("<x>")
    println(html::toText(e))     // expect: &lt;x&gt;
    var parts = new []html::Html(0)
    append(parts, html::raw("<a>"))
    append(parts, html::escapeAttr("\""))
    append(parts, html::raw("</a>"))
    let joined = html::join(parts)
    println(html::toText(joined)) // expect: <a>&quot;</a>
}
