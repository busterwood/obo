module lib
pub type Counter = ref record {
    pub value: int
    step: int
}
pub fn mk(): Counter { return new Counter{value: 0, step: 3} }
pub fn (c: &Counter) peek(): int { return c.value * c.step }
pub fn (mut c: &Counter) bump() { c.value += c.step }
fn (c: &Counter) hidden(): int { return c.step }
pub fn (c: &Counter) viaHidden(): int { return c.hidden() }
