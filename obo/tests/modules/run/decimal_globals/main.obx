module main
import "lib.obx"

// main's initializers run after lib's: they read lib's globals and constants
var mine: decimal = lib::RATE * 2.0
var mine2 = lib::start + 1.0

fn main() {
    println(lib::RATE, " ", lib::NEG, " ", lib::NEG0, " ", -lib::RATE)     // expect: 0.0825 -1.5 0.00 -0.0825
    println(lib::total, " ", lib::base, " ", lib::start)                     // expect: 0 10.25 3.00
    lib::addTotal(2.5)
    lib::addTotal(0.25)
    println(lib::total, " ", lib::hidden())                                  // expect: 2.75 5.25
    println(lib::bumpBase(), " ", lib::base)                                 // expect: 20.500 20.500
    println(mine, " ", mine2)                                                // expect: 0.16500 4.00
    lib::total = 9.0
    lib::total += lib::NEG
    println(lib::total)                                                      // expect: 7.5
}
