// time_civil: floor division/modulo (including negative operands), the
// civil-date table (epoch, pre-1970, year 1, leap 2000, non-leap 2100, month
// and year boundaries, weekday 0 = Sunday), and both ISO formats. Expected
// values were checked against the proleptic Gregorian calendar in UTC.
// expect: time civil ok
import "time.obx" as time
import "support.obx" as t

fn civilEq(label: string, secs: int, y: int, mo: int, d: int,
           h: int, mi: int, s: int, wd: int) {
    let c = time::civil(secs)
    let w = t::ints7(y, mo, d, h, mi, s, wd)
    t::checkOrder(label, c, w)
}

fn main() {
    // floorDiv: truncation adjusted down when the signs differ and the
    // remainder is nonzero
    t::checkInt("floorDiv 7 2", time::floorDiv(7, 2), 3)
    t::checkInt("floorDiv 0 2", time::floorDiv(0, 2), 0)
    t::checkInt("floorDiv -1 2", time::floorDiv(-1, 2), -1)
    t::checkInt("floorDiv -7 2", time::floorDiv(-7, 2), -4)
    t::checkInt("floorDiv 7 -2", time::floorDiv(7, -2), -4)
    t::checkInt("floorDiv -7 -2", time::floorDiv(-7, -2), 3)
    t::checkInt("floorDiv 6 3", time::floorDiv(6, 3), 2)
    t::checkInt("floorDiv -6 3", time::floorDiv(-6, 3), -2)
    t::checkInt("floorDiv 5 5", time::floorDiv(5, 5), 1)
    t::checkInt("floorDiv -5 5", time::floorDiv(-5, 5), -1)
    t::checkInt("floorDiv 1 3", time::floorDiv(1, 3), 0)
    t::checkInt("floorDiv -1 3", time::floorDiv(-1, 3), -1)

    // floorMod = a - floorDiv(a, b) * b; non-negative for positive b
    t::checkInt("floorMod 7 2", time::floorMod(7, 2), 1)
    t::checkInt("floorMod 0 2", time::floorMod(0, 2), 0)
    t::checkInt("floorMod -1 2", time::floorMod(-1, 2), 1)
    t::checkInt("floorMod -7 2", time::floorMod(-7, 2), 1)
    t::checkInt("floorMod 7 -2", time::floorMod(7, -2), -1)
    t::checkInt("floorMod -7 -2", time::floorMod(-7, -2), -1)
    t::checkInt("floorMod 6 3", time::floorMod(6, 3), 0)
    t::checkInt("floorMod -6 3", time::floorMod(-6, 3), 0)
    t::checkInt("floorMod 5 3", time::floorMod(5, 3), 2)
    t::checkInt("floorMod -5 3", time::floorMod(-5, 3), 1)
    t::checkInt("floorMod -1 3", time::floorMod(-1, 3), 2)
    t::checkInt("floorMod 59 60", time::floorMod(59, 60), 59)
    t::checkInt("floorMod -1 60", time::floorMod(-1, 60), 59)

    // epoch and the first day
    civilEq("epoch", 0, 1970, 1, 1, 0, 0, 0, 4)
    civilEq("epoch 59", 59, 1970, 1, 1, 0, 0, 59, 4)
    civilEq("epoch 60", 60, 1970, 1, 1, 0, 1, 0, 4)
    civilEq("day end", 86399, 1970, 1, 1, 23, 59, 59, 4)
    civilEq("day roll", 86400, 1970, 1, 2, 0, 0, 0, 5)
    civilEq("third day", 172800, 1970, 1, 3, 0, 0, 0, 6)

    // pre-1970 uses floor division: -1 is the previous day's last second
    civilEq("minus one", -1, 1969, 12, 31, 23, 59, 59, 3)
    civilEq("minus day", -86400, 1969, 12, 31, 0, 0, 0, 3)
    civilEq("minus day second", -86401, 1969, 12, 30, 23, 59, 59, 2)
    civilEq("1900", -2208988800, 1900, 1, 1, 0, 0, 0, 1)
    civilEq("1899", -2208988801, 1899, 12, 31, 23, 59, 59, 0)
    civilEq("year 1", -62135596800, 1, 1, 1, 0, 0, 0, 1)

    // leap year: 2000-02-29 exists; 2100 is not a leap year
    civilEq("leap day", 951782400, 2000, 2, 29, 0, 0, 0, 2)
    civilEq("leap next", 951868800, 2000, 3, 1, 0, 0, 0, 3)
    civilEq("2100 jan", 4102444800, 2100, 1, 1, 0, 0, 0, 5)
    civilEq("2100 feb", 4105123200, 2100, 2, 1, 0, 0, 0, 1)
    civilEq("2100 feb 28", 4107542399, 2100, 2, 28, 23, 59, 59, 0)
    civilEq("2100 mar", 4107542400, 2100, 3, 1, 0, 0, 0, 1)

    // month and year boundaries around 2009
    civilEq("year end", 1230767999, 2008, 12, 31, 23, 59, 59, 3)
    civilEq("year start", 1230768000, 2009, 1, 1, 0, 0, 0, 4)
    civilEq("2009 mid", 1234567890, 2009, 2, 13, 23, 31, 30, 5)
    civilEq("far future", 253402300799, 9999, 12, 31, 23, 59, 59, 5)

    // long-iso and iso formats, minute precision, UTC
    t::checkStr("long epoch", time::formatLongIso(0), "1970-01-01 00:00")
    t::checkStr("long day end", time::formatLongIso(86399), "1970-01-01 23:59")
    t::checkStr("long minus one", time::formatLongIso(-1), "1969-12-31 23:59")
    t::checkStr("long minus day", time::formatLongIso(-86400), "1969-12-31 00:00")
    t::checkStr("long 1900", time::formatLongIso(-2208988800), "1900-01-01 00:00")
    t::checkStr("long year 1", time::formatLongIso(-62135596800), "0001-01-01 00:00")
    t::checkStr("long leap", time::formatLongIso(951782400), "2000-02-29 00:00")
    t::checkStr("long 2100", time::formatLongIso(4107542400), "2100-03-01 00:00")
    t::checkStr("long 2009", time::formatLongIso(1234567890), "2009-02-13 23:31")
    t::checkStr("long 2008 end", time::formatLongIso(1230767999), "2008-12-31 23:59")
    t::checkStr("long 9999", time::formatLongIso(253402300799), "9999-12-31 23:59")

    t::checkStr("iso epoch", time::formatIso(0), "01-01 00:00")
    t::checkStr("iso minus one", time::formatIso(-1), "12-31 23:59")
    t::checkStr("iso leap", time::formatIso(951782400), "02-29 00:00")
    t::checkStr("iso 2100", time::formatIso(4107542400), "03-01 00:00")
    t::checkStr("iso 2009", time::formatIso(1234567890), "02-13 23:31")

    println("time civil ok")
}
