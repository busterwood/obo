// support.obx: shared assertions and small array builders for tests/stdlib.
//
// This is a module, not a test root. tests/stdlib.py collects only headerless
// files as cases; every root imports this file from its own directory
// (importer-directory-first resolution) and LIBDIR supplies the stdlib modules.
//
// Each check prints one FAIL line with the label and the mismatching values,
// then exits 1. Successful checks print nothing; a root prints its single
// "ok" line at the end and the runner compares stdout against the // expect:
// markers. Values are compared exactly, never approximately.
module support

import "cli.obx" as cli

fn fail(label: string, detail: string) {
    println("FAIL ", label, ": ", detail)
    exit(1)
}

pub fn checkInt(label: string, got: int, want: int) {
    if got != want { fail(label, "got " + string(got) + ", want " + string(want)) }
}

pub fn checkBool(label: string, got: bool, want: bool) {
    if got != want {
        if want { fail(label, "got false, want true") }
        fail(label, "got true, want false")
    }
}

pub fn checkByte(label: string, got: byte, want: byte) {
    if got != want { fail(label, "got " + string(int(got)) + ", want " + string(int(want))) }
}

pub fn checkStr(label: string, got: string, want: string) {
    if got != want { fail(label, "got [" + got + "] want [" + want + "]") }
}

pub fn checkOrder(label: string, got: &[]int, want: &[]int) {
    if len(got) != len(want) {
        fail(label, "length " + string(len(got)) + ", want " + string(len(want)))
    }
    for i in 0..len(got) {
        if got[i] != want[i] {
            fail(label, "at " + string(i) + " got " + string(got[i]) + ", want " + string(want[i]))
        }
    }
}

pub fn checkStrs(label: string, got: &[]string, want: &[]string) {
    if len(got) != len(want) {
        fail(label, "length " + string(len(got)) + ", want " + string(len(want)))
    }
    for i in 0..len(got) {
        if got[i] != want[i] {
            fail(label, "at " + string(i) + " got [" + got[i] + "] want [" + want[i] + "]")
        }
    }
}

// a successful split result must hold exactly want
pub fn checkParts(label: string, r: Result[[]string], want: &[]string) {
    match r {
        ok(v) { checkStrs(label, v, want) }
        err(m, c) { fail(label, "unexpected error [" + m + "] code " + string(c)) }
    }
}

// a split result must be err(message, EINVAL 22)
pub fn checkSplitErr(label: string, r: Result[[]string], message: string) {
    match r {
        ok(v) { fail(label, "expected an error, got " + string(len(v)) + " parts") }
        err(m, c) {
            if m != message { fail(label, "message [" + m + "] want [" + message + "]") }
            checkInt(label, c, 22)
        }
    }
}

