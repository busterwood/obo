// cli_parse: every successful spelling from design 5.6 over an eza-like flag
// set: long required/optional/none, short clusters, attached and split values,
// optional defaults, consume-vs-operand, interspersed operands, "--", a lone
// "-", the empty operand, repeats and the from index. Option.short is the
// matched flag's canonical short form (0 when it has none), including for a
// long spelling; Option.value carries the effective value (the default for a
// bare optional with a non-empty default), and hasValue is true exactly when
// the value is effective.
// expect: cli parse ok
import "cli.obx" as cli
import "support.obx" as t

fn parsed(label: string, r: Result[cli::Parsed]): cli::Parsed {
    match r {
        ok(p) { return p }
        err(m, c) { println("FAIL ", label, ": ", m, " (", c, ")"); exit(1) }
    }
}

fn counts(label: string, p: &cli::Parsed, nopts: int, nops: int) {
    t::checkInt(label + " options", len(p.options), nopts)
    t::checkInt(label + " operands", len(p.operands), nops)
}

fn optAt(label: string, p: &cli::Parsed, i: int, short: byte, long: string,
         value: string, has: bool) {
    t::checkByte(label + " short", p.options[i].short, short)
    t::checkStr(label + " long", p.options[i].long, long)
    t::checkStr(label + " value", p.options[i].value, value)
    t::checkBool(label + " hasValue", p.options[i].hasValue, has)
}

fn oneOpt(label: string, p: &cli::Parsed, short: byte, long: string,
          value: string, has: bool) {
    counts(label, p, 1, 0)
    optAt(label, p, 0, short, long, value, has)
}

fn operandsEq(label: string, p: &cli::Parsed, want: &[]string) {
    t::checkStrs(label + " operand list", p.operands, want)
}

fn main() {
    let sp = t::cliSpecs()
    t::checkInt("spec count", len(sp), 12)

    // no tokens
    let av0 = t::list0()
    let p0 = parsed("empty", cli::parse(av0, 0, sp))
    counts("empty", p0, 0, 0)

    // long and short VALUE_NONE spellings carry the canonical short form
    let av1 = t::list1("-a")
    let p1 = parsed("all short", cli::parse(av1, 0, sp))
    oneOpt("all short", p1, 'a', "all", "", false)
    let av2 = t::list1("--all")
    let p2 = parsed("all long", cli::parse(av2, 0, sp))
    oneOpt("all long", p2, 'a', "all", "", false)
    let av3 = t::list1("--long")
    let p3 = parsed("long long", cli::parse(av3, 0, sp))
    oneOpt("long long", p3, 'l', "long", "", false)
    let av4 = t::list1("-l")
    let p4 = parsed("long short", cli::parse(av4, 0, sp))
    oneOpt("long short", p4, 'l', "long", "", false)

    // required long: =value, separate value, attached short, =value short,
    // separate short value
    let av5 = t::list1("--sort=name")
    let p5 = parsed("sort eq", cli::parse(av5, 0, sp))
    oneOpt("sort eq", p5, 's', "sort", "name", true)
    let av6 = t::list2("--sort", "name")
    let p6 = parsed("sort next", cli::parse(av6, 0, sp))
    oneOpt("sort next", p6, 's', "sort", "name", true)
    let av7 = t::list1("-sname")
    let p7 = parsed("sort attached", cli::parse(av7, 0, sp))
    oneOpt("sort attached", p7, 's', "sort", "name", true)
    let av8 = t::list1("-s=name")
    let p8 = parsed("sort short eq", cli::parse(av8, 0, sp))
    oneOpt("sort short eq", p8, 's', "sort", "name", true)
    let av9 = t::list2("-s", "name")
    let p9 = parsed("sort short next", cli::parse(av9, 0, sp))
    oneOpt("sort short next", p9, 's', "sort", "name", true)
    let av10 = t::list1("--sort=Extension")
    let p10 = parsed("sort Extension", cli::parse(av10, 0, sp))
    oneOpt("sort Extension", p10, 's', "sort", "Extension", true)

    // required with an empty accept list takes any value, including "="
    let av11 = t::list1("-I=foo")
    let p11 = parsed("ignore eq", cli::parse(av11, 0, sp))
    oneOpt("ignore eq", p11, 'I', "ignore-glob", "foo", true)
    let av12 = t::list1("-I=")
    let p12 = parsed("ignore bare eq", cli::parse(av12, 0, sp))
    oneOpt("ignore bare eq", p12, 'I', "ignore-glob", "=", true)
    let av13 = t::list1("--ignore-glob=*.txt")
    let p13 = parsed("ignore long", cli::parse(av13, 0, sp))
    oneOpt("ignore long", p13, 'I', "ignore-glob", "*.txt", true)
    let av14 = t::list2("--ignore-glob", "--")
    let p14 = parsed("ignore dashdash value", cli::parse(av14, 0, sp))
    oneOpt("ignore dashdash value", p14, 'I', "ignore-glob", "--", true)

    // optional: bare uses the default, split takes the value, a consumed next
    // token is a value, an unconsumed next token stays an operand
    let av15 = t::list1("-F")
    let p15 = parsed("classify bare", cli::parse(av15, 0, sp))
    oneOpt("classify bare", p15, 'F', "classify", "auto", true)
    let av16 = t::list1("--classify")
    let p16 = parsed("classify long", cli::parse(av16, 0, sp))
    oneOpt("classify long", p16, 'F', "classify", "auto", true)
    let av17 = t::list1("-F=always")
    let p17 = parsed("classify eq", cli::parse(av17, 0, sp))
    oneOpt("classify eq", p17, 'F', "classify", "always", true)
    let av18 = t::list1("-F=automatic")
    let p18 = parsed("classify eq automatic", cli::parse(av18, 0, sp))
    oneOpt("classify eq automatic", p18, 'F', "classify", "automatic", true)
    let av19 = t::list1("-Falways")
    let p19 = parsed("classify attached", cli::parse(av19, 0, sp))
    oneOpt("classify attached", p19, 'F', "classify", "always", true)
    let av20 = t::list2("-F", "always")
    let p20 = parsed("classify next", cli::parse(av20, 0, sp))
    oneOpt("classify next", p20, 'F', "classify", "always", true)
    let av21 = t::list2("-F", "automatic")
    let p21 = parsed("classify operand", cli::parse(av21, 0, sp))
    counts("classify operand", p21, 1, 1)
    optAt("classify operand", p21, 0, 'F', "classify", "auto", true)
    let w1 = t::list1("automatic")
    operandsEq("classify operand", p21, w1)
    let av22 = t::list1("--classify=automatic")
    let p22 = parsed("classify automatic", cli::parse(av22, 0, sp))
    oneOpt("classify automatic", p22, 'F', "classify", "automatic", true)
    let av23 = t::list2("--classify", "automatic")
    let p23 = parsed("classify long operand", cli::parse(av23, 0, sp))
    counts("classify long operand", p23, 1, 1)
    optAt("classify long operand", p23, 0, 'F', "classify", "auto", true)
    operandsEq("classify long operand", p23, w1)
    // consume contains always/auto/never (not automatic): a separate token in
    // consume is taken as the value; an attached rest is taken when in consume
    let av23b = t::list2("-F", "auto")
    let p23b = parsed("classify auto next", cli::parse(av23b, 0, sp))
    oneOpt("classify auto next", p23b, 'F', "classify", "auto", true)
    let av23c = t::list2("-F", "never")
    let p23c = parsed("classify never next", cli::parse(av23c, 0, sp))
    oneOpt("classify never next", p23c, 'F', "classify", "never", true)
    let av23d = t::list1("-F=never")
    let p23d = parsed("classify never eq", cli::parse(av23d, 0, sp))
    oneOpt("classify never eq", p23d, 'F', "classify", "never", true)
    let av23e = t::list1("-F=auto")
    let p23e = parsed("classify auto eq", cli::parse(av23e, 0, sp))
    oneOpt("classify auto eq", p23e, 'F', "classify", "auto", true)
    let av23f = t::list1("-Fauto")
    let p23f = parsed("classify auto attached", cli::parse(av23f, 0, sp))
    oneOpt("classify auto attached", p23f, 'F', "classify", "auto", true)
    let av23g = t::list2("--classify", "auto")
    let p23g = parsed("classify long auto", cli::parse(av23g, 0, sp))
    oneOpt("classify long auto", p23g, 'F', "classify", "auto", true)
    let av23h = t::list2("--classify", "never")
    let p23h = parsed("classify long never", cli::parse(av23h, 0, sp))
    oneOpt("classify long never", p23h, 'F', "classify", "never", true)
    let av23i = t::list1("--classify=always")
    let p23i = parsed("classify long eq always", cli::parse(av23i, 0, sp))
    oneOpt("classify long eq always", p23i, 'F', "classify", "always", true)
    let av23j = t::list2("--classify", "always")
    let p23j = parsed("classify long next always", cli::parse(av23j, 0, sp))
    oneOpt("classify long next always", p23j, 'F', "classify", "always", true)

    // long-only optional flags report short 0
    let av24 = t::list1("--color")
    let p24 = parsed("color bare", cli::parse(av24, 0, sp))
    oneOpt("color bare", p24, byte(0), "color", "auto", true)
    let av25 = t::list1("--color=always")
    let p25 = parsed("color eq", cli::parse(av25, 0, sp))
    oneOpt("color eq", p25, byte(0), "color", "always", true)
    let av26 = t::list1("--icons")
    let p26 = parsed("icons bare", cli::parse(av26, 0, sp))
    oneOpt("icons bare", p26, byte(0), "icons", "auto", true)
    let av27 = t::list2("--icons", "automatic")
    let p27 = parsed("icons operand", cli::parse(av27, 0, sp))
    counts("icons operand", p27, 1, 1)
    optAt("icons operand", p27, 0, byte(0), "icons", "auto", true)
    let w2 = t::list1("automatic")
    operandsEq("icons operand", p27, w2)
    let av27b = t::list1("--color=auto")
    let p27b = parsed("color auto", cli::parse(av27b, 0, sp))
    oneOpt("color auto", p27b, byte(0), "color", "auto", true)
    let av27c = t::list1("--color=automatic")
    let p27c = parsed("color automatic", cli::parse(av27c, 0, sp))
    oneOpt("color automatic", p27c, byte(0), "color", "automatic", true)
    let av27d = t::list1("--color=never")
    let p27d = parsed("color never", cli::parse(av27d, 0, sp))
    oneOpt("color never", p27d, byte(0), "color", "never", true)
    let av27e = t::list2("--color", "never")
    let p27e = parsed("color never next", cli::parse(av27e, 0, sp))
    oneOpt("color never next", p27e, byte(0), "color", "never", true)
    let av27f = t::list2("--color", "automatic")
    let p27f = parsed("color automatic operand", cli::parse(av27f, 0, sp))
    counts("color automatic operand", p27f, 1, 1)
    optAt("color automatic operand", p27f, 0, byte(0), "color", "auto", true)
    operandsEq("color automatic operand", p27f, w2)
    let av27g = t::list1("--icons=auto")
    let p27g = parsed("icons auto", cli::parse(av27g, 0, sp))
    oneOpt("icons auto", p27g, byte(0), "icons", "auto", true)
    let av27h = t::list1("--icons=automatic")
    let p27h = parsed("icons automatic eq", cli::parse(av27h, 0, sp))
    oneOpt("icons automatic eq", p27h, byte(0), "icons", "automatic", true)
    let av27i = t::list1("--icons=never")
    let p27i = parsed("icons never", cli::parse(av27i, 0, sp))
    oneOpt("icons never", p27i, byte(0), "icons", "never", true)
    let av27j = t::list2("--icons", "never")
    let p27j = parsed("icons never next", cli::parse(av27j, 0, sp))
    oneOpt("icons never next", p27j, byte(0), "icons", "never", true)

    // optional with an empty default: value is empty and hasValue is false
    let av28 = t::list1("--level")
    let p28 = parsed("level bare", cli::parse(av28, 0, sp))
    oneOpt("level bare", p28, byte(0), "level", "", false)
    let av29 = t::list1("--level=3")
    let p29 = parsed("level eq", cli::parse(av29, 0, sp))
    oneOpt("level eq", p29, byte(0), "level", "3", true)
    let av30 = t::list2("--level", "3")
    let p30 = parsed("level next", cli::parse(av30, 0, sp))
    counts("level next", p30, 1, 1)
    optAt("level next", p30, 0, byte(0), "level", "", false)
    let w3 = t::list1("3")
    operandsEq("level next", p30, w3)

    // long-only required flag
    let av31 = t::list2("--output", "x")
    let p31 = parsed("output", cli::parse(av31, 0, sp))
    oneOpt("output", p31, 'o', "output", "x", true)
    let av31b = t::list2("-o", "x")
    let p31b = parsed("output short", cli::parse(av31b, 0, sp))
    oneOpt("output short", p31b, 'o', "output", "x", true)

    // short clusters
    let av32 = t::list1("-al")
    let p32 = parsed("cluster al", cli::parse(av32, 0, sp))
    counts("cluster al", p32, 2, 0)
    optAt("cluster al", p32, 0, 'a', "all", "", false)
    optAt("cluster al", p32, 1, 'l', "long", "", false)
    let av33 = t::list1("-la")
    let p33 = parsed("cluster la", cli::parse(av33, 0, sp))
    counts("cluster la", p33, 2, 0)
    optAt("cluster la", p33, 0, 'l', "long", "", false)
    optAt("cluster la", p33, 1, 'a', "all", "", false)
    let av34 = t::list1("-lF")
    let p34 = parsed("cluster lF", cli::parse(av34, 0, sp))
    counts("cluster lF", p34, 2, 0)
    optAt("cluster lF", p34, 0, 'l', "long", "", false)
    optAt("cluster lF", p34, 1, 'F', "classify", "auto", true)
    let av35 = t::list1("-lFalways")
    let p35 = parsed("cluster lFalways", cli::parse(av35, 0, sp))
    counts("cluster lFalways", p35, 2, 0)
    optAt("cluster lFalways", p35, 0, 'l', "long", "", false)
    optAt("cluster lFalways", p35, 1, 'F', "classify", "always", true)
    let av36 = t::list1("-lF=always")
    let p36 = parsed("cluster lF eq", cli::parse(av36, 0, sp))
    counts("cluster lF eq", p36, 2, 0)
    optAt("cluster lF eq", p36, 0, 'l', "long", "", false)
    optAt("cluster lF eq", p36, 1, 'F', "classify", "always", true)
    let av37 = t::list1("-aa")
    let p37 = parsed("cluster aa", cli::parse(av37, 0, sp))
    counts("cluster aa", p37, 2, 0)
    optAt("cluster aa", p37, 0, 'a', "all", "", false)
    optAt("cluster aa", p37, 1, 'a', "all", "", false)
    let av38 = t::list1("-Aaa")
    let p38 = parsed("cluster Aaa", cli::parse(av38, 0, sp))
    counts("cluster Aaa", p38, 3, 0)
    optAt("cluster Aaa", p38, 0, 'A', "almost-all", "", false)
    optAt("cluster Aaa", p38, 1, 'a', "all", "", false)
    optAt("cluster Aaa", p38, 2, 'a', "all", "", false)

    // "--" stops option parsing; a second "--" and "-a" become operands
    let av39 = t::list1("--")
    let p39 = parsed("terminator", cli::parse(av39, 0, sp))
    counts("terminator", p39, 0, 0)
    let av40 = t::list3("--", "-a", "--")
    let p40 = parsed("terminator operands", cli::parse(av40, 0, sp))
    counts("terminator operands", p40, 0, 2)
    let w4 = t::list2("-a", "--")
    operandsEq("terminator operands", p40, w4)
    let av41 = t::list4("d", "--", "-l", "e")
    let p41 = parsed("terminator mixed", cli::parse(av41, 0, sp))
    counts("terminator mixed", p41, 0, 3)
    let w5 = t::list3("d", "-l", "e")
    operandsEq("terminator mixed", p41, w5)

    // a lone "-" and "" are operands
    let av42 = t::list1("-")
    let p42 = parsed("lone dash", cli::parse(av42, 0, sp))
    counts("lone dash", p42, 0, 1)
    let w6 = t::list1("-")
    operandsEq("lone dash", p42, w6)
    let av43 = t::list1("")
    let p43 = parsed("empty token", cli::parse(av43, 0, sp))
    counts("empty token", p43, 0, 1)
    let w7 = t::list1("")
    operandsEq("empty token", p43, w7)
    let av44 = t::list1("d")
    let p44 = parsed("operand", cli::parse(av44, 0, sp))
    counts("operand", p44, 0, 1)
    let w8 = t::list1("d")
    operandsEq("operand", p44, w8)

    // options are interspersed with operands in either order
    let av45 = t::list2("d", "-a")
    let p45 = parsed("operand then option", cli::parse(av45, 0, sp))
    counts("operand then option", p45, 1, 1)
    optAt("operand then option", p45, 0, 'a', "all", "", false)
    let w9 = t::list1("d")
    operandsEq("operand then option", p45, w9)
    let av46 = t::list2("-a", "d")
    let p46 = parsed("option then operand", cli::parse(av46, 0, sp))
    counts("option then operand", p46, 1, 1)
    optAt("option then operand", p46, 0, 'a', "all", "", false)
    operandsEq("option then operand", p46, w9)
    let av47 = t::list3("d", "--sort=name", "e")
    let p47 = parsed("interspersed", cli::parse(av47, 0, sp))
    counts("interspersed", p47, 1, 2)
    optAt("interspersed", p47, 0, 's', "sort", "name", true)
    let w10 = t::list2("d", "e")
    operandsEq("interspersed", p47, w10)
    let av48 = t::list3("-a", "d", "-l")
    let p48 = parsed("both sides", cli::parse(av48, 0, sp))
    counts("both sides", p48, 2, 1)
    optAt("both sides", p48, 0, 'a', "all", "", false)
    optAt("both sides", p48, 1, 'l', "long", "", false)
    operandsEq("both sides", p48, w9)

    // repeats append one option per occurrence, in order
    let av49 = t::list2("-a", "-a")
    let p49 = parsed("repeat short", cli::parse(av49, 0, sp))
    counts("repeat short", p49, 2, 0)
    optAt("repeat short", p49, 0, 'a', "all", "", false)
    optAt("repeat short", p49, 1, 'a', "all", "", false)
    let av50 = t::list2("--sort=name", "--sort=size")
    let p50 = parsed("repeat sort", cli::parse(av50, 0, sp))
    counts("repeat sort", p50, 2, 0)
    optAt("repeat sort", p50, 0, 's', "sort", "name", true)
    optAt("repeat sort", p50, 1, 's', "sort", "size", true)
    let av51 = t::list2("-a", "--all")
    let p51 = parsed("repeat mixed spelling", cli::parse(av51, 0, sp))
    counts("repeat mixed spelling", p51, 2, 0)
    optAt("repeat mixed spelling", p51, 0, 'a', "all", "", false)
    optAt("repeat mixed spelling", p51, 1, 'a', "all", "", false)

    // from: 0 <= from <= len; from=len is no tokens; from=1 skips argv[0]
    let av52 = t::list3("prog", "-a", "d")
    let p52 = parsed("from 0", cli::parse(av52, 0, sp))
    counts("from 0", p52, 1, 2)
    let w11 = t::list2("prog", "d")
    operandsEq("from 0", p52, w11)
    let p53 = parsed("from 1", cli::parse(av52, 1, sp))
    counts("from 1", p53, 1, 1)
    optAt("from 1", p53, 0, 'a', "all", "", false)
    let w12 = t::list1("d")
    operandsEq("from 1", p53, w12)
    let p54 = parsed("from 2", cli::parse(av52, 2, sp))
    counts("from 2", p54, 0, 1)
    operandsEq("from 2", p54, w12)
    let p55 = parsed("from len", cli::parse(av52, 3, sp))
    counts("from len", p55, 0, 0)

    println("cli parse ok")
}
