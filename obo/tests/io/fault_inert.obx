// fault_inert: OBO_IO_FAULT=short without OBO_CHECK=1 is inert. One writeFd of
// ten bytes returns 10, not 3; the driver checks the exact output.
// expect: xxxxxxxxxx wrote 10
fn main() {
    var data = new []byte(10)
    for i in 0..10 { data[i] = 'x' }
    let w = writeFd(stdout(), data)
    match w {
        ok(n) { println(" wrote ", n) }
        err(m, c) { println("write: ", m, " (", c, ")"); exit(1) }
    }
}
