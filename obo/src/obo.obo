module obo

// obo: the ownership language, compiler written in obo (see FORK.md).
//
// Part 1: the scanner and the x86-64 encoder, with two test modes that are
// compared against the Python compiler (tests/selfhost_test.py):
//
//     obxc --tokens FILE     one line per token, as obx.py --tokens prints them
//     obxc --encode FILE     runs a script of encoder calls, one hex line each

// ============================================================== utilities

fn hexDigit(v: int): byte {
    if v < 10 { return byte('0' + v) }
    return byte('a' + v - 10)
}

fn hexOf(b: &[]byte, from: int, to: int): string {
    let out = new []byte(0)
    for i in from..to {
        append(out, hexDigit(b[i] >> 4))
        append(out, hexDigit(b[i] & 15))
    }
    return string(out)
}

fn bytesOf(s: string): []byte {
    let out = new []byte(0)
    for i in 0..len(s) { append(out, s[i]) }
    return out
}

// ================================================================ scanner

// token kinds
const T_EOF = 0
const T_IDENT = 1
const T_INT = 2
const T_CHAR = 3
const T_STRING = 4
const T_MODULE = 5
const T_IMPORT = 6
const T_PUB = 7
const T_TYPE = 8
const T_VAR = 9
const T_LET = 10
const T_CONST = 11
const T_FN = 12
const T_RETURN = 13
const T_IF = 14
const T_ELSE = 15
const T_WHILE = 16
const T_FOR = 17
const T_IN = 18
const T_BREAK = 19
const T_CONTINUE = 20
const T_DEFER = 21
const T_MATCH = 22
const T_REF = 23
const T_RECORD = 24
const T_CLOSED = 25
const T_NEW = 26
const T_NIL = 27
const T_TRUE = 28
const T_FALSE = 29
const T_LPAREN = 30
const T_RPAREN = 31
const T_LBRACE = 32
const T_RBRACE = 33
const T_LBRACK = 34
const T_RBRACK = 35
const T_COMMA = 36
const T_SEMI = 37
const T_COLON = 38
const T_DOT = 39
const T_DOTDOT = 40
const T_ASSIGN = 41
const T_EQ = 42
const T_NE = 43
const T_LT = 44
const T_LE = 45
const T_GT = 46
const T_GE = 47
const T_PLUS = 48
const T_MINUS = 49
const T_STAR = 50
const T_SLASH = 51
const T_PERCENT = 52
const T_NOT = 53
const T_QUESTION = 54
const T_AMP = 55
const T_BAR = 56
const T_CARET = 57
const T_TILDE = 58
const T_ANDAND = 59
const T_OROR = 60
const T_PLUSEQ = 61
const T_MINUSEQ = 62
const T_STAREQ = 63
const T_SHL = 64
const T_SHR = 65

fn makeTokNames(): []string {
    let k = new []string(0)
    let names = "eof ident int char string module import pub type var let const fn return if else while for in break continue defer match ref record closed new nil true false ( ) { } [ ] , ; : . .. = == != < <= > >= + - * / % ! ? & | ^ ~ && || += -= *= << >>"
    var start = 0
    for i in 0..len(names) + 1 {
        if i == len(names) || names[i] == ' ' {
            append(k, substr(names, start, i))
            start = i + 1
        }
    }
    return k
}

let tokNames = makeTokNames()

fn tokName(k: int): string { return tokNames[k] }


var src = ""                  // the source text, read by index
var pos = 0
var line = 1
var col = 1
var last = -1             // kind of the previous token
var sym = -1              // kind of the current token: "ident", "int", "==", "fn", ...
var sval = ""             // identifier text or string literal bytes
var ival = 0              // integer or character value
var tline = 0             // where the current token starts
var tcol = 0
var dumpMode = false

fn makeKeywords(): []string {
    let k = new []string(0)
    let words = "module import pub type var let const fn return if else while for in break continue defer match ref record closed new nil true false"
    var start = 0
    for i in 0..len(words) + 1 {
        if i == len(words) || words[i] == ' ' {
            append(k, substr(words, start, i))
            start = i + 1
        }
    }
    return k
}

let keywords = makeKeywords()


// the token number of a keyword, or T_IDENT for any other word
fn keywordTok(w: string): int {
    for i in 0..len(keywords) {
        if keywords[i] == w { return T_MODULE + i }
    }
    return T_IDENT
}

var srcPath = ""

// reports an error at line l, column c (0 means the current token) and stops
fn errorAt(msg: string, l: int, c: int) {
    var ln = l
    var cn = c
    if ln == 0 { ln = tline }
    if cn == 0 { cn = tcol }
    if dumpMode {
        println(ln, ":", cn, " error ", msg)
    } else {
        eprintln(srcPath, ":", ln, ":", cn, ": ", msg)
    }
    exit(1)
}

fn fail(msg: string) { errorAt(msg, 0, 0) }

fn isLetter(c: int): bool { return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_' }
fn isDigit(c: int): bool { return c >= '0' && c <= '9' }
fn isHex(c: int): bool { return isDigit(c) || c >= 'a' && c <= 'f' || c >= 'A' && c <= 'F' }

fn hexVal(c: int): int {
    if isDigit(c) { return c - '0' }
    if c >= 'a' { return c - 'a' + 10 }
    return c - 'A' + 10
}

// the byte k places ahead, or -1 past the end
fn peek(k: int): int {
    if pos + k < len(src) { return src[pos + k] }
    return -1
}

fn advance() {
    if src[pos] == '\n' {
        line += 1
        col = 1
    } else {
        col += 1
    }
    pos += 1
}

// a newline after one of these ends the statement
// a newline after one of these ends the statement
fn semiAfter(k: int): bool {
    match k {
        T_IDENT, T_INT, T_CHAR, T_STRING, T_TRUE, T_FALSE, T_NIL, T_RETURN, T_BREAK, T_CONTINUE,
        T_RPAREN, T_RBRACK, T_RBRACE { return true }
        else { return false }
    }
}

fn setTok(k: int) {
    sym = k
    last = k
}

fn escape(c: int): int {
    match c {
        'n' { return '\n' }
        't' { return '\t' }
        'r' { return '\r' }
        '\\', '"', '\'' { return c }
        '0' { return 0 }
        else { return -1 }
    }
}

// two-character operators, or -1
fn punct2(a: int, b: int): int {
    if b == '=' {
        match a {
            '=' { return T_EQ }
            '!' { return T_NE }
            '<' { return T_LE }
            '>' { return T_GE }
            '+' { return T_PLUSEQ }
            '-' { return T_MINUSEQ }
            '*' { return T_STAREQ }
        }
    }
    if a == b {
        match a {
            '.' { return T_DOTDOT }
            '&' { return T_ANDAND }
            '|' { return T_OROR }
            '<' { return T_SHL }
            '>' { return T_SHR }
        }
    }
    return -1
}

// one-character operators and punctuation, or -1
fn punct1(c: int): int {
    match c {
        '(' { return T_LPAREN }
        ')' { return T_RPAREN }
        '{' { return T_LBRACE }
        '}' { return T_RBRACE }
        '[' { return T_LBRACK }
        ']' { return T_RBRACK }
        ',' { return T_COMMA }
        ';' { return T_SEMI }
        ':' { return T_COLON }
        '.' { return T_DOT }
        '=' { return T_ASSIGN }
        '<' { return T_LT }
        '>' { return T_GT }
        '+' { return T_PLUS }
        '-' { return T_MINUS }
        '*' { return T_STAR }
        '/' { return T_SLASH }
        '%' { return T_PERCENT }
        '!' { return T_NOT }
        '?' { return T_QUESTION }
        '&' { return T_AMP }
        '|' { return T_BAR }
        '^' { return T_CARET }
        '~' { return T_TILDE }
        else { return -1 }
    }
}

fn scanNumber() {
    var v = 0
    if src[pos] == '0' && (peek(1) == 'x' || peek(1) == 'X') {
        advance()
        advance()
        var any = false
        var significant = 0
        while pos < len(src) && (isHex(src[pos]) || src[pos] == '_') {
            let d = src[pos]
            if d != '_' {
                any = true
                if significant > 0 || d != '0' { significant += 1 }
                v = (v << 4) | hexVal(d)
            }
            advance()
        }
        if !any { fail("hex literal needs digits") }
        if significant > 16 { fail("integer literal too large") }
    } else {
        var big = false
        while pos < len(src) && (isDigit(src[pos]) || src[pos] == '_') {
            let d = src[pos]
            if d != '_' {
                let dv = d - '0'
                if v > (9223372036854775807 - dv) / 10 {
                    big = true
                } else {
                    v = v * 10 + dv
                }
            }
            advance()
        }
        if big { fail("integer literal too large") }
    }
    ival = v
    setTok(T_INT)
}

fn scanChar() {
    advance()
    if pos >= len(src) || src[pos] == '\'' || src[pos] == '\n' { fail("empty character literal") }
    var ch = int(src[pos])
    if ch == '\\' {
        advance()
        if pos >= len(src) { fail("unknown escape in character literal") }
        ch = escape(src[pos])
        if ch < 0 { fail("unknown escape in character literal") }
    } else if ch >= 128 {
        fail("character literal must be a single byte")
    }
    advance()
    if pos >= len(src) || src[pos] != '\'' { fail("unterminated character literal") }
    advance()
    ival = ch
    setTok(T_CHAR)
}

fn scanString() {
    advance()
    let buf = new []byte(0)
    while true {
        if pos >= len(src) || src[pos] == '\n' { fail("unterminated string") }
        let ch = src[pos]
        if ch == '"' {
            advance()
            break
        }
        if ch == '\\' {
            advance()
            if pos >= len(src) || src[pos] == '\n' { fail("unterminated string") }
            let e = escape(src[pos])
            if e < 0 {
                append(buf, src[pos])
            } else {
                append(buf, byte(e))
            }
        } else {
            append(buf, ch)
        }
        advance()
    }
    sval = string(buf)
    setTok(T_STRING)
}

fn upper(s: string): string {
    let b = new []byte(0)
    for i in 0..len(s) {
        let c = s[i]
        if c >= 'a' && c <= 'z' {
            append(b, byte(c - 'a' + 'A'))
        } else {
            append(b, c)
        }
    }
    return string(b)
}

fn next() {
    while true {
        while pos < len(src) {
            let c = src[pos]
            if c != ' ' && c != '\t' && c != '\r' && c != '\n' { break }
            if c == '\n' && semiAfter(last) {
                tline = line
                tcol = col
                advance()
                setTok(T_SEMI)
                return
            }
            advance()
        }
        if peek(0) == '/' && peek(1) == '/' {
            while pos < len(src) && src[pos] != '\n' { advance() }
            continue
        }
        break
    }
    tline = line
    tcol = col
    if pos >= len(src) {
        if semiAfter(last) {
            setTok(T_SEMI)
        } else {
            setTok(T_EOF)
        }
        return
    }
    let c = src[pos]
    if isLetter(c) {
        let start = pos
        while pos < len(src) && (isLetter(src[pos]) || isDigit(src[pos])) { advance() }
        sval = substr(src, start, pos)
        setTok(keywordTok(sval))
    } else if isDigit(c) {
        scanNumber()
    } else if c == '\'' {
        scanChar()
    } else if c == '"' {
        scanString()
    } else {
        let p = punct2(c, peek(1))
        let p1 = punct1(c)
        if p >= 0 {
            advance()
            advance()
            setTok(p)
        } else if p1 >= 0 {
            advance()
            setTok(p1)
        } else if c >= 33 && c <= 126 {
            fail("unexpected character '" + substr(src, pos, pos + 1) + "'")
        } else {
            let b = new []byte(0)
            append(b, hexDigit(c >> 4))
            append(b, hexDigit(c & 15))
            fail("unexpected character 0x" + upper(string(b)))
        }
    }
}

fn startScanner(source: []byte) {
    src = string(source)
    pos = 0
    line = 1
    col = 1
    last = -1
    next()
}

fn dumpTokens(source: []byte) {
    dumpMode = true
    startScanner(source)
    while true {
        print(tline, ":", tcol, " ", tokName(sym))
        if sym == T_IDENT {
            print(" ", sval)
        } else if sym == T_INT || sym == T_CHAR {
            print(" ", ival)
        } else if sym == T_STRING {
            let b = bytesOf(sval)
            print(" ", len(b), ":", hexOf(b, 0, len(b)))
        }
        println()
        if sym == T_EOF { return }
        next()
    }
}

// ================================================================ encoder

// A memory operand: [base + index*scale + disp]; base -1 means an absolute
// address in disp, index -1 means no index.
type Mem = ref record { base, index, disp, scale: int }

var code = new []byte(0)

fn emit(b: int) { append(code, byte(b)) }

fn emit32(v: int) {
    emit(v)
    emit(v >> 8)
    emit(v >> 16)
    emit(v >> 24)
}

fn emit64(v: int) {
    emit32(v)
    emit32(v >> 32)
}

fn fits8(v: int): bool { return v >= -128 && v < 128 }
fn fits32(v: int): bool { return v >= -2147483648 && v < 2147483648 }

fn pc(): int { return len(code) }

fn emitOpcode(opc: int) {
    if opc > 255 { emit(opc >> 8) }
    emit(opc & 255)
}

fn rex(w: bool, reg: int, x: int, b: int, force: bool) {
    var r = 0x40
    if w { r = r | 8 }
    r = r | ((reg >> 3) & 1) << 2 | ((x >> 3) & 1) << 1 | ((b >> 3) & 1)
    if r != 0x40 || force { emit(r) }
}

// opcode with a register as the r/m operand
fn opReg(opc: int, reg: int, rm: int, w: bool, byteReg: bool) {
    rex(w, reg, 0, rm, byteReg && (rm >= 4 && rm <= 7 || opc == 0x88 && reg >= 4 && reg <= 7))
    emitOpcode(opc)
    emit(0xC0 | (reg & 7) << 3 | (rm & 7))
}

// opcode with a memory r/m operand
fn opMem(opc: int, reg: int, m: Mem, w: bool, byteReg: bool) {
    var x = 0
    var b = 0
    if m.index >= 0 { x = m.index }
    if m.base >= 0 { b = m.base }
    rex(w, reg, x, b, byteReg && opc == 0x88 && reg >= 4 && reg <= 7)
    emitOpcode(opc)
    if m.base < 0 && m.index < 0 {
        emit(0x04 | (reg & 7) << 3)
        emit(0x25)
        emit32(m.disp)
        return
    }
    var mod = 2
    if m.disp == 0 && (m.base & 7) != 5 {
        mod = 0
    } else if fits8(m.disp) {
        mod = 1
    }
    if m.index >= 0 {
        var ss = 3
        if m.scale == 1 { ss = 0 } else if m.scale == 2 { ss = 1 } else if m.scale == 4 { ss = 2 }
        emit(mod << 6 | (reg & 7) << 3 | 4)
        emit(ss << 6 | (m.index & 7) << 3 | (m.base & 7))
    } else if (m.base & 7) == 4 {
        emit(mod << 6 | (reg & 7) << 3 | 4)
        emit(0x24)
    } else {
        emit(mod << 6 | (reg & 7) << 3 | (m.base & 7))
    }
    if mod == 1 {
        emit(m.disp)
    } else if mod == 2 {
        emit32(m.disp)
    }
}

fn movRI(r: int, v: int) {
    if v >= 0 && v < 0x100000000 {
        if r >= 8 { emit(0x41) }
        emit(0xB8 + (r & 7))
        emit32(v)
    } else if fits32(v) {
        opReg(0xC7, 0, r, true, false)
        emit32(v)
    } else {
        emit(0x48 | (r >> 3))
        emit(0xB8 + (r & 7))
        emit64(v)
    }
}

fn aluRI(o: int, r: int, v: int) {
    if fits8(v) {
        opReg(0x83, o, r, true, false)
        emit(v)
    } else {
        opReg(0x81, o, r, true, false)
        emit32(v)
    }
}

fn aluMI(o: int, m: Mem, v: int) {
    if fits8(v) {
        opMem(0x83, o, m, true, false)
        emit(v)
    } else {
        opMem(0x81, o, m, true, false)
        emit32(v)
    }
}

fn push(r: int) {
    if r >= 8 { emit(0x41) }
    emit(0x50 + (r & 7))
}

fn pop(r: int) {
    if r >= 8 { emit(0x41) }
    emit(0x58 + (r & 7))
}

// push imm8 or imm32, sign-extended to 64 bits
fn pushI(v: int) {
    if fits8(v) {
        emit(0x6A)
        emit(v)
    } else {
        emit(0x68)
        emit32(v)
    }
}

// jumps leave a zero rel32 and return its position for fix()
fn jcc(cc: int): int {
    emit(0x0F)
    emit(0x80 + cc)
    emit32(0)
    return pc() - 4
}

fn jmp(): int {
    emit(0xE9)
    emit32(0)
    return pc() - 4
}

// A jump's rel32 field holds its displacement once the target is known, and until then
// the position of the next jump waiting for the same target (waitJump): 0 after the last.
fn putRel(at: int, v: int) {
    code[at] = byte(v)
    code[at + 1] = byte(v >> 8)
    code[at + 2] = byte(v >> 16)
    code[at + 3] = byte(v >> 24)
}

fn getRel(at: int): int {
    return int(code[at]) | (int(code[at + 1]) << 8) | (int(code[at + 2]) << 16) | (int(code[at + 3]) << 24)
}

fn fix(at: int, target: int) { putRel(at, target - (at + 4)) }

fn callLocal(target: int) {
    emit(0xE8)
    emit32(target - (pc() + 4))
}

// ========================================================== encoder tests

// splits a line into space-separated words
fn words(s: string): []string {
    let out = new []string(0)
    var start = -1
    for i in 0..len(s) + 1 {
        let space = i == len(s) || s[i] == ' '
        if space && start >= 0 {
            append(out, substr(s, start, i))
            start = -1
        } else if !space && start < 0 {
            start = i
        }
    }
    return out
}

// decimal with an optional sign, or hex with a 0x prefix
fn parseInt(s: string): int {
    var i = 0
    var neg = false
    if s[0] == '-' {
        neg = true
        i = 1
    }
    var v = 0
    if len(s) > i + 1 && s[i] == '0' && s[i + 1] == 'x' {
        for k in i + 2..len(s) { v = (v << 4) | hexVal(s[k]) }
    } else {
        for k in i..len(s) { v = v * 10 + (s[k] - '0') }
    }
    if neg { return -v }
    return v
}

// "r:N" or "m:BASE,INDEX,DISP,SCALE"
fn parseMem(spec: string): ?Mem {
    if spec[0] == 'r' { return nil }
    let parts = new []int(0)
    var start = 2
    for i in 2..len(spec) + 1 {
        if i == len(spec) || spec[i] == ',' {
            append(parts, parseInt(substr(spec, start, i)))
            start = i + 1
        }
    }
    return new Mem{base: parts[0], index: parts[1], disp: parts[2], scale: parts[3]}
}

fn regOf(spec: string): int { return parseInt(substr(spec, 2, len(spec))) }

fn emitHex(h: string) {
    if h == "-" { return }
    var i = 0
    while i < len(h) {
        emit(hexVal(h[i]) << 4 | hexVal(h[i + 1]))
        i += 2
    }
}

// op OPC REG RM W BYTE IMM | movri R V | aluri O RM V | push R | pushi V | pop R
// | jcc CC T | jmp T | call T
fn runEncoderLine(l: string) {
    let w = words(l)
    let k = w[0]
    if k == "op" {
        let opc = parseInt(w[1])
        let reg = parseInt(w[2])
        let m = parseMem(w[3])
        let wide = w[4] == "1"
        let byteReg = w[5] == "1"
        if m != nil {
            opMem(opc, reg, m, wide, byteReg)
        } else {
            drop(m)
            opReg(opc, reg, regOf(w[3]), wide, byteReg)
        }
        emitHex(w[6])
    } else if k == "movri" {
        movRI(parseInt(w[1]), parseInt(w[2]))
    } else if k == "aluri" {
        let m = parseMem(w[2])
        if m != nil {
            aluMI(parseInt(w[1]), m, parseInt(w[3]))
        } else {
            drop(m)
            aluRI(parseInt(w[1]), regOf(w[2]), parseInt(w[3]))
        }
    } else if k == "push" {
        push(parseInt(w[1]))
    } else if k == "pushi" {
        pushI(parseInt(w[1]))
    } else if k == "pop" {
        pop(parseInt(w[1]))
    } else if k == "jcc" {
        fix(jcc(parseInt(w[1])), parseInt(w[2]))
    } else if k == "jmp" {
        fix(jmp(), parseInt(w[1]))
    } else if k == "call" {
        callLocal(parseInt(w[1]))
    } else {
        eprintln("unknown encoder command: ", k)
        exit(2)
    }
}

fn runEncoderScript(script: []byte) {
    var start = 0
    for i in 0..len(script) {
        if script[i] == '\n' {
            let before = pc()
            let l = new []byte(0)
            for k in start..i { append(l, script[k]) }
            runEncoderLine(string(l))
            println(hexOf(code, before, pc()))
            start = i + 1
        }
    }
}

// ================================================================== types

type Type
type Sym
type RefBind
type PState

type Field = ref record {
    name: string
    offset: int
    typ: ^Type
}

type Type = ref record {
    kind: string              // int byte bool string void nil record closed array opt
    name: string
    base: ?^Type               // element type (array) or underlying type (opt)
    fields: []Field           // record, in declaration order
    parent: ?^Type             // record: the closed type it is a variant of
    variants: []^Type          // closed
    desc: int                 // record: address of its type descriptor
    incomplete: bool          // declared by 'type Name', not yet defined
    line: int
}

var typeArena = new []Type(0)          // owns every type; the rest of the compiler holds handles

fn newType(kind: string, name: string, base: ?^Type): ^Type {
    append(typeArena, new Type{kind: kind, name: name, base: base, fields: new []Field(0), variants: new []^Type(0)})
    return handle(typeArena[len(typeArena) - 1])
}

let tInt = newType("int", "int", nil)
let tByte = newType("byte", "byte", nil)
let tBool = newType("bool", "bool", nil)
let tString = newType("string", "string", nil)
let tVoid = newType("void", "void", nil)
let tNil = newType("nil", "nil", nil)

fn baseOf(t: ^Type): ^Type {
    let b = t.base
    if b != nil { return b }
    return tVoid
}

fn tname(t: ^Type): string {
    if t.kind == "array" { return "[]" + tname(baseOf(t)) }
    if t.kind == "handle" { return "^" + tname(baseOf(t)) }
    if t.kind == "opt" { return "?" + tname(baseOf(t)) }
    if len(t.name) > 0 { return t.name }
    return t.kind
}

fn isInt(t: ^Type): bool { return t.kind == "int" || t.kind == "byte" }

fn isRef(t: ^Type): bool {
    return t.kind == "record" || t.kind == "closed" || t.kind == "array" || t.kind == "opt" || t.kind == "string"
}

fn nonNull(t: ^Type): bool { return t.kind == "record" || t.kind == "closed" || t.kind == "array" || t.kind == "handle" }

fn same(a: ^Type, b: ^Type): bool {
    if a == b { return true }
    if a.kind != b.kind { return false }
    if a.kind == "array" || a.kind == "opt" || a.kind == "handle" { return same(baseOf(a), baseOf(b)) }
    return a.kind == "int" || a.kind == "byte" || a.kind == "bool" || a.kind == "string" ||
        a.kind == "void" || a.kind == "nil"
}

fn assignable(dst: ^Type, src: ^Type): bool {
    if same(dst, src) { return true }
    if dst.kind == "int" && src.kind == "byte" { return true }
    if dst.kind == "closed" && src.kind == "record" && src.parent == dst { return true }
    if dst.kind == "handle" && src.kind == "handle" { return assignable(baseOf(dst), baseOf(src)) }
    if dst.kind == "opt" {
        if src.kind == "nil" { return true }
        if src.kind == "opt" { return assignable(baseOf(dst), baseOf(src)) }
        return assignable(baseOf(dst), src)
    }
    return false
}

// the index of a record's field, or -1 (fields are reached through the type's handle)
fn fieldIndex(t: ^Type, name: string): int {
    for i in 0..len(t.fields) {
        if t.fields[i].name == name { return i }
    }
    return -1
}

// ======================================================== symbols, items

type Sym = ref record {
    kind: string              // var let const type fn builtin
    name: string
    typ: ?^Type
    storage: string           // local or global
    offset: int               // rbp offset or absolute address
    value: int                // const
    addr: int                 // fn: code position once defined, else -1
    fixups: []int             // fn: calls waiting for the address
    params: []^Type
    ret: ^Type
    line: int
    owned: bool               // a local holding an owned value
    moved: bool               // its value has been moved away
    touches: int              // how many calls have moved it: a whole array's header is freed only by a move
    deferUse: bool            // a defer reads it, so it may not be moved
    isStr: bool               // a string local, holding one reference
    isRef: bool               // a reference: a parameter or local that borrows
    isRefLocal: bool          // a reference local (its validity is tracked)
    hOrigin: ?^Sym            // a let handle to a whole owned local: the local its object is in
    hDepth: int              // the loop depth where a let handle with an origin was declared
    isParam: bool            // a parameter of the function being compiled: its object came from a caller
    bind: ^RefBind            // what a reference local points into, on the path being compiled
    fresh: bool               // pointed afresh since the innermost loop began, on every path to here
    staleUse: int            // useSeq of the last read that was not fresh (see loopBindCheck)
    staleLine: int           // where that read is (its line and column): where a carried invalidation is reported
    staleCol: int
    freedUse: int            // useSeq of the last read that was not fresh while carryFreed (see loopBindCheck)
    writeUse: int            // useSeq of the last write through the reference, not fresh (see loopBindCheck)
    carryFreed: bool         // a change that may free something came while it was not pointed afresh on every path
    suspect: bool             // live across a recursive call that may write through a handle
    usedAt: int               // the reads so far (useSeq) when it was last read: see loopSelfCheck
    iterating: bool           // a for loop is walking this array
    pmodes: []int             // fn: 0 owned, 1 &, 2 mut, per parameter
    freed: []^Sym              // fn: the globals it might free (directly or through calls)
    freesAll: bool            // fn: it might free anything (or isn't compiled yet)
    writesHandles: bool       // fn: it frees owned objects through a handle (directly, by a callee, or a forward heading)
    home: int                 // an int or bool local held in this register (r12 to r15) instead of a stack slot, or -1
}

// A reference local's binding, on one path: what it may point into. Its roots are owned locals,
// reference parameters, globals, or handleSym (a borrow through a handle). deeps says it may point
// below the root's own object, and paths says where below ("" = anywhere). writable says changes may
// be made through it, and parent is the reference local it was derived from, which a change through
// it does not free. A binding is never changed once made: a re-point makes a new one (see arenaBind).
type RefBind = ref record {
    roots: []^Sym
    deeps: []bool
    paths: []string
    writable: bool
    parent: ?^Sym
}

// The state of the owned locals on one path at one point (see snapshot): flags holds, per local, its
// moved flag, then its suspect flag, then its fresh flag, then its carryFreed flag; binds holds its binding.
type PState = ref record {
    flags: []bool
    binds: []^RefBind
}

// A change that may free something, logged while a loop or a defer body is compiled (see logFree).
// kind 0: a change to root, all of it or the place path under it; kind 1: a change through a handle,
// which may free anything below its target (deep references); kind 2: a recursive call, which makes the
// deep references live across it suspect.
type FreeRec = ref record {
    kind: int
    root: ?^Sym
    all: bool
    path: string
    via: ?^Sym           // the reference a change is made through: references it was derived from stay valid (see invalidate)
    nonFresh: []int      // the owned locals that were reference locals not pointed afresh when the change was made
}

// the frees logged so far, while a loop or a defer body is being compiled: the loop's exits are the states
// with the frees logged before each exit applied (see loopBodyV); a defer body's frees are taken out of the
// log where it ends and replayed where its block is left (see deferStat and callDefers)
var freeLog = new []^FreeRec(0)
var freeArena = new []FreeRec(0)     // the records freeLog points into; the outermost loop's are dropped at its end
var arenaBase = 0                    // where the outermost loop's records begin in freeArena
// the loops being compiled, a count: frees are logged while it is not zero, or in a defer body
var recording = 0

// The bindings made while compiling a function. The arena owns them and fnDecl releases them when the
// function ends; handles to them are what symbols and states hold. noBind is the binding of anything
// that is not a reference local (it points at nothing); noneBind is the identity of a join.
var bindArena = new []RefBind(0)

// the ownedLocals a defer body was entered with: a re-point of one of them in the body is refused
// (see deferStat); -1 outside a defer body
var deferMark = -1
// the outer reference locals (by ownedLocals index, below deferMark) that the defer body being compiled uses
var deferUses = new []bool(0)

fn arenaBind(roots: []^Sym, deeps: []bool, paths: []string, writable: bool, parent: ?^Sym): ^RefBind {
    append(bindArena, new RefBind{roots: roots, deeps: deeps, paths: paths, writable: writable, parent: parent})
    return handle(bindArena[len(bindArena) - 1])
}

// a binding of one root
fn singleBind(root: ^Sym, deep: bool, path: string, writable: bool, parent: ?^Sym): ^RefBind {
    var roots = new []^Sym(0)
    append(roots, root)
    var deeps = new []bool(0)
    append(deeps, deep)
    var paths = new []string(0)
    if deep { append(paths, path) } else { append(paths, "") }
    return arenaBind(roots, deeps, paths, writable, parent)
}

let noBind = arenaBind(new []^Sym(0), new []bool(0), new []string(0), true, nil)
let noneBind = arenaBind(new []^Sym(0), new []bool(0), new []string(0), true, nil)

var symArena = new []Sym(0)            // owns every symbol; the rest of the compiler holds handles

fn newSym(kind: string, name: string, t: ?^Type): ^Sym {
    append(symArena, new Sym{kind: kind, name: name, typ: t, bind: noBind, addr: -1, fixups: new []int(0),
                   params: new []^Type(0), ret: tVoid, line: -1, pmodes: new []int(0), freed: new []^Sym(0), home: -1})
    return handle(symArena[len(symArena) - 1])
}

// the root of a reference that borrows through a handle: the handle may name any
// object, so any change, and any call that might free, may free what it points into
let handleSym = newSym("var", "a handle's target", nil)

fn symType(s: ^Sym): ^Type {
    let t = s.typ
    if t != nil { return t }
    return tVoid
}

type NPair = ref record {
    sym: ^Sym
    typ: ^Type
    next: ?NPair              // the rest of the list
}

// Describes where a value currently is, so that emission can be delayed.
type Item = ref record {
    mode: string              // const mem elem reg cond void
    typ: ^Type
    val: int
    base, index, disp: int    // mem: base and index registers (-1 for none)
    r: int
    cc: int                   // cond: condition code meaning true
    T, F: int                 // cond: jumps waiting for the true and false targets (lists: see waitJump)
    sym: ?^Sym                 // set when the item is a plain variable
    nt, nf: ?NPair            // narrowings valid when the condition holds / fails (a list of pairs)
    readonly: bool
    width, scale, line: int
    root: ?^Sym                // the variable a designator starts from
    strTemp: bool             // a fresh string whose reference nothing owns yet
    borrowed: bool            // the value is a reference (borrowed, not owned)
    viaHandle: bool           // the designator went through a handle
    deref: bool               // the designator goes through a field or element
    movedRef: bool            // a moved local named as an assignment target
    hOrigin: ?^Sym            // a handle made from a whole owned local by a let: that local
    path: string              // a field or element of root: "/a/b", "/items/[]"; "" = anywhere
    home: bool                // a reg item that is a local's own register: read it, never change or release it
}

fn newItem(mode: string, t: ^Type): Item {
    return new Item{mode: mode, typ: t, base: -1, index: -1, r: -1, T: 0, F: 0,
                    nt: nil, nf: nil, width: 8, scale: 8}
}

fn makeConst(t: ^Type, v: int): Item {
    let x = newItem("const", t)
    x.val = v
    return x
}

fn makeReg(t: ^Type, r: int): Item {
    let x = newItem("reg", t)
    x.r = r
    return x
}

fn voidItem(): Item { return newItem("void", tVoid) }

// a copy of where an item's value is (not its jump lists), for handing to
// something that consumes it while the original stays
fn dupItem(x: &Item): Item {
    let y = newItem(x.mode, x.typ)
    y.val = x.val
    y.base = x.base
    y.index = x.index
    y.disp = x.disp
    y.r = x.r
    y.cc = x.cc
    y.width = x.width
    y.scale = x.scale
    y.line = x.line
    y.strTemp = x.strTemp
    y.home = x.home
    return y
}

// a copy of a's narrowings, then b's (b is moved in)
fn joinPairs(a: &?NPair, b: ?NPair): ?NPair {
    if a == nil { return b }
    return new NPair{sym: a.sym, typ: a.typ, next: joinPairs(&a.next, b)}
}

// ================================================================= layout

const IMAGE_BASE = 0x400000
const CODE_BASE = 0x401000
const RODATA_BASE = 0x08000000
const GLOBAL_BASE = 0x0C000000
const RT_TEXT = 0x10000000
const RT_DATA = 0x20000000

const RT_INIT = 0
const RT_EXIT = 1
const RT_ALLOC_RECORD = 2
const RT_ALLOC_ARRAY = 3
const RT_PRINT_INT = 4
const RT_PRINT_STR = 5
const RT_PRINT_BOOL = 6
const RT_NEWLINE = 7
const RT_CONCAT = 8
const RT_STREQ = 9
const RT_PANIC_BOUNDS = 10
const RT_COLLECT = 11
const RT_GC_STATS = 12
const RT_INT_TO_STR = 13
const RT_APPEND = 14
const RT_TRUNCATE = 15
const RT_BYTES_TO_STRING = 16
const RT_SUBSTR = 17
const RT_READ_FILE = 18
const RT_WRITE_FILE = 19
const RT_ARGS = 20
const RT_SET_OUTPUT = 21
const RT_FREE = 22
const RT_FINISH = 23
const RT_STR_INC = 24
const RT_STR_DEC = 25
const RT_HANDLE = 26
const RT_DEREF = 27
const RT_ALIVE = 28

const RAX = 0
const RCX = 1
const RDX = 2
const RSP = 4
const RBP = 5
const RSI = 6
const RDI = 7

const CC_E = 4
const CC_NE = 5
const CC_L = 12
const CC_GE = 13
const CC_LE = 14
const CC_G = 15

fn relCC(o: int): int {
    match o {
        T_EQ { return CC_E }
        T_NE { return CC_NE }
        T_LT { return CC_L }
        T_GE { return CC_GE }
        T_LE { return CC_LE }
        else { return CC_G }
    }
}

fn swapCC(cc: int): int {
    match cc {
        CC_L { return CC_G }
        CC_G { return CC_L }
        CC_LE { return CC_GE }
        CC_GE { return CC_LE }
        else { return cc }
    }
}

fn isRel(s: int): bool {
    match s {
        T_EQ, T_NE, T_LT, T_LE, T_GT, T_GE { return true }
        else { return false }
    }
}

// ========================================================= compiler state

type Block = ref record {
    syms: []^Sym
    defers: []int
    frees: []^FreeRec         // the frees of the deferred bodies, replayed where the block is left (see callDefers)
    freeFrom: []int           // per defer: where its frees begin in frees
    uses: []^Sym              // the outer reference locals the deferred bodies use, checked where the block is left
    useBinds: []^RefBind      // each one's binding where the defer is declared
    useFrom: []int            // per defer: where its uses begin in uses
    nmark: int
    omark: int                // ownedLocals before this block
    hmark: int                // originSyms before this block: the let handles declared in it are dropped with it
}

type NEntry = ref record {
    sym: ^Sym
    typ: ^Type
    depth: int
    alive: bool
}

type Loop = ref record {
    brk: int                  // jumps waiting for the loop's end (a list: see waitJump)
    cont: int                 // jumps waiting for the next iteration
    blocks: int
    entry: PState              // the state when the loop was entered
    lv: ?^Sym                  // a for loop's variable, rebound every iteration
    susp: PState               // the state where a break or continue leaves the loop, joined
    back: PState               // the state where the next iteration starts: the body's end, and the continues (conts)
    exits: []PState            // the states where a break leaves the loop, each joined in with its free-log length (exitAt)
    exitAt: []int
    conts: []PState            // the states where a continue leaves, joined into back and the exits (contAt)
    contAt: []int
    logFrom: int               // the free log's length where the loop's condition or body begins
}

fn makePool(): []int {
    let p = new []int(0)
    append(p, 3)
    for r in 8..16 { append(p, r) }
    return p
}

let pool = makePool()

// Register homes. An int or bool local whose name the pre-scan of its function found busy lives in r12
// to r15 (callee-saved in the C ABI, so a runtime call keeps it) instead of a stack slot. A home is taken
// out of the free list while its local is in scope and so is never handed out as a temporary; it is
// pushed around the calls to obo functions with the other registers in use, since a callee may use any
// pool register. REG_HOMES is how many may be held at once (0 turns the allocation off); the pool keeps
// at least five others. A name needs HOME_MIN weighted uses (a use in a loop counts 8, in two loops 64)
// beyond twice the weighted calls its function makes.
const REG_HOMES = 4
const HOME_MIN = 8
var homeBits = 0                  // the registers now held by locals, as a set
var homeRetry = false             // the function being compiled ran out of registers with locals in them: see giveUpHomes

var rodata = new []byte(0)
var strKeys = new []string(0)
var strAddrs = new []int(0)
var gsize = 0
var free = new []int(0)
var depth = 0
var universe = new []^Sym(0)
var globals = new []^Sym(0)
var blocks = new []Block(0)
var narrowStack = new []NEntry(0)
var loops = new []Loop(0)
var originSyms = new []^Sym(0)   // the let handles that have an origin (hOrigin), in declaration order
var loopdepth = 0
var curFn: ?^Sym = nil
// an error that needs the whole body: reported at its end if the body writes through a handle
var pendLine = 0
var pendCol = 0
var pendMsg = ""
var selfCalls = 0                 // calls a function makes to itself, so far
var useSeq = 0                    // reads of references so far, numbered
var fnBlock = 0
var frame = 0
var farCalls = new []int(0)       // where the current function's calls out of its body keep their rel32
var fwdCalls = 0                  // calls to functions not yet defined, so far (a while condition may hold some)
var lifted = new []byte(0)        // the code of the conditions of the while loops being compiled, lifted out until their bodies are done
var waitFn = new []int(0)         // their calls that wait for a later function: which function (in globals)
var waitAt = new []int(0)         // and where the call is
var inDefer = false
var noreturn = false
var initLink = 0

fn containsInt(a: &[]int, v: int): bool {
    for x in a {
        if x == v { return true }
    }
    return false
}

fn initCompiler() {
    let poolRefs = &pool
    for r in poolRefs { append(free, r) }
    append(universe, newSym("type", "int", tInt))
    append(universe, newSym("type", "byte", tByte))
    append(universe, newSym("type", "bool", tBool))
    append(universe, newSym("type", "string", tString))
    let names = words("print println len gc gcstats exit append truncate substr eprint eprintln readFile writeFile args")
    for n in names { append(universe, newSym("builtin", n, nil)) }
    append(universe, newSym("builtin", "take", nil))
    append(universe, newSym("builtin", "handle", nil))
    append(universe, newSym("builtin", "alive", nil))
    append(universe, newSym("builtin", "drop", nil))
    append(universe, newSym("builtin", "replace", nil))
}

fn error(msg: string) { errorAt(msg, 0, 0) }

// Python's repr() of a bytes value, as obx.py shows string tokens
fn bytesRepr(s: string): string {
    var hasSingle = false
    var hasDouble = false
    for i in 0..len(s) {
        if s[i] == '\'' { hasSingle = true }
        if s[i] == '"' { hasDouble = true }
    }
    var q: byte = '\''
    if hasSingle && !hasDouble { q = '"' }
    let out = new []byte(0)
    append(out, 'b')
    append(out, q)
    for i in 0..len(s) {
        let c = s[i]
        if c == '\\' || c == q {
            append(out, '\\')
            append(out, c)
        } else if c == '\t' {
            append(out, '\\')
            append(out, 't')
        } else if c == '\n' {
            append(out, '\\')
            append(out, 'n')
        } else if c == '\r' {
            append(out, '\\')
            append(out, 'r')
        } else if c < 32 || c >= 127 {
            append(out, '\\')
            append(out, 'x')
            append(out, hexDigit(c >> 4))
            append(out, hexDigit(c & 15))
        } else {
            append(out, c)
        }
    }
    append(out, q)
    return string(out)
}

fn expect(k: int, what: string) {
    if sym != k {
        var got = tokName(sym)
        if sym == T_IDENT {
            got = "'" + sval + "'"
        } else if sym == T_INT {
            got = string(ival)
        } else if sym == T_STRING {
            got = bytesRepr(sval)
        }
        if got == ";" { got = "end of line" }
        var w = what
        if len(w) == 0 { w = "'" + tokName(k) + "'" }
        error("expected " + w + ", found " + got)
    }
    next()
}

fn ident(): string {
    if sym != T_IDENT { error("expected identifier") }
    let name = sval
    next()
    return name
}

fn skipSemis() {
    while sym == T_SEMI { next() }
}

// ======================================================== emission helpers

// A list of jumps waiting for one target is 0 when empty, else the first of them; see putRel.
fn waitJump(head: int, at: int): int {
    putRel(at, head)
    return at
}

fn joinWaits(a: int, b: int): int {
    if a == 0 { return b }
    var at = a
    while getRel(at) != 0 { at = getRel(at) }
    putRel(at, b)
    return a
}

fn fixTo(head: int, target: int) {
    var at = head
    while at != 0 {
        let next = getRel(at)
        fix(at, target)
        at = next
    }
}

fn fixHere(head: int) { fixTo(head, pc()) }

fn jmpTo(target: int) { fix(jmp(), target) }

fn fixHere1(at: int) { fix(at, pc()) }

fn callAbs(addr: int) {
    emit(0xE8)
    append(farCalls, pc())
    emit32(addr - (CODE_BASE + pc() + 4))
}

fn rodAlign() {
    while len(rodata) % 8 != 0 { append(rodata, 0) }
}

fn rod64(v: int) {
    var x = v
    for i in 0..8 {
        append(rodata, byte(x))
        x = x >> 8
    }
}

fn stringLit(data: string): int {
    for i in 0..len(strKeys) {
        if strKeys[i] == data { return strAddrs[i] }
    }
    rodAlign()
    let addr = RODATA_BASE + len(rodata)
    rod64(len(data))
    for i in 0..len(data) { append(rodata, data[i]) }
    append(strKeys, data)
    append(strAddrs, addr)
    return addr
}

fn rodataString(addr: int): string {
    let off = addr - RODATA_BASE
    var n = 0
    for i in 0..8 { n = n | int(rodata[off + i]) << (8 * i) }
    let b = new []byte(0)
    for i in 0..n { append(b, rodata[off + 8 + i]) }
    return string(b)
}

// [size][n owned][offsets...][n strings][offsets...]: what freeing a record frees
fn descriptor(size: int, ptrs: &[]int, strs: &[]int): int {
    rodAlign()
    let addr = RODATA_BASE + len(rodata)
    rod64(size)
    rod64(len(ptrs))
    for p in ptrs { rod64(p) }
    rod64(len(strs))
    for p in strs { rod64(p) }
    return addr
}

fn mem(base: int, index: int, disp: int, scale: int): Mem {
    return new Mem{base: base, index: index, disp: disp, scale: scale}
}

fn memOf(x: &Item): Mem { return mem(x.base, x.index, x.disp, x.scale) }

fn movRR(d: int, s: int) {
    if d != s { opReg(0x8B, d, s, true, false) }
}

fn pushR(r: int) {
    push(r)
    depth += 8
}

fn popR(r: int) {
    pop(r)
    depth -= 8
}

fn epilogue() {
    emit(0x48)
    emit(0x89)
    emit(0xEC)
    emit(0x5D)
    emit(0xC3)
}

// ===================================================== registers and items

// The function being compiled has locals in registers and no temporary is free. The locals' registers become
// temporaries, as they are with no locals in registers, and the pass goes on to the end of the function,
// its code to be thrown away: it reports what the function with all its locals in memory would report
// (an error at a later token, or the exhaustion again, which is then the real one), and if it reaches the
// end without one, fnDecl compiles the function again with no registers for locals (homeRetry).
fn giveUpHomes() {
    for r in 12..16 {
        if (homeBits & (1 << r)) != 0 { append(free, r) }
    }
    homeBits = 0
    homeRetry = true
}

fn alloc(): int {
    if len(free) == 0 && homeBits != 0 { giveUpHomes() }
    if len(free) == 0 { error("expression too complex (out of registers)") }
    let r = free[0]
    for i in 1..len(free) { free[i - 1] = free[i] }
    truncate(free, len(free) - 1)
    return r
}

fn release(r: int) {
    if containsInt(pool, r) && !containsInt(free, r) && (homeBits & (1 << r)) == 0 { append(free, r) }
}

fn releaseItem(x: &Item) {
    if x.mode == "reg" {
        release(x.r)
    } else if x.mode == "mem" || x.mode == "elem" {
        if x.base >= 0 && x.base != RBP { release(x.base) }
        if x.index >= 0 { release(x.index) }
    }
}

// the registers in use, as a set: bit r is set for register r
fn usedRegs(): int {
    var set = 0
    let poolRefs = &pool
    for r in poolRefs {
        if !containsInt(free, r) { set = set | (1 << r) }
    }
    return set
}

// the registers not in busy are free, in pool order
fn setFree(busy: int) {
    truncate(free, 0)
    let poolRefs = &pool
    for r in poolRefs {
        if ((busy | homeBits) & (1 << r)) == 0 { append(free, r) }
    }
}

// pushes the registers in the set, in pool order; popRegs pops them in reverse
fn pushRegs(set: int) {
    let poolRefs = &pool
    for r in poolRefs {
        if (set & (1 << r)) != 0 { pushR(r) }
    }
}

fn popRegs(set: int) {
    var i = len(pool) - 1
    while i >= 0 {
        if (set & (1 << pool[i])) != 0 { popR(pool[i]) }
        i -= 1
    }
}

// the C argument registers, in order
fn argReg(i: int): int {
    if i == 0 { return RDI }
    if i == 1 { return RSI }
    if i == 2 { return RDX }
    return RCX
}

fn trapBounds(line: int) {
    emit(0xBF)
    emit32(line)
    emit(0x48)
    emit(0x83)
    emit(0xE4)
    emit(0xF0)
    callAbs(RT_TEXT + 8 * RT_PANIC_BOUNDS)
}

fn boundsCheck(idx: int, length: Mem, line: int) {
    opMem(0x3B, idx, length, true, false)
    emit(0x72)
    emit(14)
    trapBounds(line)
}

fn resolve(mut x: &Item) {
    if x.mode == "elem" {
        boundsCheck(x.index, mem(x.base, -1, 0, 8), x.line)
        opMem(0x8B, x.base, mem(x.base, -1, 16, 8), true, false)
        x.mode = "mem"
        x.disp = 8
        x.scale = x.width
    }
}

fn load(x: Item): Item {
    if x.mode == "reg" {
        if !x.home { return x }
        let c = alloc()                       // a local's own register is copied: the caller may change what it gets
        movRR(c, x.r)
        return makeReg(x.typ, c)
    }
    var r = 0
    if x.mode == "const" {
        r = alloc()
        movRI(r, x.val)
    } else if x.mode == "mem" || x.mode == "elem" {
        resolve(x)
        releaseItem(x)
        r = alloc()
        if x.width == 1 {
            opMem(0x0FB6, r, memOf(x), true, false)
        } else {
            opMem(0x8B, r, memOf(x), true, false)
        }
    } else if x.mode == "cond" {
        r = alloc()
        if x.T == 0 && x.F == 0 {
            opReg(0x0F90 + x.cc, 0, r, false, true)
            opReg(0x0FB6, r, r, true, true)
        } else {
            x.F = waitJump(x.F, jcc(x.cc ^ 1))
            fixHere(x.T)
            movRI(r, 1)
            let j = jmp()
            fixHere(x.F)
            movRI(r, 0)
            fix(j, pc())
        }
    }
    return makeReg(x.typ, r)
}

// the item in a register that is only read: a local's own register is used where it is
fn asReg(x: Item): Item {
    if x.mode == "reg" { return x }
    return load(x)
}

fn loadCond(x: Item): Item {
    if x.typ.kind != "bool" { error("condition must be bool, not " + tname(x.typ)) }
    if x.mode == "cond" { return x }
    if x.mode == "mem" {
        releaseItem(x)
        aluMI(7, memOf(x), 0)
        drop(x)
    } else {
        let y = asReg(x)
        opReg(0x85, y.r, y.r, true, false)
        release(y.r)
    }
    let c = newItem("cond", tBool)
    c.cc = CC_NE
    return c
}

fn falseJump(mut x: &Item): int {
    x.F = waitJump(x.F, jcc(x.cc ^ 1))
    fixHere(x.T)
    return x.F
}

fn store(dst: Item, source: Item) {
    var src = source
    if dst.home {
        if src.mode == "const" {
            movRI(dst.r, src.val)
        } else {
            src = asReg(src)
            movRR(dst.r, src.r)
            release(src.r)
        }
        return
    }
    if src.mode != "const" { src = asReg(src) }
    resolve(dst)
    if dst.width == 1 {
        if src.mode == "const" {
            opMem(0xC6, 0, memOf(dst), false, false)
            emit(src.val & 255)
        } else {
            opMem(0x88, src.r, memOf(dst), false, true)
        }
    } else if src.mode == "const" && fits32(src.val) {
        opMem(0xC7, 0, memOf(dst), true, false)
        emit32(src.val)
    } else {
        src = asReg(src)
        opMem(0x89, src.r, memOf(dst), true, false)
    }
    if src.mode == "reg" { release(src.r) }
    releaseItem(dst)
}

fn materialise(x: Item): Item {
    if x.mode == "mem" || x.mode == "elem" || x.mode == "cond" { return load(x) }
    return x
}

// =================================================================== calls

// the registers in use are pushed, and all of them are free for the callee
fn saveRegs(): int {
    let saved = usedRegs()
    pushRegs(saved)
    setFree(0)
    return saved
}

// the saved registers are popped, and the ones that were not in use are free again
fn restoreRegs(saved: int) {
    popRegs(saved)
    setFree(saved)
}

var argConsts = new []int(0)      // rtCall's constant arguments: a call owns the part from its base up, so load() may re-enter

// Calls a runtime routine with the C ABI; live registers, including the
// arguments, are pushed first so the collector sees every pointer. A constant
// argument needs no register: it goes straight to its argument register.
fn rtCall(slot: int, args: []?Item, ret: ^Type): Item {
    let regs = new []int(0)                 // -1 for a constant, which is in argConsts
    let base = len(argConsts)
    let temps = new []bool(0)
    for ai in 0..len(args) {
        let a = take(args[ai])
        if a != nil {
            append(temps, a.strTemp && slot != RT_STR_DEC)    // dropping a string is its own drop
            if a.mode == "const" && !a.strTemp {
                append(regs, -1)
                append(argConsts, a.val)
                drop(a)
            } else {
                let la = asReg(a)                // a local's own register is read where it is
                append(regs, la.r)
                append(argConsts, 0)
            }
        } else {
            drop(a)
        }
    }
    let saved = usedRegs() & ~homeBits      // the C runtime keeps r12 to r15, where the locals are
    pushRegs(saved)
    for i in 0..len(regs) {
        if regs[i] < 0 { movRI(argReg(i), argConsts[base + i]) } else { movRR(argReg(i), regs[i]) }
    }
    truncate(argConsts, base)
    let pad = depth % 16
    if pad != 0 {
        aluRI(5, RSP, 8)
        depth += 8
    }
    callAbs(RT_TEXT + 8 * slot)
    if pad != 0 {
        aluRI(0, RSP, 8)
        depth -= 8
    }
    popRegs(saved)
    var got = -1
    if ret != tVoid {
        got = alloc()
        movRR(got, RAX)
    }
    for i in 0..len(regs) {
        if temps[i] {
            // not rtCall1: it comes later, and a forward heading would count as freeing anything
            let one = new []?Item(0)
            append(one, makeReg(tString, regs[i]))
            rtCall(RT_STR_DEC, one, tVoid)
        }
    }
    for r in regs { release(r) }
    if ret == tVoid { return voidItem() }
    let res = makeReg(ret, got)
    res.strTemp = ret == tString            // every string a runtime call returns is fresh
    return res
}

fn rtCall0(slot: int, ret: ^Type): Item { return rtCall(slot, new []?Item(0), ret) }

fn rtCall1(slot: int, a: Item, ret: ^Type): Item {
    let args = new []?Item(0)
    append(args, a)
    return rtCall(slot, args, ret)
}

fn rtCall2(slot: int, a: Item, b: Item, ret: ^Type): Item {
    let args = new []?Item(0)
    append(args, a)
    append(args, b)
    return rtCall(slot, args, ret)
}

// ========================================================= scopes, narrowing

fn findSym(list: &[]^Sym, name: string): ?^Sym {
    for s in list {
        if s.name == name { return s }
    }
    return nil
}

fn lookup(name: string): ^Sym {
    var i = len(blocks) - 1
    while i >= 0 {
        let s = findSym(blocks[i].syms, name)
        if s != nil { return s }
        i -= 1
    }
    let g = findSym(globals, name)
    if g != nil { return g }
    let u = findSym(universe, name)
    if u != nil { return u }
    error("undeclared identifier '" + name + "' (declare before use; use a forward heading for mutual recursion)")
    return newSym("var", name, nil)
}

fn declare(s: ^Sym): ^Sym {
    var scope = &globals
    if len(blocks) > 0 { scope = &blocks[len(blocks) - 1].syms }
    if findSym(scope, s.name) != nil { error("'" + s.name + "' is already declared in this scope") }
    append(scope, s)
    return s
}

// ============================================================== ownership

var ownedLocals = new []^Sym(0)
var condDepth = 0                 // inside the right operand of && or ||
var pinned: ?^Sym = nil            // a local being assigned through
var userCalls = 0                 // calls to obx functions compiled so far

fn isOwned(t: ^Type): bool {
    if t.kind == "record" || t.kind == "closed" || t.kind == "array" { return true }
    if t.kind == "opt" { return isOwned(baseOf(t)) }
    return false
}

fn addOwnedLocal(s: ^Sym) {
    s.owned = true
    append(ownedLocals, s)
}

fn invalidate(root: ?^Sym, via: ?^Sym, all: bool, path: string)

// frees the live owned locals ownedLocals[from..to), newest first
fn freeOwned(from: int, to: int) {
    var i = to - 1
    while i >= from {
        let s = ownedLocals[i]
        if s.owned { invalidate(s, nil, true, "") }
        if !s.moved && !s.isRefLocal {
            let x = newItem("mem", symType(s))
            x.base = RBP
            x.disp = s.offset
            if s.isStr {
                rtCall1(RT_STR_DEC, x, tVoid)
            } else {
                rtCall1(RT_FREE, x, tVoid)
            }
        }
        i -= 1
    }
}

// the index of the ']' that closes the element segment starting at i
fn elemEnd(s: string, i: int): int {
    var j = i
    while s[j] != ']' { j += 1 }
    return j
}

// p names s or something above it: its segments are the first ones of s
fn segsPrefix(p: string, s: string): bool {
    var i = 0
    var j = 0
    while i < len(p) {
        if j >= len(s) { return false }
        if p[i] == '[' {
            if s[j] != '[' { return false }
            let pe = elemEnd(p, i)
            let se = elemEnd(s, j)
            // two known elements must be the same one; an unknown one may be any
            if pe - i > 1 && se - j > 1 {
                if pe - i != se - j { return false }
                for k in 0..pe - i {
                    if p[i + k] != s[j + k] { return false }
                }
            }
            i = pe + 1
            j = se + 1
        } else {
            if p[i] != s[j] { return false }
            i += 1
            j += 1
        }
    }
    return j == len(s) || s[j] == '/'
}

// ------------------------------------------------------------ joining bindings

// two bindings of the same place (one each) joined: a place is hit by every change that hits either
// one, so when one lies under the other, the longer one is hit by all the changes that hit the shorter
fn joinPath(da: bool, pa: string, db: bool, pb: string): string {
    if !db { return pa }
    if !da { return pb }
    if pa == pb { return pa }
    if pa == "" || pb == "" { return "" }
    if segsPrefix(pa, pb) && !segsPrefix(pb, pa) { return pb }
    if segsPrefix(pb, pa) && !segsPrefix(pa, pb) { return pa }
    return ""
}

fn sameParent(a: ?^Sym, b: ?^Sym): bool {
    if a == nil { return b == nil }
    if b == nil { return false }
    return a == b
}

// the binding of a path that joins a and b: every root either may point into, deep where either may,
// at the place that covers both; writable only where both are, and a parent only where equal
fn joinBind(a: ^RefBind, b: ^RefBind): ^RefBind {
    if a == b || b == noneBind { return a }
    if a == noneBind { return b }
    var roots = new []^Sym(0)
    var deeps = new []bool(0)
    var paths = new []string(0)
    var changed = false
    for i in 0..len(a.roots) {
        append(roots, a.roots[i])
        append(deeps, a.deeps[i])
        append(paths, a.paths[i])
    }
    for j in 0..len(b.roots) {
        var found = false
        for i in 0..len(roots) {
            if roots[i] == b.roots[j] {
                found = true
                let d = deeps[i] || b.deeps[j]
                let p = joinPath(deeps[i], paths[i], b.deeps[j], b.paths[j])
                if d != deeps[i] || p != paths[i] { changed = true }
                deeps[i] = d
                paths[i] = p
            }
        }
        if !found {
            append(roots, b.roots[j])
            append(deeps, b.deeps[j])
            append(paths, b.paths[j])
            changed = true
        }
    }
    let writable = a.writable && b.writable
    if writable != a.writable { changed = true }
    var parent: ?^Sym = a.parent
    if !sameParent(a.parent, b.parent) {
        parent = nil
        changed = true
    }
    if !changed { return a }
    return arenaBind(roots, deeps, paths, writable, parent)
}

// the places e covers for a place of b, both in one root: a whole-object pointer covers only
// whole-object ones, and an e whose place lies under b's covers b's, since e is hit by all b is
fn coversPlace(ed: bool, ep: string, bd: bool, bp: string): bool {
    if !bd { return true }
    if !ed { return false }
    if ep == "" { return true }
    return bp != "" && segsPrefix(bp, ep)
}

// the binding b, at the end of a loop's body, is covered by e, the binding the body was checked with:
// every change that reaches b is one e was checked against, and b is writable wherever e is (a write
// checked against e is allowed through b too)
fn bindCovers(e: ^RefBind, b: ^RefBind): bool {
    if b == noneBind || b == e { return true }
    if e.writable && !b.writable { return false }
    if !sameParent(e.parent, b.parent) { return false }
    for j in 0..len(b.roots) {
        var covered = false
        for i in 0..len(e.roots) {
            if e.roots[i] == b.roots[j] && coversPlace(e.deeps[i], e.paths[i], b.deeps[j], b.paths[j]) {
                covered = true
            }
        }
        if !covered { return false }
    }
    return true
}

// The state of the owned locals on one path: moves must agree where paths join, while suspicion,
// freshness and bindings are the join of the paths'. See PState.
fn snapshot(): PState {
    let locals = &ownedLocals
    let n = len(locals)
    var flags = new []bool(4 * n)
    var binds = new []^RefBind(0)
    for i in 0..n {
        flags[i] = locals[i].moved
        flags[n + i] = locals[i].suspect
        flags[2 * n + i] = locals[i].fresh
        flags[3 * n + i] = locals[i].carryFreed
        append(binds, locals[i].bind)
    }
    return new PState{flags: flags, binds: binds}
}

// no moves, no suspicion, every local fresh and nothing pointed at: where a join begins
fn neutralState(n: int): PState {
    var flags = new []bool(4 * n)
    var binds = new []^RefBind(0)
    for i in 0..n {
        flags[2 * n + i] = true
        append(binds, noneBind)
    }
    return new PState{flags: flags, binds: binds}
}

fn emptyState(): PState { return neutralState(0) }

// the number of locals a state covers
fn localsIn(st: &PState): int { return len(st.binds) }

fn copyState(a: &PState): PState {
    let n = len(a.flags)
    let m = len(a.binds)
    var flags = new []bool(n)
    var binds = new []^RefBind(0)
    for i in 0..n { flags[i] = a.flags[i] }
    for i in 0..m { append(binds, a.binds[i]) }
    return new PState{flags: flags, binds: binds}
}

fn restore(st: &PState) {
    let n = localsIn(st)
    for i in 0..n {
        ownedLocals[i].moved = st.flags[i]
        ownedLocals[i].suspect = st.flags[n + i]
        ownedLocals[i].fresh = st.flags[2 * n + i]
        ownedLocals[i].carryFreed = st.flags[3 * n + i]
        ownedLocals[i].bind = st.binds[i]
    }
}

// a deferred body runs where its block is left, so the suspicion, freshness and bindings it
// leaves are taken back here; its moves are kept, since a deferred body may free
fn restoreDeferred(st: &PState) {
    let n = localsIn(st)
    for i in 0..n {
        ownedLocals[i].suspect = st.flags[n + i]
        ownedLocals[i].fresh = st.flags[2 * n + i]
        ownedLocals[i].bind = st.binds[i]
    }
}

// the moves of a state, without the rest (a loop's exits are joined in afterwards)
fn restoreMoved(st: &PState) {
    for i in 0..localsIn(st) { ownedLocals[i].moved = st.flags[i] }
}

// where paths join: st's suspicion, bindings and freshness join the current ones
fn joinSuspect(st: &PState) {
    let n = localsIn(st)
    for i in 0..n {
        let s = ownedLocals[i]
        if st.flags[n + i] { s.suspect = true }
        if st.flags[i] && s.isRefLocal { s.moved = true }
        if st.flags[3 * n + i] { s.carryFreed = true }
        let jb = joinBind(s.bind, st.binds[i])
        s.bind = jb
        s.fresh = s.fresh && st.flags[2 * n + i]
    }
}

// as joinSuspect, but without suspicion (a continue's exit carries its suspicion to the top only)
fn joinBinds(st: &PState) {
    let n = localsIn(st)
    for i in 0..n {
        let s = ownedLocals[i]
        if st.flags[3 * n + i] { s.carryFreed = true }
        let jb = joinBind(s.bind, st.binds[i])
        s.bind = jb
        s.fresh = s.fresh && st.flags[2 * n + i]
    }
}

// per local: suspect where either state is, bindings joined, fresh only where both are; moves are b's, except
// that a reference local is invalid where either state has it invalid (its uses are checked, see nameItem)
fn joinStates(a: &PState, b: &PState): PState {
    let out = copyState(b)
    let n = localsIn(b)
    for i in 0..n {
        if a.flags[i] && ownedLocals[i].isRefLocal { out.flags[i] = true }
        if a.flags[n + i] { out.flags[n + i] = true }
        if a.flags[3 * n + i] { out.flags[3 * n + i] = true }
        out.flags[2 * n + i] = out.flags[2 * n + i] && a.flags[2 * n + i]
        let jb = joinBind(a.binds[i], b.binds[i])
        out.binds[i] = jb
    }
    return out
}

// a loop's exit (a break, a continue, or the body's end) joins the loop's accumulated state, for the
// locals the loop began with: the exit's st has at least as many
fn absorb(mut acc: &PState, st: &PState) {
    let m = localsIn(acc)
    let n = localsIn(st)
    for i in 0..m {
        if st.flags[i] && ownedLocals[i].isRefLocal { acc.flags[i] = true }
        if st.flags[n + i] { acc.flags[m + i] = true }
        if st.flags[3 * n + i] { acc.flags[3 * m + i] = true }
        acc.flags[2 * m + i] = acc.flags[2 * m + i] && st.flags[2 * n + i]
        let jb = joinBind(acc.binds[i], st.binds[i])
        acc.binds[i] = jb
    }
}

// A loop's carry marks are its own: the marks from before it are set aside while it is compiled, and
// joined back where it ends, so that a loop checks only what changes inside it (see loopBindCheck)
fn loopMarksSave(): []bool {
    var saved = new []bool(len(ownedLocals))
    for i in 0..len(ownedLocals) {
        saved[i] = ownedLocals[i].carryFreed
        ownedLocals[i].carryFreed = false
    }
    return saved
}

fn loopMarksJoin(saved: []bool) {
    for i in 0..len(saved) {
        if saved[i] { ownedLocals[i].carryFreed = true }
    }
}

// a defer body uses the reference local s: if it was declared outside the body, its binding and validity
// are checked where the block is left (see checkDeferUses)
fn noteDeferUse(s: ^Sym) {
    for i in 0..len(deferUses) {
        if ownedLocals[i] == s { deferUses[i] = true }
    }
}

// whether s is one of the first mark locals (declared before a defer body was entered)
fn declaredBefore(s: ^Sym, mark: int): bool {
    for i in 0..mark {
        if ownedLocals[i] == s { return true }
    }
    return false
}

// a reference is pointed afresh by the body of a loop before it is read there: the reads before
// that depend on the back edge, so they are not fresh
fn clearFresh() {
    let locals = &ownedLocals
    for s in locals { s.fresh = false }
}

// the first owned local whose move state differs between a and b, or nil. A reference local's invalidation
// is not a difference: where paths join it is invalid where either is, and a use of it is what is refused
fn stateDiff(a: &PState, b: &PState): ?^Sym {
    let n = localsIn(b)
    for i in 0..localsIn(a) {
        if i < n && a.flags[i] != b.flags[i] && !ownedLocals[i].isRefLocal { return ownedLocals[i] }
    }
    return nil
}

fn sameStates(a: &PState, b: &PState, line: int, col: int) {
    let d = stateDiff(a, b)
    if d != nil {
        errorAt("'" + d.name + "' is moved on one path but not another; move it on every path or none", line, col)
    }
}

// the held places are defined with the checks that use them (heldMove: see below)
fn heldMove(s: ^Sym)
fn originMove(s: ?^Sym, move: bool)
fn loopOriginCheck(s: ^Sym)

// Takes ownership of x's value, which is about to be stored in a variable,
// field, element or parameter, or returned.
fn consume(mut x: &Item) {
    if x.typ.kind == "string" {
        // the destination will hold a reference: a fresh string hands over its
        // own, anything else gets a new one (literals need none)
        if x.strTemp {
            x.strTemp = false
        } else if x.mode != "const" {
            let r = rtCall1(RT_STR_INC, dupItem(x), tString)
            x.mode = "reg"
            x.r = r.r
            x.base = -1
            x.index = -1
            x.sym = nil
            x.strTemp = false
        }
        return
    }
    if !isOwned(x.typ) || x.mode == "reg" || x.mode == "const" { return }
    let s = x.sym
    if x.borrowed || (s != nil && s.isRef) { error("cannot move out of a reference: a reference only borrows") }
    if s != nil && s.iterating { error("cannot move '" + s.name + "' while a for loop walks it") }
    if x.mode == "mem" && s != nil {
        if s.storage != "local" { error("cannot move out of global '" + s.name + "'; use take() on an optional one") }
        if inDefer { error("cannot move '" + s.name + "' inside defer") }
        if condDepth > 0 { error("cannot move '" + s.name + "' inside && or ||") }
        if pinned == s { error("cannot move '" + s.name + "' while assigning into it") }
        if s.deferUse { error("'" + s.name + "' is used by a defer and cannot be moved") }
        originMove(s, true)
        s.moved = true
        s.touches = s.touches + 1
        heldMove(s)
        invalidate(s, nil, true, "")                  // references into it now dangle
        return
    }
    error("cannot move out of a field or element; use take() on an optional one")
}

// A string read from a variable, field or element, about to be held while
// more code runs (which might replace it), takes a reference of its own.
fn pinStr(x: Item): Item {
    if x.typ.kind == "string" && !x.strTemp && x.mode != "const" {
        consume(x)
        x.strTemp = true
        return x
    }
    return materialise(x)
}

fn addStrLocal(s: ^Sym) {
    s.isStr = true
    append(ownedLocals, s)
}

// ============================================================= references

var refMode = 0                   // set by parseRefType: 0 plain, 1 &

fn mutableOf(x: &Item): bool
fn deepOf(x: &Item): bool
fn parentOf(x: &Item): ?^Sym

// the binding a reference to x takes: what x may point into, through the binding of the reference it
// goes through; a constant points at nothing
fn itemBind(x: &Item): ^RefBind {
    if x.viaHandle { return singleBind(handleSym, deepOf(x), x.path, mutableOf(x), parentOf(x)) }
    let r = x.root
    if x.mode == "const" || r == nil { return noBind }
    if !r.isRef { return singleBind(r, x.deref, x.path, true, nil) }
    let rb = r.bind
    var roots = new []^Sym(0)
    var deeps = new []bool(0)
    var paths = new []string(0)
    for i in 0..len(rb.roots) {
        append(roots, rb.roots[i])
        append(deeps, x.deref || rb.deeps[i])
        if x.deref { append(paths, "") } else { append(paths, rb.paths[i]) }
    }
    var parent: ?^Sym = nil
    if r.isRefLocal {
        if x.deref { parent = r } else { parent = rb.parent }
    }
    return arenaBind(roots, deeps, paths, rb.writable, parent)
}

// x is about to be borrowed: the binding it takes, after the checks borrowing needs
fn borrowBind(x: &Item): ^RefBind {
    if x.mode == "const" { return noBind }
    if x.viaHandle { return itemBind(x) }
    if x.mode == "reg" && isOwned(x.typ) {
        error("store this value in a variable first: a reference cannot borrow from a temporary")
    }
    let b = itemBind(x)
    if len(b.roots) == 0 { error("only variables, fields and elements can be borrowed") }
    return b
}

// the same binding with another parent
fn rebind(b: ^RefBind, parent: ?^Sym): ^RefBind {
    var roots = new []^Sym(0)
    var deeps = new []bool(0)
    var paths = new []string(0)
    for i in 0..len(b.roots) {
        append(roots, b.roots[i])
        append(deeps, b.deeps[i])
        append(paths, b.paths[i])
    }
    return arenaBind(roots, deeps, paths, b.writable, parent)
}

// true if some place the binding may point into is deeper than its root's own object
fn anyDeep(b: ^RefBind): bool {
    for i in 0..len(b.deeps) {
        if b.deeps[i] { return true }
    }
    return false
}

fn mutableOf(x: &Item): bool {
    let r = x.root
    if r != nil && r.isRef { return r.bind.writable }
    return true
}

fn deepOf(x: &Item): bool {
    if x.deref { return true }
    let r = x.root
    if r != nil && r.isRefLocal { return anyDeep(r.bind) }
    return false
}

// the reference local x was derived from, through its own binding
fn parentOf(x: &Item): ?^Sym {
    let r = x.root
    if r == nil || !r.isRefLocal { return nil }
    if x.deref { return r }
    return r.bind.parent
}

// true if a is via itself or one of the references via was derived from
fn ancestorOf(a: ^Sym, via: ?^Sym): bool {
    var p = via
    while p != nil {
        if p == a { return true }
        p = p.bind.parent
    }
    return false
}

fn makeRefLocal(v: ^Sym, b: ^RefBind) {
    v.isRef = true
    v.isRefLocal = true
    v.bind = b
    v.fresh = true
    append(ownedLocals, v)
}

// a for loop's variable borrows each element of the walked array: deep, anywhere in what the array may be in
fn walkBind(x: &Item, walked: ^Sym): ^RefBind {
    let b = itemBind(x)
    var roots = new []^Sym(0)
    var deeps = new []bool(0)
    var paths = new []string(0)
    for i in 0..len(b.roots) {
        append(roots, b.roots[i])
        append(deeps, true)
        append(paths, "")
    }
    var parent: ?^Sym = nil
    if walked.isRefLocal { parent = walked }
    return arenaBind(roots, deeps, paths, b.writable, parent)
}

// a reference parameter: it may name the same object as another one, or a global
fn isRefParam(s: ^Sym): bool { return s.isRef && !s.isRefLocal && s.storage == "local" }

// a change under root changed may free something inside root other. A change
// under a reference parameter reaches other reference parameters and globals,
// since it may be either; a change under a global reaches no parameter, since
// a function that might free under a global is never given references into it.
fn reaches(changed: ^Sym, other: ^Sym): bool {
    if changed == other { return true }
    return isRefParam(changed) && (isRefParam(other) || other.storage == "global")
}

// Paths name a place inside a root, segment by segment: "/a" for a field, "/[3]"
// for element 3 and "/[]" for an element not known at compile time. "" is the
// whole root. An element that is not known may be any element.

// the change at path p may free what a reference at path r points into: r is p
// or lies under it. "" as either side means anywhere.
fn underPath(r: string, p: string): bool {
    return r == "" || segsPrefix(p, r)
}

// two places that may be one: one lies under the other
fn pathsOverlap(a: string, b: string): bool {
    return segsPrefix(a, b) || segsPrefix(b, a)
}

// Something under root may have been freed: the root's references become
// invalid, except via (the reference the change went through) and, unless
// all, references to the root's own object; so do references that may point
// inside any other root the change reaches.
// A change that may free something is logged while a loop or a deferred body is compiled: a loop's exits
// are checked against the frees logged on their way out (see applyExit), and a deferred body's frees are
// replayed where its block is left (see replayFrees).
fn logFree(kind: int, root: ?^Sym, all: bool, path: string, via: ?^Sym) {
    if recording == 0 && !inDefer { return }
    var nf = new []int(0)
    for i in 0..len(ownedLocals) {
        if ownedLocals[i].isRefLocal && !ownedLocals[i].fresh { append(nf, i) }
    }
    append(freeArena, new FreeRec{kind: kind, root: root, all: all, path: path, via: via, nonFresh: nf})
    append(freeLog, handle(freeArena[len(freeArena) - 1]))
}

// the start of a loop, or of its condition: the outermost one remembers where its records begin
fn loopLogStart() {
    if recording == 0 { arenaBase = len(freeArena) }
    recording += 1
}

// the end of a loop, or of its condition: the log is kept while an outer loop or a deferred body needs it.
// The records of the outermost loop are dead then (a block that holds one is inside the loop and has closed)
fn loopLogEnd() {
    recording -= 1
    if recording == 0 && !inDefer {
        truncate(freeLog, 0)
        truncate(freeArena, arenaBase)
    }
}

// whether a change to root (all of it, or the place path under it) may free what binding b points into
fn hitBy(b: ^RefBind, root: ?^Sym, all: bool, path: string): bool {
    if root == nil { return false }
    for i in 0..len(b.roots) {
        let r = b.roots[i]
        // a borrow through a handle may point into any object, so any change reaches it
        if r == handleSym || r == root && (all || b.deeps[i] && underPath(b.paths[i], path)) { return true }
        if r != root && b.deeps[i] && reaches(root, r) { return true }
    }
    return false
}

// whether a logged change may free what binding b points into, for the reference local s: the same test as
// invalidate and invalidateDeep make, so a reference the change was made through, or derived from, stays valid
fn freeHits(s: ^Sym, b: ^RefBind, r: ^FreeRec): bool {
    let rv = r.via
    if ancestorOf(s, rv) { return false }
    if r.kind == 0 { return hitBy(b, r.root, r.all, r.path) }
    return anyDeep(b)
}

// a change that may free something marks each reference that is not pointed afresh on every path: a read
// of it, or its being carried round a loop, is checked (see loopBindCheck). The marks are coarse: the
// loop's end narrows them to the changes that may reach the binding the next iteration starts with.
fn markCarriedFreed() {
    for i in 0..len(ownedLocals) {
        if ownedLocals[i].isRefLocal && !ownedLocals[i].fresh {
            ownedLocals[i].carryFreed = true
        }
    }
}

// a change through a handle may free anything below its target: the references inside something are marked
fn markCarriedDeep() {
    for i in 0..len(ownedLocals) {
        if ownedLocals[i].isRefLocal && !ownedLocals[i].fresh && anyDeep(ownedLocals[i].bind) {
            ownedLocals[i].carryFreed = true
        }
    }
}

// whether two states agree: the same flags, and bindings that cover one another
fn sameState(a: &PState, b: &PState): bool {
    if len(a.flags) != len(b.flags) { return false }
    for i in 0..len(a.flags) {
        if a.flags[i] != b.flags[i] { return false }
    }
    for i in 0..localsIn(a) {
        if !bindCovers(a.binds[i], b.binds[i]) || !bindCovers(b.binds[i], a.binds[i]) { return false }
    }
    return true
}

// The state a loop is left in (at a break, at a continue, or where the condition fails), joined with the
// state where the next iteration starts (back). A reference not pointed afresh on the way out may point
// where back points, so a free on the way (logged from the loop's start, logFrom, to at) that may reach
// what it points into moves it (a recursive call makes it suspect instead), and its binding joins back's.
fn applyExit(mut x: &PState, back: &PState, logFrom: int, at: int) {
    let n = localsIn(x)
    let m = localsIn(back)
    for i in 0..m {
        if !x.flags[2 * n + i] && ownedLocals[i].isRefLocal {
            let bb = back.binds[i]
            let s = ownedLocals[i]
            for k in logFrom..at {
                let r = freeLog[k]
                if r.kind == 2 {
                    if freeHits(s, bb, r) {
                        x.flags[n + i] = true
                        x.flags[3 * n + i] = true
                    }
                } else if freeHits(s, bb, r) {
                    x.flags[i] = true
                    x.flags[3 * n + i] = true
                }
            }
            x.binds[i] = joinBind(x.binds[i], bb)
        }
    }
}

fn invalidate(root: ?^Sym, via: ?^Sym, all: bool, path: string) {
    if root == nil { return }
    logFree(0, root, all, path, via)
    markCarriedFreed()
    let locals = &ownedLocals
    for v in locals {
        // a change through via frees only things below via: references it was
        // derived from point above it and stay valid
        if v.isRefLocal && !ancestorOf(v, via) && !v.moved {
            if hitBy(v.bind, root, all, path) {
                if v.iterating { error("cannot change what '" + v.name + "' points into while a for loop walks it") }
                v.moved = true
            }
        }
    }
}

// A change through a handle may free anything below its target, so every reference that points
// inside something is invalid, whatever it borrows from. A reference to a whole object stays
// valid: only owners free whole objects, and a change through a handle frees only below its target.
fn invalidateDeep(via: ?^Sym) {
    logFree(1, nil, false, "", via)
    markCarriedDeep()
    let locals = &ownedLocals
    for v in locals {
        if v.isRefLocal && anyDeep(v.bind) && !ancestorOf(v, via) && !v.moved {
            if v.iterating { error("cannot change what '" + v.name + "' points into while a for loop walks it") }
            v.moved = true
        }
    }
}

// a deferred error, reported at the end of the body if it writes through a handle; the earliest wins
fn notePending(line: int, col: int, msg: string) {
    if pendLine == 0 || line < pendLine || (line == pendLine && col < pendCol) {
        pendLine = line
        pendCol = col
        pendMsg = msg
    }
}

// a recursive call (or a deferred one) may write through a handle: the references inside something
// that are live now may be freed, so they are suspect until they are pointed afresh
fn markSuspects() {
    logFree(2, nil, false, "", nil)
    let locals = &ownedLocals
    for v in locals {
        if v.isRefLocal && anyDeep(v.bind) && !v.moved { v.suspect = true }
    }
}

// a loop whose body calls the function itself: a reference from before the loop that is suspect where
// the next iteration starts (back: the body's end, or a continue) may be read there, in the loop's
// condition or its body, after the call freed what it points into. The suspicion follows the paths,
// so a reference pointed afresh after the call on every path is not reported, and a reference that
// the loop does not read (usedAt, read since the loop began: useBefore) is not reported either. The
// loop variable of a for walk is rebound each iteration, so its suspicion is not carried.
fn loopSelfCheck(nOuter: int, selfBefore: int, useBefore: int, back: &PState, lv: ?^Sym, line: int, col: int) {
    if selfCalls == selfBefore { return }
    for i in 0..nOuter {
        if back.flags[localsIn(back) + i] && ownedLocals[i] != lv && ownedLocals[i].usedAt > useBefore {
            notePending(line, col, "a recursive call in this loop writes through a handle, which could free what a reference inside something points into on the next iteration")
            return
        }
    }
}

// A loop that points a reference somewhere new and reads it before pointing it again reads it on the
// next iteration with a binding the body was not checked with. That is unsafe where a change may have
// freed what the reference points into while it was not pointed afresh (carryFreed, at a read or at the
// back edge), and where the binding comes back read-only but the body was checked against a writable
// one. Otherwise the binding must be covered by the one the body was checked with (see bindCovers).
fn loopBindCheck(entry: &PState, back: &PState, useBefore: int, lv: ?^Sym, line: int, col: int, hit: []bool) {
    let n = localsIn(entry)
    for i in 0..n {
        let s = ownedLocals[i]
        let e = entry.binds[i]
        let b = back.binds[i]
        if s.isRefLocal && s != lv && s.staleUse > useBefore && !bindCovers(e, b) {
            if hit[i] && (s.freedUse > useBefore || back.flags[3 * n + i]) {
                errorAt("'" + s.name + "' is pointed somewhere new inside the loop, and read before it is pointed again; point it before the loop, or point it afresh before reading it in the loop", line, col)
            }
            if e.writable && !b.writable && s.writeUse > useBefore {
                errorAt("'" + s.name + "' is read-only where the loop starts again, and written before it is pointed again; point it afresh before writing it in the loop", line, col)
            }
        }
    }
}

// the error at a use of a reference that a change may have invalidated, on some path (see nameItem)
fn freedRefMsg(name: string): string {
    return "'" + name + "' may point to freed memory: something under what it points into was changed; point it again first"
}

// A reference that is invalid where the next iteration starts (a change in the loop invalidated it on some
// path to the back edge, or to a continue) is invalid at the top of the loop. The body was compiled with the
// state the loop was entered in, so a read of it that is not pointed afresh is where the invalidity shows: it
// is reported there, as a use, with the message a use of an invalid reference always gets. A loop that
// invalidates a reference and never reads it again is accepted.
fn loopCarryCheck(back: &PState, useBefore: int, lv: ?^Sym) {
    let n = localsIn(back)
    for i in 0..n {
        let s = ownedLocals[i]
        if s.isRefLocal && s != lv && back.flags[i] && s.staleUse > useBefore {
            errorAt(freedRefMsg(s.name), s.staleLine, s.staleCol)
        }
    }
}

// ======================================================== effect summaries
// Every function records which globals it might free. Bodies are compiled
// before they can be called (declare before use), so at a call site the
// callee's summary is complete, unless it is still being compiled (recursion:
// the body treats the call as freeing anything, but the summary does not) or
// only has a forward heading: then it is assumed to free anything.

// a callee that frees no global and changes no mut argument: compiled, freeing no globals, and with
// no mut parameters it could free through. An owned by-value parameter does not make it impure: the
// caller's argument is a move, which consume() counts (touches), and the array checks see that.
fn pureFn(f: ^Sym): bool {
    if f.addr < 0 || f == curFn || f.freesAll || len(f.freed) > 0 { return false }
    for i in 0..len(f.pmodes) {
        if f.pmodes[i] == 2 { return false }
    }
    return true
}

fn mightFree(f: ^Sym, g: ^Sym): bool {
    if f.addr < 0 || f == curFn || f.freesAll { return true }
    let freed = &f.freed
    for x in freed {
        if x == g { return true }
    }
    return false
}

// the current function might free global g
fn recordFree(g: ?^Sym) {
    let f = curFn
    if f == nil || g == nil { return }
    if g == handleSym {                  // a change through a handle may free anything
        f.freesAll = true
        f.writesHandles = true
        return
    }
    if g.storage != "global" { return }
    let freed = &f.freed
    for x in freed {
        if x == g { return }
    }
    append(f.freed, g)
}

// after calling f: references into what f might free are no longer valid,
// and the caller inherits f's effects. A self-call adds nothing to the summary: the
// body's later frees are not recorded yet, but the body treats the call as freeing
// anything, and a caller reads the summary only once the body is finished.
fn afterCall(f: ^Sym) {
    let cur = curFn
    let all = f.addr < 0 || f == cur || f.freesAll
    if cur != nil && all && f != cur { cur.freesAll = true }
    if f == cur {
        // a recursive call may write through a handle, which is known only at the end of the body:
        // until then the references inside something that are live across it are suspect
        selfCalls += 1
        markSuspects()
        markCarriedDeep()                 // the deep references it may free are carried as any other change's are
    } else if f.addr < 0 || f.writesHandles {
        // a callee that writes through a handle, or may: references inside something may be freed
        if cur != nil { cur.writesHandles = true }
        invalidateDeep(nil)
    }
    if !pureFn(f) { invalidate(handleSym, nil, false, "") }   // and so may a borrow through a handle
    let gs = &globals
    for g in gs {
        if (g.kind == "var" || g.kind == "let") && (all || mightFree(f, g)) {
            invalidate(g, nil, true, "")
            if !all { recordFree(g) }
        }
    }
}

// the reference local a change goes through, if any
fn viaOf(x: &Item): ?^Sym {
    let r = x.root
    if r != nil && r.isRefLocal { return r }
    return nil
}

// a change through x: the roots its binding may point into lose their references, and so do the
// handle-rooted ones when x went through a handle. Such an x may have no root (handle(p).items).
fn invalidateChange(x: &Item) {
    let r = x.root
    let via = viaOf(x)
    if r != nil {
        // a write through a reference that is not pointed afresh: see loopBindCheck
        if r.isRefLocal && !r.fresh {
            useSeq += 1
            r.writeUse = useSeq
        }
        if r.isRef {
            for i in 0..len(r.bind.roots) { invalidate(r.bind.roots[i], via, false, x.path) }
        } else {
            invalidate(r, via, false, x.path)
        }
    }
    if x.viaHandle { invalidate(handleSym, via, false, "") }
}

// a change through x goes through a handle, or through a reference that may point into one
fn throughHandle(x: &Item): bool {
    if x.viaHandle { return true }
    let r = x.root
    if r != nil && r.isRef {
        for i in 0..len(r.bind.roots) {
            if r.bind.roots[i] == handleSym { return true }
        }
    }
    return false
}

// the globals a change through x may free: a change through a handle may free anything
fn recordFreeChange(x: &Item) {
    if x.viaHandle {
        recordFree(handleSym)
        return
    }
    let r = x.root
    if r == nil { return }
    if r.isRef {
        for i in 0..len(r.bind.roots) { recordFree(r.bind.roots[i]) }
    } else {
        recordFree(r)
    }
}

// a change of an owned value that goes through a handle, or through a reference borrowed through
// one: it may free what references inside something point into
// a write through x, which is through a reference local that is not pointed afresh: see loopBindCheck
fn noteWrite(x: &Item) {
    let r = x.root
    if r != nil && r.isRefLocal && !r.fresh {
        useSeq += 1
        r.writeUse = useSeq
    }
}

fn invalidateOwnedChange(x: &Item) {
    invalidateChange(x)
    if throughHandle(x) { invalidateDeep(viaOf(x)) }
}

fn parseType(): ^Type

fn parseRefType(): ^Type {
    refMode = 0
    if sym == T_AMP {
        next()
        if sym == T_IDENT && sval == "mut" { error("there is one reference type, &T: write mut before the parameter name, as in mut p: &T") }
        let t = parseType()
        if !isOwned(t) { error("only records, closed types and arrays can be borrowed, not " + tname(t)) }
        refMode = 1
        return t
    }
    return parseType()
}

// an owned value that nothing owns yet must be stored, not just looked at
fn noTemp(x: &Item) {
    if x.mode == "reg" && isOwned(x.typ) {
        error("store this value in a variable first: otherwise it would never be freed")
    }
}

// ===================================================== register homes

// What the pre-scan of the function being compiled found (see scanFunction): the names that are declared in
// it, with their weighted uses, and the weighted calls it makes to the program's own functions.
var scanBytes = new []byte(0)     // the names, one after another
var scanAt = new []int(0)         // where each begins in scanBytes
var scanLen = new []int(0)
var scanScore = new []int(0)      // its weighted uses
var scanPend = new []bool(0)      // it may still be declared as an int or bool local
var scanCalls = 0
var homeCap = 0                   // how many registers the function may use for locals: fewer where it nests expressions deeply

// the name src[a..b) among the scanned ones, or -1
fn findScanned(a: int, b: int): int {
    let n = b - a
    for k in 0..len(scanAt) {
        if scanLen[k] == n {
            var j = 0
            while j < n && scanBytes[scanAt[k] + j] == src[a + j] { j += 1 }
            if j == n { return k }
        }
    }
    return -1
}

fn scannedName(name: string): int {
    let n = len(name)
    for k in 0..len(scanAt) {
        if scanLen[k] == n {
            var j = 0
            while j < n && scanBytes[scanAt[k] + j] == name[j] { j += 1 }
            if j == n { return k }
        }
    }
    return -1
}

fn netScore(k: int): int { return scanScore[k] - 2 * scanCalls }

// the register for the int or bool local `name`, which is about to be declared, or -1 for a stack slot. A
// name is given one when its weighted uses are worth it and a register is free, and when the names that
// do better and are yet to be declared in the function would still have one. declares is false for a
// second register of the same local (a for loop's limit).
fn pickHome(name: string, declares: bool): int {
    if REG_HOMES == 0 || curFn == nil || inDefer || homeRetry { return -1 }
    let k = scannedName(name)
    if k < 0 { return -1 }
    if declares { scanPend[k] = false }
    if netScore(k) < HOME_MIN { return -1 }
    var nfree = 0
    var pick = -1
    for i in 0..homeCap {
        let r = 15 - i
        if (homeBits & (1 << r)) == 0 && containsInt(free, r) {
            nfree += 1
            if pick < 0 { pick = r }
        }
    }
    if pick < 0 { return -1 }
    var better = 0
    for m in 0..len(scanPend) {
        if scanPend[m] && m != k && netScore(m) >= HOME_MIN {
            if netScore(m) > netScore(k) || (netScore(m) == netScore(k) && m < k) { better += 1 }
        }
    }
    if nfree <= better { return -1 }
    var j = 0
    while free[j] != pick { j += 1 }
    while j + 1 < len(free) {
        free[j] = free[j + 1]
        j += 1
    }
    truncate(free, len(free) - 1)
    homeBits = homeBits | (1 << pick)
    return pick
}

// the name is declared in the function being compiled, whatever its type: it no longer competes as a candidate yet to come
fn noteDeclared(name: string) {
    let k = scannedName(name)
    if k >= 0 { scanPend[k] = false }
}

fn releaseHome(r: int) {
    homeBits = homeBits & ~(1 << r)
    append(free, r)
}

// s, just made by newLocal, takes a register if pickHome gives it one: no stack slot then
fn homeFor(s: ^Sym, name: string, declares: bool) {
    let h = pickHome(name, declares)
    if h >= 0 {
        s.home = h
        s.offset = 0
        frame -= 8
    }
}

// where a local is: its register, or its slot
fn localItem(s: ^Sym, t: ^Type): Item {
    if s.home >= 0 {
        let x = newItem("reg", t)
        x.r = s.home
        x.home = true
        return x
    }
    let x = newItem("mem", t)
    x.base = RBP
    x.disp = s.offset
    return x
}

fn openBlock() {
    append(blocks, new Block{syms: new []^Sym(0), defers: new []int(0), nmark: len(narrowStack),
                             omark: len(ownedLocals), hmark: len(originSyms), frees: new []^FreeRec(0),
                             freeFrom: new []int(0), uses: new []^Sym(0), useBinds: new []^RefBind(0), useFrom: new []int(0)})
}

// whether a reference bound to e at a block's end points only where it was bound to d when its defer was
// declared: every root and place of e is covered by d's, and a reference that was writable then still is.
// The body was checked against d, so a narrower e is covered by those checks, and the frees replayed
// from the body (made for every root of d) reach every root of e. The parent is not part of the target.
fn withinDeclared(d: ^RefBind, e: ^RefBind): bool {
    if d == e || e == noneBind { return true }
    if d.writable && !e.writable { return false }
    for j in 0..len(e.roots) {
        var covered = false
        for i in 0..len(d.roots) {
            if d.roots[i] == e.roots[j] && coversPlace(d.deeps[i], d.paths[i], e.deeps[j], e.paths[j]) { covered = true }
        }
        if !covered { return false }
    }
    return true
}

// The reference locals that a deferred body uses were checked where the defer is declared, with the
// bindings and validity they had there. The body runs where the block is left, so each must be as it was:
// not pointed elsewhere, and not invalidated by a change since (or by a newer defer's frees, which have run).
fn checkDeferUses(bi: int, d: int) {
    var hi = len(blocks[bi].uses)
    if d + 1 < len(blocks[bi].useFrom) { hi = blocks[bi].useFrom[d + 1] }
    for k in blocks[bi].useFrom[d]..hi {
        let s = blocks[bi].uses[k]
        if !withinDeclared(blocks[bi].useBinds[k], s.bind) {
            error("cannot point '" + s.name + "' elsewhere while a defer uses it: the defer runs where its block is left, and would use the new target")
        }
        if s.moved {
            error("'" + s.name + "' is used by a defer but may point to freed memory at the block's end: something under what it points into was changed")
        }
        if s.suspect {
            notePending(tline, tcol, "'" + s.name + "' is used by a defer but may point to freed memory at the block's end: a recursive call writes through a handle")
        }
    }
}

// the frees of the deferred body d of blocks[bi], replayed where the block is left: the references they reach
// are moved (or carried) as at any other change, so a reference re-pointed inside the block is checked
fn replayFrees(bi: int, d: int) {
    var hi = len(blocks[bi].frees)
    if d + 1 < len(blocks[bi].freeFrom) { hi = blocks[bi].freeFrom[d + 1] }
    for k in blocks[bi].freeFrom[d]..hi {
        let r = blocks[bi].frees[k]
        // the change is replayed as it was made: through the same reference, so what it was derived from stays valid
        let rv = r.via
        if r.kind == 0 {
            let rt = r.root
            invalidate(rt, rv, r.all, r.path)
        } else if r.kind == 1 {
            invalidateDeep(rv)
        } else {
            markSuspects()
        }
    }
}

// calls the deferred statements of blocks[bi], newest first: each checks its uses against the state it
// runs in, and then its frees are applied, for the older ones to see
fn callDefers(bi: int) {
    var i = len(blocks[bi].defers) - 1
    while i >= 0 {
        checkDeferUses(bi, i)
        callLocal(blocks[bi].defers[i])
        replayFrees(bi, i)
        i -= 1
    }
}

fn closeBlock(terminated: bool) {
    let last = len(blocks) - 1
    let om = blocks[last].omark
    let nm = blocks[last].nmark
    if !terminated {
        callDefers(last)
        freeOwned(om, len(ownedLocals))
    }
    let scope = &blocks[last].syms
    for s in scope {
        if s.home >= 0 && !homeRetry { releaseHome(s.home) }
    }
    // the block's symbols are freed with it: the origin list keeps only the handles still in scope
    truncate(originSyms, blocks[last].hmark)
    truncate(blocks, last)
    truncate(ownedLocals, om)
    truncate(narrowStack, nm)
}

// leaving blocks early (return, break, continue): each block's defers run,
// then its live owned locals are freed, innermost first
fn runDefers(downTo: int) {
    var top = len(ownedLocals)
    var i = len(blocks) - 1
    while i >= downTo {
        callDefers(i)
        let om = blocks[i].omark
        freeOwned(om, top)
        top = om
        i -= 1
    }
}

fn newLocal(name: string, t: ^Type, kind: string): ^Sym {
    frame += 8
    let s = newSym(kind, name, t)
    s.storage = "local"
    s.offset = -frame
    if len(name) > 0 { return declare(s) }
    return s
}

fn varType(s: ^Sym): ^Type {
    var i = len(narrowStack) - 1
    while i >= 0 {
        let e = &narrowStack[i]
        if e.sym == s && e.alive { return e.typ }
        i -= 1
    }
    return symType(s)
}

fn pushNarrowings(lst: &?NPair) {
    if lst == nil { return }
    append(narrowStack, new NEntry{sym: lst.sym, typ: lst.typ, depth: loopdepth, alive: true})
    pushNarrowings(&lst.next)
}

fn widen(s: ^Sym) {
    let stack = &narrowStack
    for e in stack {
        if e.sym == s && e.alive {
            if e.depth != loopdepth {
                error("'" + s.name + "' may become nil here, but it was checked outside this loop; check it inside the loop instead")
            }
            e.alive = false
        }
    }
}

// =========================================================== type syntax

fn parseType(): ^Type {
    if sym == T_QUESTION {
        next()
        let b = parseType()
        if !nonNull(b) { error("only reference types can be optional, not " + tname(b)) }
        return newType("opt", "", b)
    }
    if sym == T_LBRACK {
        next()
        expect(T_RBRACK, "")
        return newType("array", "", parseType())
    }
    if sym == T_CARET {
        next()
        let b = parseType()
        if b.kind != "record" && b.kind != "closed" { error("handles name records and closed types, not " + tname(b)) }
        return newType("handle", "", b)
    }
    if sym == T_REF || sym == T_CLOSED { error("record and closed types must be declared with 'type'") }
    let name = ident()
    let s = lookup(name)
    if s.kind != "type" { error("'" + name + "' is not a type") }
    return symType(s)
}

fn fieldList(rec: ^Type) {
    expect(T_LBRACE, "")
    skipSemis()
    var offset = 0
    while sym != T_RBRACE {
        let names = new []string(0)
        append(names, ident())
        while sym == T_COMMA {
            next()
            append(names, ident())
        }
        expect(T_COLON, "")
        let t = parseType()
        for n in names {
            if fieldIndex(rec, n) >= 0 { error("duplicate field '" + n + "'") }
            append(rec.fields, new Field{name: n, offset: offset, typ: t})
            offset += 8
        }
        if sym != T_RBRACE { expect(T_SEMI, "';' or newline") }
        skipSemis()
    }
    expect(T_RBRACE, "")
    let ptrs = new []int(0)
    let strs = new []int(0)
    for i in 0..len(rec.fields) {
        let ft = rec.fields[i].typ
        let fo = rec.fields[i].offset
        if isOwned(ft) { append(ptrs, fo) }                      // the fields freed with the record
        if ft.kind == "string" { append(strs, fo) }              // and the strings it drops
    }
    rec.desc = descriptor(offset, ptrs, strs)
}

fn typeDecl() {
    let line = tline
    let name = ident()
    let prior = findSym(globals, name)
    var fwd: ?^Type = nil
    if prior != nil && prior.kind == "type" {
        let pt = symType(prior)
        if pt.incomplete { fwd = pt }
    }
    if sym != T_ASSIGN {
        let t = newType("record", name, nil)
        t.incomplete = true
        t.line = line
        declare(newSym("type", name, t))
        return
    }
    expect(T_ASSIGN, "")
    if fwd == nil && (sym == T_REF || sym == T_CLOSED) && prior != nil {
        error("'" + name + "' is already declared in this scope")
    }
    if sym == T_REF {
        next()
        expect(T_RECORD, "")
        var rec = newType("record", name, nil)
        if fwd != nil {
            rec = fwd
        } else {
            declare(newSym("type", name, rec))
        }
        fieldList(rec)
        rec.incomplete = false
    } else if sym == T_CLOSED {
        next()
        var ct = newType("closed", name, nil)
        if fwd != nil { ct = fwd }
        ct.kind = "closed"
        ct.incomplete = false
        if fwd == nil { declare(newSym("type", name, ct)) }
        expect(T_LBRACE, "")
        skipSemis()
        while sym != T_RBRACE {
            let vname = ident()
            let v = newType("record", vname, nil)
            v.parent = ct
            declare(newSym("type", vname, v))
            fieldList(v)
            append(ct.variants, v)
            skipSemis()
        }
        expect(T_RBRACE, "")
        if len(ct.variants) == 0 { error("a closed type needs at least one variant") }
    } else {
        if fwd != nil {
            error("'" + name + "' was declared as a forward type: define it as a ref record or closed type")
        }
        declare(newSym("type", name, parseType()))
    }
}

// A target located before a value that calls a function: the call could free what the
// target is in, so the value is computed first. xs is the target's variable, if it is one
// (a whole variable's place is fixed), r0 its root.
fn checkTargetAcrossCall(x: &Item, xs: ?^Sym, r0: ?^Sym, callsBefore: int, line: int, col: int) {
    if userCalls == callsBefore { return }
    if x.viaHandle {
        errorAt("cannot assign through a handle across a call: the call could free the object; compute the value first", line, col)
    }
    if x.deref && r0 != nil && r0.storage == "global" && isOwned(symType(r0)) {
        errorAt("cannot assign through global '" + r0.name + "' across a call: the call could free what it points into", line, col)
    }
    if xs == nil {
        // a field or element: the call could free the record or array it is in
        errorAt("cannot assign to a field or element across a call: the call could free what it is in; compute the value first", line, col)
    }
}

// An array operand whose array a call might free while it is held: one reached through a
// field, element, handle, global or reference. A whole local array is not held here: a by-value call
// that could free its header moves it, which heldLost sees where the array is held across a call (an
// index, append, truncate or replace). A mut argument cannot replace the header.
fn heldArray(x: &Item): bool {
    if x.viaHandle { return true }
    let r = x.root
    if r == nil { return false }
    return x.sym == nil || r.storage == "global" || r.isRef
}

// how many calls have moved the local s so far: a whole local array's header is freed only by
// a call that takes it by value, so an operand that holds the header must see this unchanged
fn touched(s: ?^Sym): int {
    if s == nil { return 0 }
    return s.touches
}

// the owned local whose move frees the array that a designator rooted at root holds: root itself,
// or for a reference, the local it borrows from. Nil through a handle (no local owns that object),
// and for a reference parameter, whose owner is in the caller.
// A reference may borrow from several owners on different paths (its binding's roots), so the touches of
// all of them are summed: a sum only grows, so a change of it is a move of one of them.
fn ownerTouch(root: ?^Sym): int {
    if root == nil { return 0 }
    let r = root
    if !r.isRef { return touched(r) }
    if !r.isRefLocal { return 0 }
    var t = 0
    let b = r.bind
    for i in 0..len(b.roots) {
        let o = b.roots[i]
        if o != handleSym && !o.isRef { t += touched(o) }
    }
    return t
}

// snapshot taken before a value or index runs while the array under root is held
fn heldTouch(root: ?^Sym): int { return ownerTouch(root) }

// the array held under root may have been freed while a value or index ran: its owner was moved (a
// by-value call takes the whole object, and nothing in a call's argument list is counted by pureFn),
// or root is a reference that a move or a change invalidated. Compare with heldTouch taken before.
fn heldLost(root: ?^Sym, t0: int): bool {
    if root == nil { return false }
    if root.isRefLocal && root.moved { return true }
    return ownerTouch(root) != t0
}

// The places a statement holds while an index or a value runs. heldPush records them, keyed by what
// each is in: an owned local (its owner), a handle made from a whole owned local by a let (its origin:
// the places a handle names are that local's places), or an identity, a handle variable or a
// reference parameter, whose places are compared by path only among themselves. A reference local is
// held once per root of its binding (a reference after a join may point into several), at the binding's
// path in that root. A place with no identity (a handle of unknown origin, or a root that is a handle)
// is hit by any free. heldHitAt and heldPop take the mark heldPush returns: the entries from it on.
var heldKey = new []?^Sym(0)
var heldPath = new []string(0)
var heldForeign = new []bool(0)
var heldHit = new []bool(0)
var heldStore = new []bool(0)
var heldWhole = new []bool(0)
// the path inside the designator's root, and the identity or origin of the designator that
// designatorT returned last; replace, take and the assignments read them straight after parsing their
// designator
var lastPlace = ""
var lastRaw = ""
var lastOrigin: ?^Sym = nil
var lastIdent: ?^Sym = nil
var lastViaHandle = false

// the place a designator names inside its root: the path as written. A reference's binding adds its own
// path per root, in heldPush and freeEvent
fn placePath(root: ?^Sym, path: string): string { return path }

// adds one held entry; heldPush and heldPushStore are the only callers
fn heldAdd(key: ?^Sym, foreign: bool, whole: bool, at: string) {
    append(heldKey, key)
    append(heldPath, at)
    append(heldForeign, foreign)
    append(heldHit, false)
    append(heldStore, false)
    append(heldWhole, whole)
}

// holds the places of a designator: origin, when the handle is a let of a whole owned local; ident, the
// handle variable or the reference parameter; raw, the path as written. Returns the mark: the entries from
// it on are the ones pushed (none when root is nil and there is no handle)
fn heldPush(root: ?^Sym, viaHandle: bool, origin: ?^Sym, ident: ?^Sym, place: string, raw: string): int {
    let mark = len(heldKey)
    if viaHandle {
        if origin != nil {
            heldAdd(origin, false, false, raw)
        } else {
            heldAdd(ident, true, false, raw)
        }
        return mark
    }
    if root == nil { return mark }
    let r = root
    if isRefParam(r) {
        heldAdd(r, true, false, raw)
        return mark
    }
    if r.isRefLocal {
        let b = r.bind
        for i in 0..len(b.roots) {
            let o = b.roots[i]
            let p = b.paths[i] + raw
            if o == handleSym {
                heldAdd(nil, true, false, "")
            } else if o.isRef {
                heldAdd(o, true, false, p)
            } else {
                heldAdd(o, false, false, p)
            }
        }
        return mark
    }
    heldAdd(r, false, raw == "", raw)
    return mark
}

// heldPush for an assignment's target: its own place is exempt from a free of exactly that place
// (take leaves the place nil, and the store then writes a valid place; replace installs the value
// the store frees). A free of an ancestor still hits
fn heldPushStore(root: ?^Sym, viaHandle: bool, origin: ?^Sym, ident: ?^Sym, place: string, raw: string): int {
    let mark = heldPush(root, viaHandle, origin, ident, place, raw)
    for k in mark..len(heldKey) { heldStore[k] = true }
    return mark
}

// a held identity that is a reference parameter: its object lies in a caller, so a local this function
// declared (a fresh object, or one taken out of a caller's record) cannot be it
fn refParamKey(k: ?^Sym): bool {
    if k == nil { return false }
    let r = k
    return isRefParam(r)
}

// a local this function declared: not a by-value parameter (whose object a caller may name through a
// reference) and not a global (which a reference parameter may name). No reference parameter names
// the object of such a local, so a move or free of it does not reach a reference parameter's place
fn calleeLocal(o: ?^Sym): bool {
    if o == nil { return false }
    let r = o
    return r.storage == "local" && !r.isParam
}

// the owned local s is moved: a held place inside s, and every place that is not owned, may be freed
fn heldMove(s: ^Sym) {
    for i in 0..len(heldKey) {
        if heldKey[i] == s {
            heldHit[i] = true
        } else if heldForeign[i] {
            if s.isParam || !refParamKey(heldKey[i]) { heldHit[i] = true }
        }
    }
}

// a free of a place, by the owned object o (its root's owner), or through the identity i (a handle
// variable or reference parameter), or of unknown identity (both nil). An identity entry is hit only
// by a free of the same identity at or below its path; any other free may reach it. An owned entry is
// hit by a free of its own object at or above its path, and by a free that is not owned, unless it is
// a whole local array: no handle or reference parameter names an array's header, only a record's
// field or an element's contents
fn heldFree(o: ?^Sym, i: ?^Sym, place: string) {
    for k in 0..len(heldKey) {
        if heldForeign[k] {
            if i != nil && heldKey[k] == i {
                if segsPrefix(place, heldPath[k]) && !(heldStore[k] && place == heldPath[k]) { heldHit[k] = true }
            } else if !(calleeLocal(o) && refParamKey(heldKey[k])) {
                heldHit[k] = true
            }
        } else if o != nil {
            if heldKey[k] == o && segsPrefix(place, heldPath[k]) && !(heldStore[k] && place == heldPath[k]) {
                heldHit[k] = true
            }
        } else if !heldWhole[k] {
            heldHit[k] = true
        }
    }
}

// the old value of the designator x that a replace or take frees, with its path as written, origin and
// identity (see lastRaw). A reference frees in each root of its binding, at the binding's path there
fn freeEvent(x: &Item, place: string, raw: string, origin: ?^Sym, ident: ?^Sym) {
    if x.viaHandle {
        if origin != nil {
            heldFree(origin, nil, raw)
        } else {
            heldFree(nil, ident, raw)
        }
        return
    }
    let root = x.root
    if root == nil { return }
    let r = root
    if isRefParam(r) {
        heldFree(nil, r, raw)
        return
    }
    if r.isRefLocal {
        let b = r.bind
        for i in 0..len(b.roots) {
            let o = b.roots[i]
            let p = b.paths[i] + raw
            if o == handleSym {
                heldFree(nil, nil, "")
            } else if o.isRef {
                heldFree(nil, o, p)
            } else {
                heldFree(o, nil, p)
            }
        }
        return
    }
    heldFree(r, nil, raw)
}

// the owned local a let handle may name as a whole: nil unless s is a plain owned local
fn wholeOwnerOf(s: ?^Sym): ?^Sym {
    if s == nil { return nil }
    let r = s
    if r.owned && !r.isRef && r.storage == "local" { return r }
    return nil
}

// a whole move of the owned local s (move) or an assignment over it: the let handles made from s are no
// longer keyed to it, so each falls back to the identity treatment (every move or free hits it). A move
// inside a loop that a handle declared outside the loop was made from is refused, since the next
// iteration would still see the handle's origin (a handle declared inside the loop is fresh each time)
fn originMove(s: ?^Sym, move: bool) {
    if s == nil { return }
    let r = s
    if !r.owned || r.isRef || r.storage != "local" { return }
    if move { loopOriginCheck(r) }
    for i in 0..len(originSyms) {
        let x = originSyms[i]
        if x.hOrigin != nil {
            let o = x.hOrigin
            if o == r { x.hOrigin = nil }
        }
    }
}

fn loopOriginCheck(s: ^Sym) {
    for i in 0..len(originSyms) {
        let x = originSyms[i]
        if x.hOrigin != nil && x.hDepth < len(loops) {
            let o = x.hOrigin
            if o == s { error("cannot move '" + s.name + "' inside a loop while handle '" + x.name + "' made from it is in scope") }
        }
    }
}

// a held place from mark on was freed or moved while the expression ran
fn heldHitAt(mark: int): bool {
    if mark < 0 { return false }
    for i in mark..len(heldKey) {
        if heldHit[i] { return true }
    }
    return false
}

// drops the held places from mark on
fn heldPop(mark: int) {
    if mark < 0 { return }
    truncate(heldKey, mark)
    truncate(heldPath, mark)
    truncate(heldForeign, mark)
    truncate(heldHit, mark)
    truncate(heldStore, mark)
    truncate(heldWhole, mark)
}

fn checkAssign(dst: ^Type, x: &Item, what: string) {
    if x.typ == tVoid { error(what + ": expression has no value") }
    if dst.kind == "byte" && x.mode == "const" && x.typ.kind == "int" && x.val >= 0 && x.val <= 255 { return }
    if !assignable(dst, x.typ) {
        var hint = ""
        if x.typ.kind == "nil" && nonNull(dst) {
            hint = " (" + tname(dst) + " can never be nil; declare it as ?" + tname(dst) + ")"
        } else if dst.kind != "opt" && x.typ.kind == "opt" {
            hint = " (it may be nil: check it with '!= nil' first)"
        }
        error(what + ": cannot use " + tname(x.typ) + " as " + tname(dst) + hint)
    }
}

// ============================================================ expressions

fn expression(): Item
fn designator(): Item

fn callFn(f: ^Sym): Item {
    let saved = saveRegs()
    let n = len(f.params)
    let pad = (depth + 8 * n) % 16
    if pad != 0 {
        aluRI(5, RSP, 8)
        depth += 8
    }
    expect(T_LPAREN, "")
    var argBinds = new []^RefBind(0)
    let argModes = new []int(0)
    let argVias = new []?^Sym(0)
    let argPaths = new []string(0)
    var deepLine = 0                   // the first argument that points inside something
    var deepCol = 0
    for i in 0..n {
        if sym == T_RPAREN { error(f.name + " takes " + string(n) + " argument(s), not " + string(i)) }
        if i > 0 { expect(T_COMMA, "") }
        let argLine = tline
        let argCol = tcol
        let a = expression()
        checkAssign(f.params[i], a, "argument " + string(i + 1) + " of " + f.name)
        if f.pmodes[i] > 0 {
            let b = borrowBind(a)
            if f.pmodes[i] == 2 && !b.writable {
                error("argument " + string(i + 1) + " of " + f.name + " needs a mut reference, but this one is read-only")
            }
            // a mut argument writes through the reference it is passed by
            if f.pmodes[i] == 2 { noteWrite(a) }
            append(argBinds, b)
            append(argModes, f.pmodes[i])
            append(argVias, viaOf(a))
            if anyDeep(b) && deepLine == 0 {
                deepLine = argLine
                deepCol = argCol
            }
            append(argPaths, a.path)
        } else {
            consume(a)
        }
        if a.mode == "const" && fits32(a.val) {
            pushI(a.val)                           // no register needed
            depth += 8
            drop(a)
        } else {
            let r = asReg(a)
            pushR(r.r)
            release(r.r)
        }
    }
    if sym != T_RPAREN { error(f.name + " takes " + string(n) + " argument(s), not more") }
    expect(T_RPAREN, "")
    // a reference inside something may not go to a callee that writes through a handle, since the
    // handle may name what it is inside. A callee with only a forward heading is assumed to write.
    if deepLine > 0 {
        if f == curFn {
            notePending(deepLine, deepCol, "cannot pass a reference that points inside something to " + f.name + ": it writes through a handle, which could free it")
        } else if f.addr < 0 {
            errorAt("cannot pass a reference that points inside something to " + f.name + ": its body is not known yet, so it is assumed to write through a handle, which could free it", deepLine, deepCol)
        } else if f.writesHandles {
            errorAt("cannot pass a reference that points inside something to " + f.name + ": it writes through a handle, which could free it", deepLine, deepCol)
        }
    }
    // a mut reference and another that may point inside it could let the callee
    // free what the other points to; references to one object are fine
    for i in 0..len(argBinds) {
        for j in 0..len(argBinds) {
            let bi = argBinds[i]
            let bj = argBinds[j]
            if i != j && argModes[i] == 2 {
                for p in 0..len(bi.roots) {
                    for q in 0..len(bj.roots) {
                        let ri = bi.roots[p]
                        let rj = bj.roots[q]
                        // two places in one root may be told apart: elements known to differ
                        if bj.deeps[q] && reaches(ri, rj) && (ri != rj || pathsOverlap(bi.paths[p], bj.paths[q])) {
                            error("argument " + string(j + 1) + " of " + f.name + " may point inside argument " + string(i + 1) + ", which is mut")
                        }
                    }
                }
            }
        }
    }
    for i in 0..len(argBinds) {
        let b = argBinds[i]
        for p in 0..len(b.roots) {
            let ar = b.roots[p]
            if ar.storage == "global" && mightFree(f, ar) {
                error("cannot pass a reference into global '" + ar.name + "' to " + f.name + ": it might free it")
            }
        }
    }
    for i in 0..len(argBinds) {
        let b = argBinds[i]
        for p in 0..len(b.roots) {
            if b.roots[p] == handleSym && !pureFn(f) {
                error("cannot pass a reference that borrows through a handle to " + f.name + ": it might free what the handle names")
            }
        }
    }
    for i in 0..len(argBinds) {
        if argModes[i] == 2 {
            let b = argBinds[i]
            for p in 0..len(b.roots) {
                invalidate(b.roots[p], argVias[i], false, argPaths[i])
                recordFree(b.roots[p])
            }
        }
    }
    afterCall(f)
    if !pureFn(f) { userCalls += 1 }              // only calls that might free count
    emit(0xE8)
    emit32(0)
    let at = pc() - 4
    if f.addr >= 0 {
        fix(at, f.addr)
        append(farCalls, at)
    } else {
        append(f.fixups, at)
        fwdCalls += 1
    }
    if n > 0 || pad != 0 {
        aluRI(0, RSP, 8 * n + pad)
        depth -= 8 * n + pad
    }
    restoreRegs(saved)
    if f.ret == tVoid { return voidItem() }
    let r = alloc()
    movRR(r, RAX)
    let res = makeReg(f.ret, r)
    res.strTemp = f.ret == tString               // the caller now holds the returned reference
    return res
}

fn describe(x: &Item): string {
    let s = x.sym
    if s != nil { return s.name }
    return "value"
}

fn conversion(t: ^Type): Item {
    expect(T_LPAREN, "")
    let a = expression()
    expect(T_RPAREN, "")
    if t == tString {
        // string(n) gives the decimal digits of an int; string(bytes) copies a []byte
        if a.typ.kind == "int" {
            if a.mode == "const" { return makeConst(tString, stringLit(string(a.val))) }
            return rtCall1(RT_INT_TO_STR, a, tString)
        }
        if a.typ.kind == "byte" {
            error("string() of a byte is ambiguous: use string(int(b)) for its number, or a []byte for the character")
        }
        if a.typ.kind != "array" || baseOf(a.typ).kind != "byte" {
            error("string() needs an int or a []byte, not " + tname(a.typ))
        }
        noTemp(a)
        return rtCall1(RT_BYTES_TO_STRING, a, tString)
    }
    if !isInt(a.typ) { error(tname(t) + "() needs an int or byte, not " + tname(a.typ)) }
    if a.mode == "const" {
        if t == tByte { return makeConst(t, a.val & 255) }
        return makeConst(t, a.val)
    }
    let x = load(a)
    if t == tByte && x.typ.kind != "byte" { aluRI(4, x.r, 255) }
    x.typ = t
    return x
}

fn builtin(name: string): Item {
    if name == "print" || name == "println" || name == "eprint" || name == "eprintln" {
        let toStderr = name[0] == 'e'
        if toStderr { rtCall1(RT_SET_OUTPUT, makeConst(tInt, 2), tVoid) }
        expect(T_LPAREN, "")
        var first = true
        while sym != T_RPAREN {
            if !first { expect(T_COMMA, "") }
            first = false
            let a = expression()
            let k = a.typ.kind
            var slot = -1
            if k == "int" || k == "byte" {
                slot = RT_PRINT_INT
            } else if k == "bool" {
                slot = RT_PRINT_BOOL
            } else if k == "string" {
                slot = RT_PRINT_STR
            }
            if slot < 0 { error("cannot print " + tname(a.typ)) }
            rtCall1(slot, a, tVoid)
        }
        expect(T_RPAREN, "")
        if name == "println" || name == "eprintln" { rtCall0(RT_NEWLINE, tVoid) }
        if toStderr { rtCall1(RT_SET_OUTPUT, makeConst(tInt, 1), tVoid) }
        return voidItem()
    }
    if name == "args" {
        expect(T_LPAREN, "")
        expect(T_RPAREN, "")
        return rtCall0(RT_ARGS, newType("array", "", tString))
    }
    if name == "readFile" || name == "writeFile" {
        expect(T_LPAREN, "")
        var p = expression()
        if p.typ.kind != "string" { error(name + " needs a string path, not " + tname(p.typ)) }
        if name == "readFile" {
            expect(T_RPAREN, "")
            return rtCall1(RT_READ_FILE, p, newType("opt", "", newType("array", "", tByte)))
        }
        p = pinStr(p)
        expect(T_COMMA, "")
        var d = expression()
        if d.typ.kind != "array" || baseOf(d.typ).kind != "byte" {
            error("writeFile needs a []byte, not " + tname(d.typ))
        }
        noTemp(d)
        d = materialise(d)
        expect(T_COMMA, "")
        let e = expression()
        if e.typ.kind != "bool" { error("writeFile needs a bool saying whether the file is executable") }
        expect(T_RPAREN, "")
        let args3 = new []?Item(0)
        append(args3, p)
        append(args3, d)
        append(args3, e)
        return rtCall(RT_WRITE_FILE, args3, tBool)
    }
    if name == "handle" {
        // a handle to an object: copyable, storable, checked on every use
        expect(T_LPAREN, "")
        if sym != T_IDENT { error("handle needs a variable, field or element") }
        let x = designator()
        expect(T_RPAREN, "")
        if (x.mode != "mem" && x.mode != "elem") || (x.typ.kind != "record" && x.typ.kind != "closed") {
            error("handle needs a record or closed-type value that is not optional, not " + tname(x.typ))
        }
        let ht = newType("handle", "", x.typ)
        var origin: ?^Sym = nil
        if !x.viaHandle && lastRaw == "" { origin = wholeOwnerOf(x.sym) }
        let made = rtCall1(RT_HANDLE, x, ht)
        made.hOrigin = origin
        return made
    }
    if name == "replace" {
        // stores a new value in a variable, field or element and hands back the old one
        expect(T_LPAREN, "")
        if sym != T_IDENT { error("replace needs a variable, field or element") }
        var x = designator()
        let place = lastPlace
        let raw = lastRaw
        let orig = lastOrigin
        let ident = lastIdent
        if (x.mode != "mem" && x.mode != "elem") || !isOwned(x.typ) {
            error("replace needs a variable, field or element holding an owned value")
        }
        if x.readonly { error("replace cannot change '" + describe(x) + "': it is immutable") }
        if raw == "" && !x.viaHandle && !x.deref { originMove(x.sym, true) }
        let tr = x.root
        if x.deref && tr != nil && tr.isRef && !tr.bind.writable {
            error("replace cannot change through '" + tr.name + "': it is a read-only reference")
        }
        expect(T_COMMA, "")
        let callsBefore = userCalls
        let savedPin = pinned
        let touch0 = heldTouch(tr)
        if x.deref && tr != nil && tr.storage == "local" { pinned = tr }
        let hp = heldPush(tr, x.viaHandle, orig, ident, place, raw)
        var v = expression()
        pinned = savedPin
        expect(T_RPAREN, "")
        if (x.viaHandle || x.sym == nil) && userCalls != callsBefore {
            error("replace through a handle, a field or an element cannot have a value that calls a function that might free; compute the value first")
        }
        if tr != nil && heldLost(tr, touch0) {
            error("cannot replace '" + tr.name + "' with a value that moves it: the call could free the array it gives back; compute the value first")
        }
        if heldHitAt(hp) {
            error("cannot replace a place with a value that moves or frees what it holds: the old value could be freed; compute the value first")
        }
        heldPop(hp)
        checkAssign(x.typ, v, "replacement value")
        consume(v)
        freeEvent(x, place, raw, orig, ident)
        if x.deref || x.viaHandle {
            invalidateOwnedChange(x)
            recordFreeChange(x)
        } else {
            let ts = x.sym
            if ts != nil {
                invalidate(ts, nil, true, "")
                recordFree(ts)
            }
        }
        resolve(x)
        let r = alloc()
        opMem(0x8B, r, memOf(x), true, false)
        let xt = x.typ
        store(x, v)
        return makeReg(xt, r)
    }
    if name == "drop" {
        // frees an owned local now and marks it moved, so that every path can agree
        expect(T_LPAREN, "")
        if sym != T_IDENT { error("drop needs a local variable") }
        let x = designator()
        expect(T_RPAREN, "")
        let ds = x.sym
        if x.mode != "mem" || ds == nil || ds.storage != "local" || !ds.owned {
            error("drop needs a local variable holding an owned value")
            return voidItem()
        }
        let dx = newItem("mem", symType(ds))
        dx.base = RBP
        dx.disp = ds.offset
        consume(x)
        rtCall1(RT_FREE, dx, tVoid)
        return voidItem()
    }
    if name == "alive" {
        expect(T_LPAREN, "")
        let h = expression()
        expect(T_RPAREN, "")
        if h.typ.kind != "handle" { error("alive needs a handle, not " + tname(h.typ)) }
        return rtCall1(RT_ALIVE, h, tBool)
    }
    if name == "take" {
        // takes the value out of an optional variable, field or element, leaving nil
        expect(T_LPAREN, "")
        if sym != T_IDENT { error("take needs a variable, field or element") }
        let x = designator()
        expect(T_RPAREN, "")
        if (x.mode != "mem" && x.mode != "elem") || x.typ.kind != "opt" || !isOwned(x.typ) {
            error("take needs an optional variable, field or element holding an owned value")
        }
        if x.readonly { error("take cannot change '" + describe(x) + "': it is immutable") }
        let tr = x.root
        if x.deref && tr != nil && tr.isRef && !tr.bind.writable {
            error("take cannot change through '" + tr.name + "': it is a read-only reference")
        }
        freeEvent(x, lastPlace, lastRaw, lastOrigin, lastIdent)
        if lastRaw == "" && !x.viaHandle && !x.deref { originMove(x.sym, true) }
        if x.deref || x.viaHandle {
            invalidateOwnedChange(x)
            recordFreeChange(x)
        } else {
            let ts = x.sym
            if ts != nil && ts.storage == "local" { invalidate(ts, nil, true, "") }
            if ts != nil && ts.storage == "global" {
                invalidate(ts, nil, true, "")
                recordFree(ts)
            }
        }
        resolve(x)
        let r = alloc()
        opMem(0x8B, r, memOf(x), true, false)
        opMem(0xC7, 0, memOf(x), true, false)
        emit32(0)
        releaseItem(x)
        return makeReg(x.typ, r)
    }
    if name == "append" || name == "truncate" || name == "substr" {
        let line = tline
        expect(T_LPAREN, "")
        var a = expression()
        let aPlace = lastPlace
        let aRaw = lastRaw
        let aOrig = lastOrigin
        let aIdent = lastIdent
        let aVia = lastViaHandle
        var want = "array"
        var article = "an"
        if name == "substr" {
            want = "string"
            article = "a"
        }
        if a.typ.kind != want { error(name + " needs " + article + " " + want + ", not " + tname(a.typ)) }
        noTemp(a)
        // a write through a reference: the root is read here, before pinStr loads the array into a register
        if name == "append" || name == "truncate" { noteWrite(a) }
        if name != "substr" {
            let ar = a.root
            if ar != nil && ar.isRef && !ar.bind.writable {
                error(name + " changes the array, but '" + ar.name + "' is a read-only reference")
            }
            if name == "truncate" {
                let owned = isOwned(baseOf(a.typ))
                if owned { invalidateOwnedChange(a) } else { invalidateChange(a) }
                if owned || !throughHandle(a) { recordFreeChange(a) }   // a scalar array frees nothing
            }
        }
        // the array is located before the value or count runs: a call there could free it
        let held = heldArray(a)
        let aDeref = a.deref
        let r0 = a.root
        a = pinStr(a)
        expect(T_COMMA, "")
        let callsBefore = userCalls
        let touch0 = heldTouch(r0)
        let savedPin = pinned
        if name != "substr" && aDeref && r0 != nil && r0.storage == "local" { pinned = r0 }
        let hp = heldPush(r0, aVia, aOrig, aIdent, aPlace, aRaw)
        var b = expression()
        pinned = savedPin
        if name != "substr" && held && userCalls != callsBefore {
            if name == "append" {
                errorAt("cannot append to a field, element, handle or global across a call: the call could free the array it is in; compute the value first", line, 0)
            }
            errorAt("cannot truncate a field, element, handle or global across a call: the call could free the array it is in; compute the value first", line, 0)
        }
        if name != "substr" && r0 != nil && heldLost(r0, touch0) {
            if name == "append" {
                errorAt("cannot append to '" + r0.name + "' with a value that moves it: the call could free the array it is in; compute the value first", line, 0)
            }
            errorAt("cannot truncate '" + r0.name + "' with a count that moves it: the call could free the array it is in; compute the count first", line, 0)
        }
        if heldHitAt(hp) {
            errorAt("cannot " + name + " an array with a value or count that replaces or moves what it holds: the old value could be freed; compute the value first", line, 0)
        }
        heldPop(hp)
        if name == "append" {
            checkAssign(baseOf(a.typ), b, "appended value")
            consume(b)
            expect(T_RPAREN, "")
            rtCall2(RT_APPEND, a, b, tVoid)
            return voidItem()
        }
        if !isInt(b.typ) { error(name + " needs int positions") }
        if name == "truncate" {
            expect(T_RPAREN, "")
            let at = new []?Item(0)
            append(at, a)
            append(at, b)
            append(at, makeConst(tInt, line))
            rtCall(RT_TRUNCATE, at, tVoid)
            return voidItem()
        }
        b = materialise(b)
        expect(T_COMMA, "")
        let c = expression()
        if !isInt(c.typ) { error(name + " needs int positions") }
        expect(T_RPAREN, "")
        let as = new []?Item(0)
        append(as, a)
        append(as, b)
        append(as, c)
        append(as, makeConst(tInt, line))
        return rtCall(RT_SUBSTR, as, tString)
    }
    if name == "gc" || name == "gcstats" {
        expect(T_LPAREN, "")
        expect(T_RPAREN, "")
        if name == "gc" {
            rtCall0(RT_COLLECT, tVoid)
        } else {
            rtCall0(RT_GC_STATS, tVoid)
        }
        return voidItem()
    }
    expect(T_LPAREN, "")
    let a = expression()
    expect(T_RPAREN, "")
    if name == "exit" {
        if a.typ.kind != "int" { error("exit needs an int") }
        rtCall1(RT_EXIT, a, tVoid)
        noreturn = true
        return voidItem()
    }
    if a.typ.kind == "string" {
        if a.mode == "const" { return makeConst(tInt, len(rodataString(a.val))) }
        if a.strTemp {
            let p = load(a)
            let n = alloc()
            movRR(n, p.r)
            opReg(0x85, n, n, true, false)
            emit(0x74)
            emit(0)
            let at0 = pc()
            opMem(0x8B, n, mem(n, -1, 0, 8), true, false)
            code[at0 - 1] = byte(pc() - at0)
            rtCall1(RT_STR_DEC, p, tVoid)
            return makeReg(tInt, n)
        }
        let x = load(a)
        opReg(0x85, x.r, x.r, true, false)
        emit(0x74)
        emit(0)
        let at = pc()
        opMem(0x8B, x.r, mem(x.r, -1, 0, 8), true, false)
        code[at - 1] = byte(pc() - at)
        return makeReg(tInt, x.r)
    }
    if a.typ.kind != "array" { error("len needs a string or array, not " + tname(a.typ)) }
    noTemp(a)
    let x = load(a)
    opMem(0x8B, x.r, mem(x.r, -1, 0, 8), true, false)
    return makeReg(tInt, x.r)
}

fn designatorT(target: bool): Item

fn designator(): Item { return designatorT(false) }

// target: the designator is the left side of an assignment, where a moved
// local may be given a new value
// the item a name stands for: a builtin, a call, a constant, a variable or a conversion
fn nameItem(s: ^Sym, name: string, target: bool): Item {
    if s.kind == "builtin" { return builtin(name) }
    if s.kind == "fn" {
        if sym != T_LPAREN { error("functions can only be called") }
        return callFn(s)
    }
    if s.kind == "const" { return makeConst(symType(s), s.value) }
    if s.kind == "var" || s.kind == "let" {
        var x = newItem("mem", symType(s))
        if s.home >= 0 {
            x = newItem("reg", symType(s))        // held in a register of its own: see REG_HOMES
            x.r = s.home
            x.home = true
        } else if s.storage == "local" {
            x.typ = varType(s)
            x.base = RBP
        }
        x.disp = s.offset
        x.sym = s
        x.root = s
        x.hOrigin = s.hOrigin
        x.readonly = s.kind == "let"
        x.borrowed = s.isRef
        if (s.owned || s.isRefLocal) && s.moved {
            if target {
                x.movedRef = true
            } else if s.isRefLocal {
                error(freedRefMsg(name))
            } else {
                error("'" + name + "' was moved and has no value here")
            }
        }
        if inDefer && s.owned { s.deferUse = true }
        if inDefer && s.isRefLocal { noteDeferUse(s) }
        return x
    }
    if s.kind == "type" && sym == T_LPAREN && (symType(s) == tInt || symType(s) == tByte || symType(s) == tString) {
        return conversion(symType(s))
    }
    error("'" + name + "' is a type, not a value (use 'new " + name + "{...}' to make one)")
    return voidItem()
}

fn designatorT(target: bool): Item {
    let uline = tline
    let ucol = tcol
    let name = ident()
    let s = lookup(name)
    var x = nameItem(s, name, target)
    if sym == T_LPAREN && (s.kind == "var" || s.kind == "let" || s.kind == "const") {
        error("'" + name + "' is not a function")
    }
    let root = x.root
    var viaHandle = false
    var path = ""
    var hOrig: ?^Sym = nil
    var hIdent: ?^Sym = nil
    var handles = 0
    while sym == T_DOT || sym == T_LBRACK {
        if x.movedRef {
            if s.isRefLocal { error(freedRefMsg(name)) }
            error("'" + name + "' was moved and has no value here")
        }
        if x.mode == "reg" && isOwned(x.typ) {
            error("store this value in a variable first: otherwise it would never be freed")
        }
        if x.typ.kind == "opt" { error("'" + describe(x) + "' may be nil: check it with '!= nil' first") }
        if sym == T_DOT && x.typ.kind == "handle" {
            // check the handle now: the object must still be the one it named
            let hb = baseOf(x.typ)
            if handles == 0 {
                hOrig = x.hOrigin
                hIdent = x.sym
            } else {
                hOrig = nil
                hIdent = nil
            }
            handles += 1
            x = rtCall1(RT_DEREF, x, hb)
            viaHandle = true
        }
        if sym == T_DOT {
            next()
            let fname = ident()
            if x.typ.incomplete { error(tname(x.typ) + " is declared but not yet defined") }
            if x.typ.kind == "closed" { error(tname(x.typ) + " is a closed type: use 'match' to reach its fields") }
            if x.typ.kind != "record" { error(tname(x.typ) + " has no fields") }
            let rt0 = x.typ
            let fi = fieldIndex(rt0, fname)
            if fi < 0 {
                error(tname(rt0) + " has no field '" + fname + "'")
                return x
            }
            let fty = rt0.fields[fi].typ
            let foff = rt0.fields[fi].offset
            let p = load(x)
            x = newItem("mem", fty)
            x.base = p.r
            x.disp = foff
            path = path + "/" + fname
        } else {
            next()
            let line = tline
            let kind = x.typ.kind
            if x.strTemp { error("store this string in a variable first") }
            let callsBefore = userCalls
            if kind != "array" && kind != "string" { error(tname(x.typ) + " cannot be indexed") }
            let elem = baseOf(x.typ)
            // the array's address is loaded before the index runs: a call there could free it. A
            // by-value call moves the owner of the root (any array in it, at any depth), which
            // heldLost sees; a call that only borrows, or takes a mut argument, cannot free it.
            let wholeLocal = x.sym != nil && !(root != nil && (root.storage == "global" || root.isRef))
            let touch0 = heldTouch(root)
            let a = load(x)
            let hp = heldPush(root, viaHandle, hOrig, hIdent, placePath(root, path), path)
            let i0 = expression()
            if !isInt(i0.typ) { error("array index must be int") }
            if viaHandle && userCalls != callsBefore {
                error("cannot index through a handle with an index that calls a function: the call could free the object")
            }
            if root != nil && root.storage == "global" && userCalls != callsBefore {
                error("cannot index through global '" + root.name + "' with an index that calls a function: the call could free it")
            }
            if !wholeLocal && userCalls != callsBefore {
                error("cannot index a field, element or reference with an index that calls a function: the call could free the array it is in; compute the index first")
            }
            if root != nil && heldLost(root, touch0) {
                error("cannot index '" + root.name + "' with an index that moves it: the call could free its array; compute the index first")
            }
            if viaHandle && heldHitAt(hp) {
                error("cannot index through a handle with an index that moves or frees something: the object it names could be freed; compute the index first")
            }
            if root != nil && heldHitAt(hp) {
                error("cannot index '" + root.name + "' with an index that replaces or moves what it holds: the old value could be freed; compute the index first")
            }
            heldPop(hp)
            var seg = "/[]"
            if i0.mode == "const" { seg = "/[" + string(i0.val) + "]" }
            let i = asReg(i0)
            expect(T_RBRACK, "")
            if kind == "string" {
                opReg(0x85, a.r, a.r, true, false)
                emit(0x75)
                emit(14)
                trapBounds(line)
                boundsCheck(i.r, mem(a.r, -1, 0, 8), line)
                x = newItem("mem", tByte)
                x.base = a.r
                x.index = i.r
                x.disp = 8
                x.scale = 1
                x.width = 1
                x.readonly = true
            } else {
                x = newItem("elem", elem)
                x.base = a.r
                x.index = i.r
                x.line = line
                if elem.kind == "byte" { x.width = 1 }
            }
            path = path + seg
        }
    }
    // a use of a suspect reference (not just pointing it elsewhere): see afterCall
    if s.suspect && (!target || path != "") {
        notePending(uline, ucol, "'" + name + "' may point to freed memory: a recursive call writes through a handle, which could free what it points into")
    }
    if s.isRefLocal && (!target || path != "") {        // a read, not a re-pointing: see loopBindCheck
        useSeq += 1
        s.usedAt = useSeq
        if !s.fresh {
            s.staleUse = useSeq
            s.staleLine = uline
            s.staleCol = ucol
            if s.carryFreed { s.freedUse = useSeq }
        }
    }
    x.viaHandle = viaHandle
    lastPlace = placePath(root, path)
    lastRaw = path
    lastOrigin = hOrig
    lastIdent = hIdent
    lastViaHandle = viaHandle
    if x.sym == nil && root != nil {
        x.root = root
        x.deref = true
        // a path is only known through an owned root: through a reference or handle it is the whole root
        if !root.isRef && !viaHandle { x.path = path }
        // nothing can be moved out through a reference, so this can only be a borrow
        if root.isRef && isOwned(x.typ) { x.borrowed = true }
    }
    return x
}

fn newExpr(): Item {
    next()
    if sym == T_LBRACK {
        let t = parseType()
        expect(T_LPAREN, "")
        let n = expression()
        if !isInt(n.typ) { error("array length must be int") }
        let b = baseOf(t)
        if nonNull(b) && !(n.mode == "const" && n.val == 0) {
            error("array elements of type " + tname(b) + " would start as nil; use []?" + tname(b) +
                  ", or start empty with new []" + tname(b) + "(0) and append")
        }
        expect(T_RPAREN, "")
        var kind = 1
        if b.kind == "byte" {
            kind = 4
        } else if b.kind == "string" {
            kind = 6                                  // reference-counted strings
        } else if isOwned(b) {
            kind = 2                                  // owned objects, freed with the array (not handles)
        }
        return rtCall2(RT_ALLOC_ARRAY, n, makeConst(tInt, kind), t)
    }
    let name = ident()
    let s = lookup(name)
    if s.kind == "type" && symType(s).incomplete { error("'" + name + "' is declared but not yet defined") }
    if s.kind != "type" || symType(s).kind != "record" { error("'" + name + "' is not a record type") }
    let t = symType(s)
    let p = rtCall1(RT_ALLOC_RECORD, makeConst(tInt, t.desc), t)
    let given = new []string(0)
    expect(T_LBRACE, "")
    skipSemis()
    while sym != T_RBRACE {
        let fname = ident()
        let fi = fieldIndex(t, fname)
        if fi < 0 {
            error(name + " has no field '" + fname + "'")
            return p
        }
        let fty = t.fields[fi].typ
        let foff = t.fields[fi].offset
        for g in given {
            if g == fname { error("field '" + fname + "' given twice") }
        }
        append(given, fname)
        expect(T_COLON, "")
        let v = expression()
        checkAssign(fty, v, "field '" + fname + "'")
        consume(v)
        let dst = mem(p.r, -1, foff, 8)
        if v.mode == "const" && fits32(v.val) {
            opMem(0xC7, 0, dst, true, false)
            emit32(v.val)
            drop(v)
        } else {
            let r = asReg(v)
            opMem(0x89, r.r, dst, true, false)
            release(r.r)
        }
        if sym == T_COMMA || sym == T_SEMI {
            next()
        } else if sym != T_RBRACE {
            expect(T_COMMA, "',' or '}'")
        }
        skipSemis()
    }
    expect(T_RBRACE, "")
    var missing = ""
    for i in 0..len(t.fields) {
        let fname2 = t.fields[i].name
        var isGiven = false
        for g in given {
            if g == fname2 { isGiven = true }
        }
        if nonNull(t.fields[i].typ) && !isGiven {
            if len(missing) > 0 { missing = missing + ", " }
            missing = missing + fname2
        }
    }
    if len(missing) > 0 { error(name + " needs a value for " + missing + " (it cannot be nil)") }
    return p
}

fn factor(): Item {
    let k = sym
    if k == T_INT {
        let v = ival
        next()
        return makeConst(tInt, v)
    }
    if k == T_STRING {
        let addr = stringLit(sval)
        next()
        return makeConst(tString, addr)
    }
    if k == T_TRUE || k == T_FALSE {
        next()
        if k == T_TRUE { return makeConst(tBool, 1) }
        return makeConst(tBool, 0)
    }
    if k == T_NIL {
        next()
        return makeConst(tNil, 0)
    }
    if k == T_LPAREN {
        next()
        let x = expression()
        expect(T_RPAREN, "")
        return x
    }
    if k == T_NEW { return newExpr() }
    if k == T_NOT {
        next()
        let x = factor()
        if x.typ.kind != "bool" { error("'!' needs a bool") }
        if x.mode == "const" { return makeConst(tBool, 1 - x.val) }
        let c = loadCond(x)
        let y = newItem("cond", tBool)
        y.cc = c.cc ^ 1
        y.T = c.F
        y.F = c.T
        y.nt = take(c.nf)
        y.nf = take(c.nt)
        return y
    }
    if k == T_MINUS || k == T_TILDE {
        next()
        let x = factor()
        if !isInt(x.typ) { error("'" + tokName(k) + "' needs an int") }
        if x.mode == "const" {
            if k == T_MINUS { return makeConst(tInt, -x.val) }
            return makeConst(tInt, ~x.val)
        }
        let y = load(x)
        if k == T_MINUS {
            opReg(0xF7, 3, y.r, true, false)
        } else {
            opReg(0xF7, 2, y.r, true, false)
        }
        y.typ = tInt
        return y
    }
    if k == T_CHAR {
        let v = ival
        next()
        return makeConst(tByte, v)
    }
    if k == T_AMP {
        // &place: borrow instead of moving
        next()
        if sym != T_IDENT { error("& needs a variable, field or element") }
        let x = designator()
        if (x.mode != "mem" && x.mode != "elem") || !isOwned(x.typ) {
            error("& needs a variable, field or element holding a record, closed type or array")
        }
        x.borrowed = true
        return x
    }
    if k == T_IDENT { return designator() }
    error("expected an expression")
    return voidItem()
}

// truncating division, as on x86
fn fold(o: int, a: int, b: int): int {
    if (o == T_SLASH || o == T_PERCENT) && b == 0 { error("division by zero") }
    if (o == T_SLASH || o == T_PERCENT) && b == -1 {
        if o == T_SLASH { return -a }             // wraps for the most negative int
        return 0
    }
    match o {
        T_PLUS { return a + b }
        T_MINUS { return a - b }
        T_STAR { return a * b }
        T_SLASH { return a / b }
        T_PERCENT { return a % b }
        T_AMP { return a & b }
        T_BAR { return a | b }
        T_CARET { return a ^ b }
        T_SHL { return a << b }
        else { return a >> b }
    }
}

fn isMulOp(k: int): bool {
    match k {
        T_STAR, T_SLASH, T_PERCENT, T_SHL, T_SHR, T_AMP { return true }
        else { return false }
    }
}

fn isAddOp(k: int): bool {
    match k {
        T_PLUS, T_MINUS, T_BAR, T_CARET { return true }
        else { return false }
    }
}

fn aluCode(o: int): int {
    match o {
        T_PLUS { return 0 }
        T_BAR { return 1 }
        T_AMP { return 4 }
        T_MINUS { return 5 }
        else { return 6 }
    }
}

fn opOperand(opc: int, reg: int, y0: Item) {
    var y = y0
    if y.mode != "mem" && y.mode != "reg" { y = load(y) }
    if y.mode == "reg" {
        opReg(opc, reg, y.r, true, false)
    } else {
        opMem(opc, reg, memOf(y), true, false)
    }
    releaseItem(y)
}

fn binop(o: int, x0: Item, y0: Item): Item {
    var x = x0
    var y = y0
    if !isInt(x.typ) || !isInt(y.typ) { error("'" + tokName(o) + "' needs ints") }
    if x.mode == "const" && y.mode == "const" { return makeConst(tInt, fold(o, x.val, y.val)) }
    if x.mode == "const" && (o == T_PLUS || o == T_STAR || o == T_AMP || o == T_BAR || o == T_CARET) {
        let t = x
        x = y
        y = t
    }
    if y.mode == "elem" || (y.mode == "mem" && y.width == 1) { y = load(y) }
    if o == T_STAR && x.home && y.mode == "const" && fits32(y.val) {
        let t = alloc()                           // imul reads one register and writes another
        opReg(0x69, t, x.r, true, false)
        emit32(y.val)
        drop(y)
        x = makeReg(tInt, t)
        return x
    }
    x = load(x)
    if o == T_STAR {
        if y.mode == "const" && fits32(y.val) {
            opReg(0x69, x.r, x.r, true, false)
            emit32(y.val)
            drop(y)
        } else {
            opOperand(0x0FAF, x.r, y)
        }
    } else if o == T_SLASH || o == T_PERCENT {
        if y.mode == "const" && y.val == 0 { error("division by zero") }
        if y.mode == "const" { y = load(y) }
        if y.mode != "mem" && y.mode != "reg" { y = load(y) }
        movRR(RAX, x.r)
        emit(0x48)
        emit(0x99)
        if y.mode == "reg" {
            opReg(0xF7, 7, y.r, true, false)
        } else {
            opMem(0xF7, 7, memOf(y), true, false)
        }
        releaseItem(y)
        drop(y)
        if o == T_SLASH {
            movRR(x.r, RAX)
        } else {
            movRR(x.r, RDX)
        }
    } else if o == T_SHL || o == T_SHR {
        var ext = 7
        if o == T_SHL { ext = 4 }
        if y.mode == "const" {
            opReg(0xC1, ext, x.r, true, false)
            emit(y.val & 63)
            drop(y)
        } else {
            opOperand(0x8B, RCX, y)
            opReg(0xD3, ext, x.r, true, false)
        }
    } else {
        let c = aluCode(o)
        if y.mode == "const" && fits32(y.val) {
            aluRI(c, x.r, y.val)
            drop(y)
        } else {
            opOperand(c * 8 + 3, x.r, y)
        }
    }
    x.typ = tInt
    return x
}

fn term(): Item {
    var x = factor()
    while isMulOp(sym) {
        let o = sym
        next()
        if !isInt(x.typ) { error("'" + tokName(o) + "' needs ints") }
        x = materialise(x)
        x = binop(o, x, factor())
    }
    return x
}

fn simpleExpr(): Item {
    var x = term()
    while isAddOp(sym) {
        let o = sym
        next()
        if o == T_PLUS && x.typ.kind == "string" {
            x = pinStr(x)
            let y = term()
            if y.typ.kind != "string" { error("'+' on a string needs another string (use string(n) for numbers)") }
            if x.mode == "const" && y.mode == "const" {
                x = makeConst(tString, stringLit(rodataString(x.val) + rodataString(y.val)))
                drop(y)
            } else {
                x = rtCall2(RT_CONCAT, x, y, tString)
            }
            continue
        }
        if !isInt(x.typ) { error("'" + tokName(o) + "' needs ints") }
        x = materialise(x)
        x = binop(o, x, term())
    }
    return x
}

fn relation(): Item {
    var x = simpleExpr()
    if !isRel(sym) { return x }
    let o = sym
    next()
    var xsym: ?^Sym = nil
    if x.mode == "mem" { xsym = x.sym }
    noTemp(x)
    x = pinStr(x)
    var y = simpleExpr()
    var ysym: ?^Sym = nil
    if y.mode == "mem" { ysym = y.sym }
    noTemp(y)
    let kx = x.typ.kind
    let ky = y.typ.kind
    if kx == "string" || ky == "string" {
        if kx != ky || (o != T_EQ && o != T_NE) { error("strings can only be compared with == and !=") }
        let r = rtCall2(RT_STREQ, x, y, tInt)
        opReg(0x85, r.r, r.r, true, false)
        release(r.r)
        let z = newItem("cond", tBool)
        z.cc = CC_E
        if o == T_EQ { z.cc = CC_NE }
        return z
    }
    let refs = isRef(x.typ) || isRef(y.typ) || kx == "nil" || ky == "nil"
    if refs {
        if o != T_EQ && o != T_NE { error("references can only be compared with == and !=") }
        if !(assignable(x.typ, y.typ) || assignable(y.typ, x.typ)) {
            error("cannot compare " + tname(x.typ) + " with " + tname(y.typ))
        }
    } else if kx != ky && !(isInt(x.typ) && isInt(y.typ)) {
        error("cannot compare " + tname(x.typ) + " with " + tname(y.typ))
    } else if kx == "bool" && o != T_EQ && o != T_NE {
        error("bools can only be compared with == and !=")
    }
    if x.mode == "const" && y.mode == "const" {
        var v = false
        if o == T_EQ { v = x.val == y.val }
        if o == T_NE { v = x.val != y.val }
        if o == T_LT { v = x.val < y.val }
        if o == T_LE { v = x.val <= y.val }
        if o == T_GT { v = x.val > y.val }
        if o == T_GE { v = x.val >= y.val }
        if v { return makeConst(tBool, 1) }
        return makeConst(tBool, 0)
    }
    var cc = relCC(o)
    var narrowSym: ?^Sym = nil
    var narrowType = tVoid
    if y.typ.kind == "nil" && x.typ.kind == "opt" && xsym != nil && xsym.storage == "local" {
        narrowSym = xsym
        narrowType = baseOf(x.typ)
    }
    if x.typ.kind == "nil" && y.typ.kind == "opt" && ysym != nil && ysym.storage == "local" {
        narrowSym = ysym
        narrowType = baseOf(y.typ)
    }
    if x.mode == "const" {
        let t = x
        x = y
        y = t
        cc = swapCC(cc)
    }
    if x.mode == "cond" { x = load(x) }
    if y.mode == "const" && fits32(y.val) && x.mode == "mem" && x.width == 8 {
        aluMI(7, memOf(x), y.val)
        releaseItem(x)
    } else {
        x = asReg(x)
        if y.mode == "const" && fits32(y.val) {
            aluRI(7, x.r, y.val)
        } else {
            if (y.mode != "mem" && y.mode != "reg") || y.width == 1 { y = load(y) }
            if y.mode == "reg" {
                opReg(0x3B, x.r, y.r, true, false)
            } else {
                opMem(0x3B, x.r, memOf(y), true, false)
            }
            releaseItem(y)
        }
        release(x.r)
    }
    let z = newItem("cond", tBool)
    z.cc = cc
    if narrowSym != nil {
        if o == T_NE {
            z.nt = new NPair{sym: narrowSym, typ: narrowType, next: nil}
        } else {
            z.nf = new NPair{sym: narrowSym, typ: narrowType, next: nil}
        }
    }
    return z
}

fn conjunction(): Item {
    var x = relation()
    while sym == T_ANDAND {
        next()
        if x.typ.kind != "bool" { error("'&&' needs bools") }
        x = loadCond(x)
        let flinks = falseJump(x)
        let mark = len(narrowStack)
        pushNarrowings(x.nt)
        condDepth += 1
        let y = loadCond(relation())
        condDepth -= 1
        truncate(narrowStack, mark)
        y.F = joinWaits(y.F, flinks)
        y.nt = joinPairs(&x.nt, take(y.nt))
        y.nf = nil
        x = y
    }
    return x
}

fn expression(): Item {
    var x = conjunction()
    while sym == T_OROR {
        next()
        if x.typ.kind != "bool" { error("'||' needs bools") }
        x = loadCond(x)
        x.T = waitJump(x.T, jcc(x.cc))
        fixHere(x.F)
        let mark = len(narrowStack)
        pushNarrowings(x.nf)
        condDepth += 1
        let y = loadCond(conjunction())
        condDepth -= 1
        truncate(narrowStack, mark)
        y.T = joinWaits(y.T, x.T)
        y.nf = joinPairs(&x.nf, take(y.nf))
        y.nt = nil
        x = y
    }
    return x
}

// ============================================================= statements

fn block(): bool
fn statement(): bool

fn varDecl(kind: string, isGlobal: bool) {
    let name = ident()
    if !isGlobal { noteDeclared(name) }
    var t: ?^Type = nil
    var declRef = 0
    if sym == T_COLON {
        next()
        t = parseRefType()
        declRef = refMode
        if declRef > 0 && isGlobal { error("references cannot be global") }
    }
    var gsym = newSym(kind, name, t)
    if isGlobal {
        gsym.storage = "global"
        gsym.offset = GLOBAL_BASE + gsize
        gsize += 8
    }
    if sym == T_ASSIGN {
        next()
        if isGlobal { fixHere1(initLink) }
        let x = expression()
        if !isGlobal && (declRef > 0 || (t == nil && x.borrowed)) {
            // a reference local: it borrows, nothing is moved or freed
            var rt = x.typ
            if t != nil { rt = t }
            checkAssign(rt, x, "initialising '" + name + "'")
            let nb = borrowBind(x)
            let v = newLocal("", rt, kind)
            v.name = name
            let dst = newItem("mem", rt)
            dst.base = RBP
            dst.disp = v.offset
            makeRefLocal(v, nb)
            store(dst, x)
            declare(v)
            return
        }
        if x.borrowed && t != nil && x.mode != "const" {
            error("cannot move out of a reference: declare '" + name + "' as &" + tname(t) + " to borrow")
        }
        var tt = x.typ
        if t != nil {
            tt = t
        } else if x.typ.kind == "nil" || x.typ.kind == "void" {
            error("cannot infer a type for '" + name + "' from this value")
        }
        checkAssign(tt, x, "initialising '" + name + "'")
        consume(x)
        var s = gsym
        var dst = newItem("mem", tt)
        if isGlobal {
            s.typ = tt
            dst.disp = s.offset
        } else {
            s = newLocal("", tt, kind)
            s.name = name
            if tt.kind == "int" || tt.kind == "bool" { homeFor(s, name, true) }
            dst = localItem(s, tt)
            if kind == "let" {
                s.hOrigin = x.hOrigin
                s.hDepth = len(loops)
                if s.hOrigin != nil { append(originSyms, s) }
            }
        }
        store(dst, x)
        if isGlobal { initLink = jmp() }
        declare(s)
        if !isGlobal && isOwned(tt) { addOwnedLocal(s) }
        if !isGlobal && tt.kind == "string" { addStrLocal(s) }
    } else {
        if t == nil {
            error("'" + name + "' needs a type or an initial value")
            return
        }
        if nonNull(t) { error("'" + name + "' of type " + tname(t) + " needs an initial value (it cannot be nil)") }
        if kind == "let" { error("'" + name + "' is immutable and needs a value") }
        if isGlobal {
            gsym.typ = t
            declare(gsym)
        } else {
            let s = newLocal(name, t, kind)
            if t.kind == "int" || t.kind == "bool" { homeFor(s, name, true) }
            if s.home >= 0 {
                movRI(s.home, 0)
            } else {
                opMem(0xC7, 0, mem(RBP, -1, s.offset, 8), true, false)
                emit32(0)
            }
            if isOwned(t) { addOwnedLocal(s) }
            if t.kind == "string" { addStrLocal(s) }
        }
    }
}


// returns true if the statement never completes (a call to exit)
fn assignmentOrCall(): bool {
    let line = tline
    let col = tcol
    noreturn = false
    let x = designatorT(true)
    let tplace = lastPlace
    let traw = lastRaw
    let torig = lastOrigin
    let tident = lastIdent
    if noreturn && (sym == T_SEMI || sym == T_RBRACE) { return true }
    if x.movedRef && sym != T_ASSIGN {
        let r = x.root
        if r != nil { errorAt("'" + r.name + "' was moved and has no value here", line, col) }
    }
    if sym == T_ASSIGN || sym == T_PLUSEQ || sym == T_MINUSEQ || sym == T_STAREQ {
        let o = sym
        if x.mode != "mem" && x.mode != "elem" && !x.home { errorAt("cannot assign to this", line, col) }
        if x.readonly {
            let xs = x.sym
            if xs == nil {
                errorAt("strings are immutable", line, col)
            } else {
                errorAt("'" + xs.name + "' is immutable (declared with let)", line, col)
            }
        }
        next()
        var dtype = x.typ
        let xs = x.sym
        if xs != nil { dtype = symType(xs) }
        let wr = x.root
        // a write through a reference that is not pointed afresh: see loopBindCheck
        if x.deref && wr != nil && wr.isRefLocal && !wr.fresh {
            useSeq += 1
            wr.writeUse = useSeq
        }
        if x.deref && wr != nil && wr.isRef && !wr.bind.writable {
            errorAt("cannot change through '" + wr.name + "': it is a read-only reference", line, col)
        }
        if o == T_ASSIGN && xs != nil && xs.isRefLocal {
            // pointing a reference somewhere else: nothing is moved or freed
            if xs.iterating { errorAt("cannot point '" + xs.name + "' elsewhere while a for loop walks it", line, col) }
            if deferMark >= 0 && declaredBefore(xs, deferMark) {
                errorAt("cannot point '" + xs.name + "' elsewhere in a defer: a defer body runs where its block is left, and the change would not be seen there", line, col)
            }
            let y = expression()
            checkAssign(dtype, y, "assignment")
            let nb = borrowBind(y)
            if !assignable(x.typ, y.typ) { widen(xs) }
            store(x, y)
            // the parent may be xs itself, or one below it (a reference copied from xs's own value): then
            // it is xs's old parent, so that the parents stay a chain
            let oldParent = xs.bind.parent
            var parent: ?^Sym = nb.parent
            if ancestorOf(xs, parent) { parent = oldParent }
            // the references derived from xs's old value derive from its parent now
            let locals = &ownedLocals
            for v in locals {
                if v.isRefLocal && v.bind.parent == xs {
                    let rb = rebind(v.bind, oldParent)
                    v.bind = rb
                }
            }
            let nbind = rebind(nb, parent)
            xs.bind = nbind
            xs.fresh = true
            xs.carryFreed = false
            xs.suspect = false
            xs.moved = false
            return false
        }
        if o == T_ASSIGN {
            let callsBefore = userCalls
            let savedPin = pinned
            let r0 = x.root
            let touch0 = heldTouch(r0)
            if x.deref && r0 != nil && r0.storage == "local" { pinned = r0 }
            var hp = -1
            if x.deref || x.viaHandle { hp = heldPushStore(r0, x.viaHandle, torig, tident, tplace, traw) }
            let y = expression()
            pinned = savedPin
            checkAssign(dtype, y, "assignment")
            consume(y)
            if traw == "" && !x.viaHandle && !x.deref { originMove(xs, false) }
            checkTargetAcrossCall(x, xs, r0, callsBefore, line, col)
            if x.deref && r0 != nil && heldLost(r0, touch0) {
                errorAt("cannot assign through '" + r0.name + "' with a value that moves what it is in: the call could free it; compute the value first", line, col)
            }
            if heldHitAt(hp) {
                errorAt("cannot assign through a place with a value that replaces or moves what it is in: the old value could be freed; compute the value first", line, col)
            }
            heldPop(hp)
            if xs != nil && xs.storage == "local" && !assignable(x.typ, y.typ) { widen(xs) }
            if isOwned(dtype) {
                if xs != nil && xs.storage == "local" {
                    if xs.iterating { errorAt("cannot change '" + xs.name + "' while a for loop walks it", line, col) }
                    invalidate(xs, nil, true, "")
                } else if x.deref || x.viaHandle {
                    invalidateOwnedChange(x)
                    recordFreeChange(x)
                } else if xs != nil {
                    invalidate(xs, nil, true, "")               // a global given a new value
                    recordFree(xs)
                }
                // free the old value first, unless the local's value was moved away
                var live = true
                if xs != nil && xs.storage == "local" { live = !xs.moved }
                if live {
                    resolve(x)
                    let r = alloc()
                    opMem(0x8B, r, memOf(x), true, false)
                    rtCall1(RT_FREE, makeReg(dtype, r), tVoid)
                }
                if xs != nil { xs.moved = false }
            } else if dtype.kind == "string" {
                resolve(x)
                let r = alloc()
                opMem(0x8B, r, memOf(x), true, false)
                rtCall1(RT_STR_DEC, makeReg(tString, r), tVoid)
            }
            store(x, y)
        } else {
            if dtype.kind != "int" { error("'" + tokName(o) + "' needs an int") }
            let callsBefore = userCalls
            let savedPin = pinned
            let r0 = x.root
            let touch0 = heldTouch(r0)
            if x.deref && r0 != nil && r0.storage == "local" { pinned = r0 }
            var hp = -1
            if x.deref || x.viaHandle { hp = heldPushStore(r0, x.viaHandle, torig, tident, tplace, traw) }
            var y = expression()
            pinned = savedPin
            checkTargetAcrossCall(x, xs, r0, callsBefore, line, col)
            if x.deref && r0 != nil && heldLost(r0, touch0) {
                errorAt("cannot assign through '" + r0.name + "' with a value that moves what it is in: the call could free it; compute the value first", line, col)
            }
            if heldHitAt(hp) {
                errorAt("cannot assign through a place with a value that replaces or moves what it is in: the old value could be freed; compute the value first", line, col)
            }
            heldPop(hp)
            if !isInt(y.typ) { error("'" + tokName(o) + "' needs an int") }
            if !same(dtype, tInt) { error("'" + tokName(o) + "' needs an int") }
            resolve(x)
            var r = x.r                       // a local in a register is changed where it is
            if !x.home {
                r = alloc()
                opMem(0x8B, r, memOf(x), true, false)
            }
            if o == T_STAREQ {
                y = asReg(y)
                opReg(0x0FAF, r, y.r, true, false)
                release(y.r)
            } else {
                var c = 5
                if o == T_PLUSEQ { c = 0 }
                if y.mode == "const" && fits32(y.val) {
                    aluRI(c, r, y.val)
                } else {
                    y = asReg(y)
                    opReg(c * 8 + 3, r, y.r, true, false)
                    release(y.r)
                }
            }
            if x.home {
                drop(x)
            } else {
                store(x, makeReg(tInt, r))
            }
        }
    } else {
        if x.typ != tVoid || x.mode != "void" {
            if x.mode != "reg" || x.home { errorAt("this expression does nothing", line, col) }
            if isOwned(x.typ) {
                rtCall1(RT_FREE, x, tVoid)                 // a dropped result is freed at once
            } else if x.strTemp {
                rtCall1(RT_STR_DEC, x, tVoid)
            } else {
                releaseItem(x)
                drop(x)
            }
        } else {
            drop(x)
        }
    }
    return false
}

fn statSeq(): bool {
    var term = false
    skipSemis()
    while sym != T_RBRACE && sym != T_EOF {
        if term { error("unreachable code") }
        term = statement()
        if sym != T_RBRACE { expect(T_SEMI, "';' or newline") }
        skipSemis()
    }
    return term
}

fn block(): bool {
    expect(T_LBRACE, "")
    openBlock()
    let term = statSeq()
    expect(T_RBRACE, "")
    closeBlock(term)
    return term
}

fn ifStat(): bool {
    let iline = tline
    let icol = tcol
    next()
    let x = loadCond(expression())
    let flinks = falseJump(x)
    let mark = len(narrowStack)
    let s0 = snapshot()
    pushNarrowings(x.nt)
    let t1 = block()
    let s1 = snapshot()
    restore(s0)
    truncate(narrowStack, mark)
    if sym == T_ELSE {
        next()
        let j = jmp()
        fixHere(flinks)
        pushNarrowings(x.nf)
        var t2 = false
        if sym == T_IF {
            t2 = ifStat()
        } else {
            t2 = block()
        }
        truncate(narrowStack, mark)
        fixHere1(j)
        let s2 = snapshot()
        if t1 && !t2 {
            restore(s2)
        } else if t2 && !t1 {
            restore(s1)
        } else if !t1 && !t2 {
            sameStates(s1, s2, iline, icol)
            joinSuspect(s1)
        }
        if t1 && !t2 {
            pushNarrowings(x.nf)
        } else if t2 && !t1 {
            pushNarrowings(x.nt)
        }
        return t1 && t2
    }
    fixHere(flinks)
    if !t1 {
        sameStates(s1, s0, iline, icol)
        joinSuspect(s1)
    }
    if t1 { pushNarrowings(x.nf) }
    return false
}

// entry: the state when the loop is entered; every iteration must end, and every break or continue
// happen, with the same moves. nOuter and selfBefore: the owned locals and the self-call count before
// the loop's condition (if any) and body, so that a self-call in either is seen by loopSelfCheck;
// useBefore: the reads so far, so that a read in the loop is seen by loopBindCheck
fn loopBodyV(entry: PState, line: int, col: int, lv: ?^Sym, nOuter: int, selfBefore: int, useBefore: int, logFrom: int): Loop

// a loop's end, where the state of its last iteration is checked against the one it began with
fn loopMoveError(d: ?^Sym, line: int, col: int) {
    if d != nil {
        errorAt("'" + d.name + "' is moved inside the loop; it must have a value again by the end of each iteration", line, col)
    }
}

fn loopBody(entry: PState, line: int, col: int, nOuter: int, selfBefore: int, useBefore: int, logFrom: int): Loop {
    return loopBodyV(entry, line, col, nil, nOuter, selfBefore, useBefore, logFrom)
}

// lv: a for loop's variable, rebound at the start of every iteration
// logFrom: the free log's length where the loop's condition or body begins (see applyExit)
fn loopBodyV(entry: PState, line: int, col: int, lv: ?^Sym, nOuter: int, selfBefore: int, useBefore: int, logFrom: int): Loop {
    let n = localsIn(entry)
    clearFresh()
    append(loops, new Loop{brk: 0, cont: 0, blocks: len(blocks), entry: copyState(entry), lv: lv,
                           susp: neutralState(n), back: neutralState(n), exits: new []PState(0), exitAt: new []int(0),
                           conts: new []PState(0), contAt: new []int(0), logFrom: logFrom})
    let term = block()
    // the next iteration starts where the body ends, if it falls through, and at each continue, as the
    // continue is left (applyExit depends on the state the next iteration starts from, so this is repeated
    // until the state stops changing)
    let li = len(loops) - 1
    if !term {
        let now = snapshot()
        absorb(&loops[li].back, &now)
    }
    var back = copyState(&loops[li].back)
    var settled = false
    var round = 0
    while !settled && round < 4 {
        var next = copyState(&loops[li].back)
        for k in 0..len(loops[li].conts) {
            var x = copyState(loops[li].conts[k])
            applyExit(&x, &back, logFrom, loops[li].contAt[k])
            absorb(&next, &x)
        }
        settled = sameState(&next, &back)
        back = next
        round += 1
    }
    if !settled {
        errorAt("the references in this loop change too often to be checked; point them afresh in the loop", line, col)
    }
    // A change in the loop made while a reference was not pointed afresh may free what it points into on
    // the next iteration, where its binding is back's. hit: whether a change of the loop made while the
    // reference was not pointed afresh may free what back's binding points into. Where none does, the
    // carried marks are dropped: they were coarse (see markCarriedFreed).
    var hit = new []bool(n)
    for j in logFrom..len(freeLog) {
        let r = freeLog[j]
        for q in 0..len(r.nonFresh) {
            let i = r.nonFresh[q]
            if i < n && !hit[i] && freeHits(ownedLocals[i], back.binds[i], r) { hit[i] = true }
        }
    }
    for i in 0..n {
        if !hit[i] { back.flags[3 * n + i] = false }
    }
    loopSelfCheck(nOuter, selfBefore, useBefore, &back, lv, line, col)
    loopBindCheck(&entry, &back, useBefore, lv, line, col, hit)
    loopCarryCheck(&back, useBefore, lv)
    // the states the loop is left in: each break, and each continue, with the frees on the way out. The
    // references a state moves are moved after the loop (outMoved)
    var susp = neutralState(n)
    var outMoved = new []bool(n)
    for k in 0..len(loops[li].exits) {
        var x = copyState(loops[li].exits[k])
        applyExit(&x, &back, logFrom, loops[li].exitAt[k])
        absorb(&susp, &x)
        for i in 0..n {
            if x.flags[i] { outMoved[i] = true }
        }
    }
    for k in 0..len(loops[li].conts) {
        var x = copyState(loops[li].conts[k])
        applyExit(&x, &back, logFrom, loops[li].contAt[k])
        // a continue ends an iteration, so what it moves must have a value again: as at the body's end
        loopMoveError(stateDiff(&entry, &x), line, col)
        absorb(&susp, &x)
        for i in 0..n {
            if x.flags[i] { outMoved[i] = true }
        }
    }
    // the loop's record leaves the stack; what break and continue collected comes back
    let res = new Loop{brk: loops[li].brk, cont: loops[li].cont, blocks: loops[li].blocks,
                       entry: copyState(entry), lv: lv, susp: susp, back: copyState(&back),
                       exits: new []PState(0), exitAt: new []int(0), conts: new []PState(0), contAt: new []int(0),
                       logFrom: logFrom}
    truncate(loops, li)
    if lv != nil { lv.moved = false }
    if !term {
        let now = snapshot()
        loopMoveError(stateDiff(&entry, &now), line, col)
    }
    // the loop may run no time, or leave from its body: its suspicion, bindings and freshness are what
    // either carries. A body that always leaves carries none of its own, since its end is not reached.
    // A reference invalid where the next iteration starts stays invalid where the loop is left from the top
    // (a while condition, a for loop's test), and a break on a later pass sees it too
    if term { restore(&entry) } else { restoreMoved(&entry) }
    for i in 0..n {
        if outMoved[i] { ownedLocals[i].moved = true }
        if back.flags[i] && ownedLocals[i].isRefLocal { ownedLocals[i].moved = true }
    }
    joinSuspect(&entry)
    joinSuspect(&res.susp)
    joinBinds(&res.back)
    return res
}

// A while loop's condition is compiled where it is read, and its bytes are then moved after the body
// (loop inversion): `jmp cond; body: ...; cond: C; jcc body`. Moved by d, what they hold that is not
// relative moves with them: calls out (farCalls) are d further from their targets, calls waiting for a
// later function are d further on, and the condition's true and false lists thread positions through
// their rel32 fields. The checker has seen the condition once, where it is read.
fn shiftWaits(head: int, d: int): int {
    if head == 0 { return 0 }
    var at = head + d
    while getRel(at) != 0 {
        let nxt = getRel(at) + d
        putRel(at, nxt)
        at = nxt
    }
    return head + d
}

fn whileStat(): bool {
    let wline = tline
    let wcol = tcol
    next()
    let nOuter = len(ownedLocals)
    let selfBefore = selfCalls
    let useBefore = useSeq
    let savedMarks = loopMarksSave()
    loopLogStart()
    let logFrom = len(freeLog)
    clearFresh()
    let entry = snapshot()
    let top = pc()
    let farFrom = len(farCalls)
    let fwdFrom = fwdCalls
    var x = expression()
    let forever = x.mode == "const" && x.typ.kind == "bool" && x.val == 1
    let liftFrom = len(lifted)               // this loop's part of lifted, waitFn and waitAt starts here
    let waitFrom = len(waitFn)
    var farTo = 0
    var jcond = 0
    if forever {
        x = newItem("cond", tBool)
    } else {
        x = loadCond(x)
        for i in top..pc() { append(lifted, code[i]) }
        truncate(code, top)
        farTo = len(farCalls)
        if fwdCalls != fwdFrom {
            for g in 0..len(globals) {
                if globals[g].kind == "fn" && globals[g].addr < 0 {
                    while len(globals[g].fixups) > 0 && globals[g].fixups[len(globals[g].fixups) - 1] >= top {
                        append(waitFn, g)
                        append(waitAt, globals[g].fixups[len(globals[g].fixups) - 1])
                        truncate(globals[g].fixups, len(globals[g].fixups) - 1)
                    }
                }
            }
        }
        jcond = jmp()
    }
    let bodyAt = pc()
    let condSt = snapshot()                  // the state when the condition leaves the loop
    let condAt = len(freeLog)
    loopdepth += 1
    let mark = len(narrowStack)
    pushNarrowings(x.nt)
    let loop = loopBody(entry, wline, wcol, nOuter, selfBefore, useBefore, logFrom)
    // the condition's exit: the frees in the condition, and in the body before a break, are on the way out
    var cs = copyState(&condSt)
    applyExit(&cs, &loop.back, logFrom, condAt)
    for i in 0..localsIn(&cs) {
        if cs.flags[i] && !condSt.flags[i] { ownedLocals[i].moved = true }
    }
    joinSuspect(&cs)
    truncate(narrowStack, mark)
    loopdepth -= 1
    loopMarksJoin(savedMarks)
    loopLogEnd()
    if forever {
        fixTo(loop.cont, top)
        jmpTo(top)
        fixHere(loop.brk)
        return loop.brk == 0
    }
    // the condition goes after the body, and a continue goes to it
    let at = pc()
    let d = at - top
    fix(jcond, at)
    fixTo(loop.cont, at)
    for i in liftFrom..len(lifted) { append(code, lifted[i]) }
    truncate(lifted, liftFrom)
    for k in farFrom..farTo {
        farCalls[k] += d
        putRel(farCalls[k], getRel(farCalls[k]) - d)
    }
    for k in waitFrom..len(waitFn) { append(globals[waitFn[k]].fixups, waitAt[k] + d) }
    truncate(waitFn, waitFrom)
    truncate(waitAt, waitFrom)
    let tl = shiftWaits(x.T, d)
    let fl = shiftWaits(x.F, d)
    fix(jcc(x.cc), bodyAt)
    fixTo(tl, bodyAt)
    fixHere(fl)
    fixHere(loop.brk)
    return false
}

fn forStat() {
    let fline = tline
    let fcol = tcol
    next()
    let name = ident()
    noteDeclared(name)
    expect(T_IN, "")
    openBlock()
    let x = expression()
    var top = 0
    var exitLink = 0
    var savedMarks = new []bool(0)
    var loop = new Loop{brk: 0, cont: 0, blocks: 0, entry: emptyState(), susp: emptyState(), back: emptyState(),
                        exits: new []PState(0), exitAt: new []int(0), conts: new []PState(0), contAt: new []int(0),
                        logFrom: 0}
    if sym == T_DOTDOT {
        next()
        if x.typ.kind != "int" { error("range bounds must be ints") }
        let v = newLocal(name, tInt, "let")
        homeFor(v, name, true)
        let vi = localItem(v, tInt)
        store(vi, x)
        let y = expression()
        if y.typ.kind != "int" { error("range bounds must be ints") }
        let lim = newLocal("", tInt, "var")
        if v.home >= 0 {
            homeFor(lim, name, false)              // the limit follows the variable into a register
            if lim.home >= 0 { append(blocks[len(blocks) - 1].syms, lim) }       // so that the block's end frees it
        }
        let li = localItem(lim, tInt)
        store(li, y)
        exitLink = jmp()                        // to the test, after the body
        top = pc()
        loopdepth += 1
        savedMarks = loopMarksSave()
        loopLogStart()
        loop = loopBody(snapshot(), fline, fcol, len(ownedLocals), selfCalls, useSeq, len(freeLog))
        loopdepth -= 1
        fixHere(loop.cont)
        if v.home >= 0 {
            aluRI(0, v.home, 1)
            fixHere1(exitLink)
            if lim.home >= 0 {
                opReg(0x3B, v.home, lim.home, true, false)
            } else {
                opMem(0x3B, v.home, mem(RBP, -1, lim.offset, 8), true, false)
            }
        } else {
            aluMI(0, mem(RBP, -1, v.offset, 8), 1)
            fixHere1(exitLink)
            let r = alloc()
            opMem(0x8B, r, mem(RBP, -1, v.offset, 8), true, false)
            opMem(0x3B, r, mem(RBP, -1, lim.offset, 8), true, false)
            release(r)
        }
        fix(jcc(CC_L), top)
    } else {
        if x.typ.kind != "array" { error("cannot iterate over " + tname(x.typ)) }
        noTemp(x)
        let walked = x.sym
        if walked == nil || walked.storage != "local" {
            error("a for loop walks a local variable or parameter: borrow it first, for example let items = &p.items")
            return
        }
        let arr = newLocal("", x.typ, "var")
        let ai = newItem("mem", x.typ)
        ai.base = RBP
        ai.disp = arr.offset
        let xt = x.typ
        let wb = walkBind(x, walked)
        store(ai, x)
        let idx = newLocal("", tInt, "var")
        opMem(0xC7, 0, mem(RBP, -1, idx.offset, 8), true, false)
        emit32(0)
        let v = newLocal(name, baseOf(xt), "let")
        if isOwned(baseOf(xt)) {
            // each element is borrowed, not moved out
            v.isRef = true
            v.isRefLocal = true
            v.bind = wb
            v.fresh = true
            append(ownedLocals, v)
        }
        let strs = baseOf(xt).kind == "string"
        if strs {
            opMem(0xC7, 0, mem(RBP, -1, v.offset, 8), true, false)
            emit32(0)
            addStrLocal(v)
        }
        let vi = newItem("mem", baseOf(xt))
        vi.base = RBP
        vi.disp = v.offset
        exitLink = jmp()                        // to the test, after the body
        top = pc()
        let ri = alloc()
        let ra = alloc()
        opMem(0x8B, ri, mem(RBP, -1, idx.offset, 8), true, false)
        opMem(0x8B, ra, mem(RBP, -1, arr.offset, 8), true, false)
        if strs { rtCall1(RT_STR_DEC, dupItem(vi), tVoid) }  // drop the previous element
        opMem(0x8B, ra, mem(ra, -1, 16, 8), true, false)
        if baseOf(xt).kind == "byte" {
            opMem(0x0FB6, ri, mem(ra, ri, 8, 1), true, false)
        } else {
            opMem(0x8B, ri, mem(ra, ri, 8, 8), true, false)
        }
        opMem(0x89, ri, mem(RBP, -1, v.offset, 8), true, false)
        release(ri)
        release(ra)
        if strs {
            let held = rtCall1(RT_STR_INC, dupItem(vi), tString)   // and hold the new one
            release(held.r)
        }
        loopdepth += 1
        savedMarks = loopMarksSave()
        loopLogStart()
        let wasIterating = walked.iterating
        walked.iterating = true
        let walkUse = useSeq
        if walked.isRefLocal {                  // the walk reads its array on every iteration
            useSeq += 1
            walked.usedAt = useSeq
        }
        loop = loopBodyV(snapshot(), fline, fcol, v, len(ownedLocals), selfCalls, walkUse, len(freeLog))
        walked.iterating = wasIterating
        loopdepth -= 1
        fixHere(loop.cont)
        aluMI(0, mem(RBP, -1, idx.offset, 8), 1)
        fixHere1(exitLink)
        let ti = alloc()
        let ta = alloc()
        opMem(0x8B, ti, mem(RBP, -1, idx.offset, 8), true, false)
        opMem(0x8B, ta, mem(RBP, -1, arr.offset, 8), true, false)
        opMem(0x3B, ti, mem(ta, -1, 0, 8), true, false)
        release(ti)
        release(ta)
        fix(jcc(CC_L), top)
    }
    fixHere(loop.brk)
    loopMarksJoin(savedMarks)
    loopLogEnd()
    closeBlock(false)
}

// match on an int or byte: arms are lists of constants, with an optional else.
// The subject is evaluated once; the statement terminates only with an else.
// the line for errors reported at the current token
fn line0(): int { return 0 }

fn intMatch(x: Item): bool {
    let slot = newLocal("", tInt, "var")
    let si = newItem("mem", tInt)
    si.base = RBP
    si.disp = slot.offset
    store(si, x)
    let mline = tline
    let mcol = tcol
    let s0 = snapshot()
    var acc = copyState(s0)
    var have = false
    expect(T_LBRACE, "")
    skipSemis()
    let seen = new []int(0)
    var ends = 0
    var allTerm = true
    var hasElse = false
    while sym != T_RBRACE {
        if sym == T_ELSE {
            next()
            hasElse = true
            restore(s0)
            let bt = block()
            allTerm = allTerm && bt
            if !bt {
                let st = snapshot()
                if have { sameStates(acc, st, line0(), 0); acc = joinStates(acc, st) } else { acc = copyState(st) }
                have = true
            }
            skipSemis()
            if sym != T_RBRACE { error("'else' must be the last arm") }
            break
        }
        var toBody = 0
        var nxt = 0
        while true {
            let v = expression()
            if v.mode != "const" || !isInt(v.typ) { error("match arms need constant ints or bytes") }
            if containsInt(seen, v.val) { error("value " + string(v.val) + " is matched twice") }
            append(seen, v.val)
            if fits32(v.val) {
                aluMI(7, mem(RBP, -1, slot.offset, 8), v.val)
            } else {
                let r = alloc()
                movRI(r, v.val)
                opMem(0x3B, r, mem(RBP, -1, slot.offset, 8), true, false)
                release(r)
            }
            if sym != T_COMMA {
                nxt = jcc(CC_NE)
                break
            }
            next()
            toBody = waitJump(toBody, jcc(CC_E))
        }
        fixHere(toBody)
        restore(s0)
        let bt = block()
        allTerm = allTerm && bt
        if !bt {
            let st = snapshot()
            if have { sameStates(acc, st, line0(), 0); acc = joinStates(acc, st) } else { acc = copyState(st) }
            have = true
        }
        ends = waitJump(ends, jmp())
        fixHere1(nxt)
        skipSemis()
    }
    expect(T_RBRACE, "")
    if !hasElse {
        if have { sameStates(acc, s0, mline, mcol); acc = joinStates(acc, s0) } else { acc = copyState(s0) }
        have = true
    }
    if have { restore(acc) } else { restore(s0) }
    fixHere(ends)
    return allTerm && hasElse
}

fn matchStat(): bool {
    next()
    let line = tline
    let col = tcol
    let x = expression()
    if isInt(x.typ) { return intMatch(x) }
    let t = x.typ
    if t.kind != "closed" && t.kind != "opt" && !t.incomplete {
        errorAt("match needs an int, byte or closed type, not " + tname(t), line, col)
    }
    let xs = x.sym
    if x.mode != "mem" || xs == nil || (xs.kind != "var" && xs.kind != "let") || xs.storage != "local" {
        errorAt("match needs a local variable or parameter", line, col)
        return false
    }
    let s = xs
    let name = s.name
    if t.kind == "opt" { errorAt("'" + name + "' may be nil: check it with '!= nil' first", line, col) }
    if t.incomplete { errorAt(tname(t) + " is declared but not yet defined", line, col) }
    let tag = newLocal("", tInt, "var")
    let s0 = snapshot()
    var acc = copyState(s0)
    var have = false
    let r = alloc()
    opMem(0x8B, r, mem(RBP, -1, s.offset, 8), true, false)
    opMem(0x8B, r, mem(r, -1, -16, 8), false, false)          // the tag; the high half is a generation
    opMem(0x89, r, mem(RBP, -1, tag.offset, 8), true, false)
    release(r)
    expect(T_LBRACE, "")
    skipSemis()
    let seen = new []^Type(0)
    var ends = 0
    var allTerm = true
    var hasElse = false
    while sym != T_RBRACE {
        if sym == T_ELSE {
            next()
            hasElse = true
            restore(s0)
            let bt = block()
            allTerm = allTerm && bt
            if !bt {
                let st = snapshot()
                if have { sameStates(acc, st, line0(), 0); acc = joinStates(acc, st) } else { acc = copyState(st) }
                have = true
            }
            skipSemis()
            if sym != T_RBRACE { error("'else' must be the last arm") }
            break
        }
        let vname = ident()
        var v: ?^Type = nil
        let vs = &t.variants
        for c in vs {
            if v == nil && c.name == vname { v = c }
        }
        if v == nil {
            error("'" + vname + "' is not a variant of " + tname(t))
            return false
        }
        for c in seen {
            if c == v { error("'" + vname + "' is matched twice") }
        }
        append(seen, v)
        aluMI(7, mem(RBP, -1, tag.offset, 8), v.desc)
        let nxt = jcc(CC_NE)
        let mark = len(narrowStack)
        append(narrowStack, new NEntry{sym: s, typ: v, depth: loopdepth, alive: true})
        restore(s0)
        let bt = block()
        allTerm = allTerm && bt
        if !bt {
            let st = snapshot()
            if have { sameStates(acc, st, line0(), 0); acc = joinStates(acc, st) } else { acc = copyState(st) }
            have = true
        }
        truncate(narrowStack, mark)
        ends = waitJump(ends, jmp())
        fixHere1(nxt)
        skipSemis()
    }
    expect(T_RBRACE, "")
    var missing = ""
    let vs = &t.variants
    for c in vs {
        var found = false
        for d in seen {
            if d == c { found = true }
        }
        if !found {
            if len(missing) > 0 { missing = missing + ", " }
            missing = missing + c.name
        }
    }
    if len(missing) > 0 && !hasElse { errorAt("match on " + tname(t) + " is missing " + missing, line, col) }
    if have { restore(acc) } else { restore(s0) }
    fixHere(ends)
    return allTerm
}

fn returnStat() {
    next()
    if inDefer { error("cannot return from inside defer") }
    let f = curFn
    if f == nil { return }
    var active = false
    for i in fnBlock..len(blocks) {
        if len(blocks[i].defers) > 0 { active = true }
    }
    if f.ret == tVoid {
        if sym != T_SEMI && sym != T_RBRACE { error(f.name + " does not return a value") }
        runDefers(fnBlock)
    } else {
        let x0 = expression()
        checkAssign(f.ret, x0, "return value")
        consume(x0)
        let x = asReg(x0)
        for k in blocks[fnBlock].omark..len(ownedLocals) {
            if !ownedLocals[k].moved { active = true }
        }
        if active {
            let slot = newLocal("", f.ret, "var")
            opMem(0x89, x.r, mem(RBP, -1, slot.offset, 8), true, false)
            release(x.r)
            runDefers(fnBlock)
            opMem(0x8B, RAX, mem(RBP, -1, slot.offset, 8), true, false)
        } else {
            movRR(RAX, x.r)
            release(x.r)
        }
    }
    epilogue()
}

// The deferred statement is compiled out of line as a local subroutine,
// called at every exit from the enclosing block.
fn deferStat() {
    next()
    let over = jmp()
    let entry = pc()
    let before = snapshot()
    let logAt = len(freeLog)
    let savedDepth = depth
    let savedNarrow = replace(narrowStack, new []NEntry(0))   // fresh stacks for the deferred code
    let savedLoops = replace(loops, new []Loop(0))
    let savedInDefer = inDefer
    let savedMark = deferMark
    let savedUses = replace(deferUses, new []bool(len(ownedLocals)))
    deferMark = len(ownedLocals)
    depth = depth + 8
    inDefer = true
    if sym == T_LBRACE {
        block()
    } else {
        openBlock()
        statement()
        closeBlock(false)
    }
    emit(0xC3)
    depth = savedDepth
    narrowStack = savedNarrow
    loops = savedLoops
    inDefer = savedInDefer
    deferMark = savedMark
    let uses = replace(deferUses, savedUses)
    fixHere1(over)
    // the body runs where the block is left, not here: what it did to suspicion is taken back (its
    // re-points have not happened yet either), and callDefers applies its recursive calls at each exit
    restoreDeferred(&before)
    // the body's frees happen where its block is left, not here: a reference is not moved by them where the
    // body is declared, and they are kept with the block, to be replayed there (see callDefers)
    let last = len(blocks) - 1
    for i in 0..localsIn(&before) {
        if ownedLocals[i].isRefLocal { ownedLocals[i].moved = before.flags[i] }
    }
    append(blocks[last].freeFrom, len(blocks[last].frees))
    for i in logAt..len(freeLog) { append(blocks[last].frees, freeLog[i]) }
    truncate(freeLog, logAt)
    // the outer reference locals the body used, with their bindings here; an enclosing defer body uses them too
    append(blocks[last].useFrom, len(blocks[last].uses))
    for i in 0..len(uses) {
        if uses[i] {
            append(blocks[last].uses, ownedLocals[i])
            append(blocks[last].useBinds, before.binds[i])
            if i < len(deferUses) { deferUses[i] = true }
        }
    }
    append(blocks[last].defers, entry)
}

fn statement(): bool {
    let k = sym
    match k {
        T_VAR, T_LET {
            next()
            varDecl(tokName(k), false)
        }
        T_IDENT { return assignmentOrCall() }
        T_IF { return ifStat() }
        T_WHILE { return whileStat() }
        T_FOR { forStat() }
        T_MATCH { return matchStat() }
        T_RETURN {
            returnStat()
            return true
        }
        T_BREAK, T_CONTINUE {
            next()
            if len(loops) == 0 { error("'" + tokName(k) + "' outside a loop") }
            let loop = &loops[len(loops) - 1]
            let st = snapshot()
            let lv = loop.lv
            if lv != nil {
                for q in 0..len(ownedLocals) {
                    if ownedLocals[q] == lv { st.flags[q] = false }      // rebound next time round
                }
            }
            let d = stateDiff(loop.entry, st)
            if d != nil {
                error("'" + d.name + "' is moved inside the loop; it must have a value again before " + tokName(k))
            }
            let downTo = loop.blocks
            runDefers(downTo)
            // the state this exit carries, after the deferred calls that run here
            let now = snapshot()
            let lp = &loops[len(loops) - 1]
            // joined where the loop is left, once the frees on the way out are known (see loopBodyV)
            if k == T_CONTINUE {
                append(lp.conts, now)
                append(lp.contAt, len(freeLog))
            } else {
                append(lp.exits, now)
                append(lp.exitAt, len(freeLog))
            }
            let cur = &loops[len(loops) - 1]               // runDefers might have freed: borrow again
            if k == T_BREAK {
                cur.brk = waitJump(cur.brk, jmp())
            } else {
                cur.cont = waitJump(cur.cont, jmp())
            }
            return true
        }
        T_DEFER { deferStat() }
        T_LBRACE { return block() }
        else { error("expected a statement") }
    }
    return false
}

// =========================================================== declarations

// A function with no locals needs no 'sub rsp': its seven bytes, which end with the
// frame size at 'at', are cut out and the body after them moves back. Jumps within the
// body are relative and move with it. A call out of it (farCalls) is now 7 bytes further
// from its target, and a call waiting for a later function has moved in its fixups.
fn dropFrame(at: int) {
    for i in at + 4..len(code) { code[i - 7] = code[i] }
    truncate(code, len(code) - 7)
    let calls = &farCalls
    for p in calls { putRel(p - 7, getRel(p - 7) + 7) }
    let gs = &globals
    for g in gs {
        if g.kind == "fn" && g.addr < 0 {
            for fi in 0..len(g.fixups) {
                if g.fixups[fi] > at { g.fixups[fi] -= 7 }
            }
        }
    }
}

type Param = ref record {
    name: string
    typ: ^Type
    mode: int                 // 0 owned, 1 &, 2 mut
}

// ---- the pre-scan of a function

let callExempt = words("if while for return match defer in else new print println eprint eprintln len gc gcstats exit append truncate substr readFile writeFile args take handle alive drop replace int byte string")

fn wordAt(a: int, b: int, w: string): bool {
    if len(w) != b - a { return false }
    for j in 0..len(w) {
        if src[a + j] != w[j] { return false }
    }
    return true
}

fn skipBlank(from: int): int {
    var q = from
    while q < len(src) && (src[q] == ' ' || src[q] == '\t') { q += 1 }
    return q
}

fn weight(depth: int): int {
    if depth > 3 { return 512 }
    return 1 << (3 * depth)
}

fn addScanned(a: int, b: int): int {
    append(scanAt, len(scanBytes))
    append(scanLen, b - a)
    for j in a..b { append(scanBytes, src[j]) }
    append(scanScore, 0)
    append(scanPend, false)
    return len(scanAt) - 1
}

// whether the name just read, ending at `from`, may be an int or bool local (decl 1: after var or let; 2: after
// for): by its type if it has one, else by where its value starts. A guess: a wrong one only costs a register
// kept back, or lost, in the ranking. The declaration itself decides, with the real type.
fn plausible(decl: int, from: int): bool {
    var q = skipBlank(from)
    if decl == 2 {
        while q + 1 < len(src) && src[q] != '{' && src[q] != '\n' {
            if src[q] == '.' && src[q + 1] == '.' { return true }      // a range; walking an array keeps its element in memory
            q += 1
        }
        return false
    }
    if q >= len(src) { return false }
    if src[q] == ':' {
        q = skipBlank(q + 1)
        var e = q
        while e < len(src) && (isLetter(src[e]) || isDigit(src[e])) { e += 1 }
        return wordAt(q, e, "int") || wordAt(q, e, "bool")
    }
    if src[q] != '=' { return false }
    q = skipBlank(q + 1)
    if q >= len(src) { return false }
    let c = src[q]
    if c == '"' || c == '&' || c == '[' { return false }
    if isLetter(c) {
        var e = q
        while e < len(src) && (isLetter(src[e]) || isDigit(src[e])) { e += 1 }
        if wordAt(q, e, "new") || wordAt(q, e, "string") || wordAt(q, e, "args") || wordAt(q, e, "readFile") { return false }
        if wordAt(q, e, "substr") || wordAt(q, e, "take") || wordAt(q, e, "replace") || wordAt(q, e, "handle") { return false }
        if wordAt(q, e, "nil") { return false }
    }
    return true
}

// a line that ends in this goes on in the next
fn contChar(c: int): bool {
    return c == '+' || c == '-' || c == '*' || c == '/' || c == '%' || c == '&' || c == '|' || c == '^' ||
           c == '<' || c == '>' || c == '=' || c == '!' || c == ',' || c == '.'
}

fn callAt(from: int): bool {
    let q = skipBlank(from)
    return q < len(src) && src[q] == '('
}

fn exemptCall(a: int, b: int): bool {
    let ws = &callExempt
    for w in ws {
        if wordAt(a, b, w) { return true }
    }
    return false
}

// Reads the body of the function about to be compiled, from the current token (its '{') on, as raw text and
// without the scanner's state: the int and bool parameters and the locals it declares, with the uses of each
// weighted 1, 8, 64 or 512 by how many loops it is in (the header of a while or for counts as inside),
// and the calls it makes to the program's own functions, weighted the same way. Nothing here is
// checked; whatever is wrong in the text is for the compiler to report where it reaches it.
fn scanFunction(params: &[]Param) {
    truncate(scanBytes, 0)
    truncate(scanAt, 0)
    truncate(scanLen, 0)
    truncate(scanScore, 0)
    truncate(scanPend, 0)
    scanCalls = 0
    homeCap = 0
    if REG_HOMES == 0 { return }
    for i in 0..len(params) {
        let k = params[i].typ.kind
        if params[i].mode == 0 && (k == "int" || k == "bool") {
            let nm = params[i].name
            for j in 0..len(nm) { append(scanBytes, nm[j]) }
            append(scanAt, len(scanBytes) - len(nm))
            append(scanLen, len(nm))
            append(scanScore, 0)
            append(scanPend, true)
        }
    }
    let n = len(src)
    var p = pos
    var depth = 1
    let braces = new []int(0)             // for each brace open in the body: 1 if it opens a loop's body, 2 a record literal's, else 0
    var nest = 0                          // the parentheses, brackets and record literals open now
    var nestMax = 0                       // and the most registers a statement may hold at once (see below)
    let parens = new []int(0)             // per open parenthesis or bracket: the commas so far if it is a builtin's argument list, else -1
    var totalCommas = 0                   // the earlier arguments of the builtin calls open now: each is held in a register
    var lhsCount = 0                      // the '[' and '.' left of the assignment operator: a destination holds a base and an index
    var held = 0                          // the registers the destination of this statement holds while its value is computed
    var seenAssign = false
    var inDecl = false                    // the statement is a var or let: its '[' are in a type
    var lastA = -1                        // the word just read, if the last token
    var prevCh = 0                        // the first character of the last token, comments apart
    var lastB = -1
    var prevNew = false                   // the word just read was `new`
    var afterNew = false                  // the word just read names the type of a record literal
    var loopDepth = 0
    var header = false                    // between a while or for and its '{'
    var decl = 0                          // 1 after var or let, 2 after for: the next word is the name declared
    while p < n && depth > 0 {
        let c = src[p]
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
            if c == '\n' && nest == 0 && !contChar(prevCh) {
                lhsCount = 0
                held = 0
                seenAssign = false
                inDecl = false
            }
            p += 1
            continue
        }
        if !(c == '/' && p + 1 < n && src[p + 1] == '/') { prevCh = c }
        let la = lastA
        let lb = lastB
        lastA = -1
        let wasNew = afterNew
        afterNew = false
        let newWord = prevNew
        prevNew = false
        if c == '/' && p + 1 < n && src[p + 1] == '/' {
            while p < n && src[p] != '\n' { p += 1 }
            afterNew = wasNew
            prevNew = newWord
        } else if c == '"' {
            p += 1
            while p < n && src[p] != '"' && src[p] != '\n' {
                if src[p] == '\\' { p += 1 }
                p += 1
            }
            p += 1
        } else if c == '\'' {
            p += 1
            if p < n && src[p] == '\\' { p += 2 } else { p += 1 }
            if p < n && src[p] == '\'' { p += 1 }
        } else if isLetter(c) {
            let a = p
            while p < n && (isLetter(src[p]) || isDigit(src[p])) { p += 1 }
            var d = loopDepth
            if header { d += 1 }
            let w = weight(d)
            if wordAt(a, p, "new") {
                prevNew = true
            } else if newWord {
                afterNew = true
            }
            lastA = a
            lastB = p
            if wordAt(a, p, "var") || wordAt(a, p, "let") {
                decl = 1
                inDecl = true
            } else if wordAt(a, p, "for") {
                decl = 2
                header = true
            } else if wordAt(a, p, "while") {
                header = true
            } else if decl > 0 {
                var k = findScanned(a, p)
                let known = k >= 0
                if !known { k = addScanned(a, p) }
                let ok = plausible(decl, p)
                if !known || ok { scanPend[k] = ok }
                scanScore[k] += w
                decl = 0
            } else {
                let k = findScanned(a, p)
                if k >= 0 {
                    scanScore[k] += w
                } else if callAt(p) && !exemptCall(a, p) {
                    scanCalls += w
                }
            }
        } else if isDigit(c) {
            while p < n && (isLetter(src[p]) || isDigit(src[p])) { p += 1 }
        } else if c == '(' || c == '[' {
            nest += 1
            if c == '[' && !seenAssign && !inDecl { lhsCount += 1 }
            if c == '(' && la >= 0 && exemptCall(la, lb) { append(parens, 0) } else { append(parens, -1) }
            let eff = nest + held + totalCommas
            if eff > nestMax { nestMax = eff }
            p += 1
        } else if c == ')' || c == ']' {
            if nest > 0 { nest -= 1 }
            if len(parens) > 0 {
                if parens[len(parens) - 1] > 0 { totalCommas -= parens[len(parens) - 1] }
                truncate(parens, len(parens) - 1)
            }
            p += 1
        } else if c == ',' {
            if len(parens) > 0 && parens[len(parens) - 1] >= 0 {
                parens[len(parens) - 1] += 1
                totalCommas += 1
                let eff = nest + held + totalCommas
                if eff > nestMax { nestMax = eff }
            }
            p += 1
        } else if c == ';' {
            lhsCount = 0
            held = 0
            seenAssign = false
            inDecl = false
            p += 1
        } else if c == '.' {
            if !seenAssign && !inDecl && p + 1 < n && src[p + 1] != '.' && p > 0 && src[p - 1] != '.' { lhsCount += 1 }
            p += 1
        } else if c == '=' {
            if p + 1 < n && src[p + 1] == '=' {
                p += 2
            } else {
                var plain = true
                if p > 0 && (src[p - 1] == '!' || src[p - 1] == '<' || src[p - 1] == '>') { plain = false }
                if plain && nest == 0 && !seenAssign {
                    seenAssign = true
                    held = 2 * lhsCount
                    let eff = nest + held + totalCommas
                    if eff > nestMax { nestMax = eff }
                }
                p += 1
            }
        } else if c == '{' {
            depth += 1
            var kind = 0
            if header {
                kind = 1
                loopDepth += 1
            } else if wasNew {
                kind = 2
                nest += 1
                let eff = nest + held + totalCommas
                if eff > nestMax { nestMax = eff }
            }
            if kind != 2 {
                lhsCount = 0
                held = 0
                seenAssign = false
                inDecl = false
            }
            append(braces, kind)
            header = false
            p += 1
        } else if c == '}' {
            depth -= 1
            if len(braces) > 0 {
                let kind = braces[len(braces) - 1]
                if kind == 1 { loopDepth -= 1 }
                if kind == 2 && nest > 0 { nest -= 1 }
                if kind != 2 {
                    lhsCount = 0
                    held = 0
                    seenAssign = false
                    inDecl = false
                }
                truncate(braces, len(braces) - 1)
            }
            p += 1
        } else {
            p += 1
        }
    }
    // what a statement holds in registers at once: its destination's base and index (held), the earlier
    // arguments of the builtin calls open (totalCommas) and the operands waiting in the expression (nest);
    // two more are in use at the innermost operation. The pool has nine registers.
    homeCap = 7 - nestMax
    if homeCap > REG_HOMES { homeCap = REG_HOMES }
    if homeCap < 0 { homeCap = 0 }
}

// Compiles the body of the function f, its heading read and its '{' the current token. homes is whether its int
// and bool locals may be held in registers. True if it ran out of registers with some (see giveUpHomes): nothing
// has been left but its code, to be thrown away.
fn fnBody(f: ^Sym, name: string, ret: ^Type, params: &[]Param, homes: bool): bool {
    pendLine = 0
    frame = 0
    depth = 0
    truncate(farCalls, 0)
    if homes {
        scanFunction(params)
    } else {
        homeCap = 0
    }
    emit(0x55)
    emit(0x48)
    emit(0x89)
    emit(0xE5)
    emit(0x48)
    emit(0x81)
    emit(0xEC)
    let frameAt = pc()
    emit32(0)
    let bindMark = len(bindArena)
    let symMark = len(symArena)                 // the function's own symbols start here
    openBlock()
    fnBlock = len(blocks) - 1
    let n = len(params)
    for i in 0..n {
        let s = newSym("var", params[i].name, params[i].typ)
        s.storage = "local"
        s.isParam = true
        s.offset = 16 + 8 * (n - 1 - i)
        declare(s)
        if params[i].mode > 0 {
            s.isRef = true                         // borrowed: not freed here
            s.bind = singleBind(s, false, "", params[i].mode == 2, nil)
            s.kind = "let"
        } else if isOwned(params[i].typ) {
            addOwnedLocal(s)
        }
        if params[i].typ.kind == "string" { addStrLocal(s) }
        if params[i].mode == 0 && (params[i].typ.kind == "int" || params[i].typ.kind == "bool") {
            let h = pickHome(params[i].name, true)
            if h >= 0 {
                s.home = h
                opMem(0x8B, h, mem(RBP, -1, s.offset, 8), true, false)      // the argument, from the stack
            }
        }
    }
    expect(T_LBRACE, "")
    openBlock()
    let term = statSeq()
    expect(T_RBRACE, "")
    if !term && ret != tVoid { error(name + " must return a value on every path") }
    closeBlock(term)
    closeBlock(term)
    homeBits = 0
    if homeRetry {
        truncate(bindArena, bindMark)
        truncate(symArena, symMark)
        return true
    }
    if !term { epilogue() }
    let size = (frame + 15) & ~15
    if size == 0 {
        dropFrame(frameAt)
    } else {
        code[frameAt] = byte(size)
        code[frameAt + 1] = byte(size >> 8)
        code[frameAt + 2] = byte(size >> 16)
        code[frameAt + 3] = byte(size >> 24)
    }
    if pendLine > 0 && f.writesHandles { errorAt(pendMsg, pendLine, pendCol) }
    pendLine = 0
    curFn = nil
    truncate(bindArena, bindMark)
    truncate(symArena, symMark)                 // and nothing refers to them any more
    return false
}


fn fnDecl() {
    let hline = tline
    let name = ident()
    let params = new []Param(0)
    expect(T_LPAREN, "")
    while sym != T_RPAREN {
        // `mut` before the names: the function may change what the parameter points to
        var pmut = false
        if sym == T_IDENT && sval == "mut" {
            next()
            pmut = true
        }
        let names = new []string(0)
        append(names, ident())
        while sym == T_COMMA {
            next()
            append(names, ident())
        }
        expect(T_COLON, "")
        let t = parseRefType()
        var mode = refMode
        if pmut {
            if mode == 0 { error("mut needs a reference parameter: write mut name: &T") }
            mode = 2
        }
        for n in names { append(params, new Param{name: n, typ: t, mode: mode}) }
        if sym != T_RPAREN { expect(T_COMMA, "',' or ')'") }
    }
    expect(T_RPAREN, "")
    var ret = tVoid
    if sym == T_COLON {
        next()
        ret = parseType()
    }
    let prior = findSym(globals, name)
    var f = newSym("fn", name, nil)
    if prior != nil && prior.kind == "fn" && prior.addr < 0 {
        f = prior
        var ok = len(f.params) == len(params) && same(f.ret, ret)
        if ok {
            for i in 0..len(params) {
                if !same(f.params[i], params[i].typ) || f.pmodes[i] != params[i].mode { ok = false }
            }
        }
        if !ok { error("'" + name + "' does not match its forward heading") }
    } else {
        declare(f)
        for p in params {
            append(f.params, p.typ)
            append(f.pmodes, p.mode)
        }
        f.ret = ret
        f.line = hline
    }
    if sym != T_LBRACE { return }
    if f.addr >= 0 { error("'" + name + "' is already defined") }
    f.addr = pc()
    for fi in 0..len(f.fixups) { fix(f.fixups[fi], f.addr) }   // calls waiting for this address
    curFn = f
    // what a pass over the body changes and a second pass must find as it was
    let sPos = pos
    let sLine = line
    let sCol = col
    let sLast = last
    let sSym = sym
    let sSval = sval
    let sIval = ival
    let sTline = tline
    let sTcol = tcol
    let sSelf = selfCalls
    let sUser = userCalls
    let sUse = useSeq
    let sFwd = fwdCalls
    let sFreed = len(f.freed)
    let sAll = f.freesAll
    let sWrites = f.writesHandles
    homeRetry = false
    if fnBody(f, name, ret, &params, true) {
        truncate(code, f.addr)
        let gs = &globals
        for g in gs {
            if g.kind == "fn" && g.addr < 0 {
                while len(g.fixups) > 0 && g.fixups[len(g.fixups) - 1] >= f.addr { truncate(g.fixups, len(g.fixups) - 1) }
            }
        }
        truncate(f.freed, sFreed)
        f.freesAll = sAll
        f.writesHandles = sWrites
        selfCalls = sSelf
        userCalls = sUser
        useSeq = sUse
        fwdCalls = sFwd
        pos = sPos
        line = sLine
        col = sCol
        last = sLast
        sym = sSym
        sval = sSval
        ival = sIval
        tline = sTline
        tcol = sTcol
        homeRetry = false
        homeBits = 0
        setFree(0)
        fnBody(f, name, ret, &params, false)
    }
    curFn = nil
}

fn constDecl() {
    let name = ident()
    expect(T_ASSIGN, "")
    let x = expression()
    if x.mode != "const" { error("constant value must be known at compile time") }
    let s = newSym("const", name, x.typ)
    s.value = x.val
    declare(s)
}

fn compileModule() {
    emit(0x48)
    emit(0x89)
    emit(0xE7)
    emit(0xBE)
    emit32(GLOBAL_BASE)
    emit(0xBA)
    let gendAt = pc()
    emit32(0)
    callAbs(RT_TEXT + 8 * RT_INIT)
    initLink = jmp()
    skipSemis()
    if sym == T_MODULE {
        next()
        ident()
        expect(T_SEMI, "newline")
    }
    skipSemis()
    while sym != T_EOF {
        if sym == T_PUB { next() }
        let k = sym
        match k {
            T_IMPORT { error("imports are not supported yet") }
            T_FN {
                next()
                fnDecl()
            }
            T_TYPE {
                next()
                typeDecl()
            }
            T_VAR, T_LET {
                next()
                varDecl(tokName(k), true)
            }
            T_CONST {
                next()
                constDecl()
            }
            else { error("expected a declaration") }
        }
        if sym != T_EOF { expect(T_SEMI, "newline") }
        skipSemis()
    }
    {
        let syms = &globals
        for s in syms {
            if s.kind == "type" && symType(s).incomplete {
                errorAt("type '" + s.name + "' is declared but never defined", symType(s).line, 1)
            }
            if s.kind == "fn" && s.addr < 0 {
                errorAt("function '" + s.name + "' has a forward heading but no body", s.line, 1)
            }
        }
    }
    let m = findSym(globals, "main")
    if m == nil || m.kind != "fn" || len(m.params) > 0 || m.ret != tVoid {
        var l = 1
        if m != nil && m.kind == "fn" { l = m.line }
        errorAt("the program needs 'fn main()' with no parameters or result", l, 1)
        return
    }
    fixHere1(initLink)
    emit(0xE8)
    emit32(m.addr - (pc() + 4))
    depth = 0
    let gs = &globals
    for g in gs {
        if (g.kind == "var" || g.kind == "let") && isOwned(symType(g)) {
            let x = newItem("mem", symType(g))
            x.disp = g.offset
            rtCall1(RT_FREE, x, tVoid)
        }
        if (g.kind == "var" || g.kind == "let") && symType(g).kind == "string" {
            let x = newItem("mem", tString)
            x.disp = g.offset
            rtCall1(RT_STR_DEC, x, tVoid)
        }
    }
    callAbs(RT_TEXT + 8 * RT_FINISH)
    let gend = GLOBAL_BASE + gsize
    code[gendAt] = byte(gend)
    code[gendAt + 1] = byte(gend >> 8)
    code[gendAt + 2] = byte(gend >> 16)
    code[gendAt + 3] = byte(gend >> 24)
}

// ============================================================= ELF output

fn put16(mut b: &[]byte, v: int) {
    append(b, byte(v))
    append(b, byte(v >> 8))
}

fn put32(mut b: &[]byte, v: int) {
    put16(b, v)
    put16(b, v >> 16)
}

fn put64(mut b: &[]byte, v: int) {
    put32(b, v)
    put32(b, v >> 32)
}

fn pageUp(n: int): int { return (n + 0xFFF) / 0x1000 * 0x1000 }

fn phdr(mut ph: &[]byte, flags: int, off: int, vaddr: int, filesz: int, memsz: int) {
    put32(ph, 1)
    put32(ph, flags)
    put64(ph, off)
    put64(ph, vaddr)
    put64(ph, vaddr)
    put64(ph, filesz)
    put64(ph, memsz)
    put64(ph, 0x1000)
}

// copies a part of the image into place
fn copyAt(mut out: &[]byte, at: int, data: &[]byte) {
    for i in 0..len(data) { out[at + i] = data[i] }
}

// Same layout as obx.py: headers and code, then rodata, the globals
// (memory only), and the runtime's code and data at fixed addresses. Each part
// starts on a page, and the image is allocated once, at its final size.
fn elfImage(rtText: []byte, rtData: []byte): []byte {
    let codeAt = 0x1000
    let roAt = pageUp(codeAt + len(code))
    var roLen = len(rodata)
    if roLen == 0 { roLen = 1 }                      // an empty segment still gets one byte
    let rtTextAt = pageUp(roAt + roLen)
    let rtDataAt = pageUp(rtTextAt + len(rtText))
    let out = new []byte(rtDataAt + len(rtData))
    copyAt(out, codeAt, code)
    copyAt(out, roAt, rodata)
    copyAt(out, rtTextAt, rtText)
    copyAt(out, rtDataAt, rtData)
    let ph = new []byte(0)
    phdr(ph, 5, 0, IMAGE_BASE, codeAt + len(code), codeAt + len(code))
    phdr(ph, 4, roAt, RODATA_BASE, roLen, roLen)
    var gmem = gsize
    if gmem < 8 { gmem = 8 }
    phdr(ph, 6, 0, GLOBAL_BASE, 0, gmem)
    phdr(ph, 5, rtTextAt, RT_TEXT, len(rtText), len(rtText))
    phdr(ph, 6, rtDataAt, RT_DATA, len(rtData), len(rtData))
    put32(ph, 0x6474E551)
    put32(ph, 6)
    for i in 0..5 { put64(ph, 0) }
    put64(ph, 16)
    let eh = new []byte(0)
    append(eh, 0x7F)
    append(eh, 'E')
    append(eh, 'L')
    append(eh, 'F')
    append(eh, 2)
    append(eh, 1)
    append(eh, 1)
    for i in 0..9 { append(eh, 0) }
    put16(eh, 2)
    put16(eh, 0x3E)
    put32(eh, 1)
    put64(eh, CODE_BASE)
    put64(eh, 64)
    put64(eh, 0)
    put32(eh, 0)
    put16(eh, 64)
    put16(eh, 56)
    put16(eh, 6)
    put16(eh, 64)
    put16(eh, 0)
    put16(eh, 0)
    for i in 0..len(eh) { out[i] = eh[i] }
    for i in 0..len(ph) { out[64 + i] = ph[i] }
    return out
}

fn dirOf(path: string): string {
    var i = len(path) - 1
    while i >= 0 && path[i] != '/' { i -= 1 }
    if i < 0 { return "." }
    return substr(path, 0, i)
}

fn compileFile(path: string, out: string, rtDir: string) {
    srcPath = path
    let data = readFile(path)
    if data == nil {
        eprintln("obxc: cannot read ", path)
        exit(2)
    }
    let rtText = readFile(rtDir + "/runtime_text.bin")
    let rtData = readFile(rtDir + "/runtime_data.bin")
    if rtText == nil || rtData == nil {
        eprintln("obxc: cannot read the runtime from ", rtDir)
        exit(2)
    }
    startScanner(data)
    compileModule()
    src = ""                       // the source is no longer read: free it before the image is built
    let image = elfImage(rtText, rtData)
    if !writeFile(out, image, true) {
        eprintln("obxc: cannot write ", out)
        exit(2)
    }
}

fn main() {
    initCompiler()
    let a = args()
    if len(a) == 3 && (a[1] == "--tokens" || a[1] == "--encode") {
        let data = readFile(a[2])
        if data == nil {
            eprintln("obxc: cannot read ", a[2])
            exit(2)
        }
        if a[1] == "--tokens" {
            dumpTokens(data)
        } else {
            runEncoderScript(data)
        }
        return
    }
    // obxc SOURCE [-o OUTPUT] [--rt RUNTIME_DIR]
    if len(a) >= 2 && a[1][0] != '-' {
        let path = a[1]
        var out = path
        if len(out) > 4 && substr(out, len(out) - 4, len(out)) == ".obx" { out = substr(out, 0, len(out) - 4) }
        var rtDir = dirOf(a[0])
        var i = 2
        while i + 1 < len(a) {
            if a[i] == "-o" {
                out = a[i + 1]
            } else if a[i] == "--rt" {
                rtDir = a[i + 1]
            } else {
                eprintln("obxc: unknown option ", a[i])
                exit(2)
            }
            i += 2
        }
        compileFile(path, out, rtDir)
        return
    }
    eprintln("usage: obxc SOURCE [-o OUTPUT] [--rt RUNTIME_DIR] | --tokens FILE | --encode FILE")
    exit(2)
}
