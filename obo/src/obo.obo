module obo

// obo: the ownership language, compiler written in obo (see FORK.md).
//
// Part 1: the scanner and the x86-64 encoder, with two test modes that are
// compared against the Python compiler (tests/selfhost_test.py):
//
//     obxc --tokens FILE     one line per token, as obx.py --tokens prints them
//     obxc --encode FILE     runs a script of encoder calls, one hex line each

// ============================================================== utilities

fn hexDigit(v: int): byte {
    if v < 10 { return byte('0' + v) }
    return byte('a' + v - 10)
}

fn hexOf(b: &[]byte, from: int, to: int): string {
    let out = new []byte(0)
    for i in from..to {
        append(out, hexDigit(b[i] >> 4))
        append(out, hexDigit(b[i] & 15))
    }
    return string(out)
}

fn bytesOf(s: string): []byte {
    let out = new []byte(0)
    for i in 0..len(s) { append(out, s[i]) }
    return out
}

// ================================================================ scanner

// token kinds
const T_EOF = 0
const T_IDENT = 1
const T_INT = 2
const T_CHAR = 3
const T_STRING = 4
const T_MODULE = 5
const T_IMPORT = 6
const T_PUB = 7
const T_TYPE = 8
const T_VAR = 9
const T_LET = 10
const T_CONST = 11
const T_FN = 12
const T_RETURN = 13
const T_IF = 14
const T_ELSE = 15
const T_WHILE = 16
const T_FOR = 17
const T_IN = 18
const T_BREAK = 19
const T_CONTINUE = 20
const T_DEFER = 21
const T_MATCH = 22
const T_REF = 23
const T_RECORD = 24
const T_CLOSED = 25
const T_NEW = 26
const T_NIL = 27
const T_TRUE = 28
const T_FALSE = 29
const T_LPAREN = 30
const T_RPAREN = 31
const T_LBRACE = 32
const T_RBRACE = 33
const T_LBRACK = 34
const T_RBRACK = 35
const T_COMMA = 36
const T_SEMI = 37
const T_COLON = 38
const T_DOT = 39
const T_DOTDOT = 40
const T_ASSIGN = 41
const T_EQ = 42
const T_NE = 43
const T_LT = 44
const T_LE = 45
const T_GT = 46
const T_GE = 47
const T_PLUS = 48
const T_MINUS = 49
const T_STAR = 50
const T_SLASH = 51
const T_PERCENT = 52
const T_NOT = 53
const T_QUESTION = 54
const T_AMP = 55
const T_BAR = 56
const T_CARET = 57
const T_TILDE = 58
const T_ANDAND = 59
const T_OROR = 60
const T_PLUSEQ = 61
const T_MINUSEQ = 62
const T_STAREQ = 63
const T_SHL = 64
const T_SHR = 65
const T_TRY = 66
const T_COLONCOLON = 67

// Stage 2: the symbol-file format, the compiled-program ABI and the compiler version.
// OBO_VERSION is the compiler's identity in every .sym's `compiler` line and in --version.
// Bump OBO_VERSION with each merged compiler feature; additive builtin/runtime
// extensions use a patch release (0.8 -> 0.8.1); 0.9 is lambdas Stage A and 0.10 is
// Stage B. Bump SYM_FORMAT on any grammar or meaning change; bump SYM_ABI on
// any layout/calling-convention/descriptor/effect change.
const OBO_VERSION = "0.9"
const SYM_FORMAT = 5
const SYM_ABI = 1

fn makeTokNames(): []string {
    let k = new []string(0)
    let names = "eof ident int char string module import pub type var let const fn return if else while for in break continue defer match ref record closed new nil true false ( ) { } [ ] , ; : . .. = == != < <= > >= + - * / % ! ? & | ^ ~ && || += -= *= << >> try ::"
    var start = 0
    for i in 0..len(names) + 1 {
        if i == len(names) || names[i] == ' ' {
            append(k, substr(names, start, i))
            start = i + 1
        }
    }
    return k
}

let tokNames = makeTokNames()

fn tokName(k: int): string { return tokNames[k] }


var src = ""                  // the source text, read by index
var pos = 0
var line = 1
var col = 1
var last = -1             // kind of the previous token
var sym = -1              // kind of the current token: "ident", "int", "==", "fn", ...
var sval = ""             // identifier text or string literal bytes
var ival = 0              // integer or character value
var tokSeq = 0                   // the tokens read so far (the index of the current one)
var tline = 0             // where the current token starts
var tcol = 0
var tokStart = 0          // where the current token's text starts in src (the .sym reader checks hex forms)
var dumpMode = false

fn makeKeywords(): []string {
    let k = new []string(0)
    let words = "module import pub type var let const fn return if else while for in break continue defer match ref record closed new nil true false try"
    var start = 0
    for i in 0..len(words) + 1 {
        if i == len(words) || words[i] == ' ' {
            append(k, substr(words, start, i))
            start = i + 1
        }
    }
    return k
}

let keywords = makeKeywords()


// the token number of a keyword, or T_IDENT for any other word. try is the 66th token, after the
// punctuation, so it cannot be T_MODULE + its place in the keyword list (that is T_LPAREN's number)
fn keywordTok(w: string): int {
    if w == "try" { return T_TRY }
    for i in 0..len(keywords) {
        if keywords[i] == w { return T_MODULE + i }
    }
    return T_IDENT
}

var srcPath = ""

// true while a .sym file is being read: its errors are symbol-file errors (exit 2), not
// source errors (exit 1), and name the file with the obxc: prefix
var symMode = false

// reports an error at line l, column c (0 means the current token) and stops
fn errorAt(msg: string, l: int, c: int) {
    var ln = l
    var cn = c
    if ln == 0 { ln = tline }
    if cn == 0 { cn = tcol }
    if dumpMode {
        println(ln, ":", cn, " error ", msg)
    } else if symMode {
        eprintln("obxc: ", srcPath, ":", ln, ":", cn, ": symbol file: ", msg)
    } else {
        eprintln(srcPath, ":", ln, ":", cn, ": ", msg)
    }
    if symMode { exit(2) }
    exit(1)
}

fn fail(msg: string) { errorAt(msg, 0, 0) }

fn isLetter(c: int): bool { return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_' }
fn isDigit(c: int): bool { return c >= '0' && c <= '9' }
fn isHex(c: int): bool { return isDigit(c) || c >= 'a' && c <= 'f' || c >= 'A' && c <= 'F' }

fn hexVal(c: int): int {
    if isDigit(c) { return c - '0' }
    if c >= 'a' { return c - 'a' + 10 }
    return c - 'A' + 10
}

// the byte k places ahead, or -1 past the end
fn peek(k: int): int {
    if pos + k < len(src) { return src[pos + k] }
    return -1
}

fn advance() {
    if src[pos] == '\n' {
        line += 1
        col = 1
    } else {
        col += 1
    }
    pos += 1
}

// a newline after one of these ends the statement
// a newline after one of these ends the statement
fn semiAfter(k: int): bool {
    match k {
        T_IDENT, T_INT, T_CHAR, T_STRING, T_TRUE, T_FALSE, T_NIL, T_RETURN, T_BREAK, T_CONTINUE,
        T_RPAREN, T_RBRACK, T_RBRACE { return true }
        else { return false }
    }
}

fn setTok(k: int) {
    tokSeq += 1
    sym = k
    last = k
}

fn escape(c: int): int {
    match c {
        'n' { return '\n' }
        't' { return '\t' }
        'r' { return '\r' }
        '\\', '"', '\'' { return c }
        '0' { return 0 }
        else { return -1 }
    }
}

// two-character operators, or -1
fn punct2(a: int, b: int): int {
    if b == '=' {
        match a {
            '=' { return T_EQ }
            '!' { return T_NE }
            '<' { return T_LE }
            '>' { return T_GE }
            '+' { return T_PLUSEQ }
            '-' { return T_MINUSEQ }
            '*' { return T_STAREQ }
        }
    }
    if a == b {
        match a {
            '.' { return T_DOTDOT }
            '&' { return T_ANDAND }
            '|' { return T_OROR }
            '<' { return T_SHL }
            '>' { return T_SHR }
            ':' { return T_COLONCOLON }
        }
    }
    return -1
}

// one-character operators and punctuation, or -1
fn punct1(c: int): int {
    match c {
        '(' { return T_LPAREN }
        ')' { return T_RPAREN }
        '{' { return T_LBRACE }
        '}' { return T_RBRACE }
        '[' { return T_LBRACK }
        ']' { return T_RBRACK }
        ',' { return T_COMMA }
        ';' { return T_SEMI }
        ':' { return T_COLON }
        '.' { return T_DOT }
        '=' { return T_ASSIGN }
        '<' { return T_LT }
        '>' { return T_GT }
        '+' { return T_PLUS }
        '-' { return T_MINUS }
        '*' { return T_STAR }
        '/' { return T_SLASH }
        '%' { return T_PERCENT }
        '!' { return T_NOT }
        '?' { return T_QUESTION }
        '&' { return T_AMP }
        '|' { return T_BAR }
        '^' { return T_CARET }
        '~' { return T_TILDE }
        else { return -1 }
    }
}

fn scanNumber() {
    var v = 0
    if src[pos] == '0' && (peek(1) == 'x' || peek(1) == 'X') {
        advance()
        advance()
        var any = false
        var significant = 0
        while pos < len(src) && (isHex(src[pos]) || src[pos] == '_') {
            let d = src[pos]
            if d != '_' {
                any = true
                if significant > 0 || d != '0' { significant += 1 }
                v = (v << 4) | hexVal(d)
            }
            advance()
        }
        if !any { fail("hex literal needs digits") }
        if significant > 16 { fail("integer literal too large") }
    } else {
        var big = false
        while pos < len(src) && (isDigit(src[pos]) || src[pos] == '_') {
            let d = src[pos]
            if d != '_' {
                let dv = d - '0'
                if v > (9223372036854775807 - dv) / 10 {
                    big = true
                } else {
                    v = v * 10 + dv
                }
            }
            advance()
        }
        if big { fail("integer literal too large") }
    }
    ival = v
    setTok(T_INT)
}

fn scanChar() {
    advance()
    if pos >= len(src) || src[pos] == '\'' || src[pos] == '\n' { fail("empty character literal") }
    var ch = int(src[pos])
    if ch == '\\' {
        advance()
        if pos >= len(src) { fail("unknown escape in character literal") }
        ch = escape(src[pos])
        if ch < 0 { fail("unknown escape in character literal") }
    } else if ch >= 128 {
        fail("character literal must be a single byte")
    }
    advance()
    if pos >= len(src) || src[pos] != '\'' { fail("unterminated character literal") }
    advance()
    ival = ch
    setTok(T_CHAR)
}

fn scanString() {
    advance()
    let buf = new []byte(0)
    while true {
        if pos >= len(src) || src[pos] == '\n' { fail("unterminated string") }
        let ch = src[pos]
        if ch == '"' {
            advance()
            break
        }
        if ch == '\\' {
            advance()
            if pos >= len(src) || src[pos] == '\n' { fail("unterminated string") }
            let e = escape(src[pos])
            if e < 0 {
                append(buf, src[pos])
            } else {
                append(buf, byte(e))
            }
        } else {
            append(buf, ch)
        }
        advance()
    }
    sval = string(buf)
    setTok(T_STRING)
}

fn upper(s: string): string {
    let b = new []byte(0)
    for i in 0..len(s) {
        let c = s[i]
        if c >= 'a' && c <= 'z' {
            append(b, byte(c - 'a' + 'A'))
        } else {
            append(b, c)
        }
    }
    return string(b)
}

fn next() {
    while true {
        while pos < len(src) {
            let c = src[pos]
            if c != ' ' && c != '\t' && c != '\r' && c != '\n' { break }
            if c == '\n' && semiAfter(last) {
                tline = line
                tcol = col
                tokStart = pos
                advance()
                setTok(T_SEMI)
                return
            }
            advance()
        }
        if peek(0) == '/' && peek(1) == '/' {
            while pos < len(src) && src[pos] != '\n' { advance() }
            continue
        }
        break
    }
    tline = line
    tcol = col
    tokStart = pos
    if pos >= len(src) {
        if semiAfter(last) {
            setTok(T_SEMI)
        } else {
            setTok(T_EOF)
        }
        return
    }
    let c = src[pos]
    if isLetter(c) {
        let start = pos
        while pos < len(src) && (isLetter(src[pos]) || isDigit(src[pos])) { advance() }
        sval = substr(src, start, pos)
        setTok(keywordTok(sval))
    } else if isDigit(c) {
        scanNumber()
    } else if c == '\'' {
        scanChar()
    } else if c == '"' {
        scanString()
    } else {
        let p = punct2(c, peek(1))
        let p1 = punct1(c)
        if p >= 0 {
            advance()
            advance()
            setTok(p)
        } else if p1 >= 0 {
            advance()
            setTok(p1)
        } else if c >= 33 && c <= 126 {
            fail("unexpected character '" + substr(src, pos, pos + 1) + "'")
        } else {
            let b = new []byte(0)
            append(b, hexDigit(c >> 4))
            append(b, hexDigit(c & 15))
            fail("unexpected character 0x" + upper(string(b)))
        }
    }
}

fn startScanner(source: []byte) {
    src = string(source)
    pos = 0
    line = 1
    col = 1
    last = -1
    next()
}

fn dumpTokens(source: []byte) {
    dumpMode = true
    startScanner(source)
    while true {
        print(tline, ":", tcol, " ", tokName(sym))
        if sym == T_IDENT {
            print(" ", sval)
        } else if sym == T_INT || sym == T_CHAR {
            print(" ", ival)
        } else if sym == T_STRING {
            let b = bytesOf(sval)
            print(" ", len(b), ":", hexOf(b, 0, len(b)))
        }
        println()
        if sym == T_EOF { return }
        next()
    }
}

// ================================================================ encoder

// A memory operand: [base + index*scale + disp]; base -1 means an absolute
// address in disp, index -1 means no index.
type Mem = ref record { base, index, disp, scale: int }

// The code, in chunks of CHUNK bytes, each allocated at its full size: growing the code never
// copies it, as a doubling buffer would, which holds the old block and the new one at once.
// code holds the full chunks; the last one is written in cur, of which curLen bytes are code.
const CHUNK_BITS = 14
const CHUNK = 0x4000
type Chunk = ref record { b: []byte }
var code = new []Chunk(0)
var cur = new []byte(CHUNK)
var curLen = 0
var codeBase = 0                    // where cur starts: CHUNK times len(code)

// The peephole (FORK.md, "Peephole pass"). `x = x op y` on a local in a register compiles to a copy of the
// local into a temporary, the operation on the temporary and a copy back; the store folds the three into
// one operation on the local. The emitters note what they emitted last, so that nothing is decoded, and
// the record is valid only while the code ends where the operation does (foldEnd == here()), nothing
// has asked for a position since the copy began (barrier <= foldAt: a position is a jump target or a
// patch point, and the fold would move or remove what is after it) and the code was not cut back.
var barrier = 0                     // the last position pc() gave out
var cpAt = -1                       // the last copy of a local's register into a temporary: start, end,
var cpEnd = -1                      // the temporary and the local
var cpDst = 0
var cpSrc = 0
var foldAt = 0                      // the operation on that copy, noted by binop: where the copy began,
var foldEnd = -1                    // where the operation ended (-1: none), the local, the temporary,
var foldHome = 0
var foldT = 0
var foldForm = 0                    // 1 alu with an immediate, 2 register operand, 3 imul by an immediate
var foldOpc = 0                     // the alu code (form 1) or the opcode (form 2)
var foldArg = 0                     // the immediate, or the operand register

fn emit(b: int) {
    cur[curLen] = byte(b)
    curLen += 1
    if curLen == CHUNK {
        let full = new []byte(CHUNK)
        for i in 0..CHUNK { full[i] = cur[i] }
        append(code, new Chunk{b: full})
        codeBase += CHUNK
        curLen = 0
    }
}

fn codeByte(at: int): byte {
    if at >= codeBase { return cur[at - codeBase] }
    return code[at >> CHUNK_BITS].b[at & (CHUNK - 1)]
}

fn setCode(at: int, v: int) {
    if at >= codeBase {
        cur[at - codeBase] = byte(v)
    } else {
        code[at >> CHUNK_BITS].b[at & (CHUNK - 1)] = byte(v)
    }
}

// cuts the code back to n bytes: the chunk n is in becomes cur again
fn truncCode(n: int) {
    cpEnd = -1
    foldEnd = -1
    if n < codeBase {
        let k = n >> CHUNK_BITS
        for i in 0..CHUNK { cur[i] = code[k].b[i] }
        truncate(code, k)
        codeBase = k << CHUNK_BITS
    }
    curLen = n - codeBase
}

fn emit32(v: int) {
    emit(v)
    emit(v >> 8)
    emit(v >> 16)
    emit(v >> 24)
}

fn emit64(v: int) {
    emit32(v)
    emit32(v >> 32)
}

fn fits8(v: int): bool { return v >= -128 && v < 128 }
fn fits32(v: int): bool { return v >= -2147483648 && v < 2147483648 }

// a position that is not asked for as a label or a patch point (pc() is: see barrier)
fn here(): int { return codeBase + curLen }

fn pc(): int {
    barrier = codeBase + curLen
    return barrier
}

fn emitOpcode(opc: int) {
    if opc > 255 { emit(opc >> 8) }
    emit(opc & 255)
}

fn rex(w: bool, reg: int, x: int, b: int, force: bool) {
    var r = 0x40
    if w { r = r | 8 }
    r = r | ((reg >> 3) & 1) << 2 | ((x >> 3) & 1) << 1 | ((b >> 3) & 1)
    if r != 0x40 || force { emit(r) }
}

// opcode with a register as the r/m operand
fn opReg(opc: int, reg: int, rm: int, w: bool, byteReg: bool) {
    rex(w, reg, 0, rm, byteReg && (rm >= 4 && rm <= 7 || opc == 0x88 && reg >= 4 && reg <= 7))
    emitOpcode(opc)
    emit(0xC0 | (reg & 7) << 3 | (rm & 7))
}

// opcode with a memory r/m operand
fn opMem(opc: int, reg: int, m: Mem, w: bool, byteReg: bool) {
    var x = 0
    var b = 0
    if m.index >= 0 { x = m.index }
    if m.base >= 0 { b = m.base }
    rex(w, reg, x, b, byteReg && opc == 0x88 && reg >= 4 && reg <= 7)
    emitOpcode(opc)
    if m.base < 0 && m.index < 0 {
        emit(0x04 | (reg & 7) << 3)
        emit(0x25)
        emit32(m.disp)
        return
    }
    var mod = 2
    if m.disp == 0 && (m.base & 7) != 5 {
        mod = 0
    } else if fits8(m.disp) {
        mod = 1
    }
    if m.index >= 0 {
        var ss = 3
        if m.scale == 1 { ss = 0 } else if m.scale == 2 { ss = 1 } else if m.scale == 4 { ss = 2 }
        emit(mod << 6 | (reg & 7) << 3 | 4)
        emit(ss << 6 | (m.index & 7) << 3 | (m.base & 7))
    } else if (m.base & 7) == 4 {
        emit(mod << 6 | (reg & 7) << 3 | 4)
        emit(0x24)
    } else {
        emit(mod << 6 | (reg & 7) << 3 | (m.base & 7))
    }
    if mod == 1 {
        emit(m.disp)
    } else if mod == 2 {
        emit32(m.disp)
    }
}

fn movRI(r: int, v: int) {
    if v >= 0 && v < 0x100000000 {
        if r >= 8 { emit(0x41) }
        emit(0xB8 + (r & 7))
        emit32(v)
    } else if fits32(v) {
        opReg(0xC7, 0, r, true, false)
        emit32(v)
    } else {
        emit(0x48 | (r >> 3))
        emit(0xB8 + (r & 7))
        emit64(v)
    }
}

fn aluRI(o: int, r: int, v: int) {
    if fits8(v) {
        opReg(0x83, o, r, true, false)
        emit(v)
    } else {
        opReg(0x81, o, r, true, false)
        emit32(v)
    }
}

fn aluMI(o: int, m: Mem, v: int) {
    if fits8(v) {
        opMem(0x83, o, m, true, false)
        emit(v)
    } else {
        opMem(0x81, o, m, true, false)
        emit32(v)
    }
}

fn push(r: int) {
    if r >= 8 { emit(0x41) }
    emit(0x50 + (r & 7))
}

fn pop(r: int) {
    if r >= 8 { emit(0x41) }
    emit(0x58 + (r & 7))
}

// push imm8 or imm32, sign-extended to 64 bits
fn pushI(v: int) {
    if fits8(v) {
        emit(0x6A)
        emit(v)
    } else {
        emit(0x68)
        emit32(v)
    }
}

// jumps leave a zero rel32 and return its position for fix()
fn jcc(cc: int): int {
    emit(0x0F)
    emit(0x80 + cc)
    emit32(0)
    return pc() - 4
}

fn jmp(): int {
    emit(0xE9)
    emit32(0)
    return pc() - 4
}

// A jump's rel32 field holds its displacement once the target is known, and until then
// the position of the next jump waiting for the same target (waitJump): 0 after the last.
fn putRel(at: int, v: int) {
    setCode(at, v)
    setCode(at + 1, v >> 8)
    setCode(at + 2, v >> 16)
    setCode(at + 3, v >> 24)
}

fn getRel(at: int): int {
    return int(codeByte(at)) | (int(codeByte(at + 1)) << 8) | (int(codeByte(at + 2)) << 16) | (int(codeByte(at + 3)) << 24)
}

fn fix(at: int, target: int) { putRel(at, target - (at + 4)) }

fn callLocal(target: int) {
    emit(0xE8)
    emit32(target - (pc() + 4))
}

// ========================================================== encoder tests

// splits a line into space-separated words
fn words(s: string): []string {
    let out = new []string(0)
    var start = -1
    for i in 0..len(s) + 1 {
        let space = i == len(s) || s[i] == ' '
        if space && start >= 0 {
            append(out, substr(s, start, i))
            start = -1
        } else if !space && start < 0 {
            start = i
        }
    }
    return out
}

// decimal with an optional sign, or hex with a 0x prefix
fn parseInt(s: string): int {
    var i = 0
    var neg = false
    if s[0] == '-' {
        neg = true
        i = 1
    }
    var v = 0
    if len(s) > i + 1 && s[i] == '0' && s[i + 1] == 'x' {
        for k in i + 2..len(s) { v = (v << 4) | hexVal(s[k]) }
    } else {
        for k in i..len(s) { v = v * 10 + (s[k] - '0') }
    }
    if neg { return -v }
    return v
}

// "r:N" or "m:BASE,INDEX,DISP,SCALE"
fn parseMem(spec: string): ?Mem {
    if spec[0] == 'r' { return nil }
    let parts = new []int(0)
    var start = 2
    for i in 2..len(spec) + 1 {
        if i == len(spec) || spec[i] == ',' {
            append(parts, parseInt(substr(spec, start, i)))
            start = i + 1
        }
    }
    return new Mem{base: parts[0], index: parts[1], disp: parts[2], scale: parts[3]}
}

fn regOf(spec: string): int { return parseInt(substr(spec, 2, len(spec))) }

fn emitHex(h: string) {
    if h == "-" { return }
    var i = 0
    while i < len(h) {
        emit(hexVal(h[i]) << 4 | hexVal(h[i + 1]))
        i += 2
    }
}

// op OPC REG RM W BYTE IMM | movri R V | aluri O RM V | push R | pushi V | pop R
// | jcc CC T | jmp T | call T
fn runEncoderLine(l: string) {
    let w = words(l)
    let k = w[0]
    if k == "op" {
        let opc = parseInt(w[1])
        let reg = parseInt(w[2])
        let m = parseMem(w[3])
        let wide = w[4] == "1"
        let byteReg = w[5] == "1"
        if m != nil {
            opMem(opc, reg, m, wide, byteReg)
        } else {
            drop(m)
            opReg(opc, reg, regOf(w[3]), wide, byteReg)
        }
        emitHex(w[6])
    } else if k == "movri" {
        movRI(parseInt(w[1]), parseInt(w[2]))
    } else if k == "aluri" {
        let m = parseMem(w[2])
        if m != nil {
            aluMI(parseInt(w[1]), m, parseInt(w[3]))
        } else {
            drop(m)
            aluRI(parseInt(w[1]), regOf(w[2]), parseInt(w[3]))
        }
    } else if k == "push" {
        push(parseInt(w[1]))
    } else if k == "pushi" {
        pushI(parseInt(w[1]))
    } else if k == "pop" {
        pop(parseInt(w[1]))
    } else if k == "jcc" {
        fix(jcc(parseInt(w[1])), parseInt(w[2]))
    } else if k == "jmp" {
        fix(jmp(), parseInt(w[1]))
    } else if k == "call" {
        callLocal(parseInt(w[1]))
    } else {
        eprintln("unknown encoder command: ", k)
        exit(2)
    }
}

fn runEncoderScript(script: []byte) {
    var start = 0
    for i in 0..len(script) {
        if script[i] == '\n' {
            let before = pc()
            let l = new []byte(0)
            for k in start..i { append(l, script[k]) }
            runEncoderLine(string(l))
            let b = new []byte(0)
            for k in before..pc() { append(b, codeByte(k)) }
            println(hexOf(b, 0, len(b)))
            start = i + 1
        }
    }
}

// ================================================================== types

// the module whose source is being parsed (section 13): type and symbol diagnostics qualify a
// name from another module as owner::name, and keep the bare name inside its own module
var curModuleName = ""

type Type
type Sym
type RefBind
type FnRec
type PState

type Param = ref record {
    name: string
    typ: ^Type
    mode: int                 // 0 owned, 1 &, 2 mut
}

var fnStack = new []^Sym(0)       // functions and lambda bodies being compiled, for active-callee checks
var lambdaOuterNames = new []string(0)  // enclosing local/parameter names while a lambda body compiles

type Field = ref record {
    name: string
    offset: int
    typ: ^Type
}

type Type = ref record {
    kind: string              // int byte bool string void nil record closed iface array opt result resultctor errval
    name: string
    owner: string             // the module a named type belongs to; "" for primitives, derived and built-ins
    uid: int                  // FNV-1a 64 of owner + "::" + name; 0 when the type has no key (B7: aliases never set it)
    base: ?^Type               // element type (array) or underlying type (opt, result)
    fields: []Field           // record, in declaration order
    parent: ?^Type             // record: the closed type it is a variant of
    variants: []^Type          // closed, result
    desc: int                 // record: address of its type descriptor
    incomplete: bool          // declared by 'type Name', not yet defined
    line: int
    arrayOf, optOf, handleOf, resultOf: ?^Type   // the types made from this one (see derived)
}

var typeArena = new []Type(0)          // owns every type; the rest of the compiler holds handles

fn newType(kind: string, name: string, base: ?^Type): ^Type {
    append(typeArena, new Type{kind: kind, name: name, base: base, fields: new []Field(0), variants: new []^Type(0)})
    return handle(typeArena[len(typeArena) - 1])
}

fn derivedResult(base: ^Type): ^Type

// the type of the given kind ("array", "opt", "handle" or "result") made from base: made once per base and
// then shared, since no such type is changed once made and they are compared by pointer
fn derived(kind: string, base: ^Type): ^Type {
    if kind == "result" {
        let r = base.resultOf
        if r != nil { return r }
        return derivedResult(base)
    }
    var t = base.arrayOf
    if kind == "opt" { t = base.optOf } else if kind == "handle" { t = base.handleOf }
    if t != nil { return t }
    let n = newType(kind, "", base)
    if kind == "array" { base.arrayOf = n } else if kind == "opt" { base.optOf = n } else { base.handleOf = n }
    return n
}

let tInt = newType("int", "int", nil)
let tByte = newType("byte", "byte", nil)
let tBool = newType("bool", "bool", nil)
let tString = newType("string", "string", nil)
let tVoid = newType("void", "void", nil)
let tNil = newType("nil", "nil", nil)
let tResultCtor = newType("resultctor", "Result", nil)   // the universe's Result; parseType makes Result[T]
let tErrVal = newType("errval", "err", nil)              // the static type of err(...): one allocated err cell

fn baseOf(t: ^Type): ^Type {
    let b = t.base
    if b != nil { return b }
    return tVoid
}

// A function type is structural: kind "fn", base is the return type, and fields are the parameters in
// order. A parameter's field name is "" for an owned parameter and "&" for a read-only one; its offset is
// its index. No Type field is added for this (lambdas design 5.1; do not use this syntax in the compiler).
fn newFnType(ret: ^Type): ^Type { return newType("fn", "", ret) }

fn fnAddParam(t: ^Type, p: ^Type, mode: int) {
    var modeName = ""
    if mode == 1 { modeName = "&" }
    append(t.fields, new Field{name: modeName, offset: len(t.fields), typ: p})
}

fn fnArity(t: ^Type): int { return len(t.fields) }
fn fnParam(t: ^Type, i: int): ^Type { return t.fields[i].typ }
fn fnMode(t: ^Type, i: int): int {
    if t.fields[i].name == "&" { return 1 }
    return 0
}
fn fnRet(t: ^Type): ^Type { return baseOf(t) }

fn tname(t: ^Type): string {
    if t.kind == "fn" {
        var s = "fn("
        for i in 0..fnArity(t) {
            if i > 0 { s = s + ", " }
            if fnMode(t, i) == 1 { s = s + "&" }
            s = s + tname(fnParam(t, i))
        }
        s = s + ")"
        let r = fnRet(t)
        if r.kind != "void" { s = s + ": " + tname(r) }
        return s
    }
    if t.kind == "array" { return "[]" + tname(baseOf(t)) }
    if t.kind == "handle" { return "^" + tname(baseOf(t)) }
    if t.kind == "opt" { return "?" + tname(baseOf(t)) }
    if t.kind == "result" { return "Result[" + tname(baseOf(t)) + "]" }
    if len(t.name) > 0 {
        if t.owner != "" && t.owner != curModuleName { return t.owner + "::" + t.name }
        return t.name
    }
    return t.kind
}

fn isInt(t: ^Type): bool { return t.kind == "int" || t.kind == "byte" }

fn isRef(t: ^Type): bool {
    return t.kind == "record" || t.kind == "closed" || t.kind == "array" || t.kind == "opt" ||
        t.kind == "string" || t.kind == "result"
}

fn nonNull(t: ^Type): bool {
    return t.kind == "record" || t.kind == "closed" || t.kind == "iface" || t.kind == "array" ||
        t.kind == "handle" || t.kind == "result" || t.kind == "fn"
}

fn same(a: ^Type, b: ^Type): bool {
    if a == b { return true }
    if a.kind != b.kind { return false }
    if a.kind == "fn" {
        // exact structural identity: parameter count, modes, types and return; no variance
        if !same(fnRet(a), fnRet(b)) { return false }
        if fnArity(a) != fnArity(b) { return false }
        for i in 0..fnArity(a) {
            if fnMode(a, i) != fnMode(b, i) { return false }
            if !same(fnParam(a, i), fnParam(b, i)) { return false }
        }
        return true
    }
    if a.kind == "array" || a.kind == "opt" || a.kind == "handle" { return same(baseOf(a), baseOf(b)) }
    return a.kind == "int" || a.kind == "byte" || a.kind == "bool" || a.kind == "string" ||
        a.kind == "void" || a.kind == "nil"
}

fn assignable(dst: ^Type, src: ^Type): bool {
    if same(dst, src) { return true }
    if dst.kind == "int" && src.kind == "byte" { return true }
    if dst.kind == "closed" && src.kind == "record" && src.parent == dst { return true }
    if dst.kind == "result" && src.kind == "errval" { return true }
    if dst.kind == "handle" && src.kind == "handle" { return assignable(baseOf(dst), baseOf(src)) }
    if dst.kind == "opt" {
        if src.kind == "nil" { return true }
        if src.kind == "opt" { return assignable(baseOf(dst), baseOf(src)) }
        return assignable(baseOf(dst), src)
    }
    return false
}

// A function type hidden behind a constructor or an alias: an alias resolves to the same ^Type, so a
// kind == "fn" test at the constructor is not enough (lambdas design 5.2). A record field cannot be a
// function value (fieldList refuses it), so this does not recurse into record fields.
fn containsFn(t: ^Type): bool {
    if t.kind == "fn" { return true }
    if t.kind == "array" || t.kind == "opt" || t.kind == "handle" || t.kind == "result" {
        return containsFn(baseOf(t))
    }
    return false
}

// The visited records/closed types of one containsIface query. Each top-level query starts empty; only the
// recursive helper appends, so a recursive record terminates and a stale list can never hide a hit.
var ifaceSeen = new []^Type(0)

fn containsIfaceIn(t: ^Type): bool

fn containsIface(t: ^Type): bool {
    truncate(ifaceSeen, 0)
    return containsIfaceIn(t)
}

// An interface in a function type's parameters or return, through a constructor, or through a record or
// closed type's fields (interfaces may be fields under interfaces v3 section 10.1). An incomplete forward
// shell is treated as containing one: its fields are not known yet.
fn containsIfaceIn(t: ^Type): bool {
    if t.kind == "iface" { return true }
    if t.kind == "array" || t.kind == "opt" || t.kind == "handle" || t.kind == "result" {
        return containsIfaceIn(baseOf(t))
    }
    if t.kind == "fn" {
        for i in 0..fnArity(t) {
            if containsIfaceIn(fnParam(t, i)) { return true }
        }
        return containsIfaceIn(fnRet(t))
    }
    if t.kind == "record" || t.kind == "closed" {
        if t.incomplete { return true }
        for i in 0..len(ifaceSeen) {
            if ifaceSeen[i] == t { return false }
        }
        append(ifaceSeen, t)
        if t.kind == "record" {
            for i in 0..len(t.fields) {
                if containsIfaceIn(t.fields[i].typ) { return true }
            }
        } else {
            for v in 0..len(t.variants) {
                for i in 0..len(t.variants[v].fields) {
                    if containsIfaceIn(t.variants[v].fields[i].typ) { return true }
                }
            }
        }
    }
    return false
}

fn rejectFn(t: ^Type, msg: string) { if containsFn(t) { errorAt(msg, 0, 0) } }
fn rejectIface(t: ^Type, msg: string) { if containsIface(t) { errorAt(msg, 0, 0) } }

fn symTypeText(t: ^Type): string

// A carrier name in a function-type diagnostic: source names use tname; the reader must use the
// symbol-file spelling, which does not prefix the module being defined.
fn ifaceFnName(t: ^Type): string {
    if symMode { return symTypeText(t) }
    return tname(t)
}

// The function-type formation site: a direct interface is the plain message; an interface held in a record
// or closed type, or an incomplete forward shell, names the type that carries it (interfaces v3 10.1).
fn rejectIfaceFn(t: ^Type) {
    let k = t.kind
    if k == "iface" { errorAt("a function value cannot take or return an interface value", 0, 0) }
    if k == "array" || k == "opt" || k == "handle" || k == "result" {
        rejectIfaceFn(baseOf(t))
        return
    }
    if k == "fn" {
        for i in 0..fnArity(t) { rejectIfaceFn(fnParam(t, i)) }
        rejectIfaceFn(fnRet(t))
        return
    }
    if k == "record" || k == "closed" {
        if t.incomplete {
            errorAt("a function value cannot take or return '" + ifaceFnName(t) + "': it is not yet defined; define it before this function type", 0, 0)
        }
        if containsIface(t) {
            errorAt("a function value cannot take or return '" + ifaceFnName(t) + "': it holds an interface value", 0, 0)
        }
    }
}

// the index of a record's field, or -1 (fields are reached through the type's handle)
fn fieldIndex(t: ^Type, name: string): int {
    for i in 0..len(t.fields) {
        if t.fields[i].name == name { return i }
    }
    return -1
}

// ======================================================== symbols, items

type Sym = ref record {
    kind: string              // var let const type fn builtin
    name: string
    owner: string             // the module a module-level declaration belongs to; "" for locals and builtins
    exported: bool            // a module-level declaration marked pub (a dependency can see it)
    typ: ?^Type
    storage: string           // local or global
    offset: int               // rbp offset or absolute address
    value: int                // const
    addr: int                 // fn: code position once defined, else -1
    fnRec: ^FnRec             // fn: its record (see FnRec); the other kinds share noFnRec
    ret: ^Type
    line: int
    owned: bool               // a local holding an owned value
    moved: bool               // its value has been moved away
    touches: int              // how many calls have moved it: a whole array's header is freed only by a move
    deferUse: bool            // a defer reads it, so it may not be moved
    isStr: bool               // a string local, holding one reference
    isRef: bool               // a reference: a parameter or local that borrows
    isRefLocal: bool          // a reference local (its validity is tracked)
    pairSlot: bool            // a &I local: its slot is the two-word pair itself (v3 B1)
    hOrigin: ?^Sym            // a let handle to a whole owned local: the local its object is in
    hDepth: int              // a let handle that had an origin when declared: its loop depth + 1 (0 for the others); its uses
                             // are counted (usedAt) even after a move clears the origin
    movedLoop: bool          // a let handle whose owner was moved inside a loop that did not name it: naming it again is refused
    isParam: bool            // a parameter of the function being compiled: its object came from a caller
    bind: ^RefBind            // what a reference local points into, on the path being compiled
    fresh: bool               // pointed afresh since the innermost loop began, on every path to here
    staleUse: int            // useSeq of the last read that was not fresh (see loopBindCheck)
    staleLine: int           // where that read is (its line and column): where a carried invalidation is reported
    staleCol: int
    freedUse: int            // useSeq of the last read that was not fresh while carryFreed (see loopBindCheck)
    writeUse: int            // useSeq of the last write through the reference, not fresh (see loopBindCheck)
    carryFreed: bool         // a change that may free something came while it was not pointed afresh on every path
    suspect: bool             // live across a recursive call that may write through a handle
    usedAt: int               // a reference local: the reads so far (useSeq) when it was last read before it was pointed afresh,
                              // or a for walk read it: see loopSelfCheck; a tracked let handle: when it was last named
                              // (see originFree)
    iterating: bool           // a for loop is walking this array
    freesAll: bool            // fn: it might free anything (or isn't compiled yet)
    writesHandles: bool       // fn: it frees owned objects through a handle (directly, by a callee, or a forward heading)
    pureMember: bool          // ifn: an interface member declared pure (its summary is pfree 0; the tier check reads this)
    home: int                 // an int or bool local held in this register (r12 to r15) instead of a stack slot, or -1
    recv: ^Type               // a method's receiver type; tVoid for a plain function
}

// A reference local's binding, on one path: what it may point into. Its roots are owned locals,
// reference parameters, globals, or handleSym (a borrow through a handle). deeps says it may point
// below the root's own object, and paths says where below ("" = anywhere). writable says changes may
// be made through it, and parent is the reference local it was derived from, which a change through
// it does not free. A binding is never changed once made: a re-point makes a new one (see arenaBind).
type RefBind = ref record {
    roots: []^Sym
    deeps: []bool
    paths: []string
    writable: bool
    parent: ?^Sym
}

// The state of the owned locals on one path at one point (see snapshot): flags holds, per local, its
// moved flag, then its suspect flag, then its fresh flag, then its carryFreed flag; binds holds its binding.
type PState = ref record {
    flags: []bool
    binds: []^RefBind
}

// A change that may free something, logged while a loop or a defer body is compiled (see logFree).
// kind 0: a change to root, all of it or the place path under it; kind 1: a change through a handle,
// which may free anything below its target (deep references); kind 2: a recursive call, which makes the
// deep references live across it suspect.
type FreeRec = ref record {
    kind: int
    root: ?^Sym
    all: bool
    path: string
    via: ?^Sym           // the reference a change is made through: references it was derived from stay valid (see invalidate)
    nfFrom: int          // the record's slice of nonFreshLog: the owned locals that were reference locals not
    nfTo: int            // pointed afresh when the change was made
}

// the frees logged so far, while a loop or a defer body is being compiled: the loop's exits are the states
// with the frees logged before each exit applied (see loopBodyV); a defer body's frees are taken out of the
// log where it ends and replayed where its block is left (see deferStat and callDefers)
var freeLog = new []^FreeRec(0)
var freeArena = new []FreeRec(0)     // the records freeLog points into; the outermost loop's are dropped at its end
var nonFreshLog = new []int(0)       // the nonFresh index lists, one contiguous slice per free record
var arenaBase = 0                    // where the outermost loop's records begin in freeArena
const NF_CHECK = false               // test builds flip this to check every log range and the release lifecycle
fn verifyNonFresh() {
    if !NF_CHECK { return }
    for i in 0..len(freeArena) {
        if freeArena[i].nfFrom < 0 || freeArena[i].nfFrom > freeArena[i].nfTo ||
           freeArena[i].nfTo > len(nonFreshLog) {
            eprintln("NFCHECK bad record ", i, ": ", freeArena[i].nfFrom, "..", freeArena[i].nfTo,
                     " len ", len(nonFreshLog))
            exit(9)
        }
    }
}
// the loops being compiled, a count: frees are logged while it is not zero, or in a defer body
var recording = 0

// The bindings made while compiling a function. The arena owns them and fnDecl releases them when the
// function ends; handles to them are what symbols and states hold. noBind is the binding of anything
// that is not a reference local (it points at nothing); noneBind is the identity of a join.
var bindArena = new []RefBind(0)

// the ownedLocals a defer body was entered with: a re-point of one of them in the body is refused
// (see deferStat); -1 outside a defer body
var deferMark = -1
// the outer reference locals (by ownedLocals index, below deferMark) that the defer body being compiled uses
var deferUses = new []bool(0)

fn arenaBind(roots: []^Sym, deeps: []bool, paths: []string, writable: bool, parent: ?^Sym): ^RefBind {
    append(bindArena, new RefBind{roots: roots, deeps: deeps, paths: paths, writable: writable, parent: parent})
    return handle(bindArena[len(bindArena) - 1])
}

// a binding of one root
fn singleBind(root: ^Sym, deep: bool, path: string, writable: bool, parent: ?^Sym): ^RefBind {
    var roots = new []^Sym(0)
    append(roots, root)
    var deeps = new []bool(0)
    append(deeps, deep)
    var paths = new []string(0)
    if deep { append(paths, path) } else { append(paths, "") }
    return arenaBind(roots, deeps, paths, writable, parent)
}

let noBind = arenaBind(new []^Sym(0), new []bool(0), new []string(0), true, nil)
let noneBind = arenaBind(new []^Sym(0), new []bool(0), new []string(0), true, nil)

// The data of a function, held by its symbol: the parameters, the calls waiting for its address,
// and the globals it might free. Only functions have one; the other symbols share noFnRec, which
// nothing writes, so it stays empty.
type FnRec = ref record {
    fixups: []int             // calls waiting for the address
    params: []^Type
    pmodes: []int             // 0 owned, 1 &, 2 mut, per parameter
    freed: []^Sym             // the globals it might free (directly or through calls)
    pfree: int                // bit i: it might free something below the reference it was given for parameter i (directly or through
                              // calls); parameters from the 62nd on are always assumed to
}

// Experimental native C interop: one recorded call whose rel32 target is resolved by the system
// linker. The image this compiler emits is still fixed ET_EXEC; the sidecar is the generic input a
// future object emitter would turn into .rela.text. Not part of .sym and not a stable ABI.
type NativeReloc = ref record {
    off: int                  // offset of the rel32 field from CODE_BASE
    sym: string               // C symbol before the generated obo_native_ prefix
}

var nativeRelocs = new []NativeReloc(0)
var nativeRelocPath = ""

fn isCNativeName(s: string): bool {
    if len(s) == 0 || len(s) > 200 { return false }
    for i in 0..len(s) {
        let c = s[i]
        let alpha = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
        let digit = c >= '0' && c <= '9'
        if i == 0 && !alpha { return false }
        if i > 0 && !alpha && !digit { return false }
    }
    return true
}

var fnArena = new []FnRec(0)          // owns the function records; the symbols hold handles to them

fn newFnRec(): ^FnRec {
    append(fnArena, new FnRec{fixups: new []int(0), params: new []^Type(0), pmodes: new []int(0), freed: new []^Sym(0)})
    return handle(fnArena[len(fnArena) - 1])
}

let noFnRec = newFnRec()

var symArena = new []Sym(0)            // owns every symbol; the rest of the compiler holds handles

fn newSym(kind: string, name: string, t: ?^Type): ^Sym {
    append(symArena, new Sym{kind: kind, name: name, typ: t, bind: noBind, addr: -1, fnRec: noFnRec,
                   ret: tVoid, line: -1, home: -1, recv: tVoid})
    return handle(symArena[len(symArena) - 1])
}

// every method of the whole compilation, in declaration order; each symbol's recv is its canonical
// receiver type (tVoid for a plain function). The array holds handles into symArena, which owns the
// symbols: it never frees one, and releaseTables clears it with the arena.
var methodSyms = new []^Sym(0)

fn isMethod(s: ^Sym): bool { return s.recv != tVoid }

// the method with this receiver type and name, in this one type (no parent step)
fn findMethodIn(t: ^Type, name: string): ?^Sym {
    for i in 0..len(methodSyms) {
        let m = methodSyms[i]
        if m.recv == t && m.name == name { return m }
    }
    return nil
}

// the method a receiver of type t calls: t's own, or one parent step for a variant
fn findMethod(t: ^Type, name: string): ?^Sym {
    let m = findMethodIn(t, name)
    if m != nil { return m }
    let p = t.parent
    if p != nil { return findMethodIn(p, name) }
    return nil
}

// the key of a method in its module: Type::name
fn methodKey(s: ^Sym): string { return s.recv.name + "::" + s.name }

// a method's name in diagnostics: T::m, or M::T::m when it belongs to another module
fn methodDisplay(s: ^Sym): string {
    if s.owner != "" && s.owner != curModuleName { return s.owner + "::" + s.recv.name + "::" + s.name }
    return s.recv.name + "::" + s.name
}

// an error message names a function by its bare name and a method by T::m
fn callableName(s: ^Sym): string {
    if isMethod(s) { return methodDisplay(s) }
    return s.name
}

fn inFnStack(f: ^Sym): bool {
    for i in 0..len(fnStack) {
        if fnStack[i] == f { return true }
    }
    return false
}

// ========================================================== interfaces
//
// An interface is a named type (kind "iface") whose members are synthetic symbols in ifaceSyms, in
// declaration order. They belong to no module's namespace and are not in methodSyms, so every method
// scan leaves them out. An implementation pairs a record or closed type with an interface (checked
// at its declaration, implDecl). An implementation has a vtable in rodata (v3 4). An owned interface value
// is a box (boxInto, checkAssign); calls through one, equality and handles are refused until their steps.

type Impl = ref record {
    iface: ^Type
    recv: ^Type
    owner: string
    exported: bool
    line: int
    vtable: int               // the address of its vtable in rodata (v3 4): 0 for an impl read from a .sym, which has no code
}

var ifaceSyms = new []^Sym(0)       // the members of every interface, declaration order
var impls = new []^Impl(0)          // every declared implementation, declaration order
var implArena = new []Impl(0)       // owns the implementation records

// the members of the interface t, in declaration order
fn ifaceMethodsOf(t: ^Type): []^Sym {
    var out = new []^Sym(0)
    for i in 0..len(ifaceSyms) {
        if ifaceSyms[i].recv == t { append(out, ifaceSyms[i]) }
    }
    return out
}

fn findIfaceMethod(t: ^Type, name: string): ?^Sym {
    for i in 0..len(ifaceSyms) {
        let m = ifaceSyms[i]
        if m.recv == t && m.name == name { return m }
    }
    return nil
}

// an interface method's name in diagnostics: I::m, or M::I::m when it belongs to another module
fn ifaceMethodDisplay(f: ^Sym): string {
    if f.owner != "" && f.owner != curModuleName { return f.owner + "::" + f.recv.name + "::" + f.name }
    return f.recv.name + "::" + f.name
}

// the implementation of this pair in this module, if any
fn findImplIn(recv: ^Type, iface: ^Type): ?^Impl {
    for i in 0..len(impls) {
        let im = impls[i]
        if im.recv == recv && im.iface == iface { return im }
    }
    return nil
}

// the root of a reference that borrows through a handle: the handle may name any
// object, so any change, and any call that might free, may free what it points into
let handleSym = newSym("var", "a handle's target", nil)

fn symType(s: ^Sym): ^Type {
    let t = s.typ
    if t != nil { return t }
    return tVoid
}

type NPair = ref record {
    sym: ^Sym
    typ: ^Type
    next: ?NPair              // the rest of the list
}

// Describes where a value currently is, so that emission can be delayed.
type Item = ref record {
    mode: string              // const mem elem reg cond void
    typ: ^Type
    val: int
    base, index, disp: int    // mem: base and index registers (-1 for none)
    r: int
    cc: int                   // cond: condition code meaning true
    T, F: int                 // cond: jumps waiting for the true and false targets (lists: see waitJump)
    sym: ?^Sym                 // set when the item is a plain variable
    nt, nf: ?NPair            // narrowings valid when the condition holds / fails (a list of pairs)
    readonly: bool
    width, scale, line: int
    root: ?^Sym                // the variable a designator starts from
    strTemp: bool             // a fresh string whose reference nothing owns yet
    borrowed: bool            // the value is a reference (borrowed, not owned)
    pair: bool                // a &I local's own two-word pair slot: reading it gives the slot's address
    viaHandle: bool           // the designator went through a handle
    deref: bool               // the designator goes through a field or element
    movedRef: bool            // a moved local named as an assignment target
    hOrigin: ?^Sym            // a handle made from a whole owned local by a let: that local
    pOwner: ?^Sym             // a handle made from a field or element of an owned local: that local, and its place (pPath)
    pPath: string
    path: string              // a field or element of root: "/a/b", "/items/[]"; "" = anywhere
    home: bool                // a reg item that is a local's own register: read it, never change or release it
}

fn newItem(mode: string, t: ^Type): Item {
    return new Item{mode: mode, typ: t, base: -1, index: -1, r: -1, T: 0, F: 0,
                    nt: nil, nf: nil, width: 8, scale: 8}
}

fn makeConst(t: ^Type, v: int): Item {
    let x = newItem("const", t)
    x.val = v
    return x
}

fn makeReg(t: ^Type, r: int): Item {
    let x = newItem("reg", t)
    x.r = r
    return x
}

fn voidItem(): Item { return newItem("void", tVoid) }

// a copy of where an item's value is (not its jump lists), for handing to
// something that consumes it while the original stays
fn dupItem(x: &Item): Item {
    let y = newItem(x.mode, x.typ)
    y.val = x.val
    y.base = x.base
    y.index = x.index
    y.disp = x.disp
    y.r = x.r
    y.cc = x.cc
    y.width = x.width
    y.scale = x.scale
    y.line = x.line
    y.strTemp = x.strTemp
    y.home = x.home
    y.pair = x.pair
    return y
}

// a full copy of an item, every place field included (dupItem is only for a value about to be re-read).
// A method receiver is copied so that the callee-side item can be consumed without moving the optional
// holder, which the ownership rules would otherwise see moved on one path only.
fn copyItem(x: &Item): Item {
    let y = newItem(x.mode, x.typ)
    y.val = x.val
    y.base = x.base
    y.index = x.index
    y.disp = x.disp
    y.r = x.r
    y.cc = x.cc
    y.sym = x.sym
    y.readonly = x.readonly
    y.width = x.width
    y.scale = x.scale
    y.line = x.line
    y.root = x.root
    y.strTemp = x.strTemp
    y.borrowed = x.borrowed
    y.pair = x.pair
    y.viaHandle = x.viaHandle
    y.deref = x.deref
    y.movedRef = x.movedRef
    y.hOrigin = x.hOrigin
    y.pOwner = x.pOwner
    y.pPath = x.pPath
    y.path = x.path
    y.home = x.home
    return y
}

// a copy of a's narrowings, then b's (b is moved in)
fn joinPairs(a: &?NPair, b: ?NPair): ?NPair {
    if a == nil { return b }
    return new NPair{sym: a.sym, typ: a.typ, next: joinPairs(&a.next, b)}
}

// ================================================================= layout

const IMAGE_BASE = 0x400000
const CODE_BASE = 0x401000
const RODATA_BASE = 0x08000000
const GLOBAL_BASE = 0x0C000000
const RT_TEXT = 0x10000000
const RT_DATA = 0x20000000

const RT_INIT = 0
const RT_EXIT = 1
const RT_ALLOC_RECORD = 2
const RT_ALLOC_ARRAY = 3
const RT_PRINT_INT = 4
const RT_PRINT_STR = 5
const RT_PRINT_BOOL = 6
const RT_NEWLINE = 7
const RT_CONCAT = 8
const RT_STREQ = 9
const RT_PANIC_BOUNDS = 10
const RT_COLLECT = 11
const RT_GC_STATS = 12
const RT_INT_TO_STR = 13
const RT_APPEND = 14
const RT_TRUNCATE = 15
const RT_BYTES_TO_STRING = 16
const RT_SUBSTR = 17
const RT_READ_FILE = 18
const RT_WRITE_FILE = 19
const RT_ARGS = 20
const RT_SET_OUTPUT = 21
const RT_FREE = 22
const RT_FINISH = 23
const RT_STR_INC = 24
const RT_STR_DEC = 25
const RT_HANDLE = 26
const RT_DEREF = 27
const RT_ALIVE = 28
// incremental I/O: the helpers build the Result cells themselves, from the err descriptor and the ok
// variant descriptor of the exact payload type that the compiler passes as the last two arguments
const RT_OPEN_FILE = 29
const RT_READ_FD = 30
const RT_WRITE_FD = 31
const RT_CLOSE_FD = 32
// metadata (P3): readDirFd, statPath, lstatPath and readLinkPath append slots 33-36; the runtime builds
// the cells from the same err descriptor and the ok variant of the exact payload type
const RT_READ_DIR_FD = 33
const RT_STAT_PATH = 34
const RT_LSTAT_PATH = 35
const RT_READ_LINK_PATH = 36
// environment (P5a): isatty(fd): bool and getenv(name): ?[]byte append slots 37-38; neither builds
// a Result cell or passes a descriptor. terminalWidth(fd): int appends slot 39 (P6a), likewise.
// sleepMs(ms): Result[bool] appends slot 40; it passes the shared err descriptor and
// the ok-bool variant, like the other Result-returning runtime helpers.
const RT_ISATTY = 37
const RT_GETENV = 38
const RT_TERM_WIDTH = 39
const RT_SLEEP = 40

const RAX = 0
const RCX = 1
const RDX = 2
const RSP = 4
const RBP = 5
const RSI = 6
const RDI = 7

const CC_E = 4
const CC_NE = 5
const CC_L = 12
const CC_GE = 13
const CC_LE = 14
const CC_G = 15

fn relCC(o: int): int {
    match o {
        T_EQ { return CC_E }
        T_NE { return CC_NE }
        T_LT { return CC_L }
        T_GE { return CC_GE }
        T_LE { return CC_LE }
        else { return CC_G }
    }
}

fn swapCC(cc: int): int {
    match cc {
        CC_L { return CC_G }
        CC_G { return CC_L }
        CC_LE { return CC_GE }
        CC_GE { return CC_LE }
        else { return cc }
    }
}

fn isRel(s: int): bool {
    match s {
        T_EQ, T_NE, T_LT, T_LE, T_GT, T_GE { return true }
        else { return false }
    }
}

// ========================================================= compiler state

type Block = ref record {
    syms: []^Sym
    defers: []int
    frees: []^FreeRec         // the frees of the deferred bodies, replayed where the block is left (see callDefers)
    freeFrom: []int           // per defer: where its frees begin in frees
    uses: []^Sym              // the outer reference locals the deferred bodies use, checked where the block is left
    useBinds: []^RefBind      // each one's binding where the defer is declared
    useFrom: []int            // per defer: where its uses begin in uses
    nmark: int
    omark: int                // ownedLocals before this block
    hmark: int                // originSyms before this block: the let handles declared in it are dropped with it
}

type NEntry = ref record {
    sym: ^Sym
    typ: ^Type
    depth: int
    alive: bool
}

type Loop = ref record {
    brk: int                  // jumps waiting for the loop's end (a list: see waitJump)
    cont: int                 // jumps waiting for the next iteration
    blocks: int
    entry: PState              // the state when the loop was entered
    lv: ?^Sym                  // a for loop's variable, rebound every iteration
    susp: PState               // the state where a break or continue leaves the loop, joined
    back: PState               // the state where the next iteration starts: the body's end, and the continues (conts)
    exits: []PState            // the states where a break leaves the loop, each joined in with its free-log length (exitAt)
    exitAt: []int
    conts: []PState            // the states where a continue leaves, joined into back and the exits (contAt)
    contAt: []int
    logFrom: int               // the free log's length where the loop's condition or body begins
    useFrom: int               // the reads so far (useSeq) where the loop's condition or body begins
    exitDead: []?^Sym          // the dead marks (originDead) of the arms that leave by a break or a continue, for after the loop
}

// The outer function state saved around a lambda's code island. It is a value record, not an arena:
// every field is a saved handle or scalar from 5.3.1, and restoring it must not touch the island's
// hidden symbols (those stay in symArena for the enclosing function, as the design's default policy).
type LamCtx = ref record {
    homeBits: int
    homeCap: int
    homeRetry: bool
    free: []int
    frame: int
    depth: int
    fwdCalls: int
    lifted: []byte
    waitFn: []^Sym
    waitAt: []int
    farCalls: []int
    barrier: int
    blocks: []Block
    fnBlock: int
    ownedLocals: []^Sym
    narrowStack: []NEntry
    loops: []Loop
    depthJumps: []int
    originSyms: []^Sym
    originDead: []?^Sym
    originLive: []?^Sym
    originPath: []string
    originNar: []bool
    deferH: []^Sym
    deferAt: []int
    deferFrees: []^Sym
    deferFreeEv: []string
    dfBlock: []int
    dfIndex: []int
    dfOwner: []^Sym
    dfEv: []string
    deferUses: []bool
    deferMark: int
    inDefer: bool
    freeLog: []^FreeRec
    freeArena: []FreeRec
    nonFreshLog: []int
    arenaBase: int
    recording: int
    heldKey: []?^Sym
    heldPath: []string
    heldForeign: []bool
    heldHit: []bool
    heldStore: []bool
    heldWhole: []bool
    pendSym: []^Sym
    pendDepth: []int
    frLine: []int
    frCol: []int
    pendWhat: []string
    pendOwn: []^Sym
    pendNest: []int
    pendLine: int
    pendCol: int
    pendMsg: string
    contSeq: int
    brkSeq: int
    orSeq: int
    freeSeq: int
    truncKeep: int
    replayFree: bool
    guardStart: int
    guardSym: ?^Sym
    guardFollow: int
    guardFree: int
    guardNeg: bool
    guardOpen: bool
    guardIdx: int
    guardMark: ?^Sym
    inAlive: bool
    lastNamed: ?^Sym
    lastNamedPrev: int
    lastDesigName: string
    lastPlace: string
    lastRaw: string
    lastOrigin: ?^Sym
    lastIdent: ?^Sym
    lastViaHandle: bool
    curFn: ?^Sym
    selfCalls: int
    userCalls: int
    useSeq: int
    trySite: int
    tryNest: int
    noreturn: bool
    condDepth: int
    pinned: ?^Sym
    inWhileCond: bool
    loopdepth: int
    scanBytes: []byte
    scanAt: []int
    scanLen: []int
    scanScore: []int
    scanPend: []bool
    scanCalls: int
    bindLen: int
    symLen: int
    fnLen: int
    argLen: int
    argTempsUsed: int
    fnStackLen: int
    callIface: bool
    convBorrow: int
    convPairOn: bool
    convPairDisp: int
}

fn makePool(): []int {
    let p = new []int(0)
    append(p, 3)
    for r in 8..16 { append(p, r) }
    return p
}

let pool = makePool()

// Register homes. An int or bool local whose name the pre-scan of its function found busy lives in r12
// to r15 (callee-saved in the C ABI, so a runtime call keeps it) instead of a stack slot. A home is taken
// out of the free list while its local is in scope and so is never handed out as a temporary; it is
// pushed around the calls to obo functions with the other registers in use, since a callee may use any
// pool register. REG_HOMES is how many may be held at once (0 turns the allocation off); the pool keeps
// at least five others. A name needs HOME_MIN weighted uses (a use in a loop counts 8, in two loops 64)
// beyond twice the weighted calls its function makes.
const REG_HOMES = 4
const HOME_MIN = 8
var homeBits = 0                  // the registers now held by locals, as a set
var homeRetry = false             // the function being compiled ran out of registers with locals in them: see giveUpHomes

var rodata = new []byte(0)
var strKeys = new []string(0)
var strAddrs = new []int(0)
var gsize = 0
var free = new []int(0)
var depth = 0
var universe = new []^Sym(0)
var blocks = new []Block(0)
var narrowStack = new []NEntry(0)
var loops = new []Loop(0)
var originSyms = new []^Sym(0)   // the let handles that have an origin (hOrigin), in declaration order
var depthJumps = new []int(0)    // per loop depth: the breaks and continues compiled so far that leave a loop at that depth
var pendSym = new []^Sym(0)      // the frees (see originFree) inside a loop of a handle declared outside it, to be
var pendDepth = new []int(0)     // checked where that loop ends, when it is known whether the loop uses the handle:
var frLine = new []int(0)      // the handle, the loop (an index of loops), and the place of the free
var frCol = new []int(0)
var pendWhat = new []string(0)   // "assign over", "drop" or "move"
var pendOwn = new []^Sym(0)      // the owner (for a move, whose handle's origin is cleared at once)
var pendNest = new []int(0)      // len(loops) where it was made
var contSeq = 0                  // the continues compiled so far
var brkSeq = 0                   // the breaks compiled so far
var orSeq = 0                    // the '||' operators compiled so far
var freeSeq = 0                  // the frees of an owner (originFree) so far
var guardStart = -10             // the token index at which the 'alive' of an if condition's guard would be
var guardSym: ?^Sym = nil        // the handle h of a condition that starts with alive(h) (see "Narrowing on alive"), or nil
var guardFollow = 0              // the token after that alive(h)
var guardFree = 0                // freeSeq there
var guardNeg = false             // the guard is !alive(h)
var originNar = new []bool(0)    // per entry of originSyms: narrowing cleared a dead mark of the handle (a move of the owner then marks it dead)
var guardOpen = false            // a conjunction is compiling the rest of the guard's condition with h's dead mark cleared
var guardIdx = 0                 // the originSyms entry of h, and its mark before it was cleared
var guardMark: ?^Sym = nil
var inAlive = false              // the argument of alive is being compiled: naming a handle there is not a use
var lastNamed: ?^Sym = nil       // the tracked let handle named last, and its usedAt before that (see nameItem)
var lastNamedPrev = 0
var deferH = new []^Sym(0)       // the handles (originSyms) that the defer bodies in scope use, with the index of the
var deferAt = new []int(0)       // block each defer is declared in
var deferFrees = new []^Sym(0)   // the owners a defer body being compiled assigns over or drops (originFree)
var dfBlock = new []int(0)       // the same for the defers in scope: the owners, with the block and the number
var dfIndex = new []int(0)       // of the defer in it, for callDefers to replay where the block is left
var dfOwner = new []^Sym(0)
var replayFree = false           // originFree is replaying a defer's free: the defers it runs before were checked at its declaration
var originLive = new []?^Sym(0)  // per entry of originSyms: the owner, while some path to here has not moved it (a may-flag like originDead, nil after a move on every path); an assignment over the owner frees the handle's object only while this is set
var originDead = new []?^Sym(0)  // per entry of originSyms: the local whose assignment or drop freed its object, or nil
var truncKeep = -1               // while a truncate with a constant count is judged (originFreeAt): the elements before it survive
var originPath = new []string(0) // per entry of originSyms: "" for a handle to the owner's whole object; for one made from a field or
                                 // element of the owner (see "Field and element origins"), the place, "/items/[]/next"
var deferFreeEv = new []string(0)  // with deferFrees: where in the owner each free is, "=" or "!" (strictly below) and the place
var dfEv = new []string(0)         // with dfOwner
var loopdepth = 0
var curFn: ?^Sym = nil
// an error that needs the whole body: reported at its end if the body writes through a handle
var pendLine = 0
var pendCol = 0
var pendMsg = ""
var selfCalls = 0                 // calls a function makes to itself, so far
var useSeq = 0                    // reads of references so far, numbered
var fnBlock = 0
var frame = 0
var farCalls = new []int(0)       // where the current function's calls out of its body keep their rel32
var fwdCalls = 0                  // calls to functions not yet defined, so far (a while condition may hold some)
var lifted = new []byte(0)        // the code of the conditions of the while loops being compiled, lifted out until their bodies are done
var waitFn = new []^Sym(0)        // their calls that wait for a later function: which function or method
var waitAt = new []int(0)         // and where the call is
var inDefer = false
var inWhileCond = false           // a lambda literal is not allowed in a while condition
var noreturn = false
var initLink = 0

fn containsInt(a: &[]int, v: int): bool {
    for x in a {
        if x == v { return true }
    }
    return false
}

fn initCompiler() {
    let poolRefs = &pool
    for r in poolRefs { append(free, r) }
    append(universe, newSym("type", "int", tInt))
    append(universe, newSym("type", "byte", tByte))
    append(universe, newSym("type", "bool", tBool))
    append(universe, newSym("type", "string", tString))
    append(universe, newSym("type", "Result", tResultCtor))
    let names = words("print println len gc gcstats exit append truncate substr eprint eprintln readFile writeFile args openFile readFd writeFd closeFile readDirFd statPath lstatPath readLinkPath isatty getenv terminalWidth sleepMs stdin stdout stderr cinterop")
    for n in names { append(universe, newSym("builtin", n, nil)) }
    append(universe, newSym("builtin", "ok", nil))
    append(universe, newSym("builtin", "err", nil))
    append(universe, newSym("builtin", "take", nil))
    append(universe, newSym("builtin", "handle", nil))
    append(universe, newSym("builtin", "alive", nil))
    append(universe, newSym("builtin", "drop", nil))
    append(universe, newSym("builtin", "replace", nil))
}

fn error(msg: string) { errorAt(msg, 0, 0) }

// Python's repr() of a bytes value, as obx.py shows string tokens
fn bytesRepr(s: string): string {
    var hasSingle = false
    var hasDouble = false
    for i in 0..len(s) {
        if s[i] == '\'' { hasSingle = true }
        if s[i] == '"' { hasDouble = true }
    }
    var q: byte = '\''
    if hasSingle && !hasDouble { q = '"' }
    let out = new []byte(0)
    append(out, 'b')
    append(out, q)
    for i in 0..len(s) {
        let c = s[i]
        if c == '\\' || c == q {
            append(out, '\\')
            append(out, c)
        } else if c == '\t' {
            append(out, '\\')
            append(out, 't')
        } else if c == '\n' {
            append(out, '\\')
            append(out, 'n')
        } else if c == '\r' {
            append(out, '\\')
            append(out, 'r')
        } else if c < 32 || c >= 127 {
            append(out, '\\')
            append(out, 'x')
            append(out, hexDigit(c >> 4))
            append(out, hexDigit(c & 15))
        } else {
            append(out, c)
        }
    }
    append(out, q)
    return string(out)
}

fn expect(k: int, what: string) {
    if sym != k {
        var got = tokName(sym)
        if sym == T_IDENT {
            got = "'" + sval + "'"
        } else if sym == T_INT {
            got = string(ival)
        } else if sym == T_STRING {
            got = bytesRepr(sval)
        }
        if got == ";" { got = "end of line" }
        var w = what
        if len(w) == 0 { w = "'" + tokName(k) + "'" }
        error("expected " + w + ", found " + got)
    }
    next()
}

fn ident(): string {
    if sym != T_IDENT { error("expected identifier") }
    let name = sval
    next()
    return name
}

fn skipSemis() {
    while sym == T_SEMI { next() }
}

// ====================================================== modules (Stage 1)
//
// Source imports. A module is one source file; an imported file declares `module Name` and is
// named Name.obx. Imports are compiled dependency-first at the import point and bound to their
// live exported declarations: the defining module's ^Sym and ^Type objects are reused, so one
// type key is one object and one descriptor in the whole image, and a callee's effect summary
// is final before an importer is checked. Canonical identity is the normalized source path
// (B4); the names are only for lookup and diagnostics.

fn dirOf(path: string): string
fn normPath(p: string): string
fn endsWith(s: string, suf: string): bool
fn moduleNameOfPath(p: string): string
fn resolveSource(raw: string, base: string, line: int, col: int): string
fn findSource(raw: string, base: string): string
fn joinDirPath(d: string, p: string): string
fn lookup(name: string): ^Sym

type Module
type Import = ref record { alias: string; mod: ^Module; raw: string }
type SymDepList = ref record { names: []string; paths: []string; hashes: []int }
type Module = ref record {
    name: string              // the declared name, or _root for a headerless root
    path: string              // the normalized resolved source path: the canonical identity
    srcPath: string           // the source actually read ("" for an interface-only module)
    dir: string               // its directory, for resolving its imports
    hasHeader: bool
    isRoot: bool
    compiled: bool
    ifaceOnly: bool           // reconstructed from a .sym: --check and its dependencies
    symLoaded: bool           // its .sym has been read and validated in this build
    srcHash: int              // FNV-1a 64 of the source bytes
    ifaceHash: int            // hash of the interface body (set when the .sym is written or read)
    globals: []^Sym           // its own top-level declarations (the declaration scope)
    exports: []^Sym           // the exported subset, built when it completes
    imports: []Import         // its aliases, in import order
    symDepNames: []string     // the .sym's dep/depiface pairs, in first-import order (interface-only)
    symDepPaths: []string
    symDepHashes: []int
}

var modules = new []Module(0)       // every module of the build, in compile order
var programGlobals = new []^Sym(0)  // every module's own globals, for the exit teardown
var visibleGlobals = new []^Sym(0)  // the current module's globals and its direct imports' exports
var importStack = new []^Module(0)
var importStackNames = new []string(0)
var closureSeen = new []^Type(0)

// Stage 2 symbol files (defined after the module compiler below)
fn writeSym(mod: ^Module)
fn symText(mod: ^Module): []byte
fn readSym(symPath: string, expected: string, mode: int, display: string, srcCandidate: string): ^Module
fn loadSymCheck(symPath: string, expected: string, display: string, srcCandidate: string): ^Module

var symDir = ""                  // where .sym files are written and found
var symDirSet = false
var checking = false            // --check: read dependency .sym files, write the checked module's
var emitRootSym = false          // --emit-sym: a single-file build writes the root's .sym
var symLoadNames = new []string(0)   // the modules whose interfaces are being read (cycle check)
var symSrcFound = false              // validateDepSource found and read a source (its hash may be any 64-bit value)
var symDummyGlobals = 0              // imported global dummy offsets in --check (never overlap real globals)
const SYM_DUMMY_BASE = GLOBAL_BASE + 0x01000000

// a module used before one is current: --tokens and --encode, and the compiler's own start
var noModule = new Module{name: "", path: "", srcPath: "", dir: ".", hasHeader: false, isRoot: false, compiled: false,
                          ifaceOnly: false, symLoaded: false, srcHash: 0, ifaceHash: 0,
                          globals: new []^Sym(0), exports: new []^Sym(0), imports: new []Import(0),
                          symDepNames: new []string(0), symDepPaths: new []string(0), symDepHashes: new []int(0)}
var curModule: ^Module = handle(noModule)

// The scanner's whole state, saved while a dependency's source is read or a .sym is parsed,
// and restored before the caller's next token.
type ScanState = ref record {
    src: string
    pos: int
    line: int
    col: int
    last: int
    sym: int
    sval: string
    ival: int
    tokSeq: int
    tline: int
    tcol: int
    tokStart: int
    srcPath: string
    dumpMode: bool
}

fn saveScan(): ScanState {
    return new ScanState{src: src, pos: pos, line: line, col: col, last: last, sym: sym, sval: sval,
                         ival: ival, tokSeq: tokSeq, tline: tline, tcol: tcol, tokStart: tokStart,
                         srcPath: srcPath, dumpMode: dumpMode}
}

fn restoreScan(st: &ScanState) {
    src = st.src
    pos = st.pos
    line = st.line
    col = st.col
    last = st.last
    sym = st.sym
    sval = st.sval
    ival = st.ival
    tokSeq = st.tokSeq
    tline = st.tline
    tcol = st.tcol
    tokStart = st.tokStart
    srcPath = st.srcPath
    dumpMode = st.dumpMode
}

// FNV-1a 64: the type key hash and the symbol-file hashes (§7.5)
fn fnv1a(s: string): int {
    var h = 0xcbf29ce484222325
    for i in 0..len(s) { h = (h ^ int(s[i])) * 0x100000001b3 }
    return h
}

fn fnvRange(s: string, from: int, to: int): int {
    var h = 0xcbf29ce484222325
    var i = from
    while i < to {
        h = (h ^ int(s[i])) * 0x100000001b3
        i += 1
    }
    return h
}

fn fnvBytes(b: &[]byte): int {
    var h = 0xcbf29ce484222325
    for i in 0..len(b) { h = (h ^ int(b[i])) * 0x100000001b3 }
    return h
}

// appends a value's 16 hexadecimal digits (two's complement: negatives wrap)
fn appHex16(mut b: &[]byte, v: int) {
    append(b, '0')
    append(b, 'x')
    for k in 0..16 {
        let sh = 60 - 4 * k
        append(b, hexDigit((v >> sh) & 15))
    }
}

// appends the shortest hexadecimal form of a non-negative mask (0 is "0x0")
fn appHexMin(mut b: &[]byte, v: int) {
    append(b, '0')
    append(b, 'x')
    var started = false
    for k in 0..16 {
        let sh = 60 - 4 * k
        let d = (v >> sh) & 15
        if d != 0 || started || k == 15 {
            append(b, hexDigit(d))
            started = true
        }
    }
}

fn hex16Of(v: int): string {
    let b = new []byte(0)
    appHex16(b, v)
    return string(b)
}

// true for text of exactly 0x followed by 16 hexadecimal digits
fn isHex16(s: string): bool {
    if len(s) != 18 { return false }
    if s[0] != '0' || s[1] != 'x' { return false }
    for i in 2..18 {
        if !isHex(s[i]) { return false }
    }
    return true
}

// the canonical registries (defined below)
fn registerType(t: ^Type, owner: string, name: string)
fn registerTypeAlias(owner: string, name: string, t: ^Type)
fn registerGlobalSym(s: ^Sym)

// names a type at its defining declaration: only typeDecl does this (B7)
fn nameType(t: ^Type, name: string) {
    t.name = name
    t.owner = curModuleName
    t.uid = fnv1a(curModuleName + "::" + name)
    registerType(t, curModuleName, name)
}

fn reservedTypeName(n: string): bool {
    return n == "int" || n == "byte" || n == "bool" || n == "string" ||
        n == "void" || n == "nil" || n == "Result"
}

// ------------------------------------------------- the canonical registries
//
// One ^Type per canonical key Module::Name and one ^Sym per global key, for the whole
// compilation. A full build registers the defining module's live objects as it declares
// them; --check reconstructs them from .sym files. A summary may name a global of a module
// that is not loaded: globalSym returns (or makes) an incomplete stub, and the defining
// module's later load completes that same ^Sym (B6), so mightFree compares one object.

var typeKeys = new []string(0)
var typeRegistry = new []^Type(0)
var globalKeys = new []string(0)
var globalRegistry = new []^Sym(0)

fn keyOf(owner: string, name: string): string { return owner + "::" + name }

fn typeAtKey(key: string): ?^Type {
    for i in 0..len(typeKeys) {
        if typeKeys[i] == key { return typeRegistry[i] }
    }
    return nil
}

// registers a named type; the caller has checked that the key is new
fn registerType(t: ^Type, owner: string, name: string) {
    append(typeKeys, keyOf(owner, name))
    append(typeRegistry, t)
}

// an alias key maps to an existing Type; it never creates one or changes owner/uid/name (B7)
fn registerTypeAlias(owner: string, name: string, t: ^Type) {
    append(typeKeys, keyOf(owner, name))
    append(typeRegistry, t)
}

fn globalAtKey(key: string): ?^Sym {
    for i in 0..len(globalKeys) {
        if globalKeys[i] == key { return globalRegistry[i] }
    }
    return nil
}

// the one ^Sym for a global key: the existing symbol, or an incomplete stub that a later
// defining .sym completes (B6)
fn globalSym(owner: string, name: string): ^Sym {
    let key = keyOf(owner, name)
    let have = globalAtKey(key)
    if have != nil { return have }
    let s = newSym("var", name, nil)
    s.owner = owner
    s.storage = "global"
    append(globalKeys, key)
    append(globalRegistry, s)
    return s
}

// registers a live module global; its key must be new
fn registerGlobalSym(s: ^Sym) {
    append(globalKeys, keyOf(s.owner, s.name))
    append(globalRegistry, s)
}

// the key a registered symbol was made under, for the .sym writer
fn symKey(s: ^Sym): string {
    let key = keyOf(s.owner, s.name)
    for i in 0..len(globalKeys) {
        if globalRegistry[i] == s { return globalKeys[i] }
    }
    return key
}

fn newModuleRecord(name: string, path: string, isRoot: bool): ^Module {
    let m = new Module{name: name, path: path, srcPath: "", dir: dirOf(path), hasHeader: false, isRoot: isRoot,
                       compiled: false, ifaceOnly: false, symLoaded: false, srcHash: 0, ifaceHash: 0,
                       globals: new []^Sym(0), exports: new []^Sym(0), imports: new []Import(0),
                       symDepNames: new []string(0), symDepPaths: new []string(0), symDepHashes: new []int(0)}
    append(modules, m)
    return handle(modules[len(modules) - 1])
}

fn findModPath(path: string): ?^Module {
    for i in 0..len(modules) {
        if modules[i].path == path { return handle(modules[i]) }
    }
    return nil
}

// the module a resolved path names, which must have a record by now
fn moduleAt(path: string): ^Module {
    for i in 0..len(modules) {
        if modules[i].path == path { return handle(modules[i]) }
    }
    error("internal error: no module record for " + path)
    return curModule
}

fn onImportStack(m: ^Module): bool {
    for i in 0..len(importStack) {
        if importStack[i] == m { return true }
    }
    return false
}

fn findImport(alias: string): ?^Import {
    for i in 0..len(curModule.imports) {
        if curModule.imports[i].alias == alias { return handle(curModule.imports[i]) }
    }
    return nil
}

fn findExport(m: ^Module, name: string): ?^Sym {
    for i in 0..len(m.globals) {
        let s = m.globals[i]
        if s.name == name && s.exported { return s }
    }
    return nil
}

// `alias::name`: the alias is always a module, even if a local has its name; the member is
// looked up only in that module's exports
fn importModule(alias: string, line: int, col: int): ^Module {
    let im = findImport(alias)
    if im != nil { return im.mod }
    errorAt("'" + alias + "' is not a module", line, col)
    return curModule
}

fn exportOf(alias: string, member: string, line: int, col: int): ^Sym {
    let m = importModule(alias, line, col)
    let s = findExport(m, member)
    if s != nil { return s }
    errorAt("module '" + m.name + "' has no exported member '" + member + "' (only 'pub' declarations are visible)", line, col)
    return newSym("var", member, nil)
}

// a module-level name from another module is printed qualified
fn qualifiedSymName(s: ^Sym): string {
    if s.owner != "" && s.owner != curModuleName { return s.owner + "::" + s.name }
    return s.name
}

// the symbol a designator starts with: alias::name when qualified (the alias is a module even
// if a local has its name), otherwise the ordinary lookup. lastDesigName is its display name.
var lastDesigName = ""

fn designatorSym(name: string, line: int, col: int): ^Sym {
    if sym == T_COLONCOLON {
        next()
        if sym != T_IDENT { errorAt("expected an exported name after '::'", tline, tcol) }
        let member = ident()
        lastDesigName = name + "::" + member
        return exportOf(name, member, line, col)
    }
    lastDesigName = name
    return lookup(name)
}

// a later file declaring the same module name is an error; the root is in the same table
fn registerModule(mod: ^Module, line: int) {
    for i in 0..len(modules) {
        if modules[i].path != mod.path && modules[i].name == mod.name {
            errorAt("module '" + mod.name + "' is declared by both " + modules[i].path + " and " + mod.path, line, 1)
        }
    }
}

// the import cycle text, from the stack entry that is the target to the closing import
fn cycleTextModule(target: ^Module, closing: string): string {
    var k = 0
    while k < len(importStack) && importStack[k] != target { k += 1 }
    var msg = "import cycle: "
    while k < len(importStack) {
        msg = msg + importStackNames[k] + " -> "
        k += 1
    }
    return msg + closing
}

// ======================================================== emission helpers

// A list of jumps waiting for one target is 0 when empty, else the first of them; see putRel.
fn waitJump(head: int, at: int): int {
    putRel(at, head)
    return at
}

fn joinWaits(a: int, b: int): int {
    if a == 0 { return b }
    var at = a
    while getRel(at) != 0 { at = getRel(at) }
    putRel(at, b)
    return a
}

fn fixTo(head: int, target: int) {
    var at = head
    while at != 0 {
        let next = getRel(at)
        fix(at, target)
        at = next
    }
}

fn fixHere(head: int) { fixTo(head, pc()) }

fn jmpTo(target: int) { fix(jmp(), target) }

fn fixHere1(at: int) { fix(at, pc()) }

fn callAbs(addr: int) {
    emit(0xE8)
    append(farCalls, pc())
    emit32(addr - (CODE_BASE + pc() + 4))
}

fn rodAlign() {
    while len(rodata) % 8 != 0 { append(rodata, 0) }
}

fn rod64(v: int) {
    var x = v
    for i in 0..8 {
        append(rodata, byte(x))
        x = x >> 8
    }
}

fn stringLit(data: string): int {
    for i in 0..len(strKeys) {
        if strKeys[i] == data { return strAddrs[i] }
    }
    rodAlign()
    let addr = RODATA_BASE + len(rodata)
    rod64(len(data))
    for i in 0..len(data) { append(rodata, data[i]) }
    append(strKeys, data)
    append(strAddrs, addr)
    return addr
}

fn rodataString(addr: int): string {
    let off = addr - RODATA_BASE
    var n = 0
    for i in 0..8 { n = n | int(rodata[off + i]) << (8 * i) }
    let b = new []byte(0)
    for i in 0..n { append(b, rodata[off + 8 + i]) }
    return string(b)
}

// [size][n owned][offsets...][n strings][offsets...]: what freeing a record frees
fn descriptor(size: int, ptrs: &[]int, strs: &[]int): int {
    rodAlign()
    let addr = RODATA_BASE + len(rodata)
    rod64(size)
    rod64(len(ptrs))
    for p in ptrs { rod64(p) }
    rod64(len(strs))
    for p in strs { rod64(p) }
    return addr
}

// ============================================================ Result[T]

fn isOwned(t: ^Type): bool

// The ok variant of Result[base]: a record with one field, value, at offset 0, whose descriptor owns the
// payload when base is owned and drops its reference when base is a string.
fn okVariantOf(base: ^Type): ^Type {
    let okv = newType("record", "ok", nil)
    append(okv.fields, new Field{name: "value", offset: 0, typ: base})
    let ptrs = new []int(0)
    let strs = new []int(0)
    if isOwned(base) { append(ptrs, 0) }
    if base.kind == "string" { append(strs, 0) }
    okv.desc = descriptor(8, ptrs, strs)
    return okv
}

// The one err variant every Result[T] shares: message at offset 0, code at 8. One descriptor for the
// whole program is what lets an error cell made for one T be returned as another (see try).
var errVariant: ?^Type = nil

fn errVariantType(): ^Type {
    let have = errVariant
    if have != nil { return have }
    let e = newType("record", "err", nil)
    append(e.fields, new Field{name: "message", offset: 0, typ: tString})
    append(e.fields, new Field{name: "code", offset: 8, typ: tInt})
    let ptrs = new []int(0)
    let strs = new []int(0)
    append(strs, 0)
    e.desc = descriptor(16, ptrs, strs)
    errVariant = e
    return e
}

// Result[base], made once per base type and cached in base.resultOf: the tag of an ok cell is this
// variant's descriptor, so every mention of Result[int] must be the same Type object.
fn derivedResult(base: ^Type): ^Type {
    let t = newType("result", "", base)
    let okv = okVariantOf(base)
    let ev = errVariantType()
    append(t.variants, okv)
    append(t.variants, ev)
    base.resultOf = t
    return t
}

fn mem(base: int, index: int, disp: int, scale: int): Mem {
    return new Mem{base: base, index: index, disp: disp, scale: scale}
}

fn memOf(x: &Item): Mem { return mem(x.base, x.index, x.disp, x.scale) }

fn movRR(d: int, s: int) {
    if d != s { opReg(0x8B, d, s, true, false) }
}

fn pushR(r: int) {
    push(r)
    depth += 8
}

fn popR(r: int) {
    pop(r)
    depth -= 8
}

fn epilogue() {
    emit(0xC9)                   // leave: mov rsp,rbp; pop rbp
    emit(0xC3)                   // ret
}

// ===================================================== registers and items

// The function being compiled has locals in registers and no temporary is free. The locals' registers become
// temporaries, as they are with no locals in registers, and the pass goes on to the end of the function,
// its code to be thrown away: it reports what the function with all its locals in memory would report
// (an error at a later token, or the exhaustion again, which is then the real one), and if it reaches the
// end without one, fnDecl compiles the function again with no registers for locals (homeRetry).
fn giveUpHomes() {
    for r in 12..16 {
        if (homeBits & (1 << r)) != 0 { append(free, r) }
    }
    homeBits = 0
    homeRetry = true
}

fn alloc(): int {
    if len(free) == 0 && homeBits != 0 { giveUpHomes() }
    if len(free) == 0 { error("expression too complex (out of registers)") }
    let r = free[0]
    for i in 1..len(free) { free[i - 1] = free[i] }
    truncate(free, len(free) - 1)
    return r
}

fn release(r: int) {
    if containsInt(pool, r) && !containsInt(free, r) && (homeBits & (1 << r)) == 0 { append(free, r) }
}

fn releaseItem(x: &Item) {
    if x.mode == "reg" {
        release(x.r)
    } else if x.mode == "mem" || x.mode == "elem" {
        if x.base >= 0 && x.base != RBP { release(x.base) }
        if x.index >= 0 { release(x.index) }
    }
}

// the pool registers an item holds its place in. A method receiver was evaluated before its call,
// and the call consumes those registers: they are not saved and restored around it as an outer
// expression's registers are (that would leak them on every call).
fn itemRegs(x: &Item): int {
    // a home register belongs to a local and is saved around every call like any other local;
    // only the pool registers the receiver's place was built in are consumed
    if x.mode == "reg" {
        if x.r >= 0 && (homeBits & (1 << x.r)) == 0 { return 1 << x.r }
        return 0
    }
    var set = 0
    if x.mode == "mem" || x.mode == "elem" {
        if x.base >= 0 && x.base != RBP && (homeBits & (1 << x.base)) == 0 { set = set | (1 << x.base) }
        if x.index >= 0 && (homeBits & (1 << x.index)) == 0 { set = set | (1 << x.index) }
    }
    return set
}

// the registers in use, as a set: bit r is set for register r
fn usedRegs(): int {
    var set = 0
    let poolRefs = &pool
    for r in poolRefs {
        if !containsInt(free, r) { set = set | (1 << r) }
    }
    return set
}

// the registers not in busy are free, in pool order
fn setFree(busy: int) {
    truncate(free, 0)
    let poolRefs = &pool
    for r in poolRefs {
        if ((busy | homeBits) & (1 << r)) == 0 { append(free, r) }
    }
}

// pushes the registers in the set, in pool order; popRegs pops them in reverse
fn pushRegs(set: int) {
    let poolRefs = &pool
    for r in poolRefs {
        if (set & (1 << r)) != 0 { pushR(r) }
    }
}

fn popRegs(set: int) {
    var i = len(pool) - 1
    while i >= 0 {
        if (set & (1 << pool[i])) != 0 { popR(pool[i]) }
        i -= 1
    }
}

// the C argument registers, in order
fn argReg(i: int): int {
    if i == 0 { return RDI }
    if i == 1 { return RSI }
    if i == 2 { return RDX }
    return RCX
}

fn trapBounds(line: int) {
    emit(0xBF)
    emit32(line)
    emit(0x48)
    emit(0x83)
    emit(0xE4)
    emit(0xF0)
    callAbs(RT_TEXT + 8 * RT_PANIC_BOUNDS)
}

fn boundsCheck(idx: int, length: Mem, line: int) {
    opMem(0x3B, idx, length, true, false)
    emit(0x72)
    emit(14)
    trapBounds(line)
}

fn resolve(mut x: &Item) {
    if x.mode == "elem" {
        boundsCheck(x.index, mem(x.base, -1, 0, 8), x.line)
        opMem(0x8B, x.base, mem(x.base, -1, 16, 8), true, false)
        x.mode = "mem"
        x.disp = 8
        x.scale = x.width
    }
}

fn load(x: Item): Item {
    if x.mode == "reg" {
        if !x.home { return x }
        let c = alloc()                       // a local's own register is copied: the caller may change what it gets
        let s0 = here()
        movRR(c, x.r)
        cpAt = s0
        cpEnd = here()
        cpDst = c
        cpSrc = x.r
        return makeReg(x.typ, c)
    }
    if x.mode == "mem" && x.pair {
        // a &I local's own pair slot: its value is the pair's address, not its first word (v3 B1)
        releaseItem(x)
        let c = alloc()
        opMem(0x8D, c, memOf(x), true, false)
        return makeReg(x.typ, c)
    }
    var r = 0
    if x.mode == "const" {
        r = alloc()
        movRI(r, x.val)
    } else if x.mode == "mem" || x.mode == "elem" {
        resolve(x)
        releaseItem(x)
        r = alloc()
        if x.width == 1 {
            opMem(0x0FB6, r, memOf(x), true, false)
        } else {
            opMem(0x8B, r, memOf(x), true, false)
        }
    } else if x.mode == "cond" {
        r = alloc()
        if x.T == 0 && x.F == 0 {
            opReg(0x0F90 + x.cc, 0, r, false, true)
            opReg(0x0FB6, r, r, true, true)
        } else {
            x.F = waitJump(x.F, jcc(x.cc ^ 1))
            fixHere(x.T)
            movRI(r, 1)
            let j = jmp()
            fixHere(x.F)
            movRI(r, 0)
            fix(j, pc())
        }
    }
    return makeReg(x.typ, r)
}

// the item in a register that is only read: a local's own register is used where it is
fn asReg(x: Item): Item {
    if x.mode == "reg" { return x }
    return load(x)
}

fn loadCond(x: Item): Item {
    if x.typ.kind != "bool" { error("condition must be bool, not " + tname(x.typ)) }
    if x.mode == "cond" { return x }
    if x.mode == "mem" {
        releaseItem(x)
        aluMI(7, memOf(x), 0)
        drop(x)
    } else {
        let y = asReg(x)
        opReg(0x85, y.r, y.r, true, false)
        release(y.r)
    }
    let c = newItem("cond", tBool)
    c.cc = CC_NE
    return c
}

fn falseJump(mut x: &Item): int {
    x.F = waitJump(x.F, jcc(x.cc ^ 1))
    fixHere(x.T)
    return x.F
}

// the operation noted in the fold fields, on the local h instead of its copy
fn applyFold(h: int) {
    let form = foldForm
    let opc = foldOpc
    let arg = foldArg
    truncCode(foldAt)
    if form == 1 {
        aluRI(opc, h, arg)
    } else if form == 2 {
        opReg(opc, h, arg, true, false)
    } else {
        opReg(0x69, h, h, true, false)
        emit32(arg)
    }
}

// binop emitted an operation on the register t at a0; it is foldable if it follows the copy of a local into t
fn noteFold(a0: int, form: int, opc: int, arg: int, t: int) {
    foldEnd = -1
    if cpEnd == a0 && cpDst == t {
        foldAt = cpAt
        foldHome = cpSrc
        foldT = t
        foldForm = form
        foldOpc = opc
        foldArg = arg
        foldEnd = here()
    }
}

fn store(dst: Item, source: Item) {
    var src = source
    if dst.home {
        if src.mode == "const" {
            movRI(dst.r, src.val)
        } else {
            src = asReg(src)
            if foldEnd == here() && foldT == src.r && foldHome == dst.r && barrier <= foldAt {
                applyFold(dst.r)
            } else {
                movRR(dst.r, src.r)
            }
            release(src.r)
        }
        return
    }
    if src.mode != "const" { src = asReg(src) }
    resolve(dst)
    if dst.width == 1 {
        if src.mode == "const" {
            opMem(0xC6, 0, memOf(dst), false, false)
            emit(src.val & 255)
        } else {
            opMem(0x88, src.r, memOf(dst), false, true)
        }
    } else if src.mode == "const" && fits32(src.val) {
        opMem(0xC7, 0, memOf(dst), true, false)
        emit32(src.val)
    } else {
        src = asReg(src)
        opMem(0x89, src.r, memOf(dst), true, false)
    }
    if src.mode == "reg" { release(src.r) }
    releaseItem(dst)
}

fn materialise(x: Item): Item {
    if x.mode == "mem" || x.mode == "elem" || x.mode == "cond" { return load(x) }
    return x
}

// =================================================================== calls

// the saved registers are popped, and the ones that were not in use are free again
fn restoreRegs(saved: int) {
    popRegs(saved)
    setFree(saved)
}

var argConsts = new []int(0)      // rtCall's constant arguments: a call owns the part from its base up, so load() may re-enter

// Calls a runtime routine with the C ABI; live registers, including the
// arguments, are pushed first so the collector sees every pointer. A constant
// argument needs no register: it goes straight to its argument register.
fn rtCall(slot: int, args: []?Item, ret: ^Type): Item {
    // argReg maps index 3 and every higher index to RCX, silently clobbering argument 3: a fifth
    // argument needs a descriptor block or a stack convention, so catch it as a compiler bug here
    if len(args) > 4 { error("a runtime call has at most four arguments") }
    let regs = new []int(0)                 // -1 for a constant, which is in argConsts
    let base = len(argConsts)
    let temps = new []bool(0)
    for ai in 0..len(args) {
        let a = take(args[ai])
        if a != nil {
            append(temps, a.strTemp && slot != RT_STR_DEC)    // dropping a string is its own drop
            if a.mode == "const" && !a.strTemp {
                append(regs, -1)
                append(argConsts, a.val)
                drop(a)
            } else {
                let la = asReg(a)                // a local's own register is read where it is
                append(regs, la.r)
                append(argConsts, 0)
            }
        } else {
            drop(a)
        }
    }
    let saved = usedRegs() & ~homeBits      // the C runtime keeps r12 to r15, where the locals are
    pushRegs(saved)
    for i in 0..len(regs) {
        if regs[i] < 0 { movRI(argReg(i), argConsts[base + i]) } else { movRR(argReg(i), regs[i]) }
    }
    truncate(argConsts, base)
    let pad = depth % 16
    if pad != 0 {
        aluRI(5, RSP, 8)
        depth += 8
    }
    callAbs(RT_TEXT + 8 * slot)
    if pad != 0 {
        aluRI(0, RSP, 8)
        depth -= 8
    }
    popRegs(saved)
    var got = -1
    if ret != tVoid {
        got = alloc()
        movRR(got, RAX)
    }
    for i in 0..len(regs) {
        if temps[i] {
            // not rtCall1: it comes later, and a forward heading would count as freeing anything
            let one = new []?Item(0)
            append(one, makeReg(tString, regs[i]))
            rtCall(RT_STR_DEC, one, tVoid)
        }
    }
    for r in regs { release(r) }
    if ret == tVoid { return voidItem() }
    let res = makeReg(ret, got)
    res.strTemp = ret == tString            // every string a runtime call returns is fresh
    return res
}

fn rtCall0(slot: int, ret: ^Type): Item { return rtCall(slot, new []?Item(0), ret) }

fn rtCall1(slot: int, a: Item, ret: ^Type): Item {
    let args = new []?Item(0)
    append(args, a)
    return rtCall(slot, args, ret)
}

fn rtCall2(slot: int, a: Item, b: Item, ret: ^Type): Item {
    let args = new []?Item(0)
    append(args, a)
    append(args, b)
    return rtCall(slot, args, ret)
}

// A Result-returning builtin: the runtime builds the cell, so the compiler passes the shared err
// descriptor and the ok variant of the exact payload type as the last two arguments. The ok variant
// must be the CACHED one from derived("result", payload): match compares the cell's tag against that
// descriptor, and a fresh okVariantOf(payload) would match neither arm (try would not reveal it).
fn resultCall3(slot: int, a: Item, payload: ^Type): Item {
    let rt = derived("result", payload)
    let args = new []?Item(0)
    append(args, a)
    append(args, makeConst(tInt, errVariantType().desc))
    append(args, makeConst(tInt, rt.variants[0].desc))
    return rtCall(slot, args, rt)
}

fn resultCall4(slot: int, a: Item, b: Item, payload: ^Type): Item {
    let rt = derived("result", payload)
    let args = new []?Item(0)
    append(args, a)
    append(args, b)
    append(args, makeConst(tInt, errVariantType().desc))
    append(args, makeConst(tInt, rt.variants[0].desc))
    return rtCall(slot, args, rt)
}

// openFile's constant mode must be one of the three the runtime maps
fn checkMode(m: string) {
    if m != "r" && m != "w" && m != "a" {
        error("unknown open mode '" + m + "': use \"r\", \"w\" or \"a\"")
    }
}

// ========================================================= scopes, narrowing

fn findSym(list: &[]^Sym, name: string): ?^Sym {
    for s in list {
        if s.name == name { return s }
    }
    return nil
}

fn lookup(name: string): ^Sym {
    var i = len(blocks) - 1
    while i >= 0 {
        let s = findSym(blocks[i].syms, name)
        if s != nil { return s }
        i -= 1
    }
    for i in 0..len(lambdaOuterNames) {
        if lambdaOuterNames[i] == name {
            error("'" + name + "' is a local of the enclosing function; add it to the lambda's capture list: fn [" + name + "](...)")
        }
    }
    let g = findSym(curModule.globals, name)              // never an import: qualified names only
    if g != nil { return g }
    let u = findSym(universe, name)
    if u != nil { return u }
    error("undeclared identifier '" + name + "' (declare before use; use a forward heading for mutual recursion)")
    return newSym("var", name, nil)
}

fn declare(s: ^Sym): ^Sym {
    if len(blocks) > 0 {
        let scope = &blocks[len(blocks) - 1].syms
        if findSym(scope, s.name) != nil { error("'" + s.name + "' is already declared in this scope") }
        append(scope, s)
        return s
    }
    if findSym(curModule.globals, s.name) != nil { error("'" + s.name + "' is already declared in this scope") }
    for i in 0..len(curModule.imports) {
        if curModule.imports[i].alias == s.name { error("'" + s.name + "' clashes with a top-level declaration") }
    }
    s.owner = curModuleName
    if s.storage == "global" { registerGlobalSym(s) }
    append(curModule.globals, s)
    append(visibleGlobals, s)
    return s
}

// ============================================================== ownership

var ownedLocals = new []^Sym(0)
var condDepth = 0                 // inside the right operand of && or ||
var pinned: ?^Sym = nil            // a local being assigned through
var userCalls = 0                 // calls to obx functions compiled so far

fn isOwned(t: ^Type): bool {
    if t.kind == "record" || t.kind == "closed" || t.kind == "iface" || t.kind == "array" { return true }
    if t.kind == "opt" { return isOwned(baseOf(t)) }
    // a Result is one owned cell. errval is the type of an err(...) temporary, which is already an
    // allocated cell: it must be owned too, or a discarded err(...) would leak and noTemp would let it
    // pass as a transient (so a Result comparison could allocate an unfreed cell)
    if t.kind == "result" || t.kind == "errval" { return true }
    return false
}

fn addOwnedLocal(s: ^Sym) {
    s.owned = true
    append(ownedLocals, s)
}

fn invalidate(root: ?^Sym, via: ?^Sym, all: bool, path: string)

// frees the live owned locals ownedLocals[from..to), newest first
fn freeOwned(from: int, to: int) {
    var i = to - 1
    while i >= from {
        let s = ownedLocals[i]
        if s.owned { invalidate(s, nil, true, "") }
        if !s.moved && !s.isRefLocal {
            let x = newItem("mem", symType(s))
            x.base = RBP
            x.disp = s.offset
            if s.isStr {
                rtCall1(RT_STR_DEC, x, tVoid)
            } else {
                rtCall1(RT_FREE, x, tVoid)
            }
        }
        i -= 1
    }
}

// the index of the ']' that closes the element segment starting at i
fn elemEnd(s: string, i: int): int {
    var j = i
    while s[j] != ']' { j += 1 }
    return j
}

// p names s or something above it: its segments are the first ones of s
fn segsPrefix(p: string, s: string): bool {
    var i = 0
    var j = 0
    while i < len(p) {
        if j >= len(s) { return false }
        if p[i] == '[' {
            if s[j] != '[' { return false }
            let pe = elemEnd(p, i)
            let se = elemEnd(s, j)
            // two known elements must be the same one; an unknown one may be any
            if pe - i > 1 && se - j > 1 {
                if pe - i != se - j { return false }
                for k in 0..pe - i {
                    if p[i + k] != s[j + k] { return false }
                }
            }
            i = pe + 1
            j = se + 1
        } else {
            if p[i] != s[j] { return false }
            i += 1
            j += 1
        }
    }
    return j == len(s) || s[j] == '/'
}

// ------------------------------------------------------------ joining bindings

// the places of two deep bindings of one root, joined: the same place, or the whole root ("" = anywhere).
// Neither the shorter nor the longer of a place and the place below it is right: a change under the
// shorter one is missed by the longer (a change to /a/b misses /a), and a change through the reference
// is at its place plus the path written, which is not the same place for the two (see placeIn). A
// common prefix is no better: a change to /a/b misses a join at /a of /a/b and /a/c.
fn joinPath(pa: string, pb: string): string {
    if pa == pb { return pa }
    if segsPrefix(pa, pb) && !segsPrefix(pb, pa) { return "" }
    if segsPrefix(pb, pa) && !segsPrefix(pa, pb) { return "" }
    return ""
}

fn sameParent(a: ?^Sym, b: ?^Sym): bool {
    if a == nil { return b == nil }
    if b == nil { return false }
    return a == b
}

// the binding of a path that joins a and b: every root either may point into, deep where either may,
// at the place that covers both; writable only where both are, and a parent only where equal
fn joinBind(a: ^RefBind, b: ^RefBind): ^RefBind {
    if a == b || b == noneBind { return a }
    if a == noneBind { return b }
    var roots = new []^Sym(0)
    var deeps = new []bool(0)
    var paths = new []string(0)
    var changed = false
    for i in 0..len(a.roots) {
        append(roots, a.roots[i])
        append(deeps, a.deeps[i])
        append(paths, a.paths[i])
    }
    for j in 0..len(b.roots) {
        var found = false
        // a reference to a root's whole object and one inside it stay two entries: a change through the
        // reference is at the place it points at plus the path written (see placeIn), which they differ in
        for i in 0..len(roots) {
            if roots[i] == b.roots[j] && deeps[i] == b.deeps[j] {
                found = true
                let p = joinPath(paths[i], b.paths[j])
                if p != paths[i] { changed = true }
                paths[i] = p
            }
        }
        if !found {
            append(roots, b.roots[j])
            append(deeps, b.deeps[j])
            append(paths, b.paths[j])
            changed = true
        }
    }
    let writable = a.writable && b.writable
    if writable != a.writable { changed = true }
    var parent: ?^Sym = a.parent
    if !sameParent(a.parent, b.parent) {
        parent = nil
        changed = true
    }
    if !changed { return a }
    return arenaBind(roots, deeps, paths, writable, parent)
}

// the places e covers for a place of b, both in one root: a whole-object pointer covers only
// whole-object ones, and an e whose place lies under b's covers b's, since e is hit by all b is
fn coversPlace(ed: bool, ep: string, bd: bool, bp: string, strict: bool): bool {
    if !bd { return !strict || !ed || ep == "" }
    if !ed { return false }
    if ep == "" { return true }
    // strict: a change made through the reference is at its place plus the path written, so only the same
    // place (or anywhere) is checked against the same changes
    if strict { return ep == bp }
    return bp != "" && segsPrefix(bp, ep)
}

// the binding b, at the end of a loop's body, is covered by e, the binding the body was checked with:
// every change that reaches b is one e was checked against, and b is writable wherever e is (a write
// checked against e is allowed through b too)
fn bindCovers(e: ^RefBind, b: ^RefBind, strict: bool): bool {
    if b == noneBind || b == e { return true }
    if e.writable && !b.writable { return false }
    if !sameParent(e.parent, b.parent) { return false }
    for j in 0..len(b.roots) {
        var covered = false
        for i in 0..len(e.roots) {
            if e.roots[i] == b.roots[j] && coversPlace(e.deeps[i], e.paths[i], b.deeps[j], b.paths[j], strict) {
                covered = true
            }
        }
        if !covered { return false }
    }
    return true
}

// The state of the owned locals on one path: moves must agree where paths join, while suspicion,
// freshness and bindings are the join of the paths'. See PState.
fn snapshot(): PState {
    let locals = &ownedLocals
    let n = len(locals)
    var flags = new []bool(4 * n)
    var binds = new []^RefBind(0)
    for i in 0..n {
        flags[i] = locals[i].moved
        flags[n + i] = locals[i].suspect
        flags[2 * n + i] = locals[i].fresh
        flags[3 * n + i] = locals[i].carryFreed
        append(binds, locals[i].bind)
    }
    return new PState{flags: flags, binds: binds}
}

// no moves, no suspicion, every local fresh and nothing pointed at: where a join begins
fn neutralState(n: int): PState {
    var flags = new []bool(4 * n)
    var binds = new []^RefBind(0)
    for i in 0..n {
        flags[2 * n + i] = true
        append(binds, noneBind)
    }
    return new PState{flags: flags, binds: binds}
}

fn emptyState(): PState { return neutralState(0) }

// the number of locals a state covers
fn localsIn(st: &PState): int { return len(st.binds) }

fn copyState(a: &PState): PState {
    let n = len(a.flags)
    let m = len(a.binds)
    var flags = new []bool(n)
    var binds = new []^RefBind(0)
    for i in 0..n { flags[i] = a.flags[i] }
    for i in 0..m { append(binds, a.binds[i]) }
    return new PState{flags: flags, binds: binds}
}

fn restore(st: &PState) {
    let n = localsIn(st)
    for i in 0..n {
        ownedLocals[i].moved = st.flags[i]
        ownedLocals[i].suspect = st.flags[n + i]
        ownedLocals[i].fresh = st.flags[2 * n + i]
        ownedLocals[i].carryFreed = st.flags[3 * n + i]
        ownedLocals[i].bind = st.binds[i]
    }
}

// a deferred body runs where its block is left, so the suspicion, freshness and bindings it
// leaves are taken back here; its moves are kept, since a deferred body may free
fn restoreDeferred(st: &PState) {
    let n = localsIn(st)
    for i in 0..n {
        ownedLocals[i].suspect = st.flags[n + i]
        ownedLocals[i].fresh = st.flags[2 * n + i]
        ownedLocals[i].bind = st.binds[i]
    }
}

// the moves of a state, without the rest (a loop's exits are joined in afterwards)
fn restoreMoved(st: &PState) {
    for i in 0..localsIn(st) { ownedLocals[i].moved = st.flags[i] }
}

// where paths join: st's suspicion, bindings and freshness join the current ones
fn joinSuspect(st: &PState) {
    let n = localsIn(st)
    for i in 0..n {
        let s = ownedLocals[i]
        if st.flags[n + i] { s.suspect = true }
        if st.flags[i] && s.isRefLocal { s.moved = true }
        if st.flags[3 * n + i] { s.carryFreed = true }
        let jb = joinBind(s.bind, st.binds[i])
        s.bind = jb
        s.fresh = s.fresh && st.flags[2 * n + i]
    }
}

// as joinSuspect, but without suspicion (a continue's exit carries its suspicion to the top only)
fn joinBinds(st: &PState) {
    let n = localsIn(st)
    for i in 0..n {
        let s = ownedLocals[i]
        if st.flags[3 * n + i] { s.carryFreed = true }
        let jb = joinBind(s.bind, st.binds[i])
        s.bind = jb
        s.fresh = s.fresh && st.flags[2 * n + i]
    }
}

// per local: suspect where either state is, bindings joined, fresh only where both are; moves are b's, except
// that a reference local is invalid where either state has it invalid (its uses are checked, see nameItem)
fn joinStates(a: &PState, b: &PState): PState {
    let out = copyState(b)
    let n = localsIn(b)
    for i in 0..n {
        if a.flags[i] && ownedLocals[i].isRefLocal { out.flags[i] = true }
        if a.flags[n + i] { out.flags[n + i] = true }
        if a.flags[3 * n + i] { out.flags[3 * n + i] = true }
        out.flags[2 * n + i] = out.flags[2 * n + i] && a.flags[2 * n + i]
        let jb = joinBind(a.binds[i], b.binds[i])
        out.binds[i] = jb
    }
    return out
}

// a loop's exit (a break, a continue, or the body's end) joins the loop's accumulated state, for the
// locals the loop began with: the exit's st has at least as many
fn absorb(mut acc: &PState, st: &PState) {
    let m = localsIn(acc)
    let n = localsIn(st)
    for i in 0..m {
        if st.flags[i] && ownedLocals[i].isRefLocal { acc.flags[i] = true }
        if st.flags[n + i] { acc.flags[m + i] = true }
        if st.flags[3 * n + i] { acc.flags[3 * m + i] = true }
        acc.flags[2 * m + i] = acc.flags[2 * m + i] && st.flags[2 * n + i]
        let jb = joinBind(acc.binds[i], st.binds[i])
        acc.binds[i] = jb
    }
}

// A loop's carry marks are its own: the marks from before it are set aside while it is compiled, and
// joined back where it ends, so that a loop checks only what changes inside it (see loopBindCheck)
fn loopMarksSave(): []bool {
    var saved = new []bool(len(ownedLocals))
    for i in 0..len(ownedLocals) {
        saved[i] = ownedLocals[i].carryFreed
        ownedLocals[i].carryFreed = false
    }
    return saved
}

fn loopMarksJoin(saved: []bool) {
    for i in 0..len(saved) {
        if saved[i] { ownedLocals[i].carryFreed = true }
    }
}

// a defer body uses the reference local s: if it was declared outside the body, its binding and validity
// are checked where the block is left (see checkDeferUses)
fn noteDeferUse(s: ^Sym) {
    for i in 0..len(deferUses) {
        if ownedLocals[i] == s { deferUses[i] = true }
    }
}

// whether s is one of the first mark locals (declared before a defer body was entered)
fn declaredBefore(s: ^Sym, mark: int): bool {
    for i in 0..mark {
        if ownedLocals[i] == s { return true }
    }
    return false
}

// a reference is pointed afresh by the body of a loop before it is read there: the reads before
// that depend on the back edge, so they are not fresh
fn clearFresh() {
    let locals = &ownedLocals
    for s in locals { s.fresh = false }
}

// the first owned local whose move state differs between a and b, or nil. A reference local's invalidation
// is not a difference: where paths join it is invalid where either is, and a use of it is what is refused
fn stateDiff(a: &PState, b: &PState): ?^Sym {
    let n = localsIn(b)
    for i in 0..localsIn(a) {
        if i < n && a.flags[i] != b.flags[i] && !ownedLocals[i].isRefLocal { return ownedLocals[i] }
    }
    return nil
}

fn sameStates(a: &PState, b: &PState, line: int, col: int) {
    let d = stateDiff(a, b)
    if d != nil {
        errorAt("'" + d.name + "' is moved on one path but not another; move it on every path or none", line, col)
    }
}

// the held places are defined with the checks that use them (heldMove: see below)
fn heldMove(s: ^Sym)
fn originMove(s: ?^Sym, move: bool)
fn loopOriginPend(s: ^Sym)
fn pendPush(x: ^Sym, o: ^Sym, what: string)
fn pendDrop(k: int)
fn originFree(r: ^Sym, what: string)
fn originFreeAt(r: ^Sym, path: string, strict: bool, what: string)
fn placeFreeChange(x: &Item, strict: bool, what: string)
fn placeFreeVia(orig: ?^Sym, raw: string, strict: bool, what: string)

// Takes ownership of x's value, which is about to be stored in a variable,
// field, element or parameter, or returned.
fn consume(mut x: &Item) {
    if x.typ.kind == "string" {
        // the destination will hold a reference: a fresh string hands over its
        // own, anything else gets a new one (literals need none)
        if x.strTemp {
            x.strTemp = false
        } else if x.mode != "const" {
            let r = rtCall1(RT_STR_INC, dupItem(x), tString)
            x.mode = "reg"
            x.r = r.r
            x.base = -1
            x.index = -1
            x.sym = nil
            x.strTemp = false
        }
        return
    }
    if !isOwned(x.typ) || x.mode == "reg" || x.mode == "const" { return }
    let s = x.sym
    if x.borrowed || (s != nil && s.isRef) { error("cannot move out of a reference: a reference only borrows") }
    if s != nil && s.iterating { error("cannot move '" + s.name + "' while a for loop walks it") }
    if x.mode == "mem" && s != nil {
        if s.storage != "local" { error("cannot move out of global '" + qualifiedSymName(s) + "'; use take() on an optional one") }
        if inDefer { error("cannot move '" + s.name + "' inside defer") }
        if condDepth > 0 { error("cannot move '" + s.name + "' inside && or ||") }
        if pinned == s { error("cannot move '" + s.name + "' while assigning into it") }
        if s.deferUse { error("'" + s.name + "' is used by a defer and cannot be moved") }
        originMove(s, true)
        s.moved = true
        s.touches = s.touches + 1
        heldMove(s)
        invalidate(s, nil, true, "")                  // references into it now dangle
        return
    }
    error("cannot move out of a field or element; use take() on an optional one")
}

// A string read from a variable, field or element, about to be held while
// more code runs (which might replace it), takes a reference of its own.
fn pinStr(x: Item): Item {
    if x.typ.kind == "string" && !x.strTemp && x.mode != "const" {
        consume(x)
        x.strTemp = true
        return x
    }
    return materialise(x)
}

fn addStrLocal(s: ^Sym) {
    s.isStr = true
    append(ownedLocals, s)
}

// ============================================================= references

var refMode = 0                   // set by parseRefType: 0 plain, 1 &

fn mutableOf(x: &Item): bool
fn deepOf(x: &Item): bool
fn parentOf(x: &Item): ?^Sym
fn isRefParam(s: ^Sym): bool

// the place in the i-th root of r's binding of the designator whose path is xpath, written through r.
// A reference to the root's whole object: the path written. One that points at the place bpath of the root:
// bpath plus the path written. One with no known place may point anywhere in the root: the whole root.
// So does a reference local that a loop has not pointed afresh (fresh): the loop may have pointed it
// elsewhere when the next iteration begins, and the body is compiled once, with the place it had on entry.
fn placeIn(r: ^Sym, i: int, xpath: string): string {
    let b = r.bind
    if r.isRefLocal && !r.fresh && recording > 0 { return "" }
    if !b.deeps[i] { return xpath }
    if b.paths[i] == "" { return "" }
    return b.paths[i] + xpath
}

// the binding a reference to x takes: what x may point into, through the binding of the reference it
// goes through; a constant points at nothing
fn itemBind(x: &Item): ^RefBind {
    if x.viaHandle { return singleBind(handleSym, deepOf(x), x.path, mutableOf(x), parentOf(x)) }
    let r = x.root
    if x.mode == "const" || r == nil { return noBind }
    if !r.isRef { return singleBind(r, x.deref, x.path, true, nil) }
    let rb = r.bind
    var roots = new []^Sym(0)
    var deeps = new []bool(0)
    var paths = new []string(0)
    // a copy of a reference local that a loop has not pointed afresh may be a copy of another place on the
    // next iteration: it points anywhere in its roots (see placeIn)
    let moving = r.isRefLocal && !r.fresh && recording > 0
    for i in 0..len(rb.roots) {
        append(roots, rb.roots[i])
        append(deeps, x.deref || moving || rb.deeps[i])
        // a place reached through a reference is at the reference's place plus the path written
        if x.deref { append(paths, placeIn(r, i, x.path)) } else if moving { append(paths, "") } else { append(paths, rb.paths[i]) }
    }
    var parent: ?^Sym = nil
    if r.isRefLocal {
        if x.deref { parent = r } else { parent = rb.parent }
    }
    return arenaBind(roots, deeps, paths, rb.writable, parent)
}

// x is about to be borrowed: the binding it takes, after the checks borrowing needs
fn borrowBind(x: &Item): ^RefBind {
    if x.mode == "const" { return noBind }
    if x.viaHandle { return itemBind(x) }
    if x.mode == "reg" && isOwned(x.typ) {
        error("store this value in a variable first: a reference cannot borrow from a temporary")
    }
    let b = itemBind(x)
    if len(b.roots) == 0 { error("only variables, fields and elements can be borrowed") }
    return b
}

// the same binding with another parent
fn rebind(b: ^RefBind, parent: ?^Sym): ^RefBind {
    var roots = new []^Sym(0)
    var deeps = new []bool(0)
    var paths = new []string(0)
    for i in 0..len(b.roots) {
        append(roots, b.roots[i])
        append(deeps, b.deeps[i])
        append(paths, b.paths[i])
    }
    return arenaBind(roots, deeps, paths, b.writable, parent)
}

// true if some place the binding may point into is deeper than its root's own object
fn anyDeep(b: ^RefBind): bool {
    for i in 0..len(b.deeps) {
        if b.deeps[i] { return true }
    }
    return false
}

fn mutableOf(x: &Item): bool {
    let r = x.root
    if r != nil && r.isRef { return r.bind.writable }
    return true
}

fn deepOf(x: &Item): bool {
    if x.deref { return true }
    let r = x.root
    if r != nil && r.isRefLocal { return anyDeep(r.bind) }
    return false
}

// the reference local x was derived from, through its own binding
fn parentOf(x: &Item): ?^Sym {
    let r = x.root
    if r == nil || !r.isRefLocal { return nil }
    if x.deref { return r }
    return r.bind.parent
}

// true if a is via itself or one of the references via was derived from
fn ancestorOf(a: ^Sym, via: ?^Sym): bool {
    var p = via
    while p != nil {
        if p == a { return true }
        p = p.bind.parent
    }
    return false
}

fn makeRefLocal(v: ^Sym, b: ^RefBind) {
    v.isRef = true
    v.isRefLocal = true
    v.bind = b
    v.fresh = true
    append(ownedLocals, v)
}

// a for loop's variable borrows each element of the walked array: deep, anywhere in what the array may be in
fn walkBind(x: &Item, walked: ^Sym): ^RefBind {
    let b = itemBind(x)
    var roots = new []^Sym(0)
    var deeps = new []bool(0)
    var paths = new []string(0)
    for i in 0..len(b.roots) {
        append(roots, b.roots[i])
        append(deeps, true)
        append(paths, "")
    }
    var parent: ?^Sym = nil
    if walked.isRefLocal { parent = walked }
    return arenaBind(roots, deeps, paths, b.writable, parent)
}

// a reference parameter: it may name the same object as another one, or a global
fn isRefParam(s: ^Sym): bool { return s.isRef && !s.isRefLocal && s.storage == "local" }

// a change under root changed may free something inside root other. A change
// under a reference parameter reaches other reference parameters and globals,
// since it may be either; a change under a global reaches no parameter, since
// a function that might free under a global is never given references into it.
fn reaches(changed: ^Sym, other: ^Sym): bool {
    if changed == other { return true }
    return isRefParam(changed) && (isRefParam(other) || other.storage == "global")
}

// Paths name a place inside a root, segment by segment: "/a" for a field, "/[3]"
// for element 3 and "/[]" for an element not known at compile time. "" is the
// whole root. An element that is not known may be any element.

// the change at path p may free what a reference at path r points into: r is p
// or lies under it. "" as either side means anywhere.
fn underPath(r: string, p: string): bool {
    return r == "" || segsPrefix(p, r)
}

// two places that may be one: one lies under the other
fn pathsOverlap(a: string, b: string): bool {
    return segsPrefix(a, b) || segsPrefix(b, a)
}

// Something under root may have been freed: the root's references become
// invalid, except via (the reference the change went through) and, unless
// all, references to the root's own object; so do references that may point
// inside any other root the change reaches.
// A change that may free something is logged while a loop or a deferred body is compiled: a loop's exits
// are checked against the frees logged on their way out (see applyExit), and a deferred body's frees are
// replayed where its block is left (see replayFrees).
fn logFree(kind: int, root: ?^Sym, all: bool, path: string, via: ?^Sym) {
    if recording == 0 && !inDefer { return }
    let nfFrom = len(nonFreshLog)
    for i in 0..len(ownedLocals) {
        if ownedLocals[i].isRefLocal && !ownedLocals[i].fresh { append(nonFreshLog, i) }
    }
    append(freeArena, new FreeRec{kind: kind, root: root, all: all, path: path, via: via,
                                  nfFrom: nfFrom, nfTo: len(nonFreshLog)})
    append(freeLog, handle(freeArena[len(freeArena) - 1]))
    verifyNonFresh()
}

// the start of a loop, or of its condition: the outermost one remembers where its records begin
fn loopLogStart() {
    if recording == 0 { arenaBase = len(freeArena) }
    recording += 1
}

// the end of a loop, or of its condition: the log is kept while an outer loop or a deferred body needs it.
// The records of the outermost loop are dead then (a block that holds one is inside the loop and has closed)
fn loopLogEnd() {
    recording -= 1
    if recording == 0 && !inDefer {
        verifyNonFresh()
        if arenaBase < len(freeArena) { truncate(nonFreshLog, freeArena[arenaBase].nfFrom) }
        truncate(freeLog, 0)
        truncate(freeArena, arenaBase)
        verifyNonFresh()
    }
}

// whether a change to root (all of it, or the place path under it) may free what binding b points into
fn hitBy(b: ^RefBind, root: ?^Sym, all: bool, path: string): bool {
    if root == nil { return false }
    for i in 0..len(b.roots) {
        let r = b.roots[i]
        // a borrow through a handle may point into any object, so any change reaches it
        if r == handleSym || r == root && (all || b.deeps[i] && underPath(b.paths[i], path)) { return true }
        if r != root && b.deeps[i] && reaches(root, r) { return true }
    }
    return false
}

// whether a logged change may free what binding b points into, for the reference local s: the same test as
// invalidate and invalidateDeep make, so a reference the change was made through, or derived from, stays valid
fn freeHits(s: ^Sym, b: ^RefBind, r: ^FreeRec): bool {
    let rv = r.via
    if ancestorOf(s, rv) { return false }
    if r.kind == 0 { return hitBy(b, r.root, r.all, r.path) }
    return anyDeep(b)
}

// a change that may free something marks each reference that is not pointed afresh on every path: a read
// of it, or its being carried round a loop, is checked (see loopBindCheck). The marks are coarse: the
// loop's end narrows them to the changes that may reach the binding the next iteration starts with.
fn markCarriedFreed() {
    for i in 0..len(ownedLocals) {
        if ownedLocals[i].isRefLocal && !ownedLocals[i].fresh {
            ownedLocals[i].carryFreed = true
        }
    }
}

// a change through a handle may free anything below its target: the references inside something are marked
fn markCarriedDeep() {
    for i in 0..len(ownedLocals) {
        if ownedLocals[i].isRefLocal && !ownedLocals[i].fresh && anyDeep(ownedLocals[i].bind) {
            ownedLocals[i].carryFreed = true
        }
    }
}

// whether two states agree: the same flags, and bindings that cover one another
fn sameState(a: &PState, b: &PState): bool {
    if len(a.flags) != len(b.flags) { return false }
    for i in 0..len(a.flags) {
        if a.flags[i] != b.flags[i] { return false }
    }
    for i in 0..localsIn(a) {
        if !bindCovers(a.binds[i], b.binds[i], false) || !bindCovers(b.binds[i], a.binds[i], false) { return false }
    }
    return true
}

// The state a loop is left in (at a break, at a continue, or where the condition fails), joined with the
// state where the next iteration starts (back). A reference not pointed afresh on the way out may point
// where back points, so a free on the way (logged from the loop's start, logFrom, to at) that may reach
// what it points into moves it (a recursive call makes it suspect instead), and its binding joins back's.
fn applyExit(mut x: &PState, back: &PState, logFrom: int, at: int) {
    let n = localsIn(x)
    let m = localsIn(back)
    for i in 0..m {
        if !x.flags[2 * n + i] && ownedLocals[i].isRefLocal {
            let bb = back.binds[i]
            let s = ownedLocals[i]
            for k in logFrom..at {
                let r = freeLog[k]
                if r.kind == 2 {
                    if freeHits(s, bb, r) {
                        x.flags[n + i] = true
                        x.flags[3 * n + i] = true
                    }
                } else if freeHits(s, bb, r) {
                    x.flags[i] = true
                    x.flags[3 * n + i] = true
                }
            }
            x.binds[i] = joinBind(x.binds[i], bb)
        }
    }
}

fn invalidate(root: ?^Sym, via: ?^Sym, all: bool, path: string) {
    if root == nil { return }
    logFree(0, root, all, path, via)
    markCarriedFreed()
    let locals = &ownedLocals
    for v in locals {
        // a change through via frees only things below via: references it was
        // derived from point above it and stay valid
        if v.isRefLocal && !ancestorOf(v, via) && !v.moved {
            if hitBy(v.bind, root, all, path) {
                if v.iterating { error("cannot change what '" + v.name + "' points into while a for loop walks it") }
                v.moved = true
            }
        }
    }
}

// A change through a handle may free anything below its target, so every reference that points
// inside something is invalid, whatever it borrows from. A reference to a whole object stays
// valid: only owners free whole objects, and a change through a handle frees only below its target.
fn invalidateDeep(via: ?^Sym) {
    logFree(1, nil, false, "", via)
    markCarriedDeep()
    let locals = &ownedLocals
    for v in locals {
        if v.isRefLocal && anyDeep(v.bind) && !ancestorOf(v, via) && !v.moved {
            if v.iterating { error("cannot change what '" + v.name + "' points into while a for loop walks it") }
            v.moved = true
        }
    }
}

// a deferred error, reported at the end of the body if it writes through a handle; the earliest wins
fn notePending(line: int, col: int, msg: string) {
    if pendLine == 0 || line < pendLine || (line == pendLine && col < pendCol) {
        pendLine = line
        pendCol = col
        pendMsg = msg
    }
}

// a recursive call (or a deferred one) may write through a handle: the references inside something
// that are live now may be freed, so they are suspect until they are pointed afresh
fn markSuspects() {
    logFree(2, nil, false, "", nil)
    let locals = &ownedLocals
    for v in locals {
        if v.isRefLocal && anyDeep(v.bind) && !v.moved { v.suspect = true }
    }
}

// a loop whose body calls the function itself: a reference from before the loop that is suspect where
// the next iteration starts (back: the body's end, or a continue) may be read there, in the loop's
// condition or its body, after the call freed what it points into. The suspicion follows the paths,
// so a reference pointed afresh after the call on every path is not reported, and a reference that
// the loop does not read before pointing it afresh (usedAt: a read that is not fresh, since the loop
// began: useBefore; a read after a re-point in the same iteration sees the new binding) is not reported
// either. The
// loop variable of a for walk is rebound each iteration, so its suspicion is not carried.
fn loopSelfCheck(nOuter: int, selfBefore: int, useBefore: int, back: &PState, lv: ?^Sym, line: int, col: int) {
    if selfCalls == selfBefore { return }
    for i in 0..nOuter {
        if back.flags[localsIn(back) + i] && ownedLocals[i] != lv && ownedLocals[i].usedAt > useBefore {
            notePending(line, col, "a recursive call in this loop writes through a handle, which could free what a reference inside something points into on the next iteration")
            return
        }
    }
}

// A loop that points a reference somewhere new and reads it before pointing it again reads it on the
// next iteration with a binding the body was not checked with. That is unsafe where a change may have
// freed what the reference points into while it was not pointed afresh (carryFreed, at a read or at the
// back edge), and where the binding comes back read-only but the body was checked against a writable
// one. Otherwise the binding must be covered by the one the body was checked with (see bindCovers).
fn loopBindCheck(entry: &PState, back: &PState, useBefore: int, lv: ?^Sym, line: int, col: int, hit: []bool) {
    let n = localsIn(entry)
    for i in 0..n {
        let s = ownedLocals[i]
        let e = entry.binds[i]
        let b = back.binds[i]
        if s.isRefLocal && s != lv && s.staleUse > useBefore && !bindCovers(e, b, false) {
            if hit[i] && (s.freedUse > useBefore || back.flags[3 * n + i]) {
                errorAt("'" + s.name + "' is pointed somewhere new inside the loop, and read before it is pointed again; point it before the loop, or point it afresh before reading it in the loop", line, col)
            }
            if e.writable && !b.writable && s.writeUse > useBefore {
                errorAt("'" + s.name + "' is read-only where the loop starts again, and written before it is pointed again; point it afresh before writing it in the loop", line, col)
            }
        }
    }
}

// the error at a use of a reference that a change may have invalidated, on some path (see nameItem)
fn freedRefMsg(name: string): string {
    return "'" + name + "' may point to freed memory: something under what it points into was changed; point it again first"
}

// A reference that is invalid where the next iteration starts (a change in the loop invalidated it on some
// path to the back edge, or to a continue) is invalid at the top of the loop. The body was compiled with the
// state the loop was entered in, so a read of it that is not pointed afresh is where the invalidity shows: it
// is reported there, as a use, with the message a use of an invalid reference always gets. A loop that
// invalidates a reference and never reads it again is accepted.
fn loopCarryCheck(back: &PState, useBefore: int, lv: ?^Sym) {
    let n = localsIn(back)
    for i in 0..n {
        let s = ownedLocals[i]
        if s.isRefLocal && s != lv && back.flags[i] && s.staleUse > useBefore {
            errorAt(freedRefMsg(s.name), s.staleLine, s.staleCol)
        }
    }
}

// whether the index that begins at the current token has a '(' before its closing ']': a call (or only a
// parenthesis: that costs a pin, nothing else). The tokens are read by the lexer itself (next), so a quote in a
// char literal or a comment, a bracket in a string, and a newline in the index are what the compiler will see; the
// scanner is put back as it was, the way a function's second pass does it (fnDecl).
fn indexHasCall(): bool {
    let sPos = pos
    let sLine = line
    let sCol = col
    let sLast = last
    let sSym = sym
    let sSval = sval
    let sIval = ival
    let sTline = tline
    let sTcol = tcol
    let sSeq = tokSeq
    var depth = 1
    var found = false
    while !found && depth > 0 && sym != T_EOF {
        next()
        if sym == T_LPAREN { found = true }
        if sym == T_LBRACK { depth += 1 }
        if sym == T_RBRACK { depth -= 1 }
    }
    pos = sPos
    line = sLine
    col = sCol
    last = sLast
    sym = sSym
    sval = sSval
    ival = sIval
    tline = sTline
    tcol = sTcol
    tokSeq = sSeq
    return found
}

// ======================================================== effect summaries
// Every function records which globals it might free. Bodies are compiled
// before they can be called (declare before use), so at a call site the
// callee's summary is complete, unless it is still being compiled (recursion:
// the body treats the call as freeing anything, but the summary does not) or
// only has a forward heading: then it is assumed to free anything.

// whether a call of f may free something below the argument it gets for its parameter i: a callee that is
// not compiled yet, is being compiled, or writes through a handle may free anything
fn mutFrees(f: ^Sym, i: int): bool {
    if f.addr < 0 || f == curFn || f.freesAll || f.writesHandles { return true }
    if i >= 62 { return true }
    return (f.fnRec.pfree >> i) & 1 == 1
}

// a callee that might free nothing: compiled, not being compiled, freeing no global, not writing through a
// handle, and freeing nothing below any of its mut arguments (mutFrees: FnRec.pfree). It may still change
// them without freeing, and append to a mut array (which does not move the array: see movesFn).
// An owned by-value parameter does not make it impure: the caller's argument is a move, which consume()
// counts (touches), and the array checks see that.
fn pureFn(f: ^Sym): bool {
    if f.addr < 0 || f == curFn || f.freesAll || len(f.fnRec.freed) > 0 { return false }
    for i in 0..len(f.fnRec.pmodes) {
        if f.fnRec.pmodes[i] == 2 && mutFrees(f, i) { return false }
    }
    return true
}

// a call that counts in userCalls: one that might free (not pureFn). The index, held-array, append, truncate,
// replace and assignment-target checks guard an array header (or a record address) loaded before the call.
// Appending does not move that: an array value is a header (length, capacity, data pointer) of its own, which
// append updates in place when it reallocates the data block; an element access reads the data pointer and the
// length from the header when it is resolved, after the index has run, and a reference to an element is the
// element object (or inner header), never a slot. So only a free of the array, or of what holds it, makes a loaded
// header stale, and pureFn already says whether a callee may free (below its mut arguments through
// FnRec.pfree, a global, anything through a handle, or unknown). Truncate shrinks the header in place and frees
// only owned elements, which pfree records. A callee with a mut parameter that only writes, appends or
// truncates a scalar array is therefore not moving. See FORK.md, "Move bits".
fn movesFn(f: ^Sym): bool {
    return !pureFn(f)
}

fn mightFree(f: ^Sym, g: ^Sym): bool {
    if f.addr < 0 || f == curFn || f.freesAll { return true }
    let freed = &f.fnRec.freed
    for x in freed {
        if x == g { return true }
    }
    return false
}

// Where below its reference parameters a function may free (FnRec.pfree says only whether). One row per event:
// the function, the parameter, and "=" (the value in a place is freed) or "!" (what lies below a place is freed, not
// the place) with the place relative to the parameter. "!" alone is anywhere below. A parameter has at most
// PF_MAX rows; past that, or for an unknown place, its rows all become "!"
const PF_MAX = 4
var pfFn = new []^Sym(0)
var pfIdx = new []int(0)
var pfEv = new []string(0)

fn pfAdd(f: ^Sym, i: int, ev: string) {
    var n = 0
    for k in 0..len(pfFn) {
        if pfFn[k] == f && pfIdx[k] == i {
            if pfEv[k] == ev || pfEv[k] == "!" { return }
            n += 1
        }
    }
    if ev != "!" && n < PF_MAX {
        append(pfFn, f)
        append(pfIdx, i)
        append(pfEv, ev)
        return
    }
    for k in 0..len(pfFn) {
        if pfFn[k] == f && pfIdx[k] == i { pfEv[k] = "!" }
    }
    if n == 0 {
        append(pfFn, f)
        append(pfIdx, i)
        append(pfEv, "!")
    }
}

// the current function might free, below its reference parameter g, what ev says (see pfAdd)
fn recordParamFree(g: ^Sym, ev: string) {
    let f = curFn
    if f == nil { return }
    let pi = len(f.fnRec.params) - 1 - (g.offset - 16) / 8
    if pi < 62 {
        f.fnRec.pfree = f.fnRec.pfree | (1 << pi)
        pfAdd(f, pi, ev)
    }
}

// the current function might free global g
fn recordFree(g: ?^Sym) {
    let f = curFn
    if f == nil || g == nil { return }
    if g == handleSym {                  // a change through a handle may free anything
        f.freesAll = true
        f.writesHandles = true
        return
    }
    if g.isParam && g.isRef {            // the parameter's reference: something below it may be freed, anywhere
        recordParamFree(g, "!")
        return
    }
    if g.storage != "global" { return }
    let freed = &f.fnRec.freed
    for x in freed {
        if x == g { return }
    }
    append(f.fnRec.freed, g)
}

// after calling f: references into what f might free are no longer valid,
// and the caller inherits f's effects. A self-call adds nothing to the summary: the
// body's later frees are not recorded yet, but the body treats the call as freeing
// anything, and a caller reads the summary only once the body is finished.
fn afterCall(f: ^Sym) {
    let cur = curFn
    let all = f.addr < 0 || f == cur || f.freesAll
    if cur != nil && all && f != cur { cur.freesAll = true }
    if f == cur {
        // a recursive call may write through a handle, which is known only at the end of the body:
        // until then the references inside something that are live across it are suspect
        selfCalls += 1
        markSuspects()
        markCarriedDeep()                 // the deep references it may free are carried as any other change's are
    } else if f.addr < 0 || f.writesHandles {
        // a callee that writes through a handle, or may: references inside something may be freed
        if cur != nil { cur.writesHandles = true }
        invalidateDeep(nil)
    }
    if !pureFn(f) { invalidate(handleSym, nil, false, "") }   // and so may a borrow through a handle
    // The caller's summary inherits every global the callee may free, independently of what the
    // caller can name (B2): a middle module that does not import the defining module must still
    // carry A::g for its own callers, which may import A. recordFree dedups and ignores a
    // top-level initializer (curFn == nil).
    if !all {
        let freed = &f.fnRec.freed
        for g in freed { recordFree(g) }
    }
    // The module's visible globals are invalidated for their references' sake only: a reference
    // can only point into a global the module can name, so its direct imports suffice.
    let gs = &visibleGlobals
    for g in gs {
        if (g.kind == "var" || g.kind == "let") && (all || mightFree(f, g)) {
            invalidate(g, nil, true, "")
        }
    }
}

// the reference local a change goes through, if any
fn viaOf(x: &Item): ?^Sym {
    let r = x.root
    if r != nil && r.isRefLocal { return r }
    return nil
}

// a change through x: the roots its binding may point into lose their references, and so do the
// handle-rooted ones when x went through a handle. Such an x may have no root (handle(p).items).
fn invalidateChange(x: &Item) {
    let r = x.root
    let via = viaOf(x)
    if r != nil {
        // a write through a reference that is not pointed afresh: see loopBindCheck
        if r.isRefLocal && !r.fresh {
            useSeq += 1
            r.writeUse = useSeq
        }
        if r.isRef {
            let rb = r.bind
            for i in 0..len(rb.roots) { invalidate(rb.roots[i], via, false, placeIn(r, i, x.path)) }
        } else {
            invalidate(r, via, false, x.path)
        }
    }
    if x.viaHandle { invalidate(handleSym, via, false, "") }
}

// a change through x goes through a handle, or through a reference that may point into one
fn throughHandle(x: &Item): bool {
    if x.viaHandle { return true }
    let r = x.root
    if r != nil && r.isRef {
        for i in 0..len(r.bind.roots) {
            if r.bind.roots[i] == handleSym { return true }
        }
    }
    return false
}

// the place placeIn gave for the i-th root of the reference r is not known: the reference is deep with no place, or a
// loop has not pointed it afresh
fn unknownPlace(r: ^Sym, i: int, p: string, xpath: string): bool {
    if p != "" { return false }
    return xpath != "" || r.bind.deeps[i] || (r.isRefLocal && !r.fresh && recording > 0)
}

// the globals a change through x may free (a change through a handle may free anything), and the places below a
// reference parameter it may free (strict: what lies below the place, not the place)
fn recordFreeChange(x: &Item, strict: bool) {
    if x.viaHandle {
        recordFree(handleSym)
        return
    }
    let r = x.root
    if r == nil { return }
    if r.isRef {
        let rb = r.bind
        for i in 0..len(rb.roots) {
            let o = rb.roots[i]
            if o.isParam && o.isRef {
                // below a reference parameter: at the place the reference's binding gives in it
                let p = placeIn(r, i, x.path)
                if unknownPlace(r, i, p, x.path) {
                    recordParamFree(o, "!")
                } else if strict {
                    recordParamFree(o, "!" + p)
                } else {
                    recordParamFree(o, "=" + p)
                }
            } else {
                recordFree(o)
            }
        }
    } else {
        recordFree(r)
    }
}

// a change of an owned value that goes through a handle, or through a reference borrowed through
// one: it may free what references inside something point into
// a write through x, which is through a reference local that is not pointed afresh: see loopBindCheck
fn noteWrite(x: &Item) {
    let r = x.root
    if r != nil && r.isRefLocal && !r.fresh {
        useSeq += 1
        r.writeUse = useSeq
    }
}

fn invalidateOwnedChange(x: &Item) {
    invalidateChange(x)
    if throughHandle(x) { invalidateDeep(viaOf(x)) }
}

fn parseType(): ^Type
fn finishTypeName(name: string, uline: int, ucol: int): ^Type

fn parseRefType(): ^Type {
    refMode = 0
    if sym == T_AMP {
        next()
        if sym == T_IDENT && sval == "mut" { error("there is one reference type, &T: write mut before the parameter name, as in mut p: &T") }
        let t = parseType()
        if !isOwned(t) { error("only records, closed types and arrays can be borrowed, not " + tname(t)) }
        refMode = 1
        return t
    }
    return parseType()
}

// an owned value that nothing owns yet must be stored, not just looked at
fn noTemp(x: &Item) {
    if x.mode == "reg" && isOwned(x.typ) {
        error("store this value in a variable first: otherwise it would never be freed")
    }
}

// ===================================================== register homes

// What the pre-scan of the function being compiled found (see scanFunction): the names that are declared in
// it, with their weighted uses, and the weighted calls it makes to the program's own functions.
var scanBytes = new []byte(0)     // the names, one after another
var scanAt = new []int(0)         // where each begins in scanBytes
var scanLen = new []int(0)
var scanScore = new []int(0)      // its weighted uses
var scanPend = new []bool(0)      // it may still be declared as an int or bool local
var scanCalls = 0
var homeCap = 0                   // how many registers the function may use for locals: fewer where it nests expressions deeply

// the name src[a..b) among the scanned ones, or -1
fn findScanned(a: int, b: int): int {
    let n = b - a
    for k in 0..len(scanAt) {
        if scanLen[k] == n {
            var j = 0
            while j < n && scanBytes[scanAt[k] + j] == src[a + j] { j += 1 }
            if j == n { return k }
        }
    }
    return -1
}

fn scannedName(name: string): int {
    let n = len(name)
    for k in 0..len(scanAt) {
        if scanLen[k] == n {
            var j = 0
            while j < n && scanBytes[scanAt[k] + j] == name[j] { j += 1 }
            if j == n { return k }
        }
    }
    return -1
}

fn netScore(k: int): int { return scanScore[k] - 2 * scanCalls }

// the register for the int or bool local `name`, which is about to be declared, or -1 for a stack slot. A
// name is given one when its weighted uses are worth it and a register is free, and when the names that
// do better and are yet to be declared in the function would still have one. declares is false for a
// second register of the same local (a for loop's limit).
fn pickHome(name: string, declares: bool): int {
    if REG_HOMES == 0 || curFn == nil || inDefer || homeRetry || homeCap <= 0 { return -1 }
    let k = scannedName(name)
    if k < 0 { return -1 }
    if declares { scanPend[k] = false }
    if netScore(k) < HOME_MIN { return -1 }
    var nfree = 0
    var pick = -1
    for i in 0..homeCap {
        let r = 15 - i
        if (homeBits & (1 << r)) == 0 && containsInt(free, r) {
            nfree += 1
            if pick < 0 { pick = r }
        }
    }
    if pick < 0 { return -1 }
    var better = 0
    for m in 0..len(scanPend) {
        if scanPend[m] && m != k && netScore(m) >= HOME_MIN {
            if netScore(m) > netScore(k) || (netScore(m) == netScore(k) && m < k) { better += 1 }
        }
    }
    if nfree <= better { return -1 }
    var j = 0
    while free[j] != pick { j += 1 }
    while j + 1 < len(free) {
        free[j] = free[j + 1]
        j += 1
    }
    truncate(free, len(free) - 1)
    homeBits = homeBits | (1 << pick)
    return pick
}

// the name is declared in the function being compiled, whatever its type: it no longer competes as a candidate yet to come
fn noteDeclared(name: string) {
    let k = scannedName(name)
    if k >= 0 { scanPend[k] = false }
}

fn releaseHome(r: int) {
    homeBits = homeBits & ~(1 << r)
    append(free, r)
}

// s, just made by newLocal, takes a register if pickHome gives it one: no stack slot then
fn homeFor(s: ^Sym, name: string, declares: bool) {
    let h = pickHome(name, declares)
    if h >= 0 {
        s.home = h
        s.offset = 0
        frame -= 8
    }
}

fn isPairLocal(s: ^Sym): bool

// where a local is: its register, or its slot
fn localItem(s: ^Sym, t: ^Type): Item {
    if s.home >= 0 {
        let x = newItem("reg", t)
        x.r = s.home
        x.home = true
        return x
    }
    let x = newItem("mem", t)
    x.base = RBP
    x.disp = s.offset
    x.pair = s.pairSlot
    return x
}

fn openBlock() {
    append(blocks, new Block{syms: new []^Sym(0), defers: new []int(0), nmark: len(narrowStack),
                             omark: len(ownedLocals), hmark: len(originSyms), frees: new []^FreeRec(0),
                             freeFrom: new []int(0), uses: new []^Sym(0), useBinds: new []^RefBind(0), useFrom: new []int(0)})
}

// whether a reference bound to e at a block's end points only where it was bound to d when its defer was
// declared: every root and place of e is covered by d's, and a reference that was writable then still is.
// The body was checked against d, so a narrower e is covered by those checks, and the frees replayed
// from the body (made for every root of d) reach every root of e. The parent is not part of the target.
fn withinDeclared(d: ^RefBind, e: ^RefBind): bool {
    if d == e || e == noneBind { return true }
    if d.writable && !e.writable { return false }
    for j in 0..len(e.roots) {
        var covered = false
        for i in 0..len(d.roots) {
            if d.roots[i] == e.roots[j] && coversPlace(d.deeps[i], d.paths[i], e.deeps[j], e.paths[j], true) { covered = true }
        }
        if !covered { return false }
    }
    return true
}

// The reference locals that a deferred body uses were checked where the defer is declared, with the
// bindings and validity they had there. The body runs where the block is left, so each must be as it was:
// not pointed elsewhere, and not invalidated by a change since (or by a newer defer's frees, which have run).
fn checkDeferUses(bi: int, d: int) {
    var hi = len(blocks[bi].uses)
    if d + 1 < len(blocks[bi].useFrom) { hi = blocks[bi].useFrom[d + 1] }
    for k in blocks[bi].useFrom[d]..hi {
        let s = blocks[bi].uses[k]
        if !withinDeclared(blocks[bi].useBinds[k], s.bind) {
            error("cannot point '" + s.name + "' elsewhere while a defer uses it: the defer runs where its block is left, and would use the new target")
        }
        if s.moved {
            error("'" + s.name + "' is used by a defer but may point to freed memory at the block's end: something under what it points into was changed")
        }
        if s.suspect {
            notePending(tline, tcol, "'" + s.name + "' is used by a defer but may point to freed memory at the block's end: a recursive call writes through a handle")
        }
    }
}

// the frees of the deferred body d of blocks[bi], replayed where the block is left: the references they reach
// are moved (or carried) as at any other change, so a reference re-pointed inside the block is checked
fn replayFrees(bi: int, d: int) {
    var hi = len(blocks[bi].frees)
    if d + 1 < len(blocks[bi].freeFrom) { hi = blocks[bi].freeFrom[d + 1] }
    for k in blocks[bi].freeFrom[d]..hi {
        let r = blocks[bi].frees[k]
        // the change is replayed as it was made: through the same reference, so what it was derived from stays valid
        let rv = r.via
        if r.kind == 0 {
            let rt = r.root
            invalidate(rt, rv, r.all, r.path)
        } else if r.kind == 1 {
            invalidateDeep(rv)
        } else {
            markSuspects()
        }
    }
}

// calls the deferred statements of blocks[bi], newest first: each checks its uses against the state it
// runs in, and then its frees are applied, for the older ones to see
fn callDefers(bi: int) {
    var i = len(blocks[bi].defers) - 1
    while i >= 0 {
        checkDeferUses(bi, i)
        callLocal(blocks[bi].defers[i])
        replayFrees(bi, i)
        // the body's assignments and drops of owners happen here, not where the defer is declared
        replayFree = true
        for j in 0..len(dfOwner) {
            if dfBlock[j] == bi && dfIndex[j] == i {
                let ev = dfEv[j]
                originFreeAt(dfOwner[j], substr(ev, 1, len(ev)), ev[0] == '!', "assign over")
            }
        }
        replayFree = false
        i -= 1
    }
}

fn closeBlock(terminated: bool) {
    let last = len(blocks) - 1
    let om = blocks[last].omark
    let nm = blocks[last].nmark
    if !terminated {
        callDefers(last)
        freeOwned(om, len(ownedLocals))
    }
    let scope = &blocks[last].syms
    for s in scope {
        if s.home >= 0 && !homeRetry { releaseHome(s.home) }
    }
    // the block's symbols are freed with it: the origin list keeps only the handles still in scope
    truncate(originSyms, blocks[last].hmark)
    truncate(originDead, blocks[last].hmark)
    truncate(originNar, blocks[last].hmark)
    truncate(originLive, blocks[last].hmark)
    truncate(originPath, blocks[last].hmark)
    while len(dfBlock) > 0 && dfBlock[len(dfBlock) - 1] >= last {
        truncate(dfBlock, len(dfBlock) - 1)
        truncate(dfIndex, len(dfIndex) - 1)
        truncate(dfOwner, len(dfOwner) - 1)
        truncate(dfEv, len(dfEv) - 1)
    }
    while len(deferAt) > 0 && deferAt[len(deferAt) - 1] >= last {
        truncate(deferAt, len(deferAt) - 1)
        truncate(deferH, len(deferH) - 1)
    }
    truncate(blocks, last)
    truncate(ownedLocals, om)
    truncate(narrowStack, nm)
}

// leaving blocks early (return, break, continue): each block's defers run,
// then its live owned locals are freed, innermost first
fn runDefers(downTo: int) {
    var top = len(ownedLocals)
    var i = len(blocks) - 1
    while i >= downTo {
        callDefers(i)
        let om = blocks[i].omark
        freeOwned(om, top)
        top = om
        i -= 1
    }
}

fn newLocal(name: string, t: ^Type, kind: string): ^Sym {
    frame += 8
    let s = newSym(kind, name, t)
    s.storage = "local"
    s.offset = -frame
    if len(name) > 0 { return declare(s) }
    return s
}

// A &I local owns a two-word pair slot of its own (v3 B1). The item at s.offset is its address, at
// s.offset+8 its vtable, so a pair copied from a call site's cell or another reference is still its own.
fn newPairLocal(name: string, t: ^Type, kind: string): ^Sym {
    frame += 16
    let s = newSym(kind, name, t)
    s.storage = "local"
    s.pairSlot = true
    s.offset = -frame
    if len(name) > 0 { return declare(s) }
    return s
}

fn newRefLocalSlot(name: string, t: ^Type, kind: string, pair: bool): ^Sym {
    if pair { return newPairLocal(name, t, kind) }
    return newLocal(name, t, kind)
}

fn isPairLocal(s: ^Sym): bool { return s.pairSlot }

fn varType(s: ^Sym): ^Type {
    var i = len(narrowStack) - 1
    while i >= 0 {
        let e = &narrowStack[i]
        if e.sym == s && e.alive { return e.typ }
        i -= 1
    }
    return symType(s)
}

fn pushNarrowings(lst: &?NPair) {
    if lst == nil { return }
    append(narrowStack, new NEntry{sym: lst.sym, typ: lst.typ, depth: loopdepth, alive: true})
    pushNarrowings(&lst.next)
}

fn widen(s: ^Sym) {
    let stack = &narrowStack
    for e in stack {
        if e.sym == s && e.alive {
            if e.depth != loopdepth {
                error("'" + s.name + "' may become nil here, but it was checked outside this loop; check it inside the loop instead")
            }
            e.alive = false
        }
    }
}

// =========================================================== type syntax

fn parseType(): ^Type {
    if sym == T_FN {
        // fn (ParamTypes) [: Ret]: owned or read-only & parameters, no mut, structural
        next()
        if sym == T_LBRACK { error("a function type cannot have a capture list") }
        if sym != T_LPAREN { error("expected '(' after 'fn'") }
        next()
        let t = newFnType(tVoid)
        while sym != T_RPAREN {
            var mode = 0
            if sym == T_AMP { next(); mode = 1 }
            if sym != T_QUESTION && sym != T_LBRACK && sym != T_CARET && sym != T_FN && sym != T_IDENT {
                error("expected a parameter type")
            }
            let p = parseType()
            if mode == 1 && !isOwned(p) { error("only records, closed types and arrays can be borrowed, not " + tname(p)) }
            rejectIfaceFn(p)
            fnAddParam(t, p, mode)
            if sym != T_RPAREN {
                expect(T_COMMA, "',' or ')'")
                if sym == T_RPAREN { error("expected a parameter type") }
            }
        }
        expect(T_RPAREN, "")
        if sym == T_COLON {
            next()
            let r = parseType()
            rejectFn(r, "a function type cannot return a function value")
            rejectIfaceFn(r)
            t.base = r
        }
        return t
    }
    if sym == T_QUESTION {
        next()
        let b = parseType()
        rejectFn(b, "an optional cannot hold a function value; function values are parameters and locals only")
        if !nonNull(b) { error("only reference types can be optional, not " + tname(b)) }
        return derived("opt", b)
    }
    if sym == T_LBRACK {
        next()
        expect(T_RBRACK, "")
        let b = parseType()
        rejectFn(b, "an array cannot hold function values")
        return derived("array", b)
    }
    if sym == T_CARET {
        next()
        let b = parseType()
        if b.kind != "record" && b.kind != "closed" { error("handles name records and closed types, not " + tname(b)) }
        return derived("handle", b)
    }
    if sym == T_REF || sym == T_CLOSED { error("record and closed types must be declared with 'type'") }
    let uline = tline
    let ucol = tcol
    let name = ident()
    return finishTypeName(name, uline, ucol)
}

// The name tail of a type expression, once its leading name has been read: the order of parseType, so a
// declaration's alias and a symbol-file alias resolve alike. T_COLONCOLON is checked first: a symbol-file
// alias may name a module called int or Result (`type X = int::T`), and primitives-before-'::' would
// return int and leave '::T' unconsumed.
fn finishTypeName(name: string, uline: int, ucol: int): ^Type {
    if sym == T_COLONCOLON {
        next()
        if sym != T_IDENT { error("expected a type name after '::'") }
        let member = ident()
        let qs = exportOf(name, member, uline, ucol)
        if qs.kind != "type" { error("'" + name + "::" + member + "' is not a type") }
        return symType(qs)
    }
    let s = lookup(name)
    if s.kind != "type" { error("'" + name + "' is not a type") }
    let t = symType(s)
    if t.kind == "resultctor" {
        if sym != T_LBRACK { error("Result needs a type: write Result[T]") }
        next()
        let b = parseType()
        expect(T_RBRACK, "")
        rejectFn(b, "Result cannot hold a function value")
        return derived("result", b)
    }
    return t
}

// A reference to an interface (v3 step 5) is a reference local like any other: &I and mut &I may be parameters,
// locals and walk variables. The one exception is &?I as a local (explicit or inferred): a nil-or-pair local
// would need a flag the representation does not have, so it may only be a parameter or a walk variable (v3 6.4).
fn refuseOptionalIfaceLocal(t: ^Type) {
    if t.kind == "opt" && baseOf(t).kind == "iface" {
        error("an optional interface reference can only be a parameter or a walk variable; narrow it to a '&I' local")
    }
}

fn fieldList(rec: ^Type) {
    expect(T_LBRACE, "")
    skipSemis()
    var offset = 0
    while sym != T_RBRACE {
        let names = new []string(0)
        append(names, ident())
        while sym == T_COMMA {
            next()
            append(names, ident())
        }
        expect(T_COLON, "")
        let t = parseType()
        rejectFn(t, "a record field cannot be a function value; function values are parameters and locals only")
        for n in names {
            if fieldIndex(rec, n) >= 0 { error("duplicate field '" + n + "'") }
            append(rec.fields, new Field{name: n, offset: offset, typ: t})
            offset += 8
        }
        if sym != T_RBRACE { expect(T_SEMI, "';' or newline") }
        skipSemis()
    }
    expect(T_RBRACE, "")
    let ptrs = new []int(0)
    let strs = new []int(0)
    for i in 0..len(rec.fields) {
        let ft = rec.fields[i].typ
        let fo = rec.fields[i].offset
        if isOwned(ft) { append(ptrs, fo) }                      // the fields freed with the record
        if ft.kind == "string" { append(strs, fo) }              // and the strings it drops
    }
    rec.desc = descriptor(offset, ptrs, strs)
}

fn ifaceDecl(name: string, line: int, isPub: bool)
fn typeAlias(name: string, line: int, isPub: bool, t: ^Type)

fn typeDecl(isPub: bool) {
    let line = tline
    let name = ident()
    if reservedTypeName(name) { errorAt("cannot declare a type named '" + name + "'", line, 1) }
    let prior = findSym(curModule.globals, name)
    var fwd: ?^Type = nil
    if prior != nil && prior.kind == "type" {
        let pt = symType(prior)
        if pt.incomplete { fwd = pt }
    }
    if sym != T_ASSIGN {
        let t = newType("record", name, nil)
        nameType(t, name)
        t.incomplete = true
        t.line = line
        let s = newSym("type", name, t)
        s.line = line
        declare(s)
        if isPub { s.exported = true }
        return
    }
    expect(T_ASSIGN, "")
    if fwd == nil && (sym == T_REF || sym == T_CLOSED) && prior != nil {
        error("'" + name + "' is already declared in this scope")
    }
    if sym == T_REF {
        next()
        expect(T_RECORD, "")
        var rec = newType("record", name, nil)
        if fwd != nil {
            rec = fwd
        } else {
            nameType(rec, name)
            let s = newSym("type", name, rec)
            s.line = line
            declare(s)
        }
        let cs = findSym(curModule.globals, name)
        if cs != nil {
            cs.exported = cs.exported || isPub       // sticky across a forward heading and its definition
            cs.line = line
        }
        fieldList(rec)
        rec.incomplete = false
    } else if sym == T_CLOSED {
        next()
        var ct = newType("closed", name, nil)
        if fwd != nil { ct = fwd } else { nameType(ct, name) }
        ct.kind = "closed"
        ct.incomplete = false
        if fwd == nil {
            let s = newSym("type", name, ct)
            s.line = line
            declare(s)
        }
        let cs = findSym(curModule.globals, name)
        var pubType = isPub
        if cs != nil {
            cs.exported = cs.exported || isPub
            cs.line = line
            pubType = cs.exported
        }
        expect(T_LBRACE, "")
        skipSemis()
        while sym != T_RBRACE {
            let vline = tline
            let vname = ident()
            let v = newType("record", vname, nil)
            nameType(v, vname)
            v.parent = ct
            let vs = newSym("type", vname, v)
            vs.line = vline
            declare(vs)
            vs.exported = pubType                // exporting a closed type exports its variants
            fieldList(v)
            append(ct.variants, v)
            skipSemis()
        }
        expect(T_RBRACE, "")
        if len(ct.variants) == 0 { error("a closed type needs at least one variant") }
    } else {
        // the contextual interface definition ('interface' then '{'); any other identifier starts an alias,
        // whose name tail is read as parseType reads it
        if sym == T_IDENT {
            let wline = tline
            let wcol = tcol
            let w = sval
            next()
            if w == "interface" && sym == T_LBRACE {
                ifaceDecl(name, line, isPub)
                return
            }
            if fwd != nil {
                let ws = findSym(curModule.globals, w)
                if ws != nil && ws.kind == "type" && containsFn(symType(ws)) {
                    errorAt("a function type cannot be forward-declared: '" + name + "' is already declared as a forward type", wline, wcol)
                }
                errorAt("'" + name + "' was declared as a forward type: define it as a ref record or closed type", wline, wcol)
            }
            typeAlias(name, line, isPub, finishTypeName(w, wline, wcol))
            return
        }
        if fwd != nil {
            if sym == T_FN { error("a function type cannot be forward-declared: '" + name + "' is already declared as a forward type") }
            error("'" + name + "' was declared as a forward type: define it as a ref record or closed type")
        }
        typeAlias(name, line, isPub, parseType())   // an alias key: it maps to this object; it never names it (B7)
    }
}

// an alias of a type: it maps the name to the same object and never names it (B7)
fn typeAlias(name: string, line: int, isPub: bool, t: ^Type) {
    registerTypeAlias(curModuleName, name, t)
    let s = newSym("type", name, t)
    s.line = line
    declare(s)
    if isPub { s.exported = true }
}

// A target located before a value that calls a function: the call could free what the
// target is in, so the value is computed first. xs is the target's variable, if it is one
// (a whole variable's place is fixed), r0 its root.
fn checkTargetAcrossCall(x: &Item, xs: ?^Sym, r0: ?^Sym, callsBefore: int, line: int, col: int) {
    if userCalls == callsBefore { return }
    if x.viaHandle {
        errorAt("cannot assign through a handle across a call: the call could free the object; compute the value first", line, col)
    }
    if x.deref && r0 != nil && r0.storage == "global" && isOwned(symType(r0)) {
        errorAt("cannot assign through global '" + qualifiedSymName(r0) + "' across a call: the call could free what it points into", line, col)
    }
    if xs == nil {
        // a field or element: the call could free the record or array it is in
        errorAt("cannot assign to a field or element across a call: the call could free what it is in; compute the value first", line, col)
    }
}

// An array operand whose array a call might free while it is held: one reached through a
// field, element, handle, global or reference. A whole local array is not held here: a by-value call
// that could free its header moves it, which heldLost sees where the array is held across a call (an
// index, append, truncate or replace). A mut argument cannot replace the header.
fn heldArray(x: &Item): bool {
    if x.viaHandle { return true }
    let r = x.root
    if r == nil { return false }
    return x.sym == nil || r.storage == "global" || r.isRef
}

// how many calls have moved the local s so far: a whole local array's header is freed only by
// a call that takes it by value, so an operand that holds the header must see this unchanged
fn touched(s: ?^Sym): int {
    if s == nil { return 0 }
    return s.touches
}

// the owned local whose move frees the array that a designator rooted at root holds: root itself,
// or for a reference, the local it borrows from. Nil through a handle (no local owns that object),
// and for a reference parameter, whose owner is in the caller.
// A reference may borrow from several owners on different paths (its binding's roots), so the touches of
// all of them are summed: a sum only grows, so a change of it is a move of one of them.
fn ownerTouch(root: ?^Sym): int {
    if root == nil { return 0 }
    let r = root
    if !r.isRef { return touched(r) }
    if !r.isRefLocal { return 0 }
    var t = 0
    let b = r.bind
    for i in 0..len(b.roots) {
        let o = b.roots[i]
        if o != handleSym && !o.isRef { t += touched(o) }
    }
    return t
}

// snapshot taken before a value or index runs while the array under root is held
fn heldTouch(root: ?^Sym): int { return ownerTouch(root) }

// the array held under root may have been freed while a value or index ran: its owner was moved (a
// by-value call takes the whole object, and nothing in a call's argument list is counted by pureFn),
// or root is a reference that a move or a change invalidated. Compare with heldTouch taken before.
fn heldLost(root: ?^Sym, t0: int): bool {
    if root == nil { return false }
    if root.isRefLocal && root.moved { return true }
    return ownerTouch(root) != t0
}

// The places a statement holds while an index or a value runs. heldPush records them, keyed by what
// each is in: an owned local (its owner), a handle made from a whole owned local by a let (its origin:
// the places a handle names are that local's places), or an identity, a handle variable or a
// reference parameter, whose places are compared by path only among themselves. A reference local is
// held once per root of its binding (a reference after a join may point into several), at the binding's
// path in that root. A place with no identity (a handle of unknown origin, or a root that is a handle)
// is hit by any free. heldHitAt and heldPop take the mark heldPush returns: the entries from it on.
var anyPlace = "*"                // a held place that may be anywhere in its root
var heldKey = new []?^Sym(0)
var heldPath = new []string(0)
var heldForeign = new []bool(0)
var heldHit = new []bool(0)
var heldStore = new []bool(0)
var heldWhole = new []bool(0)
// the path inside the designator's root, and the identity or origin of the designator that
// designatorT returned last; replace, take and the assignments read them straight after parsing their
// designator
var lastPlace = ""
var lastRaw = ""
var lastOrigin: ?^Sym = nil
var lastIdent: ?^Sym = nil
var lastViaHandle = false

// the place a designator names inside its root: the path as written. A reference's binding adds its own
// path per root, in heldPush and freeEvent
fn placePath(root: ?^Sym, path: string): string { return path }

// the place a designator with path raw holds in the i-th root of the reference binding b. A deep reference
// with no known place may be anywhere in the root: anyPlace, which every free in the root hits. So may one
// that a loop has not yet pointed afresh: it may be pointed elsewhere on the next iteration.
fn heldAt(b: ^RefBind, i: int, raw: string, r: ^Sym): string {
    if recording > 0 && !r.fresh { return anyPlace }
    if !b.deeps[i] { return raw }
    if b.paths[i] == "" { return anyPlace }
    return b.paths[i] + raw
}

// a held place at or under the free place (see heldFree); either may be anywhere in the root
fn heldUnder(place: string, held: string): bool { return place == anyPlace || held == anyPlace || segsPrefix(place, held) }

// adds one held entry; heldPush and heldPushStore are the only callers
fn heldAdd(key: ?^Sym, foreign: bool, whole: bool, at: string) {
    append(heldKey, key)
    append(heldPath, at)
    append(heldForeign, foreign)
    append(heldHit, false)
    append(heldStore, false)
    append(heldWhole, whole)
}

// holds the places of a designator: origin, when the handle is a let of a whole owned local; ident, the
// handle variable or the reference parameter; raw, the path as written. Returns the mark: the entries from
// it on are the ones pushed (none when root is nil and there is no handle)
fn heldPush(root: ?^Sym, viaHandle: bool, origin: ?^Sym, ident: ?^Sym, place: string, raw: string): int {
    let mark = len(heldKey)
    if viaHandle {
        if origin != nil {
            heldAdd(origin, false, false, raw)
        } else {
            heldAdd(ident, true, false, raw)
        }
        return mark
    }
    if root == nil { return mark }
    let r = root
    if isRefParam(r) {
        heldAdd(r, true, false, raw)
        return mark
    }
    if r.isRefLocal {
        let b = r.bind
        for i in 0..len(b.roots) {
            let o = b.roots[i]
            let p = heldAt(b, i, raw, r)
            if o == handleSym {
                heldAdd(nil, true, false, "")
            } else if o.isRef {
                heldAdd(o, true, false, p)
            } else {
                heldAdd(o, false, false, p)
            }
        }
        return mark
    }
    heldAdd(r, false, raw == "", raw)
    return mark
}

// heldPush for an assignment's target: its own place is exempt from a free of exactly that place
// (take leaves the place nil, and the store then writes a valid place; replace installs the value
// the store frees). A free of an ancestor still hits
fn heldPushStore(root: ?^Sym, viaHandle: bool, origin: ?^Sym, ident: ?^Sym, place: string, raw: string): int {
    let mark = heldPush(root, viaHandle, origin, ident, place, raw)
    for k in mark..len(heldKey) { heldStore[k] = true }
    return mark
}

// a held identity that is a reference parameter: its object lies in a caller, so a local this function
// declared (a fresh object, or one taken out of a caller's record) cannot be it
fn refParamKey(k: ?^Sym): bool {
    if k == nil { return false }
    let r = k
    return isRefParam(r)
}

// a local this function declared: not a by-value parameter (whose object a caller may name through a
// reference) and not a global (which a reference parameter may name). No reference parameter names
// the object of such a local, so a move or free of it does not reach a reference parameter's place
fn calleeLocal(o: ?^Sym): bool {
    if o == nil { return false }
    let r = o
    return r.storage == "local" && !r.isParam
}

// the owned local s is moved: a held place inside s, and every place that is not owned, may be freed
fn heldMove(s: ^Sym) {
    for i in 0..len(heldKey) {
        if heldKey[i] == s {
            heldHit[i] = true
        } else if heldForeign[i] {
            if s.isParam || !refParamKey(heldKey[i]) { heldHit[i] = true }
        }
    }
}

// a free of a place, by the owned object o (its root's owner), or through the identity i (a handle
// variable or reference parameter), or of unknown identity (both nil). An identity entry is hit only
// by a free of the same identity at or below its path; any other free may reach it. An owned entry is
// hit by a free of its own object at or above its path, and by a free that is not owned, unless it is
// a whole local array: no handle or reference parameter names an array's header, only a record's
// field or an element's contents
fn heldFree(o: ?^Sym, i: ?^Sym, place: string) {
    for k in 0..len(heldKey) {
        if heldForeign[k] {
            if i != nil && heldKey[k] == i {
                if heldUnder(place, heldPath[k]) && !(heldStore[k] && place == heldPath[k] && place != anyPlace) { heldHit[k] = true }
            } else if !(calleeLocal(o) && refParamKey(heldKey[k])) {
                heldHit[k] = true
            }
        } else if o != nil {
            if heldKey[k] == o && heldUnder(place, heldPath[k]) && !(heldStore[k] && place == heldPath[k] && place != anyPlace) {
                heldHit[k] = true
            }
        } else if !heldWhole[k] {
            heldHit[k] = true
        }
    }
}

// the old value of the designator x that a replace or take frees, with its path as written, origin and
// identity (see lastRaw). A reference frees in each root of its binding, at the binding's path there
fn freeEvent(x: &Item, place: string, raw: string, origin: ?^Sym, ident: ?^Sym) {
    if x.viaHandle {
        if origin != nil {
            heldFree(origin, nil, raw)
        } else {
            heldFree(nil, ident, raw)
        }
        return
    }
    let root = x.root
    if root == nil { return }
    let r = root
    if isRefParam(r) {
        heldFree(nil, r, raw)
        return
    }
    if r.isRefLocal {
        let b = r.bind
        for i in 0..len(b.roots) {
            let o = b.roots[i]
            let p = heldAt(b, i, raw, r)
            if o == handleSym {
                heldFree(nil, nil, "")
            } else if o.isRef {
                heldFree(nil, o, p)
            } else {
                heldFree(o, nil, p)
            }
        }
        return
    }
    heldFree(r, nil, raw)
}

// the owned local a let handle may name as a whole: nil unless s is a plain owned local
fn wholeOwnerOf(s: ?^Sym): ?^Sym {
    if s == nil { return nil }
    let r = s
    if r.owned && !r.isRef && r.storage == "local" { return r }
    return nil
}

// a whole move of the owned local s (move) or an assignment over it: the let handles made from s are no
// longer keyed to it, so each falls back to the identity treatment (every move or free hits it). A move
// inside a loop that a handle declared outside the loop was made from is refused, since the next
// iteration would still see the handle's origin (a handle declared inside the loop is fresh each time)
fn originMove(s: ?^Sym, move: bool) {
    if s == nil { return }
    let r = s
    if !r.owned || r.isRef || r.storage != "local" { return }
    if move { loopOriginPend(r) }
    if !move {
        originFree(r, "assign over")
        return
    }
    for i in 0..len(originSyms) {
        let x = originSyms[i]
        // on this path the owner is moved: its object is no longer the one an assignment frees (see originLive)
        let wasLive = originLive[i] == r
        if wasLive { originLive[i] = nil }
        // narrowing cleared a dead mark of this handle: the move must not make the handle usable again. This tests
        // the live mark, not hOrigin: an earlier move on a path that ended has cleared hOrigin for good
        if wasLive && originNar[i] { originDead[i] = r }
        if x.hOrigin == r { x.hOrigin = nil }
    }
}

// the narrowing of the handle of entry i: its dead mark is cleared in the marks d (and remembered, see originNar)
fn narrowMark(mut d: &[]?^Sym, i: int) {
    if d[i] != nil { originNar[i] = true }
    d[i] = nil
}

// the handle x was just named by an expression that is no use of its object (alive(x), a copy of a dead handle):
// it is not counted
fn unname(x: ?^Sym) {
    if x != nil && lastNamed == x {
        let h = x
        h.usedAt = lastNamedPrev
        lastNamed = nil
    }
}

// a whole move of the owner s inside a loop that a let handle made from it was declared outside of: the
// next iteration would still see the handle's origin, which this move clears. The move is allowed if the
// loop never names the handle (pendingFreeCheck), and the handle may then not be named again (movedLoop)
fn loopOriginPend(s: ^Sym) {
    for i in 0..len(originSyms) {
        let x = originSyms[i]
        // the live mark, not hOrigin: an earlier move on a path that ended has cleared hOrigin for good
        if originLive[i] == s && x.hDepth <= len(loops) && originDead[i] == nil {
            pendPush(x, s, "move")
        }
    }
}

// a free or a move of the owner o of the handle x, inside a loop x was declared outside of, to be judged
// where that loop ends
fn pendPush(x: ^Sym, o: ^Sym, what: string) {
    append(pendSym, x)
    append(pendDepth, x.hDepth - 1)
    append(frLine, tline)
    append(frCol, tcol)
    append(pendWhat, what)
    append(pendOwn, o)
    append(pendNest, len(loops))
}

// the object of the owned local r is freed (an assignment over it, what; or a drop): each let handle made
// from it names a freed object from here on, so a use through it is refused (deadHandleCheck). Inside a
// loop the handle was declared outside of, a use of it earlier in the loop runs again on the next
// iteration, so the free itself is refused then. The origins are cleared by originMove
fn originFree(r: ^Sym, what: string) { originFreeAt(r, "", false, what) }

// the number of segments in a place: "/items/[]/next" has three
fn placeDepth(p: string): int {
    var n = 0
    for i in 0..len(p) {
        if p[i] == '/' { n += 1 }
    }
    return n
}

// the constant index of the segment of the place e that comes after d segments ("/[3]/x" after 0 is 3), or -1
// if that segment is not an element with a constant index
fn elemAt(e: string, d: int): int {
    var seen = 0
    var i = 0
    while i < len(e) && seen <= d {
        if e[i] == '/' { seen += 1 }
        i += 1
    }
    if seen != d + 1 || i + 1 >= len(e) || e[i] != '[' { return -1 }
    var k = 0
    var j = i + 1
    while j < len(e) && e[j] != ']' {
        if e[j] < '0' || e[j] > '9' { return -1 }
        k = k * 10 + int(e[j]) - 48
        j += 1
    }
    if j == i + 1 { return -1 }
    return k
}

// whether the free of the place path in the object of the owned local r (strict: only what lies below that place,
// not the place itself) frees the object that entry i of originSyms names. A handle to the owner's whole object
// (originPath "") is freed by a free of the whole owner only; one made from a field or element is freed by a free
// of that place or of any place above it. An element with a variable index is any element (segsPrefix)
fn placeHit(i: int, r: ^Sym, path: string, strict: bool): bool {
    if originLive[i] != r { return false }
    let e = originPath[i]
    if !segsPrefix(path, e) { return false }
    if strict {
        if placeDepth(e) <= placeDepth(path) { return false }
        // truncate(a, n) with a constant n keeps the elements before n: a handle to a known one of them is not freed
        if truncKeep >= 0 {
            let k = elemAt(e, placeDepth(path))
            if k >= 0 && k < truncKeep { return false }
        }
        return true
    }
    return true
}

// a free at a place of the owned local r, or of the whole of it (path ""): see placeHit. what says what the
// program did, for the messages
fn originFreeAt(r: ^Sym, path: string, strict: bool, what: string) {
    freeSeq += 1
    if inDefer {
        append(deferFrees, r)
        if strict { append(deferFreeEv, "!" + path) } else { append(deferFreeEv, "=" + path) }
    }
    for i in 0..len(originSyms) {
        let x = originSyms[i]
        if placeHit(i, r, path, strict) {
            if x.hDepth <= len(loops) { pendPush(x, r, what) }
            originDead[i] = r
        }
    }
    for j in 0..len(deferH) {
        if replayFree { break }
        let x = deferH[j]
        var live = false
        for i in 0..len(originSyms) {
            if originSyms[i] == x && placeHit(i, r, path, strict) { live = true }
        }
        if live {
            error("cannot " + what + " '" + r.name + "' while a defer declared earlier uses handle '" + x.name + "' made from it: the defer runs after this")
        }
    }
}

// where the loop loops[li] ends: each free inside it of the object of a handle declared outside it is refused
// if the loop names the handle anywhere (usedAt after the loop began), earlier or later in its text, since
// the next iteration runs the use after the free
fn pendingFreeCheck(li: int) {
    var k = 0
    while k < len(pendSym) {
        if pendDepth[k] == li {
            let x = pendSym[k]
            if x.usedAt > loops[li].useFrom {
                if pendWhat[k] == "move" {
                    errorAt("cannot move '" + pendOwn[k].name + "' inside a loop while handle '" + x.name + "' made from it is in scope", frLine[k], frCol[k])
                }
                errorAt("cannot " + pendWhat[k] + " the owner of handle '" + x.name + "' inside a loop that uses the handle", frLine[k], frCol[k])
            }
            // the loop never names the handle: after a move it may not be named again
            if pendWhat[k] == "move" { x.movedLoop = true }
            pendDrop(k)
        } else {
            k += 1
        }
    }
}

// the pending entry k is judged, or can never be repeated
fn pendDrop(k: int) {
    var j = k
    while j + 1 < len(pendSym) {
        pendSym[j] = pendSym[j + 1]
        pendDepth[j] = pendDepth[j + 1]
        frLine[j] = frLine[j + 1]
        frCol[j] = frCol[j + 1]
        pendWhat[j] = pendWhat[j + 1]
        pendOwn[j] = pendOwn[j + 1]
        pendNest[j] = pendNest[j + 1]
        j += 1
    }
    truncate(pendSym, len(pendSym) - 1)
    truncate(pendDepth, len(pendDepth) - 1)
    truncate(frLine, len(frLine) - 1)
    truncate(frCol, len(frCol) - 1)
    truncate(pendWhat, len(pendWhat) - 1)
    truncate(pendOwn, len(pendOwn) - 1)
    truncate(pendNest, len(pendNest) - 1)
}

// A block that always ends (in a break or a return) with no continue in it: the frees it made in the loop it
// is in are never followed by another iteration, if the block ends in a return, or, if it ends in a break,
// for a handle declared in the scope directly outside the loop it leaves (pendDepth is then the index of that
// loop, the one the handle is declared outside of); a handle declared further out is judged where its outer
// loop ends, since that loop repeats. A use after such a loop is seen by the dead marks (Loop.exitDead).
// A move stays after a break, since the origin it clears
// would let a use after the loop through (movedLoop is set where the loop ends), and so does a return: the
// origin the move clears is cleared for the paths that go on, which the other frees then miss. Entries made
// in a loop inside the block repeat, and stay. pm: the entries from the block's start; cs, bs: contSeq and brkSeq there
fn pendBlockEnds(pm: int, cs: int, bs: int) {
    if contSeq != cs { return }
    var k = pm
    while k < len(pendSym) {
        var drop = false
        if pendNest[k] == len(loops) && pendWhat[k] != "move" {
            if brkSeq == bs { drop = true }
            if brkSeq != bs && pendDepth[k] == len(loops) - 1 { drop = true }
        }
        if drop { pendDrop(k) } else { k += 1 }
    }
}

// a change through x frees the old value at its place (strict: what is below it): the handles made from a field or
// element of an owned local that the change reaches are dead. The change is at the place written, directly, or, through
// a reference, at the place the reference's binding gives in each owned local it may point into (placeIn). A change
// through a handle is not here: it can name any object, and a later free of the place is a certain one
fn placeFreeIn(r: ?^Sym, viaHandle: bool, xpath: string, strict: bool, what: string) {
    if r == nil || viaHandle { return }
    let q = r
    if q.isRef {
        let rb = q.bind
        for i in 0..len(rb.roots) {
            let o = rb.roots[i]
            if o != handleSym && !o.isRef && o.storage == "local" {
                let p = placeIn(q, i, xpath)
                // a reference that may point anywhere below the root: the change is below the root, whatever the place,
                // and the elements a truncate keeps are not known
                let unk = unknownPlace(q, i, p, xpath)
                let keep = truncKeep
                if unk { truncKeep = -1 }
                originFreeAt(o, p, strict || unk, what)
                truncKeep = keep
            }
        }
    } else if q.owned && q.storage == "local" {
        originFreeAt(q, xpath, strict, what)
    }
}

fn placeFreeChange(x: &Item, strict: bool, what: string) { placeFreeIn(x.root, x.viaHandle, x.path, strict, what) }

// a change through a let handle made from the whole of an owned local (orig), at the path raw inside its object, is
// a change of that local at that place
fn placeFreeVia(orig: ?^Sym, raw: string, strict: bool, what: string) {
    if orig != nil {
        let o = orig
        originFreeAt(o, raw, strict, what)
    }
}

// a use through the let handle s, on a path where an assignment or a drop freed the object it was made from
fn deadHandleCheck(s: ?^Sym) {
    for i in 0..len(originSyms) {
        let o = originDead[i]
        if o != nil && originSyms[i] == s {
            if originPath[i] != "" {
                error("handle '" + originSyms[i].name + "' may name a freed object: a place in '" + o.name + "' was assigned over, replaced, taken, truncated or reached by a call that frees below it, after the handle was made from it; make the handle again")
            }
            error("handle '" + originSyms[i].name + "' may name a freed object: '" + o.name + "' was assigned or dropped after the handle was made from it; make the handle again")
        }
    }
}

// the dead marks (originDead), saved where paths split: an if, a match, a defer body (whose assignments
// run where its block is left, after the uses that follow it here)
// (and the live marks, originLive: the second half of the array, so that the two are saved, merged and
// restored together)
fn deadSave(): []?^Sym {
    var d = new []?^Sym(0)
    for i in 0..len(originDead) { append(d, originDead[i]) }
    for i in 0..len(originLive) { append(d, originLive[i]) }
    return d
}

fn deadSet(d: &[]?^Sym) {
    let m = len(d) / 2
    for i in 0..m { originDead[i] = d[i] }
    for i in 0..m { originLive[i] = d[m + i] }
}

// the live half of the marks d is emptied: the union of the arms that go on starts with none (the dead half
// starts with the marks before the statement, which only grow), and a path without an arm adds the marks before
fn liveClear(mut d: &[]?^Sym) {
    let m = len(d) / 2
    for i in 0..m { d[m + i] = nil }
}

// the live half of the marks before a statement (d0) joins the union acc: the statement has a path that runs no arm
fn liveJoin(d0: &[]?^Sym, mut acc: &[]?^Sym) {
    let m = len(acc) / 2
    for i in 0..m {
        if d0[m + i] != nil { acc[m + i] = d0[m + i] }
    }
}

// a held place from mark on was freed or moved while the expression ran
fn heldHitAt(mark: int): bool {
    if mark < 0 { return false }
    for i in mark..len(heldKey) {
        if heldHit[i] { return true }
    }
    return false
}

// drops the held places from mark on
fn heldPop(mark: int) {
    if mark < 0 { return }
    truncate(heldKey, mark)
    truncate(heldPath, mark)
    truncate(heldForeign, mark)
    truncate(heldHit, mark)
    truncate(heldStore, mark)
    truncate(heldWhole, mark)
}

// ================================================ interface values (v3 section 5)

// The destination types that hold an interface value: I, and ?I (a box pointer, or 0 for nil)
fn isIfaceVal(t: ^Type): bool { return t.kind == "iface" || (t.kind == "opt" && baseOf(t).kind == "iface") }

// Set around the checkAssign at a reference destination (&I, mut &I, &?I parameter or a &I local): a concrete
// source then borrows into a frame cell instead of moving into a box. 0 everywhere else.
var convBorrow = 0
// While a &I local's initialiser or re-point is checked, convPairOn says its own pair slot at convPairDisp is the
// destination: the conversion fills it directly, so no call-site cell is made for a local (v3 4, B1).
var convPairOn = false
var convPairDisp = 0

// the interface a destination of type I or ?I holds
fn ifaceOf(t: ^Type): ^Type {
    if t.kind == "opt" { return baseOf(t) }
    return t
}

// the box descriptor (v3 4): one owned word at offset 0, the object, and no strings. It is made the first time a box
// is needed and is shared by every interface, so rt_free frees a box and then its object through the object's header.
var boxDescAddr = 0

fn boxDescriptor(): int {
    if boxDescAddr == 0 {
        let ptrs = new []int(0)
        append(ptrs, 0)
        let strs = new []int(0)
        boxDescAddr = descriptor(16, ptrs, strs)
    }
    return boxDescAddr
}

// The implementation of interface it for a value of type rt (a variant uses its closed type's), if this module may
// see it: its own, or a pub one of an imported module (a private implementation is invisible to importers).
fn visibleImpl(rt: ^Type, it: ^Type): ?^Impl {
    let p = rt.parent
    var im: ?^Impl = nil
    if p != nil { im = findImplIn(p, it) } else { im = findImplIn(rt, it) }
    if im == nil { return nil }
    if im.owner != curModuleName && !im.exported { return nil }
    return im
}

// Replaces what x holds by y, a temporary of its own (the box made for an owned conversion)
fn setItem(mut x: &Item, y: Item) {
    x.mode = y.mode
    x.typ = y.typ
    x.val = y.val
    x.base = y.base
    x.index = y.index
    x.disp = y.disp
    x.r = y.r
    x.cc = y.cc
    x.T = 0
    x.F = 0
    x.nt = nil
    x.nf = nil
    x.width = y.width
    x.scale = y.scale
    x.line = y.line
    x.sym = nil
    x.readonly = false
    x.root = nil
    x.strTemp = false
    x.borrowed = false
    x.pair = false
    x.viaHandle = false
    x.deref = false
    x.movedRef = false
    x.hOrigin = nil
    x.pOwner = nil
    x.pPath = ""
    x.path = ""
    x.home = false
}

// Moves the owned value x (a record or closed value) into a new box of type dst (I or ?I), which holds x's object at
// offset 0 and the vtable of implementation im at offset 8 (v3 4). The box is an owned temporary, so the caller's
// consume of x is a no-op. The vtable is in rodata; in --check an imported implementation has none (0), and no code runs.
fn boxInto(dst: ^Type, mut x: &Item, im: ^Impl) {
    // a full build only ever sees live implementations (symImplDecl adds the .sym's own only in --check), so a zero vtable
    // here would be a box that calls through to address 0
    if im.vtable == 0 && !checking { error("internal error: the implementation of '" + tname(dst) + "' has no vtable in this build") }
    consume(x)
    let obj = asReg(copyItem(x))
    let box = rtCall1(RT_ALLOC_RECORD, makeConst(tInt, boxDescriptor()), dst)
    opMem(0x89, obj.r, mem(box.r, -1, 0, 8), true, false)
    opMem(0xC7, 0, mem(box.r, -1, 8, 8), true, false)
    emit32(im.vtable)
    release(obj.r)
    setItem(x, box)
}

// A frame cell holding a borrowed concrete object and its vtable (v3 4, 5.1): the &I value is the cell's address,
// and the cell lives in the converting function's frame, so it cannot escape. Per-site cells are built only for
// call arguments, which are consumed within the call; a &I local's own pair slot is filled directly instead.
fn ifacePairCell(vtable: int, obj: Item, t: ^Type): Item {
    if vtable == 0 && !checking { error("internal error: the implementation of '" + tname(t) + "' has no vtable in this build") }
    frame += 16
    let off = -frame
    let o = asReg(obj)
    opMem(0x89, o.r, mem(RBP, -1, off, 8), true, false)
    release(o.r)
    opMem(0xC7, 0, mem(RBP, -1, off + 8, 8), true, false)
    emit32(vtable)
    let c = alloc()
    opMem(0x8D, c, mem(RBP, -1, off, 8), true, false)
    let res = makeReg(t, c)
    res.borrowed = true
    return res
}

// Copies the {obj, vtable} pair that x points at into a &I local's own two-word slot (v3 B1). It never stores a
// pointer to another local's slot or to a conversion site's cell, so a loop that rewrites its cell cannot change
// a pair saved from an earlier pass.
fn storePair(dst: Item, source: Item) {
    let src = asReg(source)
    let lo = alloc()
    opMem(0x8B, lo, mem(src.r, -1, 0, 8), true, false)
    opMem(0x89, lo, memOf(dst), true, false)
    release(lo)
    let hi = alloc()
    opMem(0x8B, hi, mem(src.r, -1, 8, 8), true, false)
    opMem(0x89, hi, mem(RBP, -1, dst.disp + 8, 8), true, false)
    release(hi)
    release(src.r)
}

// The refusal of an assignment that no conversion makes: the seed's message, with its hints and v3's Result hint (5.2)
fn refuseAssign(dst: ^Type, x: &Item, what: string) {
    var hint = ""
    if x.typ.kind == "nil" && nonNull(dst) {
        hint = " (" + tname(dst) + " can never be nil; declare it as ?" + tname(dst) + ")"
    } else if dst.kind != "opt" && x.typ.kind == "opt" {
        hint = " (it may be nil: check it with '!= nil' first)"
    } else if x.typ.kind == "errval" {
        hint = " (err(...) is an error cell; the destination must be a Result[T])"
    } else if dst.kind == "result" && x.typ.kind == "result" && baseOf(dst).kind == "iface" {
        hint = "; store it first: let s: " + tname(baseOf(dst)) + " = ...; return ok(s)"
    }
    error(what + ": cannot use " + tname(x.typ) + " as " + tname(dst) + hint)
}

// A concrete source at a reference destination (v3 5.1): its object is borrowed, not moved, so the pair can point
// at the caller's object. The binding was taken by borrowBind before this call (that is what may refuse a
// temporary), and the impl is checked before any code is made. A frame cell has no home in a global initializer.
fn ifaceBorrowConvert(dst: ^Type, mut x: &Item, what: string) {
    let src = x.typ
    let it = ifaceOf(dst)
    let sk = src.kind
    if sk == "iface" {
        error(what + ": cannot use interface '" + tname(src) + "' as '" + tname(it) + "': interface values do not convert")
    }
    if sk == "nil" { refuseAssign(dst, x, what) }
    if sk == "opt" {
        let b = baseOf(src)
        if b.kind == "record" || b.kind == "closed" {
            error(what + ": cannot use " + tname(src) + " as interface '" + tname(it) +
                  "' (it may be nil: take it into a local, return if nil, then convert the local)")
        }
        if b.kind == "iface" { refuseAssign(dst, x, what) }
        error(what + ": cannot use " + tname(src) + " as interface '" + tname(it) + "'")
    }
    if sk != "record" && sk != "closed" {
        error(what + ": cannot use " + tname(src) + " as interface '" + tname(it) + "'")
    }
    // a variant has no implementation of its own: its closed type's one is used (0.7 4.4)
    var base = src
    let p = src.parent
    if p != nil { base = p }
    let im = visibleImpl(src, it)
    if im == nil {
        if base.owner == curModuleName {
            error(what + ": type '" + tname(base) + "' does not implement interface '" + tname(it) + "'")
        }
        error(what + ": module '" + base.owner + "' has no exported implementation of '" + tname(it) + "' for '" +
              base.name + "' (only 'pub' implementations are visible)")
        return
    }
    if curFn == nil {
        error(what + ": cannot create a borrowed interface value in a global initializer: pass the concrete value to a function that makes it")
    }
    if convPairOn {
        // a &I local's own pair slot: fill it directly; there is no call-site cell to copy from (B1). The item
        // handed back points at that slot, so the caller's ordinary pair copy reads and writes the same words.
        let o = asReg(copyItem(x))
        opMem(0x89, o.r, mem(RBP, -1, convPairDisp, 8), true, false)
        release(o.r)
        opMem(0xC7, 0, mem(RBP, -1, convPairDisp + 8, 8), true, false)
        emit32(im.vtable)
        let c = alloc()
        opMem(0x8D, c, mem(RBP, -1, convPairDisp, 8), true, false)
        setItem(x, makeReg(dst, c))
        x.borrowed = true
        return
    }
    let cell = ifacePairCell(im.vtable, copyItem(x), dst)
    setItem(x, cell)
    x.borrowed = true
}

// Converts x to a destination of type dst that holds an interface (I or ?I), or refuses it (v3 5.1-5.3). Assignable
// sources (nil, I, ?I) never get here. An owned record or closed value is moved into a box, after the impl check.
fn ifaceConvert(dst: ^Type, mut x: &Item, what: string) {
    if convBorrow > 0 {
        ifaceBorrowConvert(dst, x, what)
        return
    }
    let src = x.typ
    let it = ifaceOf(dst)
    let sk = src.kind
    if sk == "opt" {
        let b = baseOf(src)
        if b.kind == "record" || b.kind == "closed" {
            error(what + ": cannot use " + tname(src) + " as interface '" + tname(it) +
                  "' (it may be nil: take it into a local, return if nil, then convert the local)")
        }
        if b.kind == "iface" { refuseAssign(dst, x, what) }
        error(what + ": cannot use " + tname(src) + " as interface '" + tname(it) + "'")
    }
    if sk == "iface" {
        error(what + ": cannot use interface '" + tname(src) + "' as '" + tname(it) + "': interface values do not convert")
    }
    if sk == "nil" { refuseAssign(dst, x, what) }
    if sk != "record" && sk != "closed" {
        error(what + ": cannot use " + tname(src) + " as interface '" + tname(it) + "'")
    }
    let s = x.sym
    if x.borrowed || (s != nil && s.isRef) {
        error(what + ": cannot use a borrowed '" + tname(src) + "' as owned interface '" + tname(it) +
              "': move the value in, or take the interface as '&" + tname(it) + "'")
    }
    // a variant has no implementation of its own: its closed type's one is used (0.7 4.4)
    var base = src
    let p = src.parent
    if p != nil { base = p }
    let im = visibleImpl(src, it)
    if im == nil {
        if base.owner == curModuleName {
            error(what + ": type '" + tname(base) + "' does not implement interface '" + tname(it) + "'")
        }
        error(what + ": module '" + base.owner + "' has no exported implementation of '" + tname(it) + "' for '" +
              base.name + "' (only 'pub' implementations are visible)")
        return                                        // error exits; this return only narrows im
    }
    boxInto(dst, x, im)
}

// The check at every typed destination: x must be assignable to dst, or convert to it (interface destinations).
// x may be rewritten: a value converted to an interface is replaced by its box (the owned temporary x now is).
fn checkAssign(dst: ^Type, mut x: &Item, what: string) {
    if x.typ == tVoid { error(what + ": expression has no value") }
    if dst.kind == "byte" && x.mode == "const" && x.typ.kind == "int" && x.val >= 0 && x.val <= 255 { return }
    if dst.kind == "fn" && x.typ.kind == "nil" { error("a function value can never be nil") }
    if assignable(dst, x.typ) { return }
    if isIfaceVal(dst) {
        ifaceConvert(dst, x, what)
        return
    }
    refuseAssign(dst, x, what)
}

// ============================================================ expressions

fn expression(): Item
fn designator(): Item

// The position rule for try (see factor): trySite counts the sanctioned tail positions -- the value
// of a let, var or assignment, or a statement -- and tryNest the places where a value is only part of
// a larger expression. try may appear only where the first is set and the second is not.
var trySite = 0
var tryNest = 0

fn tailExpr(): Item {
    trySite += 1
    let x = expression()
    trySite -= 1
    return x
}

fn nestedExpr(): Item {
    tryNest += 1
    let x = expression()
    tryNest -= 1
    return x
}

// Arguments run left to right, and the callee is given every one of them, so a reference passed as an
// argument must stay valid while the later arguments run. Each one is held as a reference local of its
// own while they do (argTemps, from a pool: the symbols are reused, and the ones made inside a function
// go with its symbols at its end), so a move, a free or a change that would invalidate a `let`
// reference to the same place invalidates it, and the later argument is refused (see argOrderCheck).
var argTemps = new []^Sym(0)
var argTempsUsed = 0

// holds argument i, whose binding is b. A holder that was invalidated has stopped the compile (see
// argOrderCheck), so only its suspicion is left from its last use. It is never named, so its freshness and
// loop marks are not read: it is not in any loop's states, which cover only the locals a loop began with
fn holdArg(b: ^RefBind, i: int) {
    if argTempsUsed == len(argTemps) {
        let s = newSym("let", "an argument", nil)
        s.isRefLocal = true
        append(argTemps, s)
    }
    let t = argTemps[argTempsUsed]
    argTempsUsed += 1
    t.bind = b
    t.suspect = false
    t.value = i
    append(ownedLocals, t)
}

// "method 'T::m'" for a method, the plain name for a function (whose messages stay byte-identical). The call being
// checked is an interface method call when callIface is set (callFnWith sets and restores it around each call).
var callIface = false
fn callDisplay(meth: bool, name: string): string {
    if meth && callIface { return "interface method '" + name + "'" }
    if meth { return "method '" + name + "'" }
    return name
}

// an argument of a call as diagnostics name it: argument N for a source argument, the receiver for a
// method's parameter 0. i is a parameter index and start is 1 for a method call, 0 for a function's.
fn argLabel(meth: bool, i: int, start: int): string {
    if !meth { return "argument " + string(i + 1) }
    if i == 0 { return "the receiver" }
    return "argument " + string(i - start + 1)
}

// argument j has run (and been moved, if it is passed by value): an argument held before it that it
// invalidated would reach the callee pointing to freed memory. A recursive call in it that may write
// through a handle is reported at the end of the body, as the other suspect uses are
fn argOrderCheck(tbase: int, fname: string, meth: bool, j: int, line: int, col: int) {
    for k in tbase..argTempsUsed {
        let t = argTemps[k]
        if t.moved {
            errorAt(argLabel(meth, j, 1) + " of " + callDisplay(meth, fname) + " may free what " + argLabel(meth, t.value, 1) + " points into, and runs after it; compute it before the call", line, col)
        }
        if t.suspect {
            notePending(line, col, argLabel(meth, j, 1) + " of " + callDisplay(meth, fname) + " makes a recursive call that writes through a handle, which could free what " + argLabel(meth, t.value, 1) + " points into; compute it before the call")
        }
    }
}

// the held arguments from tbase on are let go: the call is made
fn releaseArgs(tbase: int, omark: int) {
    argTempsUsed = tbase
    truncate(ownedLocals, omark)
}

fn callFreeEvent(br: ^Sym, path: string, strict: bool) {
    if br == handleSym { return }
    if br.isParam && br.isRef {
        if strict { recordParamFree(br, "!" + path) } else { recordParamFree(br, "=" + path) }
    } else if !br.isRef && br.storage == "local" {
        originFreeAt(br, path, strict, "let a call free below a place in")
    }
}

// what a call to f may free below the reference it got for parameter i, which points at the place apath of the
// root br (known unless the binding is deep with no place): the events of the rows of pfFn at that place, or
// everything below it if f is not known to free only certain places. Handles made from a place of an owned
// local are killed by them, and a reference parameter of the caller takes them in its own rows
fn callFrees(f: ^Sym, i: int, br: ^Sym, known: bool, apath: string) {
    if !known {
        callFreeEvent(br, "", true)
        return
    }
    if f.addr < 0 || f == curFn || f.freesAll || f.writesHandles || i >= 62 {
        callFreeEvent(br, apath, true)
        return
    }
    var n = 0
    for k in 0..len(pfFn) {
        if pfFn[k] == f && pfIdx[k] == i {
            n += 1
            let ev = pfEv[k]
            callFreeEvent(br, apath + substr(ev, 1, len(ev)), ev[0] == '!')
        }
    }
    if n == 0 { callFreeEvent(br, apath, true) }
}

// The vtable slot of interface member f (v3 4): its place among the members of its interface, in declaration order,
// which is the order implDecl writes the vtable in and the order the .sym reader appends the members in
fn ifaceSlot(f: ^Sym): int {
    var k = 0
    for i in 0..len(ifaceSyms) {
        let m = ifaceSyms[i]
        if m == f { return k }
        if m.recv == f.recv { k += 1 }
    }
    error("internal error: interface method '" + f.name + "' has no vtable slot")
    return 0
}

// The dispatch loads of an interface call (v3 7.1, S4), made for argument 0 and so before any explicit argument runs.
// a is the receiver place, which holds its box: the vtable is read from [box+8] and pushed first, so it lies above
// the arguments; then the object from [box] is pushed as argument 0. The box's register is only read, never written,
// since it may be a home register of a local.
fn pushIfaceReceiver(a: Item) {
    let b = asReg(a)
    let vt = alloc()
    opMem(0x8B, vt, mem(b.r, -1, 8, 8), true, false)
    pushR(vt)
    release(vt)
    let ob = alloc()
    opMem(0x8B, ob, mem(b.r, -1, 0, 8), true, false)
    release(b.r)
    pushR(ob)
    release(ob)
}

fn callFnWith(f: ^Sym, recv: ?Item, hasRecv: bool, rline: int, rcol: int): Item

fn callFn(f: ^Sym): Item { return callFnWith(f, nil, false, 0, 0) }

// The call: the receiver, if any, is parameter 0 and runs before the explicit arguments. For a plain
// function (hasRecv false) every label and index is the old one, so its messages are unchanged.
fn callFnWith(f: ^Sym, recv: ?Item, hasRecv: bool, rline: int, rcol: int): Item {
    // an interface member (kind "ifn") is called through the receiver's vtable, and its synthetic summary stands for the callee
    let iface = f.kind == "ifn"
    let fnval = f.kind == "fncall"
    let savedIface = callIface
    callIface = iface
    var fname = qualifiedSymName(f)
    if hasRecv { fname = methodDisplay(f) }
    if iface { fname = ifaceMethodDisplay(f) }
    if !fnval && f != curFn && inFnStack(f) {
        error("cannot call '" + fname + "' from a lambda while it is being compiled: its effects are not known yet")
    }
    let meth = hasRecv
    var start = 1
    if !hasRecv { start = 0 }
    // saveRegs, except that the receiver's own place registers are not outer live registers: the
    // call consumes them (see itemRegs)
    var saved = usedRegs()
    if hasRecv {
        if recv != nil { saved = saved & ~itemRegs(recv) }
    }
    pushRegs(saved)
    setFree(0)
    let n = len(f.fnRec.params)
    let narg = n - start
    // the words the call pops: the arguments, and for an interface call the vtable word above them (v3 7.1)
    var nw = n
    if iface || fnval { nw = n + 1 }
    let pad = (depth + 8 * nw) % 16
    if pad != 0 {
        aluRI(5, RSP, 8)
        depth += 8
    }
    expect(T_LPAREN, "")
    if fnval {
        if recv == nil { error("internal error: a function value call without a cell") }
        if recv != nil {
            let e = copyItem(recv)
            if e.mode == "const" && fits32(e.val) {
                pushI(e.val)
                depth += 8
                drop(e)
            } else {
                let er = asReg(e)
                pushR(er.r)
                release(er.r)
            }
        }
    }
    var argBinds = new []^RefBind(0)
    let argModes = new []int(0)
    let argVias = new []?^Sym(0)
    let argIdx = new []int(0)           // the parameter each of those is
    var deepLine = 0                   // the first argument that points inside something
    var deepCol = 0
    let tbase = argTempsUsed
    let omark = len(ownedLocals)
    for i in 0..n {
        var argLine = tline
        var argCol = tcol
        var a = voidItem()
        var restorePos = false
        var savedTokLine = 0
        var savedTokCol = 0
        if i == 0 && hasRecv {
            if recv == nil { error("internal error: a method call without a receiver") }
            if recv != nil {
                a = copyItem(recv)
                argLine = rline
                argCol = rcol
                // a receiver's type/mode/ownership errors are at the receiver's start, not at the
                // call's current token: checkAssign, borrowBind and consume report through error()
                savedTokLine = tline
                savedTokCol = tcol
                tline = rline
                tcol = rcol
                restorePos = true
            }
        } else {
            if sym == T_RPAREN { error(callDisplay(meth, fname) + " takes " + string(narg) + " argument(s), not " + string(i - start)) }
            if i > start { expect(T_COMMA, "") }
            argLine = tline
            argCol = tcol
            a = nestedExpr()
        }
        if f.fnRec.pmodes[i] > 0 {
            var b: ^RefBind = noBind
            if isIfaceVal(f.fnRec.params[i]) {
                // the binding comes first: an interface conversion builds a frame cell only after borrowBind succeeds
                b = borrowBind(a)
                let savedConv = convBorrow
                convBorrow = 1
                checkAssign(f.fnRec.params[i], a, argLabel(meth, i, start) + " of " + callDisplay(meth, fname))
                convBorrow = savedConv
            } else {
                checkAssign(f.fnRec.params[i], a, argLabel(meth, i, start) + " of " + callDisplay(meth, fname))
                b = borrowBind(a)
            }
            if f.fnRec.pmodes[i] == 2 && !b.writable {
                error(argLabel(meth, i, start) + " of " + callDisplay(meth, fname) + " needs a mut reference, but this one is read-only")
            }
            // a mut argument writes through the reference it is passed by
            if f.fnRec.pmodes[i] == 2 { noteWrite(a) }
            append(argBinds, b)
            append(argModes, f.fnRec.pmodes[i])
            append(argVias, viaOf(a))
            append(argIdx, i)
            if anyDeep(b) && deepLine == 0 {
                deepLine = argLine
                deepCol = argCol
            }
            argOrderCheck(tbase, fname, meth, i, argLine, argCol)
            holdArg(b, i)
        } else {
            checkAssign(f.fnRec.params[i], a, argLabel(meth, i, start) + " of " + callDisplay(meth, fname))
            consume(a)
            argOrderCheck(tbase, fname, meth, i, argLine, argCol)
        }
        if restorePos {
            tline = savedTokLine
            tcol = savedTokCol
        }
        if iface && i == 0 {
            pushIfaceReceiver(a)                   // the box's vtable and object, before any explicit argument runs (v3 7.1)
        } else if a.mode == "const" && fits32(a.val) {
            pushI(a.val)                           // no register needed
            depth += 8
            drop(a)
        } else {
            let r = asReg(a)
            pushR(r.r)
            release(r.r)
        }
    }
    releaseArgs(tbase, omark)
    if sym != T_RPAREN { error(callDisplay(meth, fname) + " takes " + string(narg) + " argument(s), not more") }
    expect(T_RPAREN, "")
    // a reference inside something may not go to a callee that writes through a handle, since the
    // handle may name what it is inside. A callee with only a forward heading is assumed to write.
    if deepLine > 0 {
        if f == curFn {
            notePending(deepLine, deepCol, "cannot pass a reference that points inside something to " + callDisplay(meth, fname) + ": it writes through a handle, which could free it")
        } else if f.addr < 0 {
            errorAt("cannot pass a reference that points inside something to " + callDisplay(meth, fname) + ": its body is not known yet, so it is assumed to write through a handle, which could free it", deepLine, deepCol)
        } else if f.writesHandles {
            errorAt("cannot pass a reference that points inside something to " + callDisplay(meth, fname) + ": it writes through a handle, which could free it", deepLine, deepCol)
        }
    }
    // a mut reference and another that may point inside it could let the callee
    // free what the other points to; references to one object are fine
    for i in 0..len(argBinds) {
        for j in 0..len(argBinds) {
            let bi = argBinds[i]
            let bj = argBinds[j]
            if i != j && argModes[i] == 2 {
                for p in 0..len(bi.roots) {
                    for q in 0..len(bj.roots) {
                        let ri = bi.roots[p]
                        let rj = bj.roots[q]
                        // two places in one root may be told apart: elements known to differ
                        if bj.deeps[q] && reaches(ri, rj) && (ri != rj || pathsOverlap(bi.paths[p], bj.paths[q])) {
                            // a plain function numbers the references it was given (the old argBinds indexes);
                            // a method numbers source arguments, with the receiver as parameter 0
                            var lj = j
                            var li = i
                            if meth { lj = argIdx[j]; li = argIdx[i] }
                            error(argLabel(meth, lj, start) + " of " + callDisplay(meth, fname) + " may point inside " + argLabel(meth, li, start) + ", which is mut")
                        }
                    }
                }
            }
        }
    }
    for i in 0..len(argBinds) {
        let b = argBinds[i]
        for p in 0..len(b.roots) {
            let ar = b.roots[p]
            if ar.storage == "global" && mightFree(f, ar) {
                error("cannot pass a reference into global '" + qualifiedSymName(ar) + "' to " + callDisplay(meth, fname) + ": it might free it")
            }
        }
    }
    for i in 0..len(argBinds) {
        let b = argBinds[i]
        for p in 0..len(b.roots) {
            if b.roots[p] == handleSym && !pureFn(f) {
                error("cannot pass a reference that borrows through a handle to " + callDisplay(meth, fname) + ": it might free what the handle names")
            }
        }
    }
    for i in 0..len(argBinds) {
        // a callee that frees nothing below its mut parameter (see FnRec.pfree) leaves the references into it valid
        if argModes[i] == 2 && mutFrees(f, argIdx[i]) {
            let b = argBinds[i]
            for p in 0..len(b.roots) {
                // the binding's place; itemBind made it anywhere for a reference a loop has not pointed afresh
                invalidate(b.roots[p], argVias[i], false, b.paths[p])
                let br = b.roots[p]
                callFrees(f, argIdx[i], br, !b.deeps[p] || b.paths[p] != "", b.paths[p])
                if !(br.isParam && br.isRef) { recordFree(br) }
            }
        }
    }
    afterCall(f)
    if movesFn(f) { userCalls += 1 }              // only calls that might free count
    if fnval {
        if recv == nil { error("internal error: a function value call without a cell") }
        if recv != nil {
            let e = asReg(copyItem(recv))
            opMem(0xFF, 2, mem(e.r, -1, 0, 8), false, false)
            release(e.r)
        }
    } else if iface {
        // the vtable word lies above the n arguments, at [rsp + 8n]: call the member's slot through it (v3 4, 7.1)
        opMem(0x8B, RAX, mem(RSP, -1, 8 * n, 8), true, false)
        opMem(0xFF, 2, mem(RAX, -1, 8 * ifaceSlot(f), 8), false, false)
    } else {
        emit(0xE8)
        emit32(0)
        let at = pc() - 4
        if f.addr >= 0 {
            fix(at, f.addr)
            append(farCalls, at)
        } else {
            append(f.fnRec.fixups, at)
            fwdCalls += 1
        }
    }
    if nw > 0 || pad != 0 {
        aluRI(0, RSP, 8 * nw + pad)
        depth -= 8 * nw + pad
    }
    restoreRegs(saved)
    callIface = savedIface
    if f.ret == tVoid { return voidItem() }
    let r = alloc()
    movRR(r, RAX)
    let res = makeReg(f.ret, r)
    res.strTemp = f.ret == tString               // the caller now holds the returned reference
    return res
}

// An indirect call of a function-typed local/parameter. The cell pointer is materialised in a frame
// temporary before any visible argument runs; callFnWith then pushes it as hidden argument 0 and
// dispatches through qword [cell]. The synthetic callee is pure with the visible signature, so all
// ordinary argument/effect checks apply and afterCall has no effect.
fn callValue(x: Item, name: string, line: int, col: int): Item {
    let t = x.typ
    let fa = new []FnRec(0)
    append(fa, new FnRec{fixups: new []int(0), params: new []^Type(0),
                         pmodes: new []int(0), freed: new []^Sym(0)})
    let fr = handle(fa[0])
    let sa = new []Sym(0)
    append(sa, new Sym{kind: "fncall", name: "function value '" + name + "'", fnRec: fr,
                       ret: fnRet(t), bind: noBind, recv: tVoid, addr: 0})
    let f = handle(sa[0])
    for i in 0..fnArity(t) {
        append(f.fnRec.params, fnParam(t, i))
        append(f.fnRec.pmodes, fnMode(t, i))
    }
    let cell = newLocal("", tInt, "var")
    let dst = localItem(cell, tInt)
    store(dst, x)
    return callFnWith(f, localItem(cell, tInt), false, line, col)
}

fn describe(x: &Item): string {
    let s = x.sym
    if s != nil { return qualifiedSymName(s) }
    return "value"
}

// Stores a payload word of a freshly allocated Result cell, without store() (which would release the
// cell's register as if it were the destination's): the pattern newExpr uses for its fields.
fn storeCellField(p: int, off: int, v: Item) {
    let dst = mem(p, -1, off, 8)
    if v.mode == "const" && fits32(v.val) {
        opMem(0xC7, 0, dst, true, false)
        emit32(v.val)
        drop(v)
    } else {
        let r = asReg(v)
        opMem(0x89, r.r, dst, true, false)
        release(r.r)
    }
}

fn conversion(t: ^Type): Item {
    expect(T_LPAREN, "")
    let a = nestedExpr()
    expect(T_RPAREN, "")
    if t == tString {
        // string(n) gives the decimal digits of an int; string(bytes) copies a []byte
        if a.typ.kind == "int" {
            if a.mode == "const" { return makeConst(tString, stringLit(string(a.val))) }
            return rtCall1(RT_INT_TO_STR, a, tString)
        }
        if a.typ.kind == "byte" {
            error("string() of a byte is ambiguous: use string(int(b)) for its number, or a []byte for the character")
        }
        if a.typ.kind != "array" || baseOf(a.typ).kind != "byte" {
            error("string() needs an int or a []byte, not " + tname(a.typ))
        }
        noTemp(a)
        return rtCall1(RT_BYTES_TO_STRING, a, tString)
    }
    if !isInt(a.typ) { error(tname(t) + "() needs an int or byte, not " + tname(a.typ)) }
    if a.mode == "const" {
        if t == tByte { return makeConst(t, a.val & 255) }
        return makeConst(t, a.val)
    }
    let x = load(a)
    if t == tByte && x.typ.kind != "byte" { aluRI(4, x.r, 255) }
    x.typ = t
    return x
}

// Experimental cinterop("symbol", int args...): a scalar native call. The arguments use obo's
// ordinary right-to-left stack layout; the generated thunk converts them to SysV. The call target
// is a placeholder rel32 recorded in the sidecar, never an address guessed by this compiler.
// There is no name, arity or library special case: every function goes through the same path.
fn nativeCall(): Item {
    expect(T_LPAREN, "")
    if sym != T_STRING { error("cinterop needs a C symbol name string first") }
    let cname = sval
    if !isCNativeName(cname) { error("cinterop symbol name must be a C identifier") }
    next()
    // Save the live registers before the argument expressions run, as an ordinary obo call does.
    // The pushed values stay visible to the collector and are restored after the call.
    let saved = usedRegs()
    pushRegs(saved)
    setFree(0)
    let args = new []?Item(0)
    while sym == T_COMMA {
        next()
        if len(args) >= 8 { error("cinterop takes at most 8 arguments in this prototype") }
        let a = nestedExpr()
        if !isInt(a.typ) { error("cinterop arguments must be int in this prototype") }
        append(args, a)
    }
    expect(T_RPAREN, "")
    let n = len(args)
    let pad = (depth + 8 * n) % 16
    if pad != 0 {
        aluRI(5, RSP, 8)
        depth += 8
    }
    for i in 0..n {
        let a = take(args[i])
        if a != nil {
            consume(a)
            if a.mode == "const" && fits32(a.val) {
                pushI(a.val)
                depth += 8
                drop(a)
            } else {
                let r = asReg(a)
                pushR(r.r)
                release(r.r)
            }
        } else {
            drop(a)
        }
    }
    emit(0xE8)
    let at = pc()
    emit32(0)
    append(nativeRelocs, new NativeReloc{off: at, sym: cname})
    if n > 0 || pad != 0 {
        aluRI(0, RSP, 8 * n + pad)
        depth -= 8 * n + pad
    }
    restoreRegs(saved)
    // C is trusted but opaque: it may free or write through anything it had from an earlier call.
    // Native code receives no managed pointers in this prototype, but the summary stays conservative.
    let f = curFn
    if f != nil { f.writesHandles = true }
    userCalls += 1
    let r = alloc()
    movRR(r, RAX)
    return makeReg(tInt, r)
}

fn builtin(name: string): Item {
    if name == "cinterop" { return nativeCall() }
    if name == "ok" {
        // ok(v): Result[T] where T is v's type. v is moved into the cell, so a reference or an
        // error value (which has no payload type) cannot be its value.
        expect(T_LPAREN, "")
        let v = nestedExpr()
        expect(T_RPAREN, "")
        if v.typ == tVoid { error("ok needs a value, not a void expression") }
        if v.typ.kind == "nil" { error("ok(nil) has no type: give the payload a name first, as in 'let n: ?Node = nil; ok(n)'") }
        if v.typ.kind == "errval" { error("ok cannot hold an error value: type it as a Result first, as in 'let inner: Result[int] = err(...); ok(inner)'") }
        rejectFn(v.typ, "Result cannot hold a function value")
        if v.borrowed { error("ok takes ownership of its value: it cannot hold a borrowed reference") }
        consume(v)
        let rt = derived("result", v.typ)
        let okv = rt.variants[0]
        let p = rtCall1(RT_ALLOC_RECORD, makeConst(tInt, okv.desc), rt)
        storeCellField(p.r, 0, v)
        return p
    }
    if name == "err" {
        // err(message[, code]): one err cell, typed errval so that only a Result destination accepts
        // it. The message is consumed (a string field takes a reference) before the code runs.
        expect(T_LPAREN, "")
        let m = nestedExpr()
        if m.typ.kind != "string" { error("err needs a string message, not " + tname(m.typ)) }
        consume(m)
        var code = makeConst(tInt, 0)
        if sym == T_COMMA {
            next()
            code = nestedExpr()
            if !isInt(code.typ) { error("err needs an int code, not " + tname(code.typ)) }
        }
        expect(T_RPAREN, "")
        let ev = errVariantType()
        let p = rtCall1(RT_ALLOC_RECORD, makeConst(tInt, ev.desc), tErrVal)
        storeCellField(p.r, 0, m)
        storeCellField(p.r, 8, code)
        return p
    }
    if name == "print" || name == "println" || name == "eprint" || name == "eprintln" {
        let toStderr = name[0] == 'e'
        if toStderr { rtCall1(RT_SET_OUTPUT, makeConst(tInt, 2), tVoid) }
        expect(T_LPAREN, "")
        var first = true
        while sym != T_RPAREN {
            if !first { expect(T_COMMA, "") }
            first = false
            let a = nestedExpr()
            let k = a.typ.kind
            var slot = -1
            if k == "int" || k == "byte" {
                slot = RT_PRINT_INT
            } else if k == "bool" {
                slot = RT_PRINT_BOOL
            } else if k == "string" {
                slot = RT_PRINT_STR
            }
            if slot < 0 { error("cannot print " + tname(a.typ)) }
            rtCall1(slot, a, tVoid)
        }
        expect(T_RPAREN, "")
        if name == "println" || name == "eprintln" { rtCall0(RT_NEWLINE, tVoid) }
        if toStderr { rtCall1(RT_SET_OUTPUT, makeConst(tInt, 1), tVoid) }
        return voidItem()
    }
    if name == "args" {
        expect(T_LPAREN, "")
        expect(T_RPAREN, "")
        return rtCall0(RT_ARGS, derived("array", tString))
    }
    if name == "readFile" || name == "writeFile" {
        expect(T_LPAREN, "")
        var p = nestedExpr()
        if p.typ.kind != "string" { error(name + " needs a string path, not " + tname(p.typ)) }
        if name == "readFile" {
            expect(T_RPAREN, "")
            return rtCall1(RT_READ_FILE, p, derived("opt", derived("array", tByte)))
        }
        p = pinStr(p)
        expect(T_COMMA, "")
        var d = nestedExpr()
        if d.typ.kind != "array" || baseOf(d.typ).kind != "byte" {
            error("writeFile needs a []byte, not " + tname(d.typ))
        }
        noTemp(d)
        // the bytes are located before the flag runs: they are held while it does, as a call's argument is
        let tbase = argTempsUsed
        let omark = len(ownedLocals)
        holdArg(itemBind(d), 1)
        d = materialise(d)
        expect(T_COMMA, "")
        let eLine = tline
        let eCol = tcol
        let e = nestedExpr()
        argOrderCheck(tbase, name, false, 2, eLine, eCol)
        releaseArgs(tbase, omark)
        if e.typ.kind != "bool" { error("writeFile needs a bool saying whether the file is executable") }
        expect(T_RPAREN, "")
        let args3 = new []?Item(0)
        append(args3, p)
        append(args3, d)
        append(args3, e)
        return rtCall(RT_WRITE_FILE, args3, tBool)
    }
    if name == "handle" {
        // a handle to an object: copyable, storable, checked on every use
        expect(T_LPAREN, "")
        if sym != T_IDENT { error("handle needs a variable, field or element") }
        let x = designator()
        expect(T_RPAREN, "")
        if isIfaceVal(x.typ) { error("handles name records and closed types, not " + tname(x.typ)) }
        if (x.mode != "mem" && x.mode != "elem") || (x.typ.kind != "record" && x.typ.kind != "closed") {
            error("handle needs a record or closed-type value that is not optional, not " + tname(x.typ))
        }
        let ht = derived("handle", x.typ)
        var origin: ?^Sym = nil
        if !x.viaHandle && lastRaw == "" { origin = wholeOwnerOf(x.sym) }
        // a field or element of an owned local: tracked by its place (see "Field and element origins"). Not through a
        // handle or a reference, and not of a global
        var pOwner: ?^Sym = nil
        if origin == nil && !x.viaHandle && lastRaw != "" && x.deref { pOwner = wholeOwnerOf(x.root) }
        let praw = lastRaw
        let made = rtCall1(RT_HANDLE, x, ht)
        made.hOrigin = origin
        made.pOwner = pOwner
        made.pPath = praw
        return made
    }
    if name == "replace" {
        // stores a new value in a variable, field or element and hands back the old one
        expect(T_LPAREN, "")
        if sym != T_IDENT { error("replace needs a variable, field or element") }
        var x = designator()
        let place = lastPlace
        let raw = lastRaw
        let orig = lastOrigin
        let ident = lastIdent
        if (x.mode != "mem" && x.mode != "elem") || !isOwned(x.typ) {
            error("replace needs a variable, field or element holding an owned value")
        }
        if x.readonly { error("replace cannot change '" + describe(x) + "': it is immutable") }
        let rs = x.sym
        if rs != nil && rs.isRefLocal {
            error("replace cannot change '" + rs.name + "': it is a reference, which only borrows; replace a field or element of it")
        }
        if raw == "" && !x.viaHandle && !x.deref { originMove(x.sym, true) }
        let tr = x.root
        if x.deref && tr != nil && tr.isRef && !tr.bind.writable {
            error("replace cannot change through '" + tr.name + "': it is a read-only reference")
        }
        expect(T_COMMA, "")
        let callsBefore = userCalls
        let savedPin = pinned
        let touch0 = heldTouch(tr)
        if x.deref && tr != nil && tr.storage == "local" { pinned = tr }
        let hp = heldPush(tr, x.viaHandle, orig, ident, place, raw)
        var v = nestedExpr()
        pinned = savedPin
        expect(T_RPAREN, "")
        if (x.viaHandle || x.sym == nil) && userCalls != callsBefore {
            error("replace through a handle, a field or an element cannot have a value that calls a function that might free; compute the value first")
        }
        if tr != nil && heldLost(tr, touch0) {
            error("cannot replace '" + qualifiedSymName(tr) + "' with a value that moves it: the call could free the array it gives back; compute the value first")
        }
        if heldHitAt(hp) {
            error("cannot replace a place with a value that moves or frees what it holds: the old value could be freed; compute the value first")
        }
        heldPop(hp)
        checkAssign(x.typ, v, "replacement value")
        consume(v)
        freeEvent(x, place, raw, orig, ident)
        if x.deref || x.viaHandle {
            invalidateOwnedChange(x)
            recordFreeChange(x, false)
            placeFreeChange(x, false, "replace a place in")
            if x.viaHandle { placeFreeVia(orig, raw, false, "replace a place in") }
        } else {
            let ts = x.sym
            if ts != nil {
                invalidate(ts, nil, true, "")
                recordFree(ts)
            }
        }
        resolve(x)
        let r = alloc()
        opMem(0x8B, r, memOf(x), true, false)
        let xt = x.typ
        store(x, v)
        return makeReg(xt, r)
    }
    if name == "drop" {
        // frees an owned local now and marks it moved, so that every path can agree
        expect(T_LPAREN, "")
        if sym != T_IDENT { error("drop needs a local variable") }
        let x = designator()
        expect(T_RPAREN, "")
        let ds = x.sym
        if x.mode != "mem" || ds == nil || ds.storage != "local" || !ds.owned {
            error("drop needs a local variable holding an owned value")
            return voidItem()
        }
        let dx = newItem("mem", symType(ds))
        dx.base = RBP
        dx.disp = ds.offset
        originFree(ds, "drop")
        consume(x)
        rtCall1(RT_FREE, dx, tVoid)
        return voidItem()
    }
    if name == "alive" {
        let first = tokSeq == guardStart + 1
        expect(T_LPAREN, "")
        // asking whether a handle is alive is no use of its object: naming the handle here is not counted (usedAt)
        var bare = false
        if sym == T_IDENT {
            var q = 0
            while peek(q) == ' ' { q += 1 }
            bare = peek(q) == ')'
        }
        inAlive = bare
        let h = nestedExpr()
        inAlive = false
        expect(T_RPAREN, "")
        if h.typ.kind != "handle" { error("alive needs a handle, not " + tname(h.typ)) }
        unname(h.sym)
        if bare && first {
            guardSym = h.sym
            guardFollow = sym
            guardFree = freeSeq
        }
        return rtCall1(RT_ALIVE, h, tBool)
    }
    if name == "take" {
        // takes the value out of an optional variable, field or element, leaving nil
        expect(T_LPAREN, "")
        if sym != T_IDENT { error("take needs a variable, field or element") }
        let x = designator()
        expect(T_RPAREN, "")
        if (x.mode != "mem" && x.mode != "elem") || x.typ.kind != "opt" || !isOwned(x.typ) {
            error("take needs an optional variable, field or element holding an owned value")
        }
        if x.readonly { error("take cannot change '" + describe(x) + "': it is immutable") }
        let ts0 = x.sym
        if ts0 != nil && ts0.isRefLocal {
            error("take cannot change '" + ts0.name + "': it is a reference, which only borrows; take a field or element of it")
        }
        let tr = x.root
        if x.deref && tr != nil && tr.isRef && !tr.bind.writable {
            error("take cannot change through '" + tr.name + "': it is a read-only reference")
        }
        freeEvent(x, lastPlace, lastRaw, lastOrigin, lastIdent)
        if lastRaw == "" && !x.viaHandle && !x.deref { originMove(x.sym, true) }
        if x.deref || x.viaHandle {
            invalidateOwnedChange(x)
            recordFreeChange(x, false)
            placeFreeChange(x, false, "take a place in")
            if x.viaHandle { placeFreeVia(lastOrigin, lastRaw, false, "take a place in") }
        } else {
            let ts = x.sym
            if ts != nil && ts.storage == "local" { invalidate(ts, nil, true, "") }
            if ts != nil && ts.storage == "global" {
                invalidate(ts, nil, true, "")
                recordFree(ts)
            }
        }
        resolve(x)
        let r = alloc()
        opMem(0x8B, r, memOf(x), true, false)
        opMem(0xC7, 0, memOf(x), true, false)
        emit32(0)
        releaseItem(x)
        return makeReg(x.typ, r)
    }
    if name == "openFile" {
        // openFile(path, mode): Result[int]. The path is pinned before the mode runs: the mode may
        // assign over the string's owner, and the runtime converts the path only when called.
        expect(T_LPAREN, "")
        var p = nestedExpr()
        if p.typ.kind != "string" { error("openFile needs a string path, not " + tname(p.typ)) }
        p = pinStr(p)
        expect(T_COMMA, "")
        var m = nestedExpr()
        if m.typ.kind != "string" { error("openFile needs a string mode, not " + tname(m.typ)) }
        if m.mode == "const" { checkMode(rodataString(m.val)) }
        m = materialise(m)
        expect(T_RPAREN, "")
        return resultCall4(RT_OPEN_FILE, p, m, tInt)
    }
    if name == "readFd" {
        // readFd(fd, max): Result[?[]byte]. The fd is materialised before max runs, so a call there
        // that changes the fd cannot change which descriptor is read.
        expect(T_LPAREN, "")
        var fd = nestedExpr()
        if !isInt(fd.typ) { error("readFd needs an int file descriptor, not " + tname(fd.typ)) }
        fd = materialise(fd)
        expect(T_COMMA, "")
        var n = nestedExpr()
        if !isInt(n.typ) { error("readFd needs an int count, not " + tname(n.typ)) }
        if n.mode == "const" && n.val <= 0 { error("readFd needs a positive count") }
        n = materialise(n)
        expect(T_RPAREN, "")
        return resultCall4(RT_READ_FD, fd, n, derived("opt", derived("array", tByte)))
    }
    if name == "writeFd" {
        // writeFd(fd, data): Result[int]. data is borrowed and is the last argument, so no hold is
        // needed; noTemp keeps it from being a transient with no owner during the call.
        expect(T_LPAREN, "")
        var fd = nestedExpr()
        if !isInt(fd.typ) { error("writeFd needs an int file descriptor, not " + tname(fd.typ)) }
        fd = materialise(fd)
        expect(T_COMMA, "")
        var d = nestedExpr()
        if d.typ.kind != "array" || baseOf(d.typ).kind != "byte" {
            error("writeFd needs a []byte, not " + tname(d.typ))
        }
        noTemp(d)
        d = materialise(d)
        expect(T_RPAREN, "")
        return resultCall4(RT_WRITE_FD, fd, d, tInt)
    }
    if name == "closeFile" {
        expect(T_LPAREN, "")
        var fd = nestedExpr()
        if !isInt(fd.typ) { error("closeFile needs an int file descriptor, not " + tname(fd.typ)) }
        fd = materialise(fd)
        expect(T_RPAREN, "")
        return resultCall3(RT_CLOSE_FD, fd, tBool)
    }
    if name == "readDirFd" {
        // readDirFd(fd, max): Result[?[]byte]. The fd is materialised before max runs (as readFd);
        // a constant max must be positive and at most the runtime's 1 MiB cap.
        expect(T_LPAREN, "")
        var fd = nestedExpr()
        if !isInt(fd.typ) { error("readDirFd needs an int file descriptor, not " + tname(fd.typ)) }
        fd = materialise(fd)
        expect(T_COMMA, "")
        var n = nestedExpr()
        if !isInt(n.typ) { error("readDirFd needs an int count, not " + tname(n.typ)) }
        if n.mode == "const" && n.val <= 0 { error("readDirFd needs a positive count") }
        if n.mode == "const" && n.val > 1048576 { error("readDirFd count is too large") }
        n = materialise(n)
        expect(T_RPAREN, "")
        return resultCall4(RT_READ_DIR_FD, fd, n, derived("opt", derived("array", tByte)))
    }
    if name == "statPath" || name == "lstatPath" {
        // statPath(path) / lstatPath(path): Result[[]int], the 14 fields in the design's order.
        // The single argument is pinned before the call, as every path builtin is.
        expect(T_LPAREN, "")
        var p = nestedExpr()
        if p.typ.kind != "string" { error(name + " needs a string path, not " + tname(p.typ)) }
        p = pinStr(p)
        expect(T_RPAREN, "")
        if name == "statPath" { return resultCall3(RT_STAT_PATH, p, derived("array", tInt)) }
        return resultCall3(RT_LSTAT_PATH, p, derived("array", tInt))
    }
    if name == "readLinkPath" {
        // readLinkPath(path): Result[[]byte], the raw target bytes with no NUL.
        expect(T_LPAREN, "")
        var p = nestedExpr()
        if p.typ.kind != "string" { error("readLinkPath needs a string path, not " + tname(p.typ)) }
        p = pinStr(p)
        expect(T_RPAREN, "")
        return resultCall3(RT_READ_LINK_PATH, p, derived("array", tByte))
    }
    if name == "isatty" {
        // isatty(fd): a bool, not a Result. The fd is materialised before the call, as readFd's.
        expect(T_LPAREN, "")
        var fd = nestedExpr()
        if !isInt(fd.typ) { error("isatty needs an int file descriptor, not " + tname(fd.typ)) }
        fd = materialise(fd)
        expect(T_RPAREN, "")
        return rtCall1(RT_ISATTY, fd, tBool)
    }
    if name == "terminalWidth" {
        // terminalWidth(fd): an int, not a Result; 0 means not a terminal or unknown. The fd is
        // materialised before the call, as isatty's. The int result needs no `plausible` entry.
        expect(T_LPAREN, "")
        var fd = nestedExpr()
        if !isInt(fd.typ) { error("terminalWidth needs an int file descriptor, not " + tname(fd.typ)) }
        fd = materialise(fd)
        expect(T_RPAREN, "")
        return rtCall1(RT_TERM_WIDTH, fd, tInt)
    }
    if name == "sleepMs" {
        // sleepMs(ms): Result[bool]. A negative or larger-than-24.8-day count is a runtime
        // error; the argument is materialised so a call cannot change it while it runs.
        expect(T_LPAREN, "")
        var ms = nestedExpr()
        if !isInt(ms.typ) { error("sleepMs needs an int millisecond count, not " + tname(ms.typ)) }
        ms = materialise(ms)
        expect(T_RPAREN, "")
        return resultCall3(RT_SLEEP, ms, tBool)
    }
    if name == "getenv" {
        // getenv(name): ?[]byte, owned. Absent is nil and a present empty value is a non-nil empty
        // array. The name is pinned before the call, as every path builtin's argument is.
        expect(T_LPAREN, "")
        var p = nestedExpr()
        if p.typ.kind != "string" { error("getenv needs a string name, not " + tname(p.typ)) }
        p = pinStr(p)
        expect(T_RPAREN, "")
        return rtCall1(RT_GETENV, p, derived("opt", derived("array", tByte)))
    }
    if name == "stdin" || name == "stdout" || name == "stderr" {
        expect(T_LPAREN, "")
        expect(T_RPAREN, "")
        var fd = 0
        if name == "stdout" { fd = 1 } else if name == "stderr" { fd = 2 }
        return makeConst(tInt, fd)
    }
    if name == "append" || name == "truncate" || name == "substr" {
        let line = tline
        expect(T_LPAREN, "")
        var a = nestedExpr()
        let aPlace = lastPlace
        let aRaw = lastRaw
        let aOrig = lastOrigin
        let aIdent = lastIdent
        let aVia = lastViaHandle
        var want = "array"
        var article = "an"
        if name == "substr" {
            want = "string"
            article = "a"
        }
        if a.typ.kind != want { error(name + " needs " + article + " " + want + ", not " + tname(a.typ)) }
        noTemp(a)
        // a write through a reference: the root is read here, before pinStr loads the array into a register
        if name == "append" || name == "truncate" { noteWrite(a) }
        if name != "substr" {
            let ar = a.root
            if ar != nil && ar.isRef && !ar.bind.writable {
                error(name + " changes the array, but '" + ar.name + "' is a read-only reference")
            }
            if name == "truncate" {
                let owned = isOwned(baseOf(a.typ))
                if owned { invalidateOwnedChange(a) } else { invalidateChange(a) }
                if owned || !throughHandle(a) || baseOf(a.typ).kind == "string" { recordFreeChange(a, true) }   // a scalar array frees nothing; strings lose a reference
            }
        }
        // the array is located before the value or count runs: a call there could free it
        let held = heldArray(a)
        let aDeref = a.deref
        let aPath = a.path
        let r0 = a.root
        a = pinStr(a)
        expect(T_COMMA, "")
        let callsBefore = userCalls
        let touch0 = heldTouch(r0)
        let savedPin = pinned
        if name != "substr" && aDeref && r0 != nil && r0.storage == "local" { pinned = r0 }
        let hp = heldPush(r0, aVia, aOrig, aIdent, aPlace, aRaw)
        var b = nestedExpr()
        pinned = savedPin
        if name != "substr" && held && userCalls != callsBefore {
            if name == "append" {
                errorAt("cannot append to a field, element, handle or global across a call: the call could free the array it is in; compute the value first", line, 0)
            }
            errorAt("cannot truncate a field, element, handle or global across a call: the call could free the array it is in; compute the value first", line, 0)
        }
        if name != "substr" && r0 != nil && heldLost(r0, touch0) {
            if name == "append" {
                errorAt("cannot append to '" + qualifiedSymName(r0) + "' with a value that moves it: the call could free the array it is in; compute the value first", line, 0)
            }
            errorAt("cannot truncate '" + qualifiedSymName(r0) + "' with a count that moves it: the call could free the array it is in; compute the count first", line, 0)
        }
        if heldHitAt(hp) {
            errorAt("cannot " + name + " an array with a value or count that replaces or moves what it holds: the old value could be freed; compute the value first", line, 0)
        }
        heldPop(hp)
        if name == "append" {
            checkAssign(baseOf(a.typ), b, "appended value")
            consume(b)
            expect(T_RPAREN, "")
            rtCall2(RT_APPEND, a, b, tVoid)
            return voidItem()
        }
        if !isInt(b.typ) { error(name + " needs int positions") }
        if name == "truncate" {
            expect(T_RPAREN, "")
            // the elements above the count are freed: the handles made from an element of this array, or from
            // something inside one, are dead (after the count was computed)
            if isOwned(baseOf(a.typ)) {
                if b.mode == "const" { truncKeep = b.val }
                placeFreeIn(r0, aVia, aPath, true, "truncate an array in")
                if aVia { placeFreeVia(aOrig, aRaw, true, "truncate an array in") }
                truncKeep = -1
            }
            let at = new []?Item(0)
            append(at, a)
            append(at, b)
            append(at, makeConst(tInt, line))
            rtCall(RT_TRUNCATE, at, tVoid)
            return voidItem()
        }
        b = materialise(b)
        expect(T_COMMA, "")
        let c = nestedExpr()
        if !isInt(c.typ) { error(name + " needs int positions") }
        expect(T_RPAREN, "")
        let as = new []?Item(0)
        append(as, a)
        append(as, b)
        append(as, c)
        append(as, makeConst(tInt, line))
        return rtCall(RT_SUBSTR, as, tString)
    }
    if name == "gc" || name == "gcstats" {
        expect(T_LPAREN, "")
        expect(T_RPAREN, "")
        if name == "gc" {
            rtCall0(RT_COLLECT, tVoid)
        } else {
            rtCall0(RT_GC_STATS, tVoid)
        }
        return voidItem()
    }
    expect(T_LPAREN, "")
    let a = nestedExpr()
    expect(T_RPAREN, "")
    if name == "exit" {
        if a.typ.kind != "int" { error("exit needs an int") }
        rtCall1(RT_EXIT, a, tVoid)
        noreturn = true
        return voidItem()
    }
    if a.typ.kind == "string" {
        if a.mode == "const" { return makeConst(tInt, len(rodataString(a.val))) }
        if a.strTemp {
            let p = load(a)
            let n = alloc()
            movRR(n, p.r)
            opReg(0x85, n, n, true, false)
            emit(0x74)
            emit(0)
            let at0 = pc()
            opMem(0x8B, n, mem(n, -1, 0, 8), true, false)
            setCode(at0 - 1, pc() - at0)
            rtCall1(RT_STR_DEC, p, tVoid)
            return makeReg(tInt, n)
        }
        let x = load(a)
        opReg(0x85, x.r, x.r, true, false)
        emit(0x74)
        emit(0)
        let at = pc()
        opMem(0x8B, x.r, mem(x.r, -1, 0, 8), true, false)
        setCode(at - 1, pc() - at)
        return makeReg(tInt, x.r)
    }
    if a.typ.kind != "array" { error("len needs a string or array, not " + tname(a.typ)) }
    noTemp(a)
    let x = load(a)
    opMem(0x8B, x.r, mem(x.r, -1, 0, 8), true, false)
    return makeReg(tInt, x.r)
}

fn designatorT(target: bool): Item
fn methodCall(recv: Item, name: string, dline: int, dcol: int, rline: int, rcol: int): Item

fn designator(): Item { return designatorT(false) }

// target: the designator is the left side of an assignment, where a moved
// local may be given a new value
// the item a name stands for: a builtin, a call, a constant, a variable or a conversion
fn nameItem(s: ^Sym, name: string, target: bool): Item {
    if s.kind == "builtin" { return builtin(name) }
    if s.kind == "fn" {
        if sym != T_LPAREN { error("functions can only be called") }
        return callFn(s)
    }
    if s.kind == "const" { return makeConst(symType(s), s.value) }
    if s.kind == "var" || s.kind == "let" {
        var x = newItem("mem", symType(s))
        if s.home >= 0 {
            x = newItem("reg", symType(s))        // held in a register of its own: see REG_HOMES
            x.r = s.home
            x.home = true
        } else if s.storage == "local" {
            x.typ = varType(s)
            x.base = RBP
        }
        x.disp = s.offset
        x.sym = s
        x.root = s
        x.pair = isPairLocal(s)
        x.hOrigin = s.hOrigin
        if s.hDepth > 0 {
            useSeq += 1
            lastNamed = s
            lastNamedPrev = s.usedAt
            s.usedAt = useSeq
            if s.movedLoop && !inAlive {
                error("handle '" + name + "' was made from an owner that a loop moved: make the handle again")
            }
        }
        x.readonly = s.kind == "let"
        x.borrowed = s.isRef
        if (s.owned || s.isRefLocal) && s.moved {
            if target {
                x.movedRef = true
            } else if s.isRefLocal {
                error(freedRefMsg(name))
            } else {
                error("'" + name + "' was moved and has no value here")
            }
        }
        if inDefer && s.owned { s.deferUse = true }
        if inDefer && s.isRefLocal { noteDeferUse(s) }
        return x
    }
    if s.kind == "type" && sym == T_LPAREN && (symType(s) == tInt || symType(s) == tByte || symType(s) == tString) {
        return conversion(symType(s))
    }
    error("'" + name + "' is a type, not a value (use 'new " + name + "{...}' to make one)")
    return voidItem()
}

fn designatorT(target: bool): Item {
    let uline = tline
    let ucol = tcol
    let name = ident()
    let s = designatorSym(name, uline, ucol)
    let qname = lastDesigName
    var x = nameItem(s, qname, target)
    let isFnCall = sym == T_LPAREN && x.typ.kind == "fn"
    if sym == T_LPAREN && !isFnCall && (s.kind == "var" || s.kind == "let" || s.kind == "const") {
        error("'" + qname + "' is not a function")
    }
    let root = x.root
    var viaHandle = false
    var path = ""
    var hOrig: ?^Sym = nil
    var hIdent: ?^Sym = nil
    var handles = 0
    var isCall = false
    var callName = ""
    var callLine = 0
    var callCol = 0
    while sym == T_DOT || sym == T_LBRACK {
        if x.movedRef {
            if s.isRefLocal { error(freedRefMsg(qname)) }
            error("'" + qname + "' was moved and has no value here")
        }
        if x.mode == "reg" && isOwned(x.typ) {
            error("store this value in a variable first: otherwise it would never be freed")
        }
        if x.typ.kind == "opt" { error("'" + describe(x) + "' may be nil: check it with '!= nil' first") }
        if sym == T_DOT && x.typ.kind == "handle" {
            // check the handle now: the object must still be the one it named
            let hb = baseOf(x.typ)
            if handles == 0 {
                deadHandleCheck(x.sym)
                hOrig = x.hOrigin
                hIdent = x.sym
            } else {
                hOrig = nil
                hIdent = nil
            }
            handles += 1
            x = rtCall1(RT_DEREF, x, hb)
            viaHandle = true
        }
        if sym == T_DOT {
            if x.typ.kind == "fn" {
                error("a function value has no fields or methods; call it with '(' after its name")
            }
            next()
            let mline = tline
            let mcol = tcol
            let fname = ident()
            if sym == T_LPAREN {
                // a method call ends the designator: the receiver is finalized by the tail below
                isCall = true
                callName = fname
                callLine = mline
                callCol = mcol
                break
            }
            if x.typ.incomplete { error(tname(x.typ) + " is declared but not yet defined") }
            if x.typ.kind == "closed" { error(tname(x.typ) + " is a closed type: use 'match' to reach its fields") }
            if x.typ.kind == "iface" {
                // a member named without its call (v3 11); any other name is a field, and an interface has none
                let mv = findIfaceMethod(x.typ, fname)
                if mv != nil { error("interface method '" + ifaceMethodDisplay(mv) + "' cannot be used as a value: call it with '(' after its name") }
                error("interface '" + tname(x.typ) + "' has no fields; it has methods only")
            }
            if x.typ.kind != "record" { error(tname(x.typ) + " has no fields") }
            let rt0 = x.typ
            let fi = fieldIndex(rt0, fname)
            if fi < 0 {
                let mv = findMethod(rt0, fname)
                if mv != nil && (mv.owner == curModuleName || mv.exported) {
                    error("method '" + methodDisplay(mv) + "' cannot be used as a value: call it with '(' after its name")
                }
                error(tname(rt0) + " has no field '" + fname + "'")
                return x
            }
            let fty = rt0.fields[fi].typ
            let foff = rt0.fields[fi].offset
            let p = load(x)
            x = newItem("mem", fty)
            x.base = p.r
            x.disp = foff
            path = path + "/" + fname
        } else {
            next()
            let line = tline
            let kind = x.typ.kind
            if x.strTemp { error("store this string in a variable first") }
            let callsBefore = userCalls
            if kind != "array" && kind != "string" { error(tname(x.typ) + " cannot be indexed") }
            let elem = baseOf(x.typ)
            // the array's address is loaded before the index runs: a call there could free it. A
            // by-value call moves the owner of the root (any array in it, at any depth), which
            // heldLost sees; a call that only borrows, or takes a mut argument, cannot free it.
            let wholeLocal = x.sym != nil && !(root != nil && (root.storage == "global" || root.isRef))
            let touch0 = heldTouch(root)
            // a string's pointer is kept in a register across the index, and a call there that assigns over the
            // string (b.s = "", through a mut parameter, a handle or a global) drops its last reference and frees it,
            // which no free summary records (strings are not owned): the index holds a reference of its own
            let pinIdx = kind == "string" && x.mode != "const" && indexHasCall()
            var a = load(x)
            if pinIdx { a = rtCall1(RT_STR_INC, a, tString) }
            let hp = heldPush(root, viaHandle, hOrig, hIdent, placePath(root, path), path)
            let i0 = nestedExpr()
            if !isInt(i0.typ) { error("array index must be int") }
            if viaHandle && userCalls != callsBefore {
                error("cannot index through a handle with an index that calls a function: the call could free the object")
            }
            if root != nil && root.storage == "global" && userCalls != callsBefore {
                error("cannot index through global '" + qualifiedSymName(root) + "' with an index that calls a function: the call could free it")
            }
            if !wholeLocal && userCalls != callsBefore {
                error("cannot index a field, element or reference with an index that calls a function: the call could free the array it is in; compute the index first")
            }
            if root != nil && heldLost(root, touch0) {
                error("cannot index '" + qualifiedSymName(root) + "' with an index that moves it: the call could free its array; compute the index first")
            }
            if viaHandle && heldHitAt(hp) {
                error("cannot index through a handle with an index that moves or frees something: the object it names could be freed; compute the index first")
            }
            if root != nil && heldHitAt(hp) {
                error("cannot index '" + qualifiedSymName(root) + "' with an index that replaces or moves what it holds: the old value could be freed; compute the index first")
            }
            heldPop(hp)
            var seg = "/[]"
            if i0.mode == "const" { seg = "/[" + string(i0.val) + "]" }
            let i = asReg(i0)
            expect(T_RBRACK, "")
            if kind == "string" {
                opReg(0x85, a.r, a.r, true, false)
                emit(0x75)
                emit(14)
                trapBounds(line)
                boundsCheck(i.r, mem(a.r, -1, 0, 8), line)
                x = newItem("mem", tByte)
                x.base = a.r
                x.index = i.r
                x.disp = 8
                x.scale = 1
                x.width = 1
                x.readonly = true
                if pinIdx {
                    // the byte is read now, and the reference the index took is given back
                    let keep = alloc()
                    movRR(keep, a.r)
                    x = load(x)
                    rtCall1(RT_STR_DEC, makeReg(tString, keep), tVoid)
                }
            } else {
                x = newItem("elem", elem)
                x.base = a.r
                x.index = i.r
                x.line = line
                if elem.kind == "byte" { x.width = 1 }
            }
            path = path + seg
        }
    }
    // a use of a suspect reference (not just pointing it elsewhere): see afterCall.
    // A method call is a value use of its receiver even when the statement was parsed as an
    // assignment target (designatorT(true) in assignmentOrCall), so isCall forces the read marks.
    if s.suspect && (!target || path != "" || isCall) {
        notePending(uline, ucol, "'" + qname + "' may point to freed memory: a recursive call writes through a handle, which could free what it points into")
    }
    if s.isRefLocal && (!target || path != "" || isCall) {        // a read, not a re-pointing: see loopBindCheck
        useSeq += 1
        if !s.fresh {
            s.staleUse = useSeq
            s.usedAt = useSeq
            s.staleLine = uline
            s.staleCol = ucol
            if s.carryFreed { s.freedUse = useSeq }
        }
    }
    x.viaHandle = viaHandle
    lastPlace = placePath(root, path)
    lastRaw = path
    lastOrigin = hOrig
    lastIdent = hIdent
    lastViaHandle = viaHandle
    if x.sym == nil && root != nil {
        x.root = root
        x.deref = true
        // through a handle the path is not known (the whole root); a reference adds its own place (placeIn)
        if !viaHandle { x.path = path }
        // nothing can be moved out through a reference, so this can only be a borrow
        if root.isRef && isOwned(x.typ) { x.borrowed = true }
    }
    if isFnCall { return callValue(x, qname, uline, ucol) }
    if isCall { return methodCall(x, callName, callLine, callCol, uline, ucol) }
    return x
}

// A method call on the finalized receiver x. The receiver's place metadata is complete by now
// (root, deref, path, viaHandle, borrowed) and its value use has been recorded.
// A call of member name on an owned interface value (v3 7.1): through the receiver's vtable, with the member's
// synthetic summary standing for the callee (7.3). A call in a global initializer is refused before the frame
// cell and the dispatch: the initializer chain has no frame to hold the vtable across the arguments.
fn ifaceMethodCall(recv: Item, t: ^Type, name: string, dline: int, dcol: int, rline: int, rcol: int): Item {
    if curFn == nil {
        errorAt("an interface method cannot be called in a global initializer; call a function that does it, as in var G = initG()", dline, dcol)
    }
    let m = findIfaceMethod(t, name)
    if m == nil { errorAt("interface '" + tname(t) + "' has no method '" + name + "'", dline, dcol) }
    if m != nil { return callFnWith(m, recv, true, rline, rcol) }
    return voidItem()
}

fn methodCall(recv: Item, name: string, dline: int, dcol: int, rline: int, rcol: int): Item {
    let t = recv.typ
    if t.incomplete { errorAt(tname(t) + " is declared but not yet defined", dline, dcol) }
    if t.kind == "iface" { return ifaceMethodCall(recv, t, name, dline, dcol, rline, rcol) }
    if t.kind != "record" && t.kind != "closed" { errorAt(tname(t) + " has no methods", dline, dcol) }
    if t.kind == "record" && fieldIndex(t, name) >= 0 {
        errorAt("type '" + tname(t) + "' has a field '" + name + "', not a method; a field cannot be called", dline, dcol)
    }
    let m = findMethod(t, name)
    if t.owner != "" && t.owner != curModuleName && (m == nil || !m.exported) {
        // the same message in a full build and in --check: a private method never leaks
        var tn = t.name
        var mm = m
        if mm != nil { tn = mm.recv.name }
        errorAt("module '" + t.owner + "' has no exported member '" + tn + "::" + name + "' (only 'pub' declarations are visible)", dline, dcol)
    }
    if m == nil {
        errorAt("type '" + tname(t) + "' has no method '" + name + "' (declare it before use; use a forward heading for mutual recursion)", dline, dcol)
    }
    if m != nil {
        // an owned receiver that is the whole object named by a handle: the dereference is a temporary
        // register item, and consuming it would free the object without its owner knowing
        if m.fnRec.pmodes[0] == 0 && recv.viaHandle && recv.mode == "reg" {
            errorAt("cannot call a method that takes its receiver by value through a handle: the handle does not own the object; declare the method with '&' or 'mut &T', or call it on the owner", rline, rcol)
        }
        return callFnWith(m, recv, true, rline, rcol)
    }
    return voidItem()
}

fn newExpr(): Item {
    next()
    if sym == T_LBRACK {
        let t = parseType()
        expect(T_LPAREN, "")
        let n = nestedExpr()
        if !isInt(n.typ) { error("array length must be int") }
        let b = baseOf(t)
        if nonNull(b) && !(n.mode == "const" && n.val == 0) {
            error("array elements of type " + tname(b) + " would start as nil; use []?" + tname(b) +
                  ", or start empty with new []" + tname(b) + "(0) and append")
        }
        expect(T_RPAREN, "")
        var kind = 1
        if b.kind == "byte" {
            kind = 4
        } else if b.kind == "string" {
            kind = 6                                  // reference-counted strings
        } else if isOwned(b) {
            kind = 2                                  // owned objects, freed with the array (not handles)
        }
        return rtCall2(RT_ALLOC_ARRAY, n, makeConst(tInt, kind), t)
    }
    let uline = tline
    let ucol = tcol
    let name = ident()
    let s = designatorSym(name, uline, ucol)
    let qname = lastDesigName
    if s.kind == "type" && symType(s).incomplete { error("'" + qname + "' is declared but not yet defined") }
    if s.kind != "type" || symType(s).kind != "record" { error("'" + qname + "' is not a record type") }
    let t = symType(s)
    let p = rtCall1(RT_ALLOC_RECORD, makeConst(tInt, t.desc), t)
    let given = new []string(0)
    expect(T_LBRACE, "")
    skipSemis()
    while sym != T_RBRACE {
        let fname = ident()
        let fi = fieldIndex(t, fname)
        if fi < 0 {
            error(tname(t) + " has no field '" + fname + "'")
            return p
        }
        let fty = t.fields[fi].typ
        let foff = t.fields[fi].offset
        for g in given {
            if g == fname { error("field '" + fname + "' given twice") }
        }
        append(given, fname)
        expect(T_COLON, "")
        var v = nestedExpr()
        checkAssign(fty, v, "field '" + fname + "'")
        consume(v)
        let dst = mem(p.r, -1, foff, 8)
        if v.mode == "const" && fits32(v.val) {
            opMem(0xC7, 0, dst, true, false)
            emit32(v.val)
            drop(v)
        } else {
            let r = asReg(v)
            opMem(0x89, r.r, dst, true, false)
            release(r.r)
        }
        if sym == T_COMMA || sym == T_SEMI {
            next()
        } else if sym != T_RBRACE {
            expect(T_COMMA, "',' or '}'")
        }
        skipSemis()
    }
    expect(T_RBRACE, "")
    var missing = ""
    for i in 0..len(t.fields) {
        let fname2 = t.fields[i].name
        var isGiven = false
        for g in given {
            if g == fname2 { isGiven = true }
        }
        if nonNull(t.fields[i].typ) && !isGiven {
            if len(missing) > 0 { missing = missing + ", " }
            missing = missing + fname2
        }
    }
    if len(missing) > 0 { error(tname(t) + " needs a value for " + missing + " (it cannot be nil)") }
    return p
}

// try e: on an ok cell the payload is moved out and the shell freed; on an err cell the function's
// defers run, its live owned locals are freed, and that same cell is returned. The whole semantics is
// in FORK.md; the state capture happens after consume (see the comment in the body).
fn tryExpr(): Item

fn lambdaBody(f: ^Sym, ret: ^Type, params: &[]Param)
fn lambdaExpr(): Item

// Lambda parameters: the same groups as a function's, without mut, with the lambda-specific diagnostic.
fn lambdaParams(mut params: &[]Param) {
    while sym != T_RPAREN {
        if sym == T_IDENT && sval == "mut" {
            error("a lambda parameter cannot be mut; a function value takes owned or read-only parameters")
        }
        let names = new []string(0)
        append(names, ident())
        while sym == T_COMMA {
            next()
            append(names, ident())
        }
        expect(T_COLON, "")
        let t = parseRefType()
        let mode = refMode
        rejectIfaceFn(t)
        for n in names { append(params, new Param{name: n, typ: t, mode: mode}) }
        if sym != T_RPAREN {
            expect(T_COMMA, "',' or ')'")
            if sym == T_RPAREN { error("expected a parameter type") }
        }
    }
    expect(T_RPAREN, "")
}

// fn (Params) [: Ret] { Body }: a non-capturing lambda literal. The body is a code island compiled
// with its own frame and function state; the outer state is saved in LamCtx and restored before the
// literal's read-only cell is emitted.
fn lambdaExpr(): Item {
    let hline = tline
    let hcol = tcol
    next()
    if sym == T_LBRACK {
        error("a capture list is not supported yet; this compiler implements non-capturing lambdas only")
    }
    expect(T_LPAREN, "")
    let params = new []Param(0)
    lambdaParams(&params)
    var ret = tVoid
    if sym == T_COLON {
        next()
        ret = parseType()
    }
    rejectFn(ret, "a function cannot return a function value; function values are parameters and locals only")
    for p in params { rejectIfaceFn(p.typ) }
    rejectIfaceFn(ret)
    let ft = newFnType(ret)
    for p in params { fnAddParam(ft, p.typ, p.mode) }
    rejectIfaceFn(ft)
    if curFn == nil { error("a lambda can only be created inside a function") }
    if inWhileCond { error("a lambda literal cannot appear in a while condition; move the call out of the condition before the loop") }
    if inDefer { error("a lambda literal cannot appear in a defer body; move the call out of the defer") }
    if sym != T_LBRACE { error("a lambda body needs '{'") }
    let over = jmp()
    let entry = pc()
    let f = newSym("lambda", "a lambda", nil)
    f.fnRec = newFnRec()
    f.ret = ret
    f.owner = curModuleName
    f.line = hline
    f.addr = entry
    let hp = new []Param(0)
    append(hp, new Param{name: "a lambda's environment", typ: tInt, mode: 1})
    for p in params { append(hp, new Param{name: p.name, typ: p.typ, mode: p.mode}) }
    for p in hp {
        append(f.fnRec.params, p.typ)
        append(f.fnRec.pmodes, p.mode)
    }
    let outerFrom = len(lambdaOuterNames)
    for bi in 0..len(blocks) {
        for si in 0..len(blocks[bi].syms) {
            append(lambdaOuterNames, blocks[bi].syms[si].name)
        }
    }
    let c = new LamCtx{
        homeBits: homeBits, homeCap: homeCap, homeRetry: homeRetry,
        free: replace(free, new []int(0)),
        frame: frame, depth: depth, fwdCalls: fwdCalls,
        lifted: replace(lifted, new []byte(0)),
        waitFn: replace(waitFn, new []^Sym(0)),
        waitAt: replace(waitAt, new []int(0)),
        farCalls: replace(farCalls, new []int(0)),
        barrier: barrier, blocks: replace(blocks, new []Block(0)), fnBlock: fnBlock,
        ownedLocals: replace(ownedLocals, new []^Sym(0)),
        narrowStack: replace(narrowStack, new []NEntry(0)),
        loops: replace(loops, new []Loop(0)),
        depthJumps: replace(depthJumps, new []int(0)),
        originSyms: replace(originSyms, new []^Sym(0)),
        originDead: replace(originDead, new []?^Sym(0)),
        originLive: replace(originLive, new []?^Sym(0)),
        originPath: replace(originPath, new []string(0)),
        originNar: replace(originNar, new []bool(0)),
        deferH: replace(deferH, new []^Sym(0)),
        deferAt: replace(deferAt, new []int(0)),
        deferFrees: replace(deferFrees, new []^Sym(0)),
        deferFreeEv: replace(deferFreeEv, new []string(0)),
        dfBlock: replace(dfBlock, new []int(0)),
        dfIndex: replace(dfIndex, new []int(0)),
        dfOwner: replace(dfOwner, new []^Sym(0)),
        dfEv: replace(dfEv, new []string(0)),
        deferUses: replace(deferUses, new []bool(0)),
        deferMark: deferMark, inDefer: inDefer,
        freeLog: replace(freeLog, new []^FreeRec(0)),
        freeArena: replace(freeArena, new []FreeRec(0)),
        nonFreshLog: replace(nonFreshLog, new []int(0)),
        arenaBase: arenaBase, recording: recording,
        heldKey: replace(heldKey, new []?^Sym(0)),
        heldPath: replace(heldPath, new []string(0)),
        heldForeign: replace(heldForeign, new []bool(0)),
        heldHit: replace(heldHit, new []bool(0)),
        heldStore: replace(heldStore, new []bool(0)),
        heldWhole: replace(heldWhole, new []bool(0)),
        pendSym: replace(pendSym, new []^Sym(0)),
        pendDepth: replace(pendDepth, new []int(0)),
        frLine: replace(frLine, new []int(0)),
        frCol: replace(frCol, new []int(0)),
        pendWhat: replace(pendWhat, new []string(0)),
        pendOwn: replace(pendOwn, new []^Sym(0)),
        pendNest: replace(pendNest, new []int(0)),
        pendLine: pendLine, pendCol: pendCol, pendMsg: pendMsg, contSeq: contSeq, brkSeq: brkSeq,
        orSeq: orSeq, freeSeq: freeSeq, truncKeep: truncKeep, replayFree: replayFree,
        guardStart: guardStart, guardSym: guardSym, guardFollow: guardFollow, guardFree: guardFree,
        guardNeg: guardNeg, guardOpen: guardOpen, guardIdx: guardIdx, guardMark: guardMark,
        inAlive: inAlive, lastNamed: lastNamed, lastNamedPrev: lastNamedPrev,
        lastDesigName: lastDesigName, lastPlace: lastPlace, lastRaw: lastRaw,
        lastOrigin: lastOrigin, lastIdent: lastIdent, lastViaHandle: lastViaHandle, curFn: curFn,
        selfCalls: selfCalls, userCalls: userCalls, useSeq: useSeq, trySite: trySite,
        tryNest: tryNest, noreturn: noreturn, condDepth: condDepth, pinned: pinned,
        inWhileCond: inWhileCond, loopdepth: loopdepth,
        scanBytes: replace(scanBytes, new []byte(0)),
        scanAt: replace(scanAt, new []int(0)),
        scanLen: replace(scanLen, new []int(0)),
        scanScore: replace(scanScore, new []int(0)),
        scanPend: replace(scanPend, new []bool(0)),
        scanCalls: scanCalls,
        bindLen: len(bindArena), symLen: len(symArena), fnLen: len(fnArena), argLen: len(argTemps),
        argTempsUsed: argTempsUsed, fnStackLen: len(fnStack), callIface: callIface,
        convBorrow: convBorrow, convPairOn: convPairOn, convPairDisp: convPairDisp
    }
    setFree(0)
    homeBits = 0
    homeCap = 0
    homeRetry = false
    frame = 0
    depth = 0
    fwdCalls = 0
    barrier = 0
    recording = 0
    arenaBase = 0
    freeSeq = 0
    contSeq = 0
    brkSeq = 0
    orSeq = 0
    truncKeep = -1
    replayFree = false
    deferMark = -1
    inDefer = false
    inWhileCond = false
    loopdepth = 0
    guardStart = -10
    guardSym = nil
    guardFollow = 0
    guardFree = 0
    guardNeg = false
    guardOpen = false
    guardIdx = 0
    guardMark = nil
    inAlive = false
    lastNamed = nil
    lastNamedPrev = 0
    lastDesigName = ""
    lastPlace = ""
    lastRaw = ""
    lastOrigin = nil
    lastIdent = nil
    lastViaHandle = false
    selfCalls = 0
    userCalls = 0
    useSeq = 0
    trySite = 0
    tryNest = 0
    noreturn = false
    condDepth = 0
    pinned = nil
    scanCalls = 0
    pendLine = 0
    pendCol = 0
    pendMsg = ""
    callIface = false
    convBorrow = 0
    convPairOn = false
    convPairDisp = 0
    argTempsUsed = len(argTemps)
    curFn = f
    append(fnStack, f)
    lambdaBody(f, ret, &hp)
    truncate(fnStack, c.fnStackLen)
    truncate(lambdaOuterNames, outerFrom)
    homeBits = c.homeBits
    homeCap = c.homeCap
    homeRetry = c.homeRetry
    replace(free, replace(c.free, new []int(0)))
    frame = c.frame
    depth = c.depth
    fwdCalls = c.fwdCalls
    replace(lifted, replace(c.lifted, new []byte(0)))
    replace(waitFn, replace(c.waitFn, new []^Sym(0)))
    replace(waitAt, replace(c.waitAt, new []int(0)))
    replace(farCalls, replace(c.farCalls, new []int(0)))
    barrier = c.barrier
    replace(blocks, replace(c.blocks, new []Block(0)))
    fnBlock = c.fnBlock
    replace(ownedLocals, replace(c.ownedLocals, new []^Sym(0)))
    replace(narrowStack, replace(c.narrowStack, new []NEntry(0)))
    replace(loops, replace(c.loops, new []Loop(0)))
    replace(depthJumps, replace(c.depthJumps, new []int(0)))
    replace(originSyms, replace(c.originSyms, new []^Sym(0)))
    replace(originDead, replace(c.originDead, new []?^Sym(0)))
    replace(originLive, replace(c.originLive, new []?^Sym(0)))
    replace(originPath, replace(c.originPath, new []string(0)))
    replace(originNar, replace(c.originNar, new []bool(0)))
    replace(deferH, replace(c.deferH, new []^Sym(0)))
    replace(deferAt, replace(c.deferAt, new []int(0)))
    replace(deferFrees, replace(c.deferFrees, new []^Sym(0)))
    replace(deferFreeEv, replace(c.deferFreeEv, new []string(0)))
    replace(dfBlock, replace(c.dfBlock, new []int(0)))
    replace(dfIndex, replace(c.dfIndex, new []int(0)))
    replace(dfOwner, replace(c.dfOwner, new []^Sym(0)))
    replace(dfEv, replace(c.dfEv, new []string(0)))
    replace(deferUses, replace(c.deferUses, new []bool(0)))
    deferMark = c.deferMark
    inDefer = c.inDefer
    replace(freeLog, replace(c.freeLog, new []^FreeRec(0)))
    replace(freeArena, replace(c.freeArena, new []FreeRec(0)))
    replace(nonFreshLog, replace(c.nonFreshLog, new []int(0)))
    arenaBase = c.arenaBase
    recording = c.recording
    replace(heldKey, replace(c.heldKey, new []?^Sym(0)))
    replace(heldPath, replace(c.heldPath, new []string(0)))
    replace(heldForeign, replace(c.heldForeign, new []bool(0)))
    replace(heldHit, replace(c.heldHit, new []bool(0)))
    replace(heldStore, replace(c.heldStore, new []bool(0)))
    replace(heldWhole, replace(c.heldWhole, new []bool(0)))
    replace(pendSym, replace(c.pendSym, new []^Sym(0)))
    replace(pendDepth, replace(c.pendDepth, new []int(0)))
    replace(frLine, replace(c.frLine, new []int(0)))
    replace(frCol, replace(c.frCol, new []int(0)))
    replace(pendWhat, replace(c.pendWhat, new []string(0)))
    replace(pendOwn, replace(c.pendOwn, new []^Sym(0)))
    replace(pendNest, replace(c.pendNest, new []int(0)))
    pendLine = c.pendLine
    pendCol = c.pendCol
    pendMsg = c.pendMsg
    contSeq = c.contSeq
    brkSeq = c.brkSeq
    orSeq = c.orSeq
    freeSeq = c.freeSeq
    truncKeep = c.truncKeep
    replayFree = c.replayFree
    guardStart = c.guardStart
    guardSym = c.guardSym
    guardFollow = c.guardFollow
    guardFree = c.guardFree
    guardNeg = c.guardNeg
    guardOpen = c.guardOpen
    guardIdx = c.guardIdx
    guardMark = c.guardMark
    inAlive = c.inAlive
    lastNamed = c.lastNamed
    lastNamedPrev = c.lastNamedPrev
    lastDesigName = c.lastDesigName
    lastPlace = c.lastPlace
    lastRaw = c.lastRaw
    lastOrigin = c.lastOrigin
    lastIdent = c.lastIdent
    lastViaHandle = c.lastViaHandle
    curFn = c.curFn
    selfCalls = c.selfCalls
    userCalls = c.userCalls
    useSeq = c.useSeq
    trySite = c.trySite
    tryNest = c.tryNest
    noreturn = c.noreturn
    condDepth = c.condDepth
    pinned = c.pinned
    inWhileCond = c.inWhileCond
    loopdepth = c.loopdepth
    replace(scanBytes, replace(c.scanBytes, new []byte(0)))
    replace(scanAt, replace(c.scanAt, new []int(0)))
    replace(scanLen, replace(c.scanLen, new []int(0)))
    replace(scanScore, replace(c.scanScore, new []int(0)))
    replace(scanPend, replace(c.scanPend, new []bool(0)))
    scanCalls = c.scanCalls
    argTempsUsed = c.argTempsUsed
    callIface = c.callIface
    convBorrow = c.convBorrow
    convPairOn = c.convPairOn
    convPairDisp = c.convPairDisp
    fixHere1(over)
    if !(pureFn(f) && !f.writesHandles && f.fnRec.pfree == 0) {
        error("a lambda must be pure: it may not free a global or free owned state through a handle; call a pure function instead")
    }
    rodAlign()
    let cell = RODATA_BASE + len(rodata)
    rod64(CODE_BASE + f.addr)
    return makeConst(ft, cell)
}

fn factor(): Item {
    let k = sym
    if k == T_INT {
        let v = ival
        next()
        return makeConst(tInt, v)
    }
    if k == T_STRING {
        let addr = stringLit(sval)
        next()
        return makeConst(tString, addr)
    }
    if k == T_TRUE || k == T_FALSE {
        next()
        if k == T_TRUE { return makeConst(tBool, 1) }
        return makeConst(tBool, 0)
    }
    if k == T_NIL {
        next()
        return makeConst(tNil, 0)
    }
    if k == T_LPAREN {
        next()
        let x = expression()
        expect(T_RPAREN, "")
        return x
    }
    if k == T_NEW { return newExpr() }
    if k == T_TRY { return tryExpr() }
    if k == T_NOT {
        next()
        let x = factor()
        if x.typ.kind != "bool" { error("'!' needs a bool") }
        if x.mode == "const" { return makeConst(tBool, 1 - x.val) }
        let c = loadCond(x)
        let y = newItem("cond", tBool)
        y.cc = c.cc ^ 1
        y.T = c.F
        y.F = c.T
        y.nt = take(c.nf)
        y.nf = take(c.nt)
        return y
    }
    if k == T_MINUS || k == T_TILDE {
        next()
        let x = factor()
        if !isInt(x.typ) { error("'" + tokName(k) + "' needs an int") }
        if x.mode == "const" {
            if k == T_MINUS { return makeConst(tInt, -x.val) }
            return makeConst(tInt, ~x.val)
        }
        let y = load(x)
        if k == T_MINUS {
            opReg(0xF7, 3, y.r, true, false)
        } else {
            opReg(0xF7, 2, y.r, true, false)
        }
        y.typ = tInt
        return y
    }
    if k == T_CHAR {
        let v = ival
        next()
        return makeConst(tByte, v)
    }
    if k == T_AMP {
        // &place: borrow instead of moving
        next()
        if sym != T_IDENT { error("& needs a variable, field or element") }
        let x = designator()
        if (x.mode != "mem" && x.mode != "elem") || !isOwned(x.typ) {
            error("& needs a variable, field or element holding a record, closed type or array")
        }
        x.borrowed = true
        return x
    }
    if k == T_FN { return lambdaExpr() }
    if k == T_IDENT { return designator() }
    error("expected an expression")
    return voidItem()
}

// The for-walk marks of the owned locals, saved across a try's error block: the error path abandons the
// walk, so a free on it must not be judged as a change during a walk (see invalidate).
fn iteratingSave(): []bool {
    let v = new []bool(0)
    for i in 0..len(ownedLocals) { append(v, ownedLocals[i].iterating) }
    return v
}

fn iteratingClear() {
    for i in 0..len(ownedLocals) { ownedLocals[i].iterating = false }
}

fn iteratingSet(v: &[]bool) {
    for i in 0..len(v) { ownedLocals[i].iterating = v[i] }
}

fn tryExpr(): Item {
    let tl = tline
    let tc = tcol
    if inDefer { errorAt("cannot use try in a defer: a deferred statement cannot return from the function", tl, tc) }
    if tryNest > 0 { errorAt("a try expression cannot be part of a larger expression; assign it to a local first", tl, tc) }
    if trySite == 0 { errorAt("a try expression may only be the value of a let, var or assignment, or a statement", tl, tc) }
    let fr0 = curFn
    if fr0 == nil {
        errorAt("try needs a function that returns a Result; there is no function here", tl, tc)
        return voidItem()
    }
    let fr = fr0
    if fr.ret.kind != "result" {
        var what = "nothing"
        if fr.ret != tVoid { what = tname(fr.ret) }
        errorAt("try needs a function that returns a Result; '" + callableName(fr) + "' returns " + what, tl, tc)
    }
    next()
    var e = factor()
    if e.typ.kind != "result" {
        var hint = ""
        if e.typ.kind == "opt" && baseOf(e.typ).kind == "result" {
            hint = " (it may be nil: check it with '!= nil' first)"
        } else if e.typ.kind == "errval" {
            hint = " (err(...) has no success type)"
        }
        errorAt("try needs a Result value, not " + tname(e.typ) + hint, tl, tc)
    }
    let rt = e.typ
    let ut = baseOf(rt)
    consume(e)
    let cell = asReg(e)
    let cellR = cell.r
    let slot = newLocal("", fr.ret, "var")
    opMem(0x89, cellR, mem(RBP, -1, slot.offset, 8), true, false)
    // The path marks are captured AFTER consume: a pre-consume snapshot would restore moved = false
    // for the operand on the ok path (double free at scope exit), and a pre-consume deadSave would
    // restore an originLive mark that consume's originMove cleared. The pending diagnostic
    // (pendLine/pendCol/pendMsg) is deliberately not restored: the error path is a real exit.
    let st = snapshot()
    let dm = deadSave()
    let log0 = len(freeLog)
    let ps0 = len(pendSym)
    let pd0 = len(pendDepth)
    let fl0 = len(frLine)
    let fc0 = len(frCol)
    let pw0 = len(pendWhat)
    let po0 = len(pendOwn)
    let pn0 = len(pendNest)
    let fs0 = freeSeq
    let its = iteratingSave()
    let ev = errVariantType()
    let tr = alloc()
    opMem(0x8B, tr, mem(cellR, -1, -16, 8), false, false)   // 32-bit: the high half is a generation
    aluRI(7, tr, ev.desc)
    release(tr)
    let toErr = jcc(CC_E)
    let payload = alloc()
    opMem(0x8B, payload, mem(cellR, -1, 0, 8), true, false)
    opMem(0xC7, 0, mem(cellR, -1, 0, 8), true, false)       // the payload is moved out, not owned by the shell
    emit32(0)
    rtCall1(RT_FREE, makeReg(rt, cellR), tVoid)             // the shell; releases cellR
    let done = jmp()
    fixHere(toErr)
    iteratingClear()
    runDefers(fnBlock)
    opMem(0x8B, RAX, mem(RBP, -1, slot.offset, 8), true, false)
    epilogue()
    fixHere(done)
    iteratingSet(its)
    freeSeq = fs0
    truncate(freeLog, log0)
    truncate(pendSym, ps0)
    truncate(pendDepth, pd0)
    truncate(frLine, fl0)
    truncate(frCol, fc0)
    truncate(pendWhat, pw0)
    truncate(pendOwn, po0)
    truncate(pendNest, pn0)
    restore(st)
    deadSet(dm)
    let res = makeReg(ut, payload)
    if ut.kind == "string" { res.strTemp = true }          // the shell's reference is now the caller's
    return res
}

// truncating division, as on x86
fn fold(o: int, a: int, b: int): int {
    if (o == T_SLASH || o == T_PERCENT) && b == 0 { error("division by zero") }
    if (o == T_SLASH || o == T_PERCENT) && b == -1 {
        if o == T_SLASH { return -a }             // wraps for the most negative int
        return 0
    }
    match o {
        T_PLUS { return a + b }
        T_MINUS { return a - b }
        T_STAR { return a * b }
        T_SLASH { return a / b }
        T_PERCENT { return a % b }
        T_AMP { return a & b }
        T_BAR { return a | b }
        T_CARET { return a ^ b }
        T_SHL { return a << b }
        else { return a >> b }
    }
}

fn isMulOp(k: int): bool {
    match k {
        T_STAR, T_SLASH, T_PERCENT, T_SHL, T_SHR, T_AMP { return true }
        else { return false }
    }
}

fn isAddOp(k: int): bool {
    match k {
        T_PLUS, T_MINUS, T_BAR, T_CARET { return true }
        else { return false }
    }
}

fn aluCode(o: int): int {
    match o {
        T_PLUS { return 0 }
        T_BAR { return 1 }
        T_AMP { return 4 }
        T_MINUS { return 5 }
        else { return 6 }
    }
}

fn opOperand(opc: int, reg: int, y0: Item) {
    var y = y0
    if y.mode != "mem" && y.mode != "reg" { y = load(y) }
    if y.mode == "reg" {
        opReg(opc, reg, y.r, true, false)
    } else {
        opMem(opc, reg, memOf(y), true, false)
    }
    releaseItem(y)
}

fn binop(o: int, x0: Item, y0: Item): Item {
    var x = x0
    var y = y0
    if !isInt(x.typ) || !isInt(y.typ) { error("'" + tokName(o) + "' needs ints") }
    if x.mode == "const" && y.mode == "const" { return makeConst(tInt, fold(o, x.val, y.val)) }
    if x.mode == "const" && (o == T_PLUS || o == T_STAR || o == T_AMP || o == T_BAR || o == T_CARET) {
        let t = x
        x = y
        y = t
    }
    if y.mode == "elem" || (y.mode == "mem" && y.width == 1) { y = load(y) }
    if o == T_STAR && x.home && y.mode == "const" && fits32(y.val) {
        let t = alloc()                           // imul reads one register and writes another
        let a0 = here()
        opReg(0x69, t, x.r, true, false)
        emit32(y.val)
        foldAt = a0                               // a store of t into x.r becomes imul on x.r
        foldHome = x.r
        foldT = t
        foldForm = 3
        foldArg = y.val
        foldEnd = here()
        drop(y)
        x = makeReg(tInt, t)
        return x
    }
    x = load(x)
    if o == T_STAR {
        if y.mode == "const" && fits32(y.val) {
            opReg(0x69, x.r, x.r, true, false)
            emit32(y.val)
            drop(y)
        } else {
            let direct = y.mode == "reg"
            let ry = y.r
            let a0 = here()
            opOperand(0x0FAF, x.r, y)
            if direct { noteFold(a0, 2, 0x0FAF, ry, x.r) }
        }
    } else if o == T_SLASH || o == T_PERCENT {
        if y.mode == "const" && y.val == 0 { error("division by zero") }
        if y.mode == "const" { y = load(y) }
        if y.mode != "mem" && y.mode != "reg" { y = load(y) }
        movRR(RAX, x.r)
        emit(0x48)
        emit(0x99)
        if y.mode == "reg" {
            opReg(0xF7, 7, y.r, true, false)
        } else {
            opMem(0xF7, 7, memOf(y), true, false)
        }
        releaseItem(y)
        drop(y)
        if o == T_SLASH {
            movRR(x.r, RAX)
        } else {
            movRR(x.r, RDX)
        }
    } else if o == T_SHL || o == T_SHR {
        var ext = 7
        if o == T_SHL { ext = 4 }
        if y.mode == "const" {
            opReg(0xC1, ext, x.r, true, false)
            emit(y.val & 63)
            drop(y)
        } else {
            opOperand(0x8B, RCX, y)
            opReg(0xD3, ext, x.r, true, false)
        }
    } else {
        let c = aluCode(o)
        if y.mode == "const" && fits32(y.val) {
            let a0 = here()
            aluRI(c, x.r, y.val)
            noteFold(a0, 1, c, y.val, x.r)
            drop(y)
        } else {
            let direct = y.mode == "reg"
            let ry = y.r
            let a0 = here()
            opOperand(c * 8 + 3, x.r, y)
            if direct { noteFold(a0, 2, c * 8 + 3, ry, x.r) }
        }
    }
    x.typ = tInt
    return x
}

fn term(): Item {
    var x = factor()
    while isMulOp(sym) {
        let o = sym
        next()
        if !isInt(x.typ) { error("'" + tokName(o) + "' needs ints") }
        x = materialise(x)
        tryNest += 1
        let y = factor()
        tryNest -= 1
        x = binop(o, x, y)
    }
    return x
}

fn simpleExpr(): Item {
    var x = term()
    while isAddOp(sym) {
        let o = sym
        next()
        if o == T_PLUS && x.typ.kind == "string" {
            x = pinStr(x)
            tryNest += 1
            let y = term()
            tryNest -= 1
            if y.typ.kind != "string" { error("'+' on a string needs another string (use string(n) for numbers)") }
            if x.mode == "const" && y.mode == "const" {
                x = makeConst(tString, stringLit(rodataString(x.val) + rodataString(y.val)))
                drop(y)
            } else {
                x = rtCall2(RT_CONCAT, x, y, tString)
            }
            continue
        }
        if !isInt(x.typ) { error("'" + tokName(o) + "' needs ints") }
        x = materialise(x)
        tryNest += 1
        let y = term()
        tryNest -= 1
        x = binop(o, x, y)
    }
    return x
}

fn relation(): Item {
    var x = simpleExpr()
    if !isRel(sym) { return x }
    let o = sym
    next()
    var xsym: ?^Sym = nil
    if x.mode == "mem" { xsym = x.sym }
    noTemp(x)
    x = pinStr(x)
    tryNest += 1
    var y = simpleExpr()
    tryNest -= 1
    var ysym: ?^Sym = nil
    if y.mode == "mem" { ysym = y.sym }
    noTemp(y)
    let kx = x.typ.kind
    let ky = y.typ.kind
    // a function value has no identity to compare; the nil side is checked first (Section 9.3)
    if kx == "fn" || ky == "fn" {
        if kx == "nil" || ky == "nil" { error("a function value can never be nil") }
        error("function values cannot be compared")
    }
    // interface identity is not meaningful (v3 6.3); a test against nil is allowed (it narrows a ?I)
    if (isIfaceVal(x.typ) || isIfaceVal(y.typ)) && kx != "nil" && ky != "nil" {
        error("interface values cannot be compared; test an optional with '== nil' or '!= nil'")
    }
    if kx == "string" || ky == "string" {
        if kx != ky || (o != T_EQ && o != T_NE) { error("strings can only be compared with == and !=") }
        let r = rtCall2(RT_STREQ, x, y, tInt)
        opReg(0x85, r.r, r.r, true, false)
        release(r.r)
        let z = newItem("cond", tBool)
        z.cc = CC_E
        if o == T_EQ { z.cc = CC_NE }
        return z
    }
    let refs = isRef(x.typ) || isRef(y.typ) || kx == "nil" || ky == "nil"
    if refs {
        if o != T_EQ && o != T_NE { error("references can only be compared with == and !=") }
        if !(assignable(x.typ, y.typ) || assignable(y.typ, x.typ)) {
            error("cannot compare " + tname(x.typ) + " with " + tname(y.typ))
        }
    } else if kx != ky && !(isInt(x.typ) && isInt(y.typ)) {
        error("cannot compare " + tname(x.typ) + " with " + tname(y.typ))
    } else if kx == "bool" && o != T_EQ && o != T_NE {
        error("bools can only be compared with == and !=")
    }
    if x.mode == "const" && y.mode == "const" {
        var v = false
        if o == T_EQ { v = x.val == y.val }
        if o == T_NE { v = x.val != y.val }
        if o == T_LT { v = x.val < y.val }
        if o == T_LE { v = x.val <= y.val }
        if o == T_GT { v = x.val > y.val }
        if o == T_GE { v = x.val >= y.val }
        if v { return makeConst(tBool, 1) }
        return makeConst(tBool, 0)
    }
    var cc = relCC(o)
    var narrowSym: ?^Sym = nil
    var narrowType = tVoid
    if y.typ.kind == "nil" && x.typ.kind == "opt" && xsym != nil && xsym.storage == "local" {
        narrowSym = xsym
        narrowType = baseOf(x.typ)
    }
    if x.typ.kind == "nil" && y.typ.kind == "opt" && ysym != nil && ysym.storage == "local" {
        narrowSym = ysym
        narrowType = baseOf(y.typ)
    }
    if x.mode == "const" {
        let t = x
        x = y
        y = t
        cc = swapCC(cc)
    }
    if x.mode == "cond" { x = load(x) }
    if y.mode == "const" && fits32(y.val) && x.mode == "mem" && x.width == 8 {
        aluMI(7, memOf(x), y.val)
        releaseItem(x)
    } else {
        x = asReg(x)
        if y.mode == "const" && fits32(y.val) {
            aluRI(7, x.r, y.val)
        } else {
            if (y.mode != "mem" && y.mode != "reg") || y.width == 1 { y = load(y) }
            if y.mode == "reg" {
                opReg(0x3B, x.r, y.r, true, false)
            } else {
                opMem(0x3B, x.r, memOf(y), true, false)
            }
            releaseItem(y)
        }
        release(x.r)
    }
    let z = newItem("cond", tBool)
    z.cc = cc
    if narrowSym != nil {
        if o == T_NE {
            z.nt = new NPair{sym: narrowSym, typ: narrowType, next: nil}
        } else {
            z.nf = new NPair{sym: narrowSym, typ: narrowType, next: nil}
        }
    }
    return z
}

fn conjunction(): Item {
    var x = relation()
    var mine = false
    while sym == T_ANDAND {
        next()
        // the rest of an if condition that starts with alive(h) runs only where h is alive: its dead mark is
        // cleared until the conjunction ends, unless something freed an owner since the guard
        if guardSym != nil && !guardNeg && !guardOpen && guardFollow == T_ANDAND && guardFree == freeSeq {
            for i in 0..len(originSyms) {
                if originSyms[i] == guardSym {
                    guardIdx = i
                    guardMark = originDead[i]
                    originDead[i] = nil
                    guardOpen = true
                    mine = true
                }
            }
        }
        if x.typ.kind != "bool" { error("'&&' needs bools") }
        x = loadCond(x)
        let flinks = falseJump(x)
        let mark = len(narrowStack)
        pushNarrowings(x.nt)
        condDepth += 1
        tryNest += 1
        let y = loadCond(relation())
        tryNest -= 1
        condDepth -= 1
        truncate(narrowStack, mark)
        y.F = joinWaits(y.F, flinks)
        y.nt = joinPairs(&x.nt, take(y.nt))
        y.nf = nil
        x = y
    }
    if mine {
        if guardFree == freeSeq { originDead[guardIdx] = guardMark }
        guardOpen = false
    }
    return x
}

fn expression(): Item {
    var x = conjunction()
    while sym == T_OROR {
        next()
        orSeq += 1
        if x.typ.kind != "bool" { error("'||' needs bools") }
        x = loadCond(x)
        x.T = waitJump(x.T, jcc(x.cc))
        fixHere(x.F)
        let mark = len(narrowStack)
        pushNarrowings(x.nf)
        condDepth += 1
        tryNest += 1
        let y = loadCond(conjunction())
        tryNest -= 1
        condDepth -= 1
        truncate(narrowStack, mark)
        y.T = joinWaits(y.T, x.T)
        y.nf = joinPairs(&x.nf, take(y.nf))
        y.nt = nil
        x = y
    }
    return x
}

// ============================================================= statements

fn block(): bool
fn statement(): bool

fn varDecl(kind: string, isGlobal: bool, isPub: bool) {
    let nameLine = tline
    let name = ident()
    if !isGlobal { noteDeclared(name) }
    var t: ?^Type = nil
    var declRef = 0
    if sym == T_COLON {
        next()
        let pt = parseRefType()
        t = pt
        declRef = refMode
        if isGlobal { rejectFn(pt, "a function value cannot be a global; it is a parameter or a local") }
        if declRef > 0 && isGlobal { error("references cannot be global") }
        if declRef > 0 { refuseOptionalIfaceLocal(pt) }
    }
    var gsym = newSym(kind, name, t)
    gsym.line = nameLine
    if isGlobal {
        gsym.storage = "global"
        gsym.offset = GLOBAL_BASE + gsize
        gsize += 8
    }
    if sym == T_ASSIGN {
        next()
        if isGlobal { fixHere1(initLink) }
        var x = tailExpr()
        // an inferred reference local takes the same rules as an explicit one; &?I may only be a parameter or a
        // walk variable, so both spellings are refused here (v3 6.4)
        if !isGlobal && t == nil && x.borrowed { refuseOptionalIfaceLocal(x.typ) }
        if !isGlobal && (declRef > 0 || (t == nil && x.borrowed)) {
            // a reference local: it borrows, nothing is moved or freed. An interface conversion builds its frame
            // cell only after borrowBind succeeds (v3 5.1), so its binding comes first; a &T local keeps the old
            // check-then-borrow order, and its messages with it.
            var rt = x.typ
            if t != nil { rt = t }
            let pair = rt.kind == "iface"
            let v = newRefLocalSlot("", rt, kind, pair)
            v.name = name
            let dst = localItem(v, rt)
            var nb: ^RefBind = noBind
            if pair {
                nb = borrowBind(x)
                let savedConv = convBorrow
                convBorrow = 1
                convPairOn = true
                convPairDisp = dst.disp
                checkAssign(rt, x, "initialising '" + name + "'")
                convPairOn = false
                convBorrow = savedConv
            } else {
                checkAssign(rt, x, "initialising '" + name + "'")
                nb = borrowBind(x)
            }
            makeRefLocal(v, nb)
            if pair { storePair(dst, x) } else { store(dst, x) }
            declare(v)
            return
        }
        // a borrowed value for an interface destination is refused by checkAssign (v3 5.1), with its own text
        if x.borrowed && t != nil && x.mode != "const" && !isIfaceVal(t) {
            error("cannot move out of a reference: declare '" + name + "' as &" + tname(t) + " to borrow")
        }
        var tt = x.typ
        if t != nil {
            tt = t
        } else if x.typ.kind == "errval" {
            error("cannot infer a type for '" + name + "' from an error value; declare it as Result[T]")
        } else if x.typ.kind == "nil" || x.typ.kind == "void" {
            error("cannot infer a type for '" + name + "' from this value")
        }
        checkAssign(tt, x, "initialising '" + name + "'")
        consume(x)
        var s = gsym
        var dst = newItem("mem", tt)
        if isGlobal {
            s.typ = tt
            dst.disp = s.offset
        } else {
            s = newLocal("", tt, kind)
            s.name = name
            if tt.kind == "int" || tt.kind == "bool" { homeFor(s, name, true) }
            dst = localItem(s, tt)
            if kind == "let" {
                s.hOrigin = x.hOrigin
                // a copy takes the live mark of the handle it copies, so a copy of a handle whose origin an earlier
                // move on a path that ended has cleared is still tracked (with no origin, which is an identity)
                var live = x.hOrigin
                var lpath = ""
                if live == nil {
                    live = x.pOwner
                    lpath = x.pPath
                }
                var dead: ?^Sym = nil
                for i in 0..len(originSyms) {
                    if originSyms[i] == x.sym {
                        live = originLive[i]
                        lpath = originPath[i]
                        // a copy of a dead handle is dead too
                        dead = originDead[i]
                    }
                }
                if live != nil {
                    s.hDepth = len(loops) + 1
                    // naming a handle that is dead here, to copy it, is no use of its object: the copy is dead too, and
                    // every use of it is refused. (A copy of a handle not known to be dead counts as a naming.)
                    if dead != nil { unname(x.sym) }
                    append(originSyms, s)
                    append(originDead, dead)
                    append(originLive, live)
                    append(originPath, lpath)
                    append(originNar, false)
                }
            }
        }
        store(dst, x)
        if isGlobal { initLink = jmp() }
        declare(s)
        if isPub { s.exported = true }
        if !isGlobal && isOwned(tt) { addOwnedLocal(s) }
        if !isGlobal && tt.kind == "string" { addStrLocal(s) }
    } else {
        if t == nil {
            error("'" + name + "' needs a type or an initial value")
            return
        }
        if nonNull(t) { error("'" + name + "' of type " + tname(t) + " needs an initial value (it cannot be nil)") }
        if kind == "let" { error("'" + name + "' is immutable and needs a value") }
        if isGlobal {
            gsym.typ = t
            declare(gsym)
            if isPub { gsym.exported = true }
        } else {
            let s = newLocal(name, t, kind)
            if t.kind == "int" || t.kind == "bool" { homeFor(s, name, true) }
            if s.home >= 0 {
                movRI(s.home, 0)
            } else {
                opMem(0xC7, 0, mem(RBP, -1, s.offset, 8), true, false)
                emit32(0)
            }
            if isOwned(t) { addOwnedLocal(s) }
            if t.kind == "string" { addStrLocal(s) }
        }
    }
}


// a value that is only evaluated for its effect: freed at once if it is owned, its string reference
// dropped, a scalar ignored. Shared by a plain expression statement and a discarded try.
fn discardValue(x: Item, line: int, col: int) {
    if x.typ != tVoid || x.mode != "void" {
        if x.mode != "reg" || x.home { errorAt("this expression does nothing", line, col) }
        if isOwned(x.typ) {
            rtCall1(RT_FREE, x, tVoid)                 // a dropped result is freed at once
        } else if x.strTemp {
            rtCall1(RT_STR_DEC, x, tVoid)
        } else {
            releaseItem(x)
            drop(x)
        }
    } else {
        drop(x)
    }
}

// returns true if the statement never completes (a call to exit)
fn assignmentOrCall(): bool {
    let line = tline
    let col = tcol
    noreturn = false
    let x = designatorT(true)
    let tplace = lastPlace
    let traw = lastRaw
    let torig = lastOrigin
    let tident = lastIdent
    if noreturn && (sym == T_SEMI || sym == T_RBRACE) { return true }
    if x.movedRef && sym != T_ASSIGN {
        let r = x.root
        if r != nil { errorAt("'" + r.name + "' was moved and has no value here", line, col) }
    }
    if sym == T_ASSIGN || sym == T_PLUSEQ || sym == T_MINUSEQ || sym == T_STAREQ {
        let o = sym
        if x.mode != "mem" && x.mode != "elem" && !x.home { errorAt("cannot assign to this", line, col) }
        if x.readonly {
            let xs = x.sym
            if xs == nil {
                errorAt("strings are immutable", line, col)
            } else {
                errorAt("'" + qualifiedSymName(xs) + "' is immutable (declared with let)", line, col)
            }
        }
        next()
        var dtype = x.typ
        let xs = x.sym
        if xs != nil { dtype = symType(xs) }
        let wr = x.root
        // a write through a reference that is not pointed afresh: see loopBindCheck
        if x.deref && wr != nil && wr.isRefLocal && !wr.fresh {
            useSeq += 1
            wr.writeUse = useSeq
        }
        if x.deref && wr != nil && wr.isRef && !wr.bind.writable {
            errorAt("cannot change through '" + wr.name + "': it is a read-only reference", line, col)
        }
        if o == T_ASSIGN && xs != nil && xs.isRefLocal {
            // pointing a reference somewhere else: nothing is moved or freed
            if xs.iterating { errorAt("cannot point '" + xs.name + "' elsewhere while a for loop walks it", line, col) }
            if deferMark >= 0 && declaredBefore(xs, deferMark) {
                errorAt("cannot point '" + xs.name + "' elsewhere in a defer: a defer body runs where its block is left, and the change would not be seen there", line, col)
            }
            var y = tailExpr()
            var nb: ^RefBind = noBind
            if x.typ.kind == "iface" {
                nb = borrowBind(y)
                let savedConv = convBorrow
                convBorrow = 1
                convPairOn = true
                convPairDisp = x.disp
                checkAssign(dtype, y, "assignment")
                convPairOn = false
                convBorrow = savedConv
            } else {
                checkAssign(dtype, y, "assignment")
                nb = borrowBind(y)
            }
            if !assignable(x.typ, y.typ) { widen(xs) }
            if x.pair { storePair(x, y) } else { store(x, y) }
            // the parent may be xs itself, or one below it (a reference copied from xs's own value): then
            // it is xs's old parent, so that the parents stay a chain
            let oldParent = xs.bind.parent
            var parent: ?^Sym = nb.parent
            if ancestorOf(xs, parent) { parent = oldParent }
            // the references derived from xs's old value derive from its parent now
            let locals = &ownedLocals
            for v in locals {
                if v.isRefLocal && v.bind.parent == xs {
                    let rb = rebind(v.bind, oldParent)
                    v.bind = rb
                }
            }
            let nbind = rebind(nb, parent)
            xs.bind = nbind
            xs.fresh = true
            xs.carryFreed = false
            xs.suspect = false
            xs.moved = false
            return false
        }
        if o == T_ASSIGN {
            let callsBefore = userCalls
            let savedPin = pinned
            let r0 = x.root
            let touch0 = heldTouch(r0)
            if x.deref && r0 != nil && r0.storage == "local" { pinned = r0 }
            var hp = -1
            if x.deref || x.viaHandle { hp = heldPushStore(r0, x.viaHandle, torig, tident, tplace, traw) }
            var y = tailExpr()
            pinned = savedPin
            checkAssign(dtype, y, "assignment")
            consume(y)
            if traw == "" && !x.viaHandle && !x.deref { originMove(xs, false) }
            checkTargetAcrossCall(x, xs, r0, callsBefore, line, col)
            if x.deref && r0 != nil && heldLost(r0, touch0) {
                errorAt("cannot assign through '" + r0.name + "' with a value that moves what it is in: the call could free it; compute the value first", line, col)
            }
            if heldHitAt(hp) {
                errorAt("cannot assign through a place with a value that replaces or moves what it is in: the old value could be freed; compute the value first", line, col)
            }
            heldPop(hp)
            if xs != nil && xs.storage == "local" && !assignable(x.typ, y.typ) { widen(xs) }
            if isOwned(dtype) {
                if xs != nil && xs.storage == "local" {
                    if xs.iterating { errorAt("cannot change '" + xs.name + "' while a for loop walks it", line, col) }
                    invalidate(xs, nil, true, "")
                } else if x.deref || x.viaHandle {
                    invalidateOwnedChange(x)
                    recordFreeChange(x, false)
                    placeFreeChange(x, false, "assign over a place in")
                    if x.viaHandle { placeFreeVia(torig, traw, false, "assign over a place in") }
                } else if xs != nil {
                    invalidate(xs, nil, true, "")               // a global given a new value
                    recordFree(xs)
                }
                // free the old value first, unless the local's value was moved away
                var live = true
                if xs != nil && xs.storage == "local" { live = !xs.moved }
                if live {
                    resolve(x)
                    let r = alloc()
                    opMem(0x8B, r, memOf(x), true, false)
                    rtCall1(RT_FREE, makeReg(dtype, r), tVoid)
                }
                if xs != nil { xs.moved = false }
            } else if dtype.kind == "string" {
                resolve(x)
                let r = alloc()
                opMem(0x8B, r, memOf(x), true, false)
                rtCall1(RT_STR_DEC, makeReg(tString, r), tVoid)
            }
            store(x, y)
        } else {
            if dtype.kind != "int" { error("'" + tokName(o) + "' needs an int") }
            let callsBefore = userCalls
            let savedPin = pinned
            let r0 = x.root
            let touch0 = heldTouch(r0)
            if x.deref && r0 != nil && r0.storage == "local" { pinned = r0 }
            var hp = -1
            if x.deref || x.viaHandle { hp = heldPushStore(r0, x.viaHandle, torig, tident, tplace, traw) }
            var y = tailExpr()
            pinned = savedPin
            checkTargetAcrossCall(x, xs, r0, callsBefore, line, col)
            if x.deref && r0 != nil && heldLost(r0, touch0) {
                errorAt("cannot assign through '" + r0.name + "' with a value that moves what it is in: the call could free it; compute the value first", line, col)
            }
            if heldHitAt(hp) {
                errorAt("cannot assign through a place with a value that replaces or moves what it is in: the old value could be freed; compute the value first", line, col)
            }
            heldPop(hp)
            if !isInt(y.typ) { error("'" + tokName(o) + "' needs an int") }
            if !same(dtype, tInt) { error("'" + tokName(o) + "' needs an int") }
            resolve(x)
            var r = x.r                       // a local in a register is changed where it is
            if !x.home {
                r = alloc()
                opMem(0x8B, r, memOf(x), true, false)
            }
            if o == T_STAREQ {
                y = asReg(y)
                opReg(0x0FAF, r, y.r, true, false)
                release(y.r)
            } else {
                var c = 5
                if o == T_PLUSEQ { c = 0 }
                if y.mode == "const" && fits32(y.val) {
                    aluRI(c, r, y.val)
                } else {
                    y = asReg(y)
                    opReg(c * 8 + 3, r, y.r, true, false)
                    release(y.r)
                }
            }
            if x.home {
                drop(x)
            } else {
                store(x, makeReg(tInt, r))
            }
        }
    } else {
        if x.typ != tVoid || x.mode != "void" {
            discardValue(x, line, col)
        } else {
            drop(x)
        }
    }
    return false
}

fn statSeq(): bool {
    var term = false
    skipSemis()
    while sym != T_RBRACE && sym != T_EOF {
        if term { error("unreachable code") }
        term = statement()
        if sym != T_RBRACE { expect(T_SEMI, "';' or newline") }
        skipSemis()
    }
    return term
}

fn block(): bool {
    expect(T_LBRACE, "")
    openBlock()
    let pm = len(pendSym)
    let cs = contSeq
    let bs = brkSeq
    let term = statSeq()
    if term { pendBlockEnds(pm, cs, bs) }
    expect(T_RBRACE, "")
    closeBlock(term)
    return term
}

fn ifStat(): bool

// the breaks and continues so far that leave the loop being compiled: those of the loops inside it are not counted,
// since they do not leave this one
fn jumpsHere(): int {
    if len(loops) == 0 { return 0 }
    while len(depthJumps) < len(loops) { append(depthJumps, 0) }
    return depthJumps[len(loops) - 1]
}

fn addJump() {
    while len(depthJumps) < len(loops) { append(depthJumps, 0) }
    depthJumps[len(loops) - 1] += 1
}

// an arm of an if or a match: it starts from the marks before the statement (d0), and the marks after the
// statement are the union (acc) of the arms that go on. An arm that ends outside a loop ends in a return,
// and goes nowhere; inside a loop it may be a break or a continue, so its marks are kept
fn armTail(mut acc: &[]?^Sym, js: int, term: bool): bool {
    // an arm that ends does not go on to what follows the statement: its marks are the state after the loop,
    // if it leaves by a break or a continue, and nowhere if it returns
    if term {
        if len(loops) > 0 && jumpsHere() != js {
            let lx = &loops[len(loops) - 1]
            while len(lx.exitDead) < len(originDead) { append(lx.exitDead, nil) }
            for i in 0..len(originDead) {
                if originDead[i] != nil { lx.exitDead[i] = originDead[i] }
            }
        }
        return term
    }
    let m = len(acc) / 2
    for i in 0..m {
        if originDead[i] != nil { acc[i] = originDead[i] }
        if originLive[i] != nil { acc[m + i] = originLive[i] }
    }
    return term
}

fn armBlock(d0: &[]?^Sym, mut acc: &[]?^Sym, isIf: bool): bool {
    deadSet(d0)
    var term = false
    let js = jumpsHere()
    if isIf { term = ifStat() } else { term = block() }
    return armTail(acc, js, term)
}

fn ifStat(): bool {
    let iline = tline
    let icol = tcol
    next()
    // a condition that starts with alive(h) or !alive(h) narrows h (see "Narrowing on alive")
    var neg = false
    if sym == T_NOT { neg = true }
    guardSym = nil
    guardOpen = false
    guardStart = tokSeq
    guardNeg = neg
    if neg { guardStart += 1 }
    let orBefore = orSeq
    let x = loadCond(expression())
    var gi = -1
    if guardSym != nil && guardFree == freeSeq {
        if !neg && orSeq == orBefore && (guardFollow == T_LBRACE || guardFollow == T_ANDAND) {
            for i in 0..len(originSyms) {
                if originSyms[i] == guardSym { gi = i }
            }
        }
        if neg && guardFollow == T_LBRACE {
            for i in 0..len(originSyms) {
                if originSyms[i] == guardSym { gi = i }
            }
        }
    }
    guardSym = nil
    guardStart = -10
    let flinks = falseJump(x)
    let mark = len(narrowStack)
    let s0 = snapshot()
    var d0 = deadSave()
    var dacc = deadSave()
    liveClear(&dacc)
    // the arm where h is known alive starts without its dead mark
    if gi >= 0 && !neg { narrowMark(&d0, gi) }
    var e0 = deadSave()
    if gi >= 0 && neg { narrowMark(&e0, gi) }
    pushNarrowings(x.nt)
    let t1 = armBlock(&d0, &dacc, false)
    let s1 = snapshot()
    restore(s0)
    truncate(narrowStack, mark)
    if sym == T_ELSE {
        next()
        let j = jmp()
        fixHere(flinks)
        pushNarrowings(x.nf)
        if gi >= 0 && neg && t1 { narrowMark(&dacc, gi) }
        let t2 = armBlock(&e0, &dacc, sym == T_IF)
        deadSet(&dacc)
        truncate(narrowStack, mark)
        fixHere1(j)
        let s2 = snapshot()
        if t1 && !t2 {
            restore(s2)
        } else if t2 && !t1 {
            restore(s1)
        } else if !t1 && !t2 {
            sameStates(s1, s2, iline, icol)
            joinSuspect(s1)
        }
        if t1 && !t2 {
            pushNarrowings(x.nf)
        } else if t2 && !t1 {
            pushNarrowings(x.nt)
        }
        return t1 && t2
    }
    fixHere(flinks)
    if gi >= 0 && neg && t1 { narrowMark(&dacc, gi) }
    liveJoin(&d0, &dacc)
    deadSet(&dacc)
    if !t1 {
        sameStates(s1, s0, iline, icol)
        joinSuspect(s1)
    }
    if t1 { pushNarrowings(x.nf) }
    return false
}

// entry: the state when the loop is entered; every iteration must end, and every break or continue
// happen, with the same moves. nOuter and selfBefore: the owned locals and the self-call count before
// the loop's condition (if any) and body, so that a self-call in either is seen by loopSelfCheck;
// useBefore: the reads so far, so that a read in the loop is seen by loopBindCheck
fn loopBodyV(entry: PState, line: int, col: int, lv: ?^Sym, nOuter: int, selfBefore: int, useBefore: int, logFrom: int): Loop

// a loop's end, where the state of its last iteration is checked against the one it began with
fn loopMoveError(d: ?^Sym, line: int, col: int) {
    if d != nil {
        errorAt("'" + d.name + "' is moved inside the loop; it must have a value again by the end of each iteration", line, col)
    }
}

fn loopBody(entry: PState, line: int, col: int, nOuter: int, selfBefore: int, useBefore: int, logFrom: int): Loop {
    return loopBodyV(entry, line, col, nil, nOuter, selfBefore, useBefore, logFrom)
}

// lv: a for loop's variable, rebound at the start of every iteration
// logFrom: the free log's length where the loop's condition or body begins (see applyExit)
fn loopBodyV(entry: PState, line: int, col: int, lv: ?^Sym, nOuter: int, selfBefore: int, useBefore: int, logFrom: int): Loop {
    let n = localsIn(entry)
    clearFresh()
    // the loop may run no time: what the marks were before it are marks after it too (narrowing clears marks)
    let dEntry = deadSave()
    append(loops, new Loop{brk: 0, cont: 0, blocks: len(blocks), entry: copyState(entry), lv: lv,
                           susp: neutralState(n), back: neutralState(n), exits: new []PState(0), exitAt: new []int(0),
                           conts: new []PState(0), contAt: new []int(0), logFrom: logFrom, useFrom: useBefore, exitDead: new []?^Sym(0)})
    let term = block()
    // the next iteration starts where the body ends, if it falls through, and at each continue, as the
    // continue is left (applyExit depends on the state the next iteration starts from, so this is repeated
    // until the state stops changing)
    let li = len(loops) - 1
    if !term {
        let now = snapshot()
        absorb(&loops[li].back, &now)
    }
    var back = copyState(&loops[li].back)
    var settled = false
    var round = 0
    while !settled && round < 4 {
        var next = copyState(&loops[li].back)
        for k in 0..len(loops[li].conts) {
            var x = copyState(loops[li].conts[k])
            applyExit(&x, &back, logFrom, loops[li].contAt[k])
            absorb(&next, &x)
        }
        settled = sameState(&next, &back)
        back = next
        round += 1
    }
    if !settled {
        errorAt("the references in this loop change too often to be checked; point them afresh in the loop", line, col)
    }
    // A change in the loop made while a reference was not pointed afresh may free what it points into on
    // the next iteration, where its binding is back's. hit: whether a change of the loop made while the
    // reference was not pointed afresh may free what back's binding points into. Where none does, the
    // carried marks are dropped: they were coarse (see markCarriedFreed).
    var hit = new []bool(n)
    for j in logFrom..len(freeLog) {
        let r = freeLog[j]
        for q in r.nfFrom..r.nfTo {
            let i = nonFreshLog[q]
            if i < n && !hit[i] && freeHits(ownedLocals[i], back.binds[i], r) { hit[i] = true }
        }
    }
    for i in 0..n {
        if !hit[i] { back.flags[3 * n + i] = false }
    }
    loopSelfCheck(nOuter, selfBefore, useBefore, &back, lv, line, col)
    loopBindCheck(&entry, &back, useBefore, lv, line, col, hit)
    loopCarryCheck(&back, useBefore, lv)
    // the states the loop is left in: each break, and each continue, with the frees on the way out. The
    // references a state moves are moved after the loop (outMoved)
    var susp = neutralState(n)
    var outMoved = new []bool(n)
    for k in 0..len(loops[li].exits) {
        var x = copyState(loops[li].exits[k])
        applyExit(&x, &back, logFrom, loops[li].exitAt[k])
        absorb(&susp, &x)
        for i in 0..n {
            if x.flags[i] { outMoved[i] = true }
        }
    }
    for k in 0..len(loops[li].conts) {
        var x = copyState(loops[li].conts[k])
        applyExit(&x, &back, logFrom, loops[li].contAt[k])
        // a continue ends an iteration, so what it moves must have a value again: as at the body's end
        loopMoveError(stateDiff(&entry, &x), line, col)
        absorb(&susp, &x)
        for i in 0..n {
            if x.flags[i] { outMoved[i] = true }
        }
    }
    // the loop's record leaves the stack; what break and continue collected comes back
    let res = new Loop{brk: loops[li].brk, cont: loops[li].cont, blocks: loops[li].blocks,
                       entry: copyState(entry), lv: lv, susp: susp, back: copyState(&back),
                       exits: new []PState(0), exitAt: new []int(0), conts: new []PState(0), contAt: new []int(0),
                       logFrom: logFrom, useFrom: 0, exitDead: new []?^Sym(0)}
    pendingFreeCheck(li)
    for i in 0..len(loops[li].exitDead) {
        if i < len(originDead) && loops[li].exitDead[i] != nil { originDead[i] = loops[li].exitDead[i] }
    }
    // a mark only grows along a path, so the marks of the loop's entry are those of the path that runs it no
    // time, which is one of the paths out: after the loop the owner is moved only if it was moved before it
    let em = len(dEntry) / 2
    for i in 0..em {
        if dEntry[i] != nil { originDead[i] = dEntry[i] }
        originLive[i] = dEntry[em + i]
    }
    truncate(loops, li)
    if lv != nil { lv.moved = false }
    if !term {
        let now = snapshot()
        loopMoveError(stateDiff(&entry, &now), line, col)
    }
    // the loop may run no time, or leave from its body: its suspicion, bindings and freshness are what
    // either carries. A body that always leaves carries none of its own, since its end is not reached.
    // A reference invalid where the next iteration starts stays invalid where the loop is left from the top
    // (a while condition, a for loop's test), and a break on a later pass sees it too
    if term { restore(&entry) } else { restoreMoved(&entry) }
    for i in 0..n {
        if outMoved[i] { ownedLocals[i].moved = true }
        if back.flags[i] && ownedLocals[i].isRefLocal { ownedLocals[i].moved = true }
    }
    joinSuspect(&entry)
    joinSuspect(&res.susp)
    joinBinds(&res.back)
    return res
}

// A while loop's condition is compiled where it is read, and its bytes are then moved after the body
// (loop inversion): `jmp cond; body: ...; cond: C; jcc body`. Moved by d, what they hold that is not
// relative moves with them: calls out (farCalls) are d further from their targets, calls waiting for a
// later function are d further on, and the condition's true and false lists thread positions through
// their rel32 fields. The checker has seen the condition once, where it is read.
fn shiftWaits(head: int, d: int): int {
    if head == 0 { return 0 }
    var at = head + d
    while getRel(at) != 0 {
        let nxt = getRel(at) + d
        putRel(at, nxt)
        at = nxt
    }
    return head + d
}

// Loop heads (the target of a backward jump) start on a LOOP_ALIGN boundary, padded with multi-byte nops.
// The code is at CODE_BASE, a multiple of 4096, so a position that is a multiple of LOOP_ALIGN is an address
// that is. The padding is never executed in an inverted loop (the jump over it goes to the test).
const LOOP_ALIGN = 32

fn alignLoop() {
    var n = (LOOP_ALIGN - (pc() & (LOOP_ALIGN - 1))) & (LOOP_ALIGN - 1)
    while n > 0 {
        var k = n
        if k > 9 { k = 9 }
        n -= k
        if k == 6 || k == 9 {
            emit(0x66)                          // 6 and 9 start with the operand-size prefix
        }
        if k == 2 {
            emit(0x66)
            emit(0x90)
        } else if k == 1 {
            emit(0x90)
        } else {
            emit(0x0F)
            emit(0x1F)
            if k == 3 {
                emit(0x00)
            } else if k == 4 {
                emit(0x40)
                emit(0x00)
            } else if k == 5 || k == 6 {
                emit(0x44)
                emit(0x00)
                emit(0x00)
            } else if k == 7 {
                emit(0x80)
                emit32(0)
            } else {
                emit(0x84)                      // 8 and 9
                emit(0x00)
                emit32(0)
            }
        }
    }
}

fn whileStat(): bool {
    let wline = tline
    let wcol = tcol
    next()
    let nOuter = len(ownedLocals)
    let selfBefore = selfCalls
    let useBefore = useSeq
    let savedMarks = loopMarksSave()
    loopLogStart()
    let logFrom = len(freeLog)
    clearFresh()
    let entry = snapshot()
    var top = pc()
    let farFrom = len(farCalls)
    let fwdFrom = fwdCalls
    let savedWhile = inWhileCond
    inWhileCond = true
    var x = expression()
    inWhileCond = savedWhile
    let forever = x.mode == "const" && x.typ.kind == "bool" && x.val == 1
    let liftFrom = len(lifted)               // this loop's part of lifted, waitFn and waitAt starts here
    let waitFrom = len(waitFn)
    var farTo = 0
    var jcond = 0
    if forever {
        if pc() == top {                     // nothing was emitted: the head is a backward jump's target too
            alignLoop()
            top = pc()
        }
        x = newItem("cond", tBool)
    } else {
        x = loadCond(x)
        for i in top..pc() { append(lifted, codeByte(i)) }
        truncCode(top)
        farTo = len(farCalls)
        if fwdCalls != fwdFrom {
            for g in 0..len(curModule.globals) {
                if curModule.globals[g].kind == "fn" && curModule.globals[g].addr < 0 {
                    let fr = curModule.globals[g].fnRec
                    while len(fr.fixups) > 0 && fr.fixups[len(fr.fixups) - 1] >= top {
                        append(waitFn, curModule.globals[g])
                        append(waitAt, fr.fixups[len(fr.fixups) - 1])
                        truncate(fr.fixups, len(fr.fixups) - 1)
                    }
                }
            }
            for mi in 0..len(methodSyms) {
                let m = methodSyms[mi]
                if m.owner == curModuleName && m.addr < 0 {
                    let fr = m.fnRec
                    while len(fr.fixups) > 0 && fr.fixups[len(fr.fixups) - 1] >= top {
                        append(waitFn, m)
                        append(waitAt, fr.fixups[len(fr.fixups) - 1])
                        truncate(fr.fixups, len(fr.fixups) - 1)
                    }
                }
            }
        }
        jcond = jmp()
    }
    alignLoop()
    let bodyAt = pc()
    let condSt = snapshot()                  // the state when the condition leaves the loop
    let condAt = len(freeLog)
    loopdepth += 1
    let mark = len(narrowStack)
    pushNarrowings(x.nt)
    let loop = loopBody(entry, wline, wcol, nOuter, selfBefore, useBefore, logFrom)
    // the condition's exit: the frees in the condition, and in the body before a break, are on the way out
    var cs = copyState(&condSt)
    applyExit(&cs, &loop.back, logFrom, condAt)
    for i in 0..localsIn(&cs) {
        if cs.flags[i] && !condSt.flags[i] { ownedLocals[i].moved = true }
    }
    joinSuspect(&cs)
    truncate(narrowStack, mark)
    loopdepth -= 1
    loopMarksJoin(savedMarks)
    loopLogEnd()
    if forever {
        fixTo(loop.cont, top)
        jmpTo(top)
        fixHere(loop.brk)
        return loop.brk == 0
    }
    // the condition goes after the body, and a continue goes to it
    let at = pc()
    let d = at - top
    fix(jcond, at)
    fixTo(loop.cont, at)
    for i in liftFrom..len(lifted) { emit(lifted[i]) }
    truncate(lifted, liftFrom)
    for k in farFrom..farTo {
        farCalls[k] += d
        putRel(farCalls[k], getRel(farCalls[k]) - d)
    }
    for k in waitFrom..len(waitFn) { append(waitFn[k].fnRec.fixups, waitAt[k] + d) }
    truncate(waitFn, waitFrom)
    truncate(waitAt, waitFrom)
    let tl = shiftWaits(x.T, d)
    let fl = shiftWaits(x.F, d)
    fix(jcc(x.cc), bodyAt)
    fixTo(tl, bodyAt)
    fixHere(fl)
    fixHere(loop.brk)
    return false
}

fn forStat() {
    let fline = tline
    let fcol = tcol
    next()
    let name = ident()
    noteDeclared(name)
    expect(T_IN, "")
    openBlock()
    let x = expression()
    var top = 0
    var exitLink = 0
    var savedMarks = new []bool(0)
    var loop = new Loop{brk: 0, cont: 0, blocks: 0, entry: emptyState(), susp: emptyState(), back: emptyState(),
                        exits: new []PState(0), exitAt: new []int(0), conts: new []PState(0), contAt: new []int(0),
                        logFrom: 0, useFrom: 0, exitDead: new []?^Sym(0)}
    if sym == T_DOTDOT {
        next()
        if x.typ.kind != "int" { error("range bounds must be ints") }
        let v = newLocal(name, tInt, "let")
        homeFor(v, name, true)
        let vi = localItem(v, tInt)
        store(vi, x)
        let y = expression()
        if y.typ.kind != "int" { error("range bounds must be ints") }
        let lim = newLocal("", tInt, "var")
        if v.home >= 0 {
            homeFor(lim, name, false)              // the limit follows the variable into a register
            if lim.home >= 0 { append(blocks[len(blocks) - 1].syms, lim) }       // so that the block's end frees it
        }
        let li = localItem(lim, tInt)
        store(li, y)
        exitLink = jmp()                        // to the test, after the body
        alignLoop()
        top = pc()
        loopdepth += 1
        savedMarks = loopMarksSave()
        loopLogStart()
        loop = loopBody(snapshot(), fline, fcol, len(ownedLocals), selfCalls, useSeq, len(freeLog))
        loopdepth -= 1
        fixHere(loop.cont)
        if v.home >= 0 {
            aluRI(0, v.home, 1)
            fixHere1(exitLink)
            if lim.home >= 0 {
                opReg(0x3B, v.home, lim.home, true, false)
            } else {
                opMem(0x3B, v.home, mem(RBP, -1, lim.offset, 8), true, false)
            }
        } else {
            aluMI(0, mem(RBP, -1, v.offset, 8), 1)
            fixHere1(exitLink)
            let r = alloc()
            opMem(0x8B, r, mem(RBP, -1, v.offset, 8), true, false)
            opMem(0x3B, r, mem(RBP, -1, lim.offset, 8), true, false)
            release(r)
        }
        fix(jcc(CC_L), top)
    } else {
        if x.typ.kind != "array" { error("cannot iterate over " + tname(x.typ)) }
        noTemp(x)
        let walked = x.sym
        if walked == nil || walked.storage != "local" {
            error("a for loop walks a local variable or parameter: borrow it first, for example let items = &p.items")
            return
        }
        let arr = newLocal("", x.typ, "var")
        let ai = newItem("mem", x.typ)
        ai.base = RBP
        ai.disp = arr.offset
        let xt = x.typ
        let wb = walkBind(x, walked)
        store(ai, x)
        let idx = newLocal("", tInt, "var")
        opMem(0xC7, 0, mem(RBP, -1, idx.offset, 8), true, false)
        emit32(0)
        let v = newLocal(name, baseOf(xt), "let")
        if isOwned(baseOf(xt)) {
            // each element is borrowed, not moved out
            v.isRef = true
            v.isRefLocal = true
            v.bind = wb
            v.fresh = true
            append(ownedLocals, v)
        }
        let strs = baseOf(xt).kind == "string"
        if strs {
            opMem(0xC7, 0, mem(RBP, -1, v.offset, 8), true, false)
            emit32(0)
            addStrLocal(v)
        }
        let vi = newItem("mem", baseOf(xt))
        vi.base = RBP
        vi.disp = v.offset
        exitLink = jmp()                        // to the test, after the body
        alignLoop()
        top = pc()
        let ri = alloc()
        let ra = alloc()
        opMem(0x8B, ri, mem(RBP, -1, idx.offset, 8), true, false)
        opMem(0x8B, ra, mem(RBP, -1, arr.offset, 8), true, false)
        if strs { rtCall1(RT_STR_DEC, dupItem(vi), tVoid) }  // drop the previous element
        opMem(0x8B, ra, mem(ra, -1, 16, 8), true, false)
        if baseOf(xt).kind == "byte" {
            opMem(0x0FB6, ri, mem(ra, ri, 8, 1), true, false)
        } else {
            opMem(0x8B, ri, mem(ra, ri, 8, 8), true, false)
        }
        opMem(0x89, ri, mem(RBP, -1, v.offset, 8), true, false)
        release(ri)
        release(ra)
        if strs {
            let held = rtCall1(RT_STR_INC, dupItem(vi), tString)   // and hold the new one
            release(held.r)
        }
        loopdepth += 1
        savedMarks = loopMarksSave()
        loopLogStart()
        let wasIterating = walked.iterating
        walked.iterating = true
        let walkUse = useSeq
        if walked.isRefLocal {                  // the walk reads its array on every iteration
            useSeq += 1
            walked.usedAt = useSeq
        }
        loop = loopBodyV(snapshot(), fline, fcol, v, len(ownedLocals), selfCalls, walkUse, len(freeLog))
        walked.iterating = wasIterating
        loopdepth -= 1
        fixHere(loop.cont)
        aluMI(0, mem(RBP, -1, idx.offset, 8), 1)
        fixHere1(exitLink)
        let ti = alloc()
        let ta = alloc()
        opMem(0x8B, ti, mem(RBP, -1, idx.offset, 8), true, false)
        opMem(0x8B, ta, mem(RBP, -1, arr.offset, 8), true, false)
        opMem(0x3B, ti, mem(ta, -1, 0, 8), true, false)
        release(ti)
        release(ta)
        fix(jcc(CC_L), top)
    }
    fixHere(loop.brk)
    loopMarksJoin(savedMarks)
    loopLogEnd()
    closeBlock(false)
}

// match on an int or byte: arms are lists of constants, with an optional else.
// The subject is evaluated once; the statement terminates only with an else.
// the line for errors reported at the current token
fn line0(): int { return 0 }

fn intMatch(x: Item): bool {
    let slot = newLocal("", tInt, "var")
    let si = newItem("mem", tInt)
    si.base = RBP
    si.disp = slot.offset
    store(si, x)
    let mline = tline
    let mcol = tcol
    let s0 = snapshot()
    var acc = copyState(s0)
    var have = false
    let d0 = deadSave()
    var dacc = deadSave()
    liveClear(&dacc)
    expect(T_LBRACE, "")
    skipSemis()
    let seen = new []int(0)
    var ends = 0
    var allTerm = true
    var hasElse = false
    while sym != T_RBRACE {
        if sym == T_ELSE {
            next()
            hasElse = true
            restore(s0)
            let bt = armBlock(&d0, &dacc, false)
            allTerm = allTerm && bt
            if !bt {
                let st = snapshot()
                if have { sameStates(acc, st, line0(), 0); acc = joinStates(acc, st) } else { acc = copyState(st) }
                have = true
            }
            skipSemis()
            if sym != T_RBRACE { error("'else' must be the last arm") }
            break
        }
        var toBody = 0
        var nxt = 0
        while true {
            let v = expression()
            if v.mode != "const" || !isInt(v.typ) { error("match arms need constant ints or bytes") }
            if containsInt(seen, v.val) { error("value " + string(v.val) + " is matched twice") }
            append(seen, v.val)
            if fits32(v.val) {
                aluMI(7, mem(RBP, -1, slot.offset, 8), v.val)
            } else {
                let r = alloc()
                movRI(r, v.val)
                opMem(0x3B, r, mem(RBP, -1, slot.offset, 8), true, false)
                release(r)
            }
            if sym != T_COMMA {
                nxt = jcc(CC_NE)
                break
            }
            next()
            toBody = waitJump(toBody, jcc(CC_E))
        }
        fixHere(toBody)
        restore(s0)
        let bt = armBlock(&d0, &dacc, false)
        allTerm = allTerm && bt
        if !bt {
            let st = snapshot()
            if have { sameStates(acc, st, line0(), 0); acc = joinStates(acc, st) } else { acc = copyState(st) }
            have = true
        }
        ends = waitJump(ends, jmp())
        fixHere1(nxt)
        skipSemis()
    }
    expect(T_RBRACE, "")
    if !hasElse {
        if have { sameStates(acc, s0, mline, mcol); acc = joinStates(acc, s0) } else { acc = copyState(s0) }
        have = true
        liveJoin(&d0, &dacc)
    }
    if have { restore(acc) } else { restore(s0) }
    deadSet(&dacc)
    fixHere(ends)
    return allTerm && hasElse
}

// whether the match whose '{' is the current token is the consuming form: its first arm's variant name
// is followed by '('. This lookahead, and nothing else, runs before the first tag compare; the scanner
// is left exactly as it was (the indexHasCall pattern).
fn matchBindsFirst(): bool {
    let mbPos = pos
    let mbLine = line
    let mbCol = col
    let mbLast = last
    let mbSym = sym
    let mbSval = sval
    let mbIval = ival
    let mbTline = tline
    let mbTcol = tcol
    let mbSeq = tokSeq
    var binds = false
    if sym == T_LBRACE {
        next()
        skipSemis()
        if sym == T_IDENT {
            next()
            binds = sym == T_LPAREN
        }
    }
    pos = mbPos
    line = mbLine
    col = mbCol
    last = mbLast
    sym = mbSym
    sval = mbSval
    ival = mbIval
    tline = mbTline
    tcol = mbTcol
    tokSeq = mbSeq
    return binds
}

// One arm of a consuming match. After this arm's tag compare, the cell parked in the stack slot is
// emptied into fresh locals declared in the arm's own block (so its exit, or runDefers on an early
// exit, frees them) and the shell is freed. The err message is an ordinary isStr local: the cell's
// reference is transferred to it, not copied.
fn consumeArm(d0: &[]?^Sym, mut acc: &[]?^Sym, slot: int, rt: ^Type, v: ^Type, b1: string, b2: string): bool {
    deadSet(d0)
    let js = jumpsHere()
    expect(T_LBRACE, "")
    openBlock()
    let pm = len(pendSym)
    let cs = contSeq
    let bs = brkSeq
    let ev = errVariantType()
    if v == ev {
        let ml = newLocal(b1, tString, "var")
        let cl = newLocal(b2, tInt, "var")
        addStrLocal(ml)
        let cellr = alloc()
        opMem(0x8B, cellr, mem(RBP, -1, slot, 8), true, false)
        let r1 = alloc()
        opMem(0x8B, r1, mem(cellr, -1, 0, 8), true, false)
        opMem(0x89, r1, mem(RBP, -1, ml.offset, 8), true, false)
        release(r1)
        let r2 = alloc()
        opMem(0x8B, r2, mem(cellr, -1, 8, 8), true, false)
        opMem(0x89, r2, mem(RBP, -1, cl.offset, 8), true, false)
        release(r2)
        opMem(0xC7, 0, mem(cellr, -1, 0, 8), true, false)      // the message reference is the local's now
        emit32(0)
        rtCall1(RT_FREE, makeReg(rt, cellr), tVoid)
    } else {
        let pt = v.fields[0].typ
        let pl = newLocal(b1, pt, "var")
        if isOwned(pt) { addOwnedLocal(pl) }
        if pt.kind == "string" { addStrLocal(pl) }
        let cellr = alloc()
        opMem(0x8B, cellr, mem(RBP, -1, slot, 8), true, false)
        let r1 = alloc()
        opMem(0x8B, r1, mem(cellr, -1, 0, 8), true, false)
        opMem(0x89, r1, mem(RBP, -1, pl.offset, 8), true, false)
        release(r1)
        opMem(0xC7, 0, mem(cellr, -1, 0, 8), true, false)      // the payload is the local's now
        emit32(0)
        rtCall1(RT_FREE, makeReg(rt, cellr), tVoid)
    }
    let term = statSeq()
    if term { pendBlockEnds(pm, cs, bs) }
    expect(T_RBRACE, "")
    closeBlock(term)
    return armTail(acc, js, term)
}

fn matchStat(): bool {
    next()
    let line = tline
    let col = tcol
    let x = expression()
    if isInt(x.typ) { return intMatch(x) }
    let t = x.typ
    if t.kind != "closed" && t.kind != "opt" && t.kind != "result" && !t.incomplete {
        errorAt("match needs an int, byte, closed type or Result, not " + tname(t), line, col)
    }
    let xs = x.sym
    if x.mode != "mem" || xs == nil || (xs.kind != "var" && xs.kind != "let") || xs.storage != "local" {
        errorAt("match needs a local variable or parameter", line, col)
        return false
    }
    let s = xs
    let name = s.name
    if t.kind == "opt" { errorAt("'" + name + "' may be nil: check it with '!= nil' first", line, col) }
    if t.incomplete { errorAt(tname(t) + " is declared but not yet defined", line, col) }
    var consuming = false
    if t.kind == "result" { consuming = matchBindsFirst() }
    var slotOff = 0
    if consuming {
        if s.isRef || s.isRefLocal { errorAt("a consuming match needs the Result itself, not a reference", line, col) }
        if !s.owned { errorAt("a consuming match needs a local variable or parameter holding an owned Result", line, col) }
        let c0 = alloc()
        opMem(0x8B, c0, mem(RBP, -1, s.offset, 8), true, false)      // the slot still holds the cell
        let slot = newLocal("", t, "var")
        slotOff = slot.offset
        opMem(0x89, c0, mem(RBP, -1, slotOff, 8), true, false)
        release(c0)
        consume(x)                     // BEFORE the snapshot: every arm's restore must keep the move
    }
    let tag = newLocal("", tInt, "var")
    let s0 = snapshot()
    var acc = copyState(s0)
    var have = false
    let d0 = deadSave()
    var dacc = deadSave()
    liveClear(&dacc)
    let r = alloc()
    if consuming {
        opMem(0x8B, r, mem(RBP, -1, slotOff, 8), true, false)
    } else {
        opMem(0x8B, r, mem(RBP, -1, s.offset, 8), true, false)
    }
    opMem(0x8B, r, mem(r, -1, -16, 8), false, false)          // the tag; the high half is a generation
    opMem(0x89, r, mem(RBP, -1, tag.offset, 8), true, false)
    release(r)
    expect(T_LBRACE, "")
    skipSemis()
    let seen = new []^Type(0)
    var ends = 0
    var allTerm = true
    var hasElse = false
    while sym != T_RBRACE {
        if sym == T_ELSE {
            if t.kind == "result" { errorAt("a Result match names the ok and err arms; 'else' is not needed", tline, tcol) }
            next()
            hasElse = true
            restore(s0)
            let bt = armBlock(&d0, &dacc, false)
            allTerm = allTerm && bt
            if !bt {
                let st = snapshot()
                if have { sameStates(acc, st, line0(), 0); acc = joinStates(acc, st) } else { acc = copyState(st) }
                have = true
            }
            skipSemis()
            if sym != T_RBRACE { error("'else' must be the last arm") }
            break
        }
        let vname = ident()
        if sym == T_COLONCOLON {
            next()
            var bare = vname
            if sym == T_IDENT { bare = sval }
            errorAt("match arms name a variant without its module: write " + bare, tline, tcol)
        }
        var v: ?^Type = nil
        let vs = &t.variants
        for c in vs {
            if v == nil && c.name == vname { v = c }
        }
        if v == nil {
            error("'" + vname + "' is not a variant of " + tname(t))
            return false
        }
        var b1 = ""
        var b2 = ""
        if consuming {
            if sym != T_LPAREN { errorAt("a consuming match binds its value in every arm: write ok(v) and err(m, c)", tline, tcol) }
            next()
            if sym != T_IDENT { error("expected a binding name after '('") }
            b1 = ident()
            if v == errVariantType() {
                expect(T_COMMA, "")
                if sym != T_IDENT { error("expected a binding name for the code") }
                b2 = ident()
            }
            expect(T_RPAREN, "")
        } else if t.kind == "result" && sym == T_LPAREN {
            errorAt("a consuming match binds its value in every arm: write ok(v) and err(m, c)", tline, tcol)
        }
        for c in seen {
            if c == v { error("'" + vname + "' is matched twice") }
        }
        append(seen, v)
        aluMI(7, mem(RBP, -1, tag.offset, 8), v.desc)
        let nxt = jcc(CC_NE)
        let mark = len(narrowStack)
        if !consuming { append(narrowStack, new NEntry{sym: s, typ: v, depth: loopdepth, alive: true}) }
        restore(s0)
        var bt = false
        if consuming {
            bt = consumeArm(&d0, &dacc, slotOff, t, v, b1, b2)
        } else {
            bt = armBlock(&d0, &dacc, false)
        }
        allTerm = allTerm && bt
        if !bt {
            let st = snapshot()
            if have { sameStates(acc, st, line0(), 0); acc = joinStates(acc, st) } else { acc = copyState(st) }
            have = true
        }
        if !consuming { truncate(narrowStack, mark) }
        ends = waitJump(ends, jmp())
        fixHere1(nxt)
        skipSemis()
    }
    expect(T_RBRACE, "")
    var missing = ""
    let vs = &t.variants
    for c in vs {
        var found = false
        for d in seen {
            if d == c { found = true }
        }
        if !found {
            if len(missing) > 0 { missing = missing + ", " }
            missing = missing + c.name
        }
    }
    if len(missing) > 0 && !hasElse { errorAt("match on " + tname(t) + " is missing " + missing, line, col) }
    if have { restore(acc) } else { restore(s0) }
    deadSet(&dacc)
    fixHere(ends)
    return allTerm
}

fn returnStat() {
    next()
    if inDefer { error("cannot return from inside defer") }
    let f = curFn
    if f == nil { return }
    var active = false
    for i in fnBlock..len(blocks) {
        if len(blocks[i].defers) > 0 { active = true }
    }
    if f.ret == tVoid {
        if sym != T_SEMI && sym != T_RBRACE {
            if f.kind == "lambda" { error("a lambda that returns a value needs a return type") }
            error(callableName(f) + " does not return a value")
        }
        runDefers(fnBlock)
    } else {
        var x0 = expression()
        checkAssign(f.ret, x0, "return value")
        consume(x0)
        let x = asReg(x0)
        for k in blocks[fnBlock].omark..len(ownedLocals) {
            if !ownedLocals[k].moved { active = true }
        }
        if active {
            let slot = newLocal("", f.ret, "var")
            opMem(0x89, x.r, mem(RBP, -1, slot.offset, 8), true, false)
            release(x.r)
            runDefers(fnBlock)
            opMem(0x8B, RAX, mem(RBP, -1, slot.offset, 8), true, false)
        } else {
            movRR(RAX, x.r)
            release(x.r)
        }
    }
    epilogue()
}

// The deferred statement is compiled out of line as a local subroutine,
// called at every exit from the enclosing block.
fn deferStat() {
    next()
    let over = jmp()
    let entry = pc()
    let before = snapshot()
    let deadBefore = deadSave()
    let useAt = useSeq
    let nHandles = len(originSyms)
    let logAt = len(freeLog)
    let savedDepth = depth
    let savedNarrow = replace(narrowStack, new []NEntry(0))   // fresh stacks for the deferred code
    let savedLoops = replace(loops, new []Loop(0))
    let savedInDefer = inDefer
    let savedMark = deferMark
    let savedFrees = replace(deferFrees, new []^Sym(0))
    let savedEvs = replace(deferFreeEv, new []string(0))
    let savedUses = replace(deferUses, new []bool(len(ownedLocals)))
    deferMark = len(ownedLocals)
    depth = depth + 8
    inDefer = true
    if sym == T_LBRACE {
        block()
    } else {
        openBlock()
        statement()
        closeBlock(false)
    }
    emit(0xC3)
    depth = savedDepth
    narrowStack = savedNarrow
    loops = savedLoops
    inDefer = savedInDefer
    deferMark = savedMark
    let uses = replace(deferUses, savedUses)
    let owners = replace(deferFrees, savedFrees)
    let evs = replace(deferFreeEv, savedEvs)
    fixHere1(over)
    // the body runs where the block is left, not here: what it did to suspicion is taken back (its
    // re-points have not happened yet either), and callDefers applies its recursive calls at each exit
    restoreDeferred(&before)
    deadSet(&deadBefore)
    for i in 0..len(owners) {
        append(dfBlock, len(blocks) - 1)
        append(dfIndex, len(blocks[len(blocks) - 1].defers))
        append(dfOwner, owners[i])
        append(dfEv, evs[i])
    }
    // the handles the body named run where the block is left: a later free of their owners is refused (originFree)
    for i in 0..nHandles {
        if originSyms[i].usedAt > useAt {
            append(deferH, originSyms[i])
            append(deferAt, len(blocks) - 1)
        }
    }
    // the body's frees happen where its block is left, not here: a reference is not moved by them where the
    // body is declared, and they are kept with the block, to be replayed there (see callDefers)
    let last = len(blocks) - 1
    for i in 0..localsIn(&before) {
        if ownedLocals[i].isRefLocal { ownedLocals[i].moved = before.flags[i] }
    }
    append(blocks[last].freeFrom, len(blocks[last].frees))
    for i in logAt..len(freeLog) { append(blocks[last].frees, freeLog[i]) }
    truncate(freeLog, logAt)
    // the outer reference locals the body used, with their bindings here; an enclosing defer body uses them too
    append(blocks[last].useFrom, len(blocks[last].uses))
    for i in 0..len(uses) {
        if uses[i] {
            append(blocks[last].uses, ownedLocals[i])
            append(blocks[last].useBinds, before.binds[i])
            if i < len(deferUses) { deferUses[i] = true }
        }
    }
    append(blocks[last].defers, entry)
}

fn statement(): bool {
    let k = sym
    match k {
        T_VAR, T_LET {
            next()
            varDecl(tokName(k), false, false)
        }
        T_IDENT { return assignmentOrCall() }
        T_TRY {
            let tl = tline
            let tc = tcol
            let x = tailExpr()
            discardValue(x, tl, tc)
        }
        T_IF { return ifStat() }
        T_WHILE { return whileStat() }
        T_FOR { forStat() }
        T_MATCH { return matchStat() }
        T_RETURN {
            returnStat()
            return true
        }
        T_BREAK, T_CONTINUE {
            next()
            if len(loops) > 0 { addJump() }
            if k == T_BREAK { brkSeq += 1 } else { contSeq += 1 }
            if len(loops) == 0 { error("'" + tokName(k) + "' outside a loop") }
            let loop = &loops[len(loops) - 1]
            let st = snapshot()
            let lv = loop.lv
            if lv != nil {
                for q in 0..len(ownedLocals) {
                    if ownedLocals[q] == lv { st.flags[q] = false }      // rebound next time round
                }
            }
            let d = stateDiff(loop.entry, st)
            if d != nil {
                error("'" + d.name + "' is moved inside the loop; it must have a value again before " + tokName(k))
            }
            let downTo = loop.blocks
            runDefers(downTo)
            // the state this exit carries, after the deferred calls that run here
            let now = snapshot()
            let lp = &loops[len(loops) - 1]
            // joined where the loop is left, once the frees on the way out are known (see loopBodyV)
            if k == T_CONTINUE {
                append(lp.conts, now)
                append(lp.contAt, len(freeLog))
            } else {
                append(lp.exits, now)
                append(lp.exitAt, len(freeLog))
            }
            let cur = &loops[len(loops) - 1]               // runDefers might have freed: borrow again
            if k == T_BREAK {
                cur.brk = waitJump(cur.brk, jmp())
            } else {
                cur.cont = waitJump(cur.cont, jmp())
            }
            return true
        }
        T_DEFER { deferStat() }
        T_PUB { error("'pub' is only allowed on top-level declarations") }
        T_LBRACE { return block() }
        else { error("expected a statement") }
    }
    return false
}

// =========================================================== declarations

// A function with no locals needs no 'sub rsp'. Its seven bytes (the frame size is at 'at') are not cut out, because
// that would move the body, and with it every loop head the alignment padding placed: the entry moves instead.
// The four bytes of 'push rbp; mov rbp, rsp' are rewritten 7 bytes further on, right before the body, and the seven
// bytes in front of them are dead (int3). f.addr is the new entry, so the calls that were aimed at the old one are
// repointed: the calls waiting for it (its fixups) and its calls to itself (in farCalls, with the old target).
// Every other call out of the body is relative to a place that did not move.
fn dropFrame(at: int, f: ^Sym) {
    let old = at - 7
    for i in 0..7 { setCode(old + i, 0xCC) }
    setCode(old + 7, 0x55)
    setCode(old + 8, 0x48)
    setCode(old + 9, 0x89)
    setCode(old + 10, 0xE5)
    f.addr = old + 7
    let calls = &farCalls
    for p in calls {
        if ((p + 4 + getRel(p)) & 0xFFFFFFFF) == old { fix(p, f.addr) }   // getRel is unsigned
    }
    for fi in 0..len(f.fnRec.fixups) { fix(f.fnRec.fixups[fi], f.addr) }
}

// ---- the pre-scan of a function

let callExempt = words("if while for return match defer in else new print println eprint eprintln len gc gcstats exit append truncate substr readFile writeFile args openFile readFd writeFd closeFile readDirFd statPath lstatPath readLinkPath isatty getenv terminalWidth sleepMs stdin stdout stderr take handle alive drop replace int byte string ok err try cinterop")

fn wordAt(a: int, b: int, w: string): bool {
    if len(w) != b - a { return false }
    for j in 0..len(w) {
        if src[a + j] != w[j] { return false }
    }
    return true
}

fn skipBlank(from: int): int {
    var q = from
    while q < len(src) && (src[q] == ' ' || src[q] == '\t') { q += 1 }
    return q
}

fn weight(depth: int): int {
    if depth > 3 { return 512 }
    return 1 << (3 * depth)
}

fn addScanned(a: int, b: int): int {
    append(scanAt, len(scanBytes))
    append(scanLen, b - a)
    for j in a..b { append(scanBytes, src[j]) }
    append(scanScore, 0)
    append(scanPend, false)
    return len(scanAt) - 1
}

// whether the name just read, ending at `from`, may be an int or bool local (decl 1: after var or let; 2: after
// for): by its type if it has one, else by where its value starts. A guess: a wrong one only costs a register
// kept back, or lost, in the ranking. The declaration itself decides, with the real type.
fn plausible(decl: int, from: int): bool {
    var q = skipBlank(from)
    if decl == 2 {
        while q + 1 < len(src) && src[q] != '{' && src[q] != '\n' {
            if src[q] == '.' && src[q + 1] == '.' { return true }      // a range; walking an array keeps its element in memory
            q += 1
        }
        return false
    }
    if q >= len(src) { return false }
    if src[q] == ':' {
        q = skipBlank(q + 1)
        var e = q
        while e < len(src) && (isLetter(src[e]) || isDigit(src[e])) { e += 1 }
        return wordAt(q, e, "int") || wordAt(q, e, "bool")
    }
    if src[q] != '=' { return false }
    q = skipBlank(q + 1)
    if q >= len(src) { return false }
    let c = src[q]
    if c == '"' || c == '&' || c == '[' { return false }
    if isLetter(c) {
        var e = q
        while e < len(src) && (isLetter(src[e]) || isDigit(src[e])) { e += 1 }
        if wordAt(q, e, "new") || wordAt(q, e, "string") || wordAt(q, e, "args") || wordAt(q, e, "readFile") { return false }
        if wordAt(q, e, "substr") || wordAt(q, e, "take") || wordAt(q, e, "replace") || wordAt(q, e, "handle") { return false }
        if wordAt(q, e, "ok") || wordAt(q, e, "err") || wordAt(q, e, "try") { return false }
        if wordAt(q, e, "openFile") || wordAt(q, e, "readFd") || wordAt(q, e, "writeFd") { return false }
        if wordAt(q, e, "closeFile") || wordAt(q, e, "readDirFd") { return false }
        if wordAt(q, e, "statPath") || wordAt(q, e, "lstatPath") || wordAt(q, e, "readLinkPath") { return false }
        if wordAt(q, e, "getenv") { return false }        // ?[]byte, not a scalar; isatty's bool is a safe guess
        if wordAt(q, e, "stdin") || wordAt(q, e, "stdout") || wordAt(q, e, "stderr") { return false }
        if wordAt(q, e, "nil") { return false }
    }
    return true
}

// a line that ends in this goes on in the next
fn contChar(c: int): bool {
    return c == '+' || c == '-' || c == '*' || c == '/' || c == '%' || c == '&' || c == '|' || c == '^' ||
           c == '<' || c == '>' || c == '=' || c == '!' || c == ',' || c == '.'
}

fn callAt(from: int): bool {
    let q = skipBlank(from)
    return q < len(src) && src[q] == '('
}

fn exemptCall(a: int, b: int): bool {
    let ws = &callExempt
    for w in ws {
        if wordAt(a, b, w) { return true }
    }
    return false
}

// Reads the body of the function about to be compiled, from the current token (its '{') on, as raw text and
// without the scanner's state: the int and bool parameters and the locals it declares, with the uses of each
// weighted 1, 8, 64 or 512 by how many loops it is in (the header of a while or for counts as inside),
// and the calls it makes to the program's own functions, weighted the same way. Nothing here is
// checked; whatever is wrong in the text is for the compiler to report where it reaches it.
fn scanFunction(params: &[]Param) {
    truncate(scanBytes, 0)
    truncate(scanAt, 0)
    truncate(scanLen, 0)
    truncate(scanScore, 0)
    truncate(scanPend, 0)
    scanCalls = 0
    homeCap = 0
    if REG_HOMES == 0 { return }
    for i in 0..len(params) {
        let k = params[i].typ.kind
        if params[i].mode == 0 && (k == "int" || k == "bool") {
            let nm = params[i].name
            for j in 0..len(nm) { append(scanBytes, nm[j]) }
            append(scanAt, len(scanBytes) - len(nm))
            append(scanLen, len(nm))
            append(scanScore, 0)
            append(scanPend, true)
        }
    }
    let n = len(src)
    var p = pos
    var depth = 1
    let braces = new []int(0)             // for each brace open in the body: 1 if it opens a loop's body, 2 a record literal's, else 0
    var nest = 0                          // the parentheses, brackets and record literals open now
    var nestMax = 0                       // and the most registers a statement may hold at once (see below)
    let parens = new []int(0)             // per open parenthesis or bracket: the commas so far if it is a builtin's argument list, else -1
    var totalCommas = 0                   // the earlier arguments of the builtin calls open now: each is held in a register
    var lhsCount = 0                      // the '[' and '.' left of the assignment operator: a destination holds a base and an index
    var held = 0                          // the registers the destination of this statement holds while its value is computed
    var seenAssign = false
    var inDecl = false                    // the statement is a var or let: its '[' are in a type
    var lastA = -1                        // the word just read, if the last token
    var prevCh = 0                        // the first character of the last token, comments apart
    var lastB = -1
    var prevNew = false                   // the word just read was `new`
    var afterNew = false                  // the word just read names the type of a record literal
    var loopDepth = 0
    var header = false                    // between a while or for and its '{'
    var decl = 0                          // 1 after var or let, 2 after for: the next word is the name declared
    while p < n && depth > 0 {
        let c = src[p]
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
            if c == '\n' && nest == 0 && !contChar(prevCh) {
                lhsCount = 0
                held = 0
                seenAssign = false
                inDecl = false
            }
            p += 1
            continue
        }
        if !(c == '/' && p + 1 < n && src[p + 1] == '/') { prevCh = c }
        let la = lastA
        let lb = lastB
        lastA = -1
        let wasNew = afterNew
        afterNew = false
        let newWord = prevNew
        prevNew = false
        if c == '/' && p + 1 < n && src[p + 1] == '/' {
            while p < n && src[p] != '\n' { p += 1 }
            afterNew = wasNew
            prevNew = newWord
        } else if c == '"' {
            p += 1
            while p < n && src[p] != '"' && src[p] != '\n' {
                if src[p] == '\\' { p += 1 }
                p += 1
            }
            p += 1
        } else if c == '\'' {
            p += 1
            if p < n && src[p] == '\\' { p += 2 } else { p += 1 }
            if p < n && src[p] == '\'' { p += 1 }
        } else if isLetter(c) {
            let a = p
            while p < n && (isLetter(src[p]) || isDigit(src[p])) { p += 1 }
            var d = loopDepth
            if header { d += 1 }
            let w = weight(d)
            if wordAt(a, p, "new") {
                prevNew = true
            } else if newWord {
                afterNew = true
            }
            lastA = a
            lastB = p
            if wordAt(a, p, "var") || wordAt(a, p, "let") {
                decl = 1
                inDecl = true
            } else if wordAt(a, p, "for") {
                decl = 2
                header = true
            } else if wordAt(a, p, "while") {
                header = true
            } else if decl > 0 {
                var k = findScanned(a, p)
                let known = k >= 0
                if !known { k = addScanned(a, p) }
                let ok = plausible(decl, p)
                if !known || ok { scanPend[k] = ok }
                scanScore[k] += w
                decl = 0
            } else {
                let k = findScanned(a, p)
                if k >= 0 {
                    scanScore[k] += w
                } else if callAt(p) && !exemptCall(a, p) {
                    scanCalls += w
                }
            }
        } else if isDigit(c) {
            while p < n && (isLetter(src[p]) || isDigit(src[p])) { p += 1 }
        } else if c == '(' || c == '[' {
            nest += 1
            if c == '[' && !seenAssign && !inDecl { lhsCount += 1 }
            if c == '(' && la >= 0 && exemptCall(la, lb) { append(parens, 0) } else { append(parens, -1) }
            let eff = nest + held + totalCommas
            if eff > nestMax { nestMax = eff }
            p += 1
        } else if c == ')' || c == ']' {
            if nest > 0 { nest -= 1 }
            if len(parens) > 0 {
                if parens[len(parens) - 1] > 0 { totalCommas -= parens[len(parens) - 1] }
                truncate(parens, len(parens) - 1)
            }
            p += 1
        } else if c == ',' {
            if len(parens) > 0 && parens[len(parens) - 1] >= 0 {
                parens[len(parens) - 1] += 1
                totalCommas += 1
                let eff = nest + held + totalCommas
                if eff > nestMax { nestMax = eff }
            }
            p += 1
        } else if c == ';' {
            lhsCount = 0
            held = 0
            seenAssign = false
            inDecl = false
            p += 1
        } else if c == '.' {
            if !seenAssign && !inDecl && p + 1 < n && src[p + 1] != '.' && p > 0 && src[p - 1] != '.' { lhsCount += 1 }
            p += 1
        } else if c == '=' {
            if p + 1 < n && src[p + 1] == '=' {
                p += 2
            } else {
                var plain = true
                if p > 0 && (src[p - 1] == '!' || src[p - 1] == '<' || src[p - 1] == '>') { plain = false }
                if plain && nest == 0 && !seenAssign {
                    seenAssign = true
                    held = 2 * lhsCount
                    let eff = nest + held + totalCommas
                    if eff > nestMax { nestMax = eff }
                }
                p += 1
            }
        } else if c == ':' {
            // `new lib::Node{...}`: the `::` is part of the type name, so the member word after it is
            // still the type a record literal names. Treating the `::` like `new` keeps afterNew set
            // through the member word, so the `{` is counted as a record literal (kind 2).
            if p + 1 < n && src[p + 1] == ':' && wasNew {
                prevNew = true
                p += 2
            } else {
                p += 1
            }
        } else if c == '{' {
            depth += 1
            var kind = 0
            if header {
                kind = 1
                loopDepth += 1
            } else if wasNew {
                kind = 2
                nest += 1
                let eff = nest + held + totalCommas
                if eff > nestMax { nestMax = eff }
            }
            if kind != 2 {
                lhsCount = 0
                held = 0
                seenAssign = false
                inDecl = false
            }
            append(braces, kind)
            header = false
            p += 1
        } else if c == '}' {
            depth -= 1
            if len(braces) > 0 {
                let kind = braces[len(braces) - 1]
                if kind == 1 { loopDepth -= 1 }
                if kind == 2 && nest > 0 { nest -= 1 }
                if kind != 2 {
                    lhsCount = 0
                    held = 0
                    seenAssign = false
                    inDecl = false
                }
                truncate(braces, len(braces) - 1)
            }
            p += 1
        } else {
            p += 1
        }
    }
    // what a statement holds in registers at once: its destination's base and index (held), the earlier
    // arguments of the builtin calls open (totalCommas) and the operands waiting in the expression (nest);
    // two more are in use at the innermost operation. The pool has nine registers.
    homeCap = 7 - nestMax
    if homeCap > REG_HOMES { homeCap = REG_HOMES }
    if homeCap < 0 { homeCap = 0 }
}

// Compiles the body of the function f, its heading read and its '{' the current token. homes is whether its int
// and bool locals may be held in registers. True if it ran out of registers with some (see giveUpHomes): nothing
// has been left but its code, to be thrown away.
fn fnBody(f: ^Sym, name: string, ret: ^Type, params: &[]Param, homes: bool): bool {
    homeBits = 0
    setFree(0)                          // the registers in pool order: a function starts as the one before it did not leave them
    pendLine = 0
    frame = 0
    depth = 0
    truncate(farCalls, 0)
    if homes {
        scanFunction(params)
    } else {
        homeCap = 0
    }
    emit(0x55)
    emit(0x48)
    emit(0x89)
    emit(0xE5)
    emit(0x48)
    emit(0x81)
    emit(0xEC)
    let frameAt = pc()
    emit32(0)
    let bindMark = len(bindArena)
    let symMark = len(symArena)                 // the function's own symbols start here
    let tempMark = len(argTemps)                // and the argument holders made for it
    openBlock()
    fnBlock = len(blocks) - 1
    let n = len(params)
    for i in 0..n {
        let s = newSym("var", params[i].name, params[i].typ)
        s.storage = "local"
        s.isParam = true
        s.offset = 16 + 8 * (n - 1 - i)
        declare(s)
        if params[i].mode > 0 {
            s.isRef = true                         // borrowed: not freed here
            s.bind = singleBind(s, false, "", params[i].mode == 2, nil)
            s.kind = "let"
        } else if isOwned(params[i].typ) {
            addOwnedLocal(s)
        }
        if params[i].typ.kind == "string" { addStrLocal(s) }
        if params[i].mode == 0 && (params[i].typ.kind == "int" || params[i].typ.kind == "bool") {
            let h = pickHome(params[i].name, true)
            if h >= 0 {
                s.home = h
                opMem(0x8B, h, mem(RBP, -1, s.offset, 8), true, false)      // the argument, from the stack
            }
        }
    }
    expect(T_LBRACE, "")
    openBlock()
    let term = statSeq()
    expect(T_RBRACE, "")
    if !term && ret != tVoid { error(name + " must return a value on every path") }
    closeBlock(term)
    closeBlock(term)
    homeBits = 0
    if homeRetry {
        truncate(bindArena, bindMark)
        truncate(argTemps, tempMark)
        truncate(symArena, symMark)
        return true
    }
    if !term { epilogue() }
    let size = (frame + 15) & ~15
    if size == 0 {
        dropFrame(frameAt, f)
    } else {
        putRel(frameAt, size)
    }
    if pendLine > 0 && f.writesHandles { errorAt(pendMsg, pendLine, pendCol) }
    pendLine = 0
    curFn = nil
    truncate(bindArena, bindMark)
    truncate(argTemps, tempMark)
    truncate(symArena, symMark)                 // and nothing refers to them any more
    return false
}


// The hidden lambda body. It mirrors fnBody's prologue/parameter/body/epilogue skeleton but never
// releases the enclosing function's state: the enclosing LamCtx restores it, and the hidden symbol,
// its FnRec and the island's argument holders stay in the shared arenas (the safe default policy).
fn lambdaBody(f: ^Sym, ret: ^Type, params: &[]Param) {
    homeBits = 0
    setFree(0)
    pendLine = 0
    frame = 0
    depth = 0
    truncate(farCalls, 0)
    homeCap = 0
    emit(0x55)
    emit(0x48)
    emit(0x89)
    emit(0xE5)
    emit(0x48)
    emit(0x81)
    emit(0xEC)
    let frameAt = pc()
    emit32(0)
    openBlock()
    fnBlock = len(blocks) - 1
    let n = len(params)
    for i in 0..n {
        let s = newSym("var", params[i].name, params[i].typ)
        s.storage = "local"
        s.isParam = true
        s.offset = 16 + 8 * (n - 1 - i)
        declare(s)
        if params[i].mode > 0 {
            s.isRef = true
            s.bind = singleBind(s, false, "", params[i].mode == 2, nil)
            s.kind = "let"
        } else if isOwned(params[i].typ) {
            addOwnedLocal(s)
        }
        if params[i].typ.kind == "string" { addStrLocal(s) }
    }
    expect(T_LBRACE, "")
    openBlock()
    let term = statSeq()
    expect(T_RBRACE, "")
    if !term && ret != tVoid { error("a lambda must return a value on every path") }
    closeBlock(term)
    closeBlock(term)
    homeBits = 0
    if !term { epilogue() }
    let size = (frame + 15) & ~15
    if size == 0 {
        dropFrame(frameAt, f)
    } else {
        putRel(frameAt, size)
    }
    if pendLine > 0 && f.writesHandles { errorAt(pendMsg, pendLine, pendCol) }
    pendLine = 0
}

// the collision a method's name makes with a member of its receiver type (section 2.3), if any
fn memberCollision(t: ^Type, name: string) {
    if t.kind == "closed" {
        for i in 0..len(t.variants) {
            let v = t.variants[i]
            if v.name == name {
                error("type '" + tname(t) + "' already has a variant '" + v.name + "'; a method cannot have the same name")
            }
            for k in 0..len(v.fields) {
                if v.fields[k].name == name {
                    error("type '" + tname(t) + "' already has a field '" + name + "' in variant '" + v.name + "'; a method cannot have the same name")
                }
            }
        }
        return
    }
    for i in 0..len(t.fields) {
        if t.fields[i].name == name {
            error("type '" + tname(t) + "' already has a field '" + name + "'; a method cannot have the same name")
        }
    }
}

// checks the receiver type a method declares on (section 7.1) and returns it
fn methodRecvType(t: ^Type) {
    if t.incomplete { error(tname(t) + " is declared but not yet defined") }
    if t.kind != "record" && t.kind != "closed" {
        error("a method's receiver must be a record or closed type declared in this module, not " + tname(t))
    }
    if t.owner != "" && t.owner != curModuleName {
        error("cannot declare a method on imported type '" + tname(t) + "'; declare it in the type's own module")
    }
    let pp = t.parent
    if pp != nil {
        error("cannot declare a method on variant '" + tname(t) + "'; declare it on its closed type '" + pp.name + "'")
    }
}

// Parses the parameter groups of a function or an interface member, from after its '(' through its ')':
// each group is [mut] name[, name]* ':' type. A parameter of interface type is owned (p: I), borrowed (p: &I)
// or mutable (mut p: &I), as any record; `mut p: I` is refused like any owned mut. A member and an ordinary
// function take the same interface parameter forms (v3 3.2).
fn parseParams(mut params: &[]Param, member: bool) {
    while sym != T_RPAREN {
        // `mut` before the names: the function may change what the parameter points to
        var pmut = false
        if sym == T_IDENT && sval == "mut" {
            next()
            pmut = true
        }
        let names = new []string(0)
        append(names, ident())
        while sym == T_COMMA {
            next()
            append(names, ident())
        }
        expect(T_COLON, "")
        let t = parseRefType()
        if member { rejectFn(t, "an interface method cannot use a function value; function types are not supported in interfaces") }
        var mode = refMode
        if pmut {
            if mode == 0 { error("mut needs a reference parameter: write mut name: &T") }
            mode = 2
        }
        for n in names { append(params, new Param{name: n, typ: t, mode: mode}) }
        if sym != T_RPAREN { expect(T_COMMA, "',' or ')'") }
    }
    expect(T_RPAREN, "")
}

// The synthetic summary of an interface member (v3 7.4), from its marker and its parameter modes alone, so a
// symbol file's reader can rebuild it identically: a pure member frees nothing; any other member may free below
// each of its mut parameters (the receiver for 'mut fn'), and nothing else. Parameters from 62 on need no bit,
// since mutFrees already answers yes for them. The member has no globals and writes no handles.
// What 'pure' guarantees to a caller: the member frees nothing and writes no owned value through a handle. It may
// still write scalars, globals and receivers, so a caller must not infer "no writes" from 'pure'.
fn setMemberSummary(m: ^Sym, pure: bool) {
    m.freesAll = false
    m.writesHandles = false
    m.fnRec.pfree = 0
    if pure { return }
    for i in 0..len(m.fnRec.pmodes) {
        if i < 62 && m.fnRec.pmodes[i] == 2 { m.fnRec.pfree = m.fnRec.pfree | (1 << i) }
    }
}

// A contextual interface definition, from its '{' (typeDecl has read 'interface'). The type symbol is declared
// before the members are parsed, so a member may name the interface itself. A prior 'type I' has already fixed
// the name's kind, so there is no forward interface shell.
fn ifaceDecl(name: string, line: int, isPub: bool) {
    let prior = findSym(curModule.globals, name)
    if prior != nil {
        if prior.kind == "type" && symType(prior).incomplete {
            errorAt("an interface cannot be forward-declared: '" + name + "' is already declared", line, 1)
        }
        errorAt("'" + name + "' is already declared in this scope", line, 1)
    }
    let t = newType("iface", name, nil)
    nameType(t, name)
    t.line = line
    t.incomplete = true
    let s = newSym("type", name, t)
    s.line = line
    declare(s)
    if isPub { s.exported = true }
    expect(T_LBRACE, "")
    skipSemis()
    var count = 0
    while sym != T_RBRACE {
        let mline = tline
        var pure = false
        var mutrecv = false
        while true {
            if sym == T_PUB {
                error("'pub' is not allowed on an interface member; mark the interface type pub")
            }
            if sym == T_IDENT && sval == "pure" && !pure && !mutrecv {
                next()
                pure = true
                continue
            }
            if sym == T_IDENT && sval == "mut" && !mutrecv {
                next()
                mutrecv = true
                continue
            }
            if sym == T_IDENT && (sval == "pure" || sval == "mut") {
                error("'pure' and 'mut' come before 'fn'")
            }
            break
        }
        if sym != T_FN { error("expected a method name in the interface") }
        next()
        if sym != T_IDENT { error("expected a method name in the interface") }
        let mname = ident()
        if findIfaceMethod(t, mname) != nil { error("interface '" + name + "' already has method '" + mname + "'") }
        // the receiver is parameter 0: borrowed for 'fn', mutable for 'mut fn'
        var params = new []Param(0)
        var recvMode = 1
        if mutrecv { recvMode = 2 }
        append(params, new Param{name: "p0", typ: t, mode: recvMode})
        expect(T_LPAREN, "")
        parseParams(&params, true)
        var ret = tVoid
        if sym == T_COLON {
            next()
            ret = parseType()
        }
        rejectFn(ret, "an interface method cannot use a function value; function types are not supported in interfaces")
        if sym != T_RBRACE { expect(T_SEMI, "';' or newline") }
        skipSemis()
        let m = newSym("ifn", mname, nil)
        m.fnRec = newFnRec()
        for p in params {
            append(m.fnRec.params, p.typ)
            append(m.fnRec.pmodes, p.mode)
        }
        m.ret = ret
        m.owner = curModuleName
        m.exported = isPub
        m.recv = t
        m.line = mline
        m.addr = 0
        m.pureMember = pure
        setMemberSummary(m, pure)
        append(ifaceSyms, m)
        count += 1
    }
    expect(T_RBRACE, "")
    if count == 0 { error("an interface needs at least one method") }
    t.incomplete = false
}

fn fnDecl(isPub: bool) {
    let hline = tline
    var isMethod = false
    var recvName = ""
    var recvType = tVoid
    var recvMode = 0
    if sym == T_LPAREN {
        isMethod = true
        let rline = tline
        next()
        // the receiver, exactly one: [mut] name: [&] Type
        var pmut = false
        if sym == T_IDENT && sval == "mut" { next(); pmut = true }
        if sym != T_IDENT {
            if sym == T_RPAREN { errorAt("a method needs a receiver, as in 'fn (r: &T) name(...)'", rline, tcol) }
            error("expected a receiver name")
        }
        recvName = ident()
        if sym == T_COMMA { error("a method has exactly one receiver") }
        expect(T_COLON, "")
        recvType = parseRefType()
        recvMode = refMode
        if pmut {
            if recvMode == 0 { error("mut needs a reference parameter: write mut name: &T") }
            recvMode = 2
        }
        if sym == T_COMMA { error("a method has exactly one receiver") }
        expect(T_RPAREN, "")
        methodRecvType(recvType)
    }
    var name = ""
    if isMethod {
        if sym != T_IDENT { error("expected a method name after the receiver") }
        name = ident()
    } else {
        name = ident()
    }
    if isMethod {
        // a declaration is matched to a prior method before its signature is read
        let early = findMethodIn(recvType, name)
        if early != nil && early.addr >= 0 { error("method '" + methodKey(early) + "' is already defined") }
    }
    if !isMethod && name == "main" && !curModule.isRoot {
        errorAt("module '" + curModule.name + "' may not declare 'main'; the program root provides it", hline, 1)
    }
    let params = new []Param(0)
    if isMethod { append(params, new Param{name: recvName, typ: recvType, mode: recvMode}) }
    expect(T_LPAREN, "")
    parseParams(&params, false)
    var ret = tVoid
    if sym == T_COLON {
        next()
        ret = parseType()
    }
    rejectFn(ret, "a function cannot return a function value; function values are parameters and locals only")
    var f = newSym("fn", name, nil)
    if isMethod {
        memberCollision(recvType, name)
        let prior = findMethodIn(recvType, name)
        if prior != nil {
            f = prior
            if prior.addr >= 0 { error("method '" + methodKey(prior) + "' is already defined") }
            var ok = len(f.fnRec.params) == len(params) && same(f.ret, ret)
            if ok {
                for i in 0..len(params) {
                    if !same(f.fnRec.params[i], params[i].typ) || f.fnRec.pmodes[i] != params[i].mode { ok = false }
                }
            }
            if !ok { error("method '" + methodKey(prior) + "' does not match its forward heading") }
        } else {
            f.fnRec = newFnRec()
            for p in params {
                append(f.fnRec.params, p.typ)
                append(f.fnRec.pmodes, p.mode)
            }
            f.ret = ret
            f.line = hline
            f.owner = curModuleName
            f.recv = recvType
            append(methodSyms, f)
        }
    } else {
        let prior = findSym(curModule.globals, name)
        if prior != nil && prior.kind == "fn" && prior.addr < 0 {
            f = prior
            var ok = len(f.fnRec.params) == len(params) && same(f.ret, ret)
            if ok {
                for i in 0..len(params) {
                    if !same(f.fnRec.params[i], params[i].typ) || f.fnRec.pmodes[i] != params[i].mode { ok = false }
                }
            }
            if !ok { error("'" + name + "' does not match its forward heading") }
        } else {
            f.fnRec = newFnRec()
            declare(f)
            for p in params {
                append(f.fnRec.params, p.typ)
                append(f.fnRec.pmodes, p.mode)
            }
            f.ret = ret
            f.line = hline
        }
    }
    if isPub { f.exported = true }               // sticky across a forward heading and its body
    if sym != T_LBRACE { return }
    if f.addr >= 0 {
        if isMethod { error("method '" + methodKey(f) + "' is already defined") }
        error("'" + name + "' is already defined")
    }
    f.addr = pc()
    for fi in 0..len(f.fnRec.fixups) { fix(f.fnRec.fixups[fi], f.addr) }   // calls waiting for this address
    curFn = f
    // what a pass over the body changes and a second pass must find as it was
    let sPos = pos
    let sLine = line
    let sCol = col
    let sLast = last
    let sSym = sym
    let sSval = sval
    let sIval = ival
    let sTline = tline
    let sTcol = tcol
    let sSelf = selfCalls
    let sUser = userCalls
    let sUse = useSeq
    let sFwd = fwdCalls
    let sTemps = argTempsUsed
    let sFreed = len(f.fnRec.freed)
    let sAll = f.freesAll
    let sWrites = f.writesHandles
    homeRetry = false
    var dname = name
    if isMethod { dname = methodDisplay(f) }
    append(fnStack, f)
    if fnBody(f, dname, ret, &params, true) {
        truncCode(f.addr)
        for gi in 0..len(curModule.globals) {
            let g = curModule.globals[gi]
            if g.kind == "fn" && g.addr < 0 {
                let fr = g.fnRec
                while len(fr.fixups) > 0 && fr.fixups[len(fr.fixups) - 1] >= f.addr { truncate(fr.fixups, len(fr.fixups) - 1) }
            }
        }
        for mi in 0..len(methodSyms) {
            let m = methodSyms[mi]
            if m.addr < 0 {
                let fr = m.fnRec
                while len(fr.fixups) > 0 && fr.fixups[len(fr.fixups) - 1] >= f.addr { truncate(fr.fixups, len(fr.fixups) - 1) }
            }
        }
        truncate(f.fnRec.freed, sFreed)
        f.freesAll = sAll
        f.writesHandles = sWrites
        selfCalls = sSelf
        userCalls = sUser
        useSeq = sUse
        fwdCalls = sFwd
        argTempsUsed = sTemps
        pos = sPos
        line = sLine
        col = sCol
        last = sLast
        sym = sSym
        sval = sSval
        ival = sIval
        tline = sTline
        tcol = sTcol
        homeRetry = false
        fnBody(f, dname, ret, &params, false)
    }
    truncate(fnStack, len(fnStack) - 1)
    curFn = nil
}

// how a parameter or receiver of a given mode is spelled in a mismatch message: T, &T, mut &T
fn modeSpelling(t: ^Type, mode: int): string {
    if mode == 2 { return "mut &" + tname(t) }
    if mode == 1 { return "&" + tname(t) }
    return tname(t)
}

// [pub] impl I for T (v3 3.3, 7.2): a conformance declaration with no body. Every member of I must be matched
// by a method of T of the same name, already defined, with the same receiver mode, parameter count, types and
// modes, and the same return type. A pure member needs a pure method; a plain member needs a method that
// changes only what is below its own mut parameters, so an importer may trust the member's marker. The
// methods are ordinary top-level declarations of T's module.
fn implDecl(isPub: bool) {
    let iline = tline
    let it = parseType()
    if it.incomplete { error("type '" + tname(it) + "' is declared but not yet defined") }
    if it.kind != "iface" { error("'" + tname(it) + "' is not an interface type") }
    if sym != T_FOR { error("expected 'for' after the interface") }
    next()
    if sym != T_IDENT { error("expected a type name after 'for'") }
    let rline = tline
    let rcol = tcol
    let rname = ident()
    if sym == T_COLONCOLON {
        // a qualified receiver names an imported type; finishTypeName resolves it, so an unknown module or type is
        // reported as usual
        let qt = finishTypeName(rname, rline, rcol)
        errorAt("cannot implement an interface for imported type '" + tname(qt) + "'; declare the implementation in the type's own module", rline, rcol)
    }
    let rs = lookup(rname)
    if rs.kind != "type" { error("'" + rname + "' is not a type") }
    let rt = symType(rs)
    if rt.incomplete { error("type '" + tname(rt) + "' is declared but not yet defined") }
    if rt.kind != "record" && rt.kind != "closed" {
        error("an interface can only be implemented by a record or closed type, not " + tname(rt))
    }
    if rt.owner != curModuleName {
        error("cannot implement an interface for imported type '" + tname(rt) + "'; declare the implementation in the type's own module")
    }
    let rp = rt.parent
    if rp != nil {
        error("cannot implement an interface for variant '" + tname(rt) + "'; declare it on its closed type '" + rp.name + "'")
    }
    if findImplIn(rt, it) != nil {
        error("type '" + tname(rt) + "' already implements interface '" + tname(it) + "'")
    }
    let members = ifaceMethodsOf(it)
    var slots = new []^Sym(0)              // the implementing method of each member, in declaration order (the vtable)
    for m in members {
        let cm = findMethodIn(rt, m.name)
        if cm == nil {
            error("type '" + tname(rt) + "' has no method '" + m.name + "' to implement interface '" + tname(it) + "'")
            return                                    // error exits; this return only narrows cm for the checks below
        }
        if cm.addr < 0 {
            error("method '" + methodKey(cm) + "' must be defined before the implementation of interface '" + tname(it) + "'")
        }
        let mism = "method '" + methodKey(cm) + "' does not match interface '" + tname(it) + "' method '" + m.name + "': "
        if cm.fnRec.pmodes[0] != m.fnRec.pmodes[0] {
            error(mism + "the receiver must be '" + modeSpelling(rt, m.fnRec.pmodes[0]) + "'")
        }
        if len(cm.fnRec.params) != len(m.fnRec.params) {
            error(mism + "it takes " + string(len(m.fnRec.params) - 1) + " argument(s), not " + string(len(cm.fnRec.params) - 1))
        }
        for i in 1..len(m.fnRec.params) {
            if !same(cm.fnRec.params[i], m.fnRec.params[i]) {
                error(mism + "argument " + string(i) + " must be " + modeSpelling(m.fnRec.params[i], m.fnRec.pmodes[i]) +
                      ", not " + modeSpelling(cm.fnRec.params[i], cm.fnRec.pmodes[i]))
            }
            if cm.fnRec.pmodes[i] != m.fnRec.pmodes[i] {
                error(mism + "argument " + string(i) + " must be '" + modeSpelling(m.fnRec.params[i], m.fnRec.pmodes[i]) + "'")
            }
        }
        if !same(cm.ret, m.ret) {
            error(mism + "it must return " + tname(m.ret) + ", not " + tname(cm.ret))
        }
        // the tier check (v3 7.2): what the member's marker promises, the method must keep
        if m.pureMember {
            if !pureFn(cm) || cm.writesHandles {
                error("method '" + methodKey(cm) + "' is not pure, but interface '" + tname(it) + "' declares '" + m.name + "' pure")
            }
        } else {
            let tier = "method '" + methodKey(cm) + "' cannot implement '" + ifaceMethodDisplay(m) + "': "
            let rule = "; interface methods may only change what is below their own mut parameters"
            // a call to a function that is not defined yet also sets writesHandles (afterCall)
            if cm.writesHandles { error(tier + "it writes an owned value through a handle, or calls a function that is not defined yet" + rule) }
            if len(cm.fnRec.freed) > 0 {
                error(tier + "it frees global '" + qualifiedSymName(cm.fnRec.freed[0]) + "'" + rule)
            }
            // reached only with a forged .sym: a library function marked freesall and not writeshandles (honest
            // summaries set both, and the writesHandles check above refuses those first)
            if cm.freesAll {
                error(tier + "it might free anything, because it calls a function that is not compiled yet; define that function first")
            }
            if (cm.fnRec.pfree & ~m.fnRec.pfree) != 0 {
                error(tier + "it frees below a parameter that the member does not declare mut")
            }
        }
        append(slots, cm)
    }
    // the vtable (v3 4): one code address per member, slot k at 8*k. Every method is defined by now, so its address is
    // final. It lives in rodata, which is one image, so an importer in the same build reaches it through the Impl.
    rodAlign()
    let vt = RODATA_BASE + len(rodata)
    for cm in slots { rod64(CODE_BASE + cm.addr) }
    append(implArena, new Impl{iface: it, recv: rt, owner: curModuleName, exported: isPub, line: iline, vtable: vt})
    append(impls, handle(implArena[len(implArena) - 1]))
}

fn constDecl(isPub: bool) {
    let line = tline
    let name = ident()
    expect(T_ASSIGN, "")
    let x = expression()
    if x.mode != "const" { error("constant value must be known at compile time") }
    rejectFn(x.typ, "a constant cannot hold a function value")
    if x.typ.kind == "nil" { error("a constant cannot be nil; use a typed optional var or let") }
    let s = newSym("const", name, x.typ)
    s.value = x.val
    s.line = line
    declare(s)
    if isPub { s.exported = true }
}

// ================================================== checking exported types

// An exported declaration may not mention a private named type of its own module, traversed
// through [], ?, ^, Result, record fields and every closed-type variant's fields (B5).
fn closureCheck(t: ^Type, declName: string, variant: string, line: int) {
    let k = t.kind
    if k == "array" || k == "opt" || k == "handle" || k == "result" {
        closureCheck(baseOf(t), declName, variant, line)
        return
    }
    if k == "fn" {
        for i in 0..fnArity(t) { closureCheck(fnParam(t, i), declName, variant, line) }
        closureCheck(fnRet(t), declName, variant, line)
        return
    }
    if k != "record" && k != "closed" && k != "iface" { return }
    for q in 0..len(closureSeen) {
        if closureSeen[q] == t { return }
    }
    append(closureSeen, t)
    if t.owner != "" && t.owner == curModuleName && len(t.name) > 0 {
        let s = findSym(curModule.globals, t.name)
        if s != nil && s.kind == "type" && !s.exported {
            var v = ""
            if len(variant) > 0 { v = " (variant '" + variant + "')" }
            errorAt("exported '" + declName + "' uses private type '" + t.name + "'" + v + "; mark '" + t.name + "' pub too", line, 1)
        }
    }
    if t.owner != "" && t.owner != curModuleName { return }     // a foreign interface is its module's to check
    if k == "iface" {
        // every member's parameters and return type are part of the interface
        let ms = ifaceMethodsOf(t)
        for m in ms {
            for p in 1..len(m.fnRec.params) { closureCheck(m.fnRec.params[p], declName, "", line) }
            closureCheck(m.ret, declName, "", line)
        }
        return
    }
    if k == "closed" {
        for i in 0..len(t.variants) {
            closureCheck(t.variants[i], declName, t.variants[i].name, line)
        }
    } else {
        for i in 0..len(t.fields) {
            closureCheck(t.fields[i].typ, declName, variant, line)
        }
    }
}

fn checkExports() {
    for i in 0..len(curModule.globals) {
        let s = curModule.globals[i]
        if s.exported {
            truncate(closureSeen, 0)
            if s.kind == "fn" {
                for p in 0..len(s.fnRec.params) { closureCheck(s.fnRec.params[p], s.name, "", s.line) }
                closureCheck(s.ret, s.name, "", s.line)
            } else if s.kind == "var" || s.kind == "let" {
                closureCheck(symType(s), s.name, "", s.line)
            } else if s.kind == "type" {
                closureCheck(symType(s), s.name, "", s.line)
            }
        }
    }
    for mi in 0..len(methodSyms) {
        let m = methodSyms[mi]
        if m.owner == curModuleName && m.exported {
            truncate(closureSeen, 0)
            for p in 0..len(m.fnRec.params) { closureCheck(m.fnRec.params[p], methodDisplay(m), "", m.line) }
            closureCheck(m.ret, methodDisplay(m), "", m.line)
        }
    }
    for ii in 0..len(impls) {
        let im = impls[ii]
        if im.owner == curModuleName && im.exported {
            let isym = findSym(curModule.globals, im.iface.name)
            if isym != nil && im.iface.owner == curModuleName && !isym.exported {
                errorAt("exported implementation of '" + tname(im.iface) + "' for '" + tname(im.recv) +
                        "' uses private type '" + im.iface.name + "'; mark '" + im.iface.name + "' pub too", im.line, 1)
            }
            let rs = findSym(curModule.globals, im.recv.name)
            if rs != nil && !rs.exported {
                errorAt("exported implementation of '" + tname(im.iface) + "' for '" + tname(im.recv) +
                        "' uses private type '" + im.recv.name + "'; mark '" + im.recv.name + "' pub too", im.line, 1)
            }
        }
    }
}

// ================================================== one image, dependency-first

fn compileUnit(path: string, display: string, isRoot: bool)

// the alias checks and binding shared by a build import and a check import
fn bindImportedAlias(alias: string, dep: ^Module, raw: string, iline: int, icol: int) {
    if reservedTypeName(alias) || findSym(universe, alias) != nil {
        errorAt("cannot use '" + alias + "' as an import alias: it is a built-in name", iline, icol)
    }
    for i in 0..len(curModule.imports) {
        if curModule.imports[i].alias == alias {
            errorAt("'" + alias + "' is already used as an import alias", iline, icol)
        }
    }
    var dup = false
    for i in 0..len(curModule.imports) {
        if curModule.imports[i].mod == dep { dup = true }
    }
    append(curModule.imports, new Import{alias: alias, mod: dep, raw: raw})
    if !dup {
        for i in 0..len(dep.globals) {
            if dep.globals[i].exported { append(visibleGlobals, dep.globals[i]) }
        }
    }
}

// Parses one import at the current token (T_IMPORT), compiles the dependency if this build
// has not yet, binds its live exported declarations under the alias, and adds the direct
// imports' exports to visibleGlobals for call invalidation.
fn parseImport() {
    let iline = tline
    let icol = tcol
    next()
    if sym != T_STRING { errorAt("expected a module path after 'import'", iline, icol) }
    let raw = sval
    if !endsWith(raw, ".obx") { errorAt("import paths must end in .obx", iline, icol) }
    next()
    var alias = ""
    if sym == T_IDENT && sval == "as" {
        next()
        if sym != T_IDENT { errorAt("expected an import alias after 'as'", tline, tcol) }
        alias = ident()
    }
    expect(T_SEMI, "newline")
    if checking {
        // --check: the dependency's interface comes from its .sym; a source, if present, is
        // used only to validate the header and the source hash (never compiled)
        let base = moduleNameOfPath(raw)
        let symPath = joinDirPath(symDir, base + ".sym")
        let src = findSource(raw, curModule.dir)
        let dep = loadSymCheck(symPath, base, raw, src)
        if len(alias) == 0 { alias = dep.name }
        bindImportedAlias(alias, dep, raw, iline, icol)
        return
    }
    let rp = resolveSource(raw, curModule.dir, iline, icol)
    let seen = findModPath(rp)
    if seen != nil && onImportStack(seen) {
        errorAt(cycleTextModule(seen, raw), iline, icol)
    }
    if seen == nil { compileUnit(rp, raw, false) }
    let dep = moduleAt(rp)
    // every import reads the dependency's .sym at the import point and validates it against
    // the live interface (the v1 invariant: a build never takes semantics from the file)
    if !dep.symLoaded {
        readSym(joinDirPath(symDir, dep.name + ".sym"), dep.name, 0, raw, "")
        dep.symLoaded = true
    }
    if len(alias) == 0 { alias = dep.name }
    bindImportedAlias(alias, dep, raw, iline, icol)
}

// Compiles one module: its header and imports, then its declarations, into the shared code,
// rodata, globals and init chain. A dependency is compiled at its import point, before the
// importer's declarations, so its initializers run first, once, and its addresses and effect
// summaries are final at every cross-module call.
fn compileUnit(path: string, display: string, isRoot: bool) {
    let data = readFile(path)
    if data == nil {
        eprintln("obxc: cannot read ", path)
        exit(2)
    }
    let ss = saveScan()
    let savedMod = curModule
    let savedName = curModuleName
    let savedVisible = replace(visibleGlobals, new []^Sym(0))
    let m = new Module{name: "", path: path, srcPath: path, dir: dirOf(path), hasHeader: false, isRoot: isRoot,
                       compiled: false, ifaceOnly: false, symLoaded: false, srcHash: fnvBytes(&data), ifaceHash: 0,
                       globals: new []^Sym(0), exports: new []^Sym(0), imports: new []Import(0),
                       symDepNames: new []string(0), symDepPaths: new []string(0), symDepHashes: new []int(0)}
    append(modules, m)
    let mod = handle(modules[len(modules) - 1])
    curModule = mod
    curModuleName = ""
    append(importStack, mod)
    append(importStackNames, display)
    srcPath = path
    startScanner(data)
    skipSemis()
    if sym == T_MODULE {
        let mline = tline
        next()
        if sym != T_IDENT { error("expected a module name") }
        mod.name = ident()
        mod.hasHeader = true
        if !isRoot && mod.name == "_root" {
            errorAt("module '_root' is reserved for the program root", mline, 1)
        }
        registerModule(mod, mline)
        curModuleName = mod.name
        expect(T_SEMI, "newline")
    } else {
        if checking && isRoot {
            errorAt("the checked module needs a 'module Name' header", tline, tcol)
        }
        if !isRoot { errorAt("imported module '" + display + "' needs a 'module Name' header", tline, tcol) }
        mod.name = "_root"
        registerModule(mod, 1)
        curModuleName = "_root"
    }
    if isRoot && emitRootSym && !mod.hasHeader {
        errorAt("--emit-sym needs a 'module Name' header in the root source", 1, 1)
    }
    if !isRoot {
        let want = moduleNameOfPath(display)
        if mod.name != want {
            errorAt("module '" + mod.name + "' must be in a file named " + mod.name + ".obx (found " + display + ")", 1, 1)
        }
    }
    skipSemis()
    while sym == T_IMPORT { parseImport(); skipSemis() }
    while sym != T_EOF {
        var isPub = false
        if sym == T_PUB {
            let pline = tline
            let pcol = tcol
            next()
            isPub = true
            if sym == T_IMPORT { errorAt("'pub' applies to declarations, not imports", pline, pcol) }
        }
        if sym == T_IMPORT { errorAt("imports must come before declarations", tline, tcol) }
        let k = sym
        match k {
            T_FN {
                next()
                fnDecl(isPub)
            }
            T_TYPE {
                next()
                typeDecl(isPub)
            }
            T_VAR, T_LET {
                next()
                varDecl(tokName(k), true, isPub)
            }
            T_CONST {
                next()
                constDecl(isPub)
            }
            else {
                if k == T_IDENT && sval == "impl" {
                    next()
                    implDecl(isPub)
                } else {
                    error("expected a declaration")
                }
            }
        }
        if sym != T_EOF { expect(T_SEMI, "newline") }
        skipSemis()
    }
    let syms = &curModule.globals
    for s in syms {
        if s.kind == "type" && symType(s).incomplete {
            errorAt("type '" + s.name + "' is declared but never defined", symType(s).line, 1)
        }
        if s.kind == "fn" && s.addr < 0 {
            errorAt("function '" + s.name + "' has a forward heading but no body", s.line, 1)
        }
    }
    for mi in 0..len(methodSyms) {
        let m = methodSyms[mi]
        if m.owner == curModuleName && m.addr < 0 {
            errorAt("method '" + methodKey(m) + "' has a forward heading but no body", m.line, 1)
        }
    }
    checkExports()
    mod.compiled = true
    for i in 0..len(curModule.globals) {
        if curModule.globals[i].exported { append(mod.exports, curModule.globals[i]) }
        append(programGlobals, curModule.globals[i])
    }
    // The one .sym emission rule: every module with a header writes one when it has imports or
    // is a checked module, and a single-file build writes the root's only with --emit-sym.
    var doWrite = mod.hasHeader
    if isRoot && !checking && len(mod.imports) == 0 && !emitRootSym { doWrite = false }
    if doWrite { writeSym(mod) }
    truncate(importStack, len(importStack) - 1)
    truncate(importStackNames, len(importStackNames) - 1)
    curModule = savedMod
    curModuleName = savedName
    visibleGlobals = savedVisible
    restoreScan(ss)
}

// The program: one entry prologue, the root's compile, its main, and the teardown of every
// module's own globals in compile order (dependency globals first), then RT_FINISH.
fn compileProgram(rootPath: string, out: string, rtDir: string) {
    emit(0x48)
    emit(0x89)
    emit(0xE7)
    emit(0xBE)
    emit32(GLOBAL_BASE)
    emit(0xBA)
    let gendAt = pc()
    emit32(0)
    callAbs(RT_TEXT + 8 * RT_INIT)
    initLink = jmp()
    let root = normPath(rootPath)
    compileUnit(root, rootPath, true)
    let rm = moduleAt(root)
    let mainSym = findSym(rm.globals, "main")
    if mainSym == nil || mainSym.kind != "fn" || len(mainSym.fnRec.params) > 0 || mainSym.ret != tVoid {
        var l = 1
        if mainSym != nil && mainSym.kind == "fn" { l = mainSym.line }
        errorAt("the program needs 'fn main()' with no parameters or result", l, 1)
        return
    }
    fixHere1(initLink)
    emit(0xE8)
    emit32(mainSym.addr - (pc() + 4))
    depth = 0
    let gs = &programGlobals
    for g in gs {
        if (g.kind == "var" || g.kind == "let") && isOwned(symType(g)) {
            let x = newItem("mem", symType(g))
            x.disp = g.offset
            rtCall1(RT_FREE, x, tVoid)
        }
        if (g.kind == "var" || g.kind == "let") && symType(g).kind == "string" {
            let x = newItem("mem", tString)
            x.disp = g.offset
            rtCall1(RT_STR_DEC, x, tVoid)
        }
    }
    callAbs(RT_TEXT + 8 * RT_FINISH)
    let gend = GLOBAL_BASE + gsize
    putRel(gendAt, gend)
}

// ============================================================= ELF output

fn put16(mut b: &[]byte, v: int) {
    append(b, byte(v))
    append(b, byte(v >> 8))
}

fn put32(mut b: &[]byte, v: int) {
    put16(b, v)
    put16(b, v >> 16)
}

fn put64(mut b: &[]byte, v: int) {
    put32(b, v)
    put32(b, v >> 32)
}

fn pageUp(n: int): int { return (n + 0xFFF) / 0x1000 * 0x1000 }

fn phdr(mut ph: &[]byte, flags: int, off: int, vaddr: int, filesz: int, memsz: int) {
    put32(ph, 1)
    put32(ph, flags)
    put64(ph, off)
    put64(ph, vaddr)
    put64(ph, vaddr)
    put64(ph, filesz)
    put64(ph, memsz)
    put64(ph, 0x1000)
}

// copies a part of the image into place
fn copyAt(mut out: &[]byte, at: int, data: &[]byte) {
    for i in 0..len(data) { out[at + i] = data[i] }
}

// The runtime's data image ends in zero-filled .bss (obuf, the heap state, the
// free lists): only the nonzero prefix must be in the file. The memory size
// keeps the full length and the loader zero-fills the rest, which it already
// does for the compiler's own globals segment (filesz 0).
fn dataFileLen(b: &[]byte): int {
    var n = len(b)
    while n > 0 && b[n - 1] == 0 { n = n - 1 }
    return n
}

// Same layout as obx.py: headers and code, then rodata, the globals
// (memory only), and the runtime's code and data at fixed addresses. Each part
// starts on a page, and the image is allocated once, at its final size.
fn elfImage(rtText: []byte, rtData: []byte): []byte {
    let codeAt = 0x1000
    let roAt = pageUp(codeAt + pc())
    var roLen = len(rodata)
    if roLen == 0 { roLen = 1 }                      // an empty segment still gets one byte
    let rtTextAt = pageUp(roAt + roLen)
    let rtDataAt = pageUp(rtTextAt + len(rtText))
    let rtDataFile = dataFileLen(rtData)             // the trailing .bss need not be in the file
    let out = new []byte(rtDataAt + rtDataFile)
    for k in 0..len(code) { copyAt(out, codeAt + (k << CHUNK_BITS), code[k].b) }
    for i in 0..curLen { out[codeAt + codeBase + i] = cur[i] }
    copyAt(out, roAt, rodata)
    copyAt(out, rtTextAt, rtText)
    for i in 0..rtDataFile { out[rtDataAt + i] = rtData[i] }
    let ph = new []byte(0)
    phdr(ph, 5, 0, IMAGE_BASE, codeAt + pc(), codeAt + pc())
    phdr(ph, 4, roAt, RODATA_BASE, roLen, roLen)
    var gmem = gsize
    if gmem < 8 { gmem = 8 }
    phdr(ph, 6, 0, GLOBAL_BASE, 0, gmem)
    phdr(ph, 5, rtTextAt, RT_TEXT, len(rtText), len(rtText))
    phdr(ph, 6, rtDataAt, RT_DATA, rtDataFile, len(rtData))
    put32(ph, 0x6474E551)
    put32(ph, 6)
    for i in 0..5 { put64(ph, 0) }
    put64(ph, 16)
    let eh = new []byte(0)
    append(eh, 0x7F)
    append(eh, 'E')
    append(eh, 'L')
    append(eh, 'F')
    append(eh, 2)
    append(eh, 1)
    append(eh, 1)
    for i in 0..9 { append(eh, 0) }
    put16(eh, 2)
    put16(eh, 0x3E)
    put32(eh, 1)
    put64(eh, CODE_BASE)
    put64(eh, 64)
    put64(eh, 0)
    put32(eh, 0)
    put16(eh, 64)
    put16(eh, 56)
    put16(eh, 6)
    put16(eh, 64)
    put16(eh, 0)
    put16(eh, 0)
    for i in 0..len(eh) { out[i] = eh[i] }
    for i in 0..len(ph) { out[64 + i] = ph[i] }
    return out
}

fn dirOf(path: string): string {
    var i = len(path) - 1
    while i >= 0 && path[i] != '/' { i -= 1 }
    if i < 0 { return "." }
    if i == 0 { return "/" }
    return substr(path, 0, i)
}

// ================================================== module paths and --deps

fn endsWith(s: string, suf: string): bool {
    if len(suf) > len(s) { return false }
    let from = len(s) - len(suf)
    for i in 0..len(suf) {
        if s[from + i] != suf[i] { return false }
    }
    return true
}

fn isAbsPath(p: string): bool { return len(p) > 0 && p[0] == '/' }

fn joinDirPath(d: string, p: string): string {
    if len(d) == 0 || d == "." { return p }
    if d[len(d) - 1] == '/' { return d + p }
    return d + "/" + p
}

// The canonical lexical form of a path (B4): repeated '/' collapses, '.' goes, '..' pops the
// previous segment (a leading '..' of a relative path stays), and a leading '/' is kept.
// Symlinks are not resolved: the runtime has no readlink/realpath, so module trees use
// canonical paths and a symlinked duplicate is a different file.
fn normPath(p: string): string {
    let abs = isAbsPath(p)
    let parts = new []string(0)
    var start = 0
    var i = 0
    while i <= len(p) {
        if i == len(p) || p[i] == '/' {
            let seg = substr(p, start, i)
            if len(seg) > 0 && seg != "." {
                if seg == ".." {
                    if len(parts) > 0 && parts[len(parts) - 1] != ".." {
                        truncate(parts, len(parts) - 1)
                    } else if !abs {
                        append(parts, seg)
                    }
                } else {
                    append(parts, seg)
                }
            }
            start = i + 1
        }
        i += 1
    }
    var out = ""
    if abs { out = "/" }
    for k in 0..len(parts) {
        if k > 0 { out = out + "/" }
        out = out + parts[k]
    }
    if len(out) == 0 {
        if abs { return "/" }
        return "."
    }
    return out
}

fn baseNameOf(p: string): string {
    var i = len(p) - 1
    while i >= 0 && p[i] != '/' { i -= 1 }
    return substr(p, i + 1, len(p))
}

// the module name an import path names: its basename without .obx
fn moduleNameOfPath(p: string): string {
    let b = baseNameOf(p)
    if len(b) > 4 && endsWith(b, ".obx") { return substr(b, 0, len(b) - 4) }
    return b
}

var incDirs = new []string(0)

// the module record of the --deps scan: only names and paths, no compile
type Dep = ref record { name: string; path: string; display: string }

var deps = new []Dep(0)
var depStack = new []int(0)

fn depIndex(path: string): int {
    for i in 0..len(deps) {
        if deps[i].path == path { return i }
    }
    return -1
}

fn depOnStack(ix: int): bool {
    for k in 0..len(depStack) {
        if depStack[k] == ix { return true }
    }
    return false
}

// the cycle text from the stack entry that is the target to the closing import
fn cycleText(target: int, closing: string): string {
    var k = 0
    while k < len(depStack) && depStack[k] != target { k += 1 }
    var msg = "import cycle: "
    while k < len(depStack) {
        msg = msg + deps[depStack[k]].display + " -> "
        k += 1
    }
    return msg + closing
}

fn depRegister(ix: int, name: string, line: int) {
    for k in 0..len(deps) {
        if k != ix && deps[k].name == name {
            errorAt("module '" + name + "' is declared by both " + deps[k].path + " and " + deps[ix].path, line, 1)
        }
    }
    deps[ix].name = name
}

// true while --deps walks headers: it never consults a .sym directory
var depsWalk = false

// the candidate paths for an import, in search order: as written if absolute, else the
// importer's directory then each -I directory
fn sourceCandidates(raw: string, base: string): []string {
    let cands = new []string(0)
    if isAbsPath(raw) {
        append(cands, raw)
    } else {
        append(cands, joinDirPath(base, raw))
        for k in 0..len(incDirs) { append(cands, joinDirPath(incDirs[k], raw)) }
    }
    return cands
}

// the first readable candidate for an import path, normalized, or "" (no error)
fn findSource(raw: string, base: string): string {
    let cands = sourceCandidates(raw, base)
    let seenPaths = new []string(0)
    for c in cands {
        let n = normPath(c)
        var dup = false
        for k in 0..len(seenPaths) {
            if seenPaths[k] == n { dup = true }
        }
        if dup { continue }
        append(seenPaths, n)
        let data = readFile(n)
        if data != nil { return n }
    }
    return ""
}

// Resolves an import path: relative to the importer's directory, then each -I directory in
// order; an absolute path is used as written. Returns the normalized path, or exits 2 with
// every path tried in the message. A build needs the source: if only a .sym exists, say so.
fn resolveSource(raw: string, base: string, line: int, col: int): string {
    let cands = sourceCandidates(raw, base)
    var tried = ""
    let seenPaths = new []string(0)
    for c in cands {
        let n = normPath(c)
        var dup = false
        for k in 0..len(seenPaths) {
            if seenPaths[k] == n { dup = true }
        }
        if dup { continue }
        append(seenPaths, n)
        if len(tried) > 0 { tried = tried + ", " }
        tried = tried + n
        let data = readFile(n)
        if data != nil { return n }
    }
    let mname = moduleNameOfPath(raw)
    let probe = readFile(joinDirPath(symDir, mname + ".sym"))
    if !depsWalk && probe != nil {
        eprintln("obxc: cannot read module '", mname, "' at ", tried,
                 "; only --check may use a symbol file without source")
    } else {
        eprintln("obxc: cannot read module '", mname, "' at ", tried)
    }
    exit(2)
}

// Reads a source file's module header and import block (no declarations, no compile) and
// prints its normalized path after its dependencies: depth-first post-order, root last.
fn scanDeps(path: string, display: string, isRoot: bool) {
    let data = readFile(path)
    if data == nil {
        eprintln("obxc: cannot read ", path)
        exit(2)
    }
    let st = saveScan()
    append(deps, new Dep{name: "", path: path, display: display})
    let ix = len(deps) - 1
    append(depStack, ix)
    srcPath = path
    startScanner(data)
    skipSemis()
    if sym == T_MODULE {
        let mline = tline
        next()
        if sym != T_IDENT { error("expected a module name") }
        let name = ident()
        if !isRoot && name == "_root" { errorAt("module '_root' is reserved for the program root", mline, 1) }
        depRegister(ix, name, mline)
        expect(T_SEMI, "newline")
    } else {
        if !isRoot { errorAt("imported module '" + display + "' needs a 'module Name' header", tline, tcol) }
        depRegister(ix, "_root", 1)
    }
    if !isRoot {
        let want = moduleNameOfPath(display)
        if deps[ix].name != want {
            errorAt("module '" + deps[ix].name + "' must be in a file named " + deps[ix].name + ".obx (found " + display + ")", 1, 1)
        }
    }
    skipSemis()
    while sym == T_IMPORT {
        let iline = tline
        let icol = tcol
        next()
        if sym != T_STRING { errorAt("expected a module path after 'import'", iline, icol) }
        let raw = sval
        if !endsWith(raw, ".obx") { errorAt("import paths must end in .obx", iline, icol) }
        next()
        if sym == T_IDENT && sval == "as" {
            next()
            if sym != T_IDENT { errorAt("expected an import alias after 'as'", tline, tcol) }
            next()
        }
        expect(T_SEMI, "newline")
        let rp = resolveSource(raw, dirOf(path), iline, icol)
        let j = depIndex(rp)
        if j >= 0 && depOnStack(j) {
            errorAt(cycleText(j, raw), iline, icol)
        }
        if j < 0 { scanDeps(rp, raw, false) }
        skipSemis()
    }
    println(path)
    truncate(depStack, len(depStack) - 1)
    restoreScan(st)
}

fn runDeps(rootPath: string) {
    depsWalk = true
    scanDeps(normPath(rootPath), rootPath, true)
}

// Once the module is compiled, the image needs only the code, rodata and gsize: the symbols,
// types and the rest are freed before it is built, since it is the largest allocation.
// The handles that still name them (tInt, the globals' fns) are not used again.
// ===================================================== symbol files: the writer
//
// Text, line-oriented, language-like declarations (§7): obosym/abi/compiler/source/dep/
// interface, then the hashed body module/depiface/declarations. The canonical order and
// canonical p0.. parameter names make the bytes deterministic; no address, offset,
// descriptor, pointer, timestamp or absolute path appears.

fn appStr(mut b: &[]byte, s: string) {
    for i in 0..len(s) { append(b, s[i]) }
}

fn appInt(mut b: &[]byte, v: int) { appStr(b, string(v)) }

// a string in the language's source syntax: the writer and the scanner agree on every
// escape the .sym grammar can carry (paths and pf events)
fn appQuoted(mut b: &[]byte, s: string) {
    append(b, '"')
    for i in 0..len(s) {
        let c = s[i]
        if c == '\\' || c == '"' {
            append(b, '\\')
            append(b, c)
        } else if c == '\n' {
            append(b, '\\')
            append(b, 'n')
        } else if c == '\t' {
            append(b, '\\')
            append(b, 't')
        } else if c == '\r' {
            append(b, '\\')
            append(b, 'r')
        } else {
            append(b, c)
        }
    }
    append(b, '"')
}

// The canonical type expression: primitives; [] ? ^ Result; a bare name for the defining
// module; Module::Name for a foreign one. Alias names are never emitted: the underlying
// type is, so layout never depends on an alias.
fn appTypeExpr(mut b: &[]byte, t: ^Type, modName: string) {
    let k = t.kind
    if k == "fn" {
        appStr(b, "fn(")
        for i in 0..fnArity(t) {
            if i > 0 { appStr(b, ", ") }
            if fnMode(t, i) == 1 { append(b, '&') }
            appTypeExpr(b, fnParam(t, i), modName)
        }
        append(b, ')')
        let r = fnRet(t)
        if r.kind != "void" {
            appStr(b, ": ")
            appTypeExpr(b, r, modName)
        }
        return
    }
    if k == "array" {
        appStr(b, "[]")
        appTypeExpr(b, baseOf(t), modName)
        return
    }
    if k == "opt" {
        append(b, '?')
        appTypeExpr(b, baseOf(t), modName)
        return
    }
    if k == "handle" {
        append(b, '^')
        appTypeExpr(b, baseOf(t), modName)
        return
    }
    if k == "result" {
        appStr(b, "Result[")
        appTypeExpr(b, baseOf(t), modName)
        append(b, ']')
        return
    }
    if t.owner != "" && t.owner != modName {
        appStr(b, t.owner)
        appStr(b, "::")
    }
    appStr(b, t.name)
}

fn appFields(mut b: &[]byte, rec: ^Type, modName: string) {
    append(b, '{')
    for i in 0..len(rec.fields) {
        if i > 0 { append(b, ';') }
        append(b, ' ')
        appStr(b, rec.fields[i].name)
        appStr(b, ": ")
        appTypeExpr(b, rec.fields[i].typ, modName)
    }
    append(b, ' ')
    append(b, '}')
}

// a declaration in the source grammar that defines a type (as opposed to an alias key): a record, a closed type
// or an interface
fn symDefines(s: ^Sym, modName: string): bool {
    if s.kind != "type" { return false }
    let t = symType(s)
    if t.parent != nil { return false }
    return (t.kind == "record" || t.kind == "closed" || t.kind == "iface") && t.owner == modName && t.name == s.name
}

// a definition with a shell line: records and closed types. An interface has none: its definition line registers it.
fn symHasShell(s: ^Sym, modName: string): bool {
    return symDefines(s, modName) && symType(s).kind != "iface"
}

// a variant's own exported symbol (emitted inside its closed type, never as an alias)
fn symIsVariantSym(s: ^Sym): bool {
    if s.kind != "type" { return false }
    let t = symType(s)
    return t.parent != nil && t.name == s.name
}

fn appTypeShell(mut b: &[]byte, s: ^Sym) {
    appStr(b, "type ")
    appStr(b, s.name)
    appStr(b, " uid ")
    appHex16(b, symType(s).uid)
    append(b, '\n')
}

// an interface member's explicit parameters only, named p0, p1, ... (the receiver is not in the textual signature);
// a parameter is written with its mode: `&` for a borrow, `mut` before the name for a mutable one
fn appIfaceParams(mut b: &[]byte, f: ^Sym, modName: string) {
    for i in 1..len(f.fnRec.params) {
        if i > 1 { appStr(b, ", ") }
        if f.fnRec.pmodes[i] == 2 { appStr(b, "mut ") }
        append(b, 'p')
        appInt(b, i - 1)
        appStr(b, ": ")
        if f.fnRec.pmodes[i] > 0 { append(b, '&') }
        appTypeExpr(b, f.fnRec.params[i], modName)
    }
}

// the body of an interface definition, members in declaration order: interface { pure fn m(p0: T): R; mut fn n(p0: &I) }
fn appIface(mut b: &[]byte, t: ^Type, modName: string) {
    appStr(b, "interface {")
    let ms = ifaceMethodsOf(t)
    for i in 0..len(ms) {
        if i > 0 { append(b, ';') }
        append(b, ' ')
        let m = ms[i]
        if m.pureMember { appStr(b, "pure ") }
        if m.fnRec.pmodes[0] == 2 { appStr(b, "mut ") }
        appStr(b, "fn ")
        appStr(b, m.name)
        append(b, '(')
        appIfaceParams(b, m, modName)
        append(b, ')')
        if m.ret != tVoid {
            appStr(b, ": ")
            appTypeExpr(b, m.ret, modName)
        }
    }
    appStr(b, " }")
}

fn appTypeDef(mut b: &[]byte, s: ^Sym, modName: string) {
    let t = symType(s)
    appStr(b, "type ")
    appStr(b, s.name)
    if t.kind == "record" {
        appStr(b, " = ref record ")
        appFields(b, t, modName)
        append(b, '\n')
        return
    }
    if t.kind == "iface" {
        appStr(b, " = ")
        appIface(b, t, modName)
        append(b, '\n')
        return
    }
    appStr(b, " = closed {")
    for i in 0..len(t.variants) {
        append(b, ' ')
        appStr(b, t.variants[i].name)
        append(b, ' ')
        appFields(b, t.variants[i], modName)
    }
    appStr(b, " }\n")
}

fn appTypeAlias(mut b: &[]byte, s: ^Sym, modName: string) {
    appStr(b, "type ")
    appStr(b, s.name)
    appStr(b, " = ")
    appTypeExpr(b, symType(s), modName)
    append(b, '\n')
}

fn appConst(mut b: &[]byte, s: ^Sym) {
    let t = symType(s)
    appStr(b, "const ")
    appStr(b, s.name)
    appStr(b, ": ")
    appTypeExpr(b, t, "")
    appStr(b, " = ")
    if t.kind == "bool" {
        if s.value != 0 { appStr(b, "true") } else { appStr(b, "false") }
    } else if t.kind == "string" {
        let data = rodataString(s.value)
        appStr(b, "hex \"")
        for i in 0..len(data) {
            append(b, hexDigit(data[i] >> 4))
            append(b, hexDigit(data[i] & 15))
        }
        append(b, '"')
    } else {
        appHex16(b, s.value)
    }
    append(b, '\n')
}

fn appGlobal(mut b: &[]byte, s: ^Sym, modName: string) {
    appStr(b, s.kind)
    append(b, ' ')
    appStr(b, s.name)
    appStr(b, ": ")
    appTypeExpr(b, symType(s), modName)
    append(b, '\n')
}

// parameters from index `from` on, as pN: [&]Type (the receiver is always p0 for a method)
fn appParams(mut b: &[]byte, f: ^Sym, from: int, count: int, modName: string) {
    for i in from..count {
        if i > from { appStr(b, ", ") }
        if f.fnRec.pmodes[i] == 2 { appStr(b, "mut ") }
        append(b, 'p')
        appInt(b, i)
        appStr(b, ": ")
        if f.fnRec.pmodes[i] > 0 { append(b, '&') }
        appTypeExpr(b, f.fnRec.params[i], modName)
    }
}

// the shared summary: effects, freed globals and per-parameter pf rows
fn appFnSummary(mut b: &[]byte, f: ^Sym) {
    let n = len(f.fnRec.params)
    if f.freesAll { appStr(b, " freesall") }
    if f.writesHandles { appStr(b, " writeshandles") }
    if f.fnRec.pfree != 0 {
        appStr(b, " pfree ")
        appHexMin(b, f.fnRec.pfree)
    }
    if len(f.fnRec.freed) > 0 {
        appStr(b, " frees ")
        appInt(b, len(f.fnRec.freed))
        let freed = &f.fnRec.freed
        for g in freed {
            append(b, ' ')
            appStr(b, symKey(g))
        }
    }
    for i in 0..n {
        for k in 0..len(pfFn) {
            if pfFn[k] == f && pfIdx[k] == i {
                appStr(b, " pf ")
                appInt(b, i)
                append(b, ' ')
                appQuoted(b, pfEv[k])
            }
        }
    }
}

// an implementation line: impl I for R, R the defining name of a type of this module (I qualified when foreign)
fn appImpl(mut b: &[]byte, im: ^Impl, modName: string) {
    appStr(b, "impl ")
    appTypeExpr(b, im.iface, modName)
    appStr(b, " for ")
    appStr(b, im.recv.name)
    append(b, '\n')
}

fn appFn(mut b: &[]byte, f: ^Sym, modName: string) {
    appStr(b, "fn ")
    appStr(b, f.name)
    append(b, '(')
    let n = len(f.fnRec.params)
    appParams(b, f, 0, n, modName)
    append(b, ')')
    if f.ret != tVoid {
        appStr(b, ": ")
        appTypeExpr(b, f.ret, modName)
    }
    appFnSummary(b, f)
    append(b, '\n')
}

// a method as a source-like function whose first parameter is the receiver
fn appMethod(mut b: &[]byte, f: ^Sym, modName: string) {
    appStr(b, "fn (")
    if f.fnRec.pmodes[0] == 2 { appStr(b, "mut ") }
    appStr(b, "p0: ")
    if f.fnRec.pmodes[0] > 0 { append(b, '&') }
    appTypeExpr(b, f.fnRec.params[0], modName)
    appStr(b, ") ")
    appStr(b, f.name)
    append(b, '(')
    let n = len(f.fnRec.params)
    appParams(b, f, 1, n, modName)
    append(b, ')')
    if f.ret != tVoid {
        appStr(b, ": ")
        appTypeExpr(b, f.ret, modName)
    }
    appFnSummary(b, f)
    append(b, '\n')
}

// The .sym's dep/depiface pairs: one per unique module in first-import order. A module
// imported twice (with one or two aliases) appears once; the aliases are not interface data.
fn symDepsOf(mod: ^Module): SymDepList {
    let out = new SymDepList{names: new []string(0), paths: new []string(0), hashes: new []int(0)}
    if mod.ifaceOnly {
        for i in 0..len(mod.symDepNames) {
            append(out.names, mod.symDepNames[i])
            append(out.paths, mod.symDepPaths[i])
            append(out.hashes, mod.symDepHashes[i])
        }
        return out
    }
    let imports = &mod.imports
    for im in imports {
        var have = false
        for i in 0..len(out.names) {
            if out.names[i] == im.mod.name { have = true }
        }
        if !have {
            append(out.names, im.mod.name)
            append(out.paths, im.raw)
            append(out.hashes, im.mod.ifaceHash)
        }
    }
    return out
}

fn symBody(mod: ^Module): []byte {
    let b = new []byte(0)
    let modName = mod.name
    appStr(b, "module ")
    appStr(b, modName)
    append(b, '\n')
    let dl = symDepsOf(mod)
    for i in 0..len(dl.names) {
        appStr(b, "depiface ")
        appStr(b, dl.names[i])
        append(b, ' ')
        appHex16(b, dl.hashes[i])
        append(b, '\n')
    }
    for i in 0..len(mod.globals) {                  // 1. shells
        let s = mod.globals[i]
        if s.exported && symHasShell(s, modName) { appTypeShell(b, s) }
    }
    // Definitions follow their *definition* line, not the symbol's first (forward)
    // position: a forward type declared before a closed type may name one of its
    // variants, so the closed definition must be read first.
    var defDone = new []bool(0)
    for i in 0..len(mod.globals) { append(defDone, false) }
    var defLeft = 0
    for i in 0..len(mod.globals) {
        let s = mod.globals[i]
        if s.exported && symDefines(s, modName) { defLeft += 1 }
    }
    while defLeft > 0 {
        var best = -1
        var bestLine = 0
        for i in 0..len(mod.globals) {
            let s = mod.globals[i]
            if !defDone[i] && s.exported && symDefines(s, modName) {
                if best < 0 || s.line < bestLine {
                    best = i
                    bestLine = s.line
                }
            }
        }
        if best >= 0 {
            defDone[best] = true
            appTypeDef(b, mod.globals[best], modName)
            defLeft -= 1
        }
    }
    for i in 0..len(mod.globals) {                  // 3. aliases (after definitions)
        let s = mod.globals[i]
        if s.exported && s.kind == "type" && !symDefines(s, modName) && !symIsVariantSym(s) {
            appTypeAlias(b, s, modName)
        }
    }
    for i in 0..len(mod.globals) {                  // 4. constants
        let s = mod.globals[i]
        if s.exported && s.kind == "const" { appConst(b, s) }
    }
    for i in 0..len(mod.globals) {                  // 5. globals
        let s = mod.globals[i]
        if s.exported && (s.kind == "var" || s.kind == "let") && s.storage == "global" {
            appGlobal(b, s, modName)
        }
    }
    for i in 0..len(methodSyms) {                   // 6. methods, in declaration order
        let m = methodSyms[i]
        if m.owner == modName && m.exported { appMethod(b, m, modName) }
    }
    for i in 0..len(impls) {                        // 7. implementations, in declaration order
        let im = impls[i]
        if im.owner == modName && im.exported { appImpl(b, im, modName) }
    }
    for i in 0..len(mod.globals) {                  // 8. functions
        let s = mod.globals[i]
        if s.exported && s.kind == "fn" { appFn(b, s, modName) }
    }
    return b
}

// The whole file: the unhashed header, the interface hash of the body, then the body.
fn symText(mod: ^Module): []byte {
    let body = symBody(mod)
    let h = fnvBytes(&body)
    mod.ifaceHash = h
    let b = new []byte(0)
    appStr(b, "obosym ")
    appInt(b, SYM_FORMAT)
    append(b, '\n')
    appStr(b, "abi ")
    appInt(b, SYM_ABI)
    append(b, '\n')
    appStr(b, "compiler \"")
    appStr(b, OBO_VERSION)
    appStr(b, "\"\n")
    appStr(b, "source ")
    appHex16(b, mod.srcHash)
    append(b, '\n')
    let dl = symDepsOf(mod)
    for i in 0..len(dl.names) {
        appStr(b, "dep ")
        appStr(b, dl.names[i])
        append(b, ' ')
        appQuoted(b, dl.paths[i])
        append(b, '\n')
    }
    appStr(b, "interface ")
    appHex16(b, h)
    append(b, '\n')
    for i in 0..len(body) { append(b, body[i]) }
    return b
}

fn writeSym(mod: ^Module) {
    let text = symText(mod)
    if !writeFile(joinDirPath(symDir, mod.name + ".sym"), text, false) {
        eprintln("obxc: symbol-file directory '", symDir, "' does not exist or is not writable")
        exit(2)
    }
}

// ===================================================== symbol files: the reader
//
// A dedicated declaration parser over the scanner (§7.7). It never calls lookup: a bare
// name resolves in the .sym module's own export table, a qualified name in the named
// module's. Structure and summaries are validated before any index or dereference; every
// malformed file is a clean `obxc: <path>:<line>:<col>: symbol file: <detail>` (exit 2).
// A full build validates the file against the live interface and never constructs or
// overwrites a live object; --check reconstructs the interface from the file.

var symCurMod: ^Module = handle(noModule)
var symSeen = new []string(0)
var symShells = new []string(0)
var symDefined = new []string(0)
var symAliasOrder = new []string(0)
var symConstOrder = new []string(0)
var symGlobalOrder = new []string(0)
var symMethodOrder = new []string(0)
var symFnOrder = new []string(0)
var symImplOrder = new []string(0)
var symImplSeen = new []string(0)
var symAfterShells = false

fn symDisagree(decl: string)

fn symFail(msg: string) {
    eprintln("obxc: ", msg)
    exit(2)
}

fn symFileFail(p: string, tail: string) {
    eprintln("obxc: symbol file '", p, "' ", tail)
    exit(2)
}

// a rule that comes from the source language but is detected in a .sym (exit 1)
fn symSourceRule(msg: string) {
    eprintln(srcPath, ":", 1, ":", 1, ": ", msg)
    exit(1)
}

fn symHas(list: &[]string, s: string): bool {
    for i in 0..len(list) {
        if list[i] == s { return true }
    }
    return false
}

fn symLineEnd() {
    if sym == T_SEMI { next(); return }
    if sym == T_EOF { return }
    error("expected the end of the line")
}

fn symIntTok(): int {
    if sym != T_INT { error("expected an integer") }
    let v = ival
    next()
    return v
}

// a hash or uid: exactly 0x and 16 hexadecimal digits, so short/long/odd forms are clean errors
fn symHex16(what: string): int {
    if sym != T_INT { error("expected a hexadecimal " + what) }
    let text = substr(src, tokStart, pos)
    if !isHex16(text) {
        error("malformed " + what + ": expected 0x and 16 hexadecimal digits, found " + text)
    }
    let v = ival
    next()
    return v
}

fn symHexString(s: string): string {
    if len(s) % 2 != 0 { error("malformed hex string: an odd number of digits") }
    let out = new []byte(0)
    var i = 0
    while i < len(s) {
        if !isHex(s[i]) || !isHex(s[i + 1]) { error("malformed hex string: expected hexadecimal digits") }
        append(out, byte(hexVal(s[i]) * 16 + hexVal(s[i + 1])))
        i += 2
    }
    return string(out)
}

fn symWord(w: string) {
    if sym == T_IDENT && sval == w { next(); return }
    error("expected '" + w + "'")
}

fn symTypeText(t: ^Type): string {
    if t.kind == "fn" {
        var s = "fn("
        for i in 0..fnArity(t) {
            if i > 0 { s = s + ", " }
            if fnMode(t, i) == 1 { s = s + "&" }
            s = s + symTypeText(fnParam(t, i))
        }
        s = s + ")"
        let r = fnRet(t)
        if r.kind != "void" { s = s + ": " + symTypeText(r) }
        return s
    }
    if t.kind == "array" { return "[]" + symTypeText(baseOf(t)) }
    if t.kind == "handle" { return "^" + symTypeText(baseOf(t)) }
    if t.kind == "opt" { return "?" + symTypeText(baseOf(t)) }
    if t.kind == "result" { return "Result[" + symTypeText(baseOf(t)) + "]" }
    if t.owner != "" && t.owner != symCurMod.name { return t.owner + "::" + t.name }
    return t.name
}

fn moduleByName(name: string): ?^Module {
    for i in 0..len(modules) {
        if !modules[i].ifaceOnly && modules[i].name == name { return handle(modules[i]) }
    }
    return nil
}

fn symModuleByName(name: string): ?^Module {
    for i in 0..len(modules) {
        if modules[i].ifaceOnly && modules[i].name == name { return handle(modules[i]) }
    }
    return nil
}

// the pf path grammar: /field, /[n] and /[] segments; an empty path after the prefix is whole
fn symValidateEvent(ev: string) {
    if len(ev) == 0 { error("a pf event needs '=' or '!'") }
    let pref = ev[0]
    if pref != '=' && pref != '!' { error("a pf event starts with '=' or '!', not '" + substr(ev, 0, 1) + "'") }
    var i = 1
    while i < len(ev) {
        if ev[i] != '/' { error("malformed pf event path '" + ev + "': expected '/'") }
        i += 1
        if i >= len(ev) { error("malformed pf event path '" + ev + "': empty segment") }
        if ev[i] == '[' {
            i += 1
            if i < len(ev) && ev[i] == ']' {
                i += 1
            } else {
                if i < len(ev) && ev[i] == '-' { i += 1 }
                let start = i
                while i < len(ev) && isDigit(ev[i]) { i += 1 }
                if i == start { error("malformed pf event path '" + ev + "': expected an index") }
                if i >= len(ev) || ev[i] != ']' { error("malformed pf event path '" + ev + "': expected ']'") }
                i += 1
            }
        } else {
            if !isLetter(ev[i]) { error("malformed pf event path '" + ev + "': expected a field name") }
            while i < len(ev) && (isLetter(ev[i]) || isDigit(ev[i])) { i += 1 }
        }
    }
}

fn symQualifiedType(mname: string, member: string, line: int, col: int): ^Type {
    var found: ?^Module = nil
    if checking { found = symModuleByName(mname) } else { found = moduleByName(mname) }
    if found == nil { errorAt("unknown module '" + mname + "' in a type", line, col) }
    var m: ^Module = handle(noModule)
    if found != nil { m = found }
    let s = findExport(m, member)
    if s != nil && s.kind == "type" { return symType(s) }
    errorAt("module '" + mname + "' has no exported type '" + member + "'", line, col)
    return tVoid
}

fn symParseType(): ^Type

// the name tail of a type expression, once its leading name has been read: the order of finishTypeName ('::' first,
// so a symbol-file alias may name a module called int or Result)
fn symFinishTypeName(name: string, nline: int, ncol: int): ^Type {
    if sym == T_COLONCOLON {
        next()
        if sym != T_IDENT { error("expected a type name after '::'") }
        let member = ident()
        return symQualifiedType(name, member, nline, ncol)
    }
    if name == "int" { return tInt }
    if name == "byte" { return tByte }
    if name == "bool" { return tBool }
    if name == "string" { return tString }
    if name == "Result" {
        if sym != T_LBRACK { error("Result needs a type: write Result[T]") }
        next()
        let b = symParseType()
        expect(T_RBRACK, "")
        rejectFn(b, "Result cannot hold a function value")
        return derived("result", b)
    }
    let s = findExport(symCurMod, name)
    if s != nil {
        if s.kind == "type" { return symType(s) }
    }
    errorAt("unknown type '" + name + "'", nline, ncol)
    return tVoid
}

fn symParseType(): ^Type {
    if sym == T_FN {
        next()
        if sym == T_LBRACK { error("a function type cannot have a capture list") }
        if sym != T_LPAREN { error("expected '(' after 'fn'") }
        next()
        let t = newFnType(tVoid)
        while sym != T_RPAREN {
            var mode = 0
            if sym == T_AMP { next(); mode = 1 }
            if sym != T_QUESTION && sym != T_LBRACK && sym != T_CARET && sym != T_FN && sym != T_IDENT {
                error("expected a parameter type")
            }
            let p = symParseType()
            if mode == 1 && !isOwned(p) { error("only records, closed types and arrays can be borrowed, not " + symTypeText(p)) }
            rejectIfaceFn(p)
            fnAddParam(t, p, mode)
            if sym != T_RPAREN {
                expect(T_COMMA, "',' or ')'")
                if sym == T_RPAREN { error("expected a parameter type") }
            }
        }
        expect(T_RPAREN, "")
        if sym == T_COLON {
            next()
            let r = symParseType()
            rejectFn(r, "a function type cannot return a function value")
            rejectIfaceFn(r)
            t.base = r
        }
        return t
    }
    if sym == T_QUESTION {
        next()
        let b = symParseType()
        rejectFn(b, "an optional cannot hold a function value; function values are parameters and locals only")
        if !nonNull(b) { error("only reference types can be optional, not " + symTypeText(b)) }
        return derived("opt", b)
    }
    if sym == T_LBRACK {
        next()
        expect(T_RBRACK, "")
        let b = symParseType()
        rejectFn(b, "an array cannot hold function values")
        return derived("array", b)
    }
    if sym == T_CARET {
        next()
        let b = symParseType()
        if b.kind != "record" && b.kind != "closed" {
            error("handles name records and closed types, not " + symTypeText(b))
        }
        return derived("handle", b)
    }
    if sym == T_REF || sym == T_CLOSED { error("record and closed types must be declared with 'type'") }
    if sym != T_IDENT { error("expected a type") }
    let nline = tline
    let ncol = tcol
    let name = ident()
    return symFinishTypeName(name, nline, ncol)
}

// parses { field: type; ... } into rec's (empty) field list, in declaration order
fn symFieldList(rec: ^Type) {
    expect(T_LBRACE, "")
    skipSemis()
    while sym != T_RBRACE {
        if sym != T_IDENT { error("expected a field name") }
        let fline = tline
        let fname = ident()
        if sym != T_COLON { errorAt("expected ':' after the field name", fline, 1) }
        next()
        let t = symParseType()
        rejectFn(t, "a record field cannot be a function value; function values are parameters and locals only")
        for i in 0..len(rec.fields) {
            if rec.fields[i].name == fname { error("duplicate field '" + fname + "'") }
        }
        append(rec.fields, new Field{name: fname, offset: 8 * len(rec.fields), typ: t})
        if sym == T_SEMI { next() } else if sym != T_RBRACE { error("expected ';' or '}'") }
        skipSemis()
    }
    expect(T_RBRACE, "")
}

fn symCompareFields(live: ^Type, parsed: ^Type, what: string) {
    if len(live.fields) != len(parsed.fields) { symDisagree(what) }
    for i in 0..len(live.fields) {
        if live.fields[i].name != parsed.fields[i].name { symDisagree(what) }
        if live.fields[i].offset != parsed.fields[i].offset { symDisagree(what) }
        if !same(live.fields[i].typ, parsed.fields[i].typ) { symDisagree(what) }
    }
}

fn symClaim(name: string) {
    if symHas(symSeen, name) { error("duplicate exported name '" + name + "'") }
    append(symSeen, name)
}

fn symDisagree(decl: string) {
    eprintln("obxc: symbol file '", srcPath, "' disagrees with the compiled interface of '",
             symCurMod.name, "' for ", decl, "; rebuild it")
    exit(2)
}

// the key of an implementation in a file's order and duplicate lists: 'I for T', I qualified when it is foreign
fn symImplKey(iface: ^Type, recv: ^Type): string { return symTypeText(iface) + " for " + recv.name }

fn symSameList(a: &[]string, b: &[]string): bool {
    if len(a) != len(b) { return false }
    for i in 0..len(a) {
        if a[i] != b[i] { return false }
    }
    return true
}

// the file's declaration groups must match the live module's, in order (build mode)
fn symCompareOrder() {
    let liveTypes = new []string(0)
    let liveAliases = new []string(0)
    let liveConsts = new []string(0)
    let liveGlobals = new []string(0)
    let liveFns = new []string(0)
    for i in 0..len(symCurMod.globals) {
        let s = symCurMod.globals[i]
        if !s.exported { continue }
        if s.kind == "type" {
            if symIsVariantSym(s) { continue }
            let t = symType(s)
            if symDefines(s, symCurMod.name) {
                if t.kind != "iface" { append(liveTypes, s.name) }
            } else {
                append(liveAliases, s.name)
            }
        } else if s.kind == "const" {
            append(liveConsts, s.name)
        } else if (s.kind == "var" || s.kind == "let") && s.storage == "global" {
            append(liveGlobals, s.name)
        } else if s.kind == "fn" {
            append(liveFns, s.name)
        }
    }
    if !symSameList(symShells, liveTypes) { symDisagree("the type declaration order") }
    // live definitions in definition-line order, matching the writer
    var liveDefs = new []string(0)
    var liveLines = new []int(0)
    for i in 0..len(symCurMod.globals) {
        let s = symCurMod.globals[i]
        if !s.exported || s.kind != "type" || symIsVariantSym(s) { continue }
        if symDefines(s, symCurMod.name) {
            append(liveDefs, s.name)
            append(liveLines, s.line)
        }
    }
    var d = 0
    while d < len(liveDefs) {
        var bestD = d
        for k in d + 1..len(liveDefs) {
            if liveLines[k] < liveLines[bestD] { bestD = k }
        }
        if bestD != d {
            let tn = liveDefs[d]
            liveDefs[d] = liveDefs[bestD]
            liveDefs[bestD] = tn
            let tl = liveLines[d]
            liveLines[d] = liveLines[bestD]
            liveLines[bestD] = tl
        }
        d += 1
    }
    if !symSameList(symDefined, liveDefs) { symDisagree("the type definition order") }
    if !symSameList(symAliasOrder, liveAliases) { symDisagree("the type alias order") }
    if !symSameList(symConstOrder, liveConsts) { symDisagree("the constant order") }
    if !symSameList(symGlobalOrder, liveGlobals) { symDisagree("the global order") }
    let liveMethods = new []string(0)
    for i in 0..len(methodSyms) {
        let m = methodSyms[i]
        if m.owner == symCurMod.name && m.exported { append(liveMethods, methodKey(m)) }
    }
    if !symSameList(symMethodOrder, liveMethods) { symDisagree("the method order") }
    let liveImpls = new []string(0)
    for i in 0..len(impls) {
        let im = impls[i]
        if im.owner == symCurMod.name && im.exported { append(liveImpls, symImplKey(im.iface, im.recv)) }
    }
    if !symSameList(symImplOrder, liveImpls) { symDisagree("the implementation order") }
    if !symSameList(symFnOrder, liveFns) { symDisagree("the function order") }
}

fn symFinish(mode: int) {
    let shells = &symShells
    for sh in shells {
        if !symHas(symDefined, sh) { error("type '" + sh + "' has a shell but no definition") }
    }
    if mode == 1 {
        for i in 0..len(symCurMod.globals) {
            let s = symCurMod.globals[i]
            if s.kind == "type" && symType(s).incomplete { error("type '" + s.name + "' has a shell but no definition") }
            if s.exported { append(symCurMod.exports, s) }
        }
        return
    }
    for i in 0..len(symCurMod.globals) {
        let s = symCurMod.globals[i]
        if s.exported && !symHas(symSeen, s.name) { symDisagree("exported '" + s.name + "'") }
    }
    for i in 0..len(methodSyms) {
        let m = methodSyms[i]
        if m.owner == symCurMod.name && m.exported && !symHas(symSeen, methodKey(m)) {
            symDisagree("method '" + methodKey(m) + "'")
        }
    }
    for i in 0..len(impls) {
        let im = impls[i]
        if im.owner == symCurMod.name && im.exported && !symHas(symImplSeen, symImplKey(im.iface, im.recv)) {
            symDisagree("implementation '" + symImplKey(im.iface, im.recv) + "'")
        }
    }
    symCompareOrder()
}

// A .sym interface definition (v3 8.1): `interface { members }` after `type I =`, with no shell line. Mode 1 registers
// the type before its members are read, so a member may name the interface itself. Mode 0 compares the members with
// the live interface, in order: name, marker, receiver and parameter modes, parameter types and result type.
// Member summaries are built by setMemberSummary, the helper the source path uses, so --check and a full build agree.
fn symIfaceDef(name: string, nline: int, mode: int) {
    if symHas(symShells, name) {
        error("an interface cannot be forward-declared: '" + name + "' is already declared")
    }
    if symHas(symDefined, name) { error("duplicate definition of type '" + name + "'") }
    symAfterShells = true
    symClaim(name)
    let key = keyOf(symCurMod.name, name)
    var t: ^Type = tVoid
    var live = new []^Sym(0)
    if mode == 1 {
        if typeAtKey(key) != nil { error("duplicate type key '" + key + "'") }
        let nt = newType("iface", name, nil)
        nt.owner = symCurMod.name
        nt.uid = fnv1a(key)
        nt.incomplete = true
        registerType(nt, symCurMod.name, name)
        let s = newSym("type", name, nt)
        s.owner = symCurMod.name
        s.exported = true
        s.line = nline
        append(symCurMod.globals, s)
        t = nt
    } else {
        let got = typeAtKey(key)
        if got == nil { symDisagree("interface '" + name + "'") }
        if got != nil { t = got }
        if t.uid != fnv1a(key) { symDisagree("interface '" + name + "'") }
        if t.kind != "iface" || t.incomplete { symDisagree("interface '" + name + "'") }
        let es = findExport(symCurMod, name)
        if es == nil { symDisagree("interface '" + name + "'") }
        if es != nil {
            if es.kind != "type" || symType(es) != t { symDisagree("interface '" + name + "'") }
        }
        live = ifaceMethodsOf(t)
    }
    expect(T_LBRACE, "")
    skipSemis()
    let names = new []string(0)
    var count = 0
    while sym != T_RBRACE {
        let mline = tline
        var pure = false
        var mutrecv = false
        if sym == T_IDENT && sval == "pure" { next(); pure = true }
        if sym == T_IDENT && sval == "mut" { next(); mutrecv = true }
        if sym == T_IDENT && (sval == "pure" || sval == "mut") {
            error("'pure' and 'mut' come before 'fn'")
        }
        if sym != T_FN { error("expected a method name in the interface") }
        next()
        if sym != T_IDENT { error("expected a method name in the interface") }
        let mname = ident()
        if symHas(names, mname) { error("duplicate interface method '" + mname + "'") }
        append(names, mname)
        // the receiver is parameter 0: borrowed for 'fn', mutable for 'mut fn'
        let ptypes = new []^Type(0)
        let pmodes = new []int(0)
        var recvMode = 1
        if mutrecv { recvMode = 2 }
        append(ptypes, t)
        append(pmodes, recvMode)
        expect(T_LPAREN, "")
        while sym != T_RPAREN {
            var pmut = false
            if sym == T_IDENT && sval == "mut" { next(); pmut = true }
            if sym != T_IDENT { error("expected a parameter name") }
            ident()                                       // parameter names are syntax only
            if sym != T_COLON { error("expected ':' after the parameter name") }
            next()
            var isref = false
            if sym == T_AMP { next(); isref = true }
            let pt = symParseType()
            if isref {
                if !isOwned(pt) { error("only records, closed types and arrays can be borrowed, not " + symTypeText(pt)) }
                if pmut { append(pmodes, 2) } else { append(pmodes, 1) }
            } else {
                if pmut { error("mut needs a reference parameter: write mut p0: &T") }
                append(pmodes, 0)
            }
            rejectFn(pt, "an interface method cannot use a function value; function types are not supported in interfaces")
            append(ptypes, pt)
            if sym != T_RPAREN { expect(T_COMMA, "',' or ')'") }
        }
        expect(T_RPAREN, "")
        var ret = tVoid
        if sym == T_COLON {
            next()
            ret = symParseType()
        }
        rejectFn(ret, "an interface method cannot use a function value; function types are not supported in interfaces")
        let what = "interface method '" + name + "::" + mname + "'"
        if mode == 1 {
            let m = newSym("ifn", mname, nil)
            m.fnRec = newFnRec()
            for k in 0..len(ptypes) {
                append(m.fnRec.params, ptypes[k])
                append(m.fnRec.pmodes, pmodes[k])
            }
            m.ret = ret
            m.owner = symCurMod.name
            m.exported = true
            m.recv = t
            m.line = mline
            m.addr = 0
            m.pureMember = pure
            setMemberSummary(m, pure)
            append(ifaceSyms, m)
        } else {
            if count >= len(live) { symDisagree(what) }
            let lm = live[count]
            if lm.name != mname || lm.pureMember != pure { symDisagree(what) }
            if len(lm.fnRec.params) != len(ptypes) { symDisagree(what) }
            for k in 0..len(ptypes) {
                if !same(lm.fnRec.params[k], ptypes[k]) || lm.fnRec.pmodes[k] != pmodes[k] { symDisagree(what) }
            }
            if !same(lm.ret, ret) { symDisagree(what) }
        }
        count += 1
        if sym == T_SEMI { next() } else if sym != T_RBRACE { error("expected ';' or '}'") }
        skipSemis()
    }
    expect(T_RBRACE, "")
    if count == 0 { error("an interface needs at least one method") }
    if mode == 1 {
        t.incomplete = false
    } else if count != len(live) {
        symDisagree("interface '" + name + "'")
    }
    append(symDefined, name)
}

// a type alias (the name is claimed before its type is read, as the writer's order needs). lead is the first name of
// the type when the caller has read it already, or "" to read the whole type here (B7: it never names or changes a Type)
fn symAlias(name: string, nline: int, mode: int, lead: string, lline: int, lcol: int) {
    symAfterShells = true
    if symHas(symShells, name) {
        if len(lead) == 0 && sym == T_FN {
            error("a function type cannot be forward-declared: '" + name + "' is already declared as a forward type")
        }
        if len(lead) > 0 {
            let es = findExport(symCurMod, lead)
            if es != nil && es.kind == "type" && containsFn(symType(es)) {
                error("a function type cannot be forward-declared: '" + name + "' is already declared as a forward type")
            }
            if sym == T_COLONCOLON {
                var m = symModuleByName(lead)
                if m == nil { m = moduleByName(lead) }
                if m != nil {
                    let qt = symFinishTypeName(lead, lline, lcol)
                    if containsFn(qt) {
                        error("a function type cannot be forward-declared: '" + name + "' is already declared as a forward type")
                    }
                }
                error("duplicate exported name '" + name + "'")
            }
        }
    }
    symClaim(name)
    var t: ^Type = tVoid
    if len(lead) > 0 { t = symFinishTypeName(lead, lline, lcol) } else { t = symParseType() }
    append(symAliasOrder, name)
    if mode == 1 {
        let key = keyOf(symCurMod.name, name)
        if typeAtKey(key) != nil { error("duplicate type key '" + key + "'") }
        registerTypeAlias(symCurMod.name, name, t)
        let s = newSym("type", name, t)
        s.owner = symCurMod.name
        s.exported = true
        s.line = nline
        append(symCurMod.globals, s)
        return
    }
    let es = findExport(symCurMod, name)
    if es == nil { symDisagree("type '" + name + "'") }
    if es != nil {
        if es.kind != "type" || !same(symType(es), t) { symDisagree("type '" + name + "'") }
    }
}

fn symTypeDecl(mode: int) {
    let nline = tline
    if sym != T_IDENT { error("expected a type name") }
    let name = ident()
    if sym == T_IDENT && sval == "uid" {
        if symAfterShells { error("a type shell must come before every definition") }
        if symHas(symShells, name) { error("duplicate type '" + name + "'") }
        next()
        let uid = symHex16("type uid")
        symClaim(name)
        append(symShells, name)
        if mode == 1 {
            let key = keyOf(symCurMod.name, name)
            if typeAtKey(key) != nil { error("duplicate type key '" + key + "'") }
            if uid != fnv1a(key) { error("type '" + name + "' uid does not match its key") }
            let t = newType("record", name, nil)
            t.owner = symCurMod.name
            t.uid = uid
            t.incomplete = true
            registerType(t, symCurMod.name, name)
            let s = newSym("type", name, t)
            s.owner = symCurMod.name
            s.exported = true
            s.line = nline
            append(symCurMod.globals, s)
            return
        }
        let got = typeAtKey(keyOf(symCurMod.name, name))
        if got == nil { symDisagree("type '" + name + "'") }
        var t: ^Type = tVoid
        if got != nil { t = got }
        if t.uid != uid { symDisagree("type '" + name + "'") }
        if t.kind != "record" && t.kind != "closed" { symDisagree("type '" + name + "'") }
        if t.incomplete { symDisagree("type '" + name + "'") }
        let es = findExport(symCurMod, name)
        if es == nil { symDisagree("type '" + name + "'") }
        if es != nil {
            if es.kind != "type" || symType(es) != t { symDisagree("type '" + name + "'") }
        }
        return
    }
    if sym != T_ASSIGN { error("expected 'uid' or '=' after a type name") }
    next()
    if sym == T_REF {
        if !symHas(symShells, name) { error("type '" + name + "' has a definition but no shell") }
        if symHas(symDefined, name) { error("duplicate definition of type '" + name + "'") }
        symAfterShells = true
        next()
        expect(T_RECORD, "")
        append(symDefined, name)
        let got = typeAtKey(keyOf(symCurMod.name, name))
        if mode == 1 {
            if got == nil { error("unknown type key '" + keyOf(symCurMod.name, name) + "'") }
            var t: ^Type = tVoid
            if got != nil { t = got }
            if !t.incomplete { error("duplicate definition of type '" + name + "'") }
            t.kind = "record"
            symFieldList(t)
            t.incomplete = false
            t.desc = 0
            let ds = findExport(symCurMod, name)
            if ds != nil { ds.line = nline }
            return
        }
        if got == nil { symDisagree("type '" + name + "'") }
        var t: ^Type = tVoid
        if got != nil { t = got }
        if t.kind != "record" || t.incomplete { symDisagree("type '" + name + "'") }
        let tmp = newType("record", "", nil)
        symFieldList(tmp)
        symCompareFields(t, tmp, "type '" + name + "'")
        return
    }
    if sym == T_CLOSED {
        if !symHas(symShells, name) { error("type '" + name + "' has a definition but no shell") }
        if symHas(symDefined, name) { error("duplicate definition of type '" + name + "'") }
        symAfterShells = true
        next()
        expect(T_LBRACE, "")
        let ctgot = typeAtKey(keyOf(symCurMod.name, name))
        var ct: ^Type = tVoid
        if ctgot == nil {
            if mode == 1 { error("unknown type key '" + keyOf(symCurMod.name, name) + "'") }
            symDisagree("type '" + name + "'")
        }
        if ctgot != nil { ct = ctgot }
        if mode == 1 {
            if !ct.incomplete { error("duplicate definition of type '" + name + "'") }
            ct.kind = "closed"
            ct.variants = new []^Type(0)
        } else {
            if ct.kind != "closed" || ct.incomplete { symDisagree("type '" + name + "'") }
        }
        var vi = 0
        skipSemis()
        while sym != T_RBRACE {
            if sym != T_IDENT { error("expected a variant name") }
            let vline = tline
            let vname = ident()
            if mode == 1 {
                let vkey = keyOf(symCurMod.name, vname)
                if typeAtKey(vkey) != nil { error("duplicate type key '" + vkey + "'") }
                if symHas(symSeen, vname) { error("duplicate exported name '" + vname + "'") }
                let v = newType("record", vname, nil)
                v.owner = symCurMod.name
                v.uid = fnv1a(vkey)
                v.parent = ct
                registerType(v, symCurMod.name, vname)
                let vs = newSym("type", vname, v)
                vs.owner = symCurMod.name
                vs.exported = true
                vs.line = vline
                append(symCurMod.globals, vs)
                append(symSeen, vname)
                symFieldList(v)
                v.desc = 0
                append(ct.variants, v)
            } else {
                if vi >= len(ct.variants) { symDisagree("variant '" + vname + "'") }
                let v = ct.variants[vi]
                if v.name != vname { symDisagree("variant '" + vname + "'") }
                let vtmp = newType("record", "", nil)
                symFieldList(vtmp)
                symCompareFields(v, vtmp, "variant '" + vname + "'")
                let vs = findExport(symCurMod, vname)
                if vs == nil { symDisagree("variant '" + vname + "'") }
                if vs != nil {
                    if vs.kind != "type" || symType(vs) != v { symDisagree("variant '" + vname + "'") }
                }
                append(symSeen, vname)
                vi += 1
            }
            if sym == T_SEMI { next() }
            skipSemis()
        }
        expect(T_RBRACE, "")
        if mode == 1 {
            if len(ct.variants) == 0 { error("a closed type needs at least one variant") }
            ct.incomplete = false
            ct.desc = 0
            let ds = findExport(symCurMod, name)
            if ds != nil { ds.line = nline }
        } else if vi != len(ct.variants) {
            symDisagree("type '" + name + "'")
        }
        append(symDefined, name)
        return
    }
    // an interface definition (no shell line), or a type alias: an alias maps the name to the underlying Type and
    // never names or changes one (B7)
    if sym == T_IDENT {
        let w = sval
        let wline = tline
        let wcol = tcol
        next()
        if w == "interface" && sym == T_LBRACE {
            symIfaceDef(name, nline, mode)
            return
        }
        symAlias(name, nline, mode, w, wline, wcol)
        return
    }
    symAlias(name, nline, mode, "", 0, 0)
}

fn symConstDecl(mode: int) {
    if sym != T_IDENT { error("expected a constant name") }
    let nline = tline
    let name = ident()
    if sym != T_COLON { error("expected ':' in a constant declaration") }
    next()
    let t = symParseType()
    rejectFn(t, "a constant cannot hold a function value")
    if sym != T_ASSIGN { error("expected '=' in a constant declaration") }
    next()
    var kind = ""
    var v = 0
    var sv = ""
    if sym == T_INT {
        kind = "int"
        v = ival
        next()
    } else if sym == T_TRUE {
        kind = "bool"
        v = 1
        next()
    } else if sym == T_FALSE {
        kind = "bool"
        v = 0
        next()
    } else if sym == T_IDENT && sval == "hex" {
        kind = "string"
        next()
        if sym != T_STRING { error("expected a quoted hex byte string") }
        sv = symHexString(sval)
        next()
    } else {
        error("expected a constant value")
    }
    if t != tInt && t != tByte && t != tBool && t != tString {
        error("a constant must have type int, byte, bool or string")
    }
    if t == tString && kind != "string" { error("a string constant needs a hex byte string") }
    if t == tBool && kind != "bool" { error("a bool constant must be true or false") }
    if (t == tInt || t == tByte) && kind != "int" { error("an integer constant needs an integer value") }
    if t == tByte && (v < 0 || v > 255) { error("a byte constant must be between 0 and 255") }
    symClaim(name)
    append(symConstOrder, name)
    if mode == 1 {
        let s = newSym("const", name, t)
        s.owner = symCurMod.name
        s.exported = true
        s.line = nline
        if t == tString { s.value = stringLit(sv) } else { s.value = v }
        append(symCurMod.globals, s)
        return
    }
    let es = findExport(symCurMod, name)
    if es == nil { symDisagree("const '" + name + "'") }
    if es != nil {
        if es.kind != "const" || !same(symType(es), t) { symDisagree("const '" + name + "'") }
        if t == tString {
            if rodataString(es.value) != sv { symDisagree("const '" + name + "'") }
        } else if es.value != v {
            symDisagree("const '" + name + "'")
        }
    }
}

fn symGlobalDecl(mode: int, kind: string) {
    if sym != T_IDENT { error("expected a global name") }
    let nline = tline
    let name = ident()
    if sym != T_COLON { error("expected ':' in a global declaration") }
    next()
    let t = symParseType()
    rejectFn(t, "a function value cannot be a global; it is a parameter or a local")
    symClaim(name)
    append(symGlobalOrder, name)
    if mode == 1 {
        let g = globalSym(symCurMod.name, name)
        if g.typ != nil { error("duplicate global '" + name + "'") }
        g.kind = kind
        g.typ = t
        g.offset = SYM_DUMMY_BASE + 8 * symDummyGlobals
        symDummyGlobals += 1
        g.exported = true
        g.line = nline
        append(symCurMod.globals, g)
        return
    }
    let es = findExport(symCurMod, name)
    if es == nil { symDisagree(kind + " '" + name + "'") }
    if es != nil {
        if es.kind != kind || !same(symType(es), t) || es.storage != "global" {
            symDisagree(kind + " '" + name + "'")
        }
    }
}

fn symFnDecl(mode: int) {
    var isMethod = false
    var recvType = tVoid
    var recvMode = 0
    if sym == T_LPAREN {
        // a method: fn ([mut] name: [&] Type) name(...)
        isMethod = true
        next()
        var pmut = false
        if sym == T_IDENT && sval == "mut" { pmut = true; next() }
        if sym != T_IDENT { error("expected a receiver name") }
        ident()                                        // the receiver's name is syntax only
        if sym != T_COLON { error("expected ':' after the receiver name") }
        next()
        var isref = false
        if sym == T_AMP { next(); isref = true }
        if pmut {
            if !isref { error("mut needs a reference parameter: write mut p0: &T") }
            recvMode = 2
        } else if isref {
            recvMode = 1
        }
        var spelling = ""
        if sym == T_IDENT { spelling = sval }
        recvType = symParseType()
        expect(T_RPAREN, "")
        if isref && !isOwned(recvType) {
            error("only records, closed types and arrays can be borrowed, not " + symTypeText(recvType))
        }
        if recvType.kind != "record" && recvType.kind != "closed" {
            error("the receiver must be a record or closed type defined in this module, not " + symTypeText(recvType))
        }
        if recvType.owner == "" || recvType.owner != symCurMod.name {
            error("the receiver must be the defining name of a type in this module")
        }
        let rpar = recvType.parent
        if rpar != nil {
            error("the receiver cannot be a variant; declare the method on '" + rpar.name + "'")
        }
        if recvType.name != spelling {
            error("the receiver must be the defining name of a type in this module")
        }
    }
    if sym != T_IDENT { error("expected a function name") }
    let nline = tline
    let name = ident()
    if isMethod && !symHas(symDefined, recvType.name) {
        error("method '" + recvType.name + "::" + name + "' comes before the definition of type '" + recvType.name + "'")
    }
    if !isMethod && name == "main" {
        eprintln(srcPath, ":", nline, ":", 1, ": module '", symCurMod.name,
                 "' may not declare 'main'; the program root provides it")
        exit(1)
    }
    if sym != T_LPAREN { error("expected '(' after the function name") }
    next()
    let ptypes = new []^Type(0)
    let pmodes = new []int(0)
    if isMethod {
        append(ptypes, recvType)
        append(pmodes, recvMode)
    }
    while sym != T_RPAREN {
        var pmut = false
        if sym == T_IDENT && sval == "mut" { pmut = true; next() }
        if sym != T_IDENT { error("expected a parameter name") }
        ident()                                       // parameter names are syntax only
        if sym != T_COLON { error("expected ':' after the parameter name") }
        next()
        if sym == T_AMP {
            next()
            let t = symParseType()
            if !isOwned(t) { error("only records, closed types and arrays can be borrowed, not " + symTypeText(t)) }
            append(ptypes, t)
            if pmut { append(pmodes, 2) } else { append(pmodes, 1) }
        } else {
            if pmut { error("mut needs a reference parameter: write mut p0: &T") }
            append(ptypes, symParseType())
            append(pmodes, 0)
        }
        if sym != T_RPAREN { expect(T_COMMA, "',' or ')'") }
    }
    expect(T_RPAREN, "")
    var ret = tVoid
    if sym == T_COLON {
        next()
        ret = symParseType()
    }
    rejectFn(ret, "a function cannot return a function value; function values are parameters and locals only")
    var freesAll = false
    var writesHandles = false
    var pfree = 0
    var hasPfree = false
    var hasFrees = false
    let freedOwners = new []string(0)
    let freedNames = new []string(0)
    let rowIdx = new []int(0)
    let rowEv = new []string(0)
    while sym == T_IDENT {
        let w = sval
        if w == "freesall" {
            if freesAll { error("duplicate 'freesall'") }
            freesAll = true
            next()
        } else if w == "writeshandles" {
            if writesHandles { error("duplicate 'writeshandles'") }
            writesHandles = true
            next()
        } else if w == "pfree" {
            if hasPfree { error("duplicate 'pfree'") }
            next()
            pfree = symIntTok()
            hasPfree = true
        } else if w == "frees" {
            if hasFrees { error("duplicate 'frees'") }
            next()
            let cnt = symIntTok()
            if cnt > len(src) - pos { error("a frees count is larger than the rest of the file") }
            for k in 0..cnt {
                if sym != T_IDENT { error("expected a global name in the frees list") }
                let owner = ident()
                if sym != T_COLONCOLON { error("expected '::' in a frees global key") }
                next()
                if sym != T_IDENT { error("expected a global name after '::'") }
                let member = ident()
                for k2 in 0..len(freedOwners) {
                    if freedOwners[k2] == owner && freedNames[k2] == member {
                        error("duplicate frees key '" + keyOf(owner, member) + "'")
                    }
                }
                append(freedOwners, owner)
                append(freedNames, member)
            }
            hasFrees = true
        } else if w == "pf" {
            next()
            let pi = symIntTok()
            if pi < 0 || pi >= len(ptypes) { error("pf index " + string(pi) + " is out of range") }
            if sym != T_STRING { error("pf needs an event string") }
            let ev = sval
            next()
            symValidateEvent(ev)
            for k2 in 0..len(rowIdx) {
                if rowIdx[k2] == pi && rowEv[k2] == ev { error("duplicate pf row") }
            }
            append(rowIdx, pi)
            append(rowEv, ev)
        } else {
            error("unknown summary item '" + w + "'")
        }
    }
    // pfree is a 62-bit mask; bits 62 and 63 are ignored (parameters from 62 on are always
    // assumed to free), and every row below 62 and its bit agree
    let low = pfree & 0x3FFFFFFFFFFFFFFF
    if len(ptypes) < 62 {
        var i = len(ptypes)
        while i < 62 {
            if (low >> i) & 1 == 1 { error("pfree has a bit for parameter " + string(i) + ", which does not exist") }
            i += 1
        }
    }
    for i in 0..len(rowIdx) {
        let pi = rowIdx[i]
        if pi < 62 && (low >> pi) & 1 == 0 {
            error("pf row for parameter " + string(pi) + " has no pfree bit")
        }
    }
    var i = 0
    while i < len(ptypes) && i < 62 {
        if (low >> i) & 1 == 1 {
            var have = false
            for k2 in 0..len(rowIdx) {
                if rowIdx[k2] == i { have = true }
            }
            if !have { error("pfree bit " + string(i) + " has no pf row") }
        }
        i += 1
    }
    if isMethod {
        let key = recvType.name + "::" + name
        let what = "method '" + key + "'"
        symClaim(key)
        append(symMethodOrder, key)
        if mode == 1 {
            let f = newSym("fn", name, nil)
            f.fnRec = newFnRec()
            for k in 0..len(ptypes) {
                append(f.fnRec.params, ptypes[k])
                append(f.fnRec.pmodes, pmodes[k])
            }
            f.ret = ret
            f.freesAll = freesAll
            f.writesHandles = writesHandles
            f.fnRec.pfree = low
            f.addr = 0
            f.owner = symCurMod.name
            f.exported = true
            f.line = nline
            f.recv = recvType
            for k in 0..len(freedOwners) {
                append(f.fnRec.freed, globalSym(freedOwners[k], freedNames[k]))
            }
            for k in 0..len(rowIdx) {
                append(pfFn, f)
                append(pfIdx, rowIdx[k])
                append(pfEv, rowEv[k])
            }
            append(methodSyms, f)
            return
        }
        let lm = findMethodIn(recvType, name)
        if lm == nil { symDisagree(what) }
        if lm != nil {
            if !lm.exported || lm.recv != recvType { symDisagree(what) }
            if lm.kind != "fn" { symDisagree(what) }
            if len(lm.fnRec.params) != len(ptypes) { symDisagree(what) }
            for k in 0..len(ptypes) {
                if !same(lm.fnRec.params[k], ptypes[k]) || lm.fnRec.pmodes[k] != pmodes[k] {
                    symDisagree(what)
                }
            }
            if !same(lm.ret, ret) { symDisagree(what) }
            if lm.freesAll != freesAll || lm.writesHandles != writesHandles { symDisagree(what) }
            if lm.fnRec.pfree != low { symDisagree(what) }
            if len(lm.fnRec.freed) != len(freedOwners) { symDisagree(what) }
            for k in 0..len(freedOwners) {
                let g = globalAtKey(keyOf(freedOwners[k], freedNames[k]))
                if g == nil || lm.fnRec.freed[k] != g { symDisagree(what) }
            }
            var r = 0
            for k in 0..len(ptypes) {
                for q in 0..len(pfFn) {
                    if pfFn[q] == lm && pfIdx[q] == k {
                        if r >= len(rowIdx) || rowIdx[r] != k || rowEv[r] != pfEv[q] { symDisagree(what) }
                        r += 1
                    }
                }
            }
            if r != len(rowIdx) { symDisagree(what) }
        }
        return
    }
    symClaim(name)
    append(symFnOrder, name)
    if mode == 1 {
        let f = newSym("fn", name, nil)
        f.fnRec = newFnRec()
        for k in 0..len(ptypes) {
            append(f.fnRec.params, ptypes[k])
            append(f.fnRec.pmodes, pmodes[k])
        }
        f.ret = ret
        f.freesAll = freesAll
        f.writesHandles = writesHandles
        f.fnRec.pfree = low
        f.addr = 0                                    // known: a complete imported summary, never a forward heading
        f.owner = symCurMod.name
        f.exported = true
        f.line = nline
        for k in 0..len(freedOwners) {
            append(f.fnRec.freed, globalSym(freedOwners[k], freedNames[k]))
        }
        for k in 0..len(rowIdx) {
            append(pfFn, f)
            append(pfIdx, rowIdx[k])
            append(pfEv, rowEv[k])
        }
        append(symCurMod.globals, f)
        return
    }
    let es = findExport(symCurMod, name)
    if es == nil { symDisagree("fn '" + name + "'") }
    if es != nil {
        if es.kind != "fn" { symDisagree("fn '" + name + "'") }
        if len(es.fnRec.params) != len(ptypes) { symDisagree("fn '" + name + "'") }
        for k in 0..len(ptypes) {
            if !same(es.fnRec.params[k], ptypes[k]) || es.fnRec.pmodes[k] != pmodes[k] {
                symDisagree("fn '" + name + "'")
            }
        }
        if !same(es.ret, ret) { symDisagree("fn '" + name + "'") }
        if es.freesAll != freesAll || es.writesHandles != writesHandles { symDisagree("fn '" + name + "'") }
        if es.fnRec.pfree != low { symDisagree("fn '" + name + "'") }
        if len(es.fnRec.freed) != len(freedOwners) { symDisagree("fn '" + name + "'") }
        for k in 0..len(freedOwners) {
            let g = globalAtKey(keyOf(freedOwners[k], freedNames[k]))
            if g == nil || es.fnRec.freed[k] != g { symDisagree("fn '" + name + "'") }
        }
        var r = 0
        for k in 0..len(ptypes) {
            for q in 0..len(pfFn) {
                if pfFn[q] == es && pfIdx[q] == k {
                    if r >= len(rowIdx) || rowIdx[r] != k || rowEv[r] != pfEv[q] { symDisagree("fn '" + name + "'") }
                    r += 1
                }
            }
        }
        if r != len(rowIdx) { symDisagree("fn '" + name + "'") }
    }
}

// A .sym implementation line (v3 8.1): impl I for R, R the defining name of a record or closed type of this module.
// The reader does not re-run the tier check (7.2): the defining module checked it when it compiled the impl, and an
// importer trusts that check. Mode 1 records the pair; mode 0 requires the live exported impl of the same pair.
fn symImplDecl(mode: int) {
    let nline = tline
    let it = symParseType()
    if it.kind != "iface" { error("'" + symTypeText(it) + "' is not an interface type") }
    expect(T_FOR, "")
    if sym != T_IDENT { error("expected a receiver type name") }
    let rname = ident()
    let found = findExport(symCurMod, rname)
    if found == nil {
        error("the receiver of an implementation must be the defining name of a type in this module")
        return
    }
    let rt = symType(found)
    if rt.owner != symCurMod.name || rt.name != rname {
        error("the receiver of an implementation must be the defining name of a type in this module")
    }
    if rt.incomplete { error("type '" + rname + "' is declared but not yet defined") }
    if rt.kind != "record" && rt.kind != "closed" {
        error("the receiver of an implementation must be a type defined in this module")
    }
    if rt.parent != nil {
        error("an implementation's receiver cannot be a variant; use its closed type")
    }
    let key = symImplKey(it, rt)                   // rt.name is rname here: a mismatch exited above
    if symHas(symImplSeen, key) {
        error("duplicate implementation of '" + symTypeText(it) + "' for '" + rname + "'")
    }
    append(symImplSeen, key)
    append(symImplOrder, key)
    if mode == 1 {
        append(implArena, new Impl{iface: it, recv: rt, owner: symCurMod.name, exported: true, line: nline, vtable: 0})
        append(impls, handle(implArena[len(implArena) - 1]))
        return
    }
    let live = findImplIn(rt, it)
    if live == nil || !live.exported { symDisagree("implementation '" + key + "'") }
}

fn symReadDecls(mode: int) {
    skipSemis()
    while sym != T_EOF {
        if sym == T_TYPE {
            next()
            symTypeDecl(mode)
        } else if sym == T_CONST {
            next()
            symConstDecl(mode)
        } else if sym == T_VAR || sym == T_LET {
            let kind = tokName(sym)
            next()
            symGlobalDecl(mode, kind)
        } else if sym == T_FN {
            next()
            symFnDecl(mode)
        } else if sym == T_IDENT && sval == "impl" {
            next()
            symImplDecl(mode)
        } else {
            error("expected a declaration")
        }
        symLineEnd()
        skipSemis()
    }
}

// a dependency's source candidate for transitive staleness: its dep path as written,
// relative to the importing source's directory and then the -I directories
fn symDepSource(depPath: string, parentSrc: string): string {
    if len(parentSrc) == 0 { return "" }
    return findSource(depPath, dirOf(parentSrc))
}

// A dependency's source, present in check mode: validate its header and return its FNV hash.
// This is a source-level check, so its errors are source errors (exit 1), not .sym errors.
fn validateDepSource(path: string, expected: string, display: string): int {
    let data = readFile(path)
    if data == nil { return 0 }
    symSrcFound = true
    let ss = saveScan()
    let savedSymMode = symMode
    let savedPath = srcPath
    symMode = false
    srcPath = path
    let h = fnvBytes(&data)
    startScanner(data)
    skipSemis()
    if sym != T_MODULE {
        errorAt("imported module '" + display + "' needs a 'module Name' header", tline, tcol)
    }
    let nline = tline
    next()
    if sym != T_IDENT { error("expected a module name") }
    let name = ident()
    if name == "_root" { errorAt("module '_root' is reserved for the program root", nline, 1) }
    if name != expected {
        errorAt("module '" + name + "' must be in a file named " + name + ".obx (found " + display + ")", 1, 1)
    }
    symMode = savedSymMode
    srcPath = savedPath
    restoreScan(ss)
    return h
}

// Reads and validates one .sym. mode 0 validates a full build against the live module;
// mode 1 reconstructs the interface for --check and a source-less dependency.
fn readSym(symPath: string, expected: string, mode: int, display: string, srcCandidate: string): ^Module {
    if mode == 1 {
        let have = symModuleByName(expected)
        if have != nil { return have }
    }
    let loading = &symLoadNames
    for n in loading {
        if n == expected { symFileFail(symPath, "is corrupt (interface cycle); rebuild it") }
    }
    append(symLoadNames, expected)
    var srcHash = 0
    var srcFound = false
    if len(srcCandidate) > 0 {
        symSrcFound = false
        srcHash = validateDepSource(srcCandidate, expected, display)
        srcFound = symSrcFound
    }
    let data = readFile(symPath)
    if data == nil {
        eprintln("obxc: no symbol file for module '", expected, "' in ", symDir, "; run a build first")
        exit(2)
    }
    let ss = saveScan()
    let savedSymMode = symMode
    srcPath = symPath
    symMode = true
    startScanner(data)
    skipSemis()
    symWord("obosym")
    let fmt = symIntTok()
    symLineEnd()
    if fmt != SYM_FORMAT {
        symFileFail(symPath, "has format " + string(fmt) + "; this compiler reads " + string(SYM_FORMAT) + "; rebuild it")
    }
    symWord("abi")
    let abi = symIntTok()
    symLineEnd()
    if abi != SYM_ABI {
        symFileFail(symPath, "has ABI " + string(abi) + "; this compiler uses " + string(SYM_ABI) + "; rebuild it")
    }
    symWord("compiler")
    if sym != T_STRING { error("expected the compiler version") }
    let cv = sval
    next()
    symLineEnd()
    if cv != OBO_VERSION {
        symFileFail(symPath, "was built by compiler '" + cv + "'; this is '" + OBO_VERSION + "'; rebuild it")
    }
    symWord("source")
    let fileSrc = symHex16("source hash")
    symLineEnd()
    let depNames = new []string(0)
    let depPaths = new []string(0)
    let depHashes = new []int(0)
    while sym == T_IDENT && sval == "dep" {
        next()
        if sym != T_IDENT { error("expected a dependency module name") }
        let dn = ident()
        if sym != T_STRING { error("expected a quoted dependency path") }
        let dp = sval
        if len(dp) == 0 { error("a dependency path cannot be empty") }
        next()
        symLineEnd()
        let known = &depNames
        for d in known {
            if d == dn { error("duplicate dependency '" + dn + "'") }
        }
        append(depNames, dn)
        append(depPaths, dp)
        append(depHashes, 0)
    }
    symWord("interface")
    let ifaceH = symHex16("interface hash")
    if sym != T_SEMI && sym != T_EOF { error("expected the end of the line") }
    let bodyStart = pos
    let computed = fnvRange(src, bodyStart, len(src))
    if computed != ifaceH { symFileFail(symPath, "is corrupt (interface hash); rebuild it") }
    next()
    if sym != T_MODULE { error("expected 'module'") }
    next()
    if sym != T_IDENT { error("expected the module name") }
    let bodyName = ident()
    symLineEnd()
    if bodyName == "_root" { symSourceRule("module '_root' is reserved for the program root") }
    if bodyName != expected {
        symSourceRule("module '" + bodyName + "' must be in a file named " + bodyName + ".obx (found " + display + ")")
    }
    let depIfNames = new []string(0)
    let depIfHashes = new []int(0)
    while sym == T_IDENT && sval == "depiface" {
        next()
        if sym != T_IDENT { error("expected a dependency module name") }
        let dn = ident()
        let dh = symHex16("dependency interface hash")
        symLineEnd()
        append(depIfNames, dn)
        append(depIfHashes, dh)
    }
    if len(depIfNames) != len(depNames) {
        error("the depiface lines do not match the dep lines")
    }
    for i in 0..len(depIfNames) {
        if depIfNames[i] != depNames[i] {
            error("the depiface lines are not in the dependency order")
        }
    }
    for i in 0..len(depIfNames) {
        let dn = depIfNames[i]
        var dm: ^Module = handle(noModule)
        if mode == 1 {
            let cand = symDepSource(depPaths[i], srcCandidate)
            dm = loadSymCheck(joinDirPath(symDir, dn + ".sym"), dn, depPaths[i], cand)
        } else {
            let found = moduleByName(dn)
            if found == nil {
                symFileFail(symPath, "is corrupt (dependency '" + dn + "' is not part of this build); rebuild it")
            }
            if found != nil { dm = found }
        }
        if dm.ifaceHash != depIfHashes[i] {
            symFileFail(symPath, "depends on '" + dn + "' with interface hash " + hex16Of(depIfHashes[i]) +
                       ", but '" + dn + "' has " + hex16Of(dm.ifaceHash) + "; rebuild the dependent module")
        }
        depHashes[i] = depIfHashes[i]
    }
    var m: ^Module = handle(noModule)
    if mode == 1 {
        if srcFound && srcHash != fileSrc {
            symFail("symbol file '" + symPath + "' is stale: '" + srcCandidate +
                    "' changed since it was built; run a build")
        }
        let other = moduleByName(bodyName)
        if other != nil {
            symSourceRule("module '" + bodyName + "' is declared by both " + other.path + " and " + symPath)
        }
        let nm = new Module{name: bodyName, path: symPath, srcPath: srcCandidate, dir: dirOf(symPath),
                            hasHeader: true, isRoot: false, compiled: true, ifaceOnly: true, symLoaded: true,
                            srcHash: fileSrc, ifaceHash: ifaceH, globals: new []^Sym(0),
                            exports: new []^Sym(0), imports: new []Import(0),
                            symDepNames: depNames, symDepPaths: depPaths, symDepHashes: depHashes}
        append(modules, nm)
        m = handle(modules[len(modules) - 1])
    } else {
        drop(depNames)
        drop(depPaths)
        drop(depHashes)
        let found = moduleByName(bodyName)
        if found == nil { symFileFail(symPath, "is corrupt (no compiled module '" + bodyName + "'); rebuild it") }
        if found != nil { m = found }
        if m.srcHash != fileSrc {
            symFail("symbol file '" + symPath + "' is stale: '" + m.srcPath +
                    "' changed since it was built; run a build")
        }
    }
    symCurMod = m
    symSeen = new []string(0)
    symShells = new []string(0)
    symDefined = new []string(0)
    symAliasOrder = new []string(0)
    symConstOrder = new []string(0)
    symGlobalOrder = new []string(0)
    symMethodOrder = new []string(0)
    symFnOrder = new []string(0)
    symImplOrder = new []string(0)
    symImplSeen = new []string(0)
    symAfterShells = false
    symReadDecls(mode)
    symFinish(mode)
    restoreScan(ss)
    symMode = savedSymMode
    truncate(symLoadNames, len(symLoadNames) - 1)
    return m
}

fn loadSymCheck(symPath: string, expected: string, display: string, srcCandidate: string): ^Module {
    let have = symModuleByName(expected)
    if have != nil { return have }
    return readSym(symPath, expected, 1, display, srcCandidate)
}

// --reemit-sym FILE: read a .sym with the reader and print its canonical re-emission, so a
// writer/reader round-trip can be compared byte-for-byte (tests/sym_test.py)
fn reemitSym(path: string) {
    let bname = baseNameOf(path)
    if !endsWith(bname, ".sym") {
        eprintln("obxc: --reemit-sym needs a .sym file")
        exit(2)
    }
    let name = substr(bname, 0, len(bname) - 4)
    symDir = dirOf(path)
    if len(symDir) == 0 { symDir = "." }
    checking = true
    let m = loadSymCheck(path, name, name, "")
    let text = symText(m)
    print(string(text))
}

fn releaseTables() {
    symArena = new []Sym(0)
    methodSyms = new []^Sym(0)
    fnStack = new []^Sym(0)
    lambdaOuterNames = new []string(0)
    inWhileCond = false
    typeArena = new []Type(0)
    bindArena = new []RefBind(0)
    universe = new []^Sym(0)
    modules = new []Module(0)
    programGlobals = new []^Sym(0)
    visibleGlobals = new []^Sym(0)
    importStack = new []^Module(0)
    closureSeen = new []^Type(0)
    strKeys = new []string(0)
    strAddrs = new []int(0)
    typeKeys = new []string(0)
    typeRegistry = new []^Type(0)
    globalKeys = new []string(0)
    globalRegistry = new []^Sym(0)
    symLoadNames = new []string(0)
    if NF_CHECK {
        verifyNonFresh()
        if len(freeArena) == 0 && len(nonFreshLog) != 0 {
            eprintln("NFCHECK orphaned nonFresh log at release: nf=", len(nonFreshLog), " log=", len(freeLog))
            exit(9)
        }
    }
    truncate(nonFreshLog, 0)
    truncate(freeLog, 0)
    truncate(freeArena, 0)
    if NF_CHECK && (len(nonFreshLog) != 0 || len(freeLog) != 0 || len(freeArena) != 0) {
        eprintln("NFCHECK release cleanup left logs: nf=", len(nonFreshLog), " log=", len(freeLog), " arena=", len(freeArena))
        exit(9)
    }
}

// The runtime is read once before the compile, so that a missing one is reported before
// any error in the source, and again for the image: it is not held while compiling.
fn runtimeReadable(rtDir: string): bool {
    let rtText = readFile(rtDir + "/runtime_text.bin")
    let rtData = readFile(rtDir + "/runtime_data.bin")
    return rtText != nil && rtData != nil
}

fn compileFile(path: string, out: string, rtDir: string) {
    srcPath = path
    let data = readFile(path)
    if data == nil {
        eprintln("obxc: cannot read ", path)
        exit(2)
    }
    if !runtimeReadable(rtDir) {
        eprintln("obxc: cannot read the runtime from ", rtDir)
        exit(2)
    }
    drop(data)                     // the root source is read again by compileUnit; do not hold two copies
    if !symDirSet { symDir = dirOf(normPath(path)) }
    compileProgram(path, out, rtDir)
    releaseTables()
    let rtText = readFile(rtDir + "/runtime_text.bin")
    let rtData = readFile(rtDir + "/runtime_data.bin")
    if rtText == nil || rtData == nil {
        eprintln("obxc: cannot read the runtime from ", rtDir)
        exit(2)
    }
    if len(nativeRelocs) > 0 && len(nativeRelocPath) == 0 {
        eprintln("obxc: native calls need --native-relocs (the experimental link step)")
        exit(2)
    }
    let image = elfImage(rtText, rtData)
    if !writeFile(out, image, true) {
        eprintln("obxc: cannot write ", out)
        exit(2)
    }
    if len(nativeRelocPath) > 0 {
        let b = new []byte(0)
        for i in 0..len(nativeRelocs) {
            appInt(b, nativeRelocs[i].off)
            append(b, ' ')
            appStr(b, nativeRelocs[i].sym)
            append(b, '\n')
        }
        if !writeFile(nativeRelocPath, b, false) {
            eprintln("obxc: cannot write native relocations to ", nativeRelocPath)
            exit(2)
        }
    }
}

// --check: compile and check the checked module's body against its dependencies' .sym files,
// write its own .sym, and produce no executable. A dependency's source, if present, only
// validates the header and source hash; it is never compiled and a source-less dependency
// is allowed. There is no runtime and no main requirement.
fn checkFile(path: string) {
    checking = true
    if !symDirSet { symDir = dirOf(normPath(path)) }
    compileUnit(normPath(path), path, true)
}

fn usage() {
    eprintln("usage: obxc SOURCE [-o OUTPUT] [--rt RUNTIME_DIR] [-I DIR]... [--sym-dir DIR] ",
             "[--native-relocs FILE] [--check | --deps | --emit-sym] | --version | --tokens FILE | --encode FILE | --reemit-sym FILE")
}

// reports a Stage 2 CLI conflict (exit 2)
fn cliFail(msg: string) {
    eprintln("obxc: ", msg)
    exit(2)
}

fn main() {
    initCompiler()
    let a = args()
    for i in 1..len(a) {
        if a[i] == "--version" {
            println("obo ", OBO_VERSION, " sym-format ", SYM_FORMAT, " abi ", SYM_ABI)
            return
        }
    }
    if len(a) == 3 && (a[1] == "--tokens" || a[1] == "--encode") {
        let data = readFile(a[2])
        if data == nil {
            eprintln("obxc: cannot read ", a[2])
            exit(2)
        }
        if a[1] == "--tokens" {
            dumpTokens(data)
        } else {
            runEncoderScript(data)
        }
        return
    }
    if len(a) == 3 && a[1] == "--reemit-sym" {
        reemitSym(a[2])
        return
    }
    var path = ""
    var out = ""
    var outSet = false
    var rtDir = dirOf(a[0])
    var mode = "build"                 // build check deps
    var emitSym = false
    var i = 1
    while i < len(a) {
        let arg = a[i]
        if arg == "-o" || arg == "--rt" || arg == "-I" || arg == "--sym-dir" || arg == "--native-relocs" {
            if i + 1 >= len(a) { cliFail(arg + " needs a value") }
            let v = a[i + 1]
            if arg == "-o" {
                out = v
                outSet = true
            } else if arg == "--rt" {
                rtDir = v
            } else if arg == "-I" {
                append(incDirs, v)
            } else if arg == "--native-relocs" {
                nativeRelocPath = v
            } else {
                symDir = v
                symDirSet = true
            }
            i += 2
        } else if arg == "--check" {
            if mode == "deps" || emitSym { cliFail("--check, --deps and --emit-sym are mutually exclusive") }
            mode = "check"
            i += 1
        } else if arg == "--deps" {
            if mode == "check" || emitSym { cliFail("--check, --deps and --emit-sym are mutually exclusive") }
            mode = "deps"
            i += 1
        } else if arg == "--emit-sym" {
            if mode != "build" { cliFail("--check, --deps and --emit-sym are mutually exclusive") }
            emitSym = true
            i += 1
        } else if len(arg) > 0 && arg[0] == '-' {
            cliFail("unknown option " + arg)
        } else if len(path) == 0 {
            path = arg
            i += 1
        } else {
            cliFail("more than one source file: " + arg)
        }
    }
    if len(path) == 0 {
        usage()
        exit(2)
    }
    if mode != "build" && outSet { cliFail("-o cannot be used with --check or --deps") }
    emitRootSym = emitSym
    if mode == "deps" {
        runDeps(path)
        return
    }
    if mode == "check" {
        checkFile(path)
        return
    }
    if len(out) == 0 {
        out = path
        if len(out) > 4 && substr(out, len(out) - 4, len(out)) == ".obx" { out = substr(out, 0, len(out) - 4) }
    }
    compileFile(path, out, rtDir)
}
