// cat: concatenate operands to stdout, with -n, -b, -s, -E and -T.
//
// Built as a module root by tools/build_tools.py: it imports lib/io.obx as
// `io` and lib/strings.obx as `strings`, and every library name is qualified.
// The subset is deliberate: -v, -e, -t, -A, -u, long options, --help and
// --version are unsupported (see cmd/README.md).
//
// The logical stream spans operands: the line number, the blank-line squeeze
// state and a partially written line continue from one file to the next. A
// blank line is a line with no bytes before the newline; spaces, a tab or a NUL
// make a line nonblank. -b overrides -n regardless of order. With -E, a CR that
// immediately precedes an emitted LF is held and written as ^M (GNU's rule): the
// hold spans Reader chunks and operands, and a final unpaired CR is written
// literally at stream EOF. A CR-only line is still nonblank for -n/-b/-s.
//
// Open and read errors print `cat: <operand>: <text>`, set failed, close the
// operand and continue with the next one. A write error prints
// `cat: write error: <text>` once, sets fatal, stops reading and never opens a
// later operand. Both exit 1.

import "../lib/io.obx" as io
import "../lib/strings.obx" as strings

type CatOpts = ref record {
    numberEvery: bool      // -n
    numberNonBlank: bool   // -b (overrides -n)
    squeeze: bool          // -s
    showEnds: bool         // -E
    showTabs: bool         // -T
}

type CatState = ref record {
    lineNo: int            // the next line number to print
    atLineStart: bool      // the next byte begins a line
    lastBlank: bool        // the previous input line was blank (-s)
    pendingCr: bool        // -E is holding a CR for a possible following LF
    failed: bool           // an open/read error happened
    fatal: bool            // a write error happened
}

// Transform one input chunk into scratch and hand it to the Writer. A write or
// flush failure comes back as err; the caller prints the one write diagnostic
// and marks the state fatal. The scratch is flushed at 64 KiB so -nET on a
// 64 KiB chunk of newlines stays bounded (a whole-chunk batch would grow the
// array to about 1 MiB).
fn catChunk(mut w: &io::Writer, mut scratch: &[]byte, data: &[]byte, opts: &CatOpts, mut st: &CatState): Result[bool] {
    for k in 0..len(data) {
        let b = data[k]
        var handled = false
        if st.pendingCr {
            // a CR held by -E: an LF turns it into ^M$, any other byte first
            // releases the CR literally and is then processed normally (a second
            // CR can become the new pending one)
            st.pendingCr = false
            if b == '\n' {
                append(scratch, '^')
                append(scratch, 'M')
                append(scratch, '$')
                append(scratch, '\n')
                st.atLineStart = true
                st.lastBlank = false
                handled = true
            } else {
                append(scratch, '\r')
            }
        }
        if !handled {
            if st.atLineStart {
                if b == '\n' {
                    if opts.squeeze && st.lastBlank {
                        // a squeezed blank line: emit nothing, not even its number
                    } else {
                        if opts.numberEvery && !opts.numberNonBlank {
                            st.lineNo += 1
                            strings::appendPadded(scratch, st.lineNo, 6)
                            append(scratch, '\t')
                        }
                        if opts.showEnds { append(scratch, '$') }
                        append(scratch, '\n')
                    }
                    st.lastBlank = true
                } else {
                    st.lineNo += 1
                    if opts.numberEvery || opts.numberNonBlank {
                        strings::appendPadded(scratch, st.lineNo, 6)
                        append(scratch, '\t')
                    }
                    st.atLineStart = false
                    st.lastBlank = false
                    if b == '\t' && opts.showTabs {
                        append(scratch, '^')
                        append(scratch, 'I')
                    } else if b == '\r' && opts.showEnds {
                        st.pendingCr = true
                    } else {
                        append(scratch, b)
                    }
                }
            } else {
                if b == '\n' {
                    if opts.showEnds { append(scratch, '$') }
                    append(scratch, '\n')
                    st.atLineStart = true
                    st.lastBlank = false
                } else if b == '\t' && opts.showTabs {
                    append(scratch, '^')
                    append(scratch, 'I')
                } else if b == '\r' && opts.showEnds {
                    st.pendingCr = true
                } else {
                    append(scratch, b)
                }
            }
        }
        if len(scratch) >= 65536 {
            try io::writeBytes(w, scratch)
            truncate(scratch, 0)
        }
    }
    try io::writeBytes(w, scratch)
    truncate(scratch, 0)
    try io::flush(w)
    return ok(true)
}

// Stream one Reader through the transform. ok(false) means a write error was
// already reported and the whole tool must stop; a read error is returned as err
// for the operand handler, which prints it and continues.
fn catReader(mut r: &io::Reader, mut w: &io::Writer, mut scratch: &[]byte, opts: &CatOpts, mut st: &CatState): Result[bool] {
    while true {
        let more = try io::fill(r)
        if !more { return ok(true) }
        let chunk = io::takeChunk(r)
        let rr = catChunk(w, scratch, chunk, opts, st)
        match rr {
            ok { }
            err {
                eprintln("cat: write error: ", strings::errText(rr.code))
                st.fatal = true
                return ok(false)
            }
        }
    }
}

// Read one operand. Returns false only for a fatal write error; open and read
// errors are printed here and return true (continue with the next operand).
// Stdin ("-" or no operands) is never opened or closed.
fn catOperand(path: string, mut w: &io::Writer, mut scratch: &[]byte, opts: &CatOpts, mut st: &CatState): bool {
    if path == "-" {
        var r = io::newReader(stdin(), 65536)
        let rr = catReader(r, w, scratch, opts, st)
        match rr {
            ok { if !rr.value { return false } }
            err {
                eprintln("cat: -: ", strings::errText(rr.code))
                st.failed = true
            }
        }
        return true
    }
    let f = openFile(path, "r")
    match f {
        ok {
            let fd = f.value
            defer closeFile(fd)
            var r = io::newReader(fd, 65536)
            let rr = catReader(r, w, scratch, opts, st)
            match rr {
                ok { if !rr.value { return false } }
                err {
                    eprintln("cat: ", path, ": ", strings::errText(rr.code))
                    st.failed = true
                }
            }
        }
        err {
            eprintln("cat: ", path, ": ", strings::errText(f.code))
            st.failed = true
        }
    }
    return true
}

// Apply one short-option character; false means it is not one of ours.
fn setOpt(mut o: &CatOpts, c: byte): bool {
    if c == 'n' { o.numberEvery = true; return true }
    if c == 'b' { o.numberNonBlank = true; return true }
    if c == 's' { o.squeeze = true; return true }
    if c == 'E' { o.showEnds = true; return true }
    if c == 'T' { o.showTabs = true; return true }
    return false
}

fn main() {
    let argv = args()
    var opts = new CatOpts{numberEvery: false, numberNonBlank: false, squeeze: false, showEnds: false, showTabs: false}
    var operands = new []string(0)
    var endOpts = false
    var i = 1
    while i < len(argv) {
        let a = argv[i]
        if !endOpts && a == "--" {
            endOpts = true
        } else if !endOpts && len(a) > 1 && a[0] == '-' {
            if len(a) > 2 && a[1] == '-' {
                eprintln("cat: unrecognized option '", a, "'")
                exit(1)
            }
            var j = 1
            while j < len(a) {
                let c = a[j]
                if !setOpt(opts, c) {
                    let ch = substr(a, j, j + 1)
                    eprintln("cat: invalid option -- '", ch, "'")
                    exit(1)
                }
                j += 1
            }
        } else {
            append(operands, a)
        }
        i += 1
    }

    var w = io::newWriter(stdout(), 65536)
    var scratch = new []byte(0)
    var st = new CatState{lineNo: 0, atLineStart: true, lastBlank: false, pendingCr: false, failed: false, fatal: false}
    var fatal = false
    if len(operands) == 0 {
        let cont = catOperand("-", w, scratch, opts, st)
        if !cont { fatal = true }
    } else {
        var k = 0
        while k < len(operands) {
            let p = operands[k]
            let cont = catOperand(p, w, scratch, opts, st)
            if !cont {
                fatal = true
                break
            }
            k += 1
        }
    }
    if !fatal && st.pendingCr {
        st.pendingCr = false
        append(scratch, '\r')
        let wr = io::writeBytes(w, scratch)
        truncate(scratch, 0)
        match wr {
            ok { }
            err {
                eprintln("cat: write error: ", strings::errText(wr.code))
                exit(1)
            }
        }
    }
    if !fatal {
        let fl = io::flush(w)
        match fl {
            ok { }
            err {
                eprintln("cat: write error: ", strings::errText(fl.code))
                exit(1)
            }
        }
    }
    if fatal || st.failed { exit(1) }
}
