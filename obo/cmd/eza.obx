// eza: the P5b E1 core (non-TTY lines and tree, colour, --no-quotes).
//
// Built as a module root by tools/build_tools.py: it imports the stdlib by
// explicit relative paths and every library name is qualified. The module is
// named `eza`; nothing imports it, so the build writes an unread eza.sym into
// the private sym dir. This build is non-TTY only in the sense that it never
// grids: it prints one entry per line (symlink targets included) or a tree.
// It implements the hidden/-a/-A rules, the E0 sort keys, -r, directory
// grouping, quoting and --no-quotes, -F, -D/-f, -d, restricted long, -T/-L,
// --color/--colour with the default palette and the documented
// LS_COLORS/EZA_COLORS subset, --help/-?, and the error/exit classes of design
// sections 7 and 8. Multiple operands, grid details, icons, -R and the later
// sort keys are rejected with this build's own message. --help prints this
// build's own subset text, not the upstream eza help.
//
// One operand or none; a listing shows names, an operand shows its parent
// prefix and name. Entries are read through fs, filtered (-a/-A, -D/-f), sorted
// through lib/sort, quoted and rendered with symlink targets and -F markers;
// the restricted long view adds the permission, size, optional uid and date
// cells. The tree view walks each directory with an explicit frame stack and
// applies the same filter/sort at every level. Colour output is built as a
// sequence of styled text bits and emitted with the pinned reference's
// minimal-ANSI difference rule (nu-ansi-term 0.50.1 AnsiStrings). Errors
// follow eza's exit classes (0/1/2/3); a permission-denied directory keeps the
// probe's status 0.

module eza

import "../lib/io.obx" as io
import "../lib/fmt.obx" as fmt
import "../lib/strings.obx" as strings
import "../lib/paths.obx" as paths
import "../lib/sort.obx" as sort
import "../lib/cli.obx" as cli
import "../lib/errors.obx" as errors
import "../lib/time.obx" as time
import "../lib/fs.obx" as fs
import "../lib/env.obx" as env

// eza accepts a --width/COLUMNS value up to 2^64-1 and a huge width simply
// lays every cell on one line. This build stores ints and does not reproduce
// usize wraparound at the very top of the range, so it clamps the console
// width: every layout for a real name set is identical far below this bound.
const GRID_WIDTH_CAP = 1099511627776

// Deduced command-line state. Every field is copied from the effective (last)
// occurrence of its option; cli.parse has already rejected unknown names and
// missing required values, and deduce validates the effective values with
// eza's last-occurrence rule and wording.
type Opts = ref record {
    allCount: int          // -a/--all occurrences
    almostAll: bool        // -A
    treatDirs: bool        // -d/--treat-dirs-as-files/--list-dirs
    reverse: bool          // -r
    sortField: string      // effective --sort value, "" for the default
    groupFirst: bool       // --group-directories-first
    groupLast: bool        // --group-directories-last
    classifyOn: bool       // the effective classify mode adds markers now
    onlyDirs: bool         // -D
    onlyFiles: bool        // -f
    bytes: bool            // -B/--bytes
    numeric: bool          // -n
    noUser: bool           // --no-user
    noPermissions: bool    // --no-permissions
    noFilesize: bool       // --no-filesize
    noTime: bool           // --no-time
    timeStyle: string      // effective --time-style value
    timeStyleSeen: bool
    longView: bool         // the effective view is -l (last of -l/-1/-T rules)
    treeView: bool         // the effective view is a tree (details + tree)
    level: int             // -L depth when treeView; parsed from levelText
    levelSeen: bool
    levelText: string
    noQuotes: bool         // --no-quotes (outer QuoteStyle::NoQuotes)
    colourOn: bool         // colour is enabled for this run
    // E2 view and width state. `lastView` is not kept: longView/treeView/
    // gridView are the deduced Mode. `terminalish` is eza's is_a_tty: the
    // width is Set (--width>=1 or COLUMNS) or stdout is a terminal. It decides
    // the default grid view, automatic classify and (out of scope here)
    // automatic icons; it does NOT enable automatic colour (that uses the real
    // stdout isatty, probed).
    across: bool           // -x/--across
    gridView: bool         // the effective Mode is Grid
    terminalish: bool
    widthKnown: bool       // a console width is available (Set, or a TTY)
    width: int             // console width when widthKnown; 80 is the grid fallback
    widthSeen: bool        // --width was given (even when it deduced Automatic)
    widthText: string      // the effective --width value
}

// One displayed entry.
type Entry = ref record {
    name: string
    kind: byte            // kernel/d_type type (LNK for a symlink)
    synthetic: byte       // 0 real, 1 synthesized ".", 2 synthesized ".."
    mode: int             // lstat mode; meaningful when statOk
    size: int             // lstat size
    mtime: int            // lstat mtime seconds
    mtimeNs: int
    uid: int
    statOk: bool
    linkOk: bool          // readlink succeeded
    targetRaw: string     // raw target bytes as a string
    targetValid: bool     // stat (follow) on the resolved target succeeded
    targetKind: byte      // followed type when targetValid
    targetMode: int       // followed mode when targetValid
}

// How the entry set was produced: a directory listing (names only) or one
// operand (parent prefix + name). `base` is the target-resolution base.
type View = ref record {
    single: bool
    operand: string
    base: string
}

// The restricted-long column widths, computed over the displayed entries.
type Cols = ref record {
    sizeWidth: int
    userWidth: int
    dateWidth: int
}

// ------------------------------------------------------------- colour state
//
// A Style mirrors nu-ansi-term 0.50.1's Style (the crate the pinned reference
// links): eight attributes, then a background and a foreground colour. The
// colour kinds are 0 none, 1 basic (a raw 30..37/90..97 or 40..47/100..107
// code), 2 fixed (38;5;n / 48;5;n) and 3 RGB (38;2;r;g;b / 48;2;r;g;b).
// A style's prefix is written in the crate's order: attributes (1,2,3,4,5,7,8,
// 9), background, foreground. The default theme and the LS_COLORS parser set
// only these fields, so this shape is exact for the E1 subset.

type Style = ref record {
    fg: int
    fgA: int
    fgB: int
    fgC: int
    bg: int
    bgA: int
    bgB: int
    bgC: int
    bold: bool
    dim: bool
    italic: bool
    underline: bool
    blink: bool
    reverse: bool
    hidden: bool
    strike: bool
}

// One styled piece of a line. TextCellContents in the reference is a vector of
// such pieces, and the ANSIStrings writer minimises the escape sequences
// between adjacent pieces. A Bit copies the style's scalar fields so a line
// never owns a palette style.
type Bit = ref record {
    fg: int
    fgA: int
    fgB: int
    fgC: int
    bg: int
    bgA: int
    bgB: int
    bgC: int
    bold: bool
    dim: bool
    italic: bool
    underline: bool
    blink: bool
    reverse: bool
    hidden: bool
    strike: bool
    text: string
}

// One ordered `*.EXT` mapping from LS_COLORS or EZA_COLORS. kind 0 is a simple
// extension key (matched against the bytes after the name's last '.'), kind 1
// is a key containing a dot, matched as the literal suffix "." + key.
type ExtPat = ref record {
    kind: int
    key: string
    style: Style
}

// Palette slots, in the order the array is indexed.
const SC_NORMAL = 0
const SC_DIR = 1
const SC_LNK = 2
const SC_PIPE = 3
const SC_BLOCK = 4
const SC_CHAR = 5
const SC_SOCK = 6
const SC_SPECIAL = 7
const SC_EXE = 8
const SC_MOUNT = 9
const SC_PUNCT = 10
const SC_SYMLINK_PATH = 11
const SC_CONTROL = 12
const SC_BROKEN = 13
const SC_BROKEN_FILE = 14
const SC_BROKEN_CONTROL = 15
const SC_IMAGE = 20
const SC_VIDEO = 21
const SC_MUSIC = 22
const SC_LOSSLESS = 23
const SC_CRYPTO = 24
const SC_DOCUMENT = 25
const SC_COMPRESSED = 26
const SC_TEMP = 27
const SC_COMPILED = 28
const SC_BUILD = 29
const SC_SOURCE = 30
const SC_SLOTS = 31

// The effective colour theme: 31 style slots, the ordered extension mappings,
// and whether the default file-type (extension/category) palette applies
// (EZA_COLORS=reset... turns it off).
type Palette = ref record {
    styles: []Style
    patterns: []ExtPat
    useDefaultTypes: bool
}

// One directory being walked in the tree view. `anc` holds one '0'/'1' byte
// per ancestor level (1 = that ancestor was its parent's last entry); frames
// are pushed and popped in depth-first order, so no recursion is needed and
// each open directory is fully read and closed before its children.
type Frame = ref record {
    path: string
    entries: []Entry
    order: []int
    next: int
    depth: int
    anc: string
}

// ------------------------------------------------------------------- lists

// A fresh empty string array (each call owns its own array).
fn noStrings(): []string {
    return new []string(0)
}

fn stringList2(a: string, b: string): []string {
    var xs = new []string(0)
    append(xs, a)
    append(xs, b)
    return xs
}

fn stringList3(a: string, b: string, c: string): []string {
    var xs = new []string(0)
    append(xs, a)
    append(xs, b)
    append(xs, c)
    return xs
}

fn stringList4(a: string, b: string, c: string, d: string): []string {
    var xs = stringList3(a, b, c)
    append(xs, d)
    return xs
}

fn stringList5(a: string, b: string, c: string, d: string, e: string): []string {
    var xs = stringList4(a, b, c, d)
    append(xs, e)
    return xs
}

// The text after "(choices: ...)" in eza's --sort diagnostics.
fn sortChoices(): []string {
    var xs = new []string(0)
    append(xs, "name")
    append(xs, "Name")
    append(xs, "size")
    append(xs, "extension")
    append(xs, "Extension")
    append(xs, "modified")
    append(xs, "changed")
    append(xs, "accessed")
    append(xs, "created")
    append(xs, "inode")
    append(xs, "type")
    append(xs, "none")
    return xs
}

// Every value eza 0.23.3 accepts for --sort. cli.parse rejects anything else
// with eza's no-setting message; E0 then rejects the values it does not
// implement with this build's own message.
fn sortAccept(): []string {
    var xs = new []string(0)
    append(xs, "name")
    append(xs, "Name")
    append(xs, "filename")
    append(xs, "Filename")
    append(xs, ".name")
    append(xs, ".Name")
    append(xs, ".filename")
    append(xs, ".Filename")
    append(xs, "size")
    append(xs, "filesize")
    append(xs, "extension")
    append(xs, "Extension")
    append(xs, "ext")
    append(xs, "Ext")
    append(xs, "type")
    append(xs, "modified")
    append(xs, "date")
    append(xs, "time")
    append(xs, "mod")
    append(xs, "new")
    append(xs, "newest")
    append(xs, "changed")
    append(xs, "ch")
    append(xs, "accessed")
    append(xs, "acc")
    append(xs, "created")
    append(xs, "cr")
    append(xs, "inode")
    append(xs, "none")
    append(xs, "age")
    append(xs, "old")
    append(xs, "oldest")
    return xs
}

// The WHEN keywords eza's parser consumes as a separate token. `automatic` is
// accepted only after '=' (the deduction accepts it), never consumed here.
fn whenConsume(): []string {
    return stringList3("always", "auto", "never")
}

fn scaleConsume(): []string {
    return stringList3("all", "age", "size")
}

fn absoluteConsume(): []string {
    return stringList3("on", "follow", "off")
}

// ------------------------------------------------------------- flag specs

fn mkSpec(short: byte, long: string, mode: int, consume: []string,
          accept: []string, choices: []string, def: string): cli::FlagSpec {
    return new cli::FlagSpec{short: short, long: long, mode: mode,
                             consume: consume, accept: accept,
                             choices: choices, default: def}
}

// The E0 parser: the supported flags, plus every eza-valid flag E0 rejects.
// The rejected ones keep eza's value mode so their values are consumed before
// this build's unsupported-option error (design 7.11); --version and -v are
// deliberately absent and take the unknown-name path. --help/-? are ordinary
// VALUE_NONE specs, so an unknown option or missing value later in argv still
// wins over help (the pinned reference's ordering), while help itself is
// handled before operand lookup and deduction.
//
// The accept lists for --sort, --classify, --color/--colour and --icons are
// empty on purpose: eza deduces only the last occurrence, so `--sort=foo
// --sort=name` lists (it never validates foo). deduce validates the effective
// value against the same choices and prints eza's wording. The consume lists
// stay, because they decide whether a separate next token is a value at all.
fn specs(): []cli::FlagSpec {
    var s = new []cli::FlagSpec(0)
    // meta
    append(s, mkSpec('?', "help", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    // views
    append(s, mkSpec('1', "oneline", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('l', "long", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    // filters and sorting
    append(s, mkSpec('a', "all", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('A', "almost-all", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('d', "treat-dirs-as-files", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "list-dirs", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('D', "only-dirs", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('f', "only-files", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('r', "reverse", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('s', "sort", cli::VALUE_REQUIRED, noStrings(), noStrings(), sortChoices(), ""))
    append(s, mkSpec(byte(0), "group-directories-first", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "group-directories-last", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    // classify and long columns
    append(s, mkSpec('F', "classify", cli::VALUE_OPTIONAL, whenConsume(), noStrings(), noStrings(), "auto"))
    append(s, mkSpec('B', "bytes", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('n', "numeric", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "no-user", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "no-permissions", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "no-filesize", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "no-time", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "time-style", cli::VALUE_REQUIRED, noStrings(), noStrings(),
                     stringList5("default", "long-iso", "full-iso", "iso", "relative"), ""))
    // colour and icons: accepted spellings, E0 rejects rendering `always`
    append(s, mkSpec(byte(0), "color", cli::VALUE_OPTIONAL, whenConsume(), noStrings(), noStrings(), "auto"))
    append(s, mkSpec(byte(0), "colour", cli::VALUE_OPTIONAL, whenConsume(), noStrings(), noStrings(), "auto"))
    append(s, mkSpec(byte(0), "icons", cli::VALUE_OPTIONAL, whenConsume(), noStrings(), noStrings(), "auto"))
    // eza-valid options this build rejects (parsed, then reported by name)
    append(s, mkSpec('G', "grid", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('x', "across", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('R', "recurse", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('T', "tree", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('L', "level", cli::VALUE_REQUIRED, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('X', "dereference", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "follow-symlinks", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('w', "width", cli::VALUE_REQUIRED, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "no-quotes", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "absolute", cli::VALUE_OPTIONAL, absoluteConsume(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "color-scale", cli::VALUE_OPTIONAL, scaleConsume(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "colour-scale", cli::VALUE_OPTIONAL, scaleConsume(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "color-scale-mode", cli::VALUE_REQUIRED, noStrings(), noStrings(), stringList2("fixed", "gradient"), ""))
    append(s, mkSpec(byte(0), "colour-scale-mode", cli::VALUE_REQUIRED, noStrings(), noStrings(), stringList2("fixed", "gradient"), ""))
    append(s, mkSpec('I', "ignore-glob", cli::VALUE_REQUIRED, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "git-ignore", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "no-symlinks", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "show-symlinks", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('b', "binary", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('g', "group", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('h', "header", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('i', "inode", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('H', "links", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('m', "modified", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "changed", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('S', "blocksize", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "total-size", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('t', "time", cli::VALUE_REQUIRED, noStrings(), noStrings(), stringList4("modified", "changed", "accessed", "created"), ""))
    append(s, mkSpec('u', "accessed", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('U', "created", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "hyperlink", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('M', "mounts", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "smart-group", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "git", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "no-git", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "git-repos", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "git-repos-no-status", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('@', "extended", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('o', "octal-permissions", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('Z', "context", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec(byte(0), "stdin", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    append(s, mkSpec('O', "flags", cli::VALUE_NONE, noStrings(), noStrings(), noStrings(), ""))
    return s
}

// --------------------------------------------------------------- deduction

// eza-valid option names E0 does not implement.
fn isUnsupported(name: string): bool {
    if name == "recurse" { return true }
    if name == "dereference" { return true }
    if name == "follow-symlinks" { return true }
    if name == "absolute" { return true }
    if name == "color-scale" { return true }
    if name == "colour-scale" { return true }
    if name == "color-scale-mode" { return true }
    if name == "colour-scale-mode" { return true }
    if name == "ignore-glob" { return true }
    if name == "git-ignore" { return true }
    if name == "no-symlinks" { return true }
    if name == "show-symlinks" { return true }
    if name == "binary" { return true }
    if name == "group" { return true }
    if name == "header" { return true }
    if name == "inode" { return true }
    if name == "links" { return true }
    if name == "modified" { return true }
    if name == "changed" { return true }
    if name == "blocksize" { return true }
    if name == "total-size" { return true }
    if name == "time" { return true }
    if name == "accessed" { return true }
    if name == "created" { return true }
    if name == "hyperlink" { return true }
    if name == "mounts" { return true }
    if name == "smart-group" { return true }
    if name == "git" { return true }
    if name == "no-git" { return true }
    if name == "git-repos" { return true }
    if name == "git-repos-no-status" { return true }
    if name == "extended" { return true }
    if name == "octal-permissions" { return true }
    if name == "context" { return true }
    if name == "stdin" { return true }
    if name == "flags" { return true }
    return false
}

// eza-valid --sort values excluded from E0 (they need metadata E0 does not
// collect, the `.name` dot rule, or filesystem order).
fn isRejectedSort(v: string): bool {
    if v == ".name" { return true }
    if v == ".Name" { return true }
    if v == ".filename" { return true }
    if v == ".Filename" { return true }
    if v == "changed" { return true }
    if v == "ch" { return true }
    if v == "accessed" { return true }
    if v == "acc" { return true }
    if v == "created" { return true }
    if v == "cr" { return true }
    if v == "inode" { return true }
    if v == "none" { return true }
    if v == "age" { return true }
    if v == "old" { return true }
    if v == "oldest" { return true }
    return false
}

// Left-associative string concatenation helper for messages.
fn msg3(a: string, b: string, c: string): string {
    return a + b + c
}

fn messageFor(name: string): string {
    var canonical = name
    if name == "colour-scale" { canonical = "color-scale" }
    if name == "colour-scale-mode" { canonical = "color-scale-mode" }
    return msg3("option '--", canonical, "' is not supported by this build")
}

fn valueMessage(name: string, value: string): string {
    return "option '--" + name + "=" + value + "' is not supported by this build"
}

// The WHEN values eza's optional-value deduction accepts after '='.
fn isWhenValue(v: string): bool {
    return v == "always" || v == "auto" || v == "never" || v == "automatic"
}

// Linear membership over a caller-built string array (borrowed).
fn inStrings(xs: &[]string, s: string): bool {
    for i in 0..len(xs) {
        if xs[i] == s { return true }
    }
    return false
}

// The "(choices: a, b, c)" tail of a bad-value message; empty for none.
fn choicesText(xs: &[]string): string {
    if len(xs) == 0 { return "" }
    var s = " (choices: "
    for i in 0..len(xs) {
        if i > 0 { s = s + ", " }
        s = s + xs[i]
    }
    return s + ")"
}

// Rust str Debug escaping for a displayed option value (the reference uses
// `{:?}` in these messages): NUL is \0, tab/newline/CR are \t/\n/\r, quote
// and backslash are escaped, other C0/DEL bytes are \u{hex} with lowercase
// hex and no leading zeros, and every other byte is copied.
fn debugHexDigit(v: int): byte {
    if v < 10 { return byte(48 + v) }
    return byte(87 + v)
}

fn debugText(s: string): string {
    var out = new []byte(0)
    for i in 0..len(s) {
        let b = s[i]
        if b == 0 {
            append(out, '\\')
            append(out, '0')
        } else if b == '"' {
            append(out, '\\')
            append(out, '"')
        } else if b == '\\' {
            append(out, '\\')
            append(out, '\\')
        } else if b == '\t' {
            append(out, '\\')
            append(out, 't')
        } else if b == '\n' {
            append(out, '\\')
            append(out, 'n')
        } else if b == '\r' {
            append(out, '\\')
            append(out, 'r')
        } else if b < ' ' || b == 127 {
            append(out, '\\')
            append(out, 'u')
            append(out, '{')
            let v = int(b)
            if v >= 16 { append(out, debugHexDigit(v / 16)) }
            append(out, debugHexDigit(v % 16))
            append(out, '}')
        } else {
            append(out, b)
        }
    }
    return strings::fromBytes(out)
}

// eza's Optional/Option bad-value wording, without the "eza: " prefix.
fn noSetting(label: string, value: string, choices: []string): string {
    var m = "Option " + label + " has no \"" + debugText(value) + "\" setting"
    if len(choices) > 0 {
        let tail = choicesText(choices)
        m = m + tail
    }
    return m
}

// Parse the -L value the way eza's RecurseOptions does: Rust usize::from_str
// (an optional '+', decimal digits, leading zeros allowed). The error class is
// 1 invalid digit, 2 too large (above 2^64-1), 3 empty. Values between
// 2^63 and 2^64-1 are accepted by the reference and clamp to int max here
// (they are effectively unlimited depths).
fn levelValue(s: string): Result[int] {
    if len(s) == 0 { return err("empty", 3) }
    var i = 0
    if s[i] == '+' { i += 1 }
    if i >= len(s) { return err("invalid", 1) }
    var start = i
    while start < len(s) && s[start] == '0' { start += 1 }
    if start == len(s) { return ok(0) }
    var digits = 0
    for j in start..len(s) {
        if s[j] < '0' || s[j] > '9' { return err("invalid", 1) }
        digits += 1
    }
    if digits > 20 { return err("large", 2) }
    if digits == 20 {
        let top = "18446744073709551615"
        for j in 0..20 {
            if s[start + j] < top[j] { break }
            if s[start + j] > top[j] { return err("large", 2) }
        }
    }
    var v = 0
    var sat = false
    for j in start..len(s) {
        let d = int(s[j]) - 48
        if !sat {
            if v > 922337203685477580 || (v == 922337203685477580 && d > 7) {
                sat = true
                v = 9223372036854775807
            } else {
                v = v * 10 + d
            }
        }
    }
    return ok(v)
}

// Parse a --width or COLUMNS value the way eza's `usize` parse does: an
// optional '+', then decimal digits (leading zeros allowed). Error classes: 1
// invalid digit, 2 above 2^64-1, 3 empty (only a zero-length value; a lone
// "+" is InvalidDigit, as in Rust's usize::from_str). Values between 2^63 and 2^64-1 are
// accepted by the reference and saturate to int max here; the grid layout
// clamps any absurd width (see GRID_WIDTH_CAP).
fn widthValue(s: string): Result[int] {
    if len(s) == 0 { return err("empty", 3) }
    var i = 0
    if s[i] == '+' { i += 1 }
    if i >= len(s) { return err("invalid", 1) }
    var start = i
    while start < len(s) && s[start] == '0' { start += 1 }
    if start == len(s) { return ok(0) }
    var digits = 0
    for j in start..len(s) {
        if s[j] < '0' || s[j] > '9' { return err("invalid", 1) }
        digits += 1
    }
    if digits > 20 { return err("large", 2) }
    if digits == 20 {
        let top = "18446744073709551615"
        for j in 0..20 {
            if s[start + j] < top[j] { break }
            if s[start + j] > top[j] { return err("large", 2) }
        }
    }
    var v = 0
    var sat = false
    for j in start..len(s) {
        let d = int(s[j]) - 48
        if !sat {
            if v > 922337203685477580 || (v == 922337203685477580 && d > 7) {
                sat = true
                v = 9223372036854775807
            } else {
                v = v * 10 + d
            }
        }
    }
    return ok(v)
}

fn widthReason(code: int): string {
    if code == 2 { return "number too large to fit in target type" }
    if code == 3 { return "cannot parse integer from empty string" }
    return "invalid digit found in string"
}

// Turn the parsed option occurrences into the effective state. Returns this
// build's own usage errors (exit 3 at the caller) for values it does not
// implement and for the restricted long form.
fn deduce(options: &[]cli::Option): Result[Opts] {
    var o = new Opts{allCount: 0, almostAll: false, treatDirs: false,
                     reverse: false, sortField: "", groupFirst: false,
                     groupLast: false, classifyOn: false, onlyDirs: false,
                     onlyFiles: false, bytes: false, numeric: false,
                     noUser: false, noPermissions: false, noFilesize: false,
                     noTime: false, timeStyle: "", timeStyleSeen: false,
                     longView: false, treeView: false,
                     level: 0, levelSeen: false, levelText: "",
                     noQuotes: false, colourOn: false, across: false,
                     gridView: false, terminalish: false,
                     widthKnown: false, width: 0, widthSeen: false,
                     widthText: ""}
    // The effective view flag: 0 none, 1 -l, 2 -1, 3 -T, 4 -G (eza's
    // has_where_any over --long/--oneline/--grid/--tree takes the last one).
    // `lastGT` is the last of --grid/--tree alone (0 none, 1 grid, 2 tree):
    // it decides whether a long view becomes GridDetails or a tree. `longSeen`
    // is separate because a last -T/-G with any -l is a long view too.
    var lastView = 0
    var lastGT = 0
    var longSeen = false
    var treeSeen = false
    // The effective (last) values of the optional-value flags. eza deduces
    // only the last occurrence, so an earlier bad value is ignored when a
    // later valid one replaces it (probed: --sort=foo --sort=name lists).
    var classifyValue = ""
    var colorValue = ""
    var iconsValue = ""
    var k = 0
    while k < len(options) {
        let name = options[k].long
        let value = options[k].value
        if name == "all" {
            o.allCount += 1
        } else if name == "almost-all" {
            o.almostAll = true
        } else if name == "treat-dirs-as-files" {
            o.treatDirs = true
        } else if name == "list-dirs" {
            o.treatDirs = true
        } else if name == "reverse" {
            o.reverse = true
        } else if name == "sort" {
            o.sortField = value
        } else if name == "group-directories-first" {
            o.groupFirst = true
        } else if name == "group-directories-last" {
            o.groupLast = true
        } else if name == "classify" {
            classifyValue = value
        } else if name == "only-dirs" {
            o.onlyDirs = true
        } else if name == "only-files" {
            o.onlyFiles = true
        } else if name == "bytes" {
            o.bytes = true
        } else if name == "numeric" {
            o.numeric = true
        } else if name == "no-user" {
            o.noUser = true
        } else if name == "no-permissions" {
            o.noPermissions = true
        } else if name == "no-filesize" {
            o.noFilesize = true
        } else if name == "no-time" {
            o.noTime = true
        } else if name == "time-style" {
            o.timeStyle = value
            o.timeStyleSeen = true
        } else if name == "long" {
            longSeen = true
            lastView = 1
        } else if name == "oneline" {
            lastView = 2
        } else if name == "tree" {
            treeSeen = true
            lastView = 3
            lastGT = 2
        } else if name == "grid" {
            lastView = 4
            lastGT = 1
        } else if name == "across" {
            o.across = true
        } else if name == "width" {
            o.widthSeen = true
            o.widthText = value
        } else if name == "level" {
            o.levelText = value
            o.levelSeen = true
        } else if name == "no-quotes" {
            o.noQuotes = true
        } else if name == "color" || name == "colour" {
            colorValue = value
        } else if name == "icons" {
            iconsValue = value
        } else if isUnsupported(name) {
            return err(messageFor(name), 22)
        }
        k += 1
    }
    // eza's TerminalWidth::deduce and Mode::deduce (options/view.rs). The
    // --width branch wins over COLUMNS even when it deduces Automatic (0), in
    // which case COLUMNS is not consulted; a COLUMNS value is Set even when
    // it is 0. Automatic width is stdout's ioctl width only when stdout is a
    // terminal; otherwise it is unknown and only an explicit view can grid.
    let stdoutTty = io::isTty(1)
    var widthSet = false
    var consoleWidth = 0
    if o.widthSeen {
        let wv = strings::lossy(o.widthText)
        let wr = widthValue(wv)
        match wr {
            ok(v) {
                if v >= 1 {
                    widthSet = true
                    consoleWidth = v
                }
                // v == 0 is TerminalWidth::Automatic
            }
            err(m, c) {
                return err("Value \"" + debugText(wv) + "\" not valid for option --width (-w): " + widthReason(c), 22)
            }
        }
    } else if env::has("COLUMNS") {
        let cv = env::value("COLUMNS")
        // eza skips a COLUMNS value that is not valid Unicode (its
        // into_string fails), so such a value leaves Automatic in place.
        if strings::isValidUtf8(cv) {
            let cr = widthValue(cv)
            match cr {
                ok(v) {
                    widthSet = true
                    consoleWidth = v
                }
                err(m, c) {
                    return err("Value \"" + debugText(cv) + "\" not valid for environment variable COLUMNS: " + widthReason(c), 22)
                }
            }
        }
    }
    // is_a_tty: Set (--width>=1 or COLUMNS) or a real stdout terminal that
    // reports a non-zero size. The terminal_size crate returns None for a
    // zero row/column report, so a 0-column pty is NOT terminal-ish (probe:
    // it stays in Lines mode, with automatic colour on because stdout is
    // still a terminal, and no automatic classify markers). It selects the
    // default grid and enables automatic classify; automatic colour keeps
    // using the real stdout isatty (probed: --width does not colour a pipe).
    var autoWidthKnown = false
    var autoWidth = 0
    if stdoutTty {
        let tw = io::termWidth(1)
        if tw > 0 {
            autoWidthKnown = true
            autoWidth = tw
        }
    }
    o.terminalish = widthSet || autoWidthKnown
    if widthSet {
        o.widthKnown = true
        o.width = consoleWidth
    } else if autoWidthKnown {
        o.widthKnown = true
        o.width = autoWidth
    }
    if o.widthKnown && o.width > GRID_WIDTH_CAP { o.width = GRID_WIDTH_CAP }
    // eza's view rules (options/view.rs). The last of -l/-1/-T/-G wins; a
    // last -T/-G with any -l is a long view (Details), and the last of the
    // -G/-T pair alone decides whether that long view is a tree or eza's
    // GridDetails. A last -1 makes the command a lines listing even when -T
    // or -G is present (the DirAction then sees a non-details view).
    let longSeenView = lastView == 1 || ((lastView == 3 || lastView == 4) && longSeen)
    let gridDetails = longSeenView && lastGT == 1
    o.longView = longSeenView
    o.treeView = treeSeen && (lastView == 3 || (o.longView && !gridDetails))
    o.gridView = !o.longView && !o.treeView &&
                 (lastView == 4 || (lastView == 0 && o.terminalish))
    // --tree with two --all is an error in eza's DotFilter deduction; it is
    // checked before the operand path and regardless of the effective view.
    if treeSeen && o.allCount >= 2 {
        return err("Option --tree is useless given --all --all", 22)
    }
    // eza's -l -G/-G -l is GridDetails (long cells arranged in grid
    // columns); this build implements grid and long separately and rejects
    // the combination with its own message (documented divergence).
    if gridDetails {
        return err("option '--grid' with -l is not supported by this build", 22)
    }
    // Effective-value validation, in eza's last-occurrence model. The cli
    // accept lists are deliberately empty for these flags: validating every
    // occurrence would reject `--sort=foo --sort=name`, which eza accepts.
    if len(o.sortField) > 0 {
        let valid = sortAccept()
        if !inStrings(valid, o.sortField) {
            return err(noSetting("--sort (-s)", o.sortField, sortChoices()), 22)
        }
        // E0 sort keys only; eza's valid-but-later values get this build's
        // message.
        if isRejectedSort(o.sortField) {
            return err(valueMessage("sort", o.sortField), 22)
        }
    }
    if len(classifyValue) > 0 && !isWhenValue(classifyValue) {
        return err(noSetting("--classify (-F)", classifyValue, noStrings()), 22)
    }
    // Classify::deduce: no flag is JustFilenames; always is Always; auto and
    // automatic mark only when is_a_tty (so --width/COLUMNS turn them on for
    // a pipe). Probed.
    o.classifyOn = classifyValue == "always" ||
                   ((classifyValue == "auto" || classifyValue == "automatic") &&
                    o.terminalish)
    if len(colorValue) > 0 && !isWhenValue(colorValue) {
        return err(noSetting("--color", colorValue, noStrings()), 22)
    }
    // NO_COLOR (present at all, even empty) makes the DEFAULT Never; an
    // explicit --color/--colour overrides it (verified source and probe).
    // auto needs isatty(stdout()), the P5a builtin.
    var colourMode = 0
    if env::has("NO_COLOR") { colourMode = 2 }
    if len(colorValue) > 0 {
        if colorValue == "always" {
            colourMode = 1
        } else if colorValue == "auto" || colorValue == "automatic" {
            colourMode = 0
        } else {
            colourMode = 2
        }
    }
    o.colourOn = colourMode == 1 || (colourMode == 0 && io::isTty(1))
    if len(iconsValue) > 0 && !isWhenValue(iconsValue) {
        return err(noSetting("--icons", iconsValue, noStrings()), 22)
    }
    if iconsValue == "always" {
        return err(valueMessage("icons", "always"), 22)
    }
    // -L is only parsed when the tree action is active (eza's DirAction
    // deduce); without -T an invalid level is silently ignored (probe).
    if o.treeView && o.levelSeen {
        let lv = levelValue(o.levelText)
        match lv {
            ok(v) { o.level = v }
            err(m, c) {
                var tail = "invalid digit found in string"
                if c == 2 { tail = "number too large to fit in target type" }
                if c == 3 { tail = "cannot parse integer from empty string" }
                return err("Value \"" + debugText(o.levelText) + "\" not valid for option --level (-L): " + tail, 22)
            }
        }
    }
    if o.longView {
        // Restricted long: -l is only accepted with the explicit
        // --bytes --time-style=long-iso (-n | --no-user) form (design 7.8).
        if o.timeStyleSeen && o.timeStyle != "long-iso" {
            return err("--time-style=" + o.timeStyle + " is not supported with -l in this build", 22)
        }
        if !o.timeStyleSeen || !o.bytes || !(o.numeric || o.noUser) {
            return err("-l in this build requires --bytes, --time-style=long-iso and -n or --no-user", 22)
        }
    } else {
        // No date column: long-iso and default are accepted and ignored; E0
        // rejects the other valid styles (a documented divergence).
        if o.timeStyleSeen && o.timeStyle != "long-iso" && o.timeStyle != "default" {
            return err("--time-style=" + o.timeStyle + " is not supported in this build", 22)
        }
    }
    return ok(o)
}

// ----------------------------------------------------------------- display

fn quoteName(name: string, quoteSpaces: bool): string {
    return strings::quoteName(name, quoteSpaces)
}

// An input operand as eza paints it: the parent prefix escaped once with the
// outer style, then the quoted last component. `.`, `..` and `/` are
// themselves; the root parent emits a single separator (design 7.2).
// `--no-quotes` turns the outer style into QuoteStyle::NoQuotes but still
// escapes control characters (quoteName(name, false) semantics).
fn operandDisplay(p: string, quoteSpaces: bool): string {
    if p == "/" { return "/" }
    let name = paths::lastComponent(p)
    let parent = paths::parentOf(p)
    if len(parent) == 0 { return quoteName(strings::lossy(name), quoteSpaces) }
    return strings::parentPrefix(strings::lossy(parent), quoteSpaces) +
           quoteName(strings::lossy(name), quoteSpaces)
}

fn newEntry(name: string, kind: byte, synthetic: byte): Entry {
    return new Entry{name: name, kind: kind, synthetic: synthetic, mode: 0,
                     size: 0, mtime: 0, mtimeNs: 0, uid: 0, statOk: false,
                     linkOk: false, targetRaw: "", targetValid: false,
                     targetKind: byte(0), targetMode: 0}
}

// eza's File::ext: the bytes after the last '.' (ASCII-lowercased), with a
// separate hasExt flag for the Option ordering (None before Some("")).
fn lastDot(name: string): int {
    var dot = -1
    for i in 0..len(name) {
        if name[i] == '.' { dot = i }
    }
    return dot
}

fn ezaHasExt(name: string): bool {
    return lastDot(name) >= 0
}

fn ezaExt(name: string): string {
    let dot = lastDot(name)
    if dot < 0 { return "" }
    return strings::lowerAscii(substr(name, dot + 1, len(name)))
}

// The synthetic "." entry's extension key is File::ext(dir.path): None when
// the operand's last component is ".", ".." or "/" (no file_name), otherwise
// the operand component's own extension. ".." is always None.
fn dotExtHas(operand: string): bool {
    let name = paths::lastComponent(operand)
    if name == "." || name == ".." || name == "/" { return false }
    return ezaHasExt(strings::lossy(name))
}

fn dotExtKey(operand: string): string {
    let name = paths::lastComponent(operand)
    if name == "." || name == ".." || name == "/" { return "" }
    return ezaExt(strings::lossy(name))
}

fn entryExtHas(e: &Entry, operand: string): bool {
    if int(e.synthetic) == 1 { return dotExtHas(operand) }
    if int(e.synthetic) == 2 { return false }
    return ezaHasExt(strings::lossy(e.name))
}

fn entryExtKey(e: &Entry, operand: string): string {
    if int(e.synthetic) == 1 { return dotExtKey(operand) }
    if int(e.synthetic) == 2 { return "" }
    return ezaExt(strings::lossy(e.name))
}

// Directory listing names only (no parent prefix); an operand shows its
// parent prefix and name. E2 displays the lossy form of a name (eza's
// File::filename is to_string_lossy); the raw bytes stay for path lookup.
fn displayName(v: &View, e: &Entry, quoteSpaces: bool): string {
    if v.single { return operandDisplay(v.operand, quoteSpaces) }
    return quoteName(strings::lossy(e.name), quoteSpaces)
}

fn entryPath(v: &View, e: &Entry): string {
    if v.single { return v.operand }
    if int(e.synthetic) == 1 { return v.operand }
    return paths::join(v.operand, e.name)
}

// The target-resolution base: a listing entry (including the synthetic ".")
// uses the operand directory itself, and a single operand uses its own parent.
// The synthetic "." is eza's File at dir.path, so its link target is reoriented
// against dir.path, not the path's parent; this is why `-aa links/realdirlink`
// shows `. -> realdir` with no classify marker (the probe's bytes), while a
// self-link `. -> .` classifies. See FORK/cmd README.
fn targetBase(v: &View): string {
    if v.single { return v.base }
    return v.operand
}

// ---------------------------------------------------------------- metadata

// The lstat fill shared by the long view, the size/modified sort keys, the
// executable marker and any entry whose type needed a lazily resolved lstat.
fn fillStat(mut e: &Entry, path: string) {
    let r = fs::lstat(path)
    match r {
        ok {
            e.statOk = true
            e.mode = r.value.mode
            e.size = r.value.size
            e.mtime = r.value.mtime
            e.mtimeNs = r.value.mtimeNs
            e.uid = r.value.uid
        }
        err {
            e.statOk = false
        }
    }
}

// A synthetic "."/".." entry: lstat its own path (the operand itself for ".",
// join(operand, "..") for ".."), and take kind/mode/size/mtime/uid from that
// lstat. This is the probe behavior for a symlink-to-directory operand: the
// "." row is the symlink itself (`. -> target`), not the target directory.
fn dotEntry(name: string, synthetic: byte, path: string): Entry {
    var e = newEntry(name, byte(fs::KIND_UNKNOWN), synthetic)
    fillStat(e, path)
    if e.statOk { e.kind = fs::typeOf(e.mode) }
    return e
}

// readlink plus stat (follow) on the resolved target path. The display uses
// the raw target bytes; classification uses the followed type.
fn fillTarget(mut e: &Entry, path: string, base: string) {
    let rl = fs::readlink(path)
    match rl {
        ok(data) {
            e.linkOk = true
            let raw = strings::fromBytes(data)
            e.targetRaw = raw
            let tp = paths::join(base, raw)
            let st = fs::stat(tp)
            match st {
                ok {
                    e.targetValid = true
                    e.targetKind = fs::typeOf(st.value.mode)
                    e.targetMode = st.value.mode
                }
                err {
                    e.targetValid = false
                    e.targetKind = byte(0)
                    e.targetMode = 0
                }
            }
        }
        err(m, c) {
            e.linkOk = false
        }
    }
}

fn isSizeSort(f: string): bool {
    return f == "size" || f == "filesize"
}

fn isModifiedSort(f: string): bool {
    if f == "modified" { return true }
    if f == "date" { return true }
    if f == "time" { return true }
    if f == "mod" { return true }
    if f == "new" { return true }
    if f == "newest" { return true }
    return false
}

fn needStat(o: &Opts): bool {
    if o.longView { return true }
    if o.classifyOn { return true }
    if o.colourOn { return true }
    if isSizeSort(o.sortField) { return true }
    if isModifiedSort(o.sortField) { return true }
    return false
}

// ------------------------------------------------------------- entry input

fn dotsEnabled(o: &Opts): bool {
    return o.allCount >= 2
}

fn hiddenEnabled(o: &Opts): bool {
    return o.allCount >= 1 || o.almostAll
}

fn hiddenName(name: string): bool {
    return len(name) > 0 && name[0] == '.'
}

// -D/-f: each keeps one lstat type; both together cancel (eza falls through
// to no filtering). Synthetic dots obey the same rule.
fn keepKind(kind: byte, o: &Opts): bool {
    if o.onlyDirs && !o.onlyFiles {
        return int(kind) == int(fs::KIND_DIR)
    }
    if o.onlyFiles && !o.onlyDirs {
        return int(kind) == int(fs::KIND_REG)
    }
    return true
}

// Hidden filtering (real names only) and -D/-f, before sorting. Synthetic
// dots are appended by the caller, before the real entries.
fn readDirEntries(mut d: &fs::Dir, mut es: &[]Entry, o: &Opts): Result[bool] {
    var e = new fs::DirEntry{name: "", ino: 0, kind: 0}
    var more = true
    while more {
        more = try fs::next(d, e)
        if more {
            var keep = true
            if hiddenName(e.name) && !hiddenEnabled(o) { keep = false }
            if keep && !keepKind(e.kind, o) { keep = false }
            if keep {
                append(es, newEntry(e.name, e.kind, byte(0)))
            }
        }
    }
    return ok(true)
}

// --------------------------------------------------------------- ordering

fn nameKeys(es: &[]Entry): []string {
    var out = new []string(0)
    for i in 0..len(es) {
        append(out, strings::lossy(es[i].name))
    }
    return out
}

fn sizeKeys(es: &[]Entry): []int {
    var out = new []int(0)
    for i in 0..len(es) {
        var v = -1
        if es[i].statOk { v = es[i].size }
        append(out, v)
    }
    return out
}

// eza's Option<NaiveDateTime>: a pre-1970 (or missing) mtime is None and
// sorts before every real time.
fn secKeys(es: &[]Entry): []int {
    var out = new []int(0)
    for i in 0..len(es) {
        var v = -1
        if es[i].statOk && es[i].mtime >= 0 { v = es[i].mtime }
        append(out, v)
    }
    return out
}

fn nsecKeys(es: &[]Entry): []int {
    var out = new []int(0)
    for i in 0..len(es) {
        var v = 0
        if es[i].statOk && es[i].mtime >= 0 { v = es[i].mtimeNs }
        append(out, v)
    }
    return out
}

fn extKeys(es: &[]Entry, operand: string): []string {
    var out = new []string(0)
    for i in 0..len(es) {
        append(out, entryExtKey(es[i], operand))
    }
    return out
}

fn extHasKeys(es: &[]Entry, operand: string): []int {
    var out = new []int(0)
    for i in 0..len(es) {
        var v = 0
        if entryExtHas(es[i], operand) { v = 1 }
        append(out, v)
    }
    return out
}

fn typeRank(kind: byte): int {
    if int(kind) == int(fs::KIND_DIR) { return 0 }
    if int(kind) == int(fs::KIND_REG) { return 1 }
    if int(kind) == int(fs::KIND_LNK) { return 2 }
    if int(kind) == int(fs::KIND_FIFO) { return 3 }
    if int(kind) == int(fs::KIND_SOCK) { return 4 }
    if int(kind) == int(fs::KIND_CHR) { return 5 }
    if int(kind) == int(fs::KIND_BLK) { return 6 }
    return 7
}

fn typeKeys(es: &[]Entry): []int {
    var out = new []int(0)
    for i in 0..len(es) {
        append(out, typeRank(es[i].kind))
    }
    return out
}

// points_to_directory: a directory, or a symlink whose followed target is a
// directory. Symlink target metadata is filled for every link.
fn pointsToDir(e: &Entry): bool {
    if int(e.kind) == int(fs::KIND_DIR) { return true }
    if int(e.kind) == int(fs::KIND_LNK) {
        return e.targetValid && int(e.targetKind) == int(fs::KIND_DIR)
    }
    return false
}

fn groupKeys(es: &[]Entry, o: &Opts): []int {
    var out = new []int(0)
    for i in 0..len(es) {
        let d = pointsToDir(es[i])
        var rank = 0
        if o.groupFirst {
            if !d { rank = 1 }
        } else {
            if d { rank = 1 }
        }
        append(out, rank)
    }
    return out
}

// A stable merge over an existing order with a string key array. mode 0 is
// byte order, 1 natural, 2 natural folded. desc is the P0-probed eza rule: a
// reversed comparator keeps comparator-equal entries in their input order
// (eza sorts with a stable descending comparison, it does not reverse the
// resulting vector -- `--sort=size -r` on equal sizes keeps readdir order).
fn keyCmp(keys: &[]string, i: int, j: int, mode: int): int {
    if mode == 0 { return strings::cmp(keys[i], keys[j]) }
    if mode == 1 { return strings::natcmp(keys[i], keys[j]) }
    return strings::natcmpFold(keys[i], keys[j])
}

fn mergeDir(order: []int, keys: &[]string, mode: int, desc: bool): []int {
    let n = len(order)
    if n < 2 { return order }
    var aux = new []int(n)
    var width = 1
    while width < n {
        var lo = 0
        while lo < n {
            var mid = lo + width
            if mid > n { mid = n }
            var hi = mid + width
            if hi > n { hi = n }
            var a = lo
            var b = mid
            var k = lo
            while a < mid && b < hi {
                let c = keyCmp(keys, order[a], order[b], mode)
                var takeLeft = c <= 0
                if desc { takeLeft = c >= 0 }
                if takeLeft {
                    aux[k] = order[a]
                    a += 1
                } else {
                    aux[k] = order[b]
                    b += 1
                }
                k += 1
            }
            while a < mid {
                aux[k] = order[a]
                a += 1
                k += 1
            }
            while b < hi {
                aux[k] = order[b]
                b += 1
                k += 1
            }
            for t in lo..hi { order[t] = aux[t] }
            lo = hi
        }
        width *= 2
    }
    return order
}

fn copyOrder(xs: &[]int): []int {
    var out = new []int(len(xs))
    for i in 0..len(xs) { out[i] = xs[i] }
    return out
}

// Stable natural order in the requested direction; comparator-equal names keep
// their input order in both directions.
fn orderNaturalDir(keys: &[]string, fold: bool, desc: bool): []int {
    var mode = 1
    if fold { mode = 2 }
    let init = sort::identity(len(keys))
    return mergeDir(init, keys, mode, desc)
}

// The same merge over an existing order (the extension pipeline's passes).
fn sortOrderStringsDir(order: &[]int, keys: &[]string, desc: bool): []int {
    let init = copyOrder(order)
    return mergeDir(init, keys, 0, desc)
}

// A new int array with every key negated: a stable ascending sort of it is the
// stable descending sort of the original (ties keep their order, unlike the
// vector reversal the design note describes; the live probe pins this).
fn negKeys(xs: &[]int): []int {
    var out = new []int(len(xs))
    for i in 0..len(xs) { out[i] = -xs[i] }
    return out
}

// The E0 order. The field sort is ascending or a stable descending comparison
// under -r (probe-confirmed: ties keep readdir order), then the directory
// grouping is a final stable sort in either mode. Every helper keeps input
// order for equal keys; the committed fixtures also avoid comparator ties.
fn sortFieldOrder(es: &[]Entry, v: &View, o: &Opts, desc: bool): []int {
    let f = o.sortField
    var order = sort::identity(len(es))
    if f == "" || f == "name" || f == "filename" {
        let ks = nameKeys(es)
        order = orderNaturalDir(ks, true, desc)
    } else if f == "Name" || f == "Filename" {
        let ks = nameKeys(es)
        order = orderNaturalDir(ks, false, desc)
    } else if isSizeSort(f) {
        let ks = sizeKeys(es)
        if desc {
            let nk = negKeys(ks)
            order = sort::sortOrderInts(&order, &nk)
        } else {
            order = sort::sortOrderInts(&order, &ks)
        }
    } else if isModifiedSort(f) {
        let ns = nsecKeys(es)
        let sec = secKeys(es)
        if desc {
            let nk = negKeys(ns)
            let sk = negKeys(sec)
            let o1 = sort::sortOrderInts(&order, &nk)
            order = sort::sortOrderInts(&o1, &sk)
        } else {
            let o1 = sort::sortOrderInts(&order, &ns)
            order = sort::sortOrderInts(&o1, &sec)
        }
    } else if f == "extension" || f == "ext" {
        let ks = nameKeys(es)
        let pre = orderNaturalDir(ks, true, desc)
        let ek = extKeys(es, v.operand)
        let hk = extHasKeys(es, v.operand)
        let o1 = sortOrderStringsDir(&pre, &ek, desc)
        if desc {
            let nh = negKeys(hk)
            order = sort::sortOrderInts(&o1, &nh)
        } else {
            order = sort::sortOrderInts(&o1, &hk)
        }
    } else if f == "Extension" || f == "Ext" {
        let ks = nameKeys(es)
        let pre = orderNaturalDir(ks, false, desc)
        let ek = extKeys(es, v.operand)
        let hk = extHasKeys(es, v.operand)
        let o1 = sortOrderStringsDir(&pre, &ek, desc)
        if desc {
            let nh = negKeys(hk)
            order = sort::sortOrderInts(&o1, &nh)
        } else {
            order = sort::sortOrderInts(&o1, &hk)
        }
    } else {
        let ks = nameKeys(es)
        let pre = orderNaturalDir(ks, false, desc)
        let tk = typeKeys(es)
        if desc {
            let rk = negKeys(tk)
            order = sort::sortOrderInts(&pre, &rk)
        } else {
            order = sort::sortOrderInts(&pre, &tk)
        }
    }
    return order
}

// The stable dirs-first/last pass shared by both -r models.
fn groupOrder(es: &[]Entry, o: &Opts, order: []int): []int {
    if o.groupFirst || o.groupLast {
        let gk = groupKeys(es, o)
        return sort::sortOrderInts(&order, &gk)
    }
    return order
}

// Lines/long: eza compares descending in one stable pass, so comparator-equal
// entries keep readdir order (P4's probe).
fn sortEntries(es: &[]Entry, v: &View, o: &Opts): []int {
    let order = sortFieldOrder(es, v, o, o.reverse)
    return groupOrder(es, o, order)
}

// Tree: eza sorts once ascending, then reverses the vector when -r (which also
// reverses ties), then applies the stable dirs-first/last pass.
fn sortEntriesTree(es: &[]Entry, v: &View, o: &Opts): []int {
    var order = sortFieldOrder(es, v, o, false)
    if o.reverse { sort::reverse(order) }
    return groupOrder(es, o, order)
}

// ----------------------------------------------------------------- output

// eza's classify markers: directory, executable regular file, FIFO, socket;
// a symlink never reaches here for a non-grid view (its target is marked).
fn markerFor(kind: byte, mode: int): string {
    if int(kind) == int(fs::KIND_DIR) { return "/" }
    if int(kind) == int(fs::KIND_REG) {
        if mode & 0x040 != 0 { return "*" }
        return ""
    }
    if int(kind) == int(fs::KIND_FIFO) { return "|" }
    if int(kind) == int(fs::KIND_SOCK) { return "=" }
    return ""
}

// A valid target: parent prefix with the outer style, target name with
// QuoteSpaces, then the followed-type marker under -F=always. A broken target
// is the whole raw target escaped with the outer style and never marked; an
// unreadable target has no arrow at all (the caller skips it).
fn targetDisplay(e: &Entry, classify: bool, quoteSpaces: bool): string {
    if e.targetValid {
        // eza's target File is built from the raw readlink Path: the parent
        // prefix is to_string_lossy(parent), the name is the lossy last
        // component. The raw bytes are only for resolution.
        let parent = paths::parentOf(e.targetRaw)
        let prefix = strings::parentPrefix(strings::lossy(parent), quoteSpaces)
        var s = prefix + quoteName(strings::lossy(paths::lastComponent(e.targetRaw)), true)
        if classify {
            s = s + markerFor(e.targetKind, e.targetMode)
        }
        return s
    }
    return quoteName(strings::lossy(e.targetRaw), quoteSpaces)
}

fn appendStr(mut out: &[]byte, s: string) {
    for i in 0..len(s) {
        append(out, s[i])
    }
}

// Right-align a string in width (width 0: no padding).
fn appendRightStr(mut out: &[]byte, s: string, width: int) {
    let pad = width - len(s)
    if pad > 0 {
        for i in 0..pad { append(out, ' ') }
    }
    appendStr(out, s)
}

// Right-align a non-negative int in width (width 0: no padding).
fn appendRightInt(mut out: &[]byte, v: int, width: int) {
    appendRightStr(out, string(v), width)
}

// Left-align a string in width (width 0: no padding). E0 widths are bytes.
fn appendLeftStr(mut out: &[]byte, s: string, width: int) {
    appendStr(out, s)
    let pad = width - len(s)
    if pad > 0 {
        for i in 0..pad { append(out, ' ') }
    }
}

// eza's File::size(): the decimal size of a regular file, -1 (displayed as
// one '-') for every other type.
fn sizeCell(e: &Entry): int {
    if !e.statOk { return -1 }
    return fs::sizeForLong(e.mode, e.size)
}

// Widths over the displayed entry set: right-aligned size, left-aligned
// numeric uid (only with -n and not --no-user) and left-aligned date (16 for
// any representable mtime, 1 for the lone "-").
fn computeCols(es: &[]Entry, o: &Opts): Cols {
    var sw = 0
    var uw = 0
    var dw = 0
    var i = 0
    while i < len(es) {
        if !o.noFilesize {
            let c = sizeCell(es[i])
            var w = 1
            if c >= 0 { w = fmt::digits(c) }
            if w > sw { sw = w }
        }
        if o.numeric && !o.noUser {
            let w = fmt::digits(es[i].uid)
            if w > uw { uw = w }
        }
        if !o.noTime {
            var w = 1
            if es[i].statOk && es[i].mtime >= 0 { w = 16 }
            if w > dw { dw = w }
        }
        i += 1
    }
    return new Cols{sizeWidth: sw, userWidth: uw, dateWidth: dw}
}

// The symlink arrow and target, or the classify marker on a non-link name.
fn appendTargetAndMarker(e: &Entry, o: &Opts, mut out: &[]byte) {
    if int(e.kind) == int(fs::KIND_LNK) {
        if e.linkOk {
            appendStr(out, " -> ")
            appendStr(out, targetDisplay(e, o.classifyOn, !o.noQuotes))
        }
    } else if o.classifyOn {
        appendStr(out, markerFor(e.kind, e.mode))
    }
}

// The restricted-long cells plus the separator before the name (the line
// prefix). With every column suppressed the prefix is empty, so the caller
// adds no space.
fn appendLongCells(e: &Entry, o: &Opts, cols: &Cols, mut out: &[]byte) {
    var first = true
    if !o.noPermissions {
        appendStr(out, fmt::modeString(e.mode))
        first = false
    }
    if !o.noFilesize {
        if !first { append(out, ' ') }
        let c = sizeCell(e)
        if c < 0 {
            appendRightStr(out, "-", cols.sizeWidth)
        } else {
            appendRightInt(out, c, cols.sizeWidth)
        }
        first = false
    }
    if o.numeric && !o.noUser {
        if !first { append(out, ' ') }
        appendLeftStr(out, string(e.uid), cols.userWidth)
        first = false
    }
    if !o.noTime {
        if !first { append(out, ' ') }
        var ds = "-"
        if e.statOk && e.mtime >= 0 { ds = time::formatLongIso(e.mtime) }
        appendLeftStr(out, ds, cols.dateWidth)
        first = false
    }
    if !first { append(out, ' ') }
}

// The width of the long prefix (the table's total width), used to pad a tree
// error row, which has no cells.
fn longPrefixWidth(o: &Opts, cols: &Cols): int {
    var w = 0
    var first = true
    if !o.noPermissions {
        w += 10
        first = false
    }
    if !o.noFilesize {
        if !first { w += 1 }
        w += cols.sizeWidth
        first = false
    }
    if o.numeric && !o.noUser {
        if !first { w += 1 }
        w += cols.userWidth
        first = false
    }
    if !o.noTime {
        if !first { w += 1 }
        w += cols.dateWidth
        first = false
    }
    if !first { w += 1 }
    return w
}

// One line in the current view: the restricted long cells (permissions, size,
// user under -n, modified date) then the name, or the lines/default form.
// Suppressed columns and their separators disappear entirely; with every cell
// suppressed the line is the name alone.
fn renderLine(e: &Entry, v: &View, o: &Opts, cols: &Cols, mut out: &[]byte) {
    let quoteSpaces = !o.noQuotes
    if o.longView { appendLongCells(e, o, cols, out) }
    appendStr(out, displayName(v, e, quoteSpaces))
    appendTargetAndMarker(e, o, out)
}

// ------------------------------------------------------- colour: the theme

// The pinned reference's default file-type palette (source
// src/info/filetype.rs at v0.23.3): a lowercase extension category and a
// small exact-filename table, plus readme* (Build), a trailing '~' and a
// leading/trailing '#' (Temp). The compiled-source heuristic (a .o beside its
// .c) is deliberately not implemented (documented E1 divergence); it needs a
// directory listing the colour layer does not have. Tables are space
// separated and checked with exact word comparison, so they can be consts.
const EXT_BUILD = "ninja "
const EXT_IMAGE = "arw avif bmp cbr cbz cr2 dvi eps fodg gif heic heif ico j2c j2k jfi jfif jif jp2 jpe jpeg jpf jpg jpx jxl kra krz nef odg orf pbm pgm png pnm ppm ps psd pxm qoi raw svg tif tiff webp xcf xpm "
const EXT_VIDEO = "avi flv h264 heics m2ts m2v m4v mkv mov mp4 mpeg mpg ogm ogv video vob webm wmv "
const EXT_MUSIC = "aac m4a mka mp2 mp3 ogg opus wma "
const EXT_LOSSLESS = "aif aifc aiff alac ape flac pcm wav wv "
const EXT_CRYPTO = "age asc cer crt csr gpg kbx md5 p12 pem pfx pgp pub sha1 sha224 sha256 sha384 sha512 sig signature "
const EXT_DOCUMENT = "djvu doc docx eml fodp fods fodt fotd gdoc key keynote numbers odp ods odt pages pdf ppt pptx rtf xls xlsm xlsx "
const EXT_COMPRESSED = "7z ar arj br bz bz2 bz3 cpio deb dmg gz iso lz lz4 lzh lzma lzo phar qcow qcow2 rar rpm tar taz tbz tbz2 tc tgz tlz txz tz vdi vhd vhdx vmdk xz z zip zst "
const EXT_TEMP = "bak bk bkp crdownload download fcbak fcstd1 fdmdownload part swn swo swp tmp "
const EXT_COMPILED = "a bundle class cma cmi cmo cmx dll dylib elc elf ko lib o obj pyc pyd pyo so zwc "
const EXT_SOURCE = "applescript as asa awk c c++ c++m cabal cc ccm clj cp cpp cppm cr cs css csx cu cxx cxxm cypher d dart di dpr el elm erl ex exs f f90 fcmacro fcscript fnl for fs fsh fsi fsx gd go gradle groovy gvy h h++ hc hh hpp hs htc hxx inc inl ino ipynb ixx java jl js jsx kt kts kusto less lhs lisp ltx lua m malloy matlab ml mli mn nb p pas php pl pm pod pp prql ps1 psd1 psm1 purs py r rb rq rs sass scad scala scm scss sld sql ss swift tcl tex ts v vb vsh zig "
const FN_BUILD = "BUILD BUILD.bazel Brewfile CMakeLists.txt Cargo.toml Containerfile Dockerfile Earthfile GNUmakefile Gemfile Gruntfile.coffee Gruntfile.js Justfile Makefile PKGBUILD Pipfile Podfile Procfile Rakefile RoboFile.php SConstruct Vagrantfile WORKSPACE bsconfig.json build.gradle build.sbt build.xml composer.json configure flake.nix jsconfig.json justfile makefile meson.build mix.exs package.json pom.xml pyproject.toml tsconfig.json webpack.config.cjs webpack.config.js "
const FN_CRYPTO = "id_dsa id_ecdsa id_ecdsa_sk id_ed25519 id_ed25519_sk id_rsa "

fn newStyle(): Style {
    return new Style{fg: 0, fgA: 0, fgB: 0, fgC: 0, bg: 0, bgA: 0, bgB: 0,
                     bgC: 0, bold: false, dim: false, italic: false,
                     underline: false, blink: false, reverse: false,
                     hidden: false, strike: false}
}

fn styleFg(code: int): Style {
    var s = newStyle()
    s.fg = 1
    s.fgA = code
    return s
}

fn styleFgBold(code: int): Style {
    var s = styleFg(code)
    s.bold = true
    return s
}

fn styleFgUnder(code: int): Style {
    var s = styleFg(code)
    s.underline = true
    return s
}

fn styleFgBoldUnder(code: int): Style {
    var s = styleFgUnder(code)
    s.bold = true
    return s
}

fn styleFgBoldDim(): Style {
    var s = newStyle()
    s.dim = true
    return s
}

fn stylePlain(s: &Style): bool {
    if s.fg != 0 || s.bg != 0 { return false }
    if s.bold || s.dim || s.italic || s.underline { return false }
    if s.blink || s.reverse || s.hidden || s.strike { return false }
    return true
}

// The default theme of eza 0.23.3 (src/theme/default_theme.rs). Slots not in
// the E1 subset stay plain.
fn newPalette(): Palette {
    var st = new []Style(0)
    var i = 0
    while i < SC_SLOTS {
        append(st, newStyle())
        i += 1
    }
    st[SC_DIR] = styleFgBold(34)
    st[SC_LNK] = styleFg(36)
    st[SC_PIPE] = styleFg(33)
    st[SC_BLOCK] = styleFgBold(33)
    st[SC_CHAR] = styleFgBold(33)
    st[SC_SOCK] = styleFgBold(31)
    st[SC_SPECIAL] = styleFg(33)
    st[SC_EXE] = styleFgBold(32)
    st[SC_MOUNT] = styleFgBoldUnder(34)
    st[SC_PUNCT] = styleFgBold(90)
    st[SC_SYMLINK_PATH] = styleFg(36)
    st[SC_CONTROL] = styleFg(31)
    st[SC_BROKEN] = styleFg(31)
    st[SC_BROKEN_FILE] = styleFgUnder(31)
    st[SC_BROKEN_CONTROL] = styleFgUnder(31)
    st[SC_IMAGE] = styleFg(35)
    st[SC_VIDEO] = styleFgBold(35)
    st[SC_MUSIC] = styleFg(36)
    st[SC_LOSSLESS] = styleFgBold(36)
    st[SC_CRYPTO] = styleFgBold(32)
    st[SC_DOCUMENT] = styleFg(32)
    st[SC_COMPRESSED] = styleFg(31)
    st[SC_TEMP] = styleFgBoldDim()
    st[SC_COMPILED] = styleFg(33)
    st[SC_BUILD] = styleFgBoldUnder(33)
    st[SC_SOURCE] = styleFgBold(33)
    return new Palette{styles: st, patterns: new []ExtPat(0),
                       useDefaultTypes: true}
}

// Exact word membership in a space-separated const table.
fn wordSpanEq(table: string, st: int, en: int, w: string): bool {
    if en - st != len(w) { return false }
    var i = 0
    while i < len(w) {
        if table[st + i] != w[i] { return false }
        i += 1
    }
    return true
}

fn wordIn(table: string, w: string): bool {
    if len(w) == 0 { return false }
    var i = 0
    while i < len(table) {
        while i < len(table) && table[i] == ' ' { i += 1 }
        var st = i
        while i < len(table) && table[i] != ' ' { i += 1 }
        if i > st && wordSpanEq(table, st, i, w) { return true }
    }
    return false
}

// The lowercase bytes after the name's last '.', or "" when there is no dot.
fn lowerExt(name: string): string {
    let dot = lastDot(name)
    if dot < 0 { return "" }
    return strings::lowerAscii(substr(name, dot + 1, len(name)))
}

// FileType::get_file_type for the E1 subset (readme*, filename table,
// lowercase extension table, temp suffixes; no compiled-source heuristic).
fn fileCategory(name: string, p: &Palette): int {
    if !p.useDefaultTypes { return 0 }
    let low = strings::lowerAscii(name)
    if strings::startsWith(low, "readme") { return SC_BUILD }
    if wordIn(FN_BUILD, name) { return SC_BUILD }
    if wordIn(FN_CRYPTO, name) { return SC_CRYPTO }
    let ext = lowerExt(name)
    if len(ext) > 0 {
        if wordIn(EXT_IMAGE, ext) { return SC_IMAGE }
        if wordIn(EXT_VIDEO, ext) { return SC_VIDEO }
        if wordIn(EXT_MUSIC, ext) { return SC_MUSIC }
        if wordIn(EXT_LOSSLESS, ext) { return SC_LOSSLESS }
        if wordIn(EXT_CRYPTO, ext) { return SC_CRYPTO }
        if wordIn(EXT_DOCUMENT, ext) { return SC_DOCUMENT }
        if wordIn(EXT_COMPRESSED, ext) { return SC_COMPRESSED }
        if wordIn(EXT_TEMP, ext) { return SC_TEMP }
        if wordIn(EXT_COMPILED, ext) { return SC_COMPILED }
        if wordIn(EXT_BUILD, ext) { return SC_BUILD }
        if wordIn(EXT_SOURCE, ext) { return SC_SOURCE }
    }
    if strings::endsWith(name, "~") { return SC_TEMP }
    if len(name) > 0 && name[0] == '#' && name[len(name) - 1] == '#' {
        return SC_TEMP
    }
    return 0
}

// The last matching `*.` mapping (the reference walks its mappings backwards:
// a later LS_COLORS/EZA_COLORS pair overrides an earlier one). kind 0 is a
// simple extension key; kind 1 is a literal suffix containing a dot.
fn patternIndex(name: string, p: &Palette): int {
    var i = len(p.patterns) - 1
    while i >= 0 {
        let pat = &p.patterns[i]
        if pat.kind == 0 {
            let dot = lastDot(name)
            if dot >= 0 && substr(name, dot + 1, len(name)) == pat.key {
                return i
            }
        } else {
            let k = pat.key
            if len(name) > len(k) && name[len(name) - len(k) - 1] == '.' &&
                    strings::endsWith(name, k) {
                return i
            }
        }
        i -= 1
    }
    return -1
}

// ------------------------------------------------- colour: LS_COLORS parsing

fn firstEqFrom(s: string, from: int): int {
    var i = from
    while i < len(s) {
        if s[i] == '=' { return i }
        i += 1
    }
    return -1
}

// eza's LSColors::each_pair: split on ':', then split('=').take(3); only a
// token with exactly one '=' and both sides non-empty is a pair.
fn isPairToken(tok: string): bool {
    let e = firstEqFrom(tok, 0)
    if e <= 0 || e + 1 >= len(tok) { return false }
    var i = e + 1
    while i < len(tok) {
        if tok[i] == '=' { return false }
        i += 1
    }
    return true
}

fn pairKey(tok: string): string {
    let e = firstEqFrom(tok, 0)
    return substr(tok, 0, e)
}

fn pairValue(tok: string): string {
    let e = firstEqFrom(tok, 0)
    return substr(tok, e + 1, len(tok))
}

// trim_start_matches('0'): the string after its leading zeros ("" for a
// token made only of zeros).
fn trimZeros(t: string): string {
    var i = 0
    while i < len(t) && t[i] == '0' { i += 1 }
    return substr(t, i, len(t))
}

// Rust u8::from_str, roughly: an optional '+', decimal digits, value <= 255.
// -1 on failure.
fn parseU8(t: string): int {
    var i = 0
    if i < len(t) && t[i] == '+' { i += 1 }
    if i >= len(t) { return -1 }
    var v = 0
    while i < len(t) {
        if t[i] < '0' || t[i] > '9' { return -1 }
        v = v * 10 + (int(t[i]) - 48)
        if v > 255 { return -1 }
        i += 1
    }
    return v
}

// The colour-kind setters clear the unused components, so a later SGR token
// that changes the kind cannot leave stale RGB bytes behind (the reference's
// Colour enum has no such fields). Used by Pair::to_style and highColour.
fn setFgBasic(mut s: &Style, code: int) {
    s.fg = 1
    s.fgA = code
    s.fgB = 0
    s.fgC = 0
}

fn setBgBasic(mut s: &Style, code: int) {
    s.bg = 1
    s.bgA = code
    s.bgB = 0
    s.bgC = 0
}

fn setFgFixed(mut s: &Style, n: int) {
    s.fg = 2
    s.fgA = n
    s.fgB = 0
    s.fgC = 0
}

fn setBgFixed(mut s: &Style, n: int) {
    s.bg = 2
    s.bgA = n
    s.bgB = 0
    s.bgC = 0
}

fn setFgRgb(mut s: &Style, r: int, g: int, b: int) {
    s.fg = 3
    s.fgA = r
    s.fgB = g
    s.fgC = b
}

fn setBgRgb(mut s: &Style, r: int, g: int, b: int) {
    s.bg = 3
    s.bgA = r
    s.bgB = g
    s.bgC = b
}

// The `38`/`48` extended-colour parser of the reference Pair::to_style:
// "5;n" selects a fixed colour, "2;r;g;b" an RGB one; it returns the index of
// the last token consumed. The mode token is matched raw (not zero-trimmed).
fn highColour(mut s: &Style, parts: &[]string, i: int, isFg: bool): int {
    var last = i
    if i + 1 < len(parts) && parts[i + 1] == "5" {
        last = i + 1
        if i + 2 < len(parts) {
            last = i + 2
            let n = parseU8(parts[i + 2])
            if n >= 0 {
                if isFg { setFgFixed(s, n) } else { setBgFixed(s, n) }
            }
        }
    } else if i + 1 < len(parts) && parts[i + 1] == "2" {
        last = i + 1
        if i + 2 < len(parts) {
            last = i + 2
            let r = parseU8(parts[i + 2])
            if i + 3 < len(parts) {
                last = i + 3
                let g = parseU8(parts[i + 3])
                if i + 4 < len(parts) {
                    last = i + 4
                    let b = parseU8(parts[i + 4])
                    if r >= 0 && g >= 0 && b >= 0 {
                        if isFg { setFgRgb(s, r, g, b) } else { setBgRgb(s, r, g, b) }
                    }
                }
            }
        }
    }
    return last
}

// Pair::to_style: split the value on ';', zero-trim each token, apply the
// recognised SGR numbers and ignore everything else. Unknown numbers and
// invalid extended-colour parameters leave the style unchanged (so a value
// such as "bogus" parses to the empty style, which still overrides the
// default slot).
fn parsePairStyle(value: string): Style {
    var s = newStyle()
    let sp = strings::splitByte(value, ';')
    match sp {
        ok {
            let parts = &sp.value
            var i = 0
            while i < len(parts) {
                let t = trimZeros(parts[i])
                if t == "1" {
                    s.bold = true
                } else if t == "2" {
                    s.dim = true
                } else if t == "3" {
                    s.italic = true
                } else if t == "4" {
                    s.underline = true
                } else if t == "5" {
                    s.blink = true
                } else if t == "7" {
                    s.reverse = true
                } else if t == "8" {
                    s.hidden = true
                } else if t == "9" {
                    s.strike = true
                } else if t == "30" {
                    setFgBasic(s, 30)
                } else if t == "31" {
                    setFgBasic(s, 31)
                } else if t == "32" {
                    setFgBasic(s, 32)
                } else if t == "33" {
                    setFgBasic(s, 33)
                } else if t == "34" {
                    setFgBasic(s, 34)
                } else if t == "35" {
                    setFgBasic(s, 35)
                } else if t == "36" {
                    setFgBasic(s, 36)
                } else if t == "37" {
                    setFgBasic(s, 37)
                } else if t == "90" {
                    setFgBasic(s, 90)
                } else if t == "91" {
                    setFgBasic(s, 91)
                } else if t == "92" {
                    setFgBasic(s, 92)
                } else if t == "93" {
                    setFgBasic(s, 93)
                } else if t == "94" {
                    setFgBasic(s, 94)
                } else if t == "95" {
                    setFgBasic(s, 95)
                } else if t == "96" {
                    setFgBasic(s, 96)
                } else if t == "97" {
                    setFgBasic(s, 97)
                } else if t == "38" {
                    i = highColour(s, parts, i, true)
                } else if t == "40" {
                    setBgBasic(s, 40)
                } else if t == "41" {
                    setBgBasic(s, 41)
                } else if t == "42" {
                    setBgBasic(s, 42)
                } else if t == "43" {
                    setBgBasic(s, 43)
                } else if t == "44" {
                    setBgBasic(s, 44)
                } else if t == "45" {
                    setBgBasic(s, 45)
                } else if t == "46" {
                    setBgBasic(s, 46)
                } else if t == "47" {
                    setBgBasic(s, 47)
                } else if t == "100" {
                    setBgBasic(s, 100)
                } else if t == "101" {
                    setBgBasic(s, 101)
                } else if t == "102" {
                    setBgBasic(s, 102)
                } else if t == "103" {
                    setBgBasic(s, 103)
                } else if t == "104" {
                    setBgBasic(s, 104)
                } else if t == "105" {
                    setBgBasic(s, 105)
                } else if t == "106" {
                    setBgBasic(s, 106)
                } else if t == "107" {
                    setBgBasic(s, 107)
                } else if t == "48" {
                    i = highColour(s, parts, i, false)
                }
                i += 1
            }
        }
        err { }
    }
    return s
}

// True for the characters that make a `*.` key a real glob in the reference.
// Those advanced keys are out of E1 and are ignored; a dot alone is supported
// as the literal-suffix form ("*.tar.gz").
fn hasGlobChars(t: string): bool {
    for i in 0..len(t) {
        let b = t[i]
        if b == '?' || b == '*' || b == '[' || b == ']' { return true }
    }
    return false
}

fn hasDot(t: string): bool {
    for i in 0..len(t) {
        if t[i] == '.' { return true }
    }
    return false
}

// One (key, value) pair. The E1 subset is di, ln, ex, fi and `*.EXT`;
// everything else (pi/so/bd/cd/or, the EZA_COLORS UI codes, unknown keys and
// real glob patterns) is ignored. The reference treats an unknown LS_COLORS
// key as a filename glob; no E1 test file is named like one, and this is a
// documented divergence.
fn applyColourPair(mut p: &Palette, tok: string) {
    if !isPairToken(tok) { return }
    let key = pairKey(tok)
    let value = pairValue(tok)
    if key == "di" {
        p.styles[SC_DIR] = parsePairStyle(value)
    } else if key == "ln" {
        p.styles[SC_LNK] = parsePairStyle(value)
    } else if key == "ex" {
        p.styles[SC_EXE] = parsePairStyle(value)
    } else if key == "fi" {
        p.styles[SC_NORMAL] = parsePairStyle(value)
    } else if strings::startsWith(key, "*.") {
        let rest = substr(key, 2, len(key))
        if hasGlobChars(rest) { return }
        var kind = 0
        if hasDot(rest) { kind = 1 }
        append(p.patterns, new ExtPat{kind: kind, key: rest,
                                      style: parsePairStyle(value)})
    }
}

fn parseColourVar(mut p: &Palette, s: string) {
    let sp = strings::splitByte(s, ':')
    match sp {
        ok {
            let parts = &sp.value
            var i = 0
            while i < len(parts) {
                applyColourPair(p, parts[i])
                i += 1
            }
        }
        err { }
    }
}

// LS_COLORS first, then EZA_COLORS (or EXA_COLORS when EZA_COLORS is absent;
// present-empty still wins). A leading "reset" or "reset:" in the EZA string
// turns off the default file-type palette. Only called when colour is on.
fn parseColourEnv(mut p: &Palette) {
    if env::has("LS_COLORS") {
        parseColourVar(p, env::value("LS_COLORS"))
    }
    var haveExa = false
    var exa = ""
    if env::has("EZA_COLORS") {
        exa = env::value("EZA_COLORS")
        haveExa = true
    } else if env::has("EXA_COLORS") {
        exa = env::value("EXA_COLORS")
        haveExa = true
    }
    if haveExa {
        if exa == "reset" || strings::startsWith(exa, "reset:") {
            p.useDefaultTypes = false
        }
        parseColourVar(p, exa)
    }
}

// ------------------------------------------------------ colour: line pieces

fn addStyleBit(mut bits: &[]Bit, s: &Style, text: string) {
    append(bits, new Bit{fg: s.fg, fgA: s.fgA, fgB: s.fgB, fgC: s.fgC,
                         bg: s.bg, bgA: s.bgA, bgB: s.bgB, bgC: s.bgC,
                         bold: s.bold, dim: s.dim, italic: s.italic,
                         underline: s.underline, blink: s.blink,
                         reverse: s.reverse, hidden: s.hidden,
                         strike: s.strike, text: text})
}

fn addPlainBit(mut bits: &[]Bit, text: string) {
    var s = newStyle()
    addStyleBit(bits, s, text)
}

fn copyStyle(s: &Style): Style {
    return new Style{fg: s.fg, fgA: s.fgA, fgB: s.fgB, fgC: s.fgC,
                     bg: s.bg, bgA: s.bgA, bgB: s.bgB, bgC: s.bgC,
                     bold: s.bold, dim: s.dim, italic: s.italic,
                     underline: s.underline, blink: s.blink,
                     reverse: s.reverse, hidden: s.hidden, strike: s.strike}
}

fn addPalBit(mut bits: &[]Bit, p: &Palette, code: int, text: string) {
    var s = copyStyle(&p.styles[code])
    addStyleBit(bits, s, text)
}

fn hexDigit(v: int): byte {
    if v < 10 { return byte(48 + v) }
    return byte(87 + v)
}

// The QuoteSpaces escape text for one control byte: \t, \n, \r, else
// \u{h} with lowercase hex and no leading zeros (strings::quoteName's rule).
fn appendControlEscape(mut out: &[]byte, b: byte) {
    append(out, '\\')
    if b == '\t' {
        append(out, 't')
    } else if b == '\n' {
        append(out, 'n')
    } else if b == '\r' {
        append(out, 'r')
    } else {
        append(out, 'u')
        append(out, '{')
        let v = int(b)
        if v >= 16 { append(out, hexDigit(v / 16)) }
        append(out, hexDigit(v % 16))
        append(out, '}')
    }
}

fn printableByte(b: byte): bool {
    return b >= ' ' && b != 127
}

// The reference's output/escape.rs: quote the whole text when the quote style
// asks for it, and paint controls with the bad style. Adjacent pieces with the
// same style render with no escape between them, so grouping a run of
// printable bytes (or a run of controls) into one bit is byte-identical to the
// reference's per-character bits.
fn addEscapedBits(mut bits: &[]Bit, good: &Style, bad: &Style, s: string,
                  quoteSpaces: bool) {
    var needs = false
    var hasSingle = false
    for i in 0..len(s) {
        if s[i] == ' ' || s[i] == '\'' { needs = true }
        if s[i] == '\'' { hasSingle = true }
    }
    var quote = false
    var q: byte = '\''
    if quoteSpaces && needs {
        quote = true
        if hasSingle { q = '"' }
    }
    if quote {
        if q == '\'' { addStyleBit(bits, good, "'") } else { addStyleBit(bits, good, "\"") }
    }
    var i = 0
    while i < len(s) {
        if printableByte(s[i]) {
            let st = i
            while i < len(s) && printableByte(s[i]) { i += 1 }
            addStyleBit(bits, good, substr(s, st, i))
        } else {
            var txt = new []byte(0)
            while i < len(s) && !printableByte(s[i]) {
                appendControlEscape(txt, s[i])
                i += 1
            }
            let text = strings::fromBytes(txt)
            addStyleBit(bits, bad, text)
        }
    }
    if quote {
        if q == '\'' { addStyleBit(bits, good, "'") } else { addStyleBit(bits, good, "\"") }
    }
}

fn addPalEscaped(mut bits: &[]Bit, p: &Palette, code: int, badCode: int,
                 text: string, quoteSpaces: bool) {
    var g = copyStyle(&p.styles[code])
    var b = copyStyle(&p.styles[badCode])
    addEscapedBits(bits, g, b, text, quoteSpaces)
}

// The parent prefix of an operand or a symlink target: the whole parent is
// escaped once with the outer quote style and followed by a single separator.
// The root parent is exactly "/" (parentPrefix's root branch).
fn addParentBits(mut bits: &[]Bit, p: &Palette, parent: string,
                 quoteSpaces: bool) {
    if len(parent) == 0 { return }
    if parent == "/" {
        addPalBit(bits, p, SC_SYMLINK_PATH, "/")
        return
    }
    addPalEscaped(bits, p, SC_SYMLINK_PATH, SC_CONTROL, parent, quoteSpaces)
    addPalBit(bits, p, SC_SYMLINK_PATH, "/")
}

// The style slot for a file kind, in the reference's File::style order:
// directory, executable regular, symlink, FIFO, block, char, socket, special.
// Regular files that are not executable go through colour_file (patterns,
// then the default file-type palette, then `fi`), handled by the caller.
fn kindSlot(kind: byte, mode: int): int {
    if int(kind) == int(fs::KIND_DIR) { return SC_DIR }
    if int(kind) == int(fs::KIND_REG) { return SC_EXE }
    if int(kind) == int(fs::KIND_LNK) { return SC_LNK }
    if int(kind) == int(fs::KIND_FIFO) { return SC_PIPE }
    if int(kind) == int(fs::KIND_BLK) { return SC_BLOCK }
    if int(kind) == int(fs::KIND_CHR) { return SC_CHAR }
    if int(kind) == int(fs::KIND_SOCK) { return SC_SOCK }
    return SC_SPECIAL
}

// The name bits for one file: the reference's FileName::style plus
// escaped_file_name. `name` is the File name (the entry name, the operand's
// last component, or the target's last component).
fn addEntryNameBits(mut bits: &[]Bit, p: &Palette, kind: byte, mode: int,
                    name: string, quoteSpaces: bool) {
    if int(kind) == int(fs::KIND_REG) {
        if mode & 0x040 != 0 {
            addPalEscaped(bits, p, SC_EXE, SC_CONTROL, name, quoteSpaces)
            return
        }
        let idx = patternIndex(name, p)
        if idx >= 0 {
            var g = copyStyle(&p.patterns[idx].style)
            var b = copyStyle(&p.styles[SC_CONTROL])
            addEscapedBits(bits, g, b, name, quoteSpaces)
            return
        }
        let cat = fileCategory(name, p)
        addPalEscaped(bits, p, cat, SC_CONTROL, name, quoteSpaces)
        return
    }
    let code = kindSlot(kind, mode)
    addPalEscaped(bits, p, code, SC_CONTROL, name, quoteSpaces)
}

// The name (and operand parent prefix) of the current entry. Names are the
// lossy form (eza's File.name), and so is an operand's parent and last
// component; the raw bytes are only for lookup.
fn addNameBits(mut bits: &[]Bit, p: &Palette, e: &Entry, v: &View,
               o: &Opts) {
    let quoteSpaces = !o.noQuotes
    if v.single {
        addParentBits(bits, p, strings::lossy(paths::parentOf(v.operand)),
                      quoteSpaces)
        addEntryNameBits(bits, p, e.kind, e.mode,
                         strings::lossy(paths::lastComponent(v.operand)),
                         quoteSpaces)
    } else {
        addEntryNameBits(bits, p, e.kind, e.mode, strings::lossy(e.name),
                         quoteSpaces)
    }
}

// The arrow/target/marker bits of the lines, long and tree views. A valid
// target is painted by the followed target's kind/extension; a broken target
// is the whole raw path in broken_symlink + underline. Target names always use
// QuoteSpaces, and the target parent prefix uses the outer quote style.
fn addTargetAndMarkerBits(mut bits: &[]Bit, e: &Entry, o: &Opts,
                          p: &Palette) {
    let outer = !o.noQuotes
    if int(e.kind) == int(fs::KIND_LNK) {
        if e.linkOk {
            addPlainBit(bits, " ")
            if e.targetValid {
                addPalBit(bits, p, SC_PUNCT, "->")
            } else {
                addPalBit(bits, p, SC_BROKEN, "->")
            }
            addPlainBit(bits, " ")
            if e.targetValid {
                addParentBits(bits, p,
                              strings::lossy(paths::parentOf(e.targetRaw)),
                              outer)
                let tname = strings::lossy(paths::lastComponent(e.targetRaw))
                if len(tname) > 0 {
                    addEntryNameBits(bits, p, e.targetKind, e.targetMode,
                                     tname, true)
                    if o.classifyOn {
                        let m = markerFor(e.targetKind, e.targetMode)
                        if len(m) > 0 { addPlainBit(bits, m) }
                    }
                }
            } else {
                addPalEscaped(bits, p, SC_BROKEN_FILE, SC_BROKEN_CONTROL,
                              strings::lossy(e.targetRaw), outer)
            }
        }
    } else if o.classifyOn {
        let m = markerFor(e.kind, e.mode)
        if len(m) > 0 { addPlainBit(bits, m) }
    }
}

// ------------------------------------------------ colour: prefix and diffing

fn appendReset(mut out: &[]byte) {
    append(out, byte(27))
    append(out, '[')
    append(out, '0')
    append(out, 'm')
}

fn appendStylePrefix(mut out: &[]byte, s: &Style) {
    if stylePlain(s) { return }
    append(out, byte(27))
    append(out, '[')
    var sep = false
    if s.bold { if sep { append(out, ';') }; append(out, '1'); sep = true }
    if s.dim { if sep { append(out, ';') }; append(out, '2'); sep = true }
    if s.italic { if sep { append(out, ';') }; append(out, '3'); sep = true }
    if s.underline { if sep { append(out, ';') }; append(out, '4'); sep = true }
    if s.blink { if sep { append(out, ';') }; append(out, '5'); sep = true }
    if s.reverse { if sep { append(out, ';') }; append(out, '7'); sep = true }
    if s.hidden { if sep { append(out, ';') }; append(out, '8'); sep = true }
    if s.strike { if sep { append(out, ';') }; append(out, '9'); sep = true }
    // nu-ansi-term writes the background before the foreground.
    if s.bg != 0 {
        if sep { append(out, ';') }
        if s.bg == 1 {
            appendStr(out, string(s.bgA))
        } else if s.bg == 2 {
            appendStr(out, "48;5;")
            appendStr(out, string(s.bgA))
        } else {
            appendStr(out, "48;2;")
            appendStr(out, string(s.bgA))
            append(out, ';')
            appendStr(out, string(s.bgB))
            append(out, ';')
            appendStr(out, string(s.bgC))
        }
        sep = true
    }
    if s.fg != 0 {
        if sep { append(out, ';') }
        if s.fg == 1 {
            appendStr(out, string(s.fgA))
        } else if s.fg == 2 {
            appendStr(out, "38;5;")
            appendStr(out, string(s.fgA))
        } else {
            appendStr(out, "38;2;")
            appendStr(out, string(s.fgA))
            append(out, ';')
            appendStr(out, string(s.fgB))
            append(out, ';')
            appendStr(out, string(s.fgC))
        }
    }
    append(out, 'm')
}

fn bitStyle(b: &Bit): Style {
    return new Style{fg: b.fg, fgA: b.fgA, fgB: b.fgB, fgC: b.fgC,
                     bg: b.bg, bgA: b.bgA, bgB: b.bgB, bgC: b.bgC,
                     bold: b.bold, dim: b.dim, italic: b.italic,
                     underline: b.underline, blink: b.blink,
                     reverse: b.reverse, hidden: b.hidden, strike: b.strike}
}

fn bitPlain(b: &Bit): bool {
    if b.fg != 0 || b.bg != 0 { return false }
    if b.bold || b.dim || b.italic || b.underline { return false }
    if b.blink || b.reverse || b.hidden || b.strike { return false }
    return true
}

fn bitsEqual(a: &Bit, b: &Bit): bool {
    if a.fg != b.fg || a.fgA != b.fgA || a.fgB != b.fgB || a.fgC != b.fgC {
        return false
    }
    if a.bg != b.bg || a.bgA != b.bgA || a.bgB != b.bgB || a.bgC != b.bgC {
        return false
    }
    if a.bold != b.bold || a.dim != b.dim || a.italic != b.italic { return false }
    if a.underline != b.underline || a.blink != b.blink { return false }
    if a.reverse != b.reverse || a.hidden != b.hidden || a.strike != b.strike {
        return false
    }
    return true
}

// Difference::Reset: the next style cannot be reached from the previous one
// without clearing it (an attribute or colour is being removed).
fn bitsReset(a: &Bit, b: &Bit): bool {
    if a.bold && !b.bold { return true }
    if a.dim && !b.dim { return true }
    if a.italic && !b.italic { return true }
    if a.underline && !b.underline { return true }
    if a.blink && !b.blink { return true }
    if a.reverse && !b.reverse { return true }
    if a.hidden && !b.hidden { return true }
    if a.strike && !b.strike { return true }
    if a.fg != 0 && b.fg == 0 { return true }
    if a.bg != 0 && b.bg == 0 { return true }
    return false
}

// Difference::ExtraStyles: the attributes/colours the next style adds.
fn bitsExtra(a: &Bit, b: &Bit): Style {
    var s = newStyle()
    s.bold = b.bold != a.bold
    s.dim = b.dim != a.dim
    s.italic = b.italic != a.italic
    s.underline = b.underline != a.underline
    s.blink = b.blink != a.blink
    s.reverse = b.reverse != a.reverse
    s.hidden = b.hidden != a.hidden
    s.strike = b.strike != a.strike
    if a.fg != b.fg || a.fgA != b.fgA || a.fgB != b.fgB || a.fgC != b.fgC {
        s.fg = b.fg
        s.fgA = b.fgA
        s.fgB = b.fgB
        s.fgC = b.fgC
    }
    if a.bg != b.bg || a.bgA != b.bgA || a.bgB != b.bgB || a.bgC != b.bgC {
        s.bg = b.bg
        s.bgA = b.bgA
        s.bgB = b.bgB
        s.bgC = b.bgC
    }
    return s
}

// nu-ansi-term 0.50.1 AnsiStrings::write_to_any: the first prefix, then the
// minimal difference before each next bit, then one final reset when the last
// bit is styled.
fn emitBitsInto(bits: &[]Bit, mut out: &[]byte) {
    if len(bits) == 0 { return }
    let s0 = bitStyle(bits[0])
    appendStylePrefix(out, s0)
    appendStr(out, bits[0].text)
    var i = 1
    while i < len(bits) {
        if !bitsEqual(bits[i - 1], bits[i]) {
            if bitsReset(bits[i - 1], bits[i]) {
                appendReset(out)
                let sn = bitStyle(bits[i])
                appendStylePrefix(out, sn)
            } else {
                let ex = bitsExtra(bits[i - 1], bits[i])
                appendStylePrefix(out, ex)
            }
        }
        appendStr(out, bits[i].text)
        i += 1
    }
    if !bitPlain(bits[len(bits) - 1]) { appendReset(out) }
}

// The coloured form of renderLine: the long cells are one plain bit (long
// column colour is deliberately deferred; see cmd/README), then the styled
// name and link target. Layout is built first, so ANSI bytes never count in a
// width.
fn renderLineColour(e: &Entry, v: &View, o: &Opts, cols: &Cols, p: &Palette,
                    mut out: &[]byte) {
    var bits = new []Bit(0)
    if o.longView {
        var lp = new []byte(0)
        appendLongCells(e, o, cols, lp)
        addPlainBit(bits, strings::fromBytes(lp))
    }
    addNameBits(bits, p, e, v, o)
    addTargetAndMarkerBits(bits, e, o, p)
    emitBitsInto(bits, out)
}

fn renderLineAny(e: &Entry, v: &View, o: &Opts, cols: &Cols, p: &Palette,
                 mut out: &[]byte) {
    if o.colourOn {
        renderLineColour(e, v, o, cols, p, out)
    } else {
        renderLine(e, v, o, cols, out)
    }
}

// Write one rendered line per order id through a buffered Writer. A write or
// flush failure is returned with its errno; the caller prints eza's bare os
// error and exits 1.
// Write one line (bytes plus newline) through a buffered Writer.
fn writeLine(mut w: &io::Writer, line: &[]byte): Result[bool] {
    let r = io::writeBytes(w, line)
    match r {
        ok { }
        err { return err(r.message, r.code) }
    }
    let n = io::writeByte(w, byte(10))
    match n {
        ok { }
        err { return err(n.message, n.code) }
    }
    return ok(true)
}

fn flushWriter(mut w: &io::Writer): Result[bool] {
    let f = io::flush(w)
    match f {
        ok { }
        err { return err(f.message, f.code) }
    }
    return ok(true)
}

// ---------------------------------------------------------------- help text
//
// This is this build's own text, not a copy of the pinned reference's --help:
// the reference advertises options (plain -l with human-readable sizes, -b,
// -h, multiple operands, recurse, git, ...) that this partial implementation
// rejects. Keep the working restricted long form and the human-size /
// header limitation explicit.

fn helpText(): string {
    var lines = new []string(0)
    append(lines, "Usage:")
    append(lines, "  eza [options] [--] [PATH]")
    append(lines, "  eza -l --bytes --time-style=long-iso (-n | --no-user) [options] [--] [PATH]")
    append(lines, "")
    append(lines, "obo eza is a partial, source-compatible subset of eza 0.23.3, not a full")
    append(lines, "port. It lists one PATH (default \".\") and implements only the options")
    append(lines, "below. Options outside this subset are rejected, never silently accepted.")
    append(lines, "")
    append(lines, "META OPTIONS")
    append(lines, "  -?, --help                 show this help and exit")
    append(lines, "")
    append(lines, "DISPLAY OPTIONS")
    append(lines, "  -1, --oneline              display one entry per line")
    append(lines, "  -l, --long                 restricted long view (see LONG VIEW)")
    append(lines, "  -G, --grid                 display entries as a grid")
    append(lines, "  -x, --across               fill grid rows left to right")
    append(lines, "  -T, --tree                 recurse into directories as a tree")
    append(lines, "  -L, --level DEPTH          limit tree depth (used only with -T)")
    append(lines, "  -w, --width COLS           set screen width in columns (0 = automatic)")
    append(lines, "  -F, --classify[=WHEN]      type markers: always, auto, never")
    append(lines, "  --color, --colour[=WHEN]   colour: always, auto, never")
    append(lines, "  --icons[=WHEN]             accepted except always; no icons are drawn")
    append(lines, "  --no-quotes                do not quote file names containing spaces")
    append(lines, "")
    append(lines, "FILTERING AND SORTING OPTIONS")
    append(lines, "  -a, --all                  show dot files; twice also adds \".\" and \"..\"")
    append(lines, "  -A, --almost-all           show dot files without \".\" and \"..\"")
    append(lines, "  -d, --treat-dirs-as-files, --list-dirs")
    append(lines, "                             list a directory operand as one entry")
    append(lines, "  -D, --only-dirs            list directories only")
    append(lines, "  -f, --only-files           list regular files only")
    append(lines, "  -r, --reverse              reverse the sort order")
    append(lines, "  -s, --sort FIELD           name (default), Name, size, extension,")
    append(lines, "                             Extension, modified, type (and eza aliases)")
    append(lines, "  --group-directories-first  list directories before other entries")
    append(lines, "  --group-directories-last   list directories after other entries")
    append(lines, "")
    append(lines, "LONG VIEW OPTIONS")
    append(lines, "  The working long form in this build is:")
    append(lines, "    eza -l --bytes --time-style=long-iso -n PATH")
    append(lines, "    eza -l --bytes --time-style=long-iso --no-user PATH")
    append(lines, "  It prints permissions, a raw decimal byte size, user or numeric uid,")
    append(lines, "  a long-iso date, and the name. Plain \"eza -l\" is not supported.")
    append(lines, "  Human-readable sizes are NOT implemented: eza's default 1.0k/1.0M")
    append(lines, "  format and -b/--binary are unsupported. -h/--header is also")
    append(lines, "  unsupported. Those options are rejected, not silently accepted.")
    append(lines, "  -B, --bytes                show raw byte sizes (required with -l)")
    append(lines, "  -n, --numeric              show numeric user ids")
    append(lines, "  --no-user                  omit the user column")
    append(lines, "  --no-permissions           omit the permissions column")
    append(lines, "  --no-filesize              omit the size column")
    append(lines, "  --no-time                  omit the date column")
    append(lines, "  --time-style STYLE         long-iso with -l; default/long-iso otherwise")
    append(lines, "")
    append(lines, "EXAMPLES")
    append(lines, "  eza                        list the current directory")
    append(lines, "  eza -1 PATH                one entry per line")
    append(lines, "  eza -a PATH                include dot files")
    append(lines, "  eza -T -L 2 PATH           tree view to depth 2")
    append(lines, "  eza --sort=modified -r PATH")
    append(lines, "                             newest modification time first")
    append(lines, "  eza -l --bytes --time-style=long-iso --no-user PATH")
    append(lines, "                             the supported long view")
    append(lines, "")
    append(lines, "NOTES")
    append(lines, "  * At most one operand is supported; more is a usage error.")
    append(lines, "  * Zero operands mean \".\"; eza's stdin file-name mode is not supported.")
    append(lines, "  * -R, --follow-symlinks, --dereference, --absolute, -I, git options,")
    append(lines, "    --hyperlink, --stdin, -i, -H, -g, -b, -h, -t, -u, -U, --total-size,")
    append(lines, "    --octal-permissions and --context are among the rejected options.")
    append(lines, "  * --help wins over operands and supported options once argv parses;")
    append(lines, "    unknown options and missing values are still errors.")
    append(lines, "  * Exit status: 0 success, 1 write error, 2 path error, 3 usage error.")
    return strings::join(lines, "\n") + "\n"
}

fn hasHelp(options: &[]cli::Option): bool {
    for i in 0..len(options) {
        if options[i].long == "help" { return true }
    }
    return false
}

// Print the subset help on stdout. No operand lookup or directory read happens
// first; a write or flush error is returned for main's exit-1 write-error path.
fn printHelp(): Result[bool] {
    let text = helpText()
    var w = io::newWriter(stdout(), 65536)
    let r = io::write(w, text)
    match r {
        ok { }
        err { return err(r.message, r.code) }
    }
    let f = io::flush(w)
    match f {
        ok { }
        err { return err(f.message, f.code) }
    }
    return ok(true)
}

fn emitEntries(es: &[]Entry, order: &[]int, v: &View, o: &Opts, cols: &Cols,
               p: &Palette): Result[bool] {
    var w = io::newWriter(stdout(), 65536)
    var out = new []byte(0)
    var i = 0
    while i < len(order) {
        let id = order[i]
        truncate(out, 0)
        renderLineAny(es[id], v, o, cols, p, out)
        let r = writeLine(w, out)
        match r {
            ok { }
            err { return err(r.message, r.code) }
        }
        i += 1
    }
    let f = flushWriter(w)
    match f {
        ok { }
        err { return err(f.message, f.code) }
    }
    return ok(true)
}

fn appendSpaces(mut out: &[]byte, n: int) {
    var i = 0
    while i < n {
        append(out, ' ')
        i += 1
    }
}

// ---------------------------------------------------------------- grid view
//
// eza's grid is uutils_term_grid 0.7.0's Grid with Filling::Spaces(2),
// direction TopToBottom by default and LeftToRight under -x. The rules were
// read from that crate and re-checked against the pinned reference:
//   * one cell: one row and one column;
//   * when the widest cell + 2 exceeds the console width, one column (cells
//     are never truncated or wrapped; an over-wide name prints in full);
//   * otherwise start from the lower bound of columns that would fit if every
//     column were the widest cell, then keep increasing the column count while
//     the recomputed column widths plus two spaces between columns still fit.
//     The LAST fitting count wins (a larger count can fit when ragged rows
//     shrink a column).
// Column widths are per-column maxima; the last column of a row is not padded
// and a row that ends before the grid has no trailing spaces. Cell width is
// strings::displayWidth of the plain quoted name plus the marker, so ANSI
// bytes and UTF-8 continuation bytes never count.

type GridDim = ref record {
    rows: int
    cols: int
    widths: []int
}

fn minInt(a: int, b: int): int {
    if a < b { return a }
    return b
}

fn ceilDiv(a: int, b: int): int {
    var d = a / b
    if a % b != 0 { d += 1 }
    return d
}

// The classify marker on the link itself: grid never shows a target, so a
// symlink is "@" (even when broken) and other kinds use the lines rule.
fn cellMarker(e: &Entry, o: &Opts): string {
    if !o.classifyOn { return "" }
    if int(e.kind) == int(fs::KIND_LNK) { return "@" }
    return markerFor(e.kind, e.mode)
}

// The display width of one cell: the name (with the operand parent prefix for
// a single operand) plus the marker.
fn gridCellWidth(e: &Entry, v: &View, o: &Opts): int {
    let q = !o.noQuotes
    var w = 0
    if v.single {
        let parent = paths::parentOf(v.operand)
        if len(parent) > 0 {
            w += strings::quotedWidth(strings::lossy(parent), q)
            if parent != "/" { w += 1 }
        }
        w += strings::quotedWidth(
            strings::lossy(paths::lastComponent(v.operand)), q)
    } else {
        w += strings::quotedWidth(strings::lossy(e.name), q)
    }
    let m = cellMarker(e, o)
    if len(m) > 0 { w += 1 }
    return w
}

// Column widths for a fixed row/column count: TopToBottom assigns cell i to
// column i/rows, LeftToRight to column i%cols.
fn gridColWidths(widths: &[]int, rows: int, cols: int,
                 across: bool): []int {
    var cw = new []int(cols)
    var idx = 0
    while idx < len(widths) {
        var ci = idx / rows
        if across { ci = idx % cols }
        if widths[idx] > cw[ci] { cw[ci] = widths[idx] }
        idx += 1
    }
    return cw
}

fn gridSum(xs: &[]int): int {
    var s = 0
    for i in 0..len(xs) { s += xs[i] }
    return s
}

// The chosen dimensions for one grid.
fn gridDims(widths: &[]int, width: int, across: bool): GridDim {
    let n = len(widths)
    var empty = new []int(0)
    if n == 0 { return new GridDim{rows: 0, cols: 0, widths: empty} }
    var widest = 0
    for i in 0..n {
        if widths[i] > widest { widest = widths[i] }
    }
    if n == 1 {
        var one = new []int(1)
        one[0] = widest
        return new GridDim{rows: 1, cols: 1, widths: one}
    }
    let widestColumn = widest + 2
    if widestColumn > width {
        var col = new []int(1)
        col[0] = widest
        return new GridDim{rows: n, cols: 1, widths: col}
    }
    let minColumns = minInt(n, (width + 2) / widestColumn)
    let maxRows = ceilDiv(n, minColumns)
    var potRows = maxRows
    var potCols = minColumns
    var potCw = gridColWidths(widths, maxRows, minColumns, across)
    if maxRows != 1 {
        var nc = minColumns + 1
        while nc < n {
            let sep = (nc - 1) * 2
            if sep > width { break }
            let adjusted = width - sep
            let rows = ceilDiv(n, nc)
            let cw = gridColWidths(widths, rows, nc, across)
            if gridSum(&cw) <= adjusted {
                potRows = rows
                potCols = nc
                potCw = copyOrder(&cw)
            }
            nc += 1
        }
    }
    return new GridDim{rows: potRows, cols: potCols, widths: potCw}
}

// The grid name bits: a broken link's name takes the broken style because
// there is no target to colour (FileName::style with JustFilenames), a valid
// link keeps the symlink style. The marker is a plain bit.
fn addGridEntryNameBits(mut bits: &[]Bit, p: &Palette, e: &Entry, name: string,
                        quoteSpaces: bool) {
    if int(e.kind) == int(fs::KIND_LNK) && e.linkOk && !e.targetValid {
        addPalEscaped(bits, p, SC_BROKEN, SC_CONTROL, name, quoteSpaces)
        return
    }
    addEntryNameBits(bits, p, e.kind, e.mode, name, quoteSpaces)
}

fn addGridNameBits(mut bits: &[]Bit, p: &Palette, e: &Entry, v: &View,
                   o: &Opts) {
    let q = !o.noQuotes
    if v.single {
        addParentBits(bits, p, strings::lossy(paths::parentOf(v.operand)), q)
        addGridEntryNameBits(bits, p, e,
                             strings::lossy(paths::lastComponent(v.operand)),
                             q)
    } else {
        addGridEntryNameBits(bits, p, e, strings::lossy(e.name), q)
    }
}

fn renderGridCell(e: &Entry, v: &View, o: &Opts, p: &Palette,
                  mut out: &[]byte) {
    let m = cellMarker(e, o)
    if o.colourOn {
        var bits = new []Bit(0)
        addGridNameBits(bits, p, e, v, o)
        if len(m) > 0 { addPlainBit(bits, m) }
        emitBitsInto(bits, out)
    } else {
        appendStr(out, displayName(v, e, !o.noQuotes))
        appendStr(out, m)
    }
}

// Render the grid rows through a buffered Writer. The console width is the
// deduced Set/terminal width; an explicit -G with no width at all falls back
// to 80, as eza's grid renderer does with console_width None.
fn emitGrid(es: &[]Entry, order: &[]int, v: &View, o: &Opts,
            p: &Palette): Result[bool] {
    let n = len(order)
    if n == 0 { return ok(true) }
    var widths = new []int(n)
    var i = 0
    while i < n {
        widths[i] = gridCellWidth(es[order[i]], v, o)
        i += 1
    }
    var width = 80
    if o.widthKnown { width = o.width }
    let dim = gridDims(widths, width, o.across)
    // The cell after this one on the same row: +1 across, +rows down.
    var off = dim.rows
    if o.across { off = 1 }
    var w = io::newWriter(stdout(), 65536)
    var out = new []byte(0)
    var y = 0
    while y < dim.rows {
        truncate(out, 0)
        var x = 0
        while x < dim.cols {
            var cur = y + dim.rows * x
            if o.across { cur = y * dim.cols + x }
            if cur >= n { break }
            renderGridCell(es[order[cur]], v, o, p, out)
            if x == dim.cols - 1 || cur + off >= n { break }
            appendSpaces(out, dim.widths[x] - widths[cur])
            appendStr(out, "  ")
            x += 1
        }
        let rr = writeLine(w, out)
        match rr {
            ok { }
            err { return err(rr.message, rr.code) }
        }
        y += 1
    }
    return flushWriter(w)
}

// One entry set through whichever output view is effective. Grid computes no
// long column widths (the combination is rejected in deduce).
fn emitAny(es: &[]Entry, order: &[]int, v: &View, o: &Opts,
           p: &Palette): Result[bool] {
    if o.gridView { return emitGrid(es, order, v, o, p) }
    let cols = computeCols(es, o)
    return emitEntries(es, order, v, o, cols, p)
}

// ------------------------------------------------------------- entry setup

// Fill the lazy metadata the current options need. Symlink targets are always
// resolved for display (the default/-1/-d and long views show them).
fn prepareEntries(mut es: &[]Entry, v: &View, o: &Opts) {
    let wantStat = needStat(o)
    var i = 0
    while i < len(es) {
        let path = entryPath(v, es[i])
        if wantStat {
            fillStat(es[i], path)
        }
        if int(es[i].kind) == int(fs::KIND_LNK) {
            fillTarget(es[i], path, targetBase(v))
        }
        i += 1
    }
}

// ---------------------------------------------------------------- tree view
//
// The reference's tree is the details view with a tree prefix; it walks each
// directory depth-first and applies the hidden/-A, -D/-f, sort and long rules
// at every level. This build uses an explicit frame stack rather than
// recursion: a directory is read, filtered, sorted and closed before its first
// child is printed, so no descriptor stays open across levels and memory is
// bounded by one directory's entries per open level. Empty directories print
// their line only; an unreadable directory prints a styled
// "<Permission denied (os error 13)>" child and continues. Symlink entries are
// never descended (--follow-symlinks is out of scope), and -L bounds descent
// with eza's rule: descend only while max > depth (max 0 prints the root
// alone).

fn treeKeep(kind: byte, o: &Opts): bool {
    if o.onlyDirs && !o.onlyFiles {
        return int(kind) == int(fs::KIND_DIR)
    }
    // The reference's filter_child_files in recursion keeps everything for
    // --only-files (and for the both-flags fall-through); only -D alone
    // restricts a tree level.
    return true
}

fn readTreeEntries(mut d: &fs::Dir, mut es: &[]Entry, o: &Opts): Result[bool] {
    var e = new fs::DirEntry{name: "", ino: 0, kind: 0}
    var more = true
    while more {
        more = try fs::next(d, e)
        if more {
            var keep = true
            if hiddenName(e.name) && !hiddenEnabled(o) { keep = false }
            if keep && !treeKeep(e.kind, o) { keep = false }
            if keep {
                append(es, newEntry(e.name, e.kind, byte(0)))
            }
        }
    }
    return ok(true)
}

fn treeTooDeep(depth: int, o: &Opts): bool {
    return o.levelSeen && o.level <= depth
}

fn lastFlag(last: bool): string {
    if last { return "1" }
    return "0"
}

// One tree part: "│   " for a non-last ancestor, "    " for a last one, then
// "├── " or "└── " for this row. The glyph bytes are built from byte values so
// the source stays ASCII.
fn appendTreePart(mut out: &[]byte, bar: bool) {
    if bar {
        append(out, byte(226))
        append(out, byte(148))
        append(out, byte(130))
        append(out, ' ')
        append(out, ' ')
        append(out, ' ')
    } else {
        append(out, ' ')
        append(out, ' ')
        append(out, ' ')
        append(out, ' ')
    }
}

fn appendTreePrefix(mut out: &[]byte, anc: string, last: bool) {
    var i = 0
    while i < len(anc) {
        appendTreePart(out, anc[i] != '1')
        i += 1
    }
    if last {
        append(out, byte(226))
        append(out, byte(148))
        append(out, byte(148))
    } else {
        append(out, byte(226))
        append(out, byte(148))
        append(out, byte(156))
    }
    append(out, byte(226))
    append(out, byte(148))
    append(out, byte(128))
    append(out, byte(226))
    append(out, byte(148))
    append(out, byte(128))
    append(out, ' ')
}

fn treePrefixText(anc: string, last: bool): string {
    var b = new []byte(0)
    appendTreePrefix(b, anc, last)
    return strings::fromBytes(b)
}

// Read, filter, prepare and sort one directory. The whole list is owned by the
// returned frame; the descriptor is closed before returning.
fn loadFrame(path: string, depth: int, anc: string,
             o: &Opts): Result[Frame] {
    let op = fs::open(path)
    match op {
        ok(d) {
            var es = new []Entry(0)
            let v = new View{single: false, operand: path, base: path}
            let rr = readTreeEntries(d, es, o)
            let cr = fs::close(d)
            match rr {
                ok(v0) {
                    prepareEntries(es, v, o)
                    let order = sortEntriesTree(es, v, o)
                    return ok(new Frame{path: path, entries: es,
                                        order: order, next: 0,
                                        depth: depth, anc: anc})
                }
                err(m, c) {
                    return err(m, c)
                }
            }
        }
        err(m, c) {
            return err(m, c)
        }
    }
}

// Add one entry's cells to the global long-column widths.
fn noteCols(e: &Entry, o: &Opts, mut cols: &Cols) {
    if !o.noFilesize {
        let c = sizeCell(e)
        var w = 1
        if c >= 0 { w = fmt::digits(c) }
        if w > cols.sizeWidth { cols.sizeWidth = w }
    }
    if o.numeric && !o.noUser {
        let w = fmt::digits(e.uid)
        if w > cols.userWidth { cols.userWidth = w }
    }
    if !o.noTime {
        var w = 1
        if e.statOk && e.mtime >= 0 { w = 16 }
        if w > cols.dateWidth { cols.dateWidth = w }
    }
}

// The measuring pass for -T -l: the reference's table spans the whole tree,
// so widths must be known before the first line is printed.
fn treeMeasure(rootE: &Entry, rootV: &View, o: &Opts, mut cols: &Cols) {
    noteCols(rootE, o, cols)
    if int(rootE.kind) != int(fs::KIND_DIR) { return }
    if treeTooDeep(0, o) { return }
    var stack = new []Frame(0)
    let fr = loadFrame(rootV.operand, 1, "", o)
    match fr {
        ok(f0) { append(stack, f0) }
        err(m, c) { return }
    }
    while len(stack) > 0 {
        let n = len(stack) - 1
        if stack[n].next >= len(stack[n].order) {
            truncate(stack, n)
        } else {
            let eid = stack[n].order[stack[n].next]
            let nxt = stack[n].next + 1
            stack[n].next = nxt
            let depth = stack[n].depth
            let anc = stack[n].anc
            let path = stack[n].path
            let last = nxt == len(stack[n].order)
            noteCols(stack[n].entries[eid], o, cols)
            let kind = stack[n].entries[eid].kind
            if int(kind) == int(fs::KIND_DIR) && !treeTooDeep(depth, o) {
                let cpath = paths::join(path, stack[n].entries[eid].name)
                let canc = anc + lastFlag(last)
                let cf = loadFrame(cpath, depth + 1, canc, o)
                match cf {
                    ok(child) { append(stack, child) }
                    err(m, c) { }
                }
            }
        }
    }
}

// The tree list rows are rendered after the global widths are known; the error
// row has no cells and is padded to the table's total width in long mode.
fn renderTreeError(anc: string, code: int, o: &Opts, cols: &Cols,
                   p: &Palette, mut line: &[]byte) {
    let msg = "<" + errors::osError(code) + ">"
    if o.colourOn {
        var bits = new []Bit(0)
        if o.longView {
            var pad = new []byte(0)
            appendSpaces(pad, longPrefixWidth(o, cols))
            addPlainBit(bits, strings::fromBytes(pad))
        }
        addPalBit(bits, p, SC_PUNCT, treePrefixText(anc, true))
        addPalBit(bits, p, SC_BROKEN, msg)
        emitBitsInto(bits, line)
    } else {
        if o.longView { appendSpaces(line, longPrefixWidth(o, cols)) }
        appendTreePrefix(line, anc, true)
        appendStr(line, msg)
    }
}

// One normal tree row. `root` suppresses the tree prefix for the operand line.
fn renderTreeRow(e: &Entry, v: &View, anc: string, last: bool, o: &Opts,
                 cols: &Cols, p: &Palette, mut line: &[]byte,
                 root: bool) {
    if o.colourOn {
        var bits = new []Bit(0)
        if o.longView {
            var lp = new []byte(0)
            appendLongCells(e, o, cols, lp)
            addPlainBit(bits, strings::fromBytes(lp))
        }
        if !root {
            addPalBit(bits, p, SC_PUNCT, treePrefixText(anc, last))
        }
        addNameBits(bits, p, e, v, o)
        addTargetAndMarkerBits(bits, e, o, p)
        emitBitsInto(bits, line)
    } else {
        if o.longView { appendLongCells(e, o, cols, line) }
        if !root { appendTreePrefix(line, anc, last) }
        appendStr(line, displayName(v, e, !o.noQuotes))
        appendTargetAndMarker(e, o, line)
    }
}

fn treeLoop(mut stack: &[]Frame, o: &Opts, cols: &Cols, p: &Palette,
            mut w: &io::Writer): Result[bool] {
    var out = new []byte(0)
    while len(stack) > 0 {
        let n = len(stack) - 1
        if stack[n].next >= len(stack[n].order) {
            truncate(stack, n)
        } else {
            let eid = stack[n].order[stack[n].next]
            let nxt = stack[n].next + 1
            stack[n].next = nxt
            let depth = stack[n].depth
            let anc = stack[n].anc
            let path = stack[n].path
            let last = nxt == len(stack[n].order)
            let kind = stack[n].entries[eid].kind
            let name = stack[n].entries[eid].name
            let cv = new View{single: false, operand: path, base: path}
            truncate(out, 0)
            renderTreeRow(stack[n].entries[eid], cv, anc, last, o,
                          cols, p, out, false)
            let rr = writeLine(w, out)
            match rr {
                ok(v0) { }
                err(m, c) { return err(m, c) }
            }
            if int(kind) == int(fs::KIND_DIR) && !treeTooDeep(depth, o) {
                let cpath = paths::join(path, name)
                let canc = anc + lastFlag(last)
                let cf = loadFrame(cpath, depth + 1, canc, o)
                match cf {
                    ok(child) { append(stack, child) }
                    err(m, c) {
                        truncate(out, 0)
                        renderTreeError(canc, c, o, cols, p, out)
                        let er = writeLine(w, out)
                        match er {
                            ok(r0) { }
                            err(m2, c2) { return err(m2, c2) }
                        }
                    }
                }
            }
        }
    }
    return ok(true)
}

// The tree entry point: root line, children, depth-first frames, flush. The
// reference filters a directory root out of the files list when --only-files
// is active (tree treats directories as files and print_files drops lstat
// directories), so that combination prints nothing at all.
fn runTree(operand: string, mode: int, o: &Opts,
           p: &Palette): Result[bool] {
    if o.onlyFiles && fs::isDir(mode) { return ok(true) }
    var rootEs = new []Entry(0)
    append(rootEs, newEntry(operand, fs::typeOf(mode), byte(0)))
    let vroot = new View{single: true, operand: operand,
                         base: paths::parentOf(operand)}
    prepareEntries(rootEs, vroot, o)
    var cols = new Cols{sizeWidth: 0, userWidth: 0, dateWidth: 0}
    if o.longView { treeMeasure(rootEs[0], vroot, o, cols) }
    var w = io::newWriter(stdout(), 65536)
    var out = new []byte(0)
    renderTreeRow(rootEs[0], vroot, "", true, o, cols, p, out, true)
    let rr = writeLine(w, out)
    match rr {
        ok(v0) { }
        err(m, c) { return err(m, c) }
    }
    if int(rootEs[0].kind) == int(fs::KIND_DIR) && !treeTooDeep(0, o) {
        let fr = loadFrame(operand, 1, "", o)
        match fr {
            ok(f0) {
                var stack = new []Frame(0)
                append(stack, f0)
                let lr = treeLoop(stack, o, cols, p, w)
                match lr {
                    ok(v0) { }
                    err(m, c) { return err(m, c) }
                }
            }
            err(m, c) {
                truncate(out, 0)
                renderTreeError("", c, o, cols, p, out)
                let er = writeLine(w, out)
                match er {
                    ok(v0) { }
                    err(m2, c2) { return err(m2, c2) }
                }
            }
        }
    }
    return flushWriter(w)
}

// eza's permission-denied diagnostic for a directory it cannot open, followed
// by the summary block. The status stays 0 (P0 records 0.23.3's exit).
fn warnPermissionDenied(operand: string) {
    eprintln("Permission denied: ", operand, " - code: 13")
    eprintln("")
    eprintln("Skipped 1 directories due to permission denied: ")
    eprintln("  ", operand)
}

// ------------------------------------------------------------------- main

fn main() {
    let av = args()
    var sp = specs()
    let parsed = cli::parse(av, 1, sp)
    match parsed {
        ok {
            // Help is actioned after the whole argv has parsed (so a later
            // unknown name or missing value still wins, as the reference does)
            // but before deduction, operand lookup or any directory scan.
            if hasHelp(parsed.value.options) {
                let hr = printHelp()
                match hr {
                    ok { return }
                    err {
                        eprintln(errors::osError(hr.code))
                        exit(errors::EXIT_FAIL)
                    }
                }
            }
            let od = deduce(parsed.value.options)
            match od {
                ok {
                    var pal = newPalette()
                    if od.value.colourOn { parseColourEnv(pal) }
                    let nops = len(parsed.value.operands)
                    if nops > 1 {
                        eprintln("eza: this build supports at most one operand")
                        exit(errors::EXIT_USAGE)
                    }
                    var operand = "."
                    if nops == 1 { operand = parsed.value.operands[0] }
                    // The operand existence check is lstat, as in eza: a
                    // dangling symlink operand exists and is listed.
                    var mode = 0
                    let lm = fs::lstat(operand)
                    match lm {
                        ok { mode = lm.value.mode }
                        err {
                            eprintln(errors::debugPath(operand), ": ", errors::osError(lm.code))
                            exit(errors::EXIT_PATH)
                        }
                    }
                    var follows = false
                    if fs::isSymlink(mode) {
                        let st = fs::stat(operand)
                        match st {
                            ok { follows = fs::isDir(st.value.mode) }
                            err { follows = false }
                        }
                    }
                    if od.value.treeView {
                        // Tree treats directory operands as files and then
                        // walks them (DirAction::Recurse{tree:true}).
                        let tr = runTree(operand, mode, od.value, pal)
                        match tr {
                            ok(v0) { }
                            err(m, c) {
                                eprintln(errors::osError(c))
                                exit(errors::EXIT_FAIL)
                            }
                        }
                        return
                    }
                    let dirsAsFiles = od.value.treatDirs
                    let listing = (fs::isDir(mode) || follows) && !dirsAsFiles
                    if listing {
                        let op = fs::open(operand)
                        match op {
                            ok(d) {
                                var es = new []Entry(0)
                                let v = new View{single: false, operand: operand, base: operand}
                                if dotsEnabled(od.value) {
                                    let dot = dotEntry(".", byte(1), operand)
                                    if keepKind(dot.kind, od.value) {
                                        append(es, dot)
                                    } else {
                                        drop(dot)
                                    }
                                    let dotdot = dotEntry("..", byte(2), paths::join(operand, ".."))
                                    if keepKind(dotdot.kind, od.value) {
                                        append(es, dotdot)
                                    } else {
                                        drop(dotdot)
                                    }
                                }
                                let rr = readDirEntries(d, es, od.value)
                                let cr = fs::close(d)
                                match rr {
                                    ok {
                                        prepareEntries(es, v, od.value)
                                        let order = sortEntries(es, v, od.value)
                                        let er = emitAny(es, order, v, od.value, pal)
                                        match er {
                                            ok { }
                                            err {
                                                eprintln(errors::osError(er.code))
                                                exit(errors::EXIT_FAIL)
                                            }
                                        }
                                    }
                                    err {
                                        eprintln(operand, ": ", errors::osError(rr.code))
                                    }
                                }
                            }
                            err(m, c) {
                                if c == errors::EXIT_PERMISSION {
                                    warnPermissionDenied(operand)
                                } else {
                                    eprintln(operand, ": ", errors::osError(c))
                                }
                            }
                        }
                    } else {
                        var es = new []Entry(0)
                        let v = new View{single: true, operand: operand, base: paths::parentOf(operand)}
                        append(es, newEntry(operand, fs::typeOf(mode), byte(0)))
                        prepareEntries(es, v, od.value)
                        let order = sort::identity(len(es))
                        let er = emitAny(es, order, v, od.value, pal)
                        match er {
                            ok { }
                            err {
                                eprintln(errors::osError(er.code))
                                exit(errors::EXIT_FAIL)
                            }
                        }
                    }
                }
                err {
                    eprintln("eza: ", od.message)
                    exit(errors::EXIT_USAGE)
                }
            }
        }
        err {
            eprintln("eza: ", parsed.message)
            exit(errors::EXIT_USAGE)
        }
    }
}
