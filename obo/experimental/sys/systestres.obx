// Experimental systems library: P0 native-resource fixture.
//
// This is deliberately not a File or Socket. It is the smallest real native
// resource used to prove the managed identity layer: the real backend uses a
// CLOEXEC, nonblocking eventfd; the scripted fake backend uses a C-owned
// counter. Both expose the same scalar adapter symbols. Neither shell contains
// a descriptor or a registry token, only `res: platform::Resource`.
//
// P1a adds File/Directory/clock; this module remains a test fixture.
module systestres

import "sysplatform.obx" as platform

pub type TestResource = ref record { res: platform::Resource }

pub fn open(): Result[TestResource] {
    let r = try platform::_create(platform::KIND_TEST_RESOURCE, 0, 0)
    return ok(new TestResource{res: r})
}

pub fn openAlt(): Result[TestResource] {
    let r = try platform::_create(platform::KIND_TEST_RESOURCE_ALT, 0, 0)
    return ok(new TestResource{res: r})
}

pub fn source(t: &TestResource): Result[^platform::Resource] {
    return platform::_requireKindHandle(handle(t.res), platform::KIND_TEST_RESOURCE)
}

// Cross-kind check used by the adversarial test: a valid test-resource shell
// must not satisfy a different typed kind.
pub fn sourceAsAlt(t: &TestResource): Result[^platform::Resource] {
    return platform::_requireKindHandle(handle(t.res), platform::KIND_TEST_RESOURCE_ALT)
}

// One write attempt. The adapter performs no retry.
pub fn write(t: &TestResource, value: int): Result[bool] {
    let n = try platform::_opHandle(handle(t.res), platform::KIND_TEST_RESOURCE,
                              platform::OP_TEST_WRITE, value, 0, 0)
    let wrote = n == 1
    return ok(wrote)
}

// One read attempt: an empty nonblocking endpoint returns WouldBlock, not 0.
pub fn read(t: &TestResource): Result[int] {
    return platform::_opHandle(handle(t.res), platform::KIND_TEST_RESOURCE,
                         platform::OP_TEST_READ, 0, 0, 0)
}

// Fake-backend progress script hook; the real backend returns Unsupported.
pub fn progress(t: &TestResource): Result[int] {
    return platform::_opHandle(handle(t.res), platform::KIND_TEST_RESOURCE,
                         platform::OP_TEST_PROGRESS, 0, 0, 0)
}

pub fn close(t: &TestResource): Result[bool] {
    return platform::_closeHandle(handle(t.res), platform::KIND_TEST_RESOURCE)
}

pub fn closeAlt(t: &TestResource): Result[bool] {
    return platform::_closeHandle(handle(t.res), platform::KIND_TEST_RESOURCE_ALT)
}

// Read the checked hint only for adversarial tests. This is an int copy, not
// an authority and not a registry token.
pub fn hint(t: &TestResource): int {
    return t.res.reserved
}
