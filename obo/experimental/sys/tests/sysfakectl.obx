// Test-only control surface for the link-time fake backend.
//
// This module is copied only by sysadapter_fake_ctl.cbind and imported only by
// the fault-injection test root. It is not part of the production package and
// no production wrapper references a sysfake_* symbol.
module sysfakectl

pub const CLASS_NEW = 1
pub const CLASS_OP = 2
pub const CLASS_CLOSE = 3
pub const CLASS_VALIDATE = 4
pub const CLASS_FILE_OPEN = 5
pub const CLASS_DIR_OPEN = 6
pub const CLASS_DIR_ITERATE = 7
pub const CLASS_DIR_NEXT = 8
pub const CLASS_READ = 9
pub const CLASS_WRITE = 10
pub const CLASS_SEEK = 11
pub const CLASS_TRUNCATE = 12
pub const CLASS_STAT = 13
pub const CLASS_DUP = 14
pub const CLASS_RETAG = 15
pub const CLASS_CLOCK = 16
pub const CLASS_SLEEP = 17
pub const CLASS_RANDOM = 18
pub const CLASS_STANDARD = 19
pub const CLASS_NET_LISTEN = 20
pub const CLASS_ACCEPT = 21
pub const CLASS_CONNECT = 22
pub const CLASS_FINISH_CONNECT = 23
pub const CLASS_CONN_READ = 24
pub const CLASS_CONN_WRITE = 25
pub const CLASS_SHUTDOWN = 26
pub const CLASS_NET_DUP = 27
pub const CLASS_ADDRESS = 28
pub const CLASS_SOCKOPT = 29
pub const CLASS_REACTOR_NEW = 30
pub const CLASS_WATCH = 31
pub const CLASS_MODIFY = 32
pub const CLASS_REMOVE = 33
pub const CLASS_TIMER = 34
pub const CLASS_CANCEL_TIMER = 35
pub const CLASS_WAIT = 36
pub const CLASS_WAKE = 37
pub const CLASS_STOP = 38
pub const CLASS_RESOLVE = 39
pub const CLASS_CANCEL = 40
pub const CLASS_DIR_MKDIR = 41
pub const CLASS_DIR_UNLINK = 42
pub const CLASS_DIR_RMDIR = 43
pub const CLASS_DIR_READLINK = 44
pub const CLASS_DIR_SYNC = 45
pub const CLASS_OPEN_BENEATH = 46
pub const CLASS_CHMOD = 47
pub const CLASS_SYNC = 48
pub const CLASS_RENAME = 49
pub const CLASS_LINK = 50
pub const CLASS_SYMLINK = 51
pub const CLASS_LOG_OPEN = 52
pub const CLASS_LOG_EMIT = 53
pub const CLASS_LOG_DRAIN = 54
pub const CLASS_LOG_FLUSH = 55
pub const CLASS_PROC_PLAN_NEW = 56
pub const CLASS_PROC_PLAN_SET = 57
pub const CLASS_PROC_SPAWN = 58
pub const CLASS_PROC_PIPE = 59
pub const CLASS_PROC_DUP = 60
pub const CLASS_PROC_EXEC = 61
pub const CLASS_PROC_TAKE = 62
pub const CLASS_PROC_WAIT = 63
pub const CLASS_PROC_KILL = 64
pub const CLASS_PROC_DETACH = 65
pub const CLASS_PROC_REAP = 66
pub const CLASS_PROC_CWD = 67
pub const CLASS_PROC_CHDIR = 68
pub const CLASS_SIGNAL_INIT = 69
pub const CLASS_SIGNAL_SUBSCRIBE = 70
pub const CLASS_SIGNAL_NEXT = 71
pub const CLASS_SIGNAL_CLOSE = 72
pub const CLASS_TERMINAL_OPEN = 73
pub const CLASS_TERMINAL_SIZE = 74
pub const CLASS_TERMINAL_RAW = 75
pub const CLASS_TERMINAL_RESTORE = 76
pub const CLASS_TERMINAL_DUP = 77

pub fn reset(): int {
    return __cinterop("sysfake_reset")
}

pub fn push(callClass: int, result: int): int {
    return __cinterop("sysfake_push", callClass, result)
}

pub fn setTime(value: int): int {
    return __cinterop("sysfake_set_time", value)
}

pub fn now(): int {
    return __cinterop("sysfake_now")
}

pub fn setRealtime(seconds: int, nanos: int): int {
    return __cinterop("sysfake_set_realtime", seconds, nanos)
}

pub fn setSeed(value: int): int {
    return __cinterop("sysfake_set_seed", value)
}

pub fn count(callClass: int): int {
    return __cinterop("sys_res_call_count", callClass)
}

pub fn netReady(sourceToken: int): int {
    return __cinterop("sysfake_net_ready", sourceToken)
}

pub fn netAdvance(nanos: int): int {
    return __cinterop("sysfake_net_advance", nanos)
}

pub fn netPending(sourceToken: int, readable: bool, writable: bool): int {
    var rd = 0
    var wr = 0
    if readable { rd = 1 }
    if writable { wr = 1 }
    return __cinterop("sysfake_net_pending", sourceToken, rd, wr)
}

pub fn disableOpenBeneath(disabled: bool): int {
    var flag = 0
    if disabled { flag = 1 }
    return __cinterop("sysfake_disable_open_beneath", flag)
}

pub fn setLogShort(bytes: int): int {
    return __cinterop("sysfake_log_short", bytes)
}

pub fn storeCount(): int {
    return __cinterop("sysfake_store_count")
}

// P3 fake controls.
pub fn setArgMax(value: int): int {
    return __cinterop("sysfake_set_arg_max", value)
}

pub fn procExit(ordinal: int, flags: int, payload: int): int {
    return __cinterop("sysfake_proc_exit", ordinal, flags, payload)
}

pub fn lastOrdinal(): int {
    return __cinterop("sysfake_proc_last")
}

pub fn procWrite(ordinal: int, which: int, bufToken: int, offset: int,
                 count: int): int {
    return __cinterop("sysfake_proc_write", ordinal, which, bufToken, offset,
                      count)
}

pub fn procRead(ordinal: int, which: int, bufToken: int, offset: int,
                count: int): int {
    return __cinterop("sysfake_proc_read", ordinal, which, bufToken, offset,
                      count)
}

pub fn signalPush(signal: int, count: int): int {
    return __cinterop("sysfake_signal_push", signal, count)
}

pub fn terminalSize(rows: int, columns: int): int {
    return __cinterop("sysfake_terminal_size", rows, columns)
}

pub fn terminalRaw(raw: bool): int {
    var flag = 0
    if raw { flag = 1 }
    return __cinterop("sysfake_terminal_raw", flag)
}
