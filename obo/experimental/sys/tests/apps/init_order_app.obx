// Explicit initialization, idempotent shutdown, cached final report and
// retired-context identity behavior.
module app
import "sysplatform.obx" as platform
import "systestres.obx" as testres
import "sysbytes.obx" as bytes
import "syserrors.obx" as errors

fn showError(label: string, m: string, c: int) {
    let k = errors::kind(c)
    println(label, "=", errors::text(&k))
}

fn main() {
    // Before initialization: no native action is legal.
    println("cap_before=", platform::hasCapability("resource.identity"))
    let c0 = platform::counts()
    match c0 { ok(c) { println("counts_before=unexpected_ok") } err(m, c) { showError("counts_before", m, c) } }
    let pre = testres::open()
    match pre { ok(t) { println("open_before=unexpected_ok") } err(m, c) { showError("open_before", m, c) } }
    let s0 = platform::shutdown()
    match s0 { ok(c) { println("shutdown_before=unexpected_ok") } err(m, c) { showError("shutdown_before", m, c) } }

    // Invalid options are rejected at entry.
    let bad = new platform::Options{maxResources: 0, maxShells: 4, maxNativeBytes: 8, ignorePipeSignal: true}
    let ib = platform::initialize(&bad)
    match ib { ok(v) { println("invalid_options=unexpected_ok") } err(m, c) { showError("invalid_options", m, c) } }

    let o = platform::defaultOptions()
    let i1 = platform::initialize(&o)
    match i1 { ok(v) { println("init1=", v) } err(m, c) { showError("init1_error", m, c) } }
    println("cap_during=", platform::hasCapability("resource.identity"), " unknown=", platform::hasCapability("net.epoll"))

    let same = platform::defaultOptions()
    let i2 = platform::initialize(&same)
    match i2 { ok(v) { println("init_same=", v) } err(m, c) { showError("init_same_error", m, c) } }

    var other = platform::defaultOptions()
    other.maxShells = 16
    let i3 = platform::initialize(&other)
    match i3 { ok(v) { println("init_other=unexpected_ok") } err(m, c) { showError("init_other", m, c) } }

    let made = testres::open()
    match made {
        ok(t) {
            let cl = testres::close(&t)
            let sd = platform::shutdown()
            match sd {
                ok(c) { println("shutdown1=", c.resources, ",", c.shells, ",", c.cleanupFailures) }
                err(m, c) { showError("shutdown1_error", m, c) }
            }
            let rc1 = testres::close(&t)
            match rc1 { ok(v) { println("close_after_shutdown=", v) } err(m, c) { showError("close_after_shutdown_error", m, c) } }
            let sd2 = platform::shutdown()
            match sd2 {
                ok(c) { println("shutdown2=", c.resources, ",", c.shells, ",", c.cleanupFailures) }
                err(m, c) { showError("shutdown2_error", m, c) }
            }
            println("cap_after=", platform::hasCapability("resource.identity"))
            let c1 = platform::counts()
            match c1 { ok(c) { println("counts_after=unexpected_ok") } err(m, c) { showError("counts_after", m, c) } }
            let post = testres::open()
            match post { ok(x) { println("open_after=unexpected_ok") } err(m, c) { showError("open_after", m, c) } }

            // New context, same process. The old shell must not address it.
            let i4 = platform::initialize(&o)
            match i4 { ok(v) { println("init_again=", v) } err(m, c) { showError("init_again_error", m, c) } }
            let rc2 = testres::close(&t)
            match rc2 { ok(v) { println("close_after_reinit=", v) } err(m, c) { showError("close_after_reinit_error", m, c) } }
            let stale = platform::_sourceHandle(handle(t.res))
            match stale { ok(h) { println("old_shell=unexpected_ok") } err(m, c) { showError("old_shell", m, c) } }
            let fresh = testres::open()
            match fresh {
                ok(t2) {
                    println("fresh_open=ok")
                    let cl2 = testres::close(&t2)
                }
                err(m, c) { showError("fresh_open_error", m, c) }
            }
            let sd3 = platform::shutdown()
            match sd3 { ok(c) { println("shutdown3=", c.resources, ",", c.shells) } err(m, c) { showError("shutdown3_error", m, c) } }
        }
        err(m, c) { showError("open_error", m, c) }
    }
}
