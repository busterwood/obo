// Adversarial identity tests: future/forged/stale nonces, user-created shells,
// wrong-kind shells, owner-liveness aliases, double close and closed I/O.
module app
import "sysplatform.obx" as platform
import "systestres.obx" as testres
import "sysbytes.obx" as bytes
import "syserrors.obx" as errors

fn showError(label: string, m: string, c: int) {
    let k = errors::kind(c)
    println(label, "=", errors::text(&k))
}

fn showSource(label: string, r: Result[^platform::Resource]) {
    match r {
        ok(h) { println(label, "=ok") }
        err(m, c) { showError(label, m, c) }
    }
}

fn leakedHint(): Result[int] {
    let t = try testres::open()
    return ok(t.res.reserved)
}

fn main() {
    let o = platform::defaultOptions()
    o.maxShells = 16
    o.maxResources = 16
    o.maxNativeBytes = 1024
    let init = platform::initialize(&o)
    match init { ok(v) { println("init=", v) } err(m, c) { showError("init_error", m, c) } }

    // Nonce 1 is never issued. A hint forged before its slot exists must stay
    // invalid after the slot is populated with a random nonce.
    let future = new platform::Resource{reserved: platform::_hint(0, 1)}
    showSource("future_before", platform::source(&future))
    let futureFar = new platform::Resource{reserved: platform::_hint(10, 1)}
    showSource("out_of_range_before", platform::source(&futureFar))

    let made = testres::open()
    match made {
        ok(t) {
            println("live_open=ok")
            showSource("future_after_populate", platform::source(&future))
            let hint = t.res.reserved
            let slot = hint % 1048576
            let nonce = hint / 1048576
            let wrongNonce = new platform::Resource{reserved: platform::_hint(slot - 1, nonce + 1)}
            showSource("wrong_nonce", platform::source(&wrongNonce))
            let zero = new platform::Resource{reserved: 0}
            showSource("zero_shell", platform::source(&zero))
            showSource("live_source", testres::source(&t))
            showSource("wrong_kind", testres::sourceAsAlt(&t))

            // A copied live hint aliases the same entry while its registered
            // owner is alive (documented 0.12 public-field limitation).
            let alias = new platform::Resource{reserved: hint}
            showSource("copied_hint_live", platform::source(&alias))

            let wc = testres::closeAlt(&t)
            match wc { ok(v) { println("wrong_kind_close=unexpected_ok") } err(m, c) { showError("wrong_kind_close", m, c) } }
            let c1 = testres::close(&t)
            match c1 { ok(v) { println("close=", v) } err(m, c) { showError("close_error", m, c) } }
            let c2 = testres::close(&t)
            match c2 { ok(v) { println("double_close=", v) } err(m, c) { showError("double_close_error", m, c) } }
            let closedRead = testres::read(&t)
            match closedRead { ok(v) { println("closed_read=unexpected_ok") } err(m, c) { showError("closed_read", m, c) } }
        }
        err(m, c) { showError("open_error", m, c) }
    }

    // Populate slot index 10 so the earlier out-of-range hint is now in range;
    // its nonce is still not the slot's random nonce.
    var held = new []testres::TestResource(0)
    var i = 0
    while i < 10 {
        let extra = testres::open()
        match extra {
            ok(x) { append(held, x) }
            err(m, c) { showError("extra_open_error", m, c) }
        }
        i += 1
    }
    showSource("out_of_range_after_populate", platform::source(&futureFar))

    // A copied hint is bound to the registered owner's liveness: after the
    // owner shell dies, the same hint fails even though the native resource is
    // a leak record until shutdown.
    let leaked = leakedHint()
    match leaked {
        ok(oldHint) {
            let orphan = new platform::Resource{reserved: oldHint}
            showSource("orphan_owner_dead", platform::source(&orphan))
        }
        err(m, c) { showError("leaked_hint_error", m, c) }
    }

    for x in held {
        let hx = handle(x)
        let cx = testres::closeHandle(hx)
    }

    let cnt = platform::counts()
    match cnt { ok(c) { println("counts=", c.resources, ",", c.shells) } err(m, c) { showError("counts_error", m, c) } }
    let sd = platform::shutdown()
    match sd { ok(c) { println("shutdown=", c.resources, ",", c.shells) } err(m, c) { showError("shutdown_error", m, c) } }
}
