// Capacity tests: native resource limit, shell/slot limit, byte quota and the
// 16 MiB per-buffer ceiling. All limits are configured, never host-dependent.
module app
import "sysplatform.obx" as platform
import "systestres.obx" as testres
import "sysbytes.obx" as bytes
import "syserrors.obx" as errors

fn showError(label: string, m: string, c: int) {
    let k = errors::kind(c)
    println(label, "=", errors::text(&k))
}

fn main() {
    // Phase 1: one native resource, two live shells.
    let o1 = platform::defaultOptions()
    o1.maxResources = 1
    o1.maxShells = 2
    o1.maxNativeBytes = 64
    let i1 = platform::initialize(&o1)
    match i1 { ok(v) { println("init1=", v) } err(m, c) { showError("init1_error", m, c) } }

    let a = testres::open()
    match a {
        ok(ta) {
            println("a=ok")
            let b = testres::open()
            match b { ok(tb) { println("b=unexpected_ok") } err(m, c) { showError("b", m, c) } }
            let ca = testres::close(&ta)
            let cok = testres::open()
            match cok {
                ok(tc) {
                    println("after_close=ok")
                    let d = testres::open()
                    match d { ok(td) { println("shell_cap=unexpected_ok") } err(m, c) { showError("shell_cap", m, c) } }
                    let cc = testres::close(&tc)
                }
                err(m, c) { showError("after_close_error", m, c) }
            }
        }
        err(m, c) { showError("a_error", m, c) }
    }
    let s1 = platform::shutdown()
    match s1 { ok(c) { println("shutdown1=", c.resources, ",", c.shells) } err(m, c) { showError("shutdown1_error", m, c) } }

    // Phase 2: byte quota and per-buffer ceiling.
    let o2 = platform::defaultOptions()
    o2.maxResources = 8
    o2.maxShells = 8
    o2.maxNativeBytes = 10
    let i2 = platform::initialize(&o2)
    match i2 { ok(v) { println("init2=", v) } err(m, c) { showError("init2_error", m, c) } }

    let eight = bytes::create(8)
    match eight {
        ok(b8) {
            println("buffer8=ok")
            let four = bytes::create(4)
            match four { ok(b4) { println("quota=unexpected_ok") } err(m, c) { showError("quota", m, c) } }
            let cb = bytes::close(&b8)
            let four2 = bytes::create(4)
            match four2 {
                ok(b4) {
                    println("after_release=ok")
                    let big = bytes::create(platform::MAX_BYTE_BUFFER + 1)
                    match big { ok(bb) { println("oversize=unexpected_ok") } err(m, c) { showError("oversize", m, c) } }
                    let neg = bytes::create(-1)
                    match neg { ok(bn) { println("negative=unexpected_ok") } err(m, c) { showError("negative", m, c) } }
                    let zero = bytes::create(0)
                    match zero {
                        ok(bz) {
                            println("zero=ok")
                            let lz = bytes::length(&bz)
                            match lz { ok(n) { println("zero_len=", n) } err(m, c) { showError("zero_len_error", m, c) } }
                            let cz = bytes::close(&bz)
                        }
                        err(m, c) { showError("zero_error", m, c) }
                    }
                    let c4 = bytes::close(&b4)
                }
                err(m, c) { showError("after_release_error", m, c) }
            }
        }
        err(m, c) { showError("buffer8_error", m, c) }
    }
    let s2 = platform::shutdown()
    match s2 { ok(c) { println("shutdown2=", c.resources, ",", c.shells) } err(m, c) { showError("shutdown2_error", m, c) } }

    // Phase 3: maxShells=1. A closed tombstone whose shell is alive still
    // occupies the slot; after the shell dies, insertion reuses it.
    let o3 = platform::defaultOptions()
    o3.maxResources = 4
    o3.maxShells = 1
    o3.maxNativeBytes = 64
    let i3 = platform::initialize(&o3)
    match i3 { ok(v) { println("init3=", v) } err(m, c) { showError("init3_error", m, c) } }
    let tomb = testres::open()
    match tomb {
        ok(ta) {
            let cl = testres::close(&ta)
            match cl { ok(v) { println("tombstone_close=", v) } err(m, c) { showError("tombstone_close_error", m, c) } }
            let blocked = testres::open()
            match blocked { ok(tb) { println("tombstone_open=unexpected_ok") } err(m, c) { showError("tombstone_open", m, c) } }
        }
        err(m, c) { showError("tombstone_create_error", m, c) }
    }
    let afterDrop = testres::open()
    match afterDrop {
        ok(tc) {
            println("after_drop_open=ok")
            let cc = testres::close(&tc)
        }
        err(m, c) { showError("after_drop_open_error", m, c) }
    }
    let s3 = platform::shutdown()
    match s3 { ok(c) { println("shutdown3=", c.resources, ",", c.shells) } err(m, c) { showError("shutdown3_error", m, c) } }

    // Phase 4: exact 16 MiB boundary and one past it.
    let o4 = platform::defaultOptions()
    o4.maxResources = 4
    o4.maxShells = 4
    o4.maxNativeBytes = 33554432
    let i4 = platform::initialize(&o4)
    match i4 { ok(v) { println("init4=", v) } err(m, c) { showError("init4_error", m, c) } }
    let exact = bytes::create(platform::MAX_BYTE_BUFFER)
    match exact {
        ok(big) {
            println("exact16=ok")
            let le = bytes::length(&big)
            match le { ok(n) { println("exact16_len=", n) } err(m, c) { showError("exact16_len_error", m, c) } }
            let past = bytes::create(platform::MAX_BYTE_BUFFER + 1)
            match past { ok(bp) { println("past16=unexpected_ok") } err(m, c) { showError("past16", m, c) } }
            let cb = bytes::close(&big)
        }
        err(m, c) { showError("exact16_error", m, c) }
    }
    let s4 = platform::shutdown()
    match s4 { ok(c) { println("shutdown4=", c.resources, ",", c.shells) } err(m, c) { showError("shutdown4_error", m, c) } }
}
