// P1b replaceAtomic stage faults (fake_ctl link). Every injection is on the
// operation's own class; the fake store count proves no temporary is left.
module app

import "sysplatform.obx" as platform
import "sysfile.obx" as file
import "sysdir.obx" as dir
import "sysfakectl.obx" as fake
import "syserrors.obx" as errs

fn show(label: string, code: int) {
    let k = errs::kind(code)
    println(label, "=", errs::text(&k))
}

fn bytesOf(s: string): []byte {
    let b = new []byte(len(s))
    for i in 0..len(s) { b[i] = s[i] }
    return b
}

fn readFile(d: &dir::Directory, name: string): string {
    let o = file::readOptions()
    let made = file::openAt(d, name, &o)
    match made {
        ok(f) {
            let r = file::readSome(&f, 128)
            let c = file::close(&f)
            match r {
                ok(v) {
                    if v == nil { return "<nil>" }
                    return string(v)
                }
                err(m, code) { return "<err>" }
            }
        }
        err(m, c) { return "<missing>" }
    }
}

fn report(label: string, r: Result[file::ReplaceReport]) {
    match r {
        ok(v) {
            println(label, "=ok,", v.committed, ",", v.durable, ",", v.code)
        }
        err(m, c) { show(label, c) }
    }
}

fn main() {
    let av = args()
    let base = av[1]
    let o = platform::defaultOptions()
    let ini = platform::initialize(&o)
    match ini { ok(v) { println("init=", v) } err(m, c) { show("init", c) } }
    println("fake_reset=", fake::reset())
    let d = dir::open(base)
    match d {
        ok(dd) {
            let target = bytesOf("payload")
            let baseCount = fake::storeCount()
            println("baseline=", baseCount)
            report("success", file::replaceAtomic(&dd, "ok", &target, 420, true))
            println("success_count=", fake::storeCount() - baseCount, " content=", readFile(&dd, "ok"))
            report("nondur", file::replaceAtomic(&dd, "nondur", &target, 420, false))
            println("nondur_count=", fake::storeCount() - baseCount)

            fake::push(fake::CLASS_FILE_OPEN, -28)
            report("temp_create", file::replaceAtomic(&dd, "fail1", &target, 420, true))
            println("temp_create_count=", fake::storeCount() - baseCount)

            fake::push(fake::CLASS_WRITE, -28)
            report("write", file::replaceAtomic(&dd, "fail2", &target, 420, true))
            println("write_count=", fake::storeCount() - baseCount)

            fake::push(fake::CLASS_CHMOD, -13)
            report("chmod", file::replaceAtomic(&dd, "fail3", &target, 420, true))
            println("chmod_count=", fake::storeCount() - baseCount)

            fake::push(fake::CLASS_SYNC, -5)
            report("fsync", file::replaceAtomic(&dd, "fail4", &target, 420, true))
            println("fsync_count=", fake::storeCount() - baseCount)

            fake::push(fake::CLASS_RENAME, -18)
            report("rename", file::replaceAtomic(&dd, "fail5", &target, 420, true))
            println("rename_count=", fake::storeCount() - baseCount)

            let old = bytesOf("old")
            report("seed", file::replaceAtomic(&dd, "post", &old, 420, false))
            let before = fake::storeCount()
            fake::push(fake::CLASS_DIR_SYNC, -5)
            report("postcommit", file::replaceAtomic(&dd, "post", &target, 420, true))
            println("post_count=", fake::storeCount() - before, " content=", readFile(&dd, "post"))

            // A target in a directory that is actually a directory fails at the
            // commit rename after write/chmod; the temporary must be removed.
            let mk = dir::mkdir(&dd, "adir", 493)
            let beforeDir = fake::storeCount()
            fake::push(fake::CLASS_RENAME, -21)
            report("commit_isdir", file::replaceAtomic(&dd, "adir", &target, 420, true))
            println("commit_dir_count=", fake::storeCount() - beforeDir)

            let c = dir::close(&dd)
            match c { ok(v) { println("dir_close=", v) } err(m, cc) { show("dir_close", cc) } }
        }
        err(m, c) { show("dir_open", c) }
    }
    let cnt = platform::counts()
    match cnt { ok(c) { println("counts=", c.resources, ",", c.shells) } err(m, c) { show("counts", c) } }
    let sd = platform::shutdown()
    match sd { ok(c) { println("shutdown=", c.resources, ",", c.shells, ",", c.cleanupFailures) } err(m, c) { show("shutdown", c) } }
}
