// Ordinary obo surface for the v2 template adapter.
//
// Demo is a foreign handle: obo holds the real demo_item * in its private word
// and cannot construct, copy or convert it. open() gets an `own` result and
// open_out() gets the same pointer through an out record. Close explicitly,
// normally with defer. Dropping Demo does NOT release the C object; under
// OBO_CHECK=1 the foreign-handle census reports it (exit 8).
module demo

pub type Demo = foreign "demo_item"

native fn demo_open(size: int): Demo
native fn demo_read_byte(item: &Demo, index: int): int
native fn demo_make(size: int, out item: Demo): demo_make_out

pub fn (mut d: &Demo) close(): Result[bool] { return __foreignClose(d) }
pub fn (d: &Demo) is_open(): bool { return __foreignIsOpen(d) }

pub fn open(size: int): Result[Demo] {
    if size < 0 || size > 1048576 { return err("size is out of range", 2) }
    return ok(demo_open(size))
}

// The out record is an ordinary value: `rc` first, then `item: ?Demo`. `take`
// moves the handle out; close it exactly once on the error path too.
pub fn open_out(size: int): Result[Demo] {
    if size < 0 || size > 1048576 { return err("size is out of range", 2) }
    var out = demo_make(size)
    var d = take(out.item)
    if d == nil { return err("demo_make returned no item", 3) }
    if out.rc != 0 {
        d.close()
        return err("demo_make failed", out.rc)
    }
    return ok(d)
}

pub fn (d: &Demo) byte_at(index: int): int {
    return demo_read_byte(d, index)
}
