module demo

// Ordinary obo surface for the template adapter. The token is an integer; obo
// record fields are not private, so the C registry is what rejects a forged or
// stale token. Dropping Demo does NOT release the C resource: call close(),
// normally through defer (close borrows the wrapper).
pub type Demo = ref record { tok: int }

pub fn open(size: int): Result[Demo] {
    let t = __cinterop("demo_open", size)
    if t <= 0 { return err("demo_open failed", 2) }
    return ok(new Demo{tok: t})
}

pub fn (d: &Demo) byte_at(index: int): int {
    return __cinterop("demo_read_byte", d.tok, index)
}

pub fn (d: &Demo) close(): bool {
    return __cinterop("demo_close", d.tok) == 1
}

pub fn live(): int {
    return __cinterop("demo_live")
}
