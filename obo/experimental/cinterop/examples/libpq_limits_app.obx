module app

import "libpq.obx"

fn bytes_of(s: string): []byte {
    var b = new []byte(0)
    for i in 0..len(s) { append(b, s[i]) }
    return b
}

fn values_of(n: int): []?[]byte {
    var v = new []?[]byte(0)
    for i in 0..n { append(v, bytes_of("1")) }
    return v
}

// n copies of b; b must be non-NUL when the bytes are used as SQL.
fn filled(n: int, b: byte): []byte {
    var out = new []byte(0)
    for i in 0..n { append(out, b) }
    return out
}

fn flags_of(n: int): []bool {
    var f = new []bool(0)
    for i in 0..n { append(f, false) }
    return f
}

// Runs against the fake libpq only. The wrapper rejects an over-limit query
// before any C call, so the message is specific and never a stale connection
// error. The 32-parameter query at the limit is accepted.
fn main() {
    let made = libpq::connect(bytes_of("fake-ok"))
    match made {
        ok(conn) {
            let q33 = libpq::exec_params(&conn, bytes_of("FAKE_OK"), values_of(33), flags_of(33))
            match q33 {
                ok(rows) {
                    println("params33=unexpected_ok")
                    rows.close()
                    exit(2)
                }
                err(m, c) { println("params33_error=", m, " (", c, ")") }
            }

            let q32 = libpq::exec_params(&conn, bytes_of("FAKE_OK"), values_of(32), flags_of(32))
            match q32 {
                ok(rows) {
                    println("params32_status=", rows.status())
                    println("params32_closed=", rows.close())
                }
                err(m, c) {
                    println("params32_error=", m, " (", c, ")")
                    exit(3)
                }
            }

            let big = new []byte(1048577)
            let qbig = libpq::exec_params(&conn, big, new []?[]byte(0), new []bool(0))
            match qbig {
                ok(rows) {
                    println("sql_over_limit=unexpected_ok")
                    rows.close()
                    exit(4)
                }
                err(m, c) { println("sql_error=", m, " (", c, ")") }
            }
            // Exactly the 1 MiB SQL limit is not rejected by the limit check. The
            // fake PQexecParams cannot run a statement this long, so the failure
            // that follows is not the limit message; only that is asserted.
            let at = filled(1048576, byte(97))
            let qat = libpq::exec_params(&conn, at, new []?[]byte(0), new []bool(0))
            match qat {
                ok(rows) {
                    println("sql_at_limit=accepted status=", rows.status())
                    rows.close()
                }
                err(m, c) { println("sql_at_limit=rejected ", m, " (", c, ")") }
            }

            // Packet bound, exact. The packet is 21 + L bytes for the 7-byte
            // SQL "FAKE_OK" and one binary parameter of L bytes. L = 16777195
            // makes exactly PQ_MAX_BUFFER (16 MiB) and must be accepted; one more
            // byte must be rejected in build_packet. Binary, so no NUL scan.
            var atvals = new []?[]byte(0)
            append(atvals, new []byte(16777195))
            var atflags = new []bool(0)
            append(atflags, true)
            let q16 = libpq::exec_params(&conn, bytes_of("FAKE_OK"), atvals, atflags)
            match q16 {
                ok(rows) {
                    println("packet_16mib=accepted status=", rows.status())
                    rows.close()
                }
                err(m, c) { println("packet_16mib=rejected ", m, " (", c, ")") }
            }
            var overvals = new []?[]byte(0)
            append(overvals, new []byte(16777196))
            var overflags = new []bool(0)
            append(overflags, true)
            let q16p = libpq::exec_params(&conn, bytes_of("FAKE_OK"), overvals, overflags)
            match q16p {
                ok(rows) {
                    println("packet_16mib_plus1=unexpected_ok")
                    rows.close()
                    exit(6)
                }
                err(m, c) { println("packet_16mib_plus1_error=", m, " (", c, ")") }
            }
            println("conn_closed=", conn.close())
        }
        err(m, c) {
            println("connect_error=", m, " (", c, ")")
            exit(5)
        }
    }
    println("live=", libpq::live_resources())
    println("conns=", libpq::live_connections())
    println("results=", libpq::live_results())
}
