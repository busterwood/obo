module app

import "libpq.obx"

fn bytes_of(s: string): []byte {
    var b = new []byte(0)
    for i in 0..len(s) { append(b, s[i]) }
    return b
}

fn values_of(n: int): []?[]byte {
    var v = new []?[]byte(0)
    for i in 0..n { append(v, bytes_of("1")) }
    return v
}

// n copies of b; b must be non-NUL when the bytes are used as SQL.
fn filled(n: int, b: byte): []byte {
    var out = new []byte(0)
    for i in 0..n { append(out, b) }
    return out
}

fn flags_of(n: int): []bool {
    var f = new []bool(0)
    for i in 0..n { append(f, false) }
    return f
}

fn close_conn(mut conn: &libpq::Connection): bool {
    let r = conn.close()
    match r {
        ok(v) { return v }
        err(m, c) { println("close_error=", m, " (", c, ")"); return false }
    }
}

// Runs against the fake libpq only. The wrapper rejects over-limit calls before
// any C call, so each message is specific and never a stale connection error.
fn main() {
    let made = libpq::connect(bytes_of("fake-ok"))
    match made {
        ok(conn) {
            let q33 = libpq::exec_params(&conn, bytes_of("FAKE_OK"), values_of(33), flags_of(33))
            match q33 {
                ok(rows) {
                    println("params33=unexpected_ok")
                    rows.close()
                    exit(2)
                }
                err(m, c) { println("params33_error=", m, " (", c, ")") }
            }

            let q32 = libpq::exec_params(&conn, bytes_of("FAKE_OK"), values_of(32), flags_of(32))
            match q32 {
                ok(rows) {
                    println("params32_status=", rows.status())
                    rows.close()
                    println("params32_closed=", !rows.is_open())
                }
                err(m, c) {
                    println("params32_error=", m, " (", c, ")")
                    exit(3)
                }
            }

            let big = new []byte(1048577)
            let qbig = libpq::exec_params(&conn, big, new []?[]byte(0), new []bool(0))
            match qbig {
                ok(rows) {
                    println("sql_over_limit=unexpected_ok")
                    rows.close()
                    exit(4)
                }
                err(m, c) { println("sql_error=", m, " (", c, ")") }
            }
            // Exactly the 1 MiB SQL limit is not rejected by the wrapper. The
            // fake PQexecParams cannot run a statement this long, so the failure
            // that follows is not the limit message; only that is asserted.
            let at = filled(1048576, byte(97))
            let qat = libpq::exec_params(&conn, at, new []?[]byte(0), new []bool(0))
            match qat {
                ok(rows) {
                    println("sql_at_limit=accepted status=", rows.status())
                    rows.close()
                }
                err(m, c) { println("sql_at_limit=rejected ", m, " (", c, ")") }
            }

            // A single value of exactly 16 MiB is accepted; one more byte is
            // rejected by the wrapper before the C call.
            var atvals = new []?[]byte(0)
            append(atvals, new []byte(libpq::PQ_MAX_VALUE))
            var atflags = new []bool(0)
            append(atflags, true)
            let q16 = libpq::exec_params(&conn, bytes_of("FAKE_OK"), atvals, atflags)
            match q16 {
                ok(rows) {
                    println("value_16mib=accepted status=", rows.status())
                    rows.close()
                }
                err(m, c) { println("value_16mib=rejected ", m, " (", c, ")") }
            }
            var overvals = new []?[]byte(0)
            append(overvals, new []byte(libpq::PQ_MAX_VALUE + 1))
            var overflags = new []bool(0)
            append(overflags, true)
            let q16p = libpq::exec_params(&conn, bytes_of("FAKE_OK"), overvals, overflags)
            match q16p {
                ok(rows) {
                    println("value_16mib_plus1=unexpected_ok")
                    rows.close()
                    exit(6)
                }
                err(m, c) { println("value_16mib_plus1_error=", m, " (", c, ")") }
            }
            println("conn_closed=", close_conn(&conn))
        }
        err(m, c) {
            println("connect_error=", m, " (", c, ")")
            exit(5)
        }
    }

    // A DSN over 16 MiB is refused before any C call.
    let bigdsn = filled(libpq::PQ_MAX_DSN + 1, byte(97))
    let d = libpq::connect(bigdsn)
    match d {
        ok(conn) {
            println("dsn_over_limit=unexpected_ok")
            close_conn(&conn)
            exit(7)
        }
        err(m, c) { println("dsn_error=", m, " (", c, ")") }
    }
}
