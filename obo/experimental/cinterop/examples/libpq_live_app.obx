module app

import "libpq.obx"

// Opt-in local PostgreSQL smoke test. Pass the conninfo as the only argument;
// the private test documentation records the non-secret local development
// conninfo. This app performs SELECTs only (no persistent schema/data changes)
// and closes every Connection and Rows explicitly.
fn bytes_of(s: string): []byte {
    var b = new []byte(0)
    for i in 0..len(s) { append(b, s[i]) }
    return b
}

fn check(ok: bool, name: string, code: int) {
    if !ok {
        println("FAIL ", name)
        exit(code)
    }
}

fn main() {
    let a = args()
    if len(a) != 2 {
        println("usage: app <conninfo>")
        exit(64)
    }
    let dsn = bytes_of(a[1])
    let made = libpq::connect(dsn)
    match made {
        ok(conn) {
            defer conn.close()
            println("server_version=", libpq::lib_version())

            // 1. Parameterized text, NULL vs empty, exact numeric text/OID/typmod.
            let attack = "x'); DROP TABLE nope; --"
            let vals = new []?[]byte(0)
            append(vals, bytes_of(attack))
            append(vals, bytes_of("42"))
            let flags = new []bool(0)
            append(flags, false)
            append(flags, false)
            let q1 = libpq::exec_params(&conn,
                bytes_of("SELECT $1::text AS t, $2::int AS n, NULL::text AS z, 1.234567890123456789::numeric AS num"),
                vals, flags)
            match q1 {
                ok(rows) {
                    defer rows.close()
                    if rows.status() != libpq::PGRES_TUPLES_OK {
                        println("q1 status=", rows.status())
                        let em = rows.error_message()
                        println("q1 server error=", string(em))
                    }
                    check(rows.status() == libpq::PGRES_TUPLES_OK, "q1 status", 1)
                    check(rows.ntuples() == 1, "q1 tuples", 2)
                    check(rows.nfields() == 4, "q1 fields", 3)
                    let t = rows.text(0, 0)
                    match t {
                        ok(s) { check(s == attack, "q1 injection-as-data", 4) }
                        err(m, c) { println("q1 t error ", m, " ", c); exit(5) }
                    }
                    let n = rows.text(0, 1)
                    match n {
                        ok(s) { check(s == "42", "q1 int text", 6) }
                        err(m, c) { println("q1 n error ", m, " ", c); exit(7) }
                    }
                    check(rows.is_null(0, 2), "q1 NULL", 8)
                    let num = rows.text(0, 3)
                    match num {
                        ok(s) { check(s == "1.234567890123456789", "q1 numeric text", 9) }
                        err(m, c) { println("q1 num error ", m, " ", c); exit(10) }
                    }
                    check(rows.ftype(3) == 1700, "q1 numeric OID", 11)
                    check(rows.fmod(3) == -1, "q1 numeric typmod", 12)
                    println("numeric_text=", "1.234567890123456789", " oid=1700 typmod=-1")
                }
                err(m, c) { println("q1 error ", m, " ", c); exit(14) }
            }

            // 2. NULL and a distinct empty string parameter.
            let nv = new []?[]byte(0)
            append(nv, nil)
            append(nv, new []byte(0))
            let nf = new []bool(0)
            append(nf, false)
            append(nf, false)
            let q2 = libpq::exec_params(&conn,
                bytes_of("SELECT $1::text AS a, $2::text AS b"), nv, nf)
            match q2 {
                ok(rows) {
                    defer rows.close()
                    check(rows.status() == 2, "q2 status", 15)
                    check(rows.is_null(0, 0), "q2 null param", 16)
                    check(!rows.is_null(0, 1), "q2 empty param not null", 17)
                    check(rows.length(0, 1) == 0, "q2 empty length", 18)
                    let b = rows.value(0, 1)
                    match b {
                        ok(v) { check(len(v) == 0, "q2 empty value", 19) }
                        err(m, c) { println("q2 b error ", m, " ", c); exit(20) }
                    }
                    println("null_and_empty=ok")
                }
                err(m, c) { println("q2 error ", m, " ", c); exit(22) }
            }

            // 3. A server error still owns a result and closes cleanly.
            let q3 = libpq::query(&conn, bytes_of("SELECT * FROM obo_cinterop_no_such_table"))
            match q3 {
                ok(rows) {
                    defer rows.close()
                    check(rows.status() == libpq::PGRES_FATAL_ERROR, "q3 error status", 23)
                    let em = rows.error_message()
                    check(len(em) > 0, "q3 error message", 24)
                    println("sql_error_length=", len(em))
                }
                err(m, c) { println("q3 query error ", m, " ", c); exit(26) }
            }

            // 4. Binary result with embedded NUL: decode('00ff41','hex').
            let q4 = libpq::exec_params_binary(&conn,
                bytes_of("SELECT decode('00ff41','hex') AS b"),
                new []?[]byte(0), new []bool(0))
            match q4 {
                ok(rows) {
                    defer rows.close()
                    check(rows.status() == 2, "q4 status", 27)
                    check(rows.nfields() == 1, "q4 fields", 28)
                    check(rows.length(0, 0) == 3, "q4 binary length", 29)
                    let b = rows.value(0, 0)
                    match b {
                        ok(v) {
                            check(len(v) == 3, "q4 value length", 30)
                            check(int(v[0]) == 0, "q4 NUL byte", 31)
                            check(int(v[1]) == 255, "q4 0xff byte", 32)
                            check(int(v[2]) == 65, "q4 0x41 byte", 33)
                        }
                        err(m, c) { println("q4 value error ", m, " ", c); exit(34) }
                    }
                    println("binary_bytes=00ff41 len=3")
                }
                err(m, c) { println("q4 error ", m, " ", c); exit(36) }
            }

        }
        err(m, c) { println("connect error code=", c); exit(38) }
    }

    let live = libpq::live_resources()
    println("live=", live)
    check(live == 0, "resource leak", 39)
    check(libpq::live_buffers() == 0, "buffer leak", 40)
    check(libpq::live_connections() == 0, "connection leak", 41)
    check(libpq::live_results() == 0, "result leak", 42)
    println("live_db_smoke=ok")
}
