module app

import "libpq.obx"

// No database connection: actual libpq version plus real PGresult ownership
// through PQmakeEmptyPGresult/PQclear.
fn main() {
    println("PQlibVersion=", libpq::lib_version())
    let made = libpq::make_empty_rows(libpq::PGRES_TUPLES_OK)
    match made {
        ok(r) {
            println("empty_status=", r.status())
            println("empty_rows=", r.ntuples())
            println("empty_fields=", r.nfields())
            r.close()
            println("empty_closed=", !r.is_open())
        }
        err(m, c) {
            println("empty_error=", m, " (", c, ")")
            exit(1)
        }
    }
}
