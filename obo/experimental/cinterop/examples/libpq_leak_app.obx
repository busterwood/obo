module app

import "libpq.obx"

// Deliberately omits close(). Under OBO_CHECK=1 the foreign census reports the
// leaked Connection (exit 8); the wrapper no longer has a live counter.
fn bytes_of(s: string): []byte {
    var b = new []byte(0)
    for i in 0..len(s) { append(b, s[i]) }
    return b
}

fn main() {
    let made = libpq::connect(bytes_of("fake-ok"))
    match made {
        ok(conn) {
            println("leaked_connection=", conn.is_open())
        }
        err(m, c) { println("unexpected connect error ", m, " ", c); exit(1) }
    }
}
