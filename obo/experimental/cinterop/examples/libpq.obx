// Experimental libpq binding on the cinterop v2 boundary.
//
// This is an explicit-close package, not a production driver. Connection and
// Res are foreign handles: obo holds the real PGconn*/PGresult* in a private
// word and never copies it. Rows owns one Res and records the result format.
// Close explicitly (defer conn.close()/rows.close()); dropping an open handle
// leaks it and the OBO_CHECK=1 census reports it. There is no live_resources()
// counter any more: the census replaces it.
module libpq

pub const CONNECTION_OK = 0
pub const PGRES_EMPTY_QUERY = 0
pub const PGRES_COMMAND_OK = 1
pub const PGRES_TUPLES_OK = 2
pub const PGRES_FATAL_ERROR = 7
pub const PGRES_PIPELINE_ABORTED = 11

// Wrapper limits, checked before any C call (C15 in the design).
pub const PQ_MAX_PARAMS = 32
pub const PQ_MAX_SQL = 1048576
pub const PQ_MAX_DSN = 16777216
pub const PQ_MAX_VALUE = 16777216

// ------------------------------------------------------------- foreign types

pub type Connection = foreign "PGconn"
pub type Res = foreign "PGresult"

pub type Rows = ref record { h: Res; pub fmt: int }


// ------------------------------------------------------------ native surface

native fn connectdb(dsn: &[]byte): ?Connection
native fn conn_status(c: &Connection): int
native fn conn_error(c: &Connection): []byte
native fn exec_params_raw(c: &Connection, sql: &[]byte, values: &[]?[]byte,
                          oids: &[]int, formats: &[]int, result_format: int): ?Res
native fn res_status(r: &Res): int
native fn res_ntuples(r: &Res): int
native fn res_nfields(r: &Res): int
native fn res_is_null(r: &Res, row: int, col: int): int
native fn res_length(r: &Res, row: int, col: int): int
native fn res_value(r: &Res, row: int, col: int): ?[]byte
native fn res_fname(r: &Res, col: int): []byte
native fn res_ftype(r: &Res, col: int): int
native fn res_fmod(r: &Res, col: int): int
native fn res_error(r: &Res): []byte
native fn make_empty_result(status: int): Res
native fn lib_version_native(): int
native fn conninfo_has_timeout(s: &[]byte): int
native fn conninfo_error(): []byte

pub fn (mut c: &Connection) close(): Result[bool] { return __foreignClose(c) }
pub fn (c: &Connection) is_open(): bool { return __foreignIsOpen(c) }
pub fn (c: &Connection) status(): int { return conn_status(c) }
pub fn (c: &Connection) error_message(): []byte { return conn_error(c) }
pub fn (mut r: &Res) close(): Result[bool] { return __foreignClose(r) }
pub fn (r: &Res) is_open(): bool { return __foreignIsOpen(r) }

// ------------------------------------------------------------------ helpers

fn has_nul(b: &[]byte): bool {
    for i in 0..len(b) {
        if b[i] == byte(0) { return true }
    }
    return false
}

fn has_byte(b: &[]byte, c: byte): bool {
    for i in 0..len(b) {
        if b[i] == c { return true }
    }
    return false
}

fn starts_with_bytes(b: &[]byte, s: string): bool {
    if len(b) < len(s) { return false }
    for i in 0..len(s) {
        if b[i] != s[i] { return false }
    }
    return true
}

fn trim_newlines(b: []byte): []byte {
    var n = len(b)
    while n > 0 && (b[n - 1] == byte(10) || b[n - 1] == byte(13)) { n = n - 1 }
    var out = new []byte(0)
    for i in 0..n { append(out, b[i]) }
    return out
}

// Append ` connect_timeout=5` (or the URI separator form) when the keyword is
// absent. libpq's own parser decides presence in conninfo_has_timeout.
fn with_default_timeout(dsn: []byte): []byte {
    var out = new []byte(0)
    for i in 0..len(dsn) { append(out, dsn[i]) }
    var sep = byte(32)
    if starts_with_bytes(&dsn, "postgres://") || starts_with_bytes(&dsn, "postgresql://") {
        if has_byte(&dsn, byte(63)) { sep = byte(38) } else { sep = byte(63) }
    }
    append(out, sep)
    let suffix = "connect_timeout=5"
    for i in 0..len(suffix) { append(out, suffix[i]) }
    return out
}

fn text_of(b: []byte): Result[string] {
    if has_nul(&b) { return err("bytes contain an embedded NUL", 1) }
    return ok(string(b))
}

// -------------------------------------------------------------- connections

pub fn connect(dsn: []byte): Result[Connection] {
    if len(dsn) > PQ_MAX_DSN { return err("connection string is too large", 2) }
    if has_nul(&dsn) { return err("connection string contains a NUL byte", 2) }
    let has = conninfo_has_timeout(&dsn)
    if has < 0 {
        let e = trim_newlines(conninfo_error())
        let msg = string(e)
        if len(msg) == 0 { return err("invalid connection string", 2) }
        return err(msg, 2)
    }
    var bounded = new []byte(0)
    if has == 0 {
        bounded = with_default_timeout(dsn)
    } else {
        bounded = dsn
    }
    let c = connectdb(&bounded)
    if c == nil {
        return err("libpq returned no connection object (PQconnectdb returned NULL)", 2)
    }
    var conn = c
    let st = conn_status(&conn)
    if st != CONNECTION_OK {
        let mb = conn_error(&conn)
        let msg = string(mb)
        conn.close()
        return err(msg, st)
    }
    return ok(conn)
}

// -------------------------------------------------------------- query / rows

fn exec_params_fmt(c: &Connection, sql: []byte, values: []?[]byte,
                   binary: []bool, result_binary: bool): Result[Rows] {
    if len(binary) != len(values) { return err("values and binary flags differ in length", 2) }
    if len(values) > PQ_MAX_PARAMS {
        return err("too many query parameters: the limit is 32 (PQ_MAX_PARAMS)", 2)
    }
    if len(sql) > PQ_MAX_SQL {
        return err("SQL text is larger than the 1 MiB limit (PQ_MAX_SQL)", 2)
    }
    if has_nul(&sql) { return err("SQL text contains an embedded NUL", 2) }
    var oids = new []int(0)
    var formats = new []int(0)
    // libpq treats a text paramValues[] entry as a C string and ignores
    // paramLengths, so every text value needs a NUL one byte past its data.
    // Build len+1, then truncate to len: the array keeps the terminator in its
    // capacity while its length (and the thunk's paramLengths) stays exact.
    var wire = new []?[]byte(0)
    for i in 0..len(values) {
        append(oids, 0)                     // untyped parameter; libpq infers
        var fmt = 0
        if binary[i] { fmt = 1 }
        append(formats, fmt)
        let v = take(values[i])
        if v == nil {
            append(wire, nil)
            drop(v)
        } else {
            if len(v) > PQ_MAX_VALUE {
                return err("query parameter is larger than the 16 MiB limit", 2)
            }
            if binary[i] {
                append(wire, v)             // explicit length; NULs are data
            } else {
                if has_nul(&v) {
                    return err("text parameter contains an embedded NUL", 2)
                }
                var t = new []byte(len(v) + 1)
                for j in 0..len(v) { t[j] = v[j] }
                truncate(t, len(v))
                append(wire, t)
                drop(v)                     // the original text bytes are copied
            }
        }
    }
    var rf = 0
    if result_binary { rf = 1 }
    let r = exec_params_raw(c, &sql, &wire, &oids, &formats, rf)
    if r == nil {
        let mb = conn_error(c)
        let msg = string(mb)
        if len(msg) == 0 { return err("libpq returned no result and no error message", 2) }
        return err(msg, 2)
    }
    let res = r
    return ok(new Rows{h: res, fmt: rf})
}

pub fn exec_params(c: &Connection, sql: []byte,
                   values: []?[]byte, binary: []bool): Result[Rows] {
    return exec_params_fmt(c, sql, values, binary, false)
}

pub fn exec_params_binary(c: &Connection, sql: []byte,
                          values: []?[]byte, binary: []bool): Result[Rows] {
    return exec_params_fmt(c, sql, values, binary, true)
}

pub fn query(c: &Connection, sql: []byte): Result[Rows] {
    return exec_params(c, sql, new []?[]byte(0), new []bool(0))
}

pub fn (r: &Rows) is_open(): bool {
    return __foreignIsOpen(&r.h)
}

pub fn (r: &Rows) status(): int {
    if !r.is_open() { return -1 }
    return res_status(&r.h)
}

pub fn (r: &Rows) ntuples(): int {
    if !r.is_open() { return -1 }
    return res_ntuples(&r.h)
}

pub fn (r: &Rows) nfields(): int {
    if !r.is_open() { return -1 }
    return res_nfields(&r.h)
}

fn (r: &Rows) bounds_ok(row: int, col: int): bool {
    if !r.is_open() { return false }
    if row < 0 || col < 0 { return false }
    if row >= r.ntuples() || col >= r.nfields() { return false }
    return true
}

pub fn (r: &Rows) is_null(row: int, col: int): bool {
    if !r.bounds_ok(row, col) { return false }
    return res_is_null(&r.h, row, col) == 1
}

// Length in bytes as libpq reports it; NULL and empty both report 0. Use
// is_null to tell them apart.
pub fn (r: &Rows) length(row: int, col: int): int {
    if !r.bounds_ok(row, col) { return -1 }
    return res_length(&r.h, row, col)
}

// Exact bytes, including an embedded NUL. SQL NULL is err("SQL NULL", 1); a
// value over the copy-out cap is a different error, so the two nil cases stay
// distinguishable. Check is_null first when NULL and empty must differ.
pub fn (r: &Rows) value(row: int, col: int): Result[[]byte] {
    if !r.is_open() { return err("rows are closed", 2) }
    if !r.bounds_ok(row, col) { return err("row or column is out of range", 2) }
    if r.is_null(row, col) { return err("SQL NULL", 1) }
    let v = res_value(&r.h, row, col)
    if v == nil { return err("value is larger than the 16 MiB limit", 2) }
    return ok(v)
}

pub fn (r: &Rows) text(row: int, col: int): Result[string] {
    let b = try r.value(row, col)
    return text_of(b)
}

pub fn (r: &Rows) fname(col: int): Result[string] {
    if !r.is_open() { return err("rows are closed", 2) }
    if col < 0 || col >= r.nfields() { return err("column is out of range", 2) }
    let b = res_fname(&r.h, col)
    return ok(string(b))
}

pub fn (r: &Rows) ftype(col: int): int {
    if !r.is_open() || col < 0 || col >= r.nfields() { return 0 }
    return res_ftype(&r.h, col)
}

pub fn (r: &Rows) fmod(col: int): int {
    if !r.is_open() || col < 0 || col >= r.nfields() { return -1 }
    return res_fmod(&r.h, col)
}

pub fn (r: &Rows) error_message(): []byte {
    if !r.is_open() { return new []byte(0) }
    return res_error(&r.h)
}

// Rows.close is unit: the Rows owns one Res and closing it is enough. A
// discarded Result[bool] from the Res close is freed at once.
pub fn (mut r: &Rows) close() {
    r.h.close()
}

// ------------------------------------------------------- library/result info

pub fn lib_version(): int {
    return lib_version_native()
}

// PQmakeEmptyPGresult(NULL, status) + PQclear. A NULL result from libpq is a
// contract violation and the own result traps with exit 11 (design 5.1).
pub fn make_empty_rows(status: int): Result[Rows] {
    if status < 0 || status > PGRES_PIPELINE_ABORTED {
        return err("invalid result status", 2)
    }
    let res = make_empty_result(status)
    return ok(new Rows{h: res, fmt: 0})
}
