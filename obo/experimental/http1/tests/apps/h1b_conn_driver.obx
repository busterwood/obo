fn modeBackpressure() {
    let made = setupSmall("GET / HTTP/1.1\r\nHost: x\r\n\r\n")
    match made {
        ok(c) {
            let now = nowAt(1)
            start(c, &now)
            let b = conn::beginResponse(c, 200, &now)
            let s = conn::setLength(c, 400)
            let w1 = conn::writeText(c, "x", 0, 1)
            match w1 { ok(n) { println("W1 ", n) } err(m, code) { println("W1ERR ", code) } }
            let w2 = conn::writeText(c, "x", 0, 1)
            match w2 { ok(n) { println("W2 ", n) } err(m, code) { println("W2ERR ", code) } }
            let e = conn::endResponse(c, &now)
            match e { ok(v) { println("END ", v) } err(m, code) { println("EERR ", code) } }
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}

fn modeTimeoutHeader() {
    let made = setup("GET / HTTP/1.1\r\n")
    match made {
        ok(c) {
            let now = nowAt(1)
            let e1 = conn::next(c, &now)
            match e1 { ok(ev) { println("EV ", evName(&ev)) } err(m, code) { println("ERR ", code, " ", m) } }
            let a = conn::acceptAlpn(c)
            let e2 = conn::next(c, &now)
            match e2 { ok(ev) { println("EV ", evName(&ev)) } err(m, code) { println("ERR ", code, " ", m) } }
            let late = nowAt(20000)
            let e3 = conn::next(c, &late)
            match e3 { ok(ev) { println("EV ", evName(&ev)) } err(m, code) { println("ERR ", code, " ", m) } }
            showFlush(conn::flush(c, &late))
            out(c)
            let e4 = conn::next(c, &late)
            match e4 { ok(ev) { println("EV4 ", evName(&ev)) } err(m, code) { println("ERR4 ", code, " ", m) } }
            let e5 = conn::next(c, &late)
            match e5 { ok(ev) { println("EV5 ", evName(&ev)) } err(m, code) { println("ERR5 ", code, " ", m) } }
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}

