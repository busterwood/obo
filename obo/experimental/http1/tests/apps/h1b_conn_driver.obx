// H1b deterministic connection driver. Not public API.
import "http1core.obx" as core
import "http1conn.obx" as conn
import "http1transport.obx" as tr
import "sysclock.obx" as clock

fn mk(s: string): []byte {
    let out = new []byte(len(s))
    for i in 0..len(s) { out[i] = s[i] }
    return out
}

fn hexBytes(b: &[]byte): string {
    let digits = "0123456789abcdef"
    var out = new []byte(0)
    for i in 0..len(b) {
        let v = int(b[i])
        append(out, digits[(v / 16) % 16])
        append(out, digits[v % 16])
    }
    return string(out)
}

fn nowAt(ms: int): conn::Now {
    return new conn::Now{mono: new clock::Instant{nanos: ms * 1000000},
                         wall: new clock::Timestamp{seconds: 0, nanos: 0}}
}

fn evName(e: &conn::Event): string {
    match e {
        HandshakeDone { return "handshake" }
        NeedRead { return "needread" }
        NeedWrite { return "needwrite" }
        HeadReady { return "head" }
        ResponseComplete { return "complete" }
        TimedOut { return "timedout" }
        ProtocolError { return "protocol:" + string(e.status) }
        ConnectionClosed { return "closed" }
    }
}

fn phaseName(p: &conn::Phase): string {
    match p {
        Handshaking { return "handshaking" }
        Idle { return "idle" }
        ReadingHead { return "readinghead" }
        ReadingBody { return "readingbody" }
        Responding { return "responding" }
        Draining { return "draining" }
        Closing { return "closing" }
        Closed { return "closed" }
    }
}

fn flushName(f: &conn::FlushOutcome): string {
    match f {
        Flushed { return "flushed" }
        FlushWantRead { return "wantread" }
        FlushWantWrite { return "wantwrite" }
    }
}

fn bodyName(b: &conn::BodyRead): string {
    match b {
        BodyData { return "data:" + hexBytes(&b.bytes) }
        BodyEnd { return "end" }
        BodyNeedRead { return "needread" }
    }
}

fn show(r: Result[conn::Event]) {
    match r {
        ok(e) { println("EV ", evName(&e)) }
        err(m, c) { println("ERR ", c, " ", m) }
    }
}

fn showFlush(r: Result[conn::FlushOutcome]) {
    match r {
        ok(f) { println("FL ", flushName(&f)) }
        err(m, c) { println("FERR ", c) }
    }
}

fn showBody(r: Result[conn::BodyRead]) {
    match r {
        ok(b) { println("BD ", bodyName(&b)) }
        err(m, c) { println("BERR ", c, " ", m) }
    }
}

fn out(mut c: &conn::Connection) {
    let r = conn::memoryOutput(c)
    match r {
        ok(b) { println("OUT ", hexBytes(&b)) }
        err(m, code) { println("OUTERR ", code) }
    }
    let cl = conn::memoryClearOutput(c)
    match cl { ok(v) { } err(m, c2) { } }
}

fn setup(req: string): Result[conn::Connection] {
    let bytes = mk(req)
    let t = tr::memory(&bytes)
    let lim = core::defaultLimits()
    let c = try conn::make(t, &lim)
    let w = try conn::memorySetWriteLimit(c, 65536)
    return ok(c)
}

fn setupSmall(req: string): Result[conn::Connection] {
    let bytes = mk(req)
    let t = tr::memory(&bytes)
    var lim = core::defaultLimits()
    lim.maxStartLine = 256
    lim.maxTarget = 128
    lim.maxHeaderBytes = 512
    lim.maxHeaderCount = 5
    lim.maxHeaderLine = 256
    lim.maxBody = 16
    lim.maxChunkLine = 64
    lim.maxChunkSize = 16
    lim.maxChunkCount = 5
    lim.maxChunkMetadata = 128
    lim.maxTrailerBytes = 64
    lim.maxTrailerCount = 2
    lim.maxResponseHeaderBytes = 256
    lim.maxResponseBuffer = 256
    lim.maxResponseTrailerCount = 2
    lim.maxResponseTrailerBytes = 64
    lim.maxPipelineBytes = 512
    lim.maxRequests = 2
    let c = try conn::make(t, &lim)
    let w = try conn::memorySetWriteLimit(c, 65536)
    return ok(c)
}

fn start(mut c: &conn::Connection, now: &conn::Now): bool {
    let e1 = conn::next(c, now)
    match e1 { ok(ev) { println("EV ", evName(&ev)) } err(m, code) { println("ERR ", code, " ", m) } }
    let a = conn::acceptAlpn(c)
    match a { ok(v) { println("ALPN ", v) } err(m, code) { println("ALPNERR ", code) } }
    var guard = 0
    while guard < 200 {
        guard += 1
        let e2 = conn::next(c, now)
        match e2 {
            ok(ev) {
                println("EV ", evName(&ev))
                match ev {
                    NeedRead { }
                    NeedWrite { }
                    HeadReady { return true }
                    HandshakeDone { }
                    ResponseComplete { return true }
                    TimedOut { return true }
                    ProtocolError { return true }
                    ConnectionClosed { return true }
                }
            }
            err(m, code) { println("ERR ", code, " ", m); return true }
        }
    }
    return true
}

fn respondText(mut c: &conn::Connection, text: string, length: bool, now: &conn::Now) {
    let b1 = conn::beginResponse(c, 200, now)
    match b1 { ok(v) { } err(m, code) { println("BEGERR ", code) } }
    if length {
        let s = conn::setLength(c, len(text))
        match s { ok(v) { } err(m, code) { println("LENERR ", code) } }
    }
    let w = conn::writeText(c, text, 0, len(text))
    match w { ok(n) { println("WR ", n) } err(m, code) { println("WERR ", code) } }
    let e = conn::endResponse(c, now)
    match e { ok(v) { println("END ", v) } err(m, code) { println("EERR ", code) } }
    var guard = 0
    while guard < 200 {
        guard += 1
        let f = conn::flush(c, now)
        match f {
            ok(fl) {
                match fl {
                    Flushed {
                        println("FL flushed")
                        break
                    }
                    FlushWantRead { println("FL wantread") }
                    FlushWantWrite { println("FL wantwrite") }
                }
            }
            err(m, code) { println("FERR ", code); break }
        }
    }
    out(c)
}

fn modeBasic() {
    let made = setup("GET / HTTP/1.1\r\nHost: x\r\n\r\n")
    match made {
        ok(c) {
            let now = nowAt(1)
            start(c, &now)
            let info = conn::requestInfo(c)
            match info { ok(i) { println("REQ ", i.method, " ", i.path) } err(m, code) { } }
            let ct = conn::setHeader(c, "Content-Type", "text/plain")
            match ct { ok(v) { } err(m, code) { println("HERR ", code) } }
            respondText(c, "hello", true, &now)
            let e3 = conn::next(c, &now)
            match e3 { ok(ev) { println("EV ", evName(&ev)) } err(m, code) { println("ERR ", code, " ", m) } }
            let p = conn::phase(c)
            println("PH ", phaseName(&p))
            println("N ", conn::requestCount(c))
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}

fn modeKeepalive() {
    let made = setup("GET /a HTTP/1.1\r\nHost: x\r\n\r\nGET /b HTTP/1.1\r\nHost: x\r\n\r\n")
    match made {
        ok(c) {
            let now = nowAt(1)
            start(c, &now)
            respondText(c, "A", true, &now)
            let e3 = conn::next(c, &now)
            match e3 { ok(ev) { println("EV ", evName(&ev)) } err(m, code) { println("ERR ", code, " ", m) } }
            let e4 = conn::next(c, &now)
            match e4 { ok(ev) { println("EV ", evName(&ev)) } err(m, code) { println("ERR ", code, " ", m) } }
            let info = conn::requestInfo(c)
            match info { ok(i) { println("REQ2 ", i.path) } err(m, code) { } }
            respondText(c, "B", true, &now)
            let e5 = conn::next(c, &now)
            match e5 { ok(ev) { println("EV ", evName(&ev)) } err(m, code) { println("ERR ", code, " ", m) } }
            println("N ", conn::requestCount(c))
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}

fn modeHead() {
    let made = setup("HEAD /x HTTP/1.1\r\nHost: x\r\n\r\n")
    match made {
        ok(c) {
            let now = nowAt(1)
            start(c, &now)
            let b = conn::beginResponse(c, 200, &now)
            let l = conn::setLength(c, 5)
            match l { ok(v) { } err(m, code) { println("LENERR ", code) } }
            let w = conn::writeText(c, "hello", 0, 5)
            match w { ok(n) { println("WR ", n) } err(m, code) { println("WERR ", code) } }
            let e = conn::endResponse(c, &now)
            match e { ok(v) { println("END ", v) } err(m, code) { println("EERR ", code) } }
            showFlush(conn::flush(c, &now))
            out(c)
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}

fn modeFixed() {
    let made = setup("POST /x HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhello")
    match made {
        ok(c) {
            let now = nowAt(1)
            start(c, &now)
            showBody(conn::readBody(c, 3, &now))
            showBody(conn::readBody(c, 10, &now))
            showBody(conn::readBody(c, 10, &now))
            respondText(c, "ok", true, &now)
            let e = conn::next(c, &now)
            match e { ok(ev) { println("EV ", evName(&ev)) } err(m, code) { println("ERR ", code, " ", m) } }
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}

fn modeChunked() {
    let made = setup("POST /x HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n")
    match made {
        ok(c) {
            let now = nowAt(1)
            start(c, &now)
            showBody(conn::readBody(c, 10, &now))
            showBody(conn::readBody(c, 10, &now))
            respondText(c, "ok", true, &now)
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}

fn modeContinue() {
    let made = setup("POST /x HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nExpect: 100-continue\r\n\r\n")
    match made {
        ok(c) {
            let now = nowAt(1)
            start(c, &now)
            out(c)
            showBody(conn::readBody(c, 5, &now))
            out(c)
            let more = mk("hello")
            let a = conn::memoryAppendInput(c, &more)
            showBody(conn::readBody(c, 5, &now))
            showBody(conn::readBody(c, 5, &now))
            respondText(c, "ok", true, &now)
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}

fn modeContinueEarlyFinal() {
    let made = setup("POST /x HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nExpect: 100-continue\r\n\r\n")
    match made {
        ok(c) {
            let now = nowAt(1)
            start(c, &now)
            let b = conn::beginResponse(c, 413, &now)
            match b { ok(v) { } err(m, code) { println("BEGERR ", code) } }
            let e = conn::endResponse(c, &now)
            match e { ok(v) { println("END ", v) } err(m, code) { println("EERR ", code) } }
            showFlush(conn::flush(c, &now))
            out(c)
            println("CLOSE ", conn::closeAfterResponse(c))
            showBody(conn::readBody(c, 5, &now))
            let e2 = conn::next(c, &now)
            match e2 { ok(ev) { println("EV ", evName(&ev)) } err(m, code) { println("ERR ", code, " ", m) } }
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}

fn modeUnread() {
    let made = setup("POST /x HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhelloGET /y HTTP/1.1\r\nHost: x\r\n\r\n")
    match made {
        ok(c) {
            let now = nowAt(1)
            start(c, &now)
            respondText(c, "ok", true, &now)
            let e = conn::next(c, &now)
            match e { ok(ev) { println("EV ", evName(&ev)) } err(m, code) { println("ERR ", code, " ", m) } }
            println("N ", conn::requestCount(c))
            let rc = conn::requestClose(c)
            match rc { ok(v) { println("RC ", v) } err(m, code) { println("RCERR ", code) } }
            let e2 = conn::next(c, &now)
            match e2 { ok(ev) { println("EV ", evName(&ev)) } err(m, code) { println("ERR ", code, " ", m) } }
            println("N2 ", conn::requestCount(c))
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}

