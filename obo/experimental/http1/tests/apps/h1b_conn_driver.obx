fn modeIdleTimeout() {
    let made = setup("GET / HTTP/1.1\r\nHost: x\r\n\r\n")
    match made {
        ok(c) {
            let now = nowAt(1)
            start(c, &now)
            respondText(c, "ok", true, &now)
            let e = conn::next(c, &now)
            match e { ok(ev) { println("EV ", evName(&ev)) } err(m, code) { println("ERR ", code, " ", m) } }
            let late = nowAt(70000)
            let e2 = conn::next(c, &late)
            match e2 { ok(ev) { println("EV2 ", evName(&ev)) } err(m, code) { println("ERR2 ", code, " ", m) } }
            let p = conn::phase(c)
            println("PH ", phaseName(&p))
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}

fn modeXfer() {
    let made = setupXfer4("GET /this-is-a-long-path HTTP/1.1\r\nHost: x\r\nX-Long: 0123456789abcdef\r\n\r\n")
    match made {
        ok(c) {
            let now = nowAt(1)
            start(c, &now)
            respondText(c, "0123456789", true, &now)
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}

fn modeNoAlpnForbidden() {
    let bytes = mk("")
    let t = tr::memory(&bytes)
    var lim = core::defaultLimits()
    lim.allowNoAlpn = false
    let made = conn::make(t, &lim)
    match made {
        ok(c) {
            let sec = conn::memorySetSecure(c, true)
            let now = nowAt(1)
            let e1 = conn::next(c, &now)
            match e1 { ok(ev) { println("EV ", evName(&ev)) } err(m, code) { println("ERR ", code) } }
            let a = conn::acceptAlpn(c)
            match a { ok(v) { println("ALPN ", v) } err(m, code) { println("ALPNERR ", code) } }
            let n = conn::next(c, &now)
            match n { ok(ev) { println("EV2 ", evName(&ev)) } err(m, code) { println("ERR2 ", code) } }
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}


fn modeEndFalse() {
    let made = setupSmall("GET / HTTP/1.1\r\nHost: x\r\n\r\n")
    match made {
        ok(c) {
            let now = nowAt(1)
            start(c, &now)
            let names = new []string(0)
            append(names, "X-Long")
            let st = conn::setTrailerNames(c, &names)
            let b = conn::beginResponse(c, 200, &now)
            var guard = 0
            while guard < 50 {
                guard += 1
                let w = conn::writeText(c, "0123456789abcdef", 0, 16)
                match w {
                    ok(n) { if n == 0 { break } }
                    err(m, code) { println("WERR ", code); break }
                }
            }
            let t = conn::addTrailer(c, "X-Long", "0123456789012345678901234567890123456789")
            match t { ok(v) { println("TRAILER ", v) } err(m, code) { println("TRAILERERR ", code) } }
            let e1 = conn::endResponse(c, &now)
            match e1 { ok(v) { println("END1 ", v) } err(m, code) { println("END1ERR ", code) } }
            showFlush(conn::flush(c, &now))
            let e2 = conn::endResponse(c, &now)
            match e2 { ok(v) { println("END2 ", v) } err(m, code) { println("END2ERR ", code) } }
            showFlush(conn::flush(c, &now))
            out(c)
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}


fn setupNoAuto(req: string): Result[conn::Connection] {
    let bytes = mk(req)
    let t = tr::memory(&bytes)
    var lim = core::defaultLimits()
    lim.autoContinue = false
    let c = try conn::make(t, &lim)
    let w = try conn::memorySetWriteLimit(c, 65536)
    return ok(c)
}

fn modeDiscard() {
    let made = setup("POST /x HTTP/1.1\r\nHost: x\r\nContent-Length: 10\r\n\r\n0123456789")
    match made {
        ok(c) {
            let now = nowAt(1)
            start(c, &now)
            let d = conn::discardBody(c, 1000, &now)
            match d { ok(v) { println("DISCARD ", v) } err(m, code) { println("DISCARDERR ", code) } }
            respondText(c, "ok", true, &now)
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}

fn modeManualContinue() {
    let made = setupNoAuto("POST /x HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nExpect: 100-continue\r\n\r\n")
    match made {
        ok(c) {
            let now = nowAt(1)
            start(c, &now)
            showBody(conn::readBody(c, 5, &now))
            out(c)
            let sc = conn::sendContinue(c)
            match sc { ok(v) { println("SENDCONT ", v) } err(m, code) { println("SENDCONT ", code) } }
            showFlush(conn::flush(c, &now))
            out(c)
            let more = mk("hello")
            let a = conn::memoryAppendInput(c, &more)
            showBody(conn::readBody(c, 5, &now))
            showBody(conn::readBody(c, 5, &now))
            respondText(c, "ok", true, &now)
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}


fn modeSecondDeadline() {
    let made = setup("GET /a HTTP/1.1\r\nHost: x\r\n\r\nGET /b HTTP/1.1\r\nHost: x\r\n")
    match made {
        ok(c) {
            let now = nowAt(1)
            start(c, &now)
            respondText(c, "A", true, &now)
            let e3 = conn::next(c, &now)
            match e3 { ok(ev) { println("EV3 ", evName(&ev)) } err(m, code) { println("ERR3 ", code, " ", m) } }
            let e4 = conn::next(c, &now)
            match e4 { ok(ev) { println("EV4 ", evName(&ev)) } err(m, code) { println("ERR4 ", code, " ", m) } }
            let d = conn::deadline(c)
            if d.finite { println("DL ", d.nanos / 1000000) } else { println("DL forever") }
            let p = conn::phase(c)
            println("PH ", phaseName(&p))
            let late = nowAt(15000)
            let e5 = conn::next(c, &late)
            match e5 { ok(ev) { println("EV5 ", evName(&ev)) } err(m, code) { println("ERR5 ", code, " ", m) } }
            showFlush(conn::flush(c, &late))
            out(c)
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}


fn modeCloseHead() {
    let made = setup("GET / HTTP/1.1\r\nHo")
    match made {
        ok(c) {
            let now = nowAt(1)
            let e1 = conn::next(c, &now)
            let a = conn::acceptAlpn(c)
            let e2 = conn::next(c, &now)
            match e2 { ok(ev) { println("EV2 ", evName(&ev)) } err(m, code) { println("ERR2 ", code) } }
            let rc = conn::requestClose(c)
            match rc { ok(v) { println("RC ", v) } err(m, code) { println("RCERR ", code) } }
            let rest = mk("st: x\r\n\r\n")
            let ap = conn::memoryAppendInput(c, &rest)
            var guard = 0
            while guard < 20 {
                guard += 1
                let e = conn::next(c, &now)
                match e {
                    ok(ev) {
                        println("EV ", evName(&ev))
                        match ev {
                            HeadReady { guard = 20 }
                            NeedRead { }
                            NeedWrite { }
                            HandshakeDone { }
                            ResponseComplete { guard = 20 }
                            TimedOut { guard = 20 }
                            ProtocolError { guard = 20 }
                            ConnectionClosed { guard = 20 }
                        }
                    }
                    err(m, code) { println("ERR ", code); guard = 20 }
                }
            }
            respondText(c, "ok", true, &now)
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}


fn modeTimeoutStarted() {
    let made = setup("POST /x HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhe")
    match made {
        ok(c) {
            let now = nowAt(1)
            start(c, &now)
            let b = conn::beginResponse(c, 200, &now)
            let w = conn::writeText(c, "x", 0, 1)
            showBody(conn::readBody(c, 5, &now))
            let late = nowAt(40000)
            showBody(conn::readBody(c, 5, &late))
            var guard = 0
            while guard < 5 {
                guard += 1
                let e = conn::next(c, &late)
                match e {
                    ok(ev) {
                        println("EV ", evName(&ev))
                        match ev {
                            TimedOut { println("REPEAT_TIMEOUT") }
                            ConnectionClosed { guard = 5 }
                            ProtocolError { guard = 5 }
                            HandshakeDone { }
                            NeedRead { }
                            NeedWrite { }
                            HeadReady { }
                            ResponseComplete { }
                        }
                    }
                    err(m, code) { println("ERR ", code); guard = 5 }
                }
            }
            let p = conn::phase(c)
            println("PH ", phaseName(&p))
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}

fn main() {
    let args = args()
    var mode = "basic"
    if len(args) > 1 { mode = args[1] }
    if mode == "basic" { modeBasic() }
    if mode == "keepalive" { modeKeepalive() }
    if mode == "head" { modeHead() }
    if mode == "fixed" { modeFixed() }
    if mode == "chunked" { modeChunked() }
    if mode == "continue" { modeContinue() }
    if mode == "continue_early" { modeContinueEarlyFinal() }
    if mode == "unread" { modeUnread() }
    if mode == "limits" { modeLimits() }
    if mode == "bigbody" { modeBigBody() }
    if mode == "injection" { modeInjection() }
    if mode == "backpressure" { modeBackpressure() }
    if mode == "timeout_header" { modeTimeoutHeader() }
    if mode == "timeout_accept" { modeTimeoutAccept() }
    if mode == "h2" { modeH2() }
    if mode == "alpn_required" { modeAlpnRequired() }
    if mode == "close" { modeClose() }
    if mode == "errors" { modeErrors() }
    if mode == "rules" { modeRules() }
    if mode == "trailers" { modeTrailers() }
    if mode == "http10" { modeHttp10() }
    if mode == "nopipe" { modeNoPipe() }
    if mode == "maxreq1" { modeMaxReq1() }
    if mode == "timeout_body" { modeTimeoutBody() }
    if mode == "idle_timeout" { modeIdleTimeout() }
    if mode == "xfer" { modeXfer() }
    if mode == "noalpn" { modeNoAlpnForbidden() }
    if mode == "endfalse" { modeEndFalse() }
    if mode == "discard" { modeDiscard() }
    if mode == "second_deadline" { modeSecondDeadline() }
    if mode == "close_head" { modeCloseHead() }
    if mode == "timeout_started" { modeTimeoutStarted() }
    if mode == "manual_continue" { modeManualContinue() }
}
