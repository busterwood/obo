fn modeClose() {
    let made = setup("GET / HTTP/1.1\r\nHost: x\r\n\r\n")
    match made {
        ok(c) {
            let a = conn::close(c)
            match a { ok(v) { println("C1 ", v) } err(m, code) { println("C1ERR ", code) } }
            let b = conn::close(c)
            match b { ok(v) { println("C2 ", v) } err(m, code) { println("C2ERR ", code) } }
            let mc = conn::memoryClosed(c)
            match mc { ok(v) { println("MC ", v) } err(m, code) { } }
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}


fn setupHttp10(req: string): Result[conn::Connection] {
    let bytes = mk(req)
    let t = tr::memory(&bytes)
    var lim = core::defaultLimits()
    lim.allowHttp10 = true
    let c = try conn::make(t, &lim)
    let w = try conn::memorySetWriteLimit(c, 65536)
    return ok(c)
}

fn setupNoPipe(req: string): Result[conn::Connection] {
    let bytes = mk(req)
    let t = tr::memory(&bytes)
    var lim = core::defaultLimits()
    lim.pipelining = false
    let c = try conn::make(t, &lim)
    let w = try conn::memorySetWriteLimit(c, 65536)
    return ok(c)
}

fn setupMaxReq1(req: string): Result[conn::Connection] {
    let bytes = mk(req)
    let t = tr::memory(&bytes)
    var lim = core::defaultLimits()
    lim.maxRequests = 1
    let c = try conn::make(t, &lim)
    let w = try conn::memorySetWriteLimit(c, 65536)
    return ok(c)
}

fn setupXfer4(req: string): Result[conn::Connection] {
    let bytes = mk(req)
    let t = tr::memory(&bytes)
    let lim = core::defaultLimits()
    let c = try conn::make(t, &lim)
    let w = try conn::memorySetWriteLimit(c, 65536)
    let x = try conn::memorySetReadLimit(c, 3)
    let m = try conn::memorySetWriteLimit(c, 4)
    return ok(c)
}

fn showErrPage(req: string, small: bool) {
    var made: Result[conn::Connection] = setup(req)
    if small { made = setupSmall(req) }
    match made {
        ok(c) {
            let now = nowAt(1)
            let e1 = conn::next(c, &now)
            match e1 { ok(ev) { println("EV ", evName(&ev)) } err(m, code) { println("ERR ", code, " ", m) } }
            let a = conn::acceptAlpn(c)
            match a { ok(v) { } err(m, code) { println("ALPNERR ", code) } }
            let e2 = conn::next(c, &now)
            match e2 { ok(ev) { println("EV ", evName(&ev)) } err(m, code) { println("ERR ", code, " ", m) } }
            showFlush(conn::flush(c, &now))
            out(c)
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}

fn modeErrors() {
    showErrPage("BAD\r\n\r\n", false)
    showErrPage("GET /" + "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa HHTP/1.1\r\nHost: x\r\n\r\n", true)
    showErrPage("GET / HTTP/1.1\r\nHost: x\r\nA: 1\r\nB: 2\r\nC: 3\r\nD: 4\r\nE: 5\r\n\r\n", true)
    showErrPage("TRACE / HTTP/1.1\r\nHost: x\r\n\r\n", false)
    showErrPage("GET / HTTP/2.0\r\nHost: x\r\n\r\n", false)
    showErrPage("GET / HTTP/1.1\r\nHost: x\r\nExpect: something\r\n\r\n", false)
    showErrPage("POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 17\r\n\r\n", true)
}

fn modeRules() {
    let made = setup("GET / HTTP/1.1\r\nHost: x\r\n\r\n")
    match made {
        ok(c) {
            let now = nowAt(1)
            start(c, &now)
            let b = conn::beginResponse(c, 204, &now)
            let l = conn::setLength(c, 5)
            match l { ok(v) { println("L204 ", v) } err(m, code) { println("L204ERR ", code) } }
            let e = conn::endResponse(c, &now)
            match e { ok(v) { println("E204 ", v) } err(m, code) { println("E204ERR ", code) } }
            showFlush(conn::flush(c, &now))
            out(c)
        }
        err(m, code) { println("MAKEERR ", code) }
    }
    let made2 = setup("GET / HTTP/1.1\r\nHost: x\r\n\r\n")
    match made2 {
        ok(c) {
            let now = nowAt(1)
            start(c, &now)
            let b = conn::beginResponse(c, 304, &now)
            let l = conn::setLength(c, 9)
            let e = conn::endResponse(c, &now)
            match e { ok(v) { println("E304 ", v) } err(m, code) { println("E304ERR ", code) } }
            showFlush(conn::flush(c, &now))
            out(c)
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}

fn modeTrailers() {
    let made = setup("GET / HTTP/1.1\r\nHost: x\r\n\r\n")
    match made {
        ok(c) {
            let now = nowAt(1)
            start(c, &now)
            let names = new []string(0)
            append(names, "X-Sum")
            let st = conn::setTrailerNames(c, &names)
            match st { ok(v) { } err(m, code) { println("TERR ", code) } }
            let b = conn::beginResponse(c, 200, &now)
            let w = conn::writeText(c, "abc", 0, 3)
            let t = conn::addTrailer(c, "X-Sum", "1")
            match t { ok(v) { println("TRAILER ", v) } err(m, code) { println("TRAILERERR ", code) } }
            let e = conn::endResponse(c, &now)
            match e { ok(v) { println("ET ", v) } err(m, code) { println("ETERR ", code) } }
            showFlush(conn::flush(c, &now))
            out(c)
        }
        err(m, code) { println("MAKEERR ", code) }
    }
}

