// Experimental HTTP/1.1 byte transport seam (H1c).
//
// Status: experimental and unstable. This module is the concrete H1c seam from
// obo/design/http1-server-design.md section 4.3 and section 11.5. It imports
// both `sysstream` and `systls`; `systls` never imports HTTP.
//
// The seam is a closed concrete dispatch record with three backends:
//
//     Plain  -- an owned sysstream::Stream (loopback TCP/Unix tests)
//     Tls    -- an owned systls::TlsSession (HTTPS)
//     Memory -- the deterministic socket-free test transport
//
// obo 0.14 has no impure interface-member tier, so an interface method could not
// call `stream::readSome` or `tls::readSome`. This record is therefore the
// 0.14-compatible concrete dispatch: every operation is an ordinary module
// function over an owned value, with no function value, callback, fd or native
// token exposed. The observable contract is unchanged: owned read bytes,
// accepted-prefix writes, Want* control flow, multi-step shutdown, ALPN/secure
// metadata, maxTransfer and no hidden retry.
//
// A transport owns exactly one backend. `Plain` owns a Stream, `Tls` owns a
// TlsSession, and `Memory` owns no native object. `close` is abortive and
// exactly once; clean TLS close is the multi-step `shutdownStep` path.
module http1io

import "syserrors.obx" as errors
import "sysplatform.obx" as platform
import "sysreactor.obx" as reactor
import "sysstream.obx" as stream
import "systls.obx" as tls

pub type Step = closed {
    StepDone {}
    StepWantRead {}
    StepWantWrite {}
}

pub type ReadOutcome = closed {
    ReadData { bytes: []byte }
    ReadEof {}
    ReadWantRead {}
    ReadWantWrite {}
}

pub type WriteOutcome = closed {
    WriteWrote { count: int }
    WriteWantRead {}
    WriteWantWrite {}
}

pub type ShutdownOutcome = closed {
    ShutdownDone {}
    ShutdownSent {}
    ShutdownPeerClosed {}
    ShutdownWantRead {}
    ShutdownWantWrite {}
}

pub type Want = closed {
    WantNone {}
    WantRead {}
    WantWrite {}
    WantReadWrite {}
}

pub type Alpn = closed {
    AlpnNone {}
    AlpnHttp11 {}
    AlpnH2 {}
    AlpnOther { name: string }
}

pub const MAX_TRANSFER = 65536
pub const KIND_PLAIN = 1
pub const KIND_MEMORY = 2
pub const KIND_TLS = 3

const W_NONE = 0
const W_READ = 1
const W_WRITE = 2
const W_BOTH = 3

const A_NONE = 0
const A_HTTP11 = 1
const A_H2 = 2
const A_OTHER = 3

// The representation is private. Applications construct a transport only with
// plain(), fromTls() or memory(); every entry point revalidates the record.
pub type Transport = ref record {
    kind: int
    s: stream::Stream
    session: ?tls::TlsSession
    shut: bool
    inBytes: []byte
    inPos: int
    outBytes: []byte
    readLimit: int
    writeLimit: int
    readable: bool
    eof: bool
    pendingBytes: int
    pendingLimit: int
    wantMode: int
    secure: bool
    alpnKind: int
    alpnName: string
    maxXfer: int
    readCount: int
    writeCount: int
}

fn libCode(k: errors::Kind): int {
    return errors::code(&k)
}

fn invalidArgument(): int { return libCode(new errors::InvalidArgument{}) }
fn unsupported(): int { return libCode(new errors::Unsupported{}) }

fn placeholderStream(): stream::Stream {
    return new stream::Stream{res: new platform::Resource{reserved: 0}}
}

// Internal placeholder used while an owned transport is moved into a local for
// one native call. It performs no I/O and owns no native object.
pub fn empty(): Transport {
    return new Transport{
        kind: KIND_MEMORY,
        s: placeholderStream(),
        session: nil,
        shut: true,
        inBytes: new []byte(0),
        inPos: 0,
        outBytes: new []byte(0),
        readLimit: 0,
        writeLimit: 0,
        readable: false,
        eof: true,
        pendingBytes: 0,
        pendingLimit: 0,
        wantMode: W_NONE,
        secure: false,
        alpnKind: A_NONE,
        alpnName: "",
        maxXfer: MAX_TRANSFER,
        readCount: 0,
        writeCount: 0
    }
}

fn memoryRecord(input: &[]byte): Transport {
    let copy = new []byte(len(input))
    for i in 0..len(input) { copy[i] = input[i] }
    return new Transport{
        kind: KIND_MEMORY,
        s: placeholderStream(),
        session: nil,
        shut: false,
        inBytes: copy,
        inPos: 0,
        outBytes: new []byte(0),
        readLimit: 0,
        writeLimit: 0,
        readable: true,
        eof: false,
        pendingBytes: 0,
        pendingLimit: 0,
        wantMode: W_NONE,
        secure: false,
        alpnKind: A_NONE,
        alpnName: "",
        maxXfer: MAX_TRANSFER,
        readCount: 0,
        writeCount: 0
    }
}

pub fn plain(s: stream::Stream): Transport {
    return new Transport{
        kind: KIND_PLAIN,
        s: s,
        session: nil,
        shut: false,
        inBytes: new []byte(0),
        inPos: 0,
        outBytes: new []byte(0),
        readLimit: 0,
        writeLimit: 0,
        readable: true,
        eof: false,
        pendingBytes: 0,
        pendingLimit: 0,
        wantMode: W_NONE,
        secure: false,
        alpnKind: A_NONE,
        alpnName: "",
        maxXfer: MAX_TRANSFER,
        readCount: 0,
        writeCount: 0
    }
}

// Wrap an already-created systls::TlsSession. The transport takes ownership of
// the session and closes it exactly once. The caller must not keep or close a
// second alias for the same session.
pub fn fromTls(session: tls::TlsSession): Transport {
    return new Transport{
        kind: KIND_TLS,
        s: placeholderStream(),
        session: session,
        shut: false,
        inBytes: new []byte(0),
        inPos: 0,
        outBytes: new []byte(0),
        readLimit: 0,
        writeLimit: 0,
        readable: true,
        eof: false,
        pendingBytes: 0,
        pendingLimit: 0,
        wantMode: W_NONE,
        secure: true,
        alpnKind: A_NONE,
        alpnName: "",
        maxXfer: MAX_TRANSFER,
        readCount: 0,
        writeCount: 0
    }
}

pub fn memory(input: &[]byte): Transport {
    return memoryRecord(input)
}

pub fn isPlain(t: &Transport): bool { return t.kind == KIND_PLAIN }
pub fn isMemory(t: &Transport): bool { return t.kind == KIND_MEMORY }
pub fn isTls(t: &Transport): bool { return t.kind == KIND_TLS }
pub fn memoryClosed(t: &Transport): bool { return t.shut }
pub fn memoryOutput(t: &Transport): Result[[]byte] {
    if t.kind != KIND_MEMORY {
        return err("transport is not a memory transport", invalidArgument())
    }
    let copy = new []byte(len(t.outBytes))
    for i in 0..len(t.outBytes) { copy[i] = t.outBytes[i] }
    return ok(copy)
}
pub fn memoryAppendInput(mut t: &Transport, bytes: &[]byte): Result[bool] {
    if t.kind != KIND_MEMORY {
        return err("transport is not a memory transport", invalidArgument())
    }
    for i in 0..len(bytes) { append(t.inBytes, bytes[i]) }
    return ok(true)
}

pub fn memoryClearOutput(mut t: &Transport): Result[bool] {
    if t.kind != KIND_MEMORY {
        return err("transport is not a memory transport", invalidArgument())
    }
    t.outBytes = new []byte(0)
    return ok(true)
}
pub fn memoryReadCount(t: &Transport): int { return t.readCount }
pub fn memoryWriteCount(t: &Transport): int { return t.writeCount }

pub fn memorySetReadLimit(mut t: &Transport, n: int): Result[bool] {
    if t.kind != KIND_MEMORY {
        return err("transport is not a memory transport", invalidArgument())
    }
    if n < 0 { return err("read limit is negative", invalidArgument()) }
    t.readLimit = n
    return ok(true)
}

pub fn memorySetWriteLimit(mut t: &Transport, n: int): Result[bool] {
    if t.kind != KIND_MEMORY {
        return err("transport is not a memory transport", invalidArgument())
    }
    if n < 0 { return err("write limit is negative", invalidArgument()) }
    t.writeLimit = n
    return ok(true)
}

pub fn memorySetReadable(mut t: &Transport, value: bool): Result[bool] {
    if t.kind != KIND_MEMORY {
        return err("transport is not a memory transport", invalidArgument())
    }
    t.readable = value
    return ok(true)
}

pub fn memorySetEof(mut t: &Transport, value: bool): Result[bool] {
    if t.kind != KIND_MEMORY {
        return err("transport is not a memory transport", invalidArgument())
    }
    t.eof = value
    return ok(true)
}

pub fn memorySetWant(mut t: &Transport, w: &Want): Result[bool] {
    if t.kind != KIND_MEMORY {
        return err("transport is not a memory transport", invalidArgument())
    }
    match w {
        WantNone { t.wantMode = W_NONE }
        WantRead { t.wantMode = W_READ }
        WantWrite { t.wantMode = W_WRITE }
        WantReadWrite { t.wantMode = W_BOTH }
    }
    return ok(true)
}

pub fn memorySetPending(mut t: &Transport, total: int, perFlush: int): Result[bool] {
    if t.kind != KIND_MEMORY {
        return err("transport is not a memory transport", invalidArgument())
    }
    if total < 0 || perFlush < 0 {
        return err("pending byte counts are negative", invalidArgument())
    }
    t.pendingBytes = total
    t.pendingLimit = perFlush
    return ok(true)
}

pub fn memorySetAlpn(mut t: &Transport, a: &Alpn): Result[bool] {
    if t.kind != KIND_MEMORY {
        return err("transport is not a memory transport", invalidArgument())
    }
    match a {
        AlpnNone { t.alpnKind = A_NONE; t.alpnName = "" }
        AlpnHttp11 { t.alpnKind = A_HTTP11; t.alpnName = "" }
        AlpnH2 { t.alpnKind = A_H2; t.alpnName = "" }
        AlpnOther { t.alpnKind = A_OTHER; t.alpnName = a.name }
    }
    return ok(true)
}

pub fn memorySetSecure(mut t: &Transport, value: bool): Result[bool] {
    if t.kind != KIND_MEMORY {
        return err("transport is not a memory transport", invalidArgument())
    }
    t.secure = value
    return ok(true)
}

pub fn memorySetMaxTransfer(mut t: &Transport, n: int): Result[bool] {
    if t.kind != KIND_MEMORY {
        return err("transport is not a memory transport", invalidArgument())
    }
    if n < 1 || n > MAX_TRANSFER {
        return err("maxTransfer is outside 1..65536", invalidArgument())
    }
    t.maxXfer = n
    return ok(true)
}

// Plain stream calls move the owned Stream briefly into a local because obo's
// conservative native-effect rule rejects a reference to a field of a borrowed
// record. One call, one bounded transfer; nothing is retained through the move.
fn plainRead(mut t: &Transport, max: int): Result[?[]byte] {
    let tmp = replace(t.s, placeholderStream())
    let outcome = stream::readSome(&tmp, max)
    t.s = tmp
    return outcome
}

fn plainWrite(mut t: &Transport, bytes: &[]byte, offset: int,
              count: int): Result[int] {
    let tmp = replace(t.s, placeholderStream())
    let outcome = stream::writeSome(&tmp, bytes, offset, count)
    t.s = tmp
    return outcome
}

fn plainShutdown(mut t: &Transport): Result[bool] {
    let tmp = replace(t.s, placeholderStream())
    let outcome = stream::shutdownWrite(&tmp)
    t.s = tmp
    return outcome
}

fn takeTls(mut t: &Transport): ?tls::TlsSession {
    return take(t.session)
}

fn restoreTls(mut t: &Transport, held: ?tls::TlsSession) {
    let old = replace(t.session, held)
    drop(old)
}

fn tlsRead(mut t: &Transport, max: int): Result[ReadOutcome] {
    let held = takeTls(t)
    if held == nil {
        return err("TLS transport has no session", invalidArgument())
    }
    let s: tls::TlsSession = held
    let outcome = tls::readSome(&s, max)
    restoreTls(t, s)
    match outcome {
        ok(v) {
            match v {
                ReadData {
                    // The systls outcome owns its array; copy the bytes into
                    // the HTTP outcome so the TLS outcome can be dropped.
                    let copy = new []byte(len(v.bytes))
                    for i in 0..len(v.bytes) { copy[i] = v.bytes[i] }
                    let data: ReadOutcome = new ReadData{bytes: copy}
                    return ok(data)
                }
                ReadEof {
                    let eof: ReadOutcome = new ReadEof{}
                    return ok(eof)
                }
                ReadWantRead {
                    let want: ReadOutcome = new ReadWantRead{}
                    return ok(want)
                }
                ReadWantWrite {
                    let want: ReadOutcome = new ReadWantWrite{}
                    return ok(want)
                }
            }
        }
        err(m, c) { return err(m, c) }
    }
}

fn tlsWrite(mut t: &Transport, bytes: &[]byte, offset: int,
            count: int): Result[WriteOutcome] {
    let held = takeTls(t)
    if held == nil {
        return err("TLS transport has no session", invalidArgument())
    }
    let s: tls::TlsSession = held
    let outcome = tls::writeSome(&s, bytes, offset, count)
    restoreTls(t, s)
    match outcome {
        ok(v) {
            match v {
                WriteWrote {
                    let wrote: WriteOutcome = new WriteWrote{count: v.count}
                    return ok(wrote)
                }
                WriteWantRead {
                    let want: WriteOutcome = new WriteWantRead{}
                    return ok(want)
                }
                WriteWantWrite {
                    let want: WriteOutcome = new WriteWantWrite{}
                    return ok(want)
                }
            }
        }
        err(m, c) { return err(m, c) }
    }
}

fn tlsFlush(mut t: &Transport): Result[WriteOutcome] {
    let held = takeTls(t)
    if held == nil {
        return err("TLS transport has no session", invalidArgument())
    }
    let s: tls::TlsSession = held
    let outcome = tls::flush(&s)
    restoreTls(t, s)
    match outcome {
        ok(v) {
            match v {
                FlushDone {
                    // `flush` reports progress, not an accepted plaintext
                    // count. The connection checks `pending` afterwards.
                    let done: WriteOutcome = new WriteWrote{count: 0}
                    return ok(done)
                }
                FlushWantWrite {
                    let want: WriteOutcome = new WriteWantWrite{}
                    return ok(want)
                }
            }
        }
        err(m, c) { return err(m, c) }
    }
}

fn tlsShutdown(mut t: &Transport): Result[ShutdownOutcome] {
    let held = takeTls(t)
    if held == nil {
        return err("TLS transport has no session", invalidArgument())
    }
    let s: tls::TlsSession = held
    let outcome = tls::shutdownStep(&s)
    restoreTls(t, s)
    match outcome {
        ok(v) {
            match v {
                ShutdownDone {
                    let out: ShutdownOutcome = new ShutdownDone{}
                    return ok(out)
                }
                ShutdownSent {
                    let out: ShutdownOutcome = new ShutdownSent{}
                    return ok(out)
                }
                ShutdownPeerClosed {
                    let out: ShutdownOutcome = new ShutdownPeerClosed{}
                    return ok(out)
                }
                ShutdownWantRead {
                    let out: ShutdownOutcome = new ShutdownWantRead{}
                    return ok(out)
                }
                ShutdownWantWrite {
                    let out: ShutdownOutcome = new ShutdownWantWrite{}
                    return ok(out)
                }
            }
        }
        err(m, c) { return err(m, c) }
    }
}

pub fn handshakeStep(mut t: &Transport): Result[Step] {
    if t.kind == KIND_PLAIN || t.kind == KIND_MEMORY {
        let done: Step = new StepDone{}
        return ok(done)
    }
    if t.kind != KIND_TLS {
        return err("transport kind is invalid", invalidArgument())
    }
    let held = takeTls(t)
    if held == nil {
        return err("TLS transport has no session", invalidArgument())
    }
    let s: tls::TlsSession = held
    let outcome = tls::handshakeStep(&s)
    restoreTls(t, s)
    match outcome {
        ok(v) {
            match v {
                StepDone {
                    let out: Step = new StepDone{}
                    return ok(out)
                }
                StepWantRead {
                    let out: Step = new StepWantRead{}
                    return ok(out)
                }
                StepWantWrite {
                    let out: Step = new StepWantWrite{}
                    return ok(out)
                }
            }
        }
        err(m, c) { return err(m, c) }
    }
}

pub fn readSome(mut t: &Transport, max: int): Result[ReadOutcome] {
    if max < 1 || max > t.maxXfer || max > MAX_TRANSFER {
        return err("readSome max is outside the transport transfer bound",
                   invalidArgument())
    }
    if t.shut { return err("transport is closed", invalidArgument()) }
    if t.kind == KIND_TLS {
        return tlsRead(t, max)
    }
    if t.kind == KIND_MEMORY {
        if !t.readable {
            let want: ReadOutcome = new ReadWantRead{}
            return ok(want)
        }
        t.readCount += 1
        if t.inPos >= len(t.inBytes) {
            if t.eof {
                let eof: ReadOutcome = new ReadEof{}
                return ok(eof)
            }
            let want: ReadOutcome = new ReadWantRead{}
            return ok(want)
        }
        var n = len(t.inBytes) - t.inPos
        if n > max { n = max }
        if t.readLimit > 0 && n > t.readLimit { n = t.readLimit }
        let out = new []byte(n)
        for i in 0..n { out[i] = t.inBytes[t.inPos + i] }
        t.inPos += n
        let data: ReadOutcome = new ReadData{bytes: out}
        return ok(data)
    }
    if t.kind != KIND_PLAIN {
        return err("transport kind is invalid", invalidArgument())
    }
    let data = plainRead(t, max)
    match data {
        ok(bytes) {
            if bytes == nil {
                let eof: ReadOutcome = new ReadEof{}
                return ok(eof)
            }
            let got: ReadOutcome = new ReadData{bytes: bytes}
            return ok(got)
        }
        err(m, code) {
            if errors::isWouldBlock(code) {
                let want: ReadOutcome = new ReadWantRead{}
                return ok(want)
            }
            return err(m, code)
        }
    }
}

pub fn writeSome(mut t: &Transport, bytes: &[]byte, offset: int,
                 count: int): Result[WriteOutcome] {
    if offset < 0 || count < 0 || offset > len(bytes) ||
       count > len(bytes) - offset {
        return err("writeSome source range is outside the array", invalidArgument())
    }
    if count > t.maxXfer || count > MAX_TRANSFER {
        return err("writeSome count is above maxTransfer", invalidArgument())
    }
    if t.shut { return err("transport is closed", invalidArgument()) }
    if count == 0 {
        let zero: WriteOutcome = new WriteWrote{count: 0}
        return ok(zero)
    }
    if t.kind == KIND_TLS {
        return tlsWrite(t, bytes, offset, count)
    }
    if t.kind == KIND_MEMORY {
        if t.writeLimit == 0 {
            let want: WriteOutcome = new WriteWantWrite{}
            return ok(want)
        }
        var n = count
        if t.writeLimit > 0 && n > t.writeLimit { n = t.writeLimit }
        for i in 0..n { append(t.outBytes, bytes[offset + i]) }
        t.writeCount += 1
        let wrote: WriteOutcome = new WriteWrote{count: n}
        return ok(wrote)
    }
    if t.kind != KIND_PLAIN {
        return err("transport kind is invalid", invalidArgument())
    }
    let n = plainWrite(t, bytes, offset, count)
    match n {
        ok(count_out) {
            let wrote: WriteOutcome = new WriteWrote{count: count_out}
            return ok(wrote)
        }
        err(m, code) {
            if errors::isWouldBlock(code) {
                let want: WriteOutcome = new WriteWantWrite{}
                return ok(want)
            }
            return err(m, code)
        }
    }
}

pub fn flushPending(mut t: &Transport): Result[WriteOutcome] {
    if t.kind == KIND_TLS {
        return tlsFlush(t)
    }
    if t.kind == KIND_MEMORY {
        if t.pendingBytes <= 0 {
            let zero: WriteOutcome = new WriteWrote{count: 0}
            return ok(zero)
        }
        var n = t.pendingBytes
        if t.pendingLimit > 0 && n > t.pendingLimit { n = t.pendingLimit }
        t.pendingBytes -= n
        let wrote: WriteOutcome = new WriteWrote{count: n}
        return ok(wrote)
    }
    if t.kind != KIND_PLAIN {
        return err("transport kind is invalid", invalidArgument())
    }
    let zero: WriteOutcome = new WriteWrote{count: 0}
    return ok(zero)
}

pub fn shutdownStep(mut t: &Transport): Result[ShutdownOutcome] {
    if t.shut {
        let peer: ShutdownOutcome = new ShutdownPeerClosed{}
        return ok(peer)
    }
    if t.kind == KIND_TLS {
        return tlsShutdown(t)
    }
    if t.kind == KIND_MEMORY {
        let done: ShutdownOutcome = new ShutdownDone{}
        return ok(done)
    }
    if t.kind != KIND_PLAIN {
        return err("transport kind is invalid", invalidArgument())
    }
    let sent_ok = plainShutdown(t)
    match sent_ok {
        ok(done) {
            if done {
                let sent: ShutdownOutcome = new ShutdownDone{}
                return ok(sent)
            }
            let peer: ShutdownOutcome = new ShutdownPeerClosed{}
            return ok(peer)
        }
        err(m, code) {
            if errors::isWouldBlock(code) {
                let want: ShutdownOutcome = new ShutdownWantWrite{}
                return ok(want)
            }
            return err(m, code)
        }
    }
}

pub fn pending(mut t: &Transport): Result[int] {
    if t.kind == KIND_TLS {
        let held = takeTls(t)
        if held == nil {
            return err("TLS transport has no session", invalidArgument())
        }
        let s: tls::TlsSession = held
        let p = tls::pending(&s)
        restoreTls(t, s)
        match p {
            ok(v) { return ok(v.ciphertext) }
            err(m, c) { return err(m, c) }
        }
    }
    if t.kind == KIND_MEMORY {
        return ok(t.pendingBytes)
    }
    if t.kind == KIND_PLAIN {
        return ok(0)
    }
    return err("transport kind is invalid", invalidArgument())
}

pub fn want(mut t: &Transport): Result[Want] {
    if t.kind == KIND_TLS {
        let held = takeTls(t)
        if held == nil {
            return err("TLS transport has no session", invalidArgument())
        }
        let s: tls::TlsSession = held
        let outcome = tls::want(&s)
        restoreTls(t, s)
        match outcome {
            ok(v) {
                match v {
                    WantNone {
                        let out: Want = new WantNone{}
                        return ok(out)
                    }
                    WantRead {
                        let out: Want = new WantRead{}
                        return ok(out)
                    }
                    WantWrite {
                        let out: Want = new WantWrite{}
                        return ok(out)
                    }
                    WantReadWrite {
                        let out: Want = new WantReadWrite{}
                        return ok(out)
                    }
                }
            }
            err(m, c) { return err(m, c) }
        }
    }
    if t.kind == KIND_MEMORY {
        if t.wantMode == W_READ {
            let w: Want = new WantRead{}
            return ok(w)
        }
        if t.wantMode == W_WRITE {
            let w: Want = new WantWrite{}
            return ok(w)
        }
        if t.wantMode == W_BOTH {
            let w: Want = new WantReadWrite{}
            return ok(w)
        }
        let none: Want = new WantNone{}
        return ok(none)
    }
    if t.kind == KIND_PLAIN {
        let none: Want = new WantNone{}
        return ok(none)
    }
    return err("transport kind is invalid", invalidArgument())
}

pub fn alpn(mut t: &Transport): Result[Alpn] {
    if t.kind == KIND_TLS {
        let held = takeTls(t)
        if held == nil {
            return err("TLS transport has no session", invalidArgument())
        }
        let s: tls::TlsSession = held
        let outcome = tls::alpn(&s)
        restoreTls(t, s)
        match outcome {
            ok(name) {
                if name == "http/1.1" {
                    let a: Alpn = new AlpnHttp11{}
                    return ok(a)
                }
                if name == "h2" {
                    let a: Alpn = new AlpnH2{}
                    return ok(a)
                }
                if len(name) == 0 {
                    let a: Alpn = new AlpnNone{}
                    return ok(a)
                }
                let a: Alpn = new AlpnOther{name: name}
                return ok(a)
            }
            err(m, c) { return err(m, c) }
        }
    }
    if t.kind == KIND_MEMORY {
        if t.alpnKind == A_HTTP11 {
            let a: Alpn = new AlpnHttp11{}
            return ok(a)
        }
        if t.alpnKind == A_H2 {
            let a: Alpn = new AlpnH2{}
            return ok(a)
        }
        if t.alpnKind == A_OTHER {
            let a: Alpn = new AlpnOther{name: t.alpnName}
            return ok(a)
        }
        let a: Alpn = new AlpnNone{}
        return ok(a)
    }
    if t.kind == KIND_PLAIN {
        let none: Alpn = new AlpnNone{}
        return ok(none)
    }
    return err("transport kind is invalid", invalidArgument())
}

pub fn isSecure(mut t: &Transport): bool {
    if t.kind == KIND_TLS {
        let held = takeTls(t)
        if held == nil { return true }
        let s: tls::TlsSession = held
        let secure = tls::isSecure(&s)
        restoreTls(t, s)
        return secure
    }
    if t.kind == KIND_MEMORY { return t.secure }
    return false
}

pub fn maxTransfer(t: &Transport): int {
    if t.kind == KIND_TLS { return MAX_TRANSFER }
    return t.maxXfer
}

pub fn watch(mut t: &Transport, r: &reactor::Reactor, readable: bool,
             writable: bool, tag: int): Result[reactor::Watch] {
    if !readable && !writable {
        return err("a watch needs read or write interest", invalidArgument())
    }
    if t.kind == KIND_TLS {
        let held = takeTls(t)
        if held == nil {
            return err("TLS transport has no session", invalidArgument())
        }
        let s: tls::TlsSession = held
        let made = tls::watch(&s, r, readable, writable, tag)
        restoreTls(t, s)
        return made
    }
    if t.kind != KIND_PLAIN {
        return err("this transport has no reactor watch", unsupported())
    }
    // Mirror net::watchConnection: pass a checked handle (a scalar) rather than
    // a reference to the transport's field. No fd or source identity escapes.
    let h = handle(t.s.res)
    let checked = try platform::_requireKindHandle(h, platform::KIND_STREAM)
    return reactor::watchResource(r, checked, readable, writable, tag)
}

pub fn close(mut t: &Transport): Result[bool] {
    if t.shut { return ok(false) }
    t.shut = true
    if t.kind == KIND_TLS {
        let held = takeTls(t)
        if held == nil { return ok(true) }
        let s: tls::TlsSession = held
        let shutRes = tls::close(&s)
        drop(s)
        return shutRes
    }
    if t.kind != KIND_PLAIN { return ok(true) }
    let tmp = replace(t.s, placeholderStream())
    return stream::close(&tmp)
}
