const EV_DRAIN_COMPLETE = 10
const EV_CONNECTION_CLOSED = 11

const FLAG_END_STREAM = 1
const FLAG_TRAILERS = 2
const FLAG_LOCAL = 4

const STATE_AWAIT_PREFACE = 0
const STATE_AWAIT_SETTINGS = 1
const STATE_OPEN = 2
const STATE_DRAINING = 3
const STATE_CLOSING = 4
const STATE_CLOSED = 5
const STATE_FAILED = 6

const STREAM_OPEN = 1
const STREAM_HALF_CLOSED_REMOTE = 2
const STREAM_HALF_CLOSED_LOCAL = 3
const STREAM_CLOSED_STATE = 4

const MODE_TLS = 0
const MODE_PRIOR = 1

const OPTION_FIELDS = 44
const OPTION_BYTES = 352
const OPTION_MAGIC = 1211253041

const INFO_FIELDS = 18
const INFO_BYTES = 144
const STATS_FIELDS = 22
const STATS_BYTES = 176
const COUNTS_FIELDS = 22
const COUNTS_BYTES = 176

pub type Mode = closed {
    ModeTls {}
    ModePriorKnowledge {}
}

pub type Options = ref record {
    pub mode: Mode
    pub serverName: string
    pub requireAuthority: bool
}

pub type Limits = ref record {
