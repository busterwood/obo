// Experimental HTTP/2 server protocol core (H2a).
//
// Status: experimental, unstable, hosted-only. This module owns the
// H2Connection/H2Stream shells, admission, deadlines, bounded header/body
// reads, response staging, the fixed-event pull interface and the pure action
// executor. Framing, HPACK, flow-control bookkeeping and stream state come
// from the system nghttp2 through native/h2_adapter.c.
//
// No nghttp2 pointer, C struct, function pointer or callback crosses the cbind.
// The C callbacks only queue fixed events and copy bounded payloads; obo polls.
// See README.md, API.md, LIMITS.md and obo/design/http2-server-design.md.
module http2

import "httpapi.obx" as http
import "httptransport.obx" as transport
import "sysbytes.obx" as bytesbuf
import "sysclock.obx" as clock
import "syserrors.obx" as errors
import "sysplatform.obx" as platform
import "sysreactor.obx" as reactor

pub const KIND_H2_CONNECTION = platform::KIND_H2_CONNECTION
pub const KIND_H2_STREAM = platform::KIND_H2_STREAM

