const FAIL_RANGE = 2
const FAIL_INVALID_RESOURCE = 3
const FAIL_CLOSED = 4
const FAIL_NOT_READY = 5
const FAIL_INVALID_STATE = 6
const FAIL_BAD_PREFACE = 7
const FAIL_BAD_FRAME = 8
const FAIL_FRAME_SIZE = 9
const FAIL_PROTOCOL = 10
const FAIL_COMPRESSION = 11
const FAIL_HEADER_LIST = 12
const FAIL_CONTINUATION = 13
const FAIL_FLOOD = 14
const FAIL_REFUSED = 15
const FAIL_STREAM_CLOSED = 16
const FAIL_RESET = 17
const FAIL_GOAWAY = 18
const FAIL_FLOW_CONTROL = 19
const FAIL_SETTINGS_TIMEOUT = 20
const FAIL_TIMEOUT = 21
const FAIL_RESOURCE_LIMIT = 22
const FAIL_BUSY = 23
const FAIL_UNSUPPORTED = 24
const FAIL_INTERNAL = 25

const FAIL_SHIFT = 16777216

