        drainTimeoutMs: l.drainTimeoutMs
    }
}

fn positive(n: int): bool { return n > 0 }

pub fn reservation(l: &Limits): Result[int]

// Pure checked validation. Every product is guarded against overflow before
// any native call or allocation.
pub fn validateLimits(l: &Limits): Result[bool] {
    if !positive(l.maxConcurrentStreams) || l.maxConcurrentStreams > 256 {
        return err("maxConcurrentStreams is outside 1..256", http::code(FAIL_INVALID_ARGUMENT, 0))
    }
    if l.maxStreamsPerConnection < l.maxConcurrentStreams {
        return err("maxStreamsPerConnection is below maxConcurrentStreams", http::code(FAIL_INVALID_ARGUMENT, 0))
    }
    if !positive(l.maxHeaderListBytes) || !positive(l.maxHeaderCount) ||
       !positive(l.maxHeaderFieldBytes) || !positive(l.maxHeaderBlockBytes) {
        return err("header limits must be positive", http::code(FAIL_INVALID_ARGUMENT, 0))
    }
    if l.maxHeaderBlockBytes < l.maxHeaderListBytes {
        return err("maxHeaderBlockBytes is below maxHeaderListBytes", http::code(FAIL_INVALID_ARGUMENT, 0))
    }
    if l.maxHeaderListBytes < l.maxHeaderFieldBytes {
        return err("maxHeaderListBytes is below maxHeaderFieldBytes", http::code(FAIL_INVALID_ARGUMENT, 0))
    }
    if !positive(l.maxContinuations) || !positive(l.maxHeaderArena) {
        return err("continuation and arena limits must be positive", http::code(FAIL_INVALID_ARGUMENT, 0))
    }
    if !positive(l.maxStreamRecvWindow) || !positive(l.maxStreamRecvBuffer) ||
       !positive(l.maxConnectionWindow) || !positive(l.maxStreamSendBuffer) {
        return err("flow-control limits must be positive", http::code(FAIL_INVALID_ARGUMENT, 0))
    }
    if l.maxStreamRecvBuffer != l.maxStreamRecvWindow {
        return err("v1 requires maxStreamRecvBuffer == maxStreamRecvWindow", http::code(FAIL_INVALID_ARGUMENT, 0))
    }
    if l.maxConcurrentStreams > 2147483647 / l.maxStreamRecvWindow {
        return err("connection window product overflows", http::code(FAIL_RANGE, 0))
    }
    if l.maxConnectionWindow != l.maxConcurrentStreams * l.maxStreamRecvWindow {
        return err("maxConnectionWindow must equal maxConcurrentStreams * maxStreamRecvWindow", http::code(FAIL_INVALID_ARGUMENT, 0))
    }
    if l.maxWire < 65536 || l.maxWire > 16777216 {
        return err("maxWire is outside 64 KiB..16 MiB", http::code(FAIL_INVALID_ARGUMENT, 0))
    }
    if l.maxReadChunk < 1 ||
       l.maxReadChunk > 9223372036854775807 - 9 ||
       l.maxWire < l.maxReadChunk + 9 {
        return err("maxWire is below maxReadChunk + 9", http::code(FAIL_INVALID_ARGUMENT, 0))
    }
    if !positive(l.maxEvents) || l.maxEvents < 5 * l.maxConcurrentStreams + 16 {
        return err("maxEvents is below 5 * maxConcurrentStreams + 16", http::code(FAIL_INVALID_ARGUMENT, 0))
    }
    if !positive(l.maxBody) || !positive(l.maxTrailerBytes) ||
       !positive(l.maxTrailerCount) || !positive(l.maxResponseHeaderBytes) ||
       !positive(l.maxResponseTrailerBytes) || !positive(l.maxResponseTrailerCount) {
        return err("body, trailer and response limits must be positive", http::code(FAIL_INVALID_ARGUMENT, 0))
    }
    if l.maxTrailerBytes > l.maxHeaderListBytes || l.maxTrailerCount > l.maxHeaderCount {
        return err("trailer limits exceed the request header limits", http::code(FAIL_INVALID_ARGUMENT, 0))
    }
    if l.maxResponseTrailerBytes > l.maxResponseHeaderBytes ||
       l.maxResponseTrailerCount > l.maxHeaderCount {
        return err("response trailer limits exceed the response header limits", http::code(FAIL_INVALID_ARGUMENT, 0))
    }
    if l.maxConcurrentStreams > 2147483647 / (l.maxHeaderListBytes + l.maxTrailerBytes +
                                              l.maxResponseHeaderBytes + l.maxResponseTrailerBytes) {
        return err("per-stream staging product overflows", http::code(FAIL_RANGE, 0))
    }
    let staging = l.maxHeaderListBytes + l.maxTrailerBytes +
                  l.maxResponseHeaderBytes + l.maxResponseTrailerBytes
    if l.maxHeaderArena < l.maxConcurrentStreams * staging {
        return err("maxHeaderArena is below maxConcurrentStreams * per-stream staging", http::code(FAIL_RESOURCE_LIMIT, 0))
    }
    if !positive(l.maxRequestsPerConnection) || !positive(l.maxConnections) ||
       !positive(l.maxTotalConnectionBytes) {
        return err("request and admission limits must be positive", http::code(FAIL_INVALID_ARGUMENT, 0))
    }
    if !positive(l.maxResetBurst) || !positive(l.maxResetRate) ||
       !positive(l.maxPingAcks) || !positive(l.maxSettingsEntries) ||
       !positive(l.frameBurst) || !positive(l.frameRate) ||
       !positive(l.zeroDataBurst) || !positive(l.zeroDataRate) {
        return err("rate and ack limits must be positive", http::code(FAIL_INVALID_ARGUMENT, 0))
    }
    let t = l.prefaceTimeoutMs
    if t < 1 || l.settingsTimeoutMs < 1 || l.headerTimeoutMs < 1 ||
       l.bodyIdleTimeoutMs < 1 || l.responseTimeoutMs < 1 ||
       l.responseTotalTimeoutMs < 1 || l.streamTotalTimeoutMs < 1 ||
       l.idleTimeoutMs < 1 || l.drainBarrierMs < 1 || l.drainTimeoutMs < 1 {
        return err("timeouts must be positive", http::code(FAIL_INVALID_ARGUMENT, 0))
    }
    if t > 9223372036854 || l.settingsTimeoutMs > 9223372036854 ||
       l.headerTimeoutMs > 9223372036854 || l.bodyIdleTimeoutMs > 9223372036854 ||
       l.responseTimeoutMs > 9223372036854 || l.responseTotalTimeoutMs > 9223372036854 ||
       l.streamTotalTimeoutMs > 9223372036854 || l.idleTimeoutMs > 9223372036854 ||
       l.drainBarrierMs > 9223372036854 || l.drainTimeoutMs > 9223372036854 {
        return err("a timeout overflows nanosecond conversion", http::code(FAIL_RANGE, 0))
    }
    let per = try reservation(l)
    if l.maxConnections > 2147483647 / per {
        return err("aggregate reservation product overflows", http::code(FAIL_RANGE, 0))
    }
    if l.maxTotalConnectionBytes < l.maxConnections * per {
        return err("maxTotalConnectionBytes is below maxConnections * reservation", http::code(FAIL_RESOURCE_LIMIT, 0))
    }
    return ok(true)
}

pub fn defaultOptions(): Options {
    return new Options{mode: new ModeTls{}, serverName: "", requireAuthority: true}
}

fn optionMode(o: &Options): int {
    let m = o.mode
    match m {
        ModeTls { return MODE_TLS }
        ModePriorKnowledge { return MODE_PRIOR }
    }
}

fn alpnIsH2(a: &transport::Alpn): bool {
    match a {
        AlpnH2 { return true }
        AlpnNone { return false }
        AlpnHttp11 { return false }
        AlpnOther { return false }
    }
}

fn validServerName(name: string): bool {
    if len(name) > 64 { return false }
    for i in 0..len(name) {
        let ch = name[i]
        if ch == '\r' || ch == '\n' || ch == byte(0) { return false }
    }
    return true
}

pub fn reservation(l: &Limits): Result[int] {
    if l.maxConcurrentStreams < 1 || l.maxStreamRecvBuffer < 1 ||
       l.maxStreamSendBuffer < 1 || l.maxWire < 1 || l.maxHeaderArena < 1 ||
       l.maxEvents < 1 {
        return err("reservation inputs must be positive", http::code(FAIL_INVALID_ARGUMENT, 0))
    }
    if l.maxConcurrentStreams > 2147483647 / (l.maxStreamRecvBuffer + l.maxStreamSendBuffer) {
        return err("per-stream reservation overflows", http::code(FAIL_RANGE, 0))
    }
    let perStream = l.maxConcurrentStreams * (l.maxStreamRecvBuffer + l.maxStreamSendBuffer)
    if l.maxWire > 9223372036854775807 / 2 {
        return err("wire reservation overflows", http::code(FAIL_RANGE, 0))
    }
    let wire = 2 * l.maxWire
    if l.maxEvents > 9223372036854775807 / 32 {
        return err("event reservation overflows", http::code(FAIL_RANGE, 0))
    }
    let events = l.maxEvents * 32
    let refs = 2 * l.maxHeaderCount + l.maxTrailerCount + l.maxResponseTrailerCount
    if refs < 1 || l.maxConcurrentStreams > 9223372036854775807 / refs / 16 {
        return err("header reference reservation overflows", http::code(FAIL_RANGE, 0))
    }
    let refBytes = l.maxConcurrentStreams * refs * 16
    var total = perStream
    if total > 9223372036854775807 - wire { return err("reservation overflows", http::code(FAIL_RANGE, 0)) }
    total += wire
    if total > 9223372036854775807 - l.maxHeaderArena { return err("reservation overflows", http::code(FAIL_RANGE, 0)) }
    total += l.maxHeaderArena
    if total > 9223372036854775807 - events { return err("reservation overflows", http::code(FAIL_RANGE, 0)) }
    total += events
    if total > 9223372036854775807 - refBytes { return err("reservation overflows", http::code(FAIL_RANGE, 0)) }
    total += refBytes
    if total > 9223372036854775807 - FIXED_OVERHEAD { return err("reservation overflows", http::code(FAIL_RANGE, 0)) }
    total += FIXED_OVERHEAD
    return ok(total)
}

// Application-owned aggregate admission. It is not a native resource and has
// no destructor. The application calls admit() before make() and release()
// after close() with reservedBytes(c).
pub type Admission = ref record {
    active: int
    reserved: int
}

pub fn makeAdmission(): Admission {
    return new Admission{active: 0, reserved: 0}
}

pub fn admit(mut a: &Admission, l: &Limits): Result[bool] {
    let checked = try validateLimits(l)
    if !checked { return ok(false) }
    let per = try reservation(l)
    if a.active >= l.maxConnections { return ok(false) }
    if a.reserved > l.maxTotalConnectionBytes - per { return ok(false) }
    a.active += 1
    a.reserved += per
    return ok(true)
}

pub fn release(mut a: &Admission, reserved: int): bool {
    if reserved < 0 { return false }
    var n = reserved
    if n > a.reserved { n = a.reserved }
    a.reserved -= n
    if a.active > 0 { a.active -= 1 }
    return true
}

pub fn activeCount(a: &Admission): int { return a.active }
pub fn admissionReservedBytes(a: &Admission): int { return a.reserved }

