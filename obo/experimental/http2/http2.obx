pub type Connection = ref record {
    pub res: platform::Resource
    t: transport::Transport
    reserved: int
    limits: Limits
    options: Options
    mode: int
    outBytes: []byte
    outPos: int
    ended: bool
    eofSeen: bool
    drained: bool
    failureCode: int
    requests: int
}

pub type Stream = ref record {
    pub res: platform::Resource
    readChunk: int
    fieldBytes: int
    maxBody: int
    secure: bool
    serverName: string
    requireAuthority: bool
    headRequest: bool
    status: int
    bodyWritten: int
    bodyRead: int
}

pub fn _emptyStream(): Stream {
    return new Stream{
        res: new platform::Resource{reserved: 0}
        readChunk: 1
        fieldBytes: 1
        maxBody: 1
        secure: false
        serverName: ""
        requireAuthority: false
        headRequest: false
        status: 0
        bodyWritten: 0
        bodyRead: 0
    }
}


pub type StreamState = closed {
    StreamOpen {}
    StreamHalfClosedRemote {}
    StreamHalfClosedLocal {}
    StreamClosed {}
}

pub type Event = closed {
    EventNeedRead {}
    EventNeedWrite {}
    EventStreamStarted { id: int }
    EventStreamData { id: int }
    EventStreamEnd { id: int }
    EventTrailers { id: int }
    EventStreamClosed { id: int; code: int }
    EventSettingsAcked {}
    EventGoaway { lastStreamID: int; code: int }
    EventTimedOut { id: int }
    EventProtocolError { code: int }
    EventDrainComplete {}
    EventConnectionClosed {}
}

pub type Counts = ref record {
    pub liveConnections: int
    pub liveStreams: int
    pub closingStreams: int
    pub streamsOpened: int
    pub streamsClosed: int
    pub requestsCompleted: int
    pub resetsSent: int
    pub resetsReceived: int
    pub goawaysSent: int
    pub goawaysReceived: int
    pub framesIn: int
    pub zeroDataFrames: int
    pub headerBytes: int
    pub bodyBytesIn: int
    pub bodyBytesOut: int
    pub wireBytes: int
    pub windowRestored: int
    pub flowControlBlocked: int
    pub eventQueueHighWater: int
    pub wireHighWater: int
    pub timeouts: int
    pub protocolErrors: int
    pub nativeBytes: int
    pub maxNativeBytes: int
}

pub type Stats = ref record {
    pub liveStreams: int
    pub closingStreams: int
    pub maxConcurrentStreams: int
    pub streamsOpened: int
    pub streamsClosed: int
    pub resetsSent: int
    pub resetsReceived: int
    pub goawaysSent: int
    pub goawaysReceived: int
