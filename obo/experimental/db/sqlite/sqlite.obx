// Experimental SQLite package for obo, on cinterop v2 foreign handles.
//
// The host has libsqlite3.so.0 and the sqlite3 shell but no sqlite3.h, so the
// binding uses the manual, declarations-only subset in sqlite_decls.h. This is
// an explicit-close package, not a stable driver: Connection and Stmt are
// foreign handles, and obo never sees a sqlite3* or sqlite3_stmt*.
//
// Close explicitly and defer the close. Dropping an open handle leaks it; under
// OBO_CHECK=1 the foreign census reports it at normal end. A connection close
// uses sqlite3_close_v2 (D14): it succeeds while statements are live, the
// Connection census drops, and the statements keep working until finalized.
// A second close is a safe ok(false). SQL and text bindings reject embedded
// NUL; BLOB bindings preserve their exact length, including NUL. There is no
// SQL interpolation. prepare_sql/bind_sql add the dialect-neutral Sql-template
// bridge: prepare_sql renders `?` placeholders with lib/sqldialect and bind_sql
// binds the ordered SqlArg values, while SqlArg.Float is an explicit
// SQL_ARG_FLOAT_UNSUPPORTED error.
module sqlite

import "sqldialect.obx" as sqldialect

pub const SQLITE_OK = 0
pub const SQLITE_ERROR = 1
pub const SQLITE_INTERNAL = 2
pub const SQLITE_PERM = 3
pub const SQLITE_ABORT = 4
pub const SQLITE_BUSY = 5
pub const SQLITE_LOCKED = 6
pub const SQLITE_NOMEM = 7
pub const SQLITE_READONLY = 8
pub const SQLITE_INTERRUPT = 9
pub const SQLITE_IOERR = 10
pub const SQLITE_CORRUPT = 11
pub const SQLITE_NOTFOUND = 12
pub const SQLITE_FULL = 13
pub const SQLITE_CANTOPEN = 14
pub const SQLITE_PROTOCOL = 15
pub const SQLITE_EMPTY = 16
pub const SQLITE_SCHEMA = 17
pub const SQLITE_TOOBIG = 18
pub const SQLITE_CONSTRAINT = 19
pub const SQLITE_MISMATCH = 20
pub const SQLITE_MISUSE = 21
pub const SQLITE_AUTH = 23
pub const SQLITE_RANGE = 25
pub const SQLITE_NOTADB = 26
pub const SQLITE_ROW = 100
pub const SQLITE_DONE = 101

pub const SQLITE_INTEGER = 1
pub const SQLITE_FLOAT = 2
pub const SQLITE_TEXT = 3
pub const SQLITE_BLOB = 4
pub const SQLITE_NULL = 5

pub const SQLITE_OPEN_READWRITE = 0x00000002
pub const SQLITE_OPEN_CREATE = 0x00000004
pub const SQLITE_OPEN_URI = 0x00000040

// The limits kept from the old adapter (design C15).
const MAX_PATH = 4096
const MAX_SQL = 1048576
const MAX_VALUE = 16777216

// SqlArg.Float is a binary64 value. This package does not bind REAL through a
// float path, so bind_sql rejects it explicitly instead of rounding or
// interpolating it. Use decimal TEXT, or an explicit integer/text form.
pub const SQL_ARG_FLOAT_UNSUPPORTED = 1014

// Decimal boundary error codes. They start at 1000 so they do not collide with
// SQLite's SQLITE_* values or the binding's plumbing codes 2/3.
pub const DEC_DB_NULL = 1001
pub const DEC_DB_NOT_DECIMAL = 1002
pub const DEC_DB_BINARY = 1003
pub const DEC_DB_NONFINITE = 1004
pub const DEC_DB_INEXACT_STORAGE = 1005
pub const DEC_DB_TEXT_INVALID = 1006
pub const DEC_DB_PRECISION = 1007
pub const DEC_DB_EXPONENT = 1008
pub const DEC_DB_DISPLAY_RANGE = 1009
pub const DEC_DB_SCALE = 1010
pub const DEC_DB_RANGE = 1011
pub const DEC_DB_METADATA = 1012
pub const DEC_DB_PG_RANGE = 1013

pub type Connection = foreign "sqlite3"
pub type Stmt = foreign "sqlite3_stmt"

// ---------------------------------------------------------- native declarations

native fn open_v2(path: &[]byte, flags: int, out db: Connection): open_v2_out
native fn prepare_v2(db: &Connection, sql: &[]byte,
                     out st: Stmt, out tail: int from sql): prepare_v2_out
native fn has_live(db: &Connection): int
native fn step(s: &Stmt): int
native fn stmt_reset(s: &Stmt): int
native fn bind_null_native(s: &Stmt, index: int): int
native fn bind_int_native(s: &Stmt, index: int, value: int): int
native fn bind_text_native(s: &Stmt, index: int, value: &[]byte): int
native fn bind_blob_native(s: &Stmt, index: int, value: &[]byte): int
native fn parameter_count(s: &Stmt): int
native fn column_count(s: &Stmt): int
native fn column_type(s: &Stmt, col: int): int
native fn column_int64(s: &Stmt, col: int): int
native fn read_text(s: &Stmt, col: int): ?[]byte
native fn read_blob(s: &Stmt, col: int): ?[]byte
native fn changes(db: &Connection): int
native fn error_code(db: &Connection): int
native fn error_message(db: &Connection): []byte
native fn errstr(code: int): []byte
native fn stmt_error_code(s: &Stmt): int

// ---------------------------------------------------------------- helpers

fn encode_string(s: string): []byte {
    var out = new []byte(0)
    for i in 0..len(s) { append(out, s[i]) }
    return out
}

// Copy a borrowed byte array. SqlArg payloads are borrowed from the Sql
// fragment, so a bridge must not move them into a binding.
fn copy_bytes(b: &[]byte): []byte {
    var out = new []byte(0)
    for i in 0..len(b) { append(out, b[i]) }
    return out
}

fn has_nul(b: &[]byte): bool {
    for i in 0..len(b) {
        if b[i] == byte(0) { return true }
    }
    return false
}

fn string_has_nul(s: string): bool {
    for i in 0..len(s) {
        if s[i] == byte(0) { return true }
    }
    return false
}

fn blank_byte(c: byte): bool {
    return c == byte(32) || c == byte(9) || c == byte(13) || c == byte(10) || c == byte(59)
}

// Only spaces, tabs, CR, LF and ';' may follow the one prepared statement.
fn blank_tail(s: &[]byte, off: int): bool {
    if off < 0 || off > len(s) { return false }
    for i in off..len(s) {
        if !blank_byte(s[i]) { return false }
    }
    return true
}

fn remainder(s: &[]byte, from: int): []byte {
    var out = new []byte(0)
    for i in from..len(s) { append(out, s[i]) }
    return out
}

// ------------------------------------------------------- decimal text helpers

fn fraction_digits(s: string): int {
    for i in 0..len(s) {
        if s[i] == '.' { return len(s) - i - 1 }
    }
    return 0
}

fn canonical_db(value: decimal): Result[string] {
    let c = decimal::canonical(value)
    match c {
        ok(s) { return ok(s) }
        err(m, code) {
            if code == 6 || code == 9 {
                return err("decimal display scale is outside uint16", DEC_DB_DISPLAY_RANGE)
            }
            if code == 10 { return err("decimal text could not be allocated", 3) }
            return err("invalid decimal value", 2)
        }
    }
}

// SQLite has a uint16 display-scale limit and no numeric(p,s) type. This is the
// same exact display-then-canonical rule as PostgreSQL, with max 65535.
fn encode_decimal(value: decimal, max_dscale: int): Result[string] {
    let f = decimal::format(value)
    match f {
        ok(s) {
            let ds = fraction_digits(s)
            if max_dscale < 0 || ds <= max_dscale { return ok(s) }
            if value != 0.0 && decimal::exponent(value) < -max_dscale {
                return err("value is not representable in PostgreSQL numeric",
                           DEC_DB_PG_RANGE)
            }
            return canonical_db(value)
        }
        err(m, c) {
            if c == 3 {
                if value != 0.0 && decimal::exponent(value) < -max_dscale {
                    return err("value is not representable in PostgreSQL numeric",
                               DEC_DB_PG_RANGE)
                }
                return canonical_db(value)
            }
            if c == 10 { return err("decimal text could not be allocated", 3) }
            if c == 6 || c == 9 {
                return err("decimal display scale is outside uint16",
                           DEC_DB_DISPLAY_RANGE)
            }
            return err("invalid decimal value", 2)
        }
    }
}

// ------------------------------------------------------------------ connection

pub fn open_with(path: string, flags: int): Result[Connection] {
    if len(path) > MAX_PATH { return err("database path is too long", 2) }
    if string_has_nul(path) { return err("database path contains an embedded NUL", 2) }
    var pb = encode_string(path)
    var out = open_v2(&pb, flags)
    if out.rc != SQLITE_OK {
        // open_v2 writes a non-NULL sqlite3* even on most failures. Read the
        // message before closing it, and close it exactly once.
        var db = take(out.db)
        if db == nil {
            var es = errstr(out.rc)
            return err(string(es), 1)
        }
        var mb = error_message(&db)
        let msg = string(mb)
        db.close()
        var code = out.rc
        if code <= 0 { code = 1 }
        return err(msg, code)
    }
    var db = take(out.db)
    if db == nil { return err("sqlite returned no handle", 1) }
    return ok(db)
}

pub fn open(path: string): Result[Connection] {
    return open_with(path, SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE | SQLITE_OPEN_URI)
}


pub fn (mut c: &Connection) close(): Result[bool] { return __foreignClose(c) }
pub fn (c: &Connection) is_open(): bool { return __foreignIsOpen(c) }

pub fn (c: &Connection) error_message(): []byte {
    return error_message(c)
}

pub fn (c: &Connection) error_code(): int {
    return error_code(c)
}

pub fn (c: &Connection) changes(): int {
    return changes(c)
}

// True while the connection owns at least one statement that has not been
// finalized. This is informational: sqlite3_close_v2 succeeds with live
// statements and leaves a C-side zombie until the last finalize.
pub fn (c: &Connection) has_live(): bool {
    return has_live(c) != 0
}

pub fn (s: &Stmt) step(): Result[bool]

// Executes a fixed SQL string as prepare/step/close for each statement. Every
// exit from the loop closes the current statement first. There is no string
// interpolation.
pub fn (c: &Connection) exec(sql: string): Result[bool] {
    if len(sql) > MAX_SQL { return err("SQL text is too large", 2) }
    if string_has_nul(sql) { return err("SQL text contains an embedded NUL", 2) }
    var all = encode_string(sql)
    var off = 0
    while true {
        while off < len(all) && blank_byte(all[off]) { off += 1 }
        if off >= len(all) { break }
        var part = remainder(&all, off)
        var out = prepare_v2(c, &part)
        if out.rc != SQLITE_OK {
            var mb = error_message(c)
            let msg = string(mb)
            var bad = take(out.st)
            if bad != nil { bad.close() }
            var code = out.rc
            if code <= 0 { code = 1 }
            return err(msg, code)
        }
        var st = take(out.st)
        if st == nil { break }                  // only trailing whitespace remains
        if out.tail < 0 || out.tail > len(part) {
            st.close()
            return err("SQL statement has an invalid tail", 2)
        }
        var more = true
        while more {
            let sr = st.step()
            match sr {
                ok(row) { more = row }
                err(m, code) {
                    st.close()
                    return err(m, code)
                }
            }
        }
        st.close()
        if out.tail <= 0 { return err("SQL statement did not advance", 2) }
        off += out.tail
    }
    return ok(true)
}

pub fn (c: &Connection) prepare(sql: string): Result[Stmt] {
    if len(sql) > MAX_SQL { return err("SQL text is too large", 2) }
    if string_has_nul(sql) { return err("SQL text contains an embedded NUL", 2) }
    var sb = encode_string(sql)
    var out = prepare_v2(c, &sb)
    if out.rc != SQLITE_OK {
        var mb = error_message(c)
        let msg = string(mb)
        var bad = take(out.st)
        if bad != nil { bad.close() }
        var code = out.rc
        if code <= 0 { code = 1 }
        return err(msg, code)
    }
    var st = take(out.st)
    if st == nil { return err("SQL text is empty", 2) }
    if !blank_tail(&sb, out.tail) {
        st.close()
        return err("prepare takes one statement; use exec for several", 2)
    }
    return ok(st)
}

// Prepare a dialect-neutral Sql fragment for SQLite with `?` placeholders.
// The fragment is borrowed; its literal chunks are trusted SQL and its values
// are bound separately by bind_sql. No text is interpolated.
pub fn prepare_sql(c: &Connection, s: &Sql): Result[Stmt] {
    let text = try sqldialect::renderSqlite(s)
    return c.prepare(text)
}

// ---------------------------------------------------------------- statements

pub fn (s: &Stmt) error_code(): int
pub fn (s: &Stmt) error_message(): []byte

fn stmt_error(s: &Stmt, fallback: int): Result[bool] {
    var code = s.error_code()
    if code == 0 { code = fallback }
    var mb = s.error_message()
    let msg = string(mb)
    return err(msg, code)
}

pub fn (mut s: &Stmt) close(): Result[bool] { return __foreignClose(s) }
pub fn (s: &Stmt) is_open(): bool { return __foreignIsOpen(s) }

// The statement's connection error code, through sq_stmt_errcode. After a
// successful step it is SQLITE_ROW (100): use the step return code for
// statement errors. Meaningful only while the Db is open (design 6.2).
pub fn (s: &Stmt) error_code(): int {
    return stmt_error_code(s)
}

pub fn (s: &Stmt) error_message(): []byte {
    var es = errstr(s.error_code())
    return es
}

// Resets the statement for another step. The C return is ignored: after a
// failed step sqlite3_reset reports that prior error but has already reset the
// statement, so reset is successful (review 1).
pub fn (s: &Stmt) reset(): Result[bool] {
    stmt_reset(s)
    return ok(true)
}

pub fn (s: &Stmt) parameter_count(): int {
    return parameter_count(s)
}

fn check_parameter(s: &Stmt, index: int): Result[bool] {
    if index < 1 || index > s.parameter_count() {
        return err("parameter index out of range", SQLITE_RANGE)
    }
    return ok(true)
}

// Binding indices are 1-based. Out-of-range indices are SQLITE_RANGE errors.
pub fn (s: &Stmt) bind_null(index: int): Result[bool] {
    let ok_index = try check_parameter(s, index)
    let rc = bind_null_native(s, index)
    if rc == SQLITE_OK { return ok(true) }
    return stmt_error(s, rc)
}

pub fn (s: &Stmt) bind_int(index: int, value: int): Result[bool] {
    let ok_index = try check_parameter(s, index)
    let rc = bind_int_native(s, index, value)
    if rc == SQLITE_OK { return ok(true) }
    return stmt_error(s, rc)
}

pub fn (s: &Stmt) bind_text(index: int, value: string): Result[bool] {
    if len(value) > MAX_VALUE { return err("bound value is too large", 2) }
    if string_has_nul(value) { return err("text value contains an embedded NUL", 2) }
    let ok_index = try check_parameter(s, index)
    var raw = encode_string(value)
    let rc = bind_text_native(s, index, &raw)
    if rc == SQLITE_OK { return ok(true) }
    return stmt_error(s, rc)
}

// Bind TEXT from a borrowed byte array. SQLite copies the value because the
// spec passes SQLITE_TRANSIENT (const:-1), so the caller may reuse or change the
// array after this returns; the bound bytes do not alias it.
pub fn (s: &Stmt) bind_text_raw(index: int, value: &[]byte): Result[bool] {
    if len(value) > MAX_VALUE { return err("bound value is too large", 2) }
    if has_nul(value) { return err("text value contains an embedded NUL", 2) }
    let ok_index = try check_parameter(s, index)
    let rc = bind_text_native(s, index, value)
    if rc == SQLITE_OK { return ok(true) }
    return stmt_error(s, rc)
}

pub fn (s: &Stmt) bind_blob(index: int, value: []byte): Result[bool] {
    if len(value) > MAX_VALUE { return err("bound value is too large", 2) }
    let ok_index = try check_parameter(s, index)
    let rc = bind_blob_native(s, index, &value)
    if rc == SQLITE_OK { return ok(true) }
    return stmt_error(s, rc)
}

// Bind every parameter of s to st at indices 1..n, in order. The SQL must have
// been prepared from the same fragment with prepare_sql (or an equivalent
// statement with the same number and order of placeholders). The relation
// len(text) == len(params) + 1 is checked here too, so a malformed fragment
// fails before any binding. Byte payloads are deep-copied because they are
// borrowed from the fragment; DecimalText is bound as its exact TEXT bytes,
// never parsed or reformatted. Float has no binding here. The match is inline
// because a borrowed SqlArg must not be passed to a helper that writes through
// the statement handle.
pub fn bind_sql(st: &Stmt, s: &Sql): Result[bool] {
    if len(s.text) == 0 {
        return err("empty Sql fragment", 2)
    }
    if len(s.text) != len(s.params) + 1 {
        return err("malformed Sql fragment: text and parameters do not alternate", 2)
    }
    for i in 0..len(s.params) {
        let a = &s.params[i]
        match a {
            Null { }
            Int { }
            Bool { }
            Str {
                if string_has_nul(a.v) {
                    return err("text value contains an embedded NUL", 2)
                }
                if len(a.v) > MAX_VALUE {
                    return err("bound value is too large", 2)
                }
            }
            Bytes {
                if len(a.v) > MAX_VALUE {
                    return err("bound value is too large", 2)
                }
            }
            Float {
                return err("float SqlArg is not supported by the SQLite adapter; use decimal or text",
                           SQL_ARG_FLOAT_UNSUPPORTED)
            }
            DecimalText {
                if len(a.v) == 0 {
                    return err("invalid decimal text", DEC_DB_TEXT_INVALID)
                }
                if has_nul(&a.v) {
                    return err("invalid decimal text", DEC_DB_TEXT_INVALID)
                }
            }
        }
    }
    for i in 0..len(s.params) {
        let index = i + 1
        let a = &s.params[i]
        match a {
            Null {
                let one = try st.bind_null(index)
                if !one { return err("parameter could not be bound", 2) }
            }
            Int {
                let v = a.v
                let one = try st.bind_int(index, v)
                if !one { return err("parameter could not be bound", 2) }
            }
            Bool {
                var v = 0
                if a.v { v = 1 }
                let one = try st.bind_int(index, v)
                if !one { return err("parameter could not be bound", 2) }
            }
            Float {
                return err("float SqlArg is not supported by the SQLite adapter; use decimal or text",
                           SQL_ARG_FLOAT_UNSUPPORTED)
            }
            Str {
                let v = a.v
                let one = try st.bind_text(index, v)
                if !one { return err("parameter could not be bound", 2) }
            }
            Bytes {
                let v = copy_bytes(&a.v)
                let one = try st.bind_blob(index, v)
                if !one { return err("parameter could not be bound", 2) }
            }
            DecimalText {
                let v = string(a.v)
                let one = try st.bind_text(index, v)
                if !one { return err("parameter could not be bound", 2) }
            }
        }
    }
    return ok(true)
}

// Store an exact decimal as TEXT. This never binds REAL and never interpolates.
pub fn bind_decimal_unchecked(st: &Stmt, index: int, value: decimal): Result[bool] {
    let txt = try encode_decimal(value, 65535)
    return st.bind_text(index, txt)
}

// The default checked binder: SQLite has no (p,s) enforcement, so this is the
// only schema gate that prevents a value from silently not fitting its column.
pub fn bind_decimal(st: &Stmt, index: int, value: decimal,
                    p: int, s: int): Result[bool] {
    let r = decimal::check(value, p, s)
    match r {
        ok(v) { return bind_decimal_unchecked(st, index, v) }
        err(m, c) {
            if c == 10 { return err("decimal text could not be allocated", 3) }
            if c == 1 || c == 4 { return err("invalid decimal value", 2) }
            if c == 3 {
                return err("value does not fit the declared scale without rounding",
                           DEC_DB_SCALE)
            }
            if c == 7 {
                return err("value exceeds the declared precision", DEC_DB_RANGE)
            }
            if c == 6 {
                return err("invalid numeric typmod or precision/scale metadata",
                           DEC_DB_METADATA)
            }
            return err(m, c)
        }
    }
}

// true means a row is available; false means SQLITE_DONE. An SQLite error is a
// Result error, never a third boolean.
pub fn (s: &Stmt) step(): Result[bool] {
    let rc = step(s)
    if rc == SQLITE_ROW { return ok(true) }
    if rc == SQLITE_DONE { return ok(false) }
    return stmt_error(s, rc)
}

pub fn (s: &Stmt) column_count(): int {
    return column_count(s)
}

pub fn (s: &Stmt) column_type(col: int): Result[int] {
    if col < 0 || col >= s.column_count() { return err("column out of range", 2) }
    let t = column_type(s, col)
    if t < 0 { return err("column out of range", 2) }
    return ok(t)
}

pub fn (s: &Stmt) is_null(col: int): Result[bool] {
    let t = try s.column_type(col)
    let is_null = t == SQLITE_NULL
    return ok(is_null)
}

// Exact text bytes for one column with SQL NULL distinct: nil means NULL, an
// empty array means an empty value. (Obo optional values must be reference
// types, so the exact text form is ?[]byte; use column_text for a string.)
// SQLite's documented integer-to-text conversion is used for INTEGER columns,
// so i64 values stay exact decimal text; no obo float path is involved. A
// non-NULL value over the 16 MiB copy bound is a Result error, never an empty
// success. A NULL from sqlite3_column_text with SQLITE_NOMEM is also an error.
// REAL is rejected as inexact.
pub fn (s: &Stmt) column_value(col: int): Result[?[]byte] {
    let t = try s.column_type(col)
    if t == SQLITE_NULL {
        let none: ?[]byte = nil
        return ok(none)
    }
    if t == SQLITE_FLOAT {
        return err("REAL column is not exact decimal/data", 2)
    }
    var v = read_text(s, col)
    if v == nil {
        return err("column value is too large to copy or allocation failed", 2)
    }
    if s.error_code() == SQLITE_NOMEM {
        return err("SQLite ran out of memory reading the column", SQLITE_NOMEM)
    }
    let b = v
    let out: ?[]byte = b
    return ok(out)
}

// Read one column as an exact decimal. Storage-class order is normative:
// NULL, then REAL (inexact), then BLOB (not decimal), then TEXT/INTEGER bytes.
// INTEGER is SQLite's exact i64-to-text rendering with dscale 0; it is also how
// an integer-valued decimal in a NUMERIC/INTEGER-affinity column arrives.
pub fn (s: &Stmt) decimal(col: int): Result[decimal] {
    let t = try s.column_type(col)
    if t == SQLITE_NULL { return err("SQL NULL", DEC_DB_NULL) }
    if t == SQLITE_FLOAT {
        return err("SQLite REAL storage is not exact decimal",
                   DEC_DB_INEXACT_STORAGE)
    }
    if t == SQLITE_BLOB {
        return err("value is not numeric decimal data", DEC_DB_NOT_DECIMAL)
    }
    let v = try s.column_value(col)
    if v == nil { return err("SQL NULL", DEC_DB_NULL) }
    let b = v
    if len(b) == 0 { return err("invalid decimal text", DEC_DB_TEXT_INVALID) }
    if has_nul(&b) { return err("invalid decimal text", DEC_DB_TEXT_INVALID) }
    let txt = string(b)
    if txt == "NaN" || txt == "Infinity" || txt == "-Infinity" {
        return err("non-finite numeric is not representable", DEC_DB_NONFINITE)
    }
    let d = decimal::parse(txt)
    match d {
        ok(v) { return ok(v) }
        err(m, c) {
            if c == 10 { return err("decimal text could not be allocated", 3) }
            if c == 1 || c == 6 { return err("invalid decimal value", 2) }
            if c == 4 { return err("invalid decimal text", DEC_DB_TEXT_INVALID) }
            if c == 7 {
                return err("decimal text has more than 38 significant digits",
                           DEC_DB_PRECISION)
            }
            if c == 8 {
                return err("decimal exponent is outside int16", DEC_DB_EXPONENT)
            }
            if c == 9 {
                return err("decimal display scale is outside uint16",
                           DEC_DB_DISPLAY_RANGE)
            }
            return err(m, c)
        }
    }
}

// Convenience string form for a non-NULL column. SQL NULL is an error; use
// column_value or is_null when NULL must be distinguished. TEXT containing NUL
// is rejected; use column_bytes for exact bytes.
pub fn (s: &Stmt) column_text(col: int): Result[string] {
    let t = try s.column_type(col)
    if t == SQLITE_NULL { return err("SQL NULL", 1) }
    if t == SQLITE_FLOAT {
        return err("REAL column is not exact decimal/data", 2)
    }
    var v = read_text(s, col)
    if v == nil {
        return err("column value is too large to copy or allocation failed", 2)
    }
    if s.error_code() == SQLITE_NOMEM {
        return err("SQLite ran out of memory reading the column", SQLITE_NOMEM)
    }
    let b = v
    if has_nul(&b) { return err("text column contains an embedded NUL; use column_bytes", 1) }
    return ok(string(b))
}

// Exact bytes for a TEXT or BLOB column. SQL NULL is ok(nil). Embedded NUL is
// preserved for BLOB (and for TEXT bytes) because the length comes from SQLite.
// A zero-length BLOB is an empty array, never nil.
pub fn (s: &Stmt) column_bytes(col: int): Result[?[]byte] {
    let t = try s.column_type(col)
    if t == SQLITE_NULL {
        let none: ?[]byte = nil
        return ok(none)
    }
    if t != SQLITE_TEXT && t != SQLITE_BLOB {
        return err("column is not TEXT or BLOB", 2)
    }
    var v = read_blob(s, col)
    if v == nil {
        return err("column value is too large to copy or allocation failed", 2)
    }
    if s.error_code() == SQLITE_NOMEM {
        return err("SQLite ran out of memory reading the column", SQLITE_NOMEM)
    }
    let b = v
    let out: ?[]byte = b
    return ok(out)
}

// Integer view through sqlite3_column_int64. It is an exact i64 only for an
// INTEGER column; TEXT is converted by SQLite. REAL is rejected because it is
// not exact decimal/integer data. Use column_value/column_text for exact
// integer-to-text values.
pub fn (s: &Stmt) column_int(col: int): Result[int] {
    let t = try s.column_type(col)
    if t == SQLITE_NULL { return err("SQL NULL", 1) }
    if t == SQLITE_FLOAT {
        return err("REAL column is not exact decimal/integer data", 2)
    }
    return ok(column_int64(s, col))
}

// ------------------------------------------------------- library/resource info

pub fn error_string(code: int): Result[string] {
    var b = errstr(code)
    return ok(string(b))
}
