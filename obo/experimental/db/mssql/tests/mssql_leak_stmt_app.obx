// Negative fixture: drop an open Stmt (Rows) without closing it.
//
// The Connection is closed, so only the statement is leaked. Under OBO_CHECK=1
// the foreign census reports "foreign handles leaked: Stmt 1" at normal end
// (exit 8).
module app

import "mssql.obx"
import "../../../../lib/env.obx" as env

fn main() {
    let got = env::get("MSSQL_TEST_DSN")
    if got == nil { exit(64) }
    let made = mssql::open(string(got))
    match made {
        ok(conn) {
            let q = conn.exec("SELECT 1")
            match q {
                ok(rows) {
                    println("leaking one statement")
                    let c = conn.close()
                    match c {
                        ok(v) {
                            if !v { println("connection close failed"); exit(2) }
                        }
                        err(m, code) {
                            println("connection close ", code, " ", m)
                            exit(3)
                        }
                    }
                    return
                }
                err(m, code) { println("exec failed ", code, " ", m); exit(5) }
            }
        }
        err(m, code) { println("open failed ", code, " ", m); exit(6) }
    }
}
