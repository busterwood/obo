// Experimental PostgreSQL package for obo, on the cinterop v2 libpq wrapper.
//
// This is an explicit-close adapter. Connection holds a libpq::Connection
// foreign handle and Rows holds a libpq::Res; obo never sees a raw PGconn*,
// PGresult* or char*. Both outer records are ordinary obo records, so
// dropping one frees the outer record but does not release the inner libpq
// handle: use `defer conn.close()` and `defer rows.close()`. A dropped handle
// is reported by the OBO_CHECK=1 foreign census.
//
// Values cross as exact bytes. Numeric columns are never converted through a
// float. Rows exposes the PostgreSQL type OID and typmod and the exact text.
// SQL is always a fixed statement with $1..$n placeholders; there is no SQL
// interpolation. execute_sql adds the dialect-neutral Sql-template bridge:
// it renders $1..$n with lib/sqldialect and maps the ordered SqlArg values,
// while SqlArg.Float is an explicit SQL_ARG_FLOAT_UNSUPPORTED error.
module postgres

import "sqldialect.obx" as sqldialect
import "libpq.obx" as libpq

pub const CONNECTION_OK = 0
pub const CONNECTION_BAD = 1
pub const PGRES_EMPTY_QUERY = 0
pub const PGRES_COMMAND_OK = 1
pub const PGRES_TUPLES_OK = 2
pub const PGRES_FATAL_ERROR = 7

pub const OID_BOOL = 16
pub const OID_BYTEA = 17
pub const OID_INT8 = 20
pub const OID_TEXT = 25
pub const OID_NUMERIC = 1700

pub type Connection = ref record { h: libpq::Connection }
// fmt is 0 for execute() text rows and 1 for execute_binary() rows. h owns the
// one libpq Res; it is private and never moves out of the record.
pub type Rows = ref record { h: libpq::Res; pub fmt: int }

// The wrapper records hold their libpq handle in a field. The deep-reference
// rule lets a field reach a native borrow, but not another obo function, so
// these are declared here as well as in libpq.obx. They use the same spec
// symbols; libpq.obx supplies the type names and the connection helpers.
native fn conn_status(c: &libpq::Connection): int
native fn conn_error(c: &libpq::Connection): []byte
native fn exec_params_raw(c: &libpq::Connection, sql: &[]byte,
                          values: &[]?[]byte, oids: &[]int,
                          formats: &[]int, result_format: int): ?libpq::Res
native fn res_status(r: &libpq::Res): int
native fn res_ntuples(r: &libpq::Res): int
native fn res_nfields(r: &libpq::Res): int
native fn res_is_null(r: &libpq::Res, row: int, col: int): int
native fn res_length(r: &libpq::Res, row: int, col: int): int
native fn res_value(r: &libpq::Res, row: int, col: int): ?[]byte
native fn res_fname(r: &libpq::Res, col: int): []byte
native fn res_ftype(r: &libpq::Res, col: int): int
native fn res_fmod(r: &libpq::Res, col: int): int
native fn res_error(r: &libpq::Res): []byte
native fn make_empty_result(status: int): libpq::Res

// A typed bind parameter. kind is PARAM_*; i carries int/bool and data carries
// text/blob bytes. Null is an explicit kind, never an empty byte string.
pub const PARAM_NULL = 0
pub const PARAM_TEXT = 1
pub const PARAM_BLOB = 2
pub const PARAM_INT = 3
pub const PARAM_BOOL = 4
pub const PARAM_DECIMAL = 5
pub const PARAM_DECIMAL_NULL = 6

// SqlArg.Float is a binary64 value. This adapter does not format floats into
// text and has no float parameter kind, so execute_sql rejects it explicitly
// rather than rounding or interpolating it. Use decimal or a typed text/binary
// representation when exactness matters.
pub const SQL_ARG_FLOAT_UNSUPPORTED = 1014

// Decimal boundary error codes. They deliberately start at 1000 so they do not
// collide with adapter plumbing codes 2/3 or PostgreSQL status values.
pub const DEC_DB_NULL = 1001
pub const DEC_DB_NOT_DECIMAL = 1002
pub const DEC_DB_BINARY = 1003
pub const DEC_DB_NONFINITE = 1004
pub const DEC_DB_TEXT_INVALID = 1006
pub const DEC_DB_PRECISION = 1007
pub const DEC_DB_EXPONENT = 1008
pub const DEC_DB_DISPLAY_RANGE = 1009
pub const DEC_DB_SCALE = 1010
pub const DEC_DB_RANGE = 1011
pub const DEC_DB_METADATA = 1012
pub const DEC_DB_PG_RANGE = 1013

// Result metadata for a numeric column. All fields are public so an importer
// can inspect the decoded typmod; there is no decimal field anywhere.
pub type DecimalType = ref record {
    pub precision: int
    pub scale: int
    pub constrained: bool
}

pub type Param = ref record {
    kind: int
    i: int
    data: []byte
}

fn encode_string(s: string): []byte {
    var out = new []byte(0)
    for i in 0..len(s) { append(out, s[i]) }
    return out
}

// Copy a borrowed byte array. SqlArg payloads are borrowed from the Sql
// fragment, and obo forbids moving out of a field, so a bridge or encoder must
// copy the payload into a local array before appending it.
fn copy_bytes(b: &[]byte): []byte {
    var out = new []byte(0)
    for i in 0..len(b) { append(out, b[i]) }
    return out
}

fn has_nul(b: &[]byte): bool {
    for i in 0..len(b) {
        if b[i] == byte(0) { return true }
    }
    return false
}

// libpq reads a text-format paramValues[] entry as a C string and ignores
// paramLengths, so the copy needs a NUL one byte past its data. Build len+1 and
// truncate to len: the capacity keeps the terminator, the length stays exact.
fn wire_text(b: &[]byte): []byte {
    var out = new []byte(len(b) + 1)
    for i in 0..len(b) { out[i] = b[i] }
    truncate(out, len(b))
    return out
}

// ------------------------------------------------------- decimal text helpers

// Count the characters after the point in fixed display text; 0 when there is
// no point. A local helper, not a new decimal API.
fn fraction_digits(s: string): int {
    for i in 0..len(s) {
        if s[i] == '.' { return len(s) - i - 1 }
    }
    return 0
}

fn canonical_db(value: decimal): Result[string] {
    let c = decimal::canonical(value)
    match c {
        ok(s) { return ok(s) }
        err(m, code) {
            if code == 6 || code == 9 {
                return err("decimal display scale is outside uint16", DEC_DB_DISPLAY_RANGE)
            }
            if code == 10 { return err("decimal text could not be allocated", 3) }
            return err("invalid decimal value", 2)
        }
    }
}

// Exact display text when its scale fits; canonical exact text when only the
// display scale would be capped. Never rounds and never emits an empty string.
fn encode_decimal(value: decimal, max_dscale: int): Result[string] {
    let f = decimal::format(value)
    match f {
        ok(s) {
            let ds = fraction_digits(s)
            if max_dscale < 0 || ds <= max_dscale { return ok(s) }
            // The value is exactly representable; only its display scale is not.
            if value != 0.0 && decimal::exponent(value) < -max_dscale {
                return err("value is not representable in PostgreSQL numeric",
                           DEC_DB_PG_RANGE)
            }
            return canonical_db(value)
        }
        err(m, c) {
            if c == 3 {
                if value != 0.0 && decimal::exponent(value) < -max_dscale {
                    return err("value is not representable in PostgreSQL numeric",
                               DEC_DB_PG_RANGE)
                }
                return canonical_db(value)
            }
            if c == 10 { return err("decimal text could not be allocated", 3) }
            if c == 6 || c == 9 {
                return err("decimal display scale is outside uint16",
                           DEC_DB_DISPLAY_RANGE)
            }
            return err("invalid decimal value", 2)
        }
    }
}

fn pg_decimal_text(value: decimal): Result[string] {
    return encode_decimal(value, 16383)
}

// Explicit opt-out for unconstrained targets or deliberate server coercion.
pub fn param_decimal_unchecked(value: decimal): Result[Param] {
    let txt = try pg_decimal_text(value)
    let raw = encode_string(txt)
    if has_nul(&raw) { return err("invalid decimal text", DEC_DB_TEXT_INVALID) }
    return ok(new Param{kind: PARAM_DECIMAL, i: 0, data: raw})
}

// The default checked binder: reject values the declared numeric(p,s) would
// round or overflow before any bytes reach the server.
pub fn param_decimal(value: decimal, p: int, s: int): Result[Param] {
    let r = decimal::check(value, p, s)
    match r {
        ok(v) { return param_decimal_unchecked(v) }
        err(m, c) {
            if c == 10 { return err("decimal text could not be allocated", 3) }
            if c == 1 || c == 4 { return err("invalid decimal value", 2) }
            if c == 3 {
                return err("value does not fit the declared scale without rounding",
                           DEC_DB_SCALE)
            }
            if c == 7 {
                return err("value exceeds the declared precision", DEC_DB_RANGE)
            }
            if c == 6 {
                return err("invalid numeric typmod or precision/scale metadata",
                           DEC_DB_METADATA)
            }
            return err(m, c)
        }
    }
}

// A typed SQL NULL with OID 1700, for contexts such as SELECT $1 where the
// server has no target column from which to infer a type.
pub fn param_decimal_null(): Param {
    return new Param{kind: PARAM_DECIMAL_NULL, i: 0, data: new []byte(0)}
}

pub fn param_null(): Param {
    return new Param{kind: PARAM_NULL, i: 0, data: new []byte(0)}
}

pub fn param_int(v: int): Param {
    return new Param{kind: PARAM_INT, i: v, data: new []byte(0)}
}

pub fn param_bool(v: bool): Param {
    var n = 0
    if v { n = 1 }
    return new Param{kind: PARAM_BOOL, i: n, data: new []byte(0)}
}

pub fn param_text(s: string): Param {
    return new Param{kind: PARAM_TEXT, i: 0, data: encode_string(s)}
}

pub fn param_blob(b: []byte): Param {
    return new Param{kind: PARAM_BLOB, i: 0, data: b}
}

// Same as param_blob, named for callers that think in bytes.
pub fn param_bytes(b: []byte): Param {
    return new Param{kind: PARAM_BLOB, i: 0, data: b}
}

// A decimal parameter from exact text bytes. The bytes are copied, never
// reformatted; PARAM_DECIMAL keeps OID 1700 and the encoder's grammar/size
// validation. Empty text and embedded NUL are rejected here as well, so a
// malformed SqlArg.DecimalText fails before any value is encoded.
fn param_decimal_copy(b: &[]byte): Result[Param] {
    if len(b) == 0 { return err("invalid decimal text", DEC_DB_TEXT_INVALID) }
    if has_nul(b) { return err("invalid decimal text", DEC_DB_TEXT_INVALID) }
    return ok(new Param{kind: PARAM_DECIMAL, i: 0, data: copy_bytes(b)})
}

pub fn param_decimal_text(b: []byte): Result[Param] {
    return param_decimal_copy(&b)
}

// Map each typed Param to the libpq parameter arrays: value bytes, binary
// flags and explicit PostgreSQL OIDs. The kinds and wire types are the old
// adapter's: NULL 0/text, TEXT 25/text, BLOB 17/binary, INT 20/text,
// BOOL 16/text "t"/"f", DECIMAL and DECIMAL_NULL 1700/text.
//
// Each payload is copied because obo forbids moving out of a field. The
// out-parameters are mutable arrays, not a returned record, for the same
// reason. Text is checked for NUL here; the libpq wrapper adds the len+1
// terminator that libpq's text paramValues[] requires.
fn encode_params(params: &[]Param, mut values: &[]?[]byte,
                 mut binary: &[]bool, mut oids: &[]int): Result[bool] {
    for i in 0..len(params) {
        let p = &params[i]
        if p.kind == PARAM_NULL {
            append(values, nil)
            append(binary, false)
            append(oids, 0)
        } else if p.kind == PARAM_TEXT {
            if has_nul(&p.data) {
                return err("text parameter contains an embedded NUL", 2)
            }
            if len(p.data) > 16777216 {
                return err("text parameter is too large", 2)
            }
            append(values, wire_text(&p.data))
            append(binary, false)
            append(oids, 25)
        } else if p.kind == PARAM_BLOB {
            if len(p.data) > 16777216 {
                return err("blob parameter is too large", 2)
            }
            append(values, copy_bytes(&p.data))
            append(binary, true)
            append(oids, 17)
        } else if p.kind == PARAM_INT {
            let digits = string(p.i)
            let raw = encode_string(digits)
            append(values, wire_text(&raw))
            append(binary, false)
            append(oids, 20)
        } else if p.kind == PARAM_BOOL {
            var raw = new []byte(0)
            if p.i != 0 {
                append(raw, 't')
            } else {
                append(raw, 'f')
            }
            append(values, wire_text(&raw))
            append(binary, false)
            append(oids, 16)
        } else if p.kind == PARAM_DECIMAL {
            let n = len(p.data)
            if n == 0 { return err("invalid decimal text", DEC_DB_TEXT_INVALID) }
            if n > 98342 { return err("decimal parameter is too large", 2) }
            if has_nul(&p.data) {
                return err("invalid decimal text", DEC_DB_TEXT_INVALID)
            }
            let d = decimal::parse(string(p.data))
            match d {
                ok(v) {
                    append(values, wire_text(&p.data))
                    append(binary, false)
                    append(oids, 1700)
                }
                err(m, c) {
                    if c == 10 { return err("decimal text could not be allocated", 3) }
                    if c == 4 { return err("invalid decimal text", DEC_DB_TEXT_INVALID) }
                    if c == 7 {
                        return err("decimal text has more than 38 significant digits",
                                   DEC_DB_PRECISION)
                    }
                    if c == 8 {
                        return err("decimal exponent is outside int16",
                                   DEC_DB_EXPONENT)
                    }
                    if c == 9 {
                        return err("decimal display scale is outside uint16",
                                   DEC_DB_DISPLAY_RANGE)
                    }
                    return err("invalid decimal value", 2)
                }
            }
        } else if p.kind == PARAM_DECIMAL_NULL {
            if len(p.data) != 0 {
                return err("invalid decimal NULL parameter", 2)
            }
            append(values, nil)
            append(binary, false)
            append(oids, 1700)
        } else {
            return err("unknown parameter kind", 2)
        }
    }
    return ok(true)
}

// ------------------------------------------------------------------ connection

pub fn open(conninfo: string): Result[Connection] {
    let raw = encode_string(conninfo)
    if has_nul(&raw) {
        return err("invalid connection string (embedded NUL)", 2)
    }
    if len(raw) > 16777216 {
        return err("invalid connection string (too long)", 2)
    }
    let made = libpq::connect(raw)
    match made {
        ok(h) { return ok(new Connection{h: h}) }
        err(m, c) { return err(m, c) }
    }
}

pub fn (c: &Connection) status(): int {
    if !c.h.is_open() { return -1 }
    return conn_status(&c.h)
}

pub fn (c: &Connection) is_open(): bool {
    return c.h.is_open()
}

pub fn (c: &Connection) error_message(): []byte {
    if !c.h.is_open() { return new []byte(0) }
    return conn_error(&c.h)
}

// Borrows the Connection. Closing zeroes the inner foreign word; a second
// close is a safe false, never a second PQfinish. Record drop does not free
// the foreign object.
pub fn (mut c: &Connection) close(): bool {
    let r = c.h.close()
    match r {
        ok(v) { return v }
        err(m, n) { return false }
    }
}

// ------------------------------------------------------------------ execution

fn execute_fmt(c: &Connection, sql: string, params: []Param,
               result_binary: bool): Result[Rows] {
    if !c.h.is_open() { return err("connection is closed or invalid", 2) }
    if len(params) > 32 { return err("too many parameters (maximum 32)", 2) }
    if len(sql) > 1048576 { return err("SQL text is too large", 2) }
    let sb = encode_string(sql)
    if has_nul(&sb) { return err("SQL text contains an embedded NUL", 2) }
    var values = new []?[]byte(0)
    var binary = new []bool(0)
    var oids = new []int(0)
    let one = try encode_params(&params, &values, &binary, &oids)
    if !one { return err("parameter could not be encoded", 2) }
    var formats = new []int(0)
    for i in 0..len(binary) {
        if binary[i] {
            append(formats, 1)
        } else {
            append(formats, 0)
        }
    }
    var rf = 0
    if result_binary { rf = 1 }
    let made = exec_params_raw(&c.h, &sb, &values, &oids, &formats, rf)
    if made == nil {
        let mb = conn_error(&c.h)
        let msg = string(mb)
        if len(msg) == 0 {
            return err("libpq returned no result and no error message", 2)
        }
        return err(msg, 2)
    }
    let res = made
    return ok(new Rows{h: res, fmt: rf})
}

// Text result format: every column is returned as PostgreSQL's exact text.
pub fn execute(c: &Connection, sql: string, params: []Param): Result[Rows] {
    return execute_fmt(c, sql, params, false)
}

// Binary result format. Use bytes() for values; value() returns exact bytes
// (including embedded NUL); text() is the NUL-rejecting string convenience.
pub fn execute_binary(c: &Connection, sql: string, params: []Param): Result[Rows] {
    return execute_fmt(c, sql, params, true)
}

// A fixed statement with no parameters.
pub fn query(c: &Connection, sql: string): Result[Rows] {
    return execute(c, sql, new []Param(0))
}

// Map one SqlArg to the typed Param in the same order. Strings and decimal
// text are copied by their constructors; byte payloads are deep-copied because
// they are borrowed from the Sql fragment. Float has no parameter kind here.
fn param_from_sql_arg(a: &SqlArg): Result[Param] {
    match a {
        Null { return ok(param_null()) }
        Int { return ok(param_int(a.v)) }
        Bool { return ok(param_bool(a.v)) }
        Float {
            return err("float SqlArg is not supported by the PostgreSQL adapter; use decimal or text",
                       SQL_ARG_FLOAT_UNSUPPORTED)
        }
        Str { return ok(param_text(a.v)) }
        Bytes { return ok(param_blob(copy_bytes(&a.v))) }
        DecimalText { return param_decimal_copy(&a.v) }
    }
}

// Execute a dialect-neutral Sql fragment with PostgreSQL $1..$n placeholders.
// The fragment is borrowed: its text and parameters remain owned by the caller.
// Literal chunks are trusted SQL; values are never interpolated. Rendering and
// parameter conversion happen before any values are encoded, so a malformed
// fragment or an unsupported value sends nothing.
pub fn execute_sql(c: &Connection, s: &Sql): Result[Rows] {
    let text = try sqldialect::renderPostgres(s)
    var params = new []Param(0)
    for i in 0..len(s.params) {
        let p = try param_from_sql_arg(&s.params[i])
        append(params, p)
    }
    return execute(c, text, params)
}

// ---------------------------------------------------------------------- rows

pub fn (r: &Rows) status(): int {
    if !r.h.is_open() { return -1 }
    return res_status(&r.h)
}

pub fn (r: &Rows) is_open(): bool {
    return r.h.is_open()
}

pub fn (r: &Rows) row_count(): int {
    if !r.h.is_open() { return -1 }
    return res_ntuples(&r.h)
}

pub fn (r: &Rows) column_count(): int {
    if !r.h.is_open() { return -1 }
    return res_nfields(&r.h)
}

fn cell_ok(r: &Rows, row: int, col: int): bool {
    if !r.h.is_open() { return false }
    if row < 0 || col < 0 { return false }
    return row < res_ntuples(&r.h) && col < res_nfields(&r.h)
}

fn col_ok(r: &Rows, col: int): bool {
    if !r.h.is_open() { return false }
    return col >= 0 && col < res_nfields(&r.h)
}

pub fn (r: &Rows) is_null(row: int, col: int): Result[bool] {
    if !cell_ok(r, row, col) { return err("row or column out of range", 2) }
    let is_null = res_is_null(&r.h, row, col) == 1
    return ok(is_null)
}

// Length in bytes as libpq reports it; NULL and empty both report 0. Use
// is_null to tell them apart. A negative result means out of range/stale.
pub fn (r: &Rows) length(row: int, col: int): int {
    if !cell_ok(r, row, col) { return -1 }
    return res_length(&r.h, row, col)
}

fn cell_value(r: &Rows, row: int, col: int): Result[[]byte] {
    let v = res_value(&r.h, row, col)
    if v == nil { return err("value could not be copied", 2) }
    let b = v
    return ok(b)
}

// Exact bytes for a cell with SQL NULL distinct: nil means NULL, an empty
// array means an empty value. (Obo does not allow a ?string payload; optional
// values are reference types only, so the exact text form is ?[]byte. Use
// text() when a string is wanted.)
pub fn (r: &Rows) value(row: int, col: int): Result[?[]byte] {
    if !cell_ok(r, row, col) { return err("row or column out of range", 2) }
    if res_is_null(&r.h, row, col) == 1 {
        let none: ?[]byte = nil
        return ok(none)
    }
    let b = try cell_value(r, row, col)
    let out: ?[]byte = b
    return ok(out)
}

// Convenience string form for a non-NULL cell. SQL NULL is an error; use
// value() or is_null() when NULL must be distinguished. Embedded NUL is
// rejected because a string cannot represent it losslessly here.
pub fn (r: &Rows) text(row: int, col: int): Result[string] {
    if !cell_ok(r, row, col) { return err("row or column out of range", 2) }
    if res_is_null(&r.h, row, col) == 1 { return err("SQL NULL", 1) }
    let b = try cell_value(r, row, col)
    if has_nul(&b) { return err("value contains an embedded NUL; use bytes", 1) }
    return ok(string(b))
}

// Exact bytes for a cell, including embedded NUL. SQL NULL is an error here;
// check is_null or use value() when NULL must be distinct.
pub fn (r: &Rows) bytes(row: int, col: int): Result[[]byte] {
    if !cell_ok(r, row, col) { return err("row or column out of range", 2) }
    if res_is_null(&r.h, row, col) == 1 { return err("SQL NULL", 1) }
    return cell_value(r, row, col)
}

pub fn (r: &Rows) column_name(col: int): Result[string] {
    if !col_ok(r, col) { return err("column out of range", 2) }
    let b = res_fname(&r.h, col)
    if len(b) == 0 { return err("column name could not be copied", 2) }
    if has_nul(&b) { return err("column name contains an embedded NUL", 1) }
    return ok(string(b))
}

pub fn (r: &Rows) column_type_oid(col: int): Result[int] {
    if !col_ok(r, col) { return err("column out of range", 2) }
    return ok(res_ftype(&r.h, col))
}

// PostgreSQL typmod; -1 is a valid "no modifier" value, so bounds are checked
// before this call rather than inferred from the result.
pub fn (r: &Rows) column_type_modifier(col: int): Result[int] {
    if !col_ok(r, col) { return err("column out of range", 2) }
    return ok(res_fmod(&r.h, col))
}

// Decode a numeric column's typmod into an all-int record. OID 1700 is the only
// accepted decimal result type; -1 means unconstrained and every other invalid
// typmod is DEC_DB_METADATA rather than a meaningless unconstrained record.
pub fn (r: &Rows) decimal_type(col: int): Result[DecimalType] {
    let oid = try r.column_type_oid(col)
    if oid != OID_NUMERIC {
        return err("value is not numeric decimal data", DEC_DB_NOT_DECIMAL)
    }
    let tm = try r.column_type_modifier(col)
    if tm == -1 {
        return ok(new DecimalType{precision: 0, scale: 0, constrained: false})
    }
    if tm < 4 {
        return err("invalid numeric typmod or precision/scale metadata",
                   DEC_DB_METADATA)
    }
    let t = tm - 4
    let p = (t >> 16) & 0xffff
    let sc = (((t & 0x7ff) ^ 1024) - 1024)
    if p < 1 || p > 1000 || sc < -1000 || sc > 1000 {
        return err("invalid numeric typmod or precision/scale metadata",
                   DEC_DB_METADATA)
    }
    return ok(new DecimalType{precision: p, scale: sc, constrained: true})
}

// Read one numeric cell as an exact decimal. The order is normative: NULL,
// then binary result format, then OID/typmod, then the exact text bytes.
pub fn (r: &Rows) decimal(row: int, col: int): Result[decimal] {
    let isn = try r.is_null(row, col)
    if isn { return err("SQL NULL", DEC_DB_NULL) }
    if r.fmt != 0 {
        return err("binary decimal result is not supported", DEC_DB_BINARY)
    }
    let meta = try r.decimal_type(col)
    let b = try r.bytes(row, col)
    if len(b) == 0 { return err("invalid decimal text", DEC_DB_TEXT_INVALID) }
    if has_nul(&b) { return err("invalid decimal text", DEC_DB_TEXT_INVALID) }
    let txt = string(b)
    if txt == "NaN" || txt == "Infinity" || txt == "-Infinity" {
        return err("non-finite numeric is not representable", DEC_DB_NONFINITE)
    }
    let d = decimal::parse(txt)
    match d {
        ok(v) {
            if meta.constrained {
                let cr = decimal::check(v, meta.precision, meta.scale)
                match cr {
                    ok(checked) { return ok(checked) }
                    err(m, c) {
                        if c == 10 {
                            return err("decimal text could not be allocated", 3)
                        }
                        if c == 1 || c == 4 {
                            return err("invalid decimal value", 2)
                        }
                        if c == 3 {
                            return err("value does not fit the declared scale without rounding",
                                       DEC_DB_SCALE)
                        }
                        if c == 7 {
                            return err("value exceeds the declared precision",
                                       DEC_DB_RANGE)
                        }
                        if c == 6 {
                            return err("invalid numeric typmod or precision/scale metadata",
                                       DEC_DB_METADATA)
                        }
                        return err(m, c)
                    }
                }
            }
            return ok(v)
        }
        err(m, c) {
            if c == 10 { return err("decimal text could not be allocated", 3) }
            if c == 1 || c == 6 { return err("invalid decimal value", 2) }
            if c == 4 { return err("invalid decimal text", DEC_DB_TEXT_INVALID) }
            if c == 7 {
                return err("decimal text has more than 38 significant digits",
                           DEC_DB_PRECISION)
            }
            if c == 8 {
                return err("decimal exponent is outside int16",
                           DEC_DB_EXPONENT)
            }
            if c == 9 {
                return err("decimal display scale is outside uint16",
                           DEC_DB_DISPLAY_RANGE)
            }
            return err(m, c)
        }
    }
}

pub fn (r: &Rows) error_message(): []byte {
    if !r.h.is_open() { return new []byte(0) }
    return res_error(&r.h)
}

// Borrows Rows. A second close is a safe false; drop never calls PQclear.
pub fn (mut r: &Rows) close(): bool {
    if !r.h.is_open() { return false }
    r.h.close()
    return true
}

// ------------------------------------------------------- library/resource info

pub fn lib_version(): int {
    return libpq::lib_version()
}

// Real PGresult ownership with no connection, for link/ownership probes.
// PostgreSQL 16 ExecStatusType ends at 11; a NULL from libpq is an own
// contract violation and exits 11.
pub fn make_empty_rows(status: int): Result[Rows] {
    if status < 0 || status > 11 {
        return err("empty result could not be created", 2)
    }
    let h = make_empty_result(status)
    return ok(new Rows{h: h, fmt: 0})
}
